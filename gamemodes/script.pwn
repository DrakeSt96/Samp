					DestroyDynamicObject(SRubbishInfo[i][RubbishObject]);
					format(string,sizeof(string),""IINFO" du hast die Straße gesäubert und %ikg Dreck aufgesaugt.",dirtrand);
					SCM(playerid,SAMP_WEISS,string);
					VehicleLoadTank[vehicleid] += dirtrand;
