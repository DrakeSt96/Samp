						{
							PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
							return SCM(playerid,SAMP_WEISS,"Fraktionskasse beinhaltet nicht so viel Geld.");
						}
						fverwaltungen[Spieler[playerid][pFraktion]][Geld] -= 2500;
						fverwaltungen[Spieler[playerid][pFraktion]][Heal] = 1;
						fverwaltungen[Spieler[playerid][pFraktion]][HealSlots] += 50;
						SCM(playerid,SAMP_WEISS,""IINFO" du hast das Heal-Pack 1 für 2500$ gekauft.");
						SCM(playerid,SAMP_WEISS,"Info: Es kann 50 mal von deiner Fraktion benutzt werden.");
						SCM(playerid,SAMP_WEISS,"Info: Das Geld wurde aus der Fraktionskasse abgehoben.");
						SCM(playerid,SAMP_WEISS,"Deine Fraktion kann sich jetzt für 50 Prozent HEAL.");
						return 1;
				    }
				    case 1://PACK 2
				    {
