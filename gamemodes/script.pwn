		format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		return SCM(playerid,WEISS,string);
	}
	if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /org(anisationschat) [Text]");
	if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /fc(firmchat) [Text]");
	for(new b=0;b<sizeof(BadWord);b++)
	{
		if(strfind(text,BadWord[b],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /fc(firmachat)",BadWord[b],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
	}
	new strpos = strfind(text,"www",true);
	if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
	{
		strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
		return 1;
	}
	format(string,sizeof(string),""#HTML_ORANGE"[UnternehmenChat]: "#HTML_WEISS"%s"#HTML_WEISS" schrieb: "IINFO2"%s",SpielerName(playerid),text);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(Spieler[i][pOrgMember] == Spieler[playerid][pOrgMember])
				{
					SCM(i,SAMP_WEISS,string);
				}
				if(Spieler[i][IreadALL] == 1)
				{
					SCM(i,SAMP_WEISS,string);
				}
			}
		}
	}
	format(string,sizeof(string),"%s: %s",Spieler[playerid][pName],text);
	Log("Firmalog.txt",string);
	return 1;
}
COMMAND:parteimember(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[1000],onlinemembers = 0,p = Spieler[playerid][pParteiMember];
    if(p == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Partei.");
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(Spieler[i][pParteiMember] == p)
				{
					format(string,sizeof(string),"%s (ID:%i)\n%s",SpielerName(i),i,string);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_LIST,PartInfo[p][ParteiName],string,"Verlassen","");
					onlinemembers++;
				}
			}
		}
	}
	if(onlinemembers == 0)return SCM(playerid,SAMP_WEISS,"Kein Parteimitglied Online.");
	return 1;
}
COMMAND:firmmitglieder(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[1000],onlinemembers = 0,org = Spieler[playerid][pOrgMember];
    if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Organisation.");
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(Spieler[i][pOrgMember] == org)
				{
					format(string,sizeof(string),""#HTML_WEISS"Name: "IINFO2"%s\n%s",SpielerName(i),string);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,OrgInfo[org][OrgName],string,"Okay","");
					onlinemembers++;
				}
			}
		}
	}
	if(onlinemembers == 0)return SCM(playerid,SAMP_WEISS,""IINFO" kein Firmenmitglied Online.");
	return 1;
}
COMMAND:firmname(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new name[32],org = Spieler[playerid][pOrgLeader],string[128];
	if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Unternehmer.");
	if(sscanf(params,"s[32]",name))return SCM(playerid,SAMP_WEISS,""IINFO" /firmname [Name]");
	if(strlen(name) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /firmname [Name]");
	strmid(OrgInfo[org][OrgName],name,0,strlen(name),32);
	format(string,sizeof(string),""IINFO" du hast den Namen der Firma in "IINFO2"%s"#HTML_WEISS" umgeändert.",OrgInfo[org][OrgName]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s hat den Namen der Firma in "IINFO2"%s"#HTML_WEISS" umgeändert.",Spieler[playerid][pName],OrgInfo[org][OrgName]);
	SendOrganisationsMessage(org,SAMP_WEISS,string);
	return 1;
}/*
