COMMAND:bentladen(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    if(!isPlayerInJob(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
	if(BauarbeiterHatErlaubnis[playerid] != 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht aktiv am arbeiten!");
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	new vehicleid = GetPlayerVehicleID(playerid);
	if(!IsVehicleABauarbeiterCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Transporter.");
	if(BauarbeiterLoad[playerid] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Ladung auf deinem Fahrzeug!");
	if(IsPlayerInRangeOfPoint(playerid, 7.5, BauarbeiterABP[BauarbeiterEntladenPunkt[playerid]][0],BauarbeiterABP[BauarbeiterEntladenPunkt[playerid]][1],BauarbeiterABP[BauarbeiterEntladenPunkt[playerid]][2]) && BauarbeiterCheckpoint[playerid] == 4)
	{
    	SetTimerEx("BauarbeiterLadung",60000,false,"ii",playerid,2);
	    SCM(playerid,SAMP_WEISS,"Warte 1 Minute bis die Ladung abgeladen wurde!");
	    TogglePlayerControllable(playerid,false);
	    BauarbeiterLoad[playerid] = 0;
	}
	else
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Zielort!");
	    return 1;
	}
	return 1;
}

COMMAND:baufladen(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    if(!isPlayerInJob(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
	if(BauarbeiterHatErlaubnis[playerid] != 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht aktiv am arbeiten!");
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	new vehicleid = GetPlayerVehicleID(playerid);
	if(!IsVehicleABauarbeiterCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Transporter.");
	if(BauarbeiterLoad[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits eine Ladung auf deinem Fahrzeug!");
    if(IsPlayerInRangeOfPoint(playerid,7.5,1633.4183,982.5751,10.5474) && BauarbeiterCheckpoint[playerid] == 2)
	{
	    SetTimerEx("BauarbeiterLadung",60000,false,"ii",playerid,1);
	    SCM(playerid,SAMP_WEISS,"Warte 1 Minute bis sich die Ladung auf dem Fahrzeug befindet.");
	    TogglePlayerControllable(playerid,false);
	    BauarbeiterLoad[playerid] = 1;
	}
	else
 	{
  		SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Aufladepunkt!");
  		return 1;
    }
	return 1;
}
COMMAND:bstarten(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
 	if(!IsPlayerInRangeOfPoint(playerid,3.5,2139.8379,-1191.7671,23.9922)) return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht beim Job-Annahme Punkt!");
    if(!isPlayerInJob(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(BauarbeiterHatErlaubnis[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist schon am Arbeiten");
	new count = 0;
	ForEachPlayer(i){
		if(IsPlayerConnected(i) && !IsPlayerNPC(i) && isPlayerInJob(playerid,8) && BauarbeiterHatErlaubnis[playerid] == 1){
		    count++;
		}
	}
	if(count == 3)return SCM(playerid,SAMP_WEISS,"Leider ist der Job leider schon vergeben! Bitte melde dich später nochmal!");
	else
    {
	    SCM(playerid,SAMP_WEISS,"Setzte dich nun in einen Transporter!");
	    SCM(playerid,SAMP_WEISS,"Es wird dir nun ein Checkpoint angezeigt wo du die gewünschte Ladung abholen sollst.");
	    SetPlayerCheckpoint(playerid,1633.4183,982.5751,10.5474,7.5);
        BauarbeiterHatErlaubnis[playerid] = 1;
        BauarbeiterCheckpoint[playerid] = 1;
        Spieler[playerid][pIsearch] = 1;
 	}
	return 1;
}
COMMAND:fillztm(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid),nearestzig = ReturnZTM(playerid),string[128],cashflow = random(40) + 75;
    if(!isPlayerInJob(playerid,19))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleAZigCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Transporter.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(nearestzig == -1)return SCM(playerid,SAMP_WEISS,"An keinem Zigarettenautomat!");
    if(VehicleLoadTank[vehicleid] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Transporter ist mit keinen Zigarettenschachteln beladen!");
	if((ZigAutomatInfo[nearestzig][Zigarrets] + 30) >= 180)return SCM(playerid,SAMP_WEISS,"Ein Zigarettenautomat kann maximal mit 180 Zigarettenschachteln gefüllt werden!");
	SCM(playerid,SAMP_WEISS,"|___Zigarettenautomat___|");
    format(string,sizeof(string),"Alter Stand: %i$",ZigAutomatInfo[nearestzig][Zigarrets]);
	SCM(playerid,SAMP_WEISS,string);
	SCM(playerid,SAMP_WEISS,"Einzahlung: 30 Schachteln");
	Spieler[playerid][pLohn] += cashflow;
	VehicleLoadTank[vehicleid] -= 30;
	ZigAutomatInfo[nearestzig][Zigarrets] += 30;
	SCM(playerid,SAMP_WEISS,"|-----------|");
	format(string,sizeof(string),"Neuer Stand: %i Schachteln",ZigAutomatInfo[nearestzig][Zigarrets]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"Transporter beinhaltet noch: %i Schachteln",VehicleLoadTank[vehicleid]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"Verdienst: %i$",cashflow);
	SCM(playerid,SAMP_WEISS,string);
	SCM(playerid,SAMP_WEISS,"Info: Die Auszahlung wird am Zahltag auf dein Konto überwiesen.");
	return 1;
}
COMMAND:buyzig(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new nearestzig = ReturnZTM(playerid);
    if(nearestzig == -1)return SCM(playerid,SAMP_WEISS,"An keinem Zigarettenautomaten.");
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst vom Fahrzeug aus auf keine Zigarettenautomaten zugreifen.");
    if(ZigAutomatInfo[nearestzig][Zigarrets] <= 0)return SCM(playerid,SAMP_WEISS,"Zigarettenautomat nicht mit genug Zigarettenschachteln befüllt!");
	if((GetACMoney(playerid) - 8) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
	if((Spieler[playerid][pZigarets] + 10) > 100)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen!");
	Spieler[playerid][pZigarets] += 10;
    ACMoney(playerid,-8);
    ZigAutomatInfo[nearestzig][Zigarrets]--;
    SCM(playerid,SAMP_WEISS,""IINFO" du hast dir eine Packung Zigaretten für 8$ gekauft! Nutze sie mit '/use zigarette'.");
	return 1;
}


COMMAND:startbaggern(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerInJob(playerid,20))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleABagger(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Erzbagger.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	SetPlayerCheckpoint(playerid,557.8638,911.2230,-42.7409,1.0);
	Spieler[playerid][pIsearch] = 1;
	SCM(playerid,SAMP_WEISS,""IINFO" der Erzablagehaufen wurde auf deine Karte markiert.");
	SCM(playerid,SAMP_WEISS,"Fahre zum Punkt und drücke wenn du am Berg bist die Taste 'Num2' um Erz aufzuladen.");
    SCM(playerid,SAMP_WEISS,"Nachdem beladen fährst du zur Aussortierrungsmaschine,wenn du da bist drücke die Taste 'Num8' um das geladene Erz abzuladen.");
	return 1;
}

