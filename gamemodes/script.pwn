stock GetDistanceToLastPoint(vehicleid)
{
	new Float:x2,Float:y2,Float:z2,Float:value;
	GetVehiclePos(vehicleid,x2,y2,z2);
	value = floatsqroot(floatpower(floatabs(floatsub(x2,vFahrzeug[vehicleid][Xs])),2)+floatpower(floatabs(floatsub(y2,vFahrzeug[vehicleid][Ys])),2)+floatpower(floatabs(floatsub(z2,vFahrzeug[vehicleid][Zs])),2));
	return floatround(value);
}
stock IsNumeric(const stringl[])
{
	for(new i=0,j=strlen(stringl);i<j;i++)
	{
		if(stringl[i] > '9' || stringl[i] < '0')return 0;
	}
	return 1;
}
stock IsFloat(const stringl[])
{
	for(new i=0,j=strlen(stringl);i<j;i++)
	{
		if((stringl[i] > '9' || stringl[i] < '0') && !strfind(stringl,".",true))return 0;
	}
	return 1;
}
stock Headshot(hitid,playerid)
{
 	new Float:x,Float:y,Float:z,Float:FrontX,Float:FrontY,Float:FrontZ,Float:CamX,Float:CamY,Float:CamZ;
   	GetPlayerCameraFrontVector(playerid,FrontX,FrontY,FrontZ);
    GetPlayerCameraPos(playerid,CamX,CamY,CamZ);
    for(new Float:i=0.0;i<100;i=i+0.5)
	{
	  	x = FrontX * i + CamX;
	 	y = FrontY * i + CamY;
	 	z = FrontZ * i + CamZ;
		if(hitid != playerid)return 1;
	   	if(GetPlayerSpecialAction(hitid) == SPECIAL_ACTION_DUCK)
	   	{
		    if(IsPlayerInRangeOfPoint(hitid,0.4,x,y,z))
			{
			    GameTextForPlayer(playerid,"~r~HEADSHOT",4000,3);
			    SetPlayerACHealth(hitid,0.0);
		    }
	    }
	    else
		{
		  	if(IsPlayerInRangeOfPoint(hitid,0.4,x,y,z-0.7))
		  	{
			   	GameTextForPlayer(playerid,"~r~HEADSHOT",4000,3);
			    SetPlayerACHealth(hitid,0.0);
		    }
	    }
    }
    return 1;
}
