forward Timer1();
public Timer1()
{
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(i != INVALID_PLAYER_ID)
		{
		    if(IsPlayerNPC(i) && IsPlayerConnected(i))
		    {
			   	if(IsPlayerConnected(i) && !IsPlayerNPC(i) && GetPVarInt(i,"Eingeloggt") == 1)
				{
					if(gettime()>GetPVarInt(i,"Sprunkcooldown") && GetPVarInt(i,"Sprunkcooldown") > 0)
					{
					    SetPVarInt(i,"Sprunkcooldown",0);
					}
				}
			}
		}
	}
	return 1;
}
stock HDDBan(playerid)
{
    if(IsPlayerConnected(playerid) && GetPVarInt(playerid,"Eingeloggt") == 1 )
    {
        new serial[50];
    	gpci(playerid,serial,sizeof(serial));
    	new pIp[20+4];
		GetPlayerIp(playerid,pIp,sizeof(pIp));
		new query[240];
		mysql_real_escape_string(pIp,pIp);
		mysql_real_escape_string(serial,serial);
        format(query, sizeof(query),"INSERT INTO `server_hddbans` (`IP`,`GPCI`,name) VALUES ('%s','%s','%s')",pIp,serial,Spieler[playerid][pName]);
		mysql_function_query(MySQL_R394, query, false,"SendQuery","");
    }
	return 1;
}
stock CheckHDDBan(playerid)
{
    if(IsPlayerConnected(playerid) && GetPVarInt(playerid,"Eingeloggt") == 1 )
    {
        new serial[50];
    	gpci(playerid,serial,sizeof(serial));
    	new pIp[20+4];
		GetPlayerIp(playerid,pIp,sizeof(pIp));
		new query[240];

		new c=0;
        for(new i=0;i<strlen(pIp);i++)
        {
            if(pIp[i]=='.')
            {
                c++;
                if(c==2)
                {
                    strmid(pIp,pIp,0,i+1);
                    break;
                }
            }
        }
        mysql_format(MySQL_R394,query,sizeof(query),"SELECT * FROM `server_hddbans` WHERE `IP` LIKE '%e%%' AND `GPCI` LIKE '%e' LIMIT 1",pIp,serial);
        print(query);
		mysql_function_query(MySQL_R394,query,true,"OnBanCheck","d",playerid);
    }
    return 1;
}
forward OnBanCheck(playerid);
public OnBanCheck(playerid)
{
	SCM(playerid,SAMP_WEISS,""IINFO" du bist von unserem Server gebannt!");
	TogglePlayerControllable(playerid, false);
 	SetTimerEx("KickDenSpieler",2000,false,"i",playerid);
	return 1;
}
forward SendLevelMessage(color, const string[]);
public SendLevelMessage(color, const string[])
{
  	for(new i = 0; i < MAX_PLAYERS; i++)
 	{
		if(GetPVarInt(i,"Eingeloggt") == 1 && !IsPlayerNPC(i) && IsPlayerConnected(i) && i != INVALID_PLAYER_ID)
 		{
		    if((Spieler[i][pLevel] < 3 || Spieler[i][pAdmin] <= 8))
		    {
		        if(Spieler[i][pNeuling] == 0)
		        {
					SCM(i,color,string);
				}
			}
		}
	}
	return 1;
}
