COMMAND:auspumpen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid,string[128],Float:Pos[3],kraftstoff[25];
	if(isPlayerInJob(playerid,12) || isPlayerInFrakt(playerid,11))
	{//                              adac ls                                                               oamt                                             adac sf
		if(IsPlayerInRangeOfPoint(playerid,5.0,1527.0393,-1458.1764,9.5000) || IsPlayerInRangeOfPoint(playerid,5.0,866.4864,-1252.8175,14.9805) || IsPlayerInRangeOfPoint(playerid,5.0,-2031.9906,144.0798,28.8359))
		{
			if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" /auspumpen [VehicleID]");
		    if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
		    GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
		    if(!IsVehicleInRangeOfPoint(vehicleid,5.0,Pos[0],Pos[1],Pos[2]))return SCM(playerid,SAMP_WEISS,"Fahrzeug nicht in deiner Nähe.");
			if(vFahrzeug[vehicleid][FailGas] == VehicleInfo[GetVehicleModel(vehicleid)-400][vtankklasse])return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug muss nicht ausgepumpt werden.");
		    switch(vFahrzeug[vehicleid][FailGas])
			{
				case 1:{kraftstoff="Benzin";}
				case 2:{kraftstoff="Diesel";}
				case 3:{kraftstoff="Turbobenzin";}
				case 4:{kraftstoff="Kerosin";}
				default:{kraftstoff="ERROR";}
			}
			format(string,sizeof(string),""IINFO" du hast gerade das Fahrzeug %s von dem Treibstoff %s ausgepumpt.",VehicleDefinations[GetVehicleModel(vehicleid)-400],kraftstoff);
			SCM(playerid,SAMP_WEISS,string);
			vFahrzeug[vehicleid][Tank] = 0;
			vFahrzeug[vehicleid][FailGas] = 0;
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier kein Fahrzeug auspumpen.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job./Du bist nicht in der jeweiligen Fraktion.");
}
