					//format(string,sizeof(string),"Hauserstellungs Fortschritt:\nPreis: %i$\nLevel zum kauf: %i\nMieter Slots: %i\nInterior Spawn: X=%i\nY=%i\nZ=%i\nInterior-ID: %i\nVirtual-World-ID: %i\nGebe nun die Beschreibung ein die am Haus stehen soll:",
					//HausInfo[MakeHaus[playerid]][haus_preis],HausInfo[MakeHaus[playerid]][haus_level],HausInfo[MakeHaus[playerid]][haus_slots],Homestore[HausInfo[MakeHaus[playerid]][haus_innenraum]][Hx],Homestore[HausInfo[MakeHaus[playerid]][haus_innenraum]][Hy],Homestore[HausInfo[MakeHaus[playerid]][haus_innenraum]][Hz],Homestore[HausInfo[MakeHaus[playerid]][haus_innenraum]][Hint],MakeHaus[playerid]);
				    //ShowPlayerDialog(playerid,HCREATE_DIALOG_HAUSBESCHREIBUNG,DIALOG_STYLE_INPUT,"Hauserstellung Schritt 5",string,"Weiter","Zurück");
				    ShowPlayerDialog(playerid,HCREATE_DIALOG_HAUSBESCHREIBUNG,DIALOG_STYLE_INPUT,""ClanTagDialoge" Haus -> Straße",""#HTML_WEISS"Bitte gebe nun eine Gültige Straße ein!","Weiter","Zurück");
					return SCM(playerid,SAMP_WEISS,""IINFO" nicht mehr als 64 zeichen benutzen.");
				}
				else
				{
				    strmid(HausInfo[MakeHaus[playerid]][haus_beschreibung],inputtext,0,strlen(inputtext),150);
				    //format(string,sizeof(string),"Hauserstellungs Fortschritt:\nPreis: %i$\nLevel zum kauf: %i\nMieter Slots: %i\nAussen Spawn:\nX=%i\nY=%i\nZ=%i\nInterior Spawn:\nX=%i\nY=%i\nZ=%i\nInterior-ID: %i\nVirtual-World-ID: %i\nHaus-Beschreibung: %s\n\n"#SERVERNAME"",
					//HausInfo[MakeHaus[playerid]][haus_preis],HausInfo[MakeHaus[playerid]][haus_level],HausInfo[MakeHaus[playerid]][haus_slots],HausInfo[MakeHaus[playerid]][haus_x],HausInfo[MakeHaus[playerid]][haus_y],HausInfo[MakeHaus[playerid]][haus_z],
