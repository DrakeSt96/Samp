	return 1;
}
public StopPlayerPlaySound(playerid)
{
    PlayerPlaySound(playerid,1063,0.0,0.0,0.0);
	PlayerPlaySound(playerid,1069,0.0,0.0,0.0);
	PlayerPlaySound(playerid,1077,0.0,0.0,0.0);
	PlayerPlaySound(playerid,1098,0.0,0.0,0.0);
	PlayerPlaySound(playerid,1166,0.0,0.0,0.0);
	PlayerPlaySound(playerid,1184,0.0,0.0,0.0);
	PlayerPlaySound(playerid,1186,0.0,0.0,0.0);
	PlayerPlaySound(playerid,1188,0.0,0.0,0.0);
	PlayerPlaySound(playerid,1036,0.0,0.0,0.0);
	return 1;
}
public CountDown(countdownc)
{
	new string[25],r = RaceStarted;
	switch(countdownc)
	{
	case 0:
	{
	    CountdownSec--;
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && GetPVarInt(i,"Eingeloggt") == 1)
		    {
			    format(string,sizeof(string),"~g~%i",CountdownSec);
			    GameTextForPlayer(i,string,1000,3);
			    PlayerPlaySound(i,1056,0.0,0.0,0.0);
			    if(CountdownSec <= 0)
			    {
				    GameTextForPlayer(i,"~y~LOS LOS LOS",1000,3);
				    PlayerPlaySound(i,1057,0.0,0.0,0.0);
			    }
		    }
		}
		if(CountdownSec <= 0)
	    {
		    CountdownSec = 0;
		    KillTimer(CountDownTimer);
	    }
    }
	case 1:
	{
		RCountdownSec--;
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && GetPVarInt(i,"Eingeloggt") == 1)
		    {
			    if(InviteInRace[i] == 1)
				{
				    format(string,sizeof(string),"~g~%i",RCountdownSec);
				    GameTextForPlayer(i,string,1000,3);
				    PlayerPlaySound(i,1056,0.0,0.0,0.0);
				    if(RCountdownSec <= 0)
				    {
				        if(!IsNosVehicleInvalid(GetVehicleModel(RaceFahrzeug[i]))){
			                AddVehicleComponent(RaceFahrzeug[i], 1010);
						}
						if(IsPlayerInAnyVehicle(i))
						{
							SetVehicleHealth(GetPlayerVehicleID(i), 1500);
							RepairVehicle(GetPlayerVehicleID(i));
							vFahrzeug[GetPlayerVehicleID(i)][Tank] = VehicleInfo[GetVehicleModel(GetPlayerVehicleID(i))-400][vtankvolumen];
							MotorDown[GetPlayerVehicleID(i)] = 0;
    						vFahrzeug[GetPlayerVehicleID(i)][FailGas] = 0;
						}
					    TogglePlayerControllable(i,true);
					    RaceBestzeit[i] = gettime();
						SCM(i,SAMP_WEISS,"Los Los Los !!!");
						DisablePlayerRaceCheckpoint(i);
						RaceCps[i] = 0;
						PlayerTextDrawShow(i,RACEdraw[i][0]);
						format(string,sizeof(string),"%s",RaceName[r]);
						PlayerTextDrawSetString(i,RACEdraw[i][0],string);
						PlayerTextDrawShow(i,RACEdraw[i][1]);
						PlayerTextDrawShow(i,RACEdraw[i][2]);
						format(string,sizeof(string),"0/%i ~y~Cps",RaceMaxCps);
						PlayerTextDrawSetString(i,RACEdraw[i][2],string);
						PlayerTextDrawShow(i,RACEdraw[i][3]);
						PlayerTextDrawSetString(i,RACEdraw[i][3],"-");
						PlayerTextDrawShow(i,RACEdraw[i][4]);
						PlayerTextDrawSetString(i,RACEdraw[i][4],"-");
						PlayerTextDrawShow(i,RACEdraw[i][5]);
						PlayerTextDrawSetString(i,RACEdraw[i][5],"-");
						if(RaceMode[r] == 0 || RaceMode[r] == 2 || RaceMode[r] == 3)
						{
							SetPlayerRaceCheckpoint(i,CP_TYPE_GROUND_NORMAL,RaceInfo[r][0][0],RaceInfo[r][0][1],RaceInfo[r][0][2],RaceInfo[r][1][0],RaceInfo[r][1][1],RaceInfo[r][1][2],RACE_CP_SIZE[r][0]);
						}
						else if(RaceMode[r] == 1)
						{
							SetPlayerRaceCheckpoint(i,CP_TYPE_AIR_NORMAL,RaceInfo[r][0][0],RaceInfo[r][0][1],RaceInfo[r][0][2],RaceInfo[r][1][0],RaceInfo[r][1][1],RaceInfo[r][1][2],RACE_CP_SIZE[r][0]);
						}
						RCountdownSec = 0;
						BeforeRace[i] = false;
					    KillTimer(RCountDownTimer);
					    GameTextForPlayer(i,"~y~LOS LOS LOS",1000,3);
					    PlayerPlaySound(i,3201,0.0,0.0,0.0);
				    }
			    }
			}
		}
	}
	}
    return 1;
}

public StartKartRace(playerid)
{
	new string[10];
    Spieler[playerid][pKartCountdown]++;
    format(string,sizeof(string),"~g~%i",5-Spieler[playerid][pKartCountdown]);
    GameTextForPlayer(playerid,string,1000,3);
    PlayerPlaySound(playerid,1056,0.0,0.0,0.0);
	if(Spieler[playerid][pKartCountdown] >= 5)
	{
		TogglePlayerControllable(playerid,true);
	    Spieler[playerid][pKartCountdown] = gettime();
		SCM(playerid,SAMP_WEISS,"Los Los Los !!!");
		SCM(playerid,SAMP_WEISS,"Steige aus dem Fahrzeug,falls du keine Lust mehr hast zu fahren.");
	    DisablePlayerRaceCheckpoint(playerid);
	    GameTextForPlayer(playerid,"~y~LOS LOS LOS",1000,3);
	    PlayerPlaySound(playerid,3201,0.0,0.0,0.0);
	    Spieler[playerid][pKartracingCP1] = 1;
		SetPlayerRaceCheckpoint(playerid,CP_TYPE_GROUND_NORMAL,KartRace[0][0],KartRace[0][1],KartRace[0][2],KartRace[1][0],KartRace[1][1],KartRace[1][2],6.0);
		KillTimer(Spieler[playerid][pKartTimer]);
		return 1;
	}
	return 1;
}
public RespawnVehicles()
{
	for(new pveh=0;pveh<sizeof(AutohausVehicle);pveh++)
	if(IsVehicleEmpty(Pvehicles[pveh]))
	{
		SetVehicleToRespawn(Pvehicles[pveh]);
	}
	for(new fveh=0;fveh<sizeof(FvehicleBuyVehicles);fveh++)
	if(IsVehicleEmpty(Fvehicles[fveh]))
	{
		SetVehicleToRespawn(Fvehicles[fveh]);
	}
	SetTimer("RespawnVehicles",60354*3,false);
	return 1;
}
public FahrschulTutorial(playerid,schein)
{
	if(schein == 1)
	{
		switch(FschulTutTime[playerid])
		{
			case 1:
			{
				SpamChat(playerid,0);// 0 = nur für einen spieler wird der chat kontrolliert 100 zeilen voll gespamt,bei 1 = für alle spieler
				SCM(playerid,SAMP_WEISS,"|____ Willkommen zur Führerscheinprüfung ____|");
				SCM(playerid,SAMP_WEISS,"________________________________________________________________________________________________________");
				SCM(playerid,SAMP_WEISS,"Herzlich Willkommen zur theoretischen Prüfung. Nun werden dir die Regeln des Staßenverkehrs erklärt.");
				SCM(playerid,SAMP_WEISS,"Gut aufpassen, denn es werden dir danach einige Fragen gestellt!");
				SCM(playerid,SAMP_WEISS,"________________________________________________________________________________________________________");
			}
			case 15:
			{
				SpamChat(playerid,0);// 0 = nur für einen spieler wird der chat kontrolliert 100 zeilen voll gespamt,bei 1 = für alle spieler
				SCM(playerid,SAMP_WEISS,"|____ Geschwindigkeit ____|");
				SCM(playerid,SAMP_WEISS,"________________________________________________________________________________________________________");
				SCM(playerid,SAMP_WEISS,"Hier gilt eine Richtgeschwindigkeit von 80 Km/h.");
				SCM(playerid,SAMP_WEISS,"In der Stadt könnten Blitzer verteilt sein. Solltest du deren vorgegebene Richtgeschwindigkeit überschreiten,");
				SCM(playerid,SAMP_WEISS,"musst du mit Strafen rechnen!");
				SCM(playerid,SAMP_WEISS,"________________________________________________________________________________________________________");
			}
			case 30:
			{
				SpamChat(playerid,0);// 0 = nur für einen spieler wird der chat kontrolliert 100 zeilen voll gespamt,bei 1 = für alle spieler
				SCM(playerid,SAMP_WEISS,"|____ Fahrspur ____|");
