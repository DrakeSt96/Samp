		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast %s zu dir geportet.",SpielerName(pID));
		SCM(playerid,SAMP_WEISS,string);
	}
	else
	{
		SetPlayerPosEx(pID,x,y + 1,z);
		SetPlayerInterior(pID,GetPlayerInterior(playerid));
		SetPlayerVirtualWorld(pID,GetPlayerVirtualWorld(playerid));
		format(string,sizeof(string),"%s hat dich geportet.",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast %s zu dir geportet.",SpielerName(pID));
		SCM(playerid,SAMP_WEISS,string);
	}
	return 1;
}
COMMAND:readall(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	if(Spieler[playerid][IreadALL] == 0)
	{
		Spieler[playerid][IreadALL] = 1;
		SCM(playerid,SAMP_WEISS,""IINFO" du kannst momentan alle Chats mitverfolgen!");
	}
	else if(Spieler[playerid][IreadALL] == 1)
	{
		Spieler[playerid][IreadALL] = 0;
		SCM(playerid,SAMP_WEISS,""IINFO" du kannst jetzt nicht mehr den momentanen Server-Chat mitverfolgen!");
	}
	return 1;
}
COMMAND:explodet(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new pID,Float:x,Float:y,Float:z,string[128];
	if(!isPlayerAnAdmin(playerid,6))return SendClientMessage (playerid,SAMP_WEISS,""IINFO" du bist kein "#SERVERTAG" Teammitglied./Du hast nicht den jeweiligen Adminrang.");
	if(sscanf(params,"u",pID))return SendClientMessage (playerid,SAMP_WEISS,""#IINFO" /explodet [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	GetPlayerPos(pID,x,y,z);
	CreateExplosion(x,y,z,7,15);
	CreateExplosion(x,y,z,7,15);
	CreateExplosion(x,y,z,7,15);
	CreateExplosion(x,y,z,7,15);
	CreateExplosion(x,y,z,7,15);
	AddFire(x,y,z,GetPlayerVirtualWorld(playerid),true);
	format(string,sizeof(string),""IINFO" du hast %s explodieren lassen.",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,string);
    format(string,sizeof(string),"%s lies dich explodieren.",SpielerName(playerid));
    SCM(pID,SAMP_WEISS,string);
	return 1;
}

COMMAND:setweather(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new cmd[15],citycmd[3],string[128];
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
    if(sscanf(params,"s[15]s[3]",cmd,citycmd))return SCM(playerid,SAMP_WEISS,""IINFO" /setweather [Normal/Regen/Sturm/Nebel/Schnee/Zufall][LS/SF/LV]");
    if(strcmp(citycmd,"LS",true) == 0)
	{
		if(strcmp(cmd,"Normal",true) == 0)
		{
			KillTimer(WeatherTimer);
			WeatherTimer = SetTimer("WeatherChange",60000*ChangeweatherinMin,true);
			UseBadWeather[0] = 0;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) ändert die Wetterverhältnisse in Los Santos auf normal.",Spieler[playerid][pName],playerid);
			SendAdminMessage(GRUEN,string);
			SendClientMessageToAll(ORANGE,""#HTML_BLAU"Wetter Station"#HTML_WEISS": Es liegt eine Wetteränderung in ganz San Andreas vor.");
			return 1;
		}
		if(strcmp(cmd,"Regen",true) == 0)
		{
			KillTimer(WeatherTimer);
			WeatherTimer = SetTimer("WeatherChange",60000*ChangeweatherinMin,true);
			UseBadWeather[0] = 8;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) ändert die Wetterverhältnisse in Los Santos auf regnerisch.",Spieler[playerid][pName],playerid);
			SendAdminMessage(GRUEN,string);
			SendClientMessageToAll(ORANGE,""#HTML_BLAU"Wetter Station"#HTML_WEISS": Es liegt eine Wetteränderung in ganz San Andreas vor.");
			return 1;
		}
		if(strcmp(cmd,"Sturm",true) == 0)
		{
			KillTimer(WeatherTimer);
			WeatherTimer = SetTimer("WeatherChange",60000*ChangeweatherinMin,true);
			UseBadWeather[0] = 16;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) ändert die Wetterverhältnisse in Los Santos auf stürmisch.",Spieler[playerid][pName],playerid);
			SendAdminMessage(GRUEN,string);
			SendClientMessageToAll(ORANGE,""#HTML_BLAU"Wetter Station"#HTML_WEISS": Es liegt eine Wetteränderung in ganz San Andreas vor.");
			return 1;
		}
		if(strcmp(cmd,"Nebel",true) == 0)
		{
			KillTimer(WeatherTimer);
			WeatherTimer = SetTimer("WeatherChange",60000*ChangeweatherinMin,true);
			UseBadWeather[0] = 9;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) ändert die Wetterverhältnisse in Los Santos auf nebelig.",Spieler[playerid][pName],playerid);
			SendAdminMessage(GRUEN,string);
			SendClientMessageToAll(ORANGE,""#HTML_BLAU"Wetter Station"#HTML_WEISS": Es liegt eine Wetteränderung in ganz San Andreas vor.");
			return 1;
		}
		if(strcmp(cmd,"Schnee",true) == 0)
		{
			if(monat < 10 && monat > 1)return SCM(playerid,SAMP_WEISS,"Es ist noch Sommerzeit.");
			KillTimer(WeatherTimer);
			WeatherTimer = SetTimer("WeatherChange",60000*ChangeweatherinMin,true);
			UseBadWeather[0] = 8;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) ändert die Wetterverhältnisse in Los Santos auf Schnee.",Spieler[playerid][pName],playerid);
			SendAdminMessage(GRUEN,string);
			SendClientMessageToAll(ORANGE,""#HTML_BLAU"Wetter Station"#HTML_WEISS": Es liegt eine Wetteränderung in ganz San Andreas vor.");
			return 1;
		}
		if(strcmp(cmd,"Zufall",true) == 0)
		{
			KillTimer(WeatherTimer);
