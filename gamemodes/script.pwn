COMMAND:call(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[128];
	if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
	if(Spieler[playerid][pHandystate] == 0)return SCM(playerid,SAMP_WEISS,"Dein Handy ist aus.");
	if(ReturnHempfangRate(playerid) == -1)return SCM(playerid,SAMP_WEISS,"Kein Empfang.");
	if(Spieler[playerid][pMuted] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist gemuted und kannst somit niemanden anrufen.");
	if(Spieler[playerid][pHandyFlat] == 0)
	{
		if(Spieler[playerid][pHandyCoins] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Guthaben!");
	}
	if(Spieler[playerid][pCallHim] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist schon am Telefonieren.");
	ShowPlayerDialog(playerid,DIALOG_HANDY_CALL,DIALOG_STYLE_INPUT,HandyInfo[Spieler[playerid][pHandy]][Handyname],""HTML_WEISS"Gib nun bitte die "IINFO2"Nummer"#HTML_WEISS" des Spielers ein, denn du "IINFO2"anrufen"#HTML_WEISS" willst!","Anrufen","Zurück");
    format(string,sizeof(string),"** %s nimmt sein %s raus **",SpielerName(playerid),HandyInfo[Spieler[playerid][pHandy]][Handyname]);
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	return 1;
}
COMMAND:sms(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[128];
	if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
	if(Spieler[playerid][pHandystate] == 0)return SCM(playerid,SAMP_WEISS,"Dein Handy ist aus.");
	if(ReturnHempfangRate(playerid) == -1)return SCM(playerid,SAMP_WEISS,"Kein Empfang.");
	if(Spieler[playerid][pMuted] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist gemuted und kannst somit niemanden anrufen.");
    if(Spieler[playerid][pHandyFlat] == 0)
	{
		if(Spieler[playerid][pHandyCoins] == 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Guthaben!");
	}
	if(Spieler[playerid][pCallHim] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist schon am Telefonieren.");
	ShowPlayerDialog(playerid,DIALOG_HANDY_SMS_eins,DIALOG_STYLE_INPUT,HandyInfo[Spieler[playerid][pHandy]][Handyname],""HTML_WEISS"Gib nun bitte die "IINFO2"Nummer"#HTML_WEISS" des Spielers ein, denn du eine "IINFO2"SMS"#HTML_WEISS" schreiben willst!","Weiter","Zurück");
	format(string,sizeof(string),"** %s nimmt sein %s raus **",SpielerName(playerid),HandyInfo[Spieler[playerid][pHandy]][Handyname]);
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	return 1;
}

COMMAND:befreien(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	new string[128],Float:x,Float:y,Float:z;
	GetPlayerPos(playerid,x,y,z);
	if((Spieler[playerid][pHandy] != 0 && Spieler[playerid][pHandystate] != 0 && ReturnHempfangRate(playerid) != -1) || ReturnTelefonzellenID(playerid) != -1)
	{
		if(Spieler[playerid][pCallServiceWheelman] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits eine Befreiung angefordert.");
		Spieler[playerid][pCallServiceWheelman] = true;
	    SCM(playerid,WEISS,"Nachricht abgesendet.");
		if((x > -992.5172 && x < 4000.0000) && (y < 528.0000 && y > -4000.0000))//Los Santos
		{
			SCM(playerid,SAMP_WEISS,"SMS: Ich benötige sofortige Hilfe von euch,bin gefangen/werde verfolgt! Bitte helft mir bin in Los Santos!,Empfänger: La Cosa Nostra (-)");
			format(string,sizeof(string),"SMS: Ich benötige sofortige Hilfe von euch,bin gefangen/werde verfolgt! Bitte helft mir bin in Los Santos!,Sender: %s (%i)",SpielerName(playerid),Spieler[playerid][pPhonenumber]);
	    }
		if((x > -4000.0000 && x < -992.5172) && (y < 4000.0000 && y > -4000.0000))//San Fierro
		{
			SCM(playerid,SAMP_WEISS,"SMS: Ich benötige sofortige Hilfe von euch,bin gefangen/werde verfolgt! Bitte helft mir bin in San Fierro!,Empfänger: La Cosa Nostra (-)");
			format(string,sizeof(string),"SMS: Ich benötige sofortige Hilfe von euch,bin gefangen/werde verfolgt! Bitte helft mir bin in San Fierro!,Sender: %s (%i)",SpielerName(playerid),Spieler[playerid][pPhonenumber]);
	    }
		if((x > -992.5172 && x < 4000.0000) && (y < 4000.0000 && y > 528.0000))//Las Venturas
		{
		    SCM(playerid,SAMP_WEISS,"SMS: Ich benötige sofortige Hilfe von euch,bin gefangen/werde verfolgt! Bitte helft mir bin in Las Venturas!,Empfänger: La Cosa Nostra (-)");
			format(string,sizeof(string),"SMS: Ich benötige sofortige Hilfe von euch,bin gefangen/werde verfolgt! Bitte helft mir bin in Las Venturas!,Sender: %s (%i)",SpielerName(playerid),Spieler[playerid][pPhonenumber]);
	    }
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && isPlayerInFrakt(i,12))
			{
				SCM(i,SAMP_WEISS,string);
				SCM(i,SAMP_WEISS,""IINFO" /accept befreiung");
				PlayerPlaySound(i,1137,0.0,0.0,0.0);
			}
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy./Dein Handy ist aus./Kein Empfang./An keiner Telefonzelle.");
}
COMMAND:dienste_3(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	new i = ReturnTelefonzellenID(playerid);
	if((Spieler[playerid][pHandy] != 0 && Spieler[playerid][pHandystate] != 0 && ReturnHempfangRate(playerid) != -1) || i != -1)
	{
		if(i != -1)
		{
			if(TeleZelleInfo[i][EGmBhHp] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" die Telefonzelle ist defekt,rufe einen Elektroniker!");
		}
		ShowPlayerNotrufe(playerid);
		//ShowPlayerDialog(playerid,DIALOG_TZELLE_DIENSTE,DIALOG_STYLE_LIST,""ClanTagDialoge" Services & Notrufe",""#HTML_BLAU"1."#HTML_WEISS" LSPD\n"#HTML_BLAU"2."#HTML_WEISS" Medic\n"#HTML_BLAU"3."#HTML_WEISS" Feuerwehr\n"#HTML_BLAU"4. "#HTML_WEISS"Abschlepper\n"#HTML_BLAU"5."#HTML_WEISS" Taxi\n"#HTML_BLAU"6."#HTML_WEISS" Mechaniker\n"#HTML_BLAU"7."#HTML_WEISS" Elektrikern\n"#HTML_BLAU"8."#HTML_WEISS" Müllmann\n"#HTML_BLAU"9."#HTML_WEISS" Befreiung","Rufen","Abbrechen");
	}
	return 1;
}
COMMAND:akku(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
   	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid);
    if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
	if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du musst in einem Fahrzeug sitzen.");
	if(GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 510 || IsVehABike(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem überdachtem Fahrzeug.");
    if(Spieler[playerid][pHandyakku] == 100.0)return SCM(playerid,SAMP_WEISS,""IINFO" dein Akku ist bereits voll.");
	Spieler[playerid][pHandyakku] = 100.0;
	SCM(playerid,SAMP_WEISS,""IINFO" dein Handy wurde erfolgreich aufgeladen.");
	return 1;
}
COMMAND:handy(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(Spieler[playerid][pHandyakku] <= 0.0)return SCM(playerid,SAMP_WEISS,""IINFO" dein Akku ist leer.");
	if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
	ShowPlayerHandyMenu2(playerid);
	return 1;
}
COMMAND:togphone_2(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
	if(Spieler[playerid][pHandyakku] <= 0.0)return SCM(playerid,SAMP_WEISS,""IINFO" dein Akku ist leer.");
	new string[64];
	if(Spieler[playerid][pHandystate] == 0)
	{
		Spieler[playerid][pHandystate] = 1;
		format(string,sizeof(string),"** %s nimmt sein %s raus **",SpielerName(playerid),HandyInfo[Spieler[playerid][pHandy]][Handyname]);
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		ShowHandyDraw(playerid);
		UpdateHandyTextdraw(playerid);
		AkkuTimer[playerid] = SetTimerEx("HandyAkku",120000,true,"i",playerid);
	}
	else if(Spieler[playerid][pHandystate] == 1)
	{
		StopAudioStreamForPlayer(playerid);
		Spieler[playerid][pHandystate] = 0;
		format(string,sizeof(string),"** %s legt sein %s in die Tasche **",SpielerName(playerid),HandyInfo[Spieler[playerid][pHandy]][Handyname]);
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		HideHandyDraw(playerid);
		KillTimer(AkkuTimer[playerid]);
		if(Spieler[playerid][pCallHim] == 1)
		{
			new pID = Spieler[playerid][pCall];
			Spieler[playerid][pCallHim] = 0;
			Spieler[pID][pCallHim] = 0;
			Spieler[pID][pCall] = -1;
			Spieler[playerid][pCall] = -1;
			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
			SetPlayerSpecialAction(pID,SPECIAL_ACTION_STOPUSECELLPHONE);
			SCM(playerid,SAMP_WEISS,""IINFO" du hast das Gespräch beendet.");
			SCM(pID,SAMP_WEISS,""IINFO" der Gesprächspartner hat aufgelegt.");
			PlayerPlaySound(playerid,1077,0.0,0.0,0.0);
			PlayerPlaySound(pID,1077,0.0,0.0,0.0);
			RemovePlayerAttachedObject(pID,8);
			RemovePlayerAttachedObject(playerid,8);
		}
	}
	return 1;
}
COMMAND:tognews(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
