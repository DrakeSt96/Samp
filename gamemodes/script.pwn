				{
					new dirtrand = random(10) + 5;
					if((VehicleLoadTank[vehicleid] + dirtrand) >= 500)return SCM(playerid,SAMP_WEISS,""IINFO" das Reinigungsfahrzeug ist voll. Fahre zur Entsorgungsmaschine. (/cleanmachine)");
					SRubbishInfo[i][RubbishCreated] = false;
