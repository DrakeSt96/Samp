COMMAND:drestart(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	getdate(tag,monat,jahr);
	gettime(stunde,minute,sekunde);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i) && GetPVarInt(i,"Eingeloggt") == 1)
		{
			SaveAccount(i);
		}
	}
	OnGameModeSave();
	format(string,sizeof(string),"[%02d/%02d/%02d] [%02d:%02d:%02d] %s (Adminlevel: %i) hat den Server gerestartet!",tag,monat,jahr,stunde,minute,sekunde,SpielerName(playerid),Spieler[playerid][pAdmin]);
	SendAdminMessage(GRUEN,string);
	format(string,sizeof(string),"Admin: %s (Adminlevel: %i) hat den Server gerestartet(Normrestart)!",Spieler[playerid][pName],Spieler[playerid][pAdmin]);
    Log("Restartssqllog",string);
    GameModeExit();
	return 1;
}

COMMAND:restart(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	SendRconCommand("hostname "#SERVERTAG" Restartet");
	KillTimer(Serverrestarter);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i) && GetPVarInt(i,"Eingeloggt") == 1)
		{
			SaveAccount(i);
		}
	}
	OnGameModeSave();
	Sekunden = 60;
	Serverrestarter = SetTimer("Restart",1000,true);
	getdate(tag,monat,jahr);
	gettime(stunde,minute,sekunde);
	format(string,sizeof(string),"[%02d/%02d/%02d] [%02d:%02d:%02d] %s (Adminlevel: %i) hat den Restart vorgang aktiviert!",tag,monat,jahr,stunde,minute,sekunde,SpielerName(playerid),Spieler[playerid][pAdmin]);
	SendAdminMessage(GRUEN,string);
	format(string,sizeof(string),"Admin: %s (Adminlevel: %i) hat den Server gerestartet(Zeitrestart)!",Spieler[playerid][pName],Spieler[playerid][pAdmin]);
    Log("Restartssqllog",string);
	return 1;
}

COMMAND:klingel(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(IsPlayerInRangeOfPoint(playerid,5,2295.8540,746.2546,1011.4030))
	{
		if(gettime() < Spieler[playerid][pKlingelSpam])return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur alle 30 Sekunden klingeln.");
		SCM(playerid,SAMP_WEISS,""IINFO" du hast geklingelt bitte warte einen Moment.");
		Spieler[playerid][pKlingelSpam] = gettime() + (1*30);
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(isPlayerInFrakt(i,1) && Spieler[i][pDuty] != 0)
				{
					PlayerPlaySound(i,6401,0.0,0.0,0.0);
					format(string,sizeof(string),"HQ: %s verlangt nach einem Beamten!",SpielerName(playerid));
					SCM(i,0x009BFFFF,string);
				}
			}
		}
		return 1;
	}
	if(IsPlayerInRangeOfPoint(playerid,5,1127.9355,-1368.8724,15.1759))
	{
		if(gettime() < Spieler[playerid][pKlingelSpam])return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur alle 30 Sekunden klingeln.");
		SCM(playerid,SAMP_WEISS,""IINFO" du hast geklingelt bitte warte einen Moment.");
		Spieler[playerid][pKlingelSpam] = gettime() + (1*30);
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(isPlayerInFrakt(i,3) && Spieler[i][pDuty] != 0)
				{
					PlayerPlaySound(i,6401,0.0,0.0,0.0);
					format(string,sizeof(string),"HQ: %s verlangt nach einem Arzt!",SpielerName(playerid));
					SCM(i,0x009BFFFF,string);
				}
			}
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier nicht klingeln.");

}

COMMAND:countdown(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new timeidx,string[10];
    if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
    if(sscanf(params,"i",timeidx))return SCM(playerid,SAMP_WEISS,""IINFO" /countdown [Zeit in Sekunden]");
    if(timeidx<1||timeidx>300)return SCM(playerid,SAMP_WEISS,""IINFO" /countdown [Zeit in Sekunden 1-300]");
    SCM(playerid,0x4BB400FF,""IINFO" du hast den Countdown gestartet.");
    KillTimer(CountDownTimer);
    CountdownSec = timeidx;
    ForEachPlayer(i)
    {
	    if(IsPlayerConnected(i) && GetPVarInt(i,"Eingeloggt") == 1)
	    {
		    format(string,sizeof(string),"~g~%i",timeidx);
		    GameTextForPlayer(i,string,1000,3);
		    PlayerPlaySound(i,1056,0.0,0.0,0.0);
	    }
	}
    CountDownTimer = SetTimerEx("CountDown",1000,true,"i",0);
    return 1;
}

COMMAND:flycam(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    new Float:x,Float:y,Float:z;
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	if(Spieler[playerid][pSpectate] != -1)return SCM(playerid,SAMP_WEISS,""IINFO" du spectatest bereits einen Spieler.");
	if(Spieler[playerid][pUseFlyCam] == false)
	{
		GetPlayerPos(playerid,x,y,z);
		Spieler[playerid][pUseFlyCam] = true;
		noclipdata[playerid][flyobject] = CreatePlayerObject(playerid,19300,x,y,z,0.0,0.0,0.0);
		TogglePlayerSpectating(playerid,true);
		AttachCameraToPlayerObject(playerid,noclipdata[playerid][flyobject]);
		SCM(playerid,SAMP_WEISS,""IINFO" du bist im Flycam Modus! Um ihn wieder zu beenden /flycam");
		noclipdata[playerid][cameramode] = CAMERA_MODE_FLY;
	}
	else
	{
		CancelEdit(playerid);
		TogglePlayerSpectating(playerid,false);
		Spieler[playerid][pUseFlyCam] = false;
		DestroyPlayerObject(playerid,noclipdata[playerid][flyobject]);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast den Flycam Modus beendet!");
		noclipdata[playerid][cameramode] = CAMERA_MODE_NONE;
	}
	return 1;
}
COMMAND:clearchat(playerid,const params[])
{
 	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new cl_grund[31],cl_form[156];
	if(sscanf(params,"s[31]",cl_grund)) return SCM(playerid,SAMP_WEISS,""IINFO" /cleachat [Grundangabe]");
	SpamChat(playerid,1);
	format(cl_form,sizeof(cl_form),""IINFO" der Chat wurde von "IINFO2"%s"#HTML_WEISS" gelöscht Grund: %s",SpielerName(playerid),cl_grund);
	SCM(playerid,SAMP_WEISS,cl_form);
	return 1;
}
COMMAND:afk(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits AFK!");
	new string[75],gwzone = GWIsPlayerInWarArea(playerid);
    Spieler[playerid][pAFKKeyStates] = 0;
	Spieler[playerid][pAFKAwayTime] = 0;
	Spieler[playerid][pAWAYFROMKEYBOARD] = 1;
	TogglePlayerControllable(playerid,false);
	format(string,sizeof(string),""IINFO2"AFK seit"#HTML_WEISS"\n%02d:%02d Uhr",stunde,minute);
	AFKLabel[playerid] = Create3DTextLabel(string,SAMP_WEISS,30.0,40.0,50.0,MAX_STREAM_NAME_DISTANCE,0,true);
	Attach3DTextLabelToPlayer(AFKLabel[playerid],playerid,0.0,0.0,-0.2);
	SCM(playerid,SAMP_WEISS,""IINFO2" du bist nun im AFK Modus");
	if(gwzone != -1)
	{
		if(GangwarZones[gwzone][War_Started] == 1)
		{
			SCM(playerid,SAMP_WEISS,""IINFO" da du in einem Gangwargebiet standest wirst du gespawned!");
			SpawnPlayerEx(playerid);
		}
	}
	return 1;
}

COMMAND:back(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht AFK!");
	new string[150],Float:angle;
	GetPlayerFacingAngle(playerid,angle);
	if(IsPlayerInRangeOfPoint(playerid,MAX_SBACKRANGE,Spieler[playerid][SlashBackPos][0],Spieler[playerid][SlashBackPos][1],Spieler[playerid][SlashBackPos][2]) && Spieler[playerid][SlashBackPos][3] == angle)
	{
		format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gekickt. Grund: Verdacht auf AFK-Bot",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(SAMP_WEISS,string);
		format(string,sizeof(string),"%s du wurdest vom Server gekickt.\nDer Grund für den Kick von dem Admin System war: Verdacht auf AFK-Bot.\nFalls du zu unrecht gekickt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[playerid][pName]);
		ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Kick",string,"Verlassen","");
		KickUser(playerid,"System","Verdacht auf AFK-Bot");
	}
	GetPlayerPos(playerid,Spieler[playerid][SlashBackPos][0],Spieler[playerid][SlashBackPos][1],Spieler[playerid][SlashBackPos][2]);
	GetPlayerFacingAngle(playerid,Spieler[playerid][SlashBackPos][3]);
	//HideAfkModus(playerid);
	if(Spieler[playerid][DigiHud] == 0){}
	KillTimer(UpdateAFK[playerid]);
	Delete3DTextLabel(AFKLabel[playerid]);
	Spieler[playerid][pAWAYFROMKEYBOARD] = 0;
	Spieler[playerid][pAFKAwayTime] = 0;
	Spieler[playerid][pAFKKeyStates] = 0;
	//format(string,sizeof(string),"* %s ist nun nicht mehr im AFK Modus (AFK Modus deaktiviert)",SpielerName(playerid));
	//PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	SCM(playerid,SAMP_WEISS,""IINFO" du bist nun nicht mehr im AFK Modus.");
	if(Spieler[playerid][pAFKPDAYDOWN] == true) Spieler[playerid][pAFKPDAYDOWN] = false;
	if(Spieler[playerid][pCuffed] == 1 || Spieler[playerid][pTazerd] == 1)return TogglePlayerControllable(playerid,false);
	if(Spieler[playerid][pFreezed] == false) TogglePlayerControllable(playerid,true);
	return 1;
}

COMMAND:delcheck(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(Spieler[playerid][InFahrSchulPruefung] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in einer Fahrschulprüfung.");
   	Spieler[playerid][pIsearch] = 0;
	Spieler[playerid][pFreedomTry] = 0;
   	Spieler[playerid][pOrtenVehORPlayer] = 0;//1 playerid 2 veh 3 service accept
    Spieler[playerid][pOrtenVehIDplayerid] = -1;
   	KillTimer(SpielerOrtenTimer[playerid]);
   	DisablePlayerCheckpoint(playerid);
   	Spieler[playerid][WorkInJob] = 0;
	JobExit(playerid);
    KillTimer(JobTimer[playerid]);
   	SCM(playerid,WEISS,"Checkpoints entfernt.");
	return 1;
}

COMMAND:waffenlagerraub(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
   	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cops,string[128];
 	if(!IsPlayerInRangeOfPoint(playerid,2,978.0559,2072.8401,10.8203))return SCM(playerid,SAMP_WEISS,"Nicht im Waffenlager der Bundeswehr.");
 	if(Spieler[playerid][pDuty] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im Dienst.");
	if(GetPlayerLevel(playerid) < 12)return SCM(playerid,SAMP_WEISS,""IINFO" du musst mindestens Level 12 sein.");
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
	 	if(gettime() > robStatusWaffenlager)
	 	{
			ForEachPlayer(c)
			{
				if(IsPlayerConnected(c))
			    {
					if(isPlayerInFrakt(c,2) || isPlayerInFrakt(c,6))
				    {
					    if(Spieler[c][pDuty] != 0)
					    {
							cops++;
						}
					}
				}
			}
			if(cops < 5)return SCM(playerid,SAMP_WEISS,"Es müssen mindestens 5 Soldaten und/oder FBI Agenten online sein.");
			robStatusWaffenlager = gettime() + (60*480);
			Spieler[playerid][pWaffenlagerRobState] = true;
			SetPlayerAttachedObject(playerid,5,1550,1,0 ,-0.2 ,0,1,450,270,1,1,1);
			SCM(playerid,HIGHROT,""IINFO" du hast ein Verbrechen begangen ( Waffenlager Raub ). Reporter: Anonym");
			SCM(playerid,0xD30023FF,""IINFO" du bist in das Waffenlager eingebrochen,der Überfall dauert insgesamt 10 Minuten.");
			SCM(playerid,0xD30023FF,"Halte es solange durch und verlasse das Waffenlager nicht.");
			SCM(playerid,0xD30023FF,"Die Staatsmächte werden bald da sein,such dir Deckung.");
		    SCM(playerid,0xD30023FF,"Begib dich schnell zum $-Zeichen.");
			format(string,sizeof(string),"%s schreit: Hände hoch das ist ein Überfall !!!",SpielerName(playerid));
			PlayerTalkPublic(playerid,WEISS,string,50);
			SendClientMessageToAll(ORANGE,"News: Ein Krimineller ist in das Waffenlager der Bundeswehr eingebrochen.");
			Spieler[playerid][pWaffenlagerRobTimer] = SetTimerEx("Waffenlagerraub",1000,true,"i",playerid);
			GameTextForPlayer(playerid,"~r~Du versuchst das Waffenlager der Bundeswehr auszurauben",3000,3);
			MoveDynamicObject(tor[96],973.15155, 2067.90112, 11.47930+6,1);
			MoveDynamicObject(tor[97],977.71112, 2072.88623, 11.47930+6,1);
			PlayerHearMusicInRange(1064, 2083.1001, 9.8,1035,5,1,2000);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(GetPVarInt(i,"Eingeloggt") == 0)
					{
						if(isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
						{
							if(Spieler[i][pDuty] != 0)
							{
								SCM(i,DUNKELBLAU,"HQ: An alle Einheiten, das Waffenlager der Bundeswehr wird überfallen!");
							}
						}
					}
				}
			}
			return 1;
		}
		else
		{
			new waffenlagerrobtime = robStatusWaffenlager-gettime();
			format(string,sizeof(string),""IINFO" du kannst das Waffenlager erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten ausrauben.",floatround(waffenlagerrobtime/60),floatround(waffenlagerrobtime%60));
			SCM(playerid,SAMP_WEISS,string);
		}
	}
	else
	{
	    SCM(playerid,SAMP_WEISS,"Nur Gang/Mafienmitglieder können das Waffenlager überfallen!");
	}
	return 1;
}
COMMAND:bankraub(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
   	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cops,string[128];
 	if(!IsPlayerInRangeOfPoint(playerid,5.0,269.0677,164.7019,989.6183) && GetPlayerVirtualWorld(playerid) != 0)return SCM(playerid,SAMP_WEISS,"Nicht in der Bank of San Andreas.");
 	if(Spieler[playerid][pDuty] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im Dienst.");
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,2))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
	 	if(gettime() > robStatusLosSantos)
	 	{
			ForEachPlayer(c)
			{
				if(IsPlayerConnected(c))
			    {
					if(isPlayerInFrakt(c,1) || isPlayerInFrakt(c,2) || isPlayerInFrakt(c,6))
				    {
					    if(Spieler[c][pDuty] != 0)
					    {
							cops++;
						}
					}
				}
			}
			if(cops < 4)return SCM(playerid,SAMP_WEISS,"Es müssen mindestens 4 Beamte online sein.");
			robStatusLosSantos = gettime() + (60*360);
			Spieler[playerid][pBankRobState] = true;
			SetPlayerAttachedObject(playerid,5,1550,1,0 ,-0.2 ,0,1,450,270,1,1,1);
			Spieler[playerid][pSuspectPoints]++;
			SCM(playerid,HIGHROT,""IINFO" du hast ein Verbrechen begangen ( Bankraub ). Reporter: Anonym");
			SCM(playerid,0xD30023FF,""IINFO" du bist in den Tresor der Bank eingebrochen,der Überfall dauert insgesamt 10 Minuten.");
			SCM(playerid,0xD30023FF,"Halte es solange durch und verlasse den Tresorraum nicht.");
			SCM(playerid,0xD30023FF,"Die Staatsmächte werden bald da sein,such dir Deckung.");
		    SCM(playerid,0xD30023FF,"Begib dich schnell zum $-Zeichen.");
			format(string,sizeof(string),"%s schreit: Hände hoch das ist ein Überfall !!!",SpielerName(playerid));
			PlayerTalkPublic(playerid,WEISS,string,50);
			SendClientMessageToAll(ORANGE,"News: Ein Krimineller ist in die Bank von San Andreas eingebrochen.");
			Spieler[playerid][pBankRobTimer] = SetTimerEx("Bankraub",1000,true,"i",playerid);
			GameTextForPlayer(playerid,"~r~Du versuchst die Bank of San Andreas auszurauben",3000,3);
			MoveDynamicObject(tor[17],1472.04,-998.54,44.58+6,1);
			PlayerHearMusicInRange(1472.04,-998.54,44.58,1035,5,1,2000);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(GetPVarInt(i,"Eingeloggt") == 0)
					{
						if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
						{
							if(Spieler[i][pDuty] != 0)
							{
								SCM(i,DUNKELBLAU,"HQ: An alle Einheiten, die Bank of San Andreas wird überfallen!");
							}
						}
					}
				}
			}
			return 1;
		}
		else
		{
			new bankrobtime = robStatusLosSantos-gettime();
			format(string,sizeof(string),""IINFO" du kannst die Bank erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten ausrauben.",floatround(bankrobtime/60),floatround(bankrobtime%60));
			SCM(playerid,SAMP_WEISS,string);
		  	return 1;
		}
	}
	else
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	}
	return 1;
}
COMMAND:repcar(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,3))
	{
		if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	    if(IsPlayerInRangeOfPoint(playerid,6.0,1824.1646,-1675.0513,-4.9928) || IsPlayerInRangeOfPoint(playerid,6.0,201.6876,1869.3944,13.1406) || IsPlayerInRangeOfPoint(playerid,6.0,1777.8367,-1120.9999,24.0859))
	    {
			new Float:vehHealth,vehicleid = GetPlayerVehicleID(playerid);
			GetVehicleHealth(GetPlayerVehicleID(playerid),vehHealth);
			if(vehHealth == 1000)return SCM(playerid,SAMP_WEISS,"Fahrzeug muss nicht repariert werden.");
		    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
			if(RepairAVehicle[vehicleid] == 1)return SCM(playerid,SAMP_WEISS,"Dein Fahrzeug wird schon repariert.");
			if(Motor[vehicleid] == true)return SCM(playerid,SAMP_WEISS,""IINFO" der Motor muss aus sein,bevor das Fahrzeug repariert wird.");
			SCM(playerid,0x4BB400FF,"Fahrzeug wird repariert und geprüft! Warte einen Moment.");
			SetCameraBehindPlayer(playerid);
			TogglePlayerControllable(playerid,false);
			RepairAVehicle[vehicleid] = 1;
			if(IsPlayerInRangeOfPoint(playerid,6.0,1777.8367,-1120.9999,24.0859))
			{
			    vFahrzeug[vehicleid][FailGas] = 0;
    			vFahrzeug[vehicleid][Tank] = VehicleInfo[GetVehicleModel(vehicleid)-400][vtankvolumen];
			}
			reptimer[playerid] = SetTimerEx("Repaired",10000,false,"i",playerid);
		    return 1;
		}
		return SCM(playerid,SAMP_WEISS,"An keiner staatlichen Werkstatt.");
    }
    return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:klaukleidung(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /klaukleidung [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pSkinRob] == 1)return SCM(playerid,SAMP_WEISS,"Spieler besitzt keine Kleidung.");
	if(Spieler[pID][pDeath] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht verletzt.");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" du bist zu weit entfernt!");
	Spieler[playerid][pSpecificSkin] = GetPlayerSkin(pID);
	SetPlayerSkin(playerid, Spieler[playerid][pSpecificSkin]);
	Spieler[pID][pSkinRob] = 1;
	new changeskin = random(6);
   	switch(changeskin)
   	{
	    case 0: SetPlayerSkin(pID,154);
	    case 1: SetPlayerSkin(pID,45);
	    case 2: SetPlayerSkin(pID,146);
	    case 3: SetPlayerSkin(pID,252);
	    case 4: SetPlayerSkin(pID,62);
	    case 5: SetPlayerSkin(pID,96);
   	}
	ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,false,true,true,true,5000,SYNC_ALL);
	SCM(pID,SAMP_WEISS,"Ein Unbekannter hat deine Kleidung geklaut.");
	format(string,sizeof string,""IINFO" du hast %s die Kleidung geklaut.",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"** %s klaut %s die Kleidung **",SpielerName(playerid),SpielerName(pID));
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	return 1;
}

COMMAND:umziehen(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pSpecificSkin] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Kleidung mit der du dich umziehen kannst.");
	if(Spieler[playerid][pWearSpecificSkin] == 0)
	{
		Spieler[playerid][pWearSpecificSkin] = 1;
		SetPlayerSkin(playerid,Spieler[playerid][pSpecificSkin]);
		format(string,sizeof(string),"** %s zieht sich heimlich ein Tarnoutfit an **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	}
	else if(Spieler[playerid][pWearSpecificSkin] == 1)
	{
		Spieler[playerid][pWearSpecificSkin] = 0;
	    SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
		format(string,sizeof(string),"** %s zieht sich heimlich sein Tarnoutfit aus **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	}
	return 1;
}

COMMAND:bekleiden(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!IsPlayerInRangeOfPoint(playerid,1.5,307.0991,300.5335,1003.3047))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich hier nicht bekleiden.");
    if(Spieler[playerid][pAdminOnduty] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im Admindienst.");
	if(Spieler[playerid][pHaveMaske] == 0)
	{
		SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
		Spieler[playerid][pHaveMaske] = 1;
		SCM(playerid,SAMP_WEISS,"Info: Die Fraktion übernimmt den Preis für das Umkleiden. ( 100$ pro Kleidungswechsel. )");
	    SCM(playerid,SAMP_WEISS,"Dein Equipment(Maske,Tarnoutfit) wurde dir ausgehändigt.");
	    fverwaltungen[8][Geld] -= 100;
	}
	else if(Spieler[playerid][pHaveMaske] == 1)
	{
		SetPlayerSkin(playerid,Spieler[playerid][pSkin]);
		Spieler[playerid][pHaveMaske] = 0;
		if(Spieler[playerid][pMaske] == 1)
		{
			Spieler[playerid][pMaske] = 0;
			SetPlayerName(playerid,Spieler[playerid][pName]);
			SetPlayerScore(playerid,GetPlayerLevel(playerid));
			RemovePlayerAttachedObject(playerid,1);
		}
	}
	return 1;
}

COMMAND:maske(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[24],cmdtext[20];
    if(Paintball[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in der Paintball Arena und kannst somit nicht Maskiert sein.");
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pHaveMaske] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst keine Maske mit dir.");
    if(Spieler[playerid][pAdminOnduty] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im Admindienst.");
	if(sscanf(params,"s[20]",cmdtext))return SCM(playerid,SAMP_WEISS,""IINFO" /maske [Absetzen/Rot/Grün/Weiß]");
	if(strcmp(cmdtext,"Absetzen",true) == 0)
	{
		if(Spieler[playerid][pMaske] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst keine Maske.");
		Spieler[playerid][pMaske] = 0;
		SetPlayerName(playerid,Spieler[playerid][pName]);
		SetPlayerScore(playerid,GetPlayerLevel(playerid));
		SCM(playerid,SAMP_WEISS,"** Du hast deine Maske abgenommen **");
		RemovePlayerAttachedObject(playerid,1);
		return 1;
	}
	if(strcmp(cmdtext,"Rot",true) == 0)
	{
	    if(Spieler[playerid][pMaske] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst bereits eine Maske.");
	    Spieler[playerid][pMaske] = 1;
	    format(string,sizeof(string),"Unbekannter(%i)",random(50) + 122);
	    SetPlayerName(playerid,string);
	    SetPlayerScore(playerid,random(50) + 122);
		SCM(playerid,SAMP_WEISS,"** Du ziehst deine Tarnung auf **");
		SetPlayerAttachedObject(playerid,1,19037,2,0.108000,0.046000,-0.001000,79.900032,80.200012,8.999998);
		return 1;
	}
	if(strcmp(cmdtext,"Grün",true) == 0)
	{
		if(Spieler[playerid][pMaske] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst bereits eine Maske.");
	    Spieler[playerid][pMaske] = 1;
	    format(string,sizeof(string),"Unbekannter(%i)",random(50) + 122);
	    SetPlayerName(playerid,string);
	    SetPlayerScore(playerid,random(50) + 122);
		SCM(playerid,SAMP_WEISS,"** Du ziehst deine Tarnung auf **");
	    SetPlayerAttachedObject(playerid,1,19038,2,0.108000,0.046000,-0.001000,79.900032,80.200012,8.999998);
		return 1;
	}
	if(strcmp(cmdtext,"Weiß",true) == 0)
	{
		if(Spieler[playerid][pMaske] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst bereits eine Maske.");
	    Spieler[playerid][pMaske] = 1;
	    format(string,sizeof(string),"Unbekannter(%i)",random(50) + 122);
	    SetPlayerName(playerid,string);
	    SetPlayerScore(playerid,random(50) + 122);
		SCM(playerid,SAMP_WEISS,"** Du ziehst deine Tarnung auf **");
		SetPlayerAttachedObject(playerid,1,19036,2,0.108000,0.046000,-0.001000,79.900032,80.200012,8.999998);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /maske [Absetzen/Rot/Grün/Weiß]");
}

COMMAND:sturmhaube(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[24];
    if(Paintball[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in der Paintball Arena und kannst somit nicht Maskiert sein.");
	if(!isPlayerInFrakt(playerid,6))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pHaveMaske] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst keine Sturmhaube mit dir.");
    if(Spieler[playerid][pAdminOnduty] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im Admindienst.");
 	if(Spieler[playerid][pMaske] == 0)
 	{
 	    if(Spieler[playerid][pDuty] == 4)
 	    {
		 	Spieler[playerid][pMaske] = 1;
		 	format(string,sizeof(string),"SEAL%i",random(50) + 122);
			SetPlayerName(playerid,string);
		 	SetPlayerScore(playerid,random(50) + 122);
			SCM(playerid,SAMP_WEISS,"** Du ziehst deine Sturmhaube auf **");
			return 1;
 		}
 		else if(Spieler[playerid][pDuty] == 5)
 	    {
		 	Spieler[playerid][pMaske] = 1;
		 	format(string,sizeof(string),"RANGER%i",random(50) + 122);
			SetPlayerName(playerid,string);
		 	SetPlayerScore(playerid,random(50) + 122);
			SCM(playerid,SAMP_WEISS,"** Du ziehst deine Sturmhaube auf **");
			return 1;
 		}
 		else if(Spieler[playerid][pDuty] == 2)
 	    {
		    Spieler[playerid][pMaske] = 1;
		    format(string,sizeof(string),"Unbekannter(%i)",random(50) + 122);
		    SetPlayerName(playerid,string);
		    SetPlayerScore(playerid,random(50) + 122);
			SCM(playerid,SAMP_WEISS,"** Du ziehst deine Sturmhaube auf **");
			SetPlayerAttachedObject(playerid,1,19036,2,0.108000,0.046000,-0.001000,79.900032,80.200012,8.999998);
			return 1;
 		}
	}
 	else
 	{
	 	Spieler[playerid][pMaske] = 0;
		SetPlayerName(playerid,Spieler[playerid][pName]);
		SetPlayerScore(playerid,GetPlayerLevel(playerid));
		SCM(playerid,SAMP_WEISS,"** Du hast deine Sturmhaube abgenommen **");
		RemovePlayerAttachedObject(playerid,1);
		return 1;
 	}
 	return 1;
}
COMMAND:changespawn(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new spawn,string[128];
    if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(!isPlayerAMember(playerid,6))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
    if(sscanf(params,"i",spawn))return SCM(playerid,SAMP_WEISS,""IINFO" /changespawn [1-6]");
	if(spawn<1||spawn>6)return SCM(playerid,SAMP_WEISS,""IINFO" /changespawn [1-6]");
	fsteuern[TerrorSpawn] = spawn;
	format(string,sizeof(string),"%s hat euren FraktionsSpawn geändert.",SpielerName(playerid));
 	SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	return 1;
}
COMMAND:setcontractsrang(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new rang,string[128];
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,6))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(sscanf(params,"i",rang))return SCM(playerid,SAMP_WEISS,""IINFO" /setcontractsrang [Rang]");
	if(rang<0||rang>6)return SCM(playerid,SAMP_WEISS,""IINFO" /setcontractsrang [Rang 1-6]");
	fsteuern[TerrorContractRang] = rang;
	format(string,sizeof(string),"%s hat den Contractrang auf %i gesetzt.",SpielerName(playerid),rang);
    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	return 1;
}
COMMAND:contracts(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[1000],onlinecontracts = 0;
    if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,fsteuern[TerrorContractRang]))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(Spieler[i][pHeadMoney] > 0)
			{
				format(string,sizeof(string),"%s (ID:%i) - Kopfgeld: %i$\n%s",SpielerName(i),i,Spieler[i][pHeadMoney],string);
				ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"Contracts",string,"Verlassen","");
				onlinecontracts++;
			}
		}
	}
	if(onlinecontracts == 0)return SCM(playerid,SAMP_WEISS,"Kein Spieler auf den Kofpgeld ausgestzt ist Online.");
	return 1;
}
COMMAND:delcontract(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],reason[31];
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,fsteuern[TerrorContractRang]))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,"/delcontract [playerid/Name][Grund]");
	if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,"/delcontract [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    Spieler[pID][pHeadMoney] = 0;
	format(string,sizeof(string),"%s hat %s mit %i$ Kopfgeld von der Contractliste gelöscht. Grund: %s",SpielerName(playerid),SpielerName(pID),Spieler[pID][pHeadMoney],reason);
	SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	return 1;
}
COMMAND:contract(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[1000],headmoney;
	if(IsPlayerInRangeOfPoint(playerid,3,-1684.1473,55.7776,-9.2019) || IsPlayerInRangeOfPoint(playerid,3,384.2141,-1886.3217,1.9834) || IsPlayerInRangeOfPoint(playerid,3,2096.2742,1285.2108,10.8203))
	{
		if(sscanf(params,"ud",pID,headmoney))return SCM(playerid,SAMP_WEISS,"/contract [playerid/Name][Betrag]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst auf dich selber kein Kopfgeld aussetzen.");
	    if((GetACMoney(playerid) - headmoney) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Geld.");
		if(headmoney<5000||headmoney>10000000)return SCM(playerid,SAMP_WEISS,"Setze bitte ein Kopfgeld zwischen 5.000$ und 10.000000$ aus.");
		ACMoney(playerid,-headmoney);
		Spieler[pID][pHeadMoney] += headmoney;
		format(string,sizeof(string),""IINFO" du hast erfolgreich ein Kopfgeld in höhe von "IINFO2"%i$"#HTML_WEISS" auf "IINFO2"%s"#HTML_WEISS" ausgesetzt.",headmoney,SpielerName(pID));
		SCM(playerid,0x4BB400FF,string);
		format(string,sizeof(string),"Auftrag: "IINFO2"%s"#HTML_WEISS" hat auf "IINFO2"%s"#HTML_WEISS" (%i$) gesetzt. Gesamtes Kopfgeld: "IINFO2"%i$",SpielerName(playerid),SpielerName(pID),headmoney,Spieler[pID][pHeadMoney]);
		SendFraktionsMessage(Spieler[playerid][pFraktion],SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,"An keinem Contract Punkt.");
}
COMMAND:robc4(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:Pos[3],string[128],cops,pID,pID2;
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
	if(!IsVehicleInRangeOfPoint(BOTarmytransport,10.0,Pos[0],Pos[1],Pos[2]))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe des C4-Transporters.");
    if(gettime() > robStatusC4)
	{
	ForEachPlayer(c)
	{
		if(IsPlayerConnected(c))
	    {
			if(isPlayerInFrakt(c,2) || isPlayerInFrakt(c,6))
		    {
			    if(Spieler[c][pDuty] != 0)
			    {
					cops++;
				}
			}
		}
	}
	if(cops < 2)return SCM(playerid,SAMP_WEISS,"Es müssen mindestens 2 Beamte online sein.");
	if(sscanf(params,"uu",pID,pID2))return SCM(playerid,SAMP_WEISS,""IINFO" /robc4 [playerid/Name(Beifahrer)][playerid/Name(Dieb)]");
    if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler(Beifahrer) nicht eingeloggt!");
    if(GetPVarInt(pID,"Eingeloggt") == 0)return SCM(playerid,SAMP_WEISS,"Spieler(Beifahrer) nicht eingeloggt!");
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    if(!IsPlayerConnected(pID2))return SCM(playerid,SAMP_WEISS,"Spieler(Dieb) nicht eingeloggt!");
    if(GetPVarInt(pID2,"Eingeloggt") == 0)return SCM(playerid,SAMP_WEISS,"Spieler(Dieb) nicht eingeloggt!");
	if(IsPlayerNPC(pID2))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(pID == playerid || pID2 == playerid || pID == pID2)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst als Beifahrer/Dieb angeben.");
    if(!isPlayerInFrakt(pID,8))return SCM(playerid,SAMP_WEISS,"Spieler(Beifahrer) ist nicht in deiner Fraktion.");
    if(!isPlayerInFrakt(pID2,8))return SCM(playerid,SAMP_WEISS,"Spieler(Dieb) ist nicht in deiner Fraktion.");
	if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler(Beifahrer) ist nicht in deinem Fahrzeug.");
    if(!IsPlayerInVehicle(pID2,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler(Beifahrer) ist nicht in deinem Fahrzeug.");
	if(GetPlayerState(pID) != PLAYER_STATE_PASSENGER)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht dein Beifahrer.");
	robStatusC4 = gettime() + (60*60*4);
	Spieler[playerid][pC4RobState] = true;
	Spieler[pID][pC4RobState] = true;
	Spieler[pID2][pC4RobState] = true;
	SCM(playerid,HIGHROT,""IINFO" du hast ein Verbrechen begangen ( C4-Raub ). Reporter: Anonym");
	SCM(playerid,0xD30023FF,"Ihr versucht den C4-Transporter zu überfallen.");
	SCM(playerid,0xD30023FF,"Die Staatsmächte wurden kontaktiert,haltet 3 Minuten durch um den Transporter leer zu räumen.");
    SCM(playerid,0xD30023FF,"Bleib die 5 Minuten so nah wie möglich am Transporter ohne zu sterben,da der Raub sonst abbricht.");
    SCM(pID,HIGHROT,""IINFO" du hast ein Verbrechen begangen ( C4-Raub ). Reporter: Anonym");
	SCM(pID,0xD30023FF,"Ihr versucht den C4-Transporter zu überfallen.");
	SCM(pID,0xD30023FF,"Die Staatsmächte wurden kontaktiert,haltet 3 Minuten durch um den Transporter leer zu räumen.");
    SCM(pID,0xD30023FF,"Bleib die 5 Minuten so nah wie möglich am Transporter ohne zu sterben,da der Raub sonst abbricht.");
    SCM(pID2,HIGHROT,""IINFO" du hast ein Verbrechen begangen ( C4-Raub ). Reporter: Anonym");
	SCM(pID2,0xD30023FF,"Ihr versucht den C4-Transporter zu überfallen.");
	SCM(pID2,0xD30023FF,"Die Staatsmächte wurden kontaktiert,haltet 3 Minuten durch um den Transporter leer zu räumen.");
    SCM(pID2,0xD30023FF,"Bleib die 5 Minuten so nah wie möglich am Transporter ohne zu sterben,da der Raub sonst abbricht.");
	PutPlayerInVehicleEx(pID2,BOTarmytransport,1);
	C4robTimer = SetTimerEx("RobC4Transporter",1000,true,"iii",playerid,pID,pID2);
	PlayerHearMusicInRange(Pos[0],Pos[1],Pos[2],1035,5,1,2000);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 0)
			{
				if(isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
				{
					if(Spieler[i][pDuty] != 0)
					{
						SetPlayerMarkerForPlayer(i,playerid,0xFF0000FF);
						SCM(i,DUNKELBLAU,"HQ: An alle Einheiten, der C4-Transporter wird überfallen!");
					}
				}
			}
		}
	}
	return 1;
	}
	new c4robtime = robStatusC4-gettime();
	format(string,sizeof(string),""IINFO" du kannst den C4-Transporter erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten ausrauben.",floatround(c4robtime/60),floatround(c4robtime%60));
	return SCM(playerid,SAMP_WEISS,string);
}
COMMAND:legbombe(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
	if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Bombe platzieren.");
    if(BombState == true)return SCM(playerid,SAMP_WEISS,"Es wurde bereits eine Bombe gelegt.");
	if((Spieler[playerid][pC4] - 3) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug C4 vorhanden.");
	if(gettime() > bombenstatus)
	{
	    bombenstatus = gettime() + (60*60*4);
		ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,false,true,true,true,5000,SYNC_ALL);
		ShowPlayerDialog(playerid,DIALOG_BOMBELEGEN_DRAHT,DIALOG_STYLE_LIST,"Wähle nun den jeweiligen Draht aus...","{FF0000}Rot\n{00FF04}Grün\n{2B00FF}Blau\n{FFCC00}Gelb","Auswählen","Abbrechen");
	}
	else
	{
	    new legbombetime = bombenstatus-gettime(),string[128];
		format(string,sizeof(string),""IINFO" du kannst erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten eine Bombe legen.",floatround(legbombetime/60),floatround(legbombetime%60));
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	return 1;
}
COMMAND:defuse(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
   	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(IsPlayerInRangeOfPoint(playerid,1.5,BombeX,BombeY,BombeZ) && BombState == true)
		{
			if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
			ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,false,true,true,true,5000,SYNC_ALL);
			ShowPlayerDialog(playerid,DIALOG_BOMBELEGEN_ENTSCHAERFEN,DIALOG_STYLE_LIST,""IINFO" du versuchst die Bombe zu entschärfen...","{FF0000}Draht Rot...\n{00FF04}Draht Grün...\n{2B00FF}Draht Blau...\n{FFCC00}Draht Gelb...","Entschärfen","Abbrechen");
		 	format(string,sizeof(string),"** %s schaut sich den Sprengsatz an **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe des Sprengsatzes./Es wurde keine Bombe gelegt.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:kofferbombe(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[12],string[128];
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if((Spieler[playerid][pC4] - 2) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug C4 vorhanden.");
	if(sscanf(params,"s[12]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /kofferbombe [Normal/Fernzünder/Zünden]");
	if(strcmp(cmd,"Normal",true) == 0)
	{
		if(Spieler[playerid][pKoffer] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Koffer.");
	    new kofferid = Spieler[playerid][pKofferBombID];
		if(KofferInfo[kofferid][KBomb] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits eine Kofferbombe gelegt,sie besteht noch.");
		Spieler[playerid][pC4] -= 2;
		new koffer = CreateDroppedKoffer(playerid,1);
		KofferInfo[koffer][KC4] += 2;
		SCM(playerid,SAMP_WEISS,""IINFO" du hast eine Kofferbombe gelegt. | Falls der Koffer geöffnet wird,explodiert er.");
	    format(string,sizeof(string),"** %s lässt etwas fallen **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	if(strcmp(cmd,"Fernzünder",true) == 0)
	{
		if(Spieler[playerid][pKoffer] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Koffer.");
	    new kofferid = Spieler[playerid][pKofferBombID];
		if(KofferInfo[kofferid][KBomb] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits eine Kofferbombe gelegt,sie besteht noch.");
		Spieler[playerid][pC4] -= 2;
		new koffer = CreateDroppedKoffer(playerid,1);
		KofferInfo[koffer][KC4] += 2;
		Spieler[playerid][pKofferBombID] = koffer;
		SCM(playerid,SAMP_WEISS,""IINFO" du hast eine Kofferbombe mit einem Fernzünder gelegt. | Du kannst die Kofferbombe aus der Ferne zünden.");
		return 1;
	}
	if(strcmp(cmd,"Zünden",true) == 0)
	{
		new koffer = Spieler[playerid][pKofferBombID];
		if(KofferInfo[koffer][KBomb] == 0 || KofferInfo[koffer][Kcreatet] == 0)return SCM(playerid,SAMP_WEISS,"Die Kofferbombe ist bereits hochgegangen./Der Koffer existiert nicht.");
	    GameTextForPlayer(playerid,"~n~ ~n~ ~r~BOOOOOM!!!!",3000,4);
	    SCM(playerid,SAMP_WEISS,""IINFO" du hast den Fernzünder betätigt ... der Koffer ist explodiert.");
		new randompos = random(20),randexploderadius = random(40)+10;
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),true);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		ForEachPlayer(i)
		{
			if(IsPlayerInRangeOfPoint(i,20.0,KofferInfo[koffer][KPos][0],KofferInfo[koffer][KPos][1],KofferInfo[koffer][KPos][2]))
			{
				if(playerid != i)
				{
					Spieler[playerid][pMorde]++;
					SetPlayerACHealth(i,0);
				    SCM(playerid,HIGHROT,""IINFO" du hast ein Verbrechen begangen ( Vorsätzlicher Mord ). Reporter: Anonym");
				}
			}
		}
		DestroyDynamicObject(KofferInfo[koffer][KObject]);
		DestroyDynamic3DTextLabel(KofferLabel[koffer]);
		KofferInfo[koffer][Kcreatet] = 0;
		KofferInfo[koffer][KPos][0] = 0.0;
		KofferInfo[koffer][KPos][1] = 0.0;
		KofferInfo[koffer][KPos][2] = 0.0;
		KofferInfo[koffer][KWorld] = 0;
	    KofferInfo[koffer][KOpium] = 0;
	    KofferInfo[koffer][KSpice] = 0;
	    KofferInfo[koffer][KGanja] = 0;
	    KofferInfo[koffer][KKokain] = 0;
	    KofferInfo[koffer][KMaterials] = 0;
	    KofferInfo[koffer][KMaterialsPakets] = 0;
	    KofferInfo[koffer][KC4] = 0;
	    KofferInfo[koffer][KMoney] = 0;
	    KofferInfo[koffer][KZigarets] = 0;
	    KofferInfo[koffer][KKoeder] = 0;
	    KofferInfo[koffer][KLunch] = 0;
	    KofferInfo[koffer][KBomb] = 0;
	    Spieler[playerid][pKofferBombID] = 0;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /kofferbombe [Normal/Fernzünder/Zünden]");
}
COMMAND:autobombe(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst in einem Fahrzeug keine Autobomben legen.");
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if((Spieler[playerid][pC4] - 2) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug C4 vorhanden.");
	new vehicleid, string[128], Float:vehx, Float:vehy, Float:vehz;
	if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" /autobombe [Vehicle-ID]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
	GetVehiclePos(vehicleid, vehx, vehy, vehz);
	if(!IsPlayerInRangeOfPoint(playerid,3.5,vehx,vehy,vehz))return SCM(playerid,SAMP_WEISS,""IINFO" du musst näher am Fahrzeug stehen.");
	if(vFahrzeug[vehicleid][Carbomb] == 1)return SCM(playerid,SAMP_WEISS,"In diesem Fahrzeug ist bereits eine Bombe verbaut.");
	vFahrzeug[vehicleid][Carbomb] = 1;
	SCM(playerid,SAMP_WEISS,""IINFO" du hast eine Autobombe gelegt. | Bei Motorstart/Motorstop explodiert sie.");
    format(string,sizeof(string),"** %s platziert etwas unter dem Fahrzeug. **",SpielerName(playerid));
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	OnePlayAnim(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0),StopAudioStreamForPlayer(playerid);
	return 1;
}
COMMAND:explode(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
