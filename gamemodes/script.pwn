COMMAND:orgdelete(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new org = Spieler[playerid][pOrgLeader],string[128];
	if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Unternehmer.");
	if(strcmp(Spieler[playerid][pName],OrgInfo[org][OrgOwner],true) == 0)
	{
		format(string,sizeof(string),""IINFO" du hast die Firma: "IINFO2"%s"#HTML_WEISS" aufgelöst.",OrgInfo[org][OrgName]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s hat die Firma: "IINFO2"%s"#HTML_WEISS" aufgelöst.",Spieler[playerid][pName],OrgInfo[org][OrgName]);
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && GetPVarInt(i,"Eingeloggt") == 1 && (Spieler[i][pOrgLeader] == org || Spieler[playerid][pOrgMember] == org))
			{
				SCM(i,SAMP_WEISS,string);
				Spieler[i][pOrgLeader] = 0;
				Spieler[i][pOrgMember] = 0;
			}
		}
		format(string,sizeof(string),"SELECT * FROM spieler WHERE pOrgMember='%d'",org);
	    mysql_function_query(MySQL_R394,string,true,"sql_array2","siii",string,_SQL_REMOVEACCSFROMORG,playerid,MySQL_R394);
	    OrgInfo[org][OrgCreatet] = 0;
	    OrgInfo[org][OrgKasse] = 0;
		strmid(OrgInfo[org][OrgName],"Keinen",0,strlen("Keinen"),32);
		strmid(OrgInfo[org][OrgOwner],"Keinen",0,strlen("Keinen"),24);
		strmid(OrgInfo[org][OrgMotto],"Keins",0,strlen("Keins"),128);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht der Besitzer der Firma.");
}
COMMAND:firmleave(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],org = Spieler[playerid][pOrgMember];
    if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Firma.");
    if(strcmp(Spieler[playerid][pName],OrgInfo[org][OrgOwner],false) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst deine Organisation nicht eigenhändig verlassen.");
	format(string,sizeof(string),"%s hat die Firma "IINFO2"%s"#HTML_WEISS" verlassen.",SpielerName(playerid),OrgInfo[org][OrgName]);
	SendOrganisationsMessage(org,SAMP_WEISS,string);
	Spieler[playerid][pOrgLeader] = 0;
	Spieler[playerid][pOrgMember] = 0;
	return 1;
}
COMMAND:firminvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],org = Spieler[playerid][pOrgLeader];
    if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Unternehmer.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /orginvite [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pOrgMember] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist bereits in einer Organisation.");
	format(string,sizeof(string),"%s (ID:%i) hat dir eine Einladung in die Firma "IINFO2"%s"#HTML_WEISS" gesendet.(/accept orginvite)",SpielerName(playerid),playerid,OrgInfo[org][OrgName]);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" du hast %s (ID:%i) eine Einladung in deine Firma gesendet.",SpielerName(pID),pID);
	SCM(playerid,SAMP_WEISS,string);
	Spieler[pID][pSeller] = playerid;
	Spieler[pID][pAngebot] = 18;
	Spieler[pID][pMenge] = org;
	return 1;
}
COMMAND:firmuninvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],org = Spieler[playerid][pOrgLeader];
    if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Unternehmer.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /orguninvite [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pOrgMember] != org)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Organisation Mitglied.");
	if(strcmp(Spieler[pID][pName],OrgInfo[org][OrgOwner],true) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst den Inhaber der Orgnisation nicht aus der Organisation schmeißen.");
	format(string,sizeof(string),""IINFO" du wurdest von %s (ID:%i) aus der Firma "IINFO2"%s"#HTML_WEISS" geschmissen.",Spieler[playerid][pName],playerid,OrgInfo[org][OrgName]);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),"%s wurde von %s aus der Firma geschmissen.",Spieler[pID][pName],Spieler[playerid][pName]);
	SendOrganisationsMessage(org,SAMP_WEISS,string);
	Spieler[pID][pOrgLeader] = 0;
	Spieler[pID][pOrgMember] = 0;
	return 1;
}
COMMAND:firmleiter(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],org = Spieler[playerid][pOrgLeader];
    if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Unternehmer.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /orgmakeleader [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pOrgMember] != org)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Organisation Mitglied.");
	if(Spieler[pID][pOrgLeader] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast schon eine Firma");
	format(string,sizeof(string),""IINFO" du wurdest von %s (ID:%i) zum Leiter der Firma "IINFO2"%s"#HTML_WEISS" ernannt.",Spieler[playerid][pName],playerid,OrgInfo[org][OrgName]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s hat %s zum Leiter der Firma ernannt.",Spieler[playerid][pName],Spieler[pID][pName]);
	SendOrganisationsMessage(org,SAMP_WEISS,string);
	Spieler[pID][pOrgLeader] = org;
	return 1;
}
COMMAND:firmunleiter(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],org = Spieler[playerid][pOrgLeader];
    if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Unternehmer.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /orgtakeleader [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pOrgMember] != org)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Organisation Mitglied.");
	if(Spieler[pID][pOrgLeader] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht Leiter der Organisation.");
	if(strcmp(Spieler[pID][pName],OrgInfo[org][OrgOwner],true) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst den Inhaber der Orgnisation nicht als Leiter abweisen.");
	format(string,sizeof(string),""IINFO" du wurdest von %s (ID:%i) als Leiter der Firma "IINFO2"%s"#HTML_WEISS" abgewiesen.",Spieler[playerid][pName],playerid,OrgInfo[org][OrgName]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s wurde von %s als Leiter der Firma abgewiesen.",Spieler[pID][pName],Spieler[playerid][pName]);
	SendOrganisationsMessage(org,SAMP_WEISS,string);
	Spieler[pID][pOrgLeader] = 0;
	return 1;
}
