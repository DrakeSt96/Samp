	format(st11,sizeof(st11),""#HTML_BLAU"19."#HTML_WEISS" Personalausweisühr "#IINFO2"(%d$)\n",fsteuern[PersoLicPrice]);
	format(st12,sizeof(st12),""#HTML_BLAU"18."#HTML_WEISS" Angelschein Preis "#IINFO2"(%d$)\n",fsteuern[AngelLicPrice]);
	format(st13,sizeof(st13),""#HTML_BLAU"17."#HTML_WEISS" Sanktion's Kosten "#IINFO2"(%d$)\n",fsteuern[JobSperreFree]);
