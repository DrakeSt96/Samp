COMMAND:tog__3(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[16],string[64];
	if(sscanf(params,"s[16]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /tog [News/Jobchat/Hud/Phone/RpChat]");
	if(strcmp(cmd,"News",true) == 0)
	{
		if(Spieler[playerid][pNEWS] == false)
		{
			Spieler[playerid][pNEWS] = true;
			SCM(playerid,SAMP_WEISS,""IINFO" du hast den Newschat eingeschaltet!");
		}
		else if(Spieler[playerid][pNEWS] == true)
		{
			Spieler[playerid][pNEWS] = false;
			SCM(playerid,SAMP_WEISS,""IINFO" du hast den Newschat ausgeschaltet!");
		}
		return 1;
	}
	if(strcmp(cmd,"RpChat",true) == 0)
	{
		if(Spieler[playerid][RpChat] == 0)
		{
			Spieler[playerid][RpChat] = 1;
			SCM(playerid,SAMP_WEISS,""IINFO" du hast den RpChat eingeschaltet!");
		}
		else if(Spieler[playerid][RpChat] == 1)
		{
			Spieler[playerid][RpChat] = 0;
			SCM(playerid,SAMP_WEISS,""IINFO" du hast den RpChat ausgeschaltet!");
		}
		return 1;
	}
	if(strcmp(cmd,"Jobchat",true) == 0)
	{
		if(Spieler[playerid][pJobchat] == false)
		{
			Spieler[playerid][pJobchat] = true;
			SCM(playerid,SAMP_WEISS,""IINFO" du hast den Jobchat eingeschaltet!");
		}
		else if(Spieler[playerid][pJobchat] == true)
		{
			Spieler[playerid][pJobchat] = false;
			SCM(playerid,SAMP_WEISS,""IINFO" du hast den Jobchat ausgeschaltet!");
		}
		return 1;
	}
	if(strcmp(cmd,"Hud",true) == 0)
	{
		if(Spieler[playerid][DigiHud] == 0)
		{
			Spieler[playerid][DigiHud] = 1;
			SCM(playerid,SAMP_WEISS,""IINFO" du hast die Serverseitige Lebens-/Rüstungsanzeige ausgeschaltet!");
		}
		else if(Spieler[playerid][DigiHud] == 1)
		{
			Spieler[playerid][DigiHud] = 0;
			SCM(playerid,SAMP_WEISS,""IINFO" du hast die Serverseitige Lebens-/Rüstungsanzeige eingeschaltet!");
		}
		return 1;
	}
	if(strcmp(cmd,"Phone",true) == 0)
	{
		if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
		if(Spieler[playerid][pHandyakku] <= 0.0)return SCM(playerid,SAMP_WEISS,"Dein Akku ist leer.");
		if(Spieler[playerid][pHandystate] == 0)
		{
			Spieler[playerid][pHandystate] = 1;
			SCM(playerid,SAMP_WEISS,"Handy an.");
			format(string,sizeof(string),"** %s nimmt sein %s raus **",SpielerName(playerid),HandyInfo[Spieler[playerid][pHandy]][Handyname]);
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
   			ShowHandyDraw(playerid);
		    UpdateHandyTextdraw(playerid);
			AkkuTimer[playerid] = SetTimerEx("HandyAkku",120000,true,"i",playerid);
		}
		else if(Spieler[playerid][pHandystate] == 1)
		{
			StopAudioStreamForPlayer(playerid);
			Spieler[playerid][pHandystate] = 0;
			SCM(playerid,SAMP_WEISS,"Handy aus.");
			format(string,sizeof(string),"** %s legt sein %s in die Tasche **",SpielerName(playerid),HandyInfo[Spieler[playerid][pHandy]][Handyname]);
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			HideHandyDraw(playerid);
			KillTimer(AkkuTimer[playerid]);
			if(Spieler[playerid][pCallHim] == 1)
			{
				new pID = Spieler[playerid][pCall];
				Spieler[playerid][pCallHim] = 0;
				Spieler[pID][pCallHim] = 0;
				Spieler[pID][pCall] = -1;
				Spieler[playerid][pCall] = -1;
				SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
				SetPlayerSpecialAction(pID,SPECIAL_ACTION_STOPUSECELLPHONE);
				SCM(playerid,SAMP_WEISS,""IINFO" du hast das Gespräch beendet.");
				SCM(pID,SAMP_WEISS,""IINFO" der Gesprächspartner hat aufgelegt.");
				PlayerPlaySound(playerid,1077,0.0,0.0,0.0);
				PlayerPlaySound(pID,1077,0.0,0.0,0.0);
				RemovePlayerAttachedObject(pID,8);
				RemovePlayerAttachedObject(playerid,8);
			}
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /tog [News/Jobchat/Hud/Phone/RpChat/Hitsound]");
}

COMMAND:listwerbetafeln(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	SCM(playerid,SAMP_WEISS,"||__________Werbetafeln__________||");
	for(new wtafel=0;wtafel<sizeof(Werbetafeln);wtafel++)
	{
		format(string,sizeof(string),"Tafel(%i): %s",wtafel,Werbetafeln[wtafel][wtafeltext]);
		SCM(playerid,SAMP_WEISS,string);
	}
	return 1;
}

COMMAND:alistwerbetafeln(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128];
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	SCM(playerid,SAMP_WEISS,"||__________Werbetafeln__________||");
	for(new wtafel=0;wtafel<sizeof(Werbetafeln);wtafel++)
	{
		format(string,sizeof(string),"Tafel(%i): %s",wtafel,Werbetafeln[wtafel][wtafeltext]);
		SCM(playerid,SAMP_WEISS,string);
	}
	return 1;
}

COMMAND:tafeltext(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],text[61],wtafel,zeile;
    if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(Spieler[playerid][pMuted] == 1)
	{
		format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		return SCM(playerid,WEISS,string);
	}
	if(sscanf(params,"is[61]i",wtafel,text,zeile))return SCM(playerid,SAMP_WEISS,""IINFO" /tafeltext [Tafelid][Text][Zeile]");
	if(wtafel<0||wtafel>(MAX_WERBETAFELN)-1)
	{
		format(string,sizeof(string),""IINFO" /tafeltext [Tafelid 0-%i][Text][Zeile]",MAX_WERBETAFELN-1);
		return SCM(playerid,SAMP_WEISS,string);
	}
	if(zeile<0||zeile>1)
	{
		format(string,sizeof(string),""IINFO" /tafeltext [Tafelid 0-%i][Text][Zeile1-1]",MAX_WERBETAFELN-1);
		return SCM(playerid,SAMP_WEISS,string);
	}
	if(!IsPlayerInRangeOfPoint(playerid,50.0,Werbetafeln[wtafel][wtafelx],Werbetafeln[wtafel][wtafely],Werbetafeln[wtafel][wtafelz]))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht an der angegebenen Werbetafel!");
	if(strlen(text) > 60)return SCM(playerid,SAMP_WEISS,""IINFO" /tafeltext [Tafelid][Text darf maximal 60 Zeichen beinhalten]");
	for(new i=0;i<sizeof(BadWord);i++)
	{
		if(strfind(text,BadWord[i],true) != -1)
	  	{
	  		format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /tafeltext",BadWord[i],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
    }
	switch(zeile)
	{
		case 1:
		{
		    format(string,sizeof(string),"[Zeile %i]: Du hast der Werbetafel %i den Text auf | %s | umgeändert.",zeile,wtafel,text);
			SCM(playerid,SAMP_WEISS,string);
		    strmid(Werbetafeln[wtafel][wtafeltext],text,0,strlen(text),sizeof(text));
		}
	}
	DestroyDynamicObject(Werbetafelobject[wtafel]);
	Werbetafelobject[wtafel] = CreateDynamicObject(Werbetafeln[wtafel][wtafelobjectid],Werbetafeln[wtafel][wtafelx],Werbetafeln[wtafel][wtafely],Werbetafeln[wtafel][wtafelz],Werbetafeln[wtafel][wtafelxrot],Werbetafeln[wtafel][wtafelyrot],Werbetafeln[wtafel][wtafelzrot]);
    SetDynamicObjectMaterialText(Werbetafelobject[wtafel],Werbetafeln[wtafel][wtafeltmindex],Werbetafeln[wtafel][wtafeltext],Werbetafeln[wtafel][wtafeltmsize],Werbetafeln[wtafel][wtafeltfonts],Werbetafeln[wtafel][wtafeltfontsize],Werbetafeln[wtafel][wtafeltbold],Werbetafeln[wtafel][wtafeltfontcolor],Werbetafeln[wtafel][wtafeltbackcolor],Werbetafeln[wtafel][wtafeltaligment]);
	SetDynamicObjectMaterial(Werbetafelobject[wtafel],1,10765,"airportgnd_sfse","white",0xFF263739);
	SetDynamicObjectMaterial(Werbetafelobject[wtafel],2,10765,"airportgnd_sfse","white",0xFFD6DAD6);
	SetDynamicObjectMaterial(Werbetafelobject[wtafel],3,10765,"airportgnd_sfse","white",0xFFD6DAD6);
	return 1;
}

COMMAND:tafelweg(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],wtafel;
    if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(sscanf(params,"i",wtafel))return SCM(playerid,SAMP_WEISS,""IINFO" /tafelweg [Tafelid]");
	if(wtafel<0||wtafel>(MAX_WERBETAFELN)-1)
	{
		format(string,sizeof(string),""IINFO" /tafelweg [Tafelid 0-%i]",MAX_WERBETAFELN-1);
		return SCM(playerid,SAMP_WEISS,string);
	}
	if(!IsPlayerInRangeOfPoint(playerid,50.0,Werbetafeln[wtafel][wtafelx],Werbetafeln[wtafel][wtafely],Werbetafeln[wtafel][wtafelz]))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht an der angegebenen Werbetafel!");
	format(string,sizeof(string),""IINFO" du hast die Werbetafel %i wieder frei gemacht.",wtafel);
	SCM(playerid,SAMP_WEISS,string);
    DestroyDynamicObject(Werbetafelobject[wtafel]);
    strmid(Werbetafeln[wtafel][wtafeltext],"San Andreas News Corporation",0,strlen("San Andreas News Corporation"),64);
	Werbetafelobject[wtafel] = CreateDynamicObject(Werbetafeln[wtafel][wtafelobjectid],Werbetafeln[wtafel][wtafelx],Werbetafeln[wtafel][wtafely],Werbetafeln[wtafel][wtafelz],Werbetafeln[wtafel][wtafelxrot],Werbetafeln[wtafel][wtafelyrot],Werbetafeln[wtafel][wtafelzrot]);
    SetDynamicObjectMaterialText(Werbetafelobject[wtafel],Werbetafeln[wtafel][wtafeltmindex],Werbetafeln[wtafel][wtafeltext],Werbetafeln[wtafel][wtafeltmsize],Werbetafeln[wtafel][wtafeltfonts],Werbetafeln[wtafel][wtafeltfontsize],Werbetafeln[wtafel][wtafeltbold],Werbetafeln[wtafel][wtafeltfontcolor],Werbetafeln[wtafel][wtafeltbackcolor],Werbetafeln[wtafel][wtafeltaligment]);
	SetDynamicObjectMaterial(Werbetafelobject[wtafel],1,10765,"airportgnd_sfse","white",0xFF263739);
	SetDynamicObjectMaterial(Werbetafelobject[wtafel],2,10765,"airportgnd_sfse","white",0xFFD6DAD6);
	SetDynamicObjectMaterial(Werbetafelobject[wtafel],3,10765,"airportgnd_sfse","white",0xFFD6DAD6);
	return 1;
}

