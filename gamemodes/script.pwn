			    SCM(playerid,SAMP_WEISS,""IINFO" du kannst momentan keine Einweisung anfordern.");
			}
			return 1;
		}
		case DIALOG_REPORT_FRAKTION:
		{
			new string[128];
			if(response == 0)
			{
				if(!isPlayerInFrakt(playerid,0))return ShowPlayerReportFrak(playerid);
				return ShowPlayerReport(playerid);
			}
			else
			{
				if(!strlen(inputtext) || strlen(inputtext) > 90)
				{
					ShowPlayerDialog(playerid,DIALOG_REPORT_FRAKTION,DIALOG_STYLE_INPUT,""ClanTagDialoge" Support - Ticket -> Fraktion Meldung/Fehler",""#HTML_WEISS"Hast du Probleme mit/in deiner Fraktion?\nSchildere das Geschehen kurz und knapp","Absenden","Zurück");
					return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nicht mehr als 90 Zeichen benutzen.");
				}
				else
				{
					for(new i=0;i<30;i++)
			   		{
						if(ReportListitem[i][rID][3] == -1)
						{
