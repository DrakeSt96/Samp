stock IsPlayerInSmarkFightZone(playerid)
{
    new Float:SzonePos[3];
 	GetPlayerPos(playerid,SzonePos[0],SzonePos[1],SzonePos[2]);
	for(new sm=1;sm<MAX_SMARKETS;sm++)
	{
		if(SmarkInfo[sm][screatet] == 1)
		{
			if((SzonePos[0] >= (SmarkInfo[sm][sx]-100) && SzonePos[0] <= (SmarkInfo[sm][sx]+100) && SzonePos[1] >= (SmarkInfo[sm][sy]-100) && SzonePos[1] <= (SmarkInfo[sm][sy]+100)))
			return sm;
		}
	}
	return -1;
}

stock ReturnSmarkID(playerid)
{
	for(new sm=1;sm<MAX_SMARKETS;sm++)
	{
		if(SmarkInfo[sm][screatet] == 1)
		{
			if(((IsPlayerInRangeOfPoint(playerid,5.0,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]) &&  GetPlayerVirtualWorld(playerid) == 0) || (IsPlayerInRangeOfPoint(playerid,5.0,944.8334,788.1722,-18.9141) && GetPlayerVirtualWorld(playerid) == sm)))
			return sm;
		}
	}
	return -1;
}

stock ReturnFbaseID(playerid)
{
	for(new i=0;i<sizeof(Fraktionsbase);i++)
	{
		if(((IsPlayerInRangeOfPoint(playerid,5.0,Fraktionsbase[i][fbaseenterX],Fraktionsbase[i][fbaseenterY],Fraktionsbase[i][fbaseenterZ]) &&  GetPlayerVirtualWorld(playerid) == 0) || (IsPlayerInRangeOfPoint(playerid,5.0,Fraktionsbase[i][fbaseexitX],Fraktionsbase[i][fbaseexitY],Fraktionsbase[i][fbaseexitZ]) && GetPlayerVirtualWorld(playerid) == Fraktionsbase[i][fbasevirtualworld])))
		return i;
	}
	return -1;
}
stock ReturnFbankPointID(playerid)
{
	for(new i=0;i<sizeof(Fraktionsbase);i++)
	{
		if(IsPlayerInRangeOfPoint(playerid,2,Fraktionsbase[i][fbasebankX],Fraktionsbase[i][fbasebankY],Fraktionsbase[i][fbasebankZ]) && GetPlayerVirtualWorld(playerid) == Fraktionsbase[i][fbasevirtualworld])
		return i;
	}
	return -1;
