			return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld dabei");
		}
		if((Spieler[playerid][pOpium] + Spieler[playerid][pMenge]) > 500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
		pID = Spieler[playerid][pSeller];
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir kein Opium Pillen verkaufen!");
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(Spieler[pID][pOpium] < Spieler[playerid][pVerbrauch])return SCM(playerid,SAMP_WEISS,""IINFO" der Verkaeufer hat nicht mehr genug Opium Pillen, der Handel wurde abgebrochen.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) die %i Opium Pillen für %i$ abgekauft.",SpielerName(pID),pID,Spieler[playerid][pMenge],Spieler[playerid][pKaufPreis]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir %i Opium Pillen für %i$ abgekauft.",SpielerName(playerid),playerid,Spieler[playerid][pMenge],Spieler[playerid][pKaufPreis]);
		SCM(pID,SAMP_WEISS,string);
		ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
		ACMoney(pID,Spieler[playerid][pKaufPreis]);
		Spieler[playerid][pOpium] += Spieler[playerid][pMenge];
		Spieler[pID][pOpium] -= Spieler[playerid][pVerbrauch];
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(pID),SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		Spieler[playerid][pMenge2] = 0;
		Spieler[playerid][pVerbrauch] = 0;
		return 1;
	}
	if(strcmp(cmd,"Ticket",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 12)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir ein Ticket an.");
		if((GetACMoney(playerid) - Spieler[playerid][pKaufPreis]) < 0)
		{
		    PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
			return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld dabei");
		}
		pID = Spieler[playerid][pSeller];
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir kein Ticket verkaufen!");
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),"%s (ID:%i) hat dir ein Ticket für %i$ ausgestellt!",SpielerName(pID),pID,Spieler[playerid][pKaufPreis]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast "IINFO2"%s"#HTML_WEISS" ein Ticket für "IINFO2"%i$"#HTML_WEISS" ausgeschrieben!",SpielerName(playerid),Spieler[playerid][pKaufPreis]);
		SCM(pID,SAMP_WEISS,string);
		ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
		fverwaltungen[16][Geld] += Spieler[playerid][pKaufPreis];
		format(string,sizeof(string),"** %s stellt %s ein Ticket aus **",SpielerName(pID),SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pBuyTickets]++;
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		Spieler[playerid][pMenge2]  = 0;
		Spieler[playerid][pVerbrauch] = 0;
		return 1;
	}
	if(strcmp(cmd,"Vertrag",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 13)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir eine Vertrag an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast den Vertrag von %s (ID:%i) angenommen!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat deine Vertrag angenommen!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		return 1;
