		    {
			    if(!strlen(inputtext) || strlen(inputtext) > 64)
			    {
					ShowPlayerDialog(playerid,HDIA_BESCHREIBUNGCHANGEN,DIALOG_STYLE_INPUT,"Haus Verwaltung (Beschreibung)","Hier kannst du deine Hausbeschreibung umändern\nGebe deinen gewünschten Text ein(Beleidigunen sind zu unterlassen):","Ändern","Zurück");
