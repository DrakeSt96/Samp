	    case DIALOG_BUWTHINGSINBIZ:
		{
			new string[128],biz = ReturnBizID(playerid),givemwst;
		    if(response == 0)return 1;
			if(biz == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Laden.");
		    else
		    {
			    switch(listitem)
			    {
				    case 0:
				    {
					    switch(BizInfo[biz][biz_art])
					    {
						    case 1://ammu
							{
								if((GetACMoney(playerid) - BizInfo[biz][biz_artikel][1]) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
							    givemwst = floatround((BizInfo[biz][biz_artikel][1]/100)*fsteuern[Mwst],floatround_ceil);
								ACMoney(playerid,-BizInfo[biz][biz_artikel][1]);
							    BizInfo[biz][biz_geldkasse] += floatround(BizInfo[biz][biz_artikel][1]-givemwst);
							    fverwaltungen[16][Geld] += givemwst;
							    format(string,sizeof(string),""IINFO" du hast dir ein Baseball Schläger für %i$(davon versteuert: %i$) gekauft!",BizInfo[biz][biz_artikel][1],givemwst);
							    SCM(playerid,SAMP_WEISS,string);
							    GiveWeapon(playerid,5,1,true);
							}
