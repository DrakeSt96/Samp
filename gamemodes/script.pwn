			return 1;
	  	}
	  	case 4://treibstoff
	 	{
		  	TogglePlayerControllable(playerid,true);
		  	DisablePlayerCheckpoint(playerid);
		  	SetPlayerCheckpoint(playerid,-1690.6570,398.8784,6.7432,7.5);
			truckerjobgo4[playerid] = 4;
			SCM(playerid,SAMP_WEISS,""IINFO" der Treibstoff wurde abgefüllt,bringe den Anhänger zurück zum Standort.");
			return 1;
	  	}
	  	case 5://eisen
	 	{
		  	TogglePlayerControllable(playerid,true);
		  	DisablePlayerCheckpoint(playerid);
		  	SetPlayerCheckpoint(playerid,797.8452,-606.8371,16.0412,7.5);
