stock SaveOnlyOneBiz(biz)
{
	new mainquery[2000],query[1000];
	if(BizInfo[biz][bizcreatet] != 0 && biz != 0)
	{
	    mysql_format(MySQL_R394,query,sizeof(query),"UPDATE server_bizes SET biz_Owned='%d',biz_art='%d',biz_preis='%d',biz_level='%d',biz_geldkasse='%d',biz_locked='%d',biz_besitzer='%e',biz_teilhaber='%e',biz_beschreibung='%e',biz_artikel0='%d',biz_artikel1='%d',biz_artikel2='%d',biz_artikel3='%d',biz_artikel4='%d',biz_artikel5='%d',",
		BizInfo[biz][biz_Owned],BizInfo[biz][biz_art],BizInfo[biz][biz_preis],BizInfo[biz][biz_level],BizInfo[biz][biz_geldkasse],BizInfo[biz][biz_locked],BizInfo[biz][biz_besitzer],BizInfo[biz][biz_teilhaber],BizInfo[biz][biz_beschreibung],BizInfo[biz][biz_artikel][0],BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3],BizInfo[biz][biz_artikel][4],BizInfo[biz][biz_artikel][5]);
		strcat(mainquery,query);
	    format(query,sizeof(query),"biz_artikel6='%d',biz_artikel7='%d',biz_artikel8='%d',biz_artikel9='%d',biz_artikel10='%d',biz_artikel11='%d',biz_artikel12='%d',biz_artikel13='%d',biz_artikel14='%d',biz_x='%f',biz_y='%f',biz_z='%f',biz_interior='%d',rentbizvehiclemodelid='%d',tPos0='%f',tPos1='%f',tPos2='%f',tPos3='%f',tPos4='%f',tPos5='%f' WHERE id='%d'",
		BizInfo[biz][biz_artikel][6],BizInfo[biz][biz_artikel][7],BizInfo[biz][biz_artikel][8],BizInfo[biz][biz_artikel][9],BizInfo[biz][biz_artikel][10],BizInfo[biz][biz_artikel][11],BizInfo[biz][biz_artikel][12],BizInfo[biz][biz_artikel][13],BizInfo[biz][biz_artikel][14],BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z],BizInfo[biz][biz_interior],BizInfo[biz][rentbizvehiclemodelid],BizInfo[biz][tPos][0],BizInfo[biz][tPos][1],BizInfo[biz][tPos][2],
		BizInfo[biz][tPos][3],BizInfo[biz][tPos][4],BizInfo[biz][tPos][5],biz);
		strcat(mainquery,query);
		mysql_function_query(MySQL_R394,mainquery,false,"","");
		strdel(mainquery,0,sizeof(mainquery));
		strdel(query,0,sizeof(query));
		printf("- Business %i gespeichert -",biz);
	}
	return 1;
}
stock BizName(biz)
{
	new bizname[32];
	switch(BizInfo[biz][biz_art])
	{
		case 1:{bizname="Ammunation";}
		case 2:{bizname="24/7 Market";}
		case 3:{bizname="Clucking Bell";}
		case 4:{bizname="Burger Shot";}
		case 5:{bizname="Handyladen";}
		case 6:{bizname="Well Staked Pizza";}
		case 7:{bizname="Club";}
		case 8:{bizname="Donut Laden";}
		case 9:{bizname="Restaurant";}
		case 10:{bizname="Tankstelle";}
		case 11:{bizname="Fahrzeugvermietung";}
		case 12:{bizname="Paintball";}
		case 13:{bizname="Hotel";}
		case 14:{bizname="Base-Jump Business";}
		case 15:{bizname="Kart-Club";}
		default:{bizname="ERROR";}
	}
	return bizname;
}
stock CreateOrganisation(const organisation[],playerid)
{
	new query[700];
    for(new org=1;org<MAX_ORGANISATIONS;org++)
	{
		if(OrgInfo[org][OrgCreatet] == 0)
		{
			format(query,sizeof(query),""IINFO" du hast die Firma "IINFO2"%s"#HTML_WEISS" erfolgreich erstellt.",organisation);
			SCM(playerid,SAMP_WEISS,query);
		 	ACMoney(playerid,-MAX_ORGCOST);
			fverwaltungen[16][Geld] += MAX_ORGCOST;
			Spieler[playerid][pOrgLeader] = org;
			Spieler[playerid][pOrgMember] = org;
			OrgInfo[org][OrgCreatet] = 1;
			strmid(OrgInfo[org][OrgName],organisation,0,strlen(organisation),32);
			strmid(OrgInfo[org][OrgOwner],Spieler[playerid][pName],0,strlen(Spieler[playerid][pName]),24);
			strmid(OrgInfo[org][OrgMotto],"Keins",0,strlen("Keins"),128);
			mysql_format(MySQL_R394,query,sizeof(query),"INSERT INTO server_firmen (id,OrgName,OrgOwner,OrgMotto,OrgKasse,OrgMBeitrag) VALUES ('%d','%e','%s','%e','0','0')",org,OrgInfo[org][OrgName],OrgInfo[org][OrgOwner],OrgInfo[org][OrgMotto]);
		    mysql_function_query(MySQL_R394,query,false,"","");
			return org;
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" es wurde bereits die Maximale Anzahl von Organisationen erstellt.");
}
stock CreatePartei(const parteis[],playerid)
{
	new query[700];
    for(new p=1;p<MAX_PARTEI;p++)
	{
		if(PartInfo[p][ParteiCreatet] == 0)
		{
			TextDrawShowForPlayer(playerid,InfoSign);
		    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~g~Partei erstellt.");
			PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
			StopAudioStreamForPlayer(playerid);
		 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
			format(query,sizeof(query),""IINFO" du hast die Partei "IINFO2"%s"#HTML_WEISS" erfolgreich erstellt.",parteis);
			SCM(playerid,SAMP_WEISS,query);
			SCM(playerid,SAMP_WEISS,"Partei Befehle:");
			SCM(playerid,SAMP_WEISS,"- '/partei' um den Organisationschat zu nutzen");
			SCM(playerid,SAMP_WEISS,"- '/parteimakeleader' um jemanden als Leiter der Organisation hinzuzufügen");
			SCM(playerid,SAMP_WEISS,"- '/parteiinvite' um jemanden als Mitglied in die Organisation einzuladen");
			SCM(playerid,SAMP_WEISS,"- '/parteiuninvite' um jemanden als Mitglied der Organisation auszuladen");
			SCM(playerid,SAMP_WEISS,"- '/parteimember' um die eingeloggten Mitglieder anzuzeigen");
			SCM(playerid,SAMP_WEISS,"- '/parteidelete' um die Organisation zu löschen");
		    SCM(playerid,SAMP_WEISS,"- '/parteisetmotto' um das Organisations Motto zu ändern");
			SCM(playerid,SAMP_WEISS,"- '/parteiname' um den Namen der Organisation zu ändern");
			SCM(playerid,SAMP_WEISS,"- '/parteimbeitrag' um den Mitgliedsbeitrag einzustellen");
			SCM(playerid,SAMP_WEISS,"- '/parteikasse' um die Parteikasse aufzurufen");
			SCM(playerid,SAMP_WEISS,"- '/parteitakeleader' um jemanden in der Organisation als Leiter auszuladen");
		 	ACMoney(playerid,-MAX_PARTEICOST);
			fverwaltungen[16][Geld] += (MAX_PARTEICOST-5000);
			Spieler[playerid][pParteiLeader] = p;
			Spieler[playerid][pParteiMember] = p;
			PartInfo[p][ParteiCreatet] = 1;
			strmid(PartInfo[p][ParteiName],parteis,0,strlen(parteis),32);
			strmid(PartInfo[p][ParteiOwner],Spieler[playerid][pName],0,strlen(Spieler[playerid][pName]),24);
			strmid(PartInfo[p][ParteiMotto],"Keins",0,strlen("Keins"),128);
			mysql_format(MySQL_R394,query,sizeof(query),"INSERT INTO server_patei (id,ParteiName,ParteiOwner,ParteiMotto,ParteiKasse,ParteiMBeitrag) VALUES ('%d','%e','%s','%e','0','0')",p,PartInfo[p][ParteiName],PartInfo[p][ParteiOwner],PartInfo[p][ParteiMotto]);
		    mysql_function_query(MySQL_R394,query,false,"","");
			return p;
		}
	}
	return SCM(playerid,SAMP_WEISS,"Es wurde bereits die Maximale Anzahl von Parteien erstellt.");
}

stock ReturnTotenID(playerid)
{
  	for(new deather;deather<MAX_TOTEN;deather++)
	{
	   	if(IsPlayerInRangeOfPoint(playerid,5.0,TotenInfo[deather][totenxpos],TotenInfo[deather][totenypos],TotenInfo[deather][totenzpos]) && GetPlayerVirtualWorld(playerid) == TotenInfo[deather][totenvworld])
	    return deather;
    }
	return -1;
}
stock CreateToten(playerid)
{
	new string[64];
	for(new deather;deather<MAX_TOTEN;deather++)
	{
		if(TotenInfo[deather][totenlevel] == 0)
		{
			TotenInfo[deather][totenxpos] = Spieler[playerid][tot_x];
			TotenInfo[deather][totenypos] = Spieler[playerid][tot_y];
			TotenInfo[deather][totenzpos] = Spieler[playerid][tot_z];
			TotenInfo[deather][totenvworld] = Spieler[playerid][tot_world];
			TotenInfo[deather][totenlevel] = GetPlayerLevel(playerid);
		    TotenInfo[deather][totenpickup] = CreateDynamicPickup(1254,1,TotenInfo[deather][totenxpos],TotenInfo[deather][totenypos],TotenInfo[deather][totenzpos],TotenInfo[deather][totenvworld]);
			format(string,sizeof(string),"Leichnahm\n"IINFO2"%s",SpielerName(playerid));
			TotenLabel[deather] = CreateDynamic3DTextLabel(string,SAMP_WEISS,TotenInfo[deather][totenxpos],TotenInfo[deather][totenypos],TotenInfo[deather][totenzpos],20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,TotenInfo[deather][totenvworld]);
		    ServiceCall(playerid,6);
			return deather;
		}
	}
	return 1;
}
stock CreateBlitzer(playerid,geschwinigkeit,const ortschaft[])
{
	new string[650],query[512];
    for(new i=0;i<MAX_BLITZER;i++)
	{
	 	if(Blitzer[i][Erstellt] == 0)
		{
			GetPlayerPos(playerid,Blitzer[i][sperreX],Blitzer[i][sperreY],Blitzer[i][sperreZ]);
		    Blitzer[i][Erstellt] = 1;
		    Blitzer[i][RubLabel] = INVALID_3D_TEXT;
		    Blitzer[i][EGmBhHp] = 100;
		    Blitzer[i][EGmBhTstamp] = gettime() + ((random(10) + 10)*60);
		    Blitzer[i][BlitzerGeschwindigkeit] = geschwinigkeit;
		    Blitzer[i][EGmBhRubbishObject] = -1;
		    strmid(Blitzer[i][BlitzerOrt],ortschaft,0,strlen(ortschaft),64);
		    Blitzer[i][ID] = CreateDynamicObject(18880,Blitzer[i][sperreX],Blitzer[i][sperreY],Blitzer[i][sperreZ]-2.0,0.0,0.0,15.0);
		    format(string,sizeof(string),""IINFO" du hast ein Blitzer mit der Richtgeschwindigkeit von %i Km/h an dem Ort %s erstellt.",geschwinigkeit,ortschaft);
			SCM(playerid,SAMP_WEISS,string);
			format(SP_INFO,sizeof(SP_INFO),"** %s %s stellt einen Blitzer auf **",SpielerFraktionsRangName(playerid),SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,SP_INFO,10);
			mysql_format(MySQL_R394,query,sizeof(query),"INSERT INTO server_blitzer (`id`,`BlitzerGeschwindigkeit`,`BlitzerOrt`,`sperreX`,`sperreY`,`sperreZ`,`HP`) VALUES ('%d','%d','%e','%f','%f','%f','%d')",i,Blitzer[i][BlitzerGeschwindigkeit],Blitzer[i][BlitzerOrt],Blitzer[i][sperreX],Blitzer[i][sperreY],Blitzer[i][sperreZ],Blitzer[i][EGmBhHp]);
		    mysql_function_query(MySQL_R394,query,false,"","");
			return i;
		}
	}
	return -1;
}
stock DeleteBlitzer(playerid)
{
    new query[128];
    for(new i=0;i<MAX_BLITZER;i++)
	{
	  	if(IsPlayerInRangeOfPoint(playerid,2,Blitzer[i][sperreX],Blitzer[i][sperreY],Blitzer[i][sperreZ]))
	   	{
		    if(Blitzer[i][Erstellt] == 1)
		    {
			    Blitzer[i][Erstellt] = 0;
			    Blitzer[i][sperreX] = -1;
			    Blitzer[i][sperreY] = -1;
			    Blitzer[i][sperreZ] = -1;
			    Blitzer[i][EGmBhHp] = 0;
			    Blitzer[i][BlitzerGeschwindigkeit] = -1;
				if(Blitzer[i][EGmBhRubbishObject] != -1) DestroyDynamicObject(Blitzer[i][EGmBhRubbishObject]);
			    Blitzer[i][EGmBhRubbishObject] = -1;
				DestroyDynamicObject(Blitzer[i][ID]);
				SCM(playerid,SAMP_WEISS,""IINFO" Blitzer entfernt.");
				format(query,sizeof(query),"DELETE FROM server_blitzer WHERE id = '%d'",i);
			   	mysql_function_query(MySQL_R394,query,false,"","");
				return 1;
		    }
	    }
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" an keinem Blitzer.");
}
stock DeleteAllBlitzer()
{
	new query[128];
    for(new i=0;i<MAX_BLITZER;i++)
	{
	 	if(Blitzer[i][Erstellt] == 1)
		{
			Blitzer[i][Erstellt] = 0;
			Blitzer[i][sperreX] = -1;
			Blitzer[i][sperreY] = -1;
			Blitzer[i][sperreZ] = -1;
			Blitzer[i][EGmBhHp] = 0;
			Blitzer[i][BlitzerGeschwindigkeit] = -1;
			if(Blitzer[i][EGmBhRubbishObject] != -1) DestroyDynamicObject(Blitzer[i][EGmBhRubbishObject]);
		    Blitzer[i][EGmBhRubbishObject] = -1;
			DestroyDynamicObject(Blitzer[i][ID]);
			format(query,sizeof(query),"DELETE FROM server_blitzer WHERE id = '%d'",i);
		   	mysql_function_query(MySQL_R394,query,false,"","");
		}
	}
	return 1;
}
