public VehicleUpdate()
{
	for(new i=0;i<MAX_VEHICLES;i++)
	{
		if(IsValidVehicle(i))
		{
			if(IsVehABoot(i) || IsVehABike(i) || IsVehAFlugzeug(i) || IsVehAHelicopter(i) || IsVehicleACar(i) || GetVehicleModel(i) == 462)
			{
				if(Motor[i] == true && gettime() > vFahrzeug[i][NextTankVerbrauch])
				{
				    vFahrzeug[i][NextTankVerbrauch] = gettime() + (10*3);
					if(GetVehicleSpeed(i) < 1) vFahrzeug[i][Tank] -= VehicleInfo[GetVehicleModel(i)-400][vtankverbrauch]/2;
					if(vFahrzeug[i][Tank] <= 0.0)
					{
						vFahrzeug[i][Tank] = 0.0;
						GetVehicleParamsEx(i,engine,lights,alarm,doors,bonnet,boot,objective);
						SetVehicleParamsEx(i,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
						Motor[i] = false;
					}
				}
			}
		}
	}
	return 1;
}

public PersonRetten(playerid, zielid)
{
	new Float:playerheal, string[128];
    GetPlayerHealth(playerid, playerheal);
    if(playerheal > 0){SetPlayerACHealth(zielid,(playerheal-25.0));}
	else{SetPlayerACHealth(zielid,10.0);}
	format(string,sizeof(string),""IINFO" du hast %s[ID: %i] aus dem Fahrzeug gerettet.",SpielerName(zielid),zielid);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s[ID: %i] hat dich aus dem Fahrzeug gerettet.",SpielerName(playerid),playerid);
	SCM(zielid,SAMP_WEISS,string);
	format(string,sizeof(string),"** %s hat %s aus dem Fahrzeug gerettet. **",SpielerName(playerid),SpielerName(zielid));
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	StopLoopingAnim(playerid);
	SetCameraBehindPlayer(zielid);
	TogglePlayerControllable(zielid,true);
	return 1;
}


public Repaired(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	RepairAVehicle[vehicleid] = 0;
	MotorDown[vehicleid] = 0;
	RepairVehicle(vehicleid);
	SCM(playerid,0x4BB400FF,"Fahrzeug wurde gewartet.");
	TogglePlayerControllable(playerid,true);
	KillTimer(reptimer[playerid]);
	return 1;
}

public Restart()
{
	new string[20];
	Sekunden--;
    format(string,sizeof(string),"~r~%i",Sekunden);
    GameTextForAll(string,1000,4);
    if(Sekunden <= 0)
	{
		KillTimer(Serverrestarter);
		GameModeExit();
	}
	return 1;
}

public DestroyTheSmokeFromFlame(id)
{
    for(new i;i<5;i++){ DestroyDynamicObject(Flame[id][Smoke][i]); }
}

public FireTimer(playerid,id)
{
	if(id < -1 && Aiming_at_Flame(playerid) == id) { StopPlayerBurning(id+MAX_PLAYERS); }
	else if(id < -1 && Pissing_at_Flame(playerid) == id) { StopPlayerBurning(id+MAX_PLAYERS); }
	else if(Flame[id][Flame_Exists] && ((Pressing(playerid) & KEY_FIRE && Aiming_at_Flame(playerid) == id) || (Pissing_at_Flame(playerid) == id)))
	{
		SCM(playerid,SAMP_WEISS,""IINFO" du hast einen Brand gelöscht!");
	 	KillFire(id);
	}
	KillTimer(ExtTimer[playerid]);
	ExtTimer[playerid] = -1;
}

public SetPlayerBurn(playerid)
{
    if(IsPlayerAttachedObjectSlotUsed(playerid,0)) SCM(playerid,WANTEDDEATHERROT,"Deine Kopfbedekung ist abgebrannt!"),Spieler[playerid][pBuyClothes] = -1;
    SetPlayerAttachedObject(playerid,0,18690,2,-1,0,-1.9,0,0);
	PlayerOnFire[playerid] = 1;
	KillTimer(PlayerOnFireTimer[playerid]);
	KillTimer(PlayerOnFireTimer2[playerid]);
	PlayerOnFireTimer[playerid] = SetTimerEx("BurningTimer",91,true,"d",playerid);
	PlayerOnFireTimer2[playerid] = SetTimerEx("StopPlayerBurning",7000,false,"d",playerid);
	return 1;
}

public BurningTimer(playerid)
{
	if(PlayerOnFire[playerid] == 1)
	{
		SetPlayerACHealth(playerid,GetPlayerACHealth(playerid)-1);
		return 1;
	}
	return KillTimer(PlayerOnFireTimer[playerid]),KillTimer(PlayerOnFireTimer2[playerid]);
}

public StopPlayerBurning(playerid)
{
	KillTimer(PlayerOnFireTimer[playerid]);
	PlayerOnFire[playerid] = 0;
	RemovePlayerAttachedObject(playerid,0);
	return 1;
}

public OnFireUpdate()
{
	ForEachPlayer(playerid)
	{
	 	if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
	  	{
   			if(PlayerOnFire[playerid] && !CanPlayerBurn(playerid,1))
			{ StopPlayerBurning(playerid); }
			if(Pissing_at_Flame(playerid) != -1 || Aiming_at_Flame(playerid) != -1)
			{
				if(ExtTimer[playerid] == -1 && ((Aiming_at_Flame(playerid) != -1 && Pressing(playerid) & KEY_FIRE) || Pissing_at_Flame(playerid) != -1))
				{
					new value,time,Float:x,Float:y,Float:z;
					if(Pissing_at_Flame(playerid) != -1)
				 	{
						value = Pissing_at_Flame(playerid);
						time = EXTINGUISH_TIME_PEEING;
					}
					else if(Aiming_at_Flame(playerid) != -1)
					{
						value = Aiming_at_Flame(playerid);
						if(GetPlayerWeapon(playerid) == WEAPON_SPRAYCAN)
						{
						CreateExplosion(Flame[value][Flame_x],Flame[value][Flame_y],Flame[value][Flame_z],2,5);
						continue;
						}
						if(IsPlayerInAnyVehicle(playerid))
						{
							time = EXTINGUISH_TIME_VEHICLE;
						}
						else
						{
							time = EXTINGUISH_TIME_ONFOOT;
						}
					}
					if(value < -1) { time = EXTINGUISH_TIME_PLAYER; }
					time *= 1000;
					if(value >= -1)
					{
						x = Flame[value][Flame_x];
						y = Flame[value][Flame_y];
						z = Flame[value][Flame_z];
					 	DestroyTheSmokeFromFlame(value);
						Flame[value][Smoke][0] = CreateDynamicObject(18727,x,y,z,0.0,0.0,0.0,Flame[value][Flame_world]);
						Flame[value][Smoke][1] = CreateDynamicObject(18727,x+1,y,z,0.0,0.0,0.0,Flame[value][Flame_world]);
						Flame[value][Smoke][2] = CreateDynamicObject(18727,x-1,y,z,0.0,0.0,0.0,Flame[value][Flame_world]);
						Flame[value][Smoke][3] = CreateDynamicObject(18727,x,y+1,z,0.0,0.0,0.0,Flame[value][Flame_world]);
						Flame[value][Smoke][4] = CreateDynamicObject(18727,x,y-1,z,0.0,0.0,0.0,Flame[value][Flame_world]);
						SetTimerEx("DestroyTheSmokeFromFlame",time,false,"d",value);
					}
					ExtTimer[playerid] = SetTimerEx("FireTimer",time,false,"dd",playerid,value);
				}
			}
			if(CanPlayerBurn(playerid) && IsAtFlame(playerid) && (GetPlayerSkin(playerid) != 277 && GetPlayerSkin(playerid) != 278 && GetPlayerSkin(playerid) != 279)) { SetPlayerBurn(playerid); }
			new Float:x,Float:y,Float:z;
			ForEachPlayer(i)
			{
				if(playerid != i && IsPlayerConnected(i) && !IsPlayerNPC(i))
				{
					if(CanPlayerBurn(i) && PlayerOnFire[playerid] && !PlayerOnFire[i] && (GetPlayerSkin(playerid) != 277 && GetPlayerSkin(playerid) != 278 && GetPlayerSkin(playerid) != 279))
					{
						GetPlayerPos(i,x,y,z);
						if(IsPlayerInRangeOfPoint(playerid,1,x,y,z))
						{
							SetPlayerBurn(i);
						}
					}
				}
			}
		}
 	}
	return 1;
}

public Erzbaggern(playerid,count)
{
	new string[128],KEY:keys,ud,lr;
    GetPlayerKeys(playerid,keys,ud,lr);
	switch(count)
	{
		case 0://beladen
		{
			if(!IsPlayerInRangeOfPoint(playerid,7.0,557.8638,911.2230,-42.7409))return SCM(playerid,SAMP_WEISS,"Beladen fehlgeschlagen. Nicht am Erzhaufen.");
			if(keys & KEY_ANALOG_DOWN)
		 	{
				VehicleLoadTank[GetPlayerVehicleID(playerid)] = (random(500) + 250);
				format(string,sizeof(string),""IINFO" du hast %ikg Erz geladen.",VehicleLoadTank[GetPlayerVehicleID(playerid)]);
				SCM(playerid,SAMP_WEISS,string);
				SCM(playerid,SAMP_WEISS,"Begebe dich nun zu einem der 2 Punkte.");
				SetPlayerCheckpoint(playerid,691.3052,831.3406,-30.6025,5.0);
				Spieler[playerid][pIsearch] = 1;
				return 1;
		 	}
		 	return SCM(playerid,SAMP_WEISS,"Beladen fehlgeschlagen. Drücke 'Num2' 7 Sekunden lang.");
		}
		case 1://entladen
		{
			if(IsPlayerInRangeOfPoint(playerid,7.0,695.8068,843.3893,-26.9968) || IsPlayerInRangeOfPoint(playerid,7.0,683.3445,822.5607,-27.5438))
			{
				if(keys & KEY_ANALOG_UP)
			 	{
					fsteuern[EisenLagger1] += VehicleLoadTank[GetPlayerVehicleID(playerid)]/2;
					format(string,sizeof(string),"Eisenlager\nEisen auf Lager: %ikg",fsteuern[EisenLagger1]);
					UpdateDynamic3DTextLabelText(EisenLagerLabel,SAMP_WEISS,string);
					format(string,sizeof(string),""IINFO" du hast aus %ikg Erz %ikg Eisenerz gewonnen",VehicleLoadTank[GetPlayerVehicleID(playerid)],VehicleLoadTank[GetPlayerVehicleID(playerid)]/2);
					SCM(playerid,SAMP_WEISS,string);
					format(string,sizeof(string),"Verdienst: %i$",VehicleLoadTank[GetPlayerVehicleID(playerid)]/5);
					SCM(playerid,SAMP_WEISS,string);
					SCM(playerid,SAMP_WEISS,"Info: Die Auszahlung wird am Zahltag auf dein Konto überwiesen.");
					Spieler[playerid][pLohn] += (VehicleLoadTank[GetPlayerVehicleID(playerid)]/5);
				    VehicleLoadTank[GetPlayerVehicleID(playerid)] = 0;
				    SetPlayerCheckpoint(playerid,557.8638,911.2230,-42.7409,3.0);
					Spieler[playerid][pIsearch] = 1;
					return 1;
				}
				return SCM(playerid,SAMP_WEISS,"Entladen fehlgeschlagen. Drücke 'Num8' 7 Sekunden lang.");
			}
            return SCM(playerid,SAMP_WEISS,"Entladen fehlgeschlagen. Nicht an der Aussortierungsmaschine.");
		}
	}
	return 1;
}
public Spraytag(playerid,count)
{
    new Float:a,string[128],KEY:keys,ud,lr;
    GetPlayerKeys(playerid,keys,ud,lr);
    switch(count)
    {
	    case 0:
	    {
		    if(keys & KEY_FIRE && GetPlayerWeapon(playerid) == WEAPON_SPRAYCAN)
		    {
		        if(!IsPlayerInVehicle(playerid,GetPlayerVehicleID(playerid)))
		        {
				    for(new i=0;i<MAX_SPRAYTAGS;i++)
					{
					 	if(Spray[i][Erstellt] == 0)
						{
						    if(gettime() > SpraytagDay[Spieler[playerid][pFraktion]])
	 						{
								GetPlayerPos(playerid,Spray[i][sperreX],Spray[i][sperreY],Spray[i][sperreZ]);
								GetPlayerFacingAngle(playerid,a);
							    Spray[i][Erstellt] = 1;
							    format(string,sizeof(string),"** %s sprayt sein Gangtag an die Wand,´%s in the Hood´ **",SpielerName(playerid),FraktionsName(Spieler[playerid][pFraktion]));
								PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
								SpraytagDay[Spieler[playerid][pFraktion]] = gettime() + (60*240);
							    switch(Spieler[playerid][pFraktion])
							    {
								    case 4:{
										Spray[i][ID] = CreateDynamicObject(18665,Spray[i][sperreX],Spray[i][sperreY],Spray[i][sperreZ],0.0,0.0,a + 90.0);//los santos vagos tag
									}
								    case 5:{
										Spray[i][ID] = CreateDynamicObject(18659,Spray[i][sperreX],Spray[i][sperreY],Spray[i][sperreZ],0.0,0.0,a + 90.0);//grove street tag
									}
									case 7:{
										Spray[i][ID] = CreateDynamicObject(18664,Spray[i][sperreX],Spray[i][sperreY],Spray[i][sperreZ],0.0,0.0,a + 90.0);//ballas tag
									}
									case 13:{
										Spray[i][ID] = CreateDynamicObject(18663,Spray[i][sperreX],Spray[i][sperreY],Spray[i][sperreZ],0.0,0.0,a + 90.0);//Sureno Syndikat tag
									}
									case 17:{
										Spray[i][ID] = CreateDynamicObject(18660,Spray[i][sperreX],Spray[i][sperreY],Spray[i][sperreZ],0.0,0.0,a + 90.0);//Sureno Syndikat tag
									}
								}
							}
							else
							{
								new stimes = SpraytagDay[Spieler[playerid][pFraktion]]-gettime();
								format(string,sizeof(string),""IINFO" du kannst erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten ein weiteres Gangtag sprayen.",floatround(stimes/60),floatround(stimes%60));
								SCM(playerid,SAMP_WEISS,string);
							}
						    return 1;
					    }
					}
				}
			}
		}
		case 1:
		{
			if(keys & KEY_FIRE && GetPlayerWeapon(playerid) == WEAPON_SPRAYCAN)
		    {
				for(new i=0;i<MAX_SPRAYTAGS;i++)
				{
					if(IsPlayerInRangeOfPoint(playerid,2,Spray[i][sperreX],Spray[i][sperreY],Spray[i][sperreZ]))
				   	{
					 	if(Spray[i][Erstellt] == 1)
						{
						  	Spray[i][sperreX] = -1;
						   	Spray[i][sperreY] = -1;
						    Spray[i][sperreZ] = -1;
						    Spray[i][Erstellt] = 0;
						    DestroyDynamicObject(Spray[i][ID]);
						    SCM(playerid,SAMP_WEISS,""IINFO" Spraytag entfernt.");
						    return 1;
					    }
				    }
		    	}
			}
		}
	}
	return 1;
}
public AFKzeit(playerid)
{
    new string[256];
	Spieler[playerid][pAFKAwayTime]++;
	if(Spieler[playerid][pAFKAwayTime] >= 5000)
	{
		format(string,sizeof(string),"%s du wurdest vom Server gekickt.\nDer Grund für den Kick von dem Admin System war: Zu lange Inaktivität.\nFalls du zu unrecht gekickt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[playerid][pName]);
		ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Kick",string,"Verlassen","");
		KillTimer(UpdateAFK[playerid]);
		KickUser(playerid,"System","Zu lange Inaktivität");
	}
	if(Spieler[playerid][pAFKAwayTime] >= 900)
	{
		Spieler[playerid][pAFKPDAYDOWN] = true;
		if(Spieler[playerid][pAdminOnduty] == true)
		{
			SCM(playerid,SAMP_WEISS,"** Du bist nun nicht mehr im Admindienst **");
			Delete3DTextLabel(AdminDuty_3DText[playerid]);
			Spieler[playerid][pAdminOnduty] = false;
			SetPlayerName(playerid,Spieler[playerid][pName]);
			SetPlayerScore(playerid,GetPlayerLevel(playerid));
			if(Spieler[playerid][pMaske] == 1)
			{
				SetPlayerScore(playerid,random(50) + 122);
				format(string,sizeof(string),"Unbekannter(%i)",random(50) + 122);
				SetPlayerName(playerid,string);
			}
			if(Spieler[playerid][pDuty] == 4)
			{
				SetPlayerScore(playerid,random(50) + 122);
				format(string,24,"SWAT%i",random(50) + 122);
				SetPlayerName(playerid,string);
			}
		}
		format(string,sizeof(string),"%i - Sekunden",Spieler[playerid][pAFKAwayTime]);
		return SCM(playerid,SAMP_WEISS,"");
	}
 	format(string,sizeof(string),"%i - Sekunden von %i - Sekunden",180-Spieler[playerid][pAFKAwayTime],Spieler[playerid][pAFKAwayTime]);
	//TextDrawSetString(AFK_MODUS_Anzeige[playerid],string);
	return 1;
}
public Elevator_Boost(floorid)
{
	// Increases the elevator's speed until it reaches 'floorid'
	StopDynamicObject(Obj_Elevator);
	StopDynamicObject(Obj_ElevatorDoors[0]);
	StopDynamicObject(Obj_ElevatorDoors[1]);
	MoveDynamicObject(Obj_Elevator,1786.678100,-1303.459472,GROUND_Z_COORD + FloorZOffsets[floorid] + ELEVATOR_OFFSET,ELEVATOR_SPEED);
    MoveDynamicObject(Obj_ElevatorDoors[0],X_DOOR_CLOSED,-1303.459472,GROUND_Z_COORD + FloorZOffsets[floorid],ELEVATOR_SPEED);
    MoveDynamicObject(Obj_ElevatorDoors[1],X_DOOR_CLOSED,-1303.459472,GROUND_Z_COORD + FloorZOffsets[floorid],ELEVATOR_SPEED);
	return 1;
}
public Elevator_TurnToIdle()
{
	ElevatorState = ELEVATOR_STATE_IDLE;
	ReadNextFloorInQueue();
	return 1;
}
public HauslockbyMakler(playerid,haus)
{
	new string[128];
	ImmobilienKeyID[playerid] = 0;
	if(HausInfo[haus][haus_Owned] == 0 && HausInfo[haus][haus_locked] == 0 && isPlayerInJob(playerid,18))
	{
	    HausInfo[haus][haus_locked] = 1;
	    SCM(playerid,SAMP_WEISS,""IINFO" du hast vergessen die Tür abzuschließen!!!");
	    format(string,sizeof(string),""IINFO" das beantragte Haus (Hausnummer %i) wurde abgeschlossen.",haus);
	    SCM(playerid,SAMP_WEISS,string);
	    Spieler[playerid][JobWarns]++;
	    format(string,sizeof(string),"Abmarnungen: "IINFO2"%i"#HTML_WEISS" / "IINFO2"3",Spieler[playerid][JobWarns]);
	    SCM(playerid,SAMP_WEISS,string);
	    KillTimer(ImmobilienTimer[playerid]);
	    if(Spieler[playerid][JobWarns] >= 3)
	    {
		    SCM(playerid,SAMP_WEISS,""IINFO" du wurdest gekündigt,da du zuviele Abmarnungen gekriegt hast!");
		    Spieler[playerid][JobWarns] = 0;
		    Spieler[playerid][pJob] = 0;
		    return 1;
	    }
	    SCM(playerid,SAMP_WEISS,""IINFO" sollte das öfters passieren wirst du fristlos gekündigt!!!!");
	    return 1;
    }
    else
    {
    	KillTimer(ImmobilienTimer[playerid]);
    }
	return 1;
}
public DriveIn(playerid)
{
    if(IsPlayerInAnyVehicle(playerid))
	{
		switch(Spieler[playerid][pWaitEatingMenu])
		{
			case 1:
			{
				SCM(playerid,WEISS,"Guten Appetit!");
				TogglePlayerControllable(playerid,true);
				Spieler[playerid][pWaitEatingMenu] = 0;
				Spieler[playerid][pWaitEating] = 0;
				if((floatadd(GetPlayerACHealth(playerid), 5)) > 100)return SetPlayerACHealth(playerid,100);
				SetPlayerACHealth(playerid,floatadd(GetPlayerACHealth(playerid), 5));
			}
			case 2:
			{
				SCM(playerid,WEISS,"Guten Appetit!");
				TogglePlayerControllable(playerid,true);
				Spieler[playerid][pWaitEatingMenu] = 0;
				Spieler[playerid][pWaitEating] = 0;
			    if((floatadd(GetPlayerACHealth(playerid), 10)) > 100)return SetPlayerACHealth(playerid,100);
				SetPlayerACHealth(playerid,floatadd(GetPlayerACHealth(playerid), 10));
			}
			case 3:
			{
				SCM(playerid,WEISS,"Guten Appetit!");
				TogglePlayerControllable(playerid,true);
				Spieler[playerid][pWaitEatingMenu] = 0;
				Spieler[playerid][pWaitEating] = 0;
				if((floatadd(GetPlayerACHealth(playerid), 15)) > 100)return SetPlayerACHealth(playerid,100);
				SetPlayerACHealth(playerid,floatadd(GetPlayerACHealth(playerid), 15));
			}
			case 4:
			{
				SCM(playerid,WEISS,"Guten Appetit!");
				TogglePlayerControllable(playerid,true);
				Spieler[playerid][pWaitEatingMenu] = 0;
				Spieler[playerid][pWaitEating] = 0;
				if((floatadd(GetPlayerACHealth(playerid), 20)) > 100)return SetPlayerACHealth(playerid,100);
				SetPlayerACHealth(playerid,floatadd(GetPlayerACHealth(playerid), 20));
			}
			case 5:
			{
				SCM(playerid,WEISS,"Guten Appetit!");
				TogglePlayerControllable(playerid,true);
				Spieler[playerid][pWaitEatingMenu] = 0;
				Spieler[playerid][pWaitEating] = 0;
				if((floatadd(GetPlayerACHealth(playerid), 35)) > 100)return SetPlayerACHealth(playerid,100);
				SetPlayerACHealth(playerid,floatadd(GetPlayerACHealth(playerid), 35));
			}
		}
	}
	return 1;
}
public OnDrugVeganceUpdate()
{
	for(new drg=0;drg<MAX_DRUGS;drg++)
	{
		if(DrugInfo[drg][drgfraktid] != 0)
		{
			DrugInfo[drg][drgWasserzustand]--;
			if(DrugInfo[drg][drgWasserzustand] <= 0)
			{
				DestroyDrugVegancy(drg);
			}
		}
	}
	return 1;
}
public OnGangwarUpdate1()
{
	new string[128];
    for(new gw;gw<sizeof(GangwarZones);gw++)
	{
		if(GangwarZones[gw][War_Time] != 0 && GangwarZones[gw][War_Attacker] != 0 && GangwarZones[gw][War_Started] != 0)
		{
			if(IsPlayerConnected(GangwarZones[gw][War_CaptureHero][0]) && IsPlayerInRangeOfPoint(GangwarZones[gw][War_CaptureHero][0],5.0,GangwarZones[gw][War_FlagX1],GangwarZones[gw][War_FlagY1],GangwarZones[gw][War_FlagZ1]))
			{
				switch(GangwarZones[gw][War_CaptureTime][0])
				{
					case 1:
					{
						SCM(GangwarZones[gw][War_CaptureHero][0],WEISS,"Noch 30 Sekunden bis zur Flaggeneroberung!"),TextDrawBackgroundColour(GangwarZones[gw][WARdraw][4],ROT),TextDrawColour(GangwarZones[gw][WARdraw][4],ROT),TextDrawSetString(GangwarZones[gw][WARdraw][4],".");
					    ForEachPlayer(i)
						{
						    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
							{
							    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
								{
									TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][4]),TextDrawShowForPlayer(i,GangwarZones[gw][WARdraw][4]);
								}
							}
						}
					}
				    case 10:SCM(GangwarZones[gw][War_CaptureHero][0],WEISS,"Noch 20 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][4],".....");
					case 15:SCM(GangwarZones[gw][War_CaptureHero][0],WEISS,"Noch 15 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][4],".......");
					case 25:SCM(GangwarZones[gw][War_CaptureHero][0],WEISS,"Noch 5 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][4],"..........");
					case 26:SCM(GangwarZones[gw][War_CaptureHero][0],WEISS,"Noch 4 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][4],"...........");
					case 27:SCM(GangwarZones[gw][War_CaptureHero][0],WEISS,"Noch 3 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][4],"............");
					case 28:SCM(GangwarZones[gw][War_CaptureHero][0],WEISS,"Noch 2 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][4],".............");
					case 29:SCM(GangwarZones[gw][War_CaptureHero][0],WEISS,"Noch 1 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][4],"..............");
					case 30:
					{
					TextDrawBackgroundColour(GangwarZones[gw][WARdraw][4],GRUEN),TextDrawColour(GangwarZones[gw][WARdraw][4],GRUEN),TextDrawSetString(GangwarZones[gw][WARdraw][4],"..............");
				    format(string,sizeof(string),"Gangwar: %s hat es geschafft die Flagge einzunehmen!",SpielerName(GangwarZones[gw][War_CaptureHero][0]));
					ForEachPlayer(i)
					{
					    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
						{
						    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
							{
						    	SCM(i,GWCHATCOLOR,string);
						    	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][4]),TextDrawShowForPlayer(i,GangwarZones[gw][WARdraw][4]);
							}
					    }
				    }
				    format(string,sizeof(string),"%s",FraktionsName(Spieler[GangwarZones[gw][War_CaptureHero][0]][pFraktion]));//Flagge 1
				    TextDrawSetString(GangwarZones[gw][WARdraw][3],string);
					format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gw][War_Zone_Name],FraktionsName(Spieler[GangwarZones[gw][War_CaptureHero][0]][pFraktion])),
				    UpdateDynamic3DTextLabelText(WarLabel[gw][0],0xCDFF00CC,string);
					SCM(GangwarZones[gw][War_CaptureHero][0],GWCHATCOLOR,"Flagge erfolgreich eingenommen!");
					GangwarZones[gw][War_CaptureTime][0] = 0;
					GangwarZones[gw][War_CapturedFlags][0] = Spieler[GangwarZones[gw][War_CaptureHero][0]][pFraktion];
					if(Spieler[GangwarZones[gw][War_CaptureHero][0]][pFraktion] == GangwarZones[gw][War_Owner])
					{
					    GangwarZones[gw][War_CaptureFlags_Owner]++;
					    if(GangwarZones[gw][War_CaptureFlags_Attacker] <= 0)
					    {
					    	GangwarZones[gw][War_CaptureFlags_Attacker] = 0;
					    }
					    GangwarZones[gw][War_CaptureFlags_Attacker]--;
					}
					if(Spieler[GangwarZones[gw][War_CaptureHero][0]][pFraktion] == GangwarZones[gw][War_Attacker])
					{
					    GangwarZones[gw][War_CaptureFlags_Attacker]++;
					    if(GangwarZones[gw][War_CaptureFlags_Owner] <= 0)
					    {
					    	GangwarZones[gw][War_CaptureFlags_Owner] = 0;
					    }
					    GangwarZones[gw][War_CaptureFlags_Owner]--;
					}
					GangwarZones[gw][War_CaptureHero][0] = -1;
					}
				}
				GangwarZones[gw][War_CaptureTime][0]++;
				}
				else
				{
			    TextDrawBackgroundColour(GangwarZones[gw][WARdraw][4],GRUEN),TextDrawColour(GangwarZones[gw][WARdraw][4],GRUEN),TextDrawSetString(GangwarZones[gw][WARdraw][4],"..............");
			    ForEachPlayer(i)
				{
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
					{
					    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
						{
							TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][4]),TextDrawShowForPlayer(i,GangwarZones[gw][WARdraw][4]);
						}
					}
				}
				SCM(GangwarZones[gw][War_CaptureHero][0],SAMP_WEISS,""IINFO" du hast es nicht geschafft die Flagge einzunehmen!");
				GangwarZones[gw][War_CaptureTime][0] = 0;
				GangwarZones[gw][War_CaptureHero][0] = -1;
			}
			if(IsPlayerConnected(GangwarZones[gw][War_CaptureHero][1]) && IsPlayerInRangeOfPoint(GangwarZones[gw][War_CaptureHero][1],5.0,GangwarZones[gw][War_FlagX2],GangwarZones[gw][War_FlagY2],GangwarZones[gw][War_FlagZ2]))
			{
				switch(GangwarZones[gw][War_CaptureTime][1])
				{
					case 1:
					{
						SCM(GangwarZones[gw][War_CaptureHero][1],WEISS,"Noch 30 Sekunden bis zur Flaggeneroberung!"),TextDrawBackgroundColour(GangwarZones[gw][WARdraw][6],ROT),TextDrawColour(GangwarZones[gw][WARdraw][6],ROT),TextDrawSetString(GangwarZones[gw][WARdraw][6],".");
					    ForEachPlayer(i)
						{
						    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
							{
							    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
								{
									TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][6]),TextDrawShowForPlayer(i,GangwarZones[gw][WARdraw][6]);
								}
							}
						}
					}
					case 10:SCM(GangwarZones[gw][War_CaptureHero][1],WEISS,"Noch 20 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][6],".....");
					case 15:SCM(GangwarZones[gw][War_CaptureHero][1],WEISS,"Noch 15 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][6],".......");
					case 25:SCM(GangwarZones[gw][War_CaptureHero][1],WEISS,"Noch 5 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][6],"..........");
					case 26:SCM(GangwarZones[gw][War_CaptureHero][1],WEISS,"Noch 4 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][6],"...........");
					case 27:SCM(GangwarZones[gw][War_CaptureHero][1],WEISS,"Noch 3 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][6],"............");
					case 28:SCM(GangwarZones[gw][War_CaptureHero][1],WEISS,"Noch 2 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][6],".............");
					case 29:SCM(GangwarZones[gw][War_CaptureHero][1],WEISS,"Noch 1 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][6],"..............");
					case 30:
					{
					TextDrawBackgroundColour(GangwarZones[gw][WARdraw][6],GRUEN),TextDrawColour(GangwarZones[gw][WARdraw][6],GRUEN),TextDrawSetString(GangwarZones[gw][WARdraw][6],"..............");
				    format(string,sizeof(string),"Gangwar: %s hat es geschafft die Flagge einzunehmen!",SpielerName(GangwarZones[gw][War_CaptureHero][1]));
					ForEachPlayer(i)
					{
					    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
						{
						    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
							{
						    	SCM(i,GWCHATCOLOR,string);
						    	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][6]),TextDrawShowForPlayer(i,GangwarZones[gw][WARdraw][6]);
							}
					    }
				    }
				    format(string,sizeof(string),"%s",FraktionsName(Spieler[GangwarZones[gw][War_CaptureHero][1]][pFraktion]));//Flagge 1
				    TextDrawSetString(GangwarZones[gw][WARdraw][5],string);
					format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gw][War_Zone_Name],FraktionsName(Spieler[GangwarZones[gw][War_CaptureHero][1]][pFraktion])),
				    UpdateDynamic3DTextLabelText(WarLabel[gw][1],0xCDFF00CC,string);
					SCM(GangwarZones[gw][War_CaptureHero][1],GWCHATCOLOR,"Flagge erfolgreich eingenommen!");
					GangwarZones[gw][War_CaptureTime][1] = 0;
					GangwarZones[gw][War_CapturedFlags][1] = Spieler[GangwarZones[gw][War_CaptureHero][1]][pFraktion];
					if(Spieler[GangwarZones[gw][War_CaptureHero][1]][pFraktion] == GangwarZones[gw][War_Owner])
					{
					    GangwarZones[gw][War_CaptureFlags_Owner]++;
					    if(GangwarZones[gw][War_CaptureFlags_Attacker] <= 0)
					    {
					    	GangwarZones[gw][War_CaptureFlags_Attacker] = 0;
					    }
					    GangwarZones[gw][War_CaptureFlags_Attacker]--;
					}
					if(Spieler[GangwarZones[gw][War_CaptureHero][1]][pFraktion] == GangwarZones[gw][War_Attacker])
					{
					    GangwarZones[gw][War_CaptureFlags_Attacker]++;
					    if(GangwarZones[gw][War_CaptureFlags_Owner] <= 0)
					    {
					    	GangwarZones[gw][War_CaptureFlags_Owner] = 0;
					    }
					    GangwarZones[gw][War_CaptureFlags_Owner]--;
					}
					GangwarZones[gw][War_CaptureHero][1] = -1;
					}
				}
				GangwarZones[gw][War_CaptureTime][1]++;
			}
			else
			{
			    TextDrawBackgroundColour(GangwarZones[gw][WARdraw][6],GRUEN),TextDrawColour(GangwarZones[gw][WARdraw][6],GRUEN),TextDrawSetString(GangwarZones[gw][WARdraw][6],"..............");
			    ForEachPlayer(i)
				{
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
					{
					    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
						{
							TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][6]),TextDrawShowForPlayer(i,GangwarZones[gw][WARdraw][6]);
						}
					}
				}
				SCM(GangwarZones[gw][War_CaptureHero][1],SAMP_WEISS,""IINFO" du hast es nicht geschafft die Flagge einzunehmen!");
				GangwarZones[gw][War_CaptureTime][1] = 0;
				GangwarZones[gw][War_CaptureHero][1] = -1;
			}
			if(IsPlayerConnected(GangwarZones[gw][War_CaptureHero][2]) && IsPlayerInRangeOfPoint(GangwarZones[gw][War_CaptureHero][2],5.0,GangwarZones[gw][War_FlagX3],GangwarZones[gw][War_FlagY3],GangwarZones[gw][War_FlagZ3]))
			{
				switch(GangwarZones[gw][War_CaptureTime][2])
				{
					case 1:
					{
						SCM(GangwarZones[gw][War_CaptureHero][2],WEISS,"Noch 30 Sekunden bis zur Flaggeneroberung!"),TextDrawBackgroundColour(GangwarZones[gw][WARdraw][8],ROT),TextDrawColour(GangwarZones[gw][WARdraw][8],ROT),TextDrawSetString(GangwarZones[gw][WARdraw][8],".");
					    ForEachPlayer(i)
						{
						    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
							{
							    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
								{
									TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][8]),TextDrawShowForPlayer(i,GangwarZones[gw][WARdraw][8]);
								}
							}
						}
					}
					case 10:SCM(GangwarZones[gw][War_CaptureHero][2],WEISS,"Noch 20 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][8],".....");
					case 15:SCM(GangwarZones[gw][War_CaptureHero][2],WEISS,"Noch 15 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][8],".......");
					case 25:SCM(GangwarZones[gw][War_CaptureHero][2],WEISS,"Noch 5 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][8],"..........");
					case 26:SCM(GangwarZones[gw][War_CaptureHero][2],WEISS,"Noch 4 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][8],"...........");
					case 27:SCM(GangwarZones[gw][War_CaptureHero][2],WEISS,"Noch 3 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][8],"............");
					case 28:SCM(GangwarZones[gw][War_CaptureHero][2],WEISS,"Noch 2 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][8],".............");
					case 29:SCM(GangwarZones[gw][War_CaptureHero][2],WEISS,"Noch 1 Sekunden bis zur Flaggeneroberung!"),TextDrawSetString(GangwarZones[gw][WARdraw][8],"..............");
					case 30:
					{
					TextDrawBackgroundColour(GangwarZones[gw][WARdraw][8],GRUEN),TextDrawColour(GangwarZones[gw][WARdraw][8],GRUEN),TextDrawSetString(GangwarZones[gw][WARdraw][8],"..............");
				    format(string,sizeof(string),"Gangwar: %s hat es geschafft die Flagge einzunehmen!",SpielerName(GangwarZones[gw][War_CaptureHero][2]));
					ForEachPlayer(i)
					{
					    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
						{
						    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
							{
						    	SCM(i,GWCHATCOLOR,string);
						    	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][8]),TextDrawShowForPlayer(i,GangwarZones[gw][WARdraw][8]);
						    }
					    }
				    }
				    format(string,sizeof(string),"%s",FraktionsName(Spieler[GangwarZones[gw][War_CaptureHero][2]][pFraktion]));//Flagge 1
				    TextDrawSetString(GangwarZones[gw][WARdraw][7],string);
					format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gw][War_Zone_Name],FraktionsName(Spieler[GangwarZones[gw][War_CaptureHero][2]][pFraktion])),
				    UpdateDynamic3DTextLabelText(WarLabel[gw][2],0xCDFF00CC,string);
					SCM(GangwarZones[gw][War_CaptureHero][2],GWCHATCOLOR,"Flagge erfolgreich eingenommen!");
					GangwarZones[gw][War_CaptureTime][2] = 0;
					GangwarZones[gw][War_CapturedFlags][2] = Spieler[GangwarZones[gw][War_CaptureHero][2]][pFraktion];
					if(Spieler[GangwarZones[gw][War_CaptureHero][2]][pFraktion] == GangwarZones[gw][War_Owner])
					{
					    GangwarZones[gw][War_CaptureFlags_Owner]++;
					    if(GangwarZones[gw][War_CaptureFlags_Attacker] <= 0)
				 		{
					    	GangwarZones[gw][War_CaptureFlags_Attacker] = 0;
				 		}
					    GangwarZones[gw][War_CaptureFlags_Attacker]--;
					}
					if(Spieler[GangwarZones[gw][War_CaptureHero][2]][pFraktion] == GangwarZones[gw][War_Attacker])
					{
					 	GangwarZones[gw][War_CaptureFlags_Attacker]++;
					 	if(GangwarZones[gw][War_CaptureFlags_Owner] <= 0)
					 	{
					 		GangwarZones[gw][War_CaptureFlags_Owner] = 0;
					 	}
						GangwarZones[gw][War_CaptureFlags_Owner]--;
					}
					GangwarZones[gw][War_CaptureHero][2] = -1;
					}
				}
				GangwarZones[gw][War_CaptureTime][2]++;
			}
			else
			{
   				TextDrawBackgroundColour(GangwarZones[gw][WARdraw][8],GRUEN),TextDrawColour(GangwarZones[gw][WARdraw][8],GRUEN),TextDrawSetString(GangwarZones[gw][WARdraw][8],"..............");
			    ForEachPlayer(i)
				{
    				if(IsPlayerConnected(i) && !IsPlayerNPC(i))
					{
					    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
						{
							TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][6]),TextDrawShowForPlayer(i,GangwarZones[gw][WARdraw][6]);
						}
					}
				}
				SCM(GangwarZones[gw][War_CaptureHero][2],SAMP_WEISS,""IINFO" du hast es nicht geschafft die Flagge einzunehmen!");
				GangwarZones[gw][War_CaptureTime][2] = 0;
				GangwarZones[gw][War_CaptureHero][2] = -1;
			}
			if(GangwarZones[gw][War_OwnerPoints] >= MAX_GWPOINT4WINNER)
			{
			    ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
				    {
					    if(!isPlayerInFrakt(i,GangwarZones[gw][War_Owner]) || !isPlayerInFrakt(i,GangwarZones[gw][War_Attacker]))
					    {
						    format(string,sizeof(string),"%s%s~w~ hat das Gangwar~n~gewonnen",GWFraktionsGameTextColor(GangwarZones[gw][War_Owner]),FraktionsName(GangwarZones[gw][War_Owner]));
						    GameTextForPlayer(i,string,7500,5);
					    }
					    if(isPlayerInFrakt(i,GangwarZones[gw][War_Owner]))
					    {
						    GangZoneStopFlashForPlayer(i,GangwarZones[gw][War_ZoneID]);
						    GangZoneHideForPlayer(i,GangwarZones[gw][War_ZoneID]);
						    GangZoneShowForPlayer(i,GangwarZones[gw][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gw][War_Owner]));
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][0]);
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][1]);
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][2]);
							TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][3]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][4]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][5]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][6]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][7]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][8]);
						    GameTextForPlayer(i,"~g~GANGWAR GEWONNEN",7500,5);
							StopAudioStreamForPlayer(i);
							PlayAudioStreamForPlayer(i,ServerSounds[9],0.0,0.0,0.0);
					    }
					    if(isPlayerInFrakt(i,GangwarZones[gw][War_Attacker]))
					    {
						    GangZoneStopFlashForPlayer(i,GangwarZones[gw][War_ZoneID]);
						    GangZoneHideForPlayer(i,GangwarZones[gw][War_ZoneID]);
						    GangZoneShowForPlayer(i,GangwarZones[gw][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gw][War_Owner]));
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][0]);
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][1]);
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][2]);
							TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][3]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][4]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][5]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][6]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][7]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][8]);
						    GameTextForPlayer(i,"~r~GANGWAR VERLOREN",7500,5);
							StopAudioStreamForPlayer(i);
						    
					    }
				    }
			    }
			    GWisStarted4Fraktion[GangwarZones[gw][War_Owner]] = 0;
			    GWisStarted4Fraktion[GangwarZones[gw][War_Attacker]] = 0;
			    GangwarZones[gw][War_Attacker] = 0;
				GangwarZones[gw][War_AttackerPoints] = 0;
			 	GangwarZones[gw][War_OwnerPoints] = 0;
			 	GangwarZones[gw][War_CaptureFlags_Owner] = 0;
				GangwarZones[gw][War_CaptureFlags_Attacker] = 0;
				GangwarZones[gw][War_CaptureHero][0] = -1;
				GangwarZones[gw][War_CaptureHero][1] = -1;
				GangwarZones[gw][War_CaptureHero][2] = -1;
				GangwarZones[gw][War_CapturedFlags][0] = 0;
				GangwarZones[gw][War_CapturedFlags][1] = 0;
				GangwarZones[gw][War_CapturedFlags][2] = 0;
				GangwarZones[gw][War_Started] = 0;
				GangwarZones[gw][War_Time] = 0;
				format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
			    UpdateDynamic3DTextLabelText(WarLabel[gw][0],SAMP_WEISS,string);
				format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
			    UpdateDynamic3DTextLabelText(WarLabel[gw][1],SAMP_WEISS,string);
				format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
			    UpdateDynamic3DTextLabelText(WarLabel[gw][2],SAMP_WEISS,string);
			    return 1;
			}
			if(GangwarZones[gw][War_AttackerPoints] >= MAX_GWPOINT4WINNER)
			{
				ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
				    {
					    if(!isPlayerInFrakt(i,GangwarZones[gw][War_Owner]) || !isPlayerInFrakt(i,GangwarZones[gw][War_Attacker]))
					    {
						    format(string,sizeof(string),"%s%s~w~ hat das Gangwar~n~gewonnen",GWFraktionsGameTextColor(GangwarZones[gw][War_Attacker]),FraktionsName(GangwarZones[gw][War_Attacker]));
						    GameTextForPlayer(i,string,7500,5);
					    }
					    if(isPlayerInFrakt(i,GangwarZones[gw][War_Attacker]))
					    {
						    GangZoneStopFlashForPlayer(i,GangwarZones[gw][War_ZoneID]);
						    GangZoneHideForPlayer(i,GangwarZones[gw][War_ZoneID]);
						    GangZoneShowForPlayer(i,GangwarZones[gw][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gw][War_Owner]));
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][0]);
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][1]);
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][2]);
							TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][3]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][4]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][5]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][6]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][7]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][8]);
						    GameTextForPlayer(i,"~g~GANGWAR GEWONNEN",7500,5);
							StopAudioStreamForPlayer(i);
							PlayAudioStreamForPlayer(i,ServerSounds[9],0.0,0.0,0.0);
					    }
					    if(isPlayerInFrakt(i,GangwarZones[gw][War_Owner]))
					    {
						    GangZoneStopFlashForPlayer(i,GangwarZones[gw][War_ZoneID]);
						    GangZoneHideForPlayer(i,GangwarZones[gw][War_ZoneID]);
						    GangZoneShowForPlayer(i,GangwarZones[gw][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gw][War_Owner]));
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][0]);
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][1]);
						    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][2]);
							TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][3]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][4]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][5]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][6]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][7]);
						 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][8]);
						    GameTextForPlayer(i,"~r~GANGWAR VERLOREN",7500,5);
							StopAudioStreamForPlayer(i);
						    
					    }
				    }
			    }
			    GWisStarted4Fraktion[GangwarZones[gw][War_Owner]] = 0;
			    GWisStarted4Fraktion[GangwarZones[gw][War_Attacker]] = 0;
			    GangwarZones[gw][War_Owner] = GangwarZones[gw][War_Attacker];
				GangwarZones[gw][War_Attacker] = 0;
			    GangwarZones[gw][War_AttackerPoints] = 0;
			 	GangwarZones[gw][War_OwnerPoints] = 0;
			 	GangwarZones[gw][War_CaptureFlags_Owner] = 0;
				GangwarZones[gw][War_CaptureFlags_Attacker] = 0;
				GangwarZones[gw][War_CaptureHero][0] = -1;
				GangwarZones[gw][War_CaptureHero][1] = -1;
				GangwarZones[gw][War_CaptureHero][2] = -1;
				GangwarZones[gw][War_CapturedFlags][0] = 0;
				GangwarZones[gw][War_CapturedFlags][1] = 0;
				GangwarZones[gw][War_CapturedFlags][2] = 0;
				GangwarZones[gw][War_Started] = 0;
				GangwarZones[gw][War_Time] = 0;
				format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
			    UpdateDynamic3DTextLabelText(WarLabel[gw][0],SAMP_WEISS,string);
				format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
			    UpdateDynamic3DTextLabelText(WarLabel[gw][1],SAMP_WEISS,string);
				format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
			    UpdateDynamic3DTextLabelText(WarLabel[gw][2],SAMP_WEISS,string);
			    return 1;
			}
		}
	}
	return 1;
}
public OnGangwarUpdate2()
{
	new string[128];
    for(new gw;gw<sizeof(GangwarZones);gw++)
	{
		if(GangwarZones[gw][War_Started] == 1 && GangwarZones[gw][War_Time] != 0)
		{
		GangwarZones[gw][War_Time]--;
		format(string,sizeof(string),"%i Min",GangwarZones[gw][War_Time]);
		TextDrawSetString(GangwarZones[gw][WARdraw][2],string);
		GangwarZones[gw][War_OwnerPoints] += GangwarZones[gw][War_CaptureFlags_Owner];
		format(string,sizeof(string),"%s %i/%i",FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_OwnerPoints],MAX_GWPOINT4WINNER);
		TextDrawSetString(GangwarZones[gw][WARdraw][0],string);
		GangwarZones[gw][War_AttackerPoints] += GangwarZones[gw][War_CaptureFlags_Attacker];
		format(string,sizeof(string),"%s %i/%i",FraktionsName(GangwarZones[gw][War_Attacker]),GangwarZones[gw][War_AttackerPoints],MAX_GWPOINT4WINNER);
		TextDrawSetString(GangwarZones[gw][WARdraw][1],string);
		if(GangwarZones[gw][War_Time] <= 0)
		{
		if(GangwarZones[gw][War_OwnerPoints] == GangwarZones[gw][War_AttackerPoints])
	    {
		    ForEachPlayer(i)
		    {
			    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			    {
				    if(!isPlayerInFrakt(i,GangwarZones[gw][War_Owner]) || !isPlayerInFrakt(i,GangwarZones[gw][War_Attacker]))
				    {
					    format(string,sizeof(string),"~b~GANGWAR: %s%s~b~ zwischen %s%s~b~~n~ging unentschieden aus",GWFraktionsGameTextColor(GangwarZones[gw][War_Owner]),FraktionsName(GangwarZones[gw][War_Owner]),GWFraktionsGameTextColor(GangwarZones[gw][War_Attacker]),FraktionsName(GangwarZones[gw][War_Attacker]));
					    GameTextForPlayer(i,string,7500,5);
				    }
				    if(isPlayerInFrakt(i,GangwarZones[gw][War_Attacker]))
				    {
					    GangZoneStopFlashForPlayer(i,GangwarZones[gw][War_ZoneID]);
					    GangZoneHideForPlayer(i,GangwarZones[gw][War_ZoneID]);
					    GangZoneShowForPlayer(i,GangwarZones[gw][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gw][War_Owner]));
					    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][0]);
					    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][1]);
					    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][2]);
						TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][3]);
					 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][4]);
					 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][5]);
					 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][6]);
					 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][7]);
					 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][8]);
					    GameTextForPlayer(i,"~b~GANGWAR UNENTSCHIEDEN",7500,5);
						StopAudioStreamForPlayer(i);
						PlayAudioStreamForPlayer(i,ServerSounds[10],0.0,0.0,0.0);
				    }
				    if(isPlayerInFrakt(i,GangwarZones[gw][War_Owner]))
				    {
					    GangZoneStopFlashForPlayer(i,GangwarZones[gw][War_ZoneID]);
					    GangZoneHideForPlayer(i,GangwarZones[gw][War_ZoneID]);
					    GangZoneShowForPlayer(i,GangwarZones[gw][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gw][War_Owner]));
					    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][0]);
					    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][1]);
					    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][2]);
						TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][3]);
