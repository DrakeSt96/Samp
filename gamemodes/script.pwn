COMMAND:warn(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128],reason[31];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
 	if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /warn [playerid/Name][Grund]");
    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /warn [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	Spieler[pID][pWarns]++;
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) einen Warn gegeben. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,reason);
	SendAdminMessage(SAMP_WEISS,string);
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat dir einen Warn gegeben. Grund: %s",Spieler[playerid][pName],playerid,reason);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),"Name:%s | Admin:%s | Grund:%s\n",Spieler[pID][pName],Spieler[playerid][pName],reason);
	Log("Warnsqllog",string);
	if(Spieler[pID][pWarns] > 2)
	{
		format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: 3 Warns",Spieler[pID][pName],pID);
		SendClientMessageToAll(SAMP_WEISS,string);
		format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nDer Grund für den Bann von dem Admin %s war: %s.\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[pID][pName],Spieler[playerid][pName],reason);
		ShowPlayerDialog(pID,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
		BanUser(pID,Spieler[playerid][pName],"3 Warns");
	}
	return 1;
}

COMMAND:clearwarn(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128],warns,reason[31];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"uds[31]",pID,warns,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /clearwarn [playerid/Name][Anzahl][Grund]");
    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /clearwarn [playerid/Name][Anzahl][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if((Spieler[pID][pWarns] - warns) < 0)return SCM(playerid,SAMP_WEISS,"Falsche Angabe!");
	Spieler[pID][pWarns] -= warns;
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) %i Warn/s gereinigt. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,warns,reason);
	SendAdminMessage(SAMP_WEISS,string);
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat dir %i Warn/s gereinigt. Grund: %s",Spieler[playerid][pName],playerid,warns,reason);
	SCM(pID,SAMP_WEISS,string);
	return 1;
}
COMMAND:o(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(OChatAbf==1)return SCM(playerid,SAMP_WEISS,""IINFO" der OChat ist aus!");
	new string[1024],nachricht[350];
	if(Spieler[playerid][pMuted] == 1)
	{
	 	format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		return SCM(playerid,WEISS,string);
	}
	if(sscanf(params,"s[90]",nachricht))return SCM(playerid,SAMP_WEISS,""IINFO" /o (Message)");
	if(strlen(nachricht) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /o (Zu Lang!)");
	for(new b=0;b<sizeof(BadWord);b++)
	{
		if(strfind(nachricht,BadWord[b],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler %s für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /o-chat",BadWord[b],nachricht);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
	}
	new strpos = strfind(nachricht,"www",true);
	if(strfind(nachricht,".",true) != -1 && strfind(nachricht,":",true) != -1 && strlen(nachricht) > 8 && strfind(nachricht,TSIP,false) == -1)
	{
		strdel(nachricht,strpos,strfind(nachricht,".",true) && strfind(nachricht,":",true));
		return 1;
	}
	switch(Spieler[playerid][pAdmin])
	{
	    case -1:
	    {
  			format(string,sizeof(string),""#HTML_ORANGE"» "#HTML_WEISS"%s"#HTML_ORANGE": %s",Spieler[playerid][pName],nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
	    case 0:
		{
 			format(string,sizeof(string),""#HTML_GUN"» "#HTML_WEISS"%s"#HTML_WEISS": %s",Spieler[playerid][pName],nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
	    case 1:
	    {
	    	format(string,sizeof(string),""#HTML_GRUEN"» "#HTML_WEISS"%s"#HTML_WEISS"( "#HTML_GRUEN"%s"#HTML_WEISS" ): %s",Spieler[playerid][pName],Adminrang(playerid),nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
	    case 2:
	    {
	    	format(string,sizeof(string),""#HTML_GRUEN"» "#HTML_WEISS"%s"#HTML_WEISS"( "#HTML_GRUEN"%s"#HTML_WEISS" ): %s",Spieler[playerid][pName],Adminrang(playerid),nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
	    case 3:
	    {
	    	format(string,sizeof(string),""#HTML_GRUEN"» "#HTML_WEISS"%s"#HTML_WEISS"( "#HTML_GRUEN"%s"#HTML_WEISS" ): %s",Spieler[playerid][pName],Adminrang(playerid),nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
	    case 4:
	    {
	    	format(string,sizeof(string),""#HTML_SERVERAC"» "#HTML_WEISS"%s"#HTML_WEISS"( "#HTML_SERVERAC"%s"#HTML_WEISS" ): %s",Spieler[playerid][pName],Adminrang(playerid),nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
	    case 5:
	    {
	    	format(string,sizeof(string),""#HTML_DUNKELORANGE"» "#HTML_WEISS"%s"#HTML_WEISS"( "#HTML_DUNKELORANGE"%s"#HTML_WEISS" ): %s",Spieler[playerid][pName],Adminrang(playerid),nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
 		case 6:
	    {
	    	format(string,sizeof(string),""#HTML_DUNKELORANGE"» "#HTML_WEISS"%s"#HTML_WEISS"( "#HTML_DUNKELORANGE"%s"#HTML_WEISS" ): %s",Spieler[playerid][pName],Adminrang(playerid),nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
 		case 7:
	    {
	    	format(string,sizeof(string),""#HTML_DUNKELORANGE"» "#HTML_WEISS"%s"#HTML_WEISS"( "#HTML_DUNKELORANGE"%s"#HTML_WEISS" ): %s",Spieler[playerid][pName],Adminrang(playerid),nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
		case 8:
	    {
	    	format(string,sizeof(string),""#HTML_ROT"» "#HTML_WEISS"%s"#HTML_WEISS"( "#HTML_ROT"%s"#HTML_WEISS" ): %s",Spieler[playerid][pName],Adminrang(playerid),nachricht);
			SendClientMessageToAll(SAMP_WEISS,string);
		}
	}
	return 1;
}
COMMAND:sex(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],preis;
	if(!isPlayerInJob(playerid,13))return SCM(playerid,SAMP_WEISS,"Keine Prostituierte.");
	if(isell[playerid] > gettime())return SCM(playerid,SAMP_WEISS,""IINFO" du kannst erst nach 20 Sekunden wieder Sex haben.");
	if(sscanf(params,"ud",pID,preis))return SCM(playerid,SAMP_WEISS,""IINFO" /sex [playerid/Name][Preis]");
    if(preis<1||preis>500)return SCM(playerid,SAMP_WEISS,""IINFO" /sex [playerid/Name][Preis 1-500]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst es nicht mit dir selbst treiben.");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler ist nicht in deinem Fahrzeug.");
	if(Motor[GetPlayerVehicleID(playerid)] == true)return SCM(playerid,SAMP_WEISS,""IINFO" der Motor muss aus sein.");
	format(string,sizeof(string),""IINFO" du bietest %s für %i$ Geschlechtsverkehr an.",SpielerName(pID),preis);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s bietet dir Sex für %i$ an.(/accept sex)",SpielerName(playerid),preis);
	SCM(pID,SAMP_WEISS,string);
	Spieler[pID][pSeller] = playerid;
	Spieler[pID][pAngebot] = 3;
	Spieler[pID][pKaufPreis] = preis;
	Spieler[pID][pMenge] = 0;
	isell[playerid] = gettime() + (20);
	return 1;
}

COMMAND:dice(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128],preis;
	if(sscanf(params,"ud",pID,preis))return SCM(playerid,SAMP_WEISS,""IINFO" /dice [playerid/Name][Betrag]");
	if(preis<=0)return SCM(playerid,SAMP_WEISS,""IINFO" du musst schon einen Betrag angeben.");
	if(preis>10000)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nicht mehr als 10.000$ setzen!");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst mit dir selbst nicht um Geld Würfeln.");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if((GetACMoney(playerid) - preis) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld.");
	if((GetACMoney(pID) - preis) < 0)return SCM(playerid,SAMP_WEISS,"Spieler hat nicht genug Geld.");
	format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) eine Runde Würfeln um %i$ an.",SpielerName(pID),pID,preis);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s (ID:%i) bietet dir eine Runde Würfeln um %i$ an.(/accept dice)",SpielerName(playerid),playerid,preis);
	SCM(pID,SAMP_WEISS,string);
	Spieler[pID][pSeller] = playerid;
	Spieler[pID][pAngebot] = 17;
	Spieler[pID][pKaufPreis] = preis;
	Spieler[pID][pMenge] = 0;
	return 1;
}

COMMAND:wuerfeln(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID = Spieler[playerid][pSeller],string[128];
	if(Spieler[playerid][pAcceptDice] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du würfelst mit Niemandem um Geld.");
	if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(Spieler[playerid][pDiceTries][0] == 0)
	{
		if(playerid > pID)
		{
			if(Spieler[pID][pDiceTries][0] == 0)return SCM(playerid,SAMP_WEISS,"Warte erst auf deinen Würfel-Partner.");
		}
		Spieler[playerid][pDiceTries][0] = random(5) + 1;
		format(string,sizeof(string),""IINFO" du würfelst die Zahl %i.",Spieler[playerid][pDiceTries][0]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) würfelt die Zahl %i.",SpielerName(playerid),playerid,Spieler[playerid][pDiceTries][0]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s würfelt die Zahl %i **",SpielerName(playerid),Spieler[playerid][pDiceTries][0]);
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	if(Spieler[playerid][pDiceTries][1] == 0)
	{
	 	if(playerid > pID)
		{
			if(Spieler[pID][pDiceTries][1] == 0)return SCM(playerid,SAMP_WEISS,"Warte erst auf deinen Würfel-Partner.");
		}
		if(Spieler[pID][pDiceTries][0] == 0)return SCM(playerid,SAMP_WEISS,"Warte erst auf deinen Würfel-Partner.");
		Spieler[playerid][pDiceTries][1] = random(5) + 1;
		format(string,sizeof(string),""IINFO" du würfelst die Zahl %i.",Spieler[playerid][pDiceTries][1]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) würfelt die Zahl %i.",SpielerName(playerid),playerid,Spieler[playerid][pDiceTries][1]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s würfelt die Zahl %i **",SpielerName(playerid),Spieler[playerid][pDiceTries][1]);
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	if(Spieler[playerid][pDiceTries][2] == 0)
	{
		if(Spieler[pID][pDiceTries][1] == 0)return SCM(playerid,SAMP_WEISS,"Warte erst auf deinen Würfel-Partner.");
		Spieler[playerid][pDiceTries][2] = random(5) + 1;
		format(string,sizeof(string),""IINFO" du würfelst die Zahl %i.",Spieler[playerid][pDiceTries][2]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) würfelt die Zahl %i.",SpielerName(playerid),playerid,Spieler[playerid][pDiceTries][2]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s würfelt die Zahl %i **",SpielerName(playerid),Spieler[playerid][pDiceTries][2]);
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		if(Spieler[pID][pDiceTries][2] != 0 && Spieler[playerid][pDiceTries][2] != 0)
		{
		if(Spieler[pID][pKaufPreis] > GetACMoney(playerid))Spieler[pID][pKaufPreis] = GetACMoney(playerid);
		if(Spieler[pID][pKaufPreis] > GetACMoney(pID))Spieler[pID][pKaufPreis] = GetACMoney(pID);
		if(Spieler[pID][pKaufPreis] < 0)Spieler[pID][pKaufPreis] = 0;
		if((Spieler[playerid][pDiceTries][0]+Spieler[playerid][pDiceTries][1]+Spieler[playerid][pDiceTries][2]) > (Spieler[pID][pDiceTries][0]+Spieler[pID][pDiceTries][1]+Spieler[pID][pDiceTries][2]))
		{
			format(string,sizeof(string),""IINFO" du würfelst die Zahlen %i-%i-%i und gewinnt %i$.",Spieler[playerid][pDiceTries][0],Spieler[playerid][pDiceTries][1],Spieler[playerid][pDiceTries][2],Spieler[pID][pKaufPreis]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) würfelt die Zahlen %i-%i-%i und gewinnt %i$.",SpielerName(playerid),playerid,Spieler[playerid][pDiceTries][0],Spieler[playerid][pDiceTries][1],Spieler[playerid][pDiceTries][2],Spieler[pID][pKaufPreis]);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"** %s würfelt die Zahlen %i-%i-%i und gewinnt gegen %s %i$ **",SpielerName(playerid),Spieler[playerid][pDiceTries][0],Spieler[playerid][pDiceTries][1],Spieler[playerid][pDiceTries][2],SpielerName(pID),Spieler[pID][pKaufPreis]);
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			ACMoney(playerid,Spieler[pID][pKaufPreis]);
			ACMoney(pID,-Spieler[pID][pKaufPreis]);
			PlayerPlaySound(pID,31202,0.0,0.0,0.0);
		}
		if((Spieler[playerid][pDiceTries][0]+Spieler[playerid][pDiceTries][1]+Spieler[playerid][pDiceTries][2]) < (Spieler[pID][pDiceTries][0]+Spieler[pID][pDiceTries][1]+Spieler[pID][pDiceTries][2]))
		{
			format(string,sizeof(string),""IINFO" du würfelst die Zahlen %i-%i-%i und gewinnt %i$.",Spieler[pID][pDiceTries][0],Spieler[pID][pDiceTries][1],Spieler[pID][pDiceTries][2],Spieler[pID][pKaufPreis]);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) würfelt die Zahlen %i-%i-%i und gewinnt %i$.",SpielerName(pID),pID,Spieler[pID][pDiceTries][0],Spieler[pID][pDiceTries][1],Spieler[pID][pDiceTries][2],Spieler[pID][pKaufPreis]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"** %s würfelt die Zahlen %i-%i-%i und gewinnt gegen %s %i$ **",SpielerName(pID),Spieler[pID][pDiceTries][0],Spieler[pID][pDiceTries][1],Spieler[pID][pDiceTries][2],SpielerName(playerid),Spieler[pID][pKaufPreis]);
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			ACMoney(playerid,-Spieler[pID][pKaufPreis]);
			ACMoney(pID,Spieler[pID][pKaufPreis]);
			PlayerPlaySound(playerid,31202,0.0,0.0,0.0);
		}
		if((Spieler[playerid][pDiceTries][0]+Spieler[playerid][pDiceTries][1]+Spieler[playerid][pDiceTries][2]) == (Spieler[pID][pDiceTries][0]+Spieler[pID][pDiceTries][1]+Spieler[pID][pDiceTries][2]))
		{
		    format(string,sizeof(string),""IINFO" du spielst gegen %s (ID:%i) mit den Zahlen %i-%i-%i unentschieden.",SpielerName(pID),pID,Spieler[playerid][pDiceTries][0],Spieler[playerid][pDiceTries][1],Spieler[playerid][pDiceTries][2]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du spielst gegen %s (ID:%i) mit den Zahlen %i-%i-%i unentschieden.",SpielerName(playerid),playerid,Spieler[pID][pDiceTries][0],Spieler[pID][pDiceTries][1],Spieler[pID][pDiceTries][2]);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"** %s spielt gegen %s **",SpielerName(playerid),SpielerName(pID));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		}
		Spieler[playerid][pAcceptDice] = 0;
		Spieler[playerid][pDiceTries][0] = 0; Spieler[playerid][pDiceTries][1] = 0; Spieler[playerid][pDiceTries][2] = 0;
		Spieler[pID][pAcceptDice] = 0;
		Spieler[pID][pDiceTries][0] = 0; Spieler[pID][pDiceTries][1] = 0; Spieler[pID][pDiceTries][2] = 0;
	    Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		Spieler[pID][pSeller] = -1;
		Spieler[pID][pAngebot] = 0;
		Spieler[pID][pKaufPreis] = 0;
		Spieler[pID][pMenge] = 0;
 		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,"Warte erst auf deinen Würfel-Partner.");
}

COMMAND:applyforhousekey(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new haus,string[128];
    if(!isPlayerInJob(playerid,18))return SCM(playerid,SAMP_WEISS,"Kein Immobilienmakler.");
    if(!IsPlayerInRangeOfPoint(playerid,2.0,354.9005,154.6433,1025.7964))return SCM(playerid,SAMP_WEISS,"Nicht in der Stadthalle!");
    if(sscanf(params,"i",haus))return SCM(playerid,SAMP_WEISS,""IINFO" /applyforhousekey [Hausnummer]");
    if(haus >= MAX_HAUS)return SCM(playerid,SAMP_WEISS,"Haus existiert nicht!");
	if(HausInfo[haus][hauscreatet] != 1)return SCM(playerid,SAMP_WEISS,"Haus existiert nicht!");
	if(HausInfo[haus][haus_Owned] == 1)return SCM(playerid,SAMP_WEISS,"Haus wurde bereits verkauft!");
	if(ImmobilienKeyID[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits einen aktiven Hausschlüssel!");
	ImmobilienKeyID[playerid] = haus;
	ImmobilienKeyTime[playerid] = gettime() + (60*20);
	format(string,sizeof(string),""IINFO" du hast einen Hausschlüssel für die Hausnummer %i bekommen",ImmobilienKeyID[playerid]);
	SCM(playerid,SAMP_WEISS,string);
	SCM(playerid,SAMP_WEISS,""IINFO" du kannst diesen Schlüssel nur 20 Minuten benutzen,nach der Zeit ist dieser deaktiviert!");
	ImmobilienTimer[playerid] = SetTimerEx("HauslockbyMakler",20*60000,false,"ii",playerid,haus);
	return 1;
}

COMMAND:maklerlock(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new haus = ImmobilienKeyID[playerid],string[128];
	if(!isPlayerInJob(playerid,18))return SCM(playerid,SAMP_WEISS,"Kein Immobilienmakler.");
	if(gettime() < ImmobilienKeyTime[playerid])
	{
		if(IsPlayerInRangeOfPoint(playerid,5,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]) || (HausInfo[haus][haus_innenraum] != 255 && IsPlayerInRangeOfPoint(playerid,5,Homestore[HausInfo[haus][haus_innenraum]][Hx],Homestore[HausInfo[haus][haus_innenraum]][Hy],Homestore[HausInfo[haus][haus_innenraum]][Hz]) && GetPlayerVirtualWorld(playerid) == haus))
		{
			if(HausInfo[haus][haus_Owned] == 1)return GameTextForPlayer(playerid,"~r~Haus bereits im Besitz von einem Spieler!",2000,1);
			if(HausInfo[haus][haus_locked] == 0)
			{
				new keyrunningtime = ImmobilienKeyTime[playerid]-gettime();
				HausInfo[haus][haus_locked] = 1;
				format(string,sizeof(string),""IINFO" du hast das in der Stadthalle beantragte Haus(Hausnummer %i) abgeschlossen!",haus);
				SCM(playerid,SAMP_WEISS,string);
				format(string,sizeof(string),"Zeit bis der Schlüssel abgelaufen ist %i Minuten.",floatround(keyrunningtime/60));
			    SCM(playerid,SAMP_WEISS,string);
				return 1;
			}
			else if(HausInfo[haus][haus_locked] == 1)
			{
				new keyrunningtime = ImmobilienKeyTime[playerid]-gettime();
				HausInfo[haus][haus_locked] = 0;
				format(string,sizeof(string),""IINFO" du hast das in der Stadthalle beantragte Haus(Hausnummer %i) aufgeschlossen!",haus);
				SCM(playerid,SAMP_WEISS,string);
				format(string,sizeof(string),"Zeit bis der Schlüssel abgelaufen ist %i Minuten.",floatround(keyrunningtime/60));
			    SCM(playerid,SAMP_WEISS,string);
				return 1;
			}
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am in der Stadthalle beantragtem Haus!");
	}
	return SCM(playerid,SAMP_WEISS,"Schlüssel nicht Aktiv!");
}
COMMAND:immobilie(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],cmd[25],hausorbizid,besitzerid,kundenid,preis;
	if(!isPlayerInJob(playerid,18))return SCM(playerid,SAMP_WEISS,"Kein Immobilienmakler.");
	if(sscanf(params,"s[25]iuui",cmd,hausorbizid,besitzerid,kundenid,preis))return SCM(playerid,SAMP_WEISS,""IINFO" /immobilie [Haus/Business][Hausnummer/Bizid][Besitzerid/Name][Käuferid/Name][Preis]");
	if(preis <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Preis darf nicht unter 0$% sein!");
	if(strcmp(cmd,"Haus",true) == 0 && (hausorbizid < 1 || hausorbizid >= MAX_HAUS))return SCM(playerid,SAMP_WEISS,""IINFO" ungueltige Hausnummer.");
	if(strcmp(cmd,"Business",true) == 0 && (hausorbizid < 1 || hausorbizid >= MAX_BIZ))return SCM(playerid,SAMP_WEISS,""IINFO" ungueltige Bizid.");
	if(!IsPlayerConnected(besitzerid))return SCM(playerid,SAMP_WEISS,"Besitzer nicht eingeloggt!");
	if(!IsPlayerConnected(kundenid))return SCM(playerid,SAMP_WEISS,"Besitzer nicht eingeloggt!");
	if(playerid == besitzerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst als Besitzer angeben!");
	if(playerid == kundenid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich selber nicht als Kunde angeben!");
	if(besitzerid == kundenid)return SCM(playerid,SAMP_WEISS,""IINFO" der Besitzer kan nicht der Kunde sein!");
	if(kundenid == besitzerid)return SCM(playerid,SAMP_WEISS,""IINFO" der Kunde kan nicht der Besitzer sein!");
	if(!ProxDetectorS(5.0,playerid,besitzerid))return SCM(playerid,SAMP_WEISS,"Besitzer nicht in deiner Nähe.");
    if(!ProxDetectorS(5.0,playerid,kundenid))return SCM(playerid,SAMP_WEISS,"Besitzer nicht in deiner Nähe.");
    ReturnPropertyData(besitzerid);
	new count = Spieler[besitzerid][pReturnPropertyDataHaus],biz = GetBusinessOwner(besitzerid,Spieler[besitzerid][pName]);
	ReturnPropertyData(kundenid);
	new count2 = Spieler[kundenid][pReturnPropertyDataHausCount],biz2 = IsPlayerAnyBusinessOwner(Spieler[kundenid][pName]);
    if(strcmp(cmd,"Haus",true) == 0)
   	{
	   	if(count == 0)return SCM(playerid,SAMP_WEISS,"Angegebener Besitzer ist nicht im Besitz eines Hauses./Ihr seid nicht in der nähe des Hauses des Besitzer.");
	   	if(count2 >= MAX_HAUS_OWNER)return SCM(playerid,SAMP_WEISS,"Angegebener Käufer besitzt bereits "#MAX_HAUS_OWNER" Haus!");
	   	if(!IsPlayerInRangeOfPoint(playerid,5,HausInfo[hausorbizid][haus_x],HausInfo[hausorbizid][haus_y],HausInfo[hausorbizid][haus_z]))return SCM(playerid,SAMP_WEISS,""IINFO" du musst schon am Haus sein!");
	    if(GetPlayerLevel(kundenid) < HausInfo[hausorbizid][haus_level])return SCM(playerid,SAMP_WEISS,"Angegebener Käufer besitzt nicht das ausreichende Level zum Kauf des Hauses.");
		format(string,sizeof(string),"%s (ID:%i) bietet dir das Haus [Hausnummer %i] von %s (ID:%i) für %i$ zum kauf an!",SpielerName(playerid),playerid,hausorbizid,SpielerName(besitzerid),besitzerid,preis);
	   	SCM(kundenid,SAMP_WEISS,string);
	   	SCM(kundenid,SAMP_WEISS,"Warte auf Antwort des Besitzers!");
	   	SCM(kundenid,SAMP_WEISS,"Um die Kaufauktion zu beenden Tippe '/cancel immobilie'");
	   	format(string,sizeof(string),"%s (ID:%i) bietet %s (ID:%i) dein Haus [Hausnummer %i] für %i$ zum kauf an!",SpielerName(playerid),playerid,SpielerName(kundenid),kundenid,hausorbizid,preis);
	   	SCM(besitzerid,SAMP_WEISS,string);
	   	SCM(besitzerid,SAMP_WEISS,"Nutze '/accept immobilie' um den Verkauf deines Hauses zu bestätigen!");
	   	SCM(besitzerid,SAMP_WEISS,"Um die Kaufauktion zu beenden Tippe '/cancel immobilie'");
	   	format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) das Haus [Hausnummer %i] von %s (ID:%i) für %i$ zum kauf an!",SpielerName(kundenid),kundenid,hausorbizid,SpielerName(besitzerid),besitzerid,preis);
	   	SCM(playerid,SAMP_WEISS,string);
	   	SCM(playerid,SAMP_WEISS,"Warte auf Annahmen!");
	   	Immobilienseller[playerid] = playerid;
	   	Immobilienbesitzer[playerid] = besitzerid;
		Immobilienkunde[playerid] = kundenid;
	   	Immobilienart[besitzerid] = 1;
	   	Immobiliensell[besitzerid] = 1;
	   	Immobilienseller[besitzerid] = playerid;
	   	Immobilienbesitzer[besitzerid] = besitzerid;
		Immobilienkunde[besitzerid] = kundenid;
		Immobilienpreis[besitzerid] = preis;
		Immobilienid[besitzerid] = hausorbizid;
		Immobilienart[kundenid] = 1;
	   	Immobiliensell[kundenid] = 1;
	   	Immobilienseller[kundenid] = playerid;
		Immobilienbesitzer[kundenid] = besitzerid;
		Immobilienkunde[kundenid] = kundenid;
		Immobilienpreis[kundenid] = preis;
		Immobilienid[kundenid] = hausorbizid;
	   	return 1;
   	}
   	if(strcmp(cmd,"Business",true) == 0)
   	{
	   	if(biz == -1)return SCM(playerid,SAMP_WEISS,"Angegebener Besitzer besitzt kein Business./Ihr seid nicht am Business des Besitzers.");
		if(Spieler[kundenid][GeworbenPlaya] > gettime())
		{
		if(biz2 >= MAX_BUSINESS_OWNER)return SCM(playerid,SAMP_WEISS,"Angegebener Kunde besitzt bereits "#MAX_BUSINESS_OWNER" Businesse.");
		}
		else
		{
		if(biz2 >= MAX_BUSINESS_OWNER/2)
		{
		format(string,sizeof(string),"Angegebener Kunde besitzt bereits %i Businesse.",MAX_BUSINESS_OWNER/2);
		return SCM(playerid,SAMP_WEISS,string);
		}
		}
		if(!IsPlayerInRangeOfPoint(playerid,5,BizInfo[hausorbizid][biz_x],BizInfo[hausorbizid][biz_y],BizInfo[hausorbizid][biz_z]))return SCM(playerid,SAMP_WEISS,""IINFO" du musst schon am Business sein!");
		if(GetPlayerLevel(kundenid) < BizInfo[hausorbizid][biz_level])return SCM(playerid,SAMP_WEISS,"Angegebener Käufer besitzt nicht das ausreichende Level zum Kauf des Businesses.");
		format(string,sizeof(string),"%s (ID:%i) bietet dir das Business (%s) [Bizid %i] von %s (ID:%i) für %i$ zum kauf an!",SpielerName(playerid),playerid,BizName(hausorbizid),hausorbizid,SpielerName(besitzerid),besitzerid,preis);
	   	SCM(kundenid,SAMP_WEISS,string);
	   	SCM(kundenid,SAMP_WEISS,"Warte auf Antwort des Besitzers!");
	   	SCM(kundenid,SAMP_WEISS,"Um die Kaufauktion zu beenden Tippe '/cancel immobilie'");
	   	format(string,sizeof(string),"%s (ID:%i) bietet %s (ID:%i) dein Business (%s) [Bizid %i] für %i$ zum kauf an!",SpielerName(playerid),playerid,SpielerName(kundenid),kundenid,BizName(hausorbizid),hausorbizid,preis);
	   	SCM(besitzerid,SAMP_WEISS,string);
	   	SCM(besitzerid,SAMP_WEISS,"Nutze '/accept immobilie' um den Verkauf deines Business zu bestätigen!");
	   	SCM(besitzerid,SAMP_WEISS,"Um die Kaufauktion zu beenden Tippe '/cancel immobilie'");
	   	format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) das Business (%s) [Bizid %i] von %s (ID:%i) für %i$ zum kauf an!",SpielerName(kundenid),kundenid,BizName(hausorbizid),hausorbizid,SpielerName(besitzerid),besitzerid,preis);
	   	SCM(playerid,SAMP_WEISS,string);
	   	SCM(playerid,SAMP_WEISS,"Warte auf Annahmen!");
	   	Immobilienseller[playerid] = playerid;
	   	Immobilienbesitzer[playerid] = besitzerid;
		Immobilienkunde[playerid] = kundenid;
	   	Immobilienart[besitzerid] = 2;
	   	Immobiliensell[besitzerid] = 1;
	   	Immobilienseller[besitzerid] = playerid;
	   	Immobilienbesitzer[besitzerid] = besitzerid;
		Immobilienkunde[besitzerid] = kundenid;
		Immobilienid[besitzerid] = hausorbizid;
		Immobilienart[kundenid] = 2;
	   	Immobiliensell[kundenid] = 1;
	   	Immobilienseller[kundenid] = playerid;
		Immobilienbesitzer[kundenid] = besitzerid;
		Immobilienkunde[kundenid] = kundenid;
		Immobilienpreis[kundenid] = preis;
		Immobilienid[kundenid] = hausorbizid;
	   	return 1;
   	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /immobilie [Haus/Business][Hausnummer/Bizid][Besitzerid/Name][Käuferid/Name][Preis]");
}

COMMAND:searchtrailer(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid),Float:Pos[3],string[128];
	if(!isPlayerInJob(playerid,10))return SCM(playerid,SAMP_WEISS,"Kein Trucker.");
	if(!IsVehicleATruck(vehicleid))return SCM(playerid,SAMP_WEISS,"In keinem Truck!");
    new trailer = GetVehicleTrailer(vehicleid);
	if(trailer == truckertrailer[playerid])return SCM(playerid,SAMP_WEISS,""IINFO" du hast deinen Anhänger bereits an der Kuplung.");
	GetVehiclePos(playerid,Pos[0],Pos[1],Pos[2]);
	SetPlayerCheckpoint(playerid,Pos[0],Pos[1],Pos[2],1.0);
	Spieler[playerid][pIsearch] = 1;
	format(string,sizeof(string),"Dein Anhänger (ID:%i) wurde auf der Karte markiert.",trailer);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}

COMMAND:ladung(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid);
    if(!isPlayerInJob(playerid,10))return SCM(playerid,SAMP_WEISS,"Kein Trucker.");
	if(!IsVehicleATruck(vehicleid))return SCM(playerid,SAMP_WEISS,"In keinem Truck!");
	if(!IsTrailerAttachedToVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Kein Anhänger angehängt.");
	if(truckLoad[playerid] == 1)return SCM(playerid,SAMP_WEISS,"Dein Trucker ist bereits beladen!");
	new trailer = GetVehicleTrailer(vehicleid);
	if(trailer != truckertrailer[playerid])return SCM(playerid,SAMP_WEISS,"Dieser Anhänger gehört nicht dir.(/searchtrailer)");
	if(IsPlayerInRangeOfPoint(playerid,10.0,2743.2227,-2466.0203,13.6484) && truckerjobgo[playerid] != 0)
	{
		if(truckerjobgo[playerid] != 2)return SCM(playerid,SAMP_WEISS,""IINFO" du musst erst den Anhänger holen.");
		SCM(playerid,SAMP_WEISS,"Warte eine Minute! Die Ware wird aufgeladen!");
		TogglePlayerControllable(playerid,false);
		SetTimerEx("TruckerTimer",60000,false,"ii",playerid,1);
		truckLoad[playerid] = 1;
		return 1;
	}
	if(IsPlayerInRangeOfPoint(playerid,10.0,-1934.7509,234.5528,33.9363) && truckerjobgo2[playerid] != 0)
	{
		if(truckerjobgo2[playerid] != 2)return SCM(playerid,SAMP_WEISS,""IINFO" du musst erst den Anhänger holen.");
	    SCM(playerid,SAMP_WEISS,"Warte eine Minute. Die Autoteile werden aufgeladen!");
		TogglePlayerControllable(playerid,false);
		SetTimerEx("TruckerTimer",60000,false,"ii",playerid,2);
		truckLoad[playerid] = 1;
		return 1;
	}
	if(IsPlayerInRangeOfPoint(playerid,10.0,585.6163,888.6312,-44.4801) && truckerjobgo3[playerid] != 0)
	{
		if(truckerjobgo3[playerid] != 2)return SCM(playerid,SAMP_WEISS,""IINFO" du musst erst den Anhänger holen.");
	    SCM(playerid,SAMP_WEISS,"Warte eine Minute. Der Bauschutt wird aufgeladen!");
		TogglePlayerControllable(playerid,false);
		SetTimerEx("TruckerTimer",60000,false,"ii",playerid,3);
		truckLoad[playerid] = 1;
		return 1;
	}
	if(IsPlayerInRangeOfPoint(playerid,10.0,2485.8442,-2084.1484,13.5469) && truckerjobgo4[playerid] != 0)
	{
		if(truckerjobgo4[playerid] != 2)return SCM(playerid,SAMP_WEISS,""IINFO" du musst erst den Anhänger holen.");
	    SCM(playerid,SAMP_WEISS,"Warte eine Minute. Bis der Treibstoff in den Tank des Anhängers gefüllt wird!");
		TogglePlayerControllable(playerid,false);
		SetTimerEx("TruckerTimer",60000,false,"ii",playerid,4);
		truckLoad[playerid] = 1;
		return 1;
	}
	if(IsPlayerInRangeOfPoint(playerid,10.0,597.2369,868.0743,-43.4611) && truckerjobgo5[playerid] != 0)
	{
		if(truckerjobgo5[playerid] != 2)return SCM(playerid,SAMP_WEISS,""IINFO" du musst erst den Anhänger holen.");
		//if((VehicleLoadTank[GetPlayerVehicleID(playerid)]+fsteuern[EisenLagger1]) > 60000)return SCM(playerid,SAMP_WEISS,""IINFO" der Anhänger ist bereits randgefüllt.");
		SCM(playerid,SAMP_WEISS,"Warte eine Minute. Bis das Eisen aufgeladen wird!");
		TogglePlayerControllable(playerid,false);
		SetTimerEx("TruckerTimer",60000,false,"ii",playerid,5);
		truckLoad[playerid] = 1;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Ladung aufladen!");
}

COMMAND:sellice(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],preis;
    if(!isPlayerInJob(playerid,7))return SCM(playerid,SAMP_WEISS,"Kein Eisverkäufer.");
	if(!IsVehicleAIceCar(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"In keinem Eiswagen.");
    if(isell[playerid] > gettime())return SCM(playerid,SAMP_WEISS,""IINFO" du kannst erst nach 10 Sekunden etwas verkaufen.");
	if(sscanf(params,"ud",pID,preis))return SCM(playerid,SAMP_WEISS,""IINFO" /sellice [playerid/Name][preis]");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst kein Eis verkaufen!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(preis<0||preis>50)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur einen Preis von 0-50$ wählen.");
	format(string,sizeof(string),"%s will dir Eis für %i$ anbieten.(/accept ice).",SpielerName(playerid),preis);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" du bietest %s ein Eis für %i$ an! Warte auf Antwort.",SpielerName(pID),preis);
	SCM(playerid,SAMP_WEISS,string);
	Spieler[pID][pSeller] = playerid;
	Spieler[pID][pAngebot] = 2;
	Spieler[pID][pKaufPreis] = preis;
	Spieler[pID][pMenge] = 0;
	isell[playerid] = gettime() + (10);
	return 1;
}

COMMAND:sellnacho(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],preis;
    if(!isPlayerInFrakt(playerid,17))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!IsVehicleANachoCar(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"In keinem Nachofahrzeug.");
    if(isell[playerid] > gettime())return SCM(playerid,SAMP_WEISS,""IINFO" du kannst erst nach 10 Sekunden etwas verkaufen.");
	if(sscanf(params,"ud",pID,preis))return SCM(playerid,SAMP_WEISS,""IINFO" /sellnacho [playerid/Name][preis]");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst keine Nachos verkaufen!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(preis<0||preis>50)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur einen Preis von 0-50$ wählen.");
	format(string,sizeof(string),"%s will dir einen Nacho für %i$ anbieten.(/accept nacho).",SpielerName(playerid),preis);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" du bietest %s ein Nacho für %i$ an! Warte auf Antwort.",SpielerName(pID),preis);
	SCM(playerid,SAMP_WEISS,string);
	Spieler[pID][pSeller] = playerid;
	Spieler[pID][pAngebot] = 22;
	Spieler[pID][pKaufPreis] = preis;
	Spieler[pID][pMenge] = 0;
	isell[playerid] = gettime() + (10);
	return 1;
}

COMMAND:vertrag(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new text[115],pID,string[128];
    if(sscanf(params,"us[115]",pID,text))return SCM(playerid,SAMP_WEISS,""IINFO" /vertrag [playerid/Name][Inhalt]");
    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst keinen Verträge mit dir selbst abschließen!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	format(string,sizeof(string),"%s hat dir einen Vertrag angeboten.",SpielerName(playerid));
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),"Inhalt: %s",text);
	SCM(pID,SAMP_WEISS,string);
	SCM(pID,SAMP_WEISS,"Nutze '/accept vertrag' um den Vertrag anzunehmen!");
	SCM(pID,SAMP_WEISS,"Bitte eine Screen zum Beweis machen!");
	SCM(pID,SAMP_WEISS,"Um den Vertrag abzulehnen Tippe '/cancel vertrag'");
	format(string,sizeof(string),""IINFO" du bietest %s eine Vertrag an.",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"Inhalt: %s",text);
	SCM(playerid,SAMP_WEISS,string);
	SCM(playerid,SAMP_WEISS,"Warte auf annahme!");
	SCM(playerid,SAMP_WEISS,"Bitte eine Screen zum Beweis machen!");
	Spieler[pID][pSeller] = playerid;
	Spieler[pID][pAngebot] = 13;
	return 1;
}
COMMAND:cv_3(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid),cmd[25],string[128],Float:x,Float:y,Float:z;
    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(sscanf(params,"s[25]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /cv [Motor/Licht/Motorhaube/Kofferraum/Radio/Handbremse/Info]");
	if(strcmp(cmd,"Motor",true) == 0)
   	{
	   	if(Spieler[playerid][pHealTime] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst während des Geschlechtsverkehr den Motor des Fahrzeuges nicht starten.");
	   	if(RepairAVehicle[vehicleid] == 1)return SCM(playerid,SAMP_WEISS,"Dein Fahrzeug wird gerade repariert!");
		if(RefillVehicle[vehicleid] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du tankst gerade!");
		if(vFahrzeug[vehicleid][Handbremse] == 1)return SCM(playerid,SAMP_WEISS,"Bitte löse zu erst die Handbremse!");
		if(GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 510)return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug hat keinen Motor.");
		else if(MotorDown[vehicleid] != 0)return SCM(playerid,WEISS,""IINFO" das Fahrzeug ist kaputt. Rufe einen Abschlepper oder einen Kraftfahrzeugmechaniker.");
		else if(vFahrzeug[vehicleid][Tank] <= 0.0)return SCM(playerid,SAMP_WEISS,"Tank leer.");
		else if(Motor[vehicleid] == false)
		{
		    if(vFahrzeug[vehicleid][Carbomb] != 1)
		    {
			Motor[vehicleid] = true;
			KillTimer(vFahrzeug[vehicleid][VehicleEngineTimer]);
			vFahrzeug[vehicleid][VehicleEngineTimer] = SetTimerEx("VehicleEngine",VehicleInfo[GetVehicleModel(vehicleid)-400][vEngineStartInSek]*1000,false,"ii",playerid,vehicleid);
			GameTextForPlayer(playerid,"~w~Motor~g~ wird gestartet",VehicleInfo[GetVehicleModel(vehicleid)-400][vEngineStartInSek]*1000,6);
			}
			else
			{
			RemovePlayerFromVehicle(playerid);
			SetPlayerHealth(playerid, 0);
			vFahrzeug[vehicleid][Carbomb] = 0;
            new randompos = random(20),randexploderadius = random(40)+10;
            new Float:vehx, Float:vehy, Float:vehz;
            GetVehiclePos(vehicleid,vehx,vehy,vehz);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),true);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i) && !IsPlayerNPC(i))
				{
					if(isPlayerInFrakt(i,8))
					{
						format(string,sizeof(string),"Detonation: Eine in einem/r %s verbaute Autobombe ist detoniert.",VehicleDefinations[GetVehicleModel(vehicleid)-400]);
						SCM(i,SAMP_WEISS,string);
					}
				}
			}
			return 1;
			}
		}
		else if(Motor[vehicleid] == true)
		{
		    if(vFahrzeug[vehicleid][Carbomb] != 1)
		    {
			KillTimer(vFahrzeug[vehicleid][VehicleEngineTimer]);
			GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
			SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
			Motor[vehicleid] = false;
			GameTextForPlayer(playerid,"~w~Motor ~r~ausgeschaltet",2000,6);
			}
			else
			{
			RemovePlayerFromVehicle(playerid);
			SetPlayerHealth(playerid, 0);
			vFahrzeug[vehicleid][Carbomb] = 0;
            new randompos = random(20),randexploderadius = random(40)+10;
            new Float:vehx, Float:vehy, Float:vehz;
            GetVehiclePos(vehicleid,vehx,vehy,vehz);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),true);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(vehx+randompos,vehy+randompos,vehz+randompos,7,randexploderadius);
			AddFire(vehx+randompos,vehy+randompos,vehz+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i) && !IsPlayerNPC(i))
				{
					if(isPlayerInFrakt(i,8))
					{
						format(string,sizeof(string),"Detonation: Eine in einem/r %s verbaute Autobombe ist detoniert.",VehicleDefinations[GetVehicleModel(vehicleid)-400]);
						SCM(i,SAMP_WEISS,string);
					}
				}
			}
			return 1;
			}
		}
	   	return 1;
   	}
   	if(strcmp(cmd,"Licht",true) == 0)
   	{
		if(GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 510 || IsVehAFlugzeug(vehicleid) || IsVehAHelicopter(vehicleid) || IsVehABoot(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug hat keine Scheinwerfer.");
		GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
		if(lightson[vehicleid] == false)
		{
			GameTextForPlayer(playerid,"~w~Licht~g~ angeschaltet",2000,6);
		    SetVehicleParamsEx(vehicleid,engine,VEHICLE_PARAMS_ON,alarm,doors,bonnet,boot,objective);
		    lightson[vehicleid] = true;
		}
		else if(lightson[vehicleid] == true)
		{
			GameTextForPlayer(playerid,"~w~Licht ~r~ausgeschaltet",2000,6);
		    SetVehicleParamsEx(vehicleid,engine,VEHICLE_PARAMS_OFF,alarm,doors,bonnet,boot,objective);
		    lightson[vehicleid] = false;
		}
	   	return 1;
   	}
   	if(strcmp(cmd,"Motorhaube",true) == 0)
   	{
		if(GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 510)return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug hat keine Motorhaube.");
		GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
		if(motorhaube[vehicleid] == false)
		{
			GameTextForPlayer(playerid,"~w~Motorhaube~g~ offen",2000,6);
		    SetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,VEHICLE_PARAMS_ON,boot,objective);
		    motorhaube[vehicleid] = true;
		}
		else if(motorhaube[vehicleid] == true)
		{
			GameTextForPlayer(playerid,"~w~Motorhaube~g~ zu",2000,6);
		    SetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,VEHICLE_PARAMS_OFF,boot,objective);
		    motorhaube[vehicleid] = false;
		}
	   	return 1;
   	}
   	if(strcmp(cmd,"Kofferraum",true) == 0)
   	{
	   	if(IsPlayerInAnyVehicle(playerid))
	   	{
		   	if(GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 510 || IsVehABike(vehicleid) || IsVehABoot(vehicleid) || IsVehAFlugzeug(vehicleid) || IsVehAHelicopter(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug hat keinen Kofferraum.");
			GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
			if(kofferraum[vehicleid] == false)
			{
				GameTextForPlayer(playerid,"~w~Kofferraum~g~ offen",2000,6);
			    SetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,VEHICLE_PARAMS_ON,objective);
			    kofferraum[vehicleid] = true;
			    return 1;
			}
			else if(kofferraum[vehicleid] == true)
			{
				GameTextForPlayer(playerid,"~w~Kofferraum~g~ zu",2000,6);
			    SetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,VEHICLE_PARAMS_OFF,objective);
			    kofferraum[vehicleid] = false;
			    return 1;
			}
		}
		for(new i=0;i<MAX_VEHICLES;i++)
		{
			if(IsValidVehicle(i))
			{
				if(GetVehicleModel(i) != 509 || GetVehicleModel(i) != 481 || GetVehicleModel(i) != 510 || !IsVehABike(i) || !IsVehABoot(i) || !IsVehAFlugzeug(i) || !IsVehAHelicopter(i))
				{
					if(IsPlayerInRangeOfPoint(playerid,3.0,x,y,z))
					{
						GetVehiclePos(i,x,y,z);
						GetVehicleParamsEx(i,engine,lights,alarm,doors,bonnet,boot,objective);
						if(kofferraum[i] == false)
						{
							GameTextForPlayer(playerid,"~w~Kofferraum~g~ offen",2000,6);
						    SetVehicleParamsEx(i,engine,lights,alarm,doors,bonnet,VEHICLE_PARAMS_ON,objective);
						    kofferraum[i] = true;
						    return 1;
						}
						else if(kofferraum[i] == true)
						{
							GameTextForPlayer(playerid,"~w~Kofferraum~g~ zu",2000,6);
						    SetVehicleParamsEx(i,engine,lights,alarm,doors,bonnet,VEHICLE_PARAMS_OFF,objective);
						    kofferraum[i] = false;
						    return 1;
						}
					}
				}
			}
		}
		return 1;
   	}
   	if(strcmp(cmd,"Radio",true) == 0)
   	{
	   	if(GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 510)return SCM(playerid,SAMP_WEISS,"Fahrzeug hat keinen Radio.");
	    new mainstring[1000];
	    for(new i=0;i<sizeof(Radio);i++)
	    {
		    format(string,sizeof(string),"%s\n",Radio[i][urlname]);
		    strcat(mainstring,string);
	    }
	    strcat(mainstring,"Radio Aus");
		return ShowPlayerDialog(playerid,DIALOG_vehMUSIK,DIALOG_STYLE_LIST,VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(playerid))-400],mainstring,"Auswählen","Abbrechen");
   	}
   	if(strcmp(cmd,"Handbremse",true) == 0)
   	{
	   	if(GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 510 || IsVehAFlugzeug(vehicleid) || IsVehAHelicopter(vehicleid) || IsVehABoot(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug besitzt keine Handbremse.");
		if(vFahrzeug[vehicleid][Handbremse] == 0)
	    {
	        if(Motor[vehicleid] == true)return SCM(playerid,SAMP_WEISS,""IINFO" der Motor muss aus sein, bevor du die Handbremse ziehen kannst.");
		    vFahrzeug[vehicleid][Handbremse] = 1;
		    GameTextForPlayer(playerid,"~w~Handbremse~g~ angezogen",2000,6);
	    }
	    else if(vFahrzeug[vehicleid][Handbremse] == 1)
	    {
	        if(Motor[vehicleid] == true)return SCM(playerid,SAMP_WEISS,""IINFO" der Motor muss aus sein, bevor du die Handbremse lösen kannst.");
		    vFahrzeug[vehicleid][Handbremse] = 0;
		    GameTextForPlayer(playerid,"~w~Handbremse ~r~geloest",2000,6);
	    }
	    return 1;
   	}
   	if(strcmp(cmd,"Info",true) == 0)
   	{
	   	if(GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 510)return SCM(playerid,SAMP_WEISS,"Fahrzeug hat keinen Radio.");
		new kraftstoff[25],kmgoeson = floatround(vFahrzeug[vehicleid][Tank]/VehicleInfo[GetVehicleModel(vehicleid)-400][vtankverbrauch]);
		switch(VehicleInfo[GetVehicleModel(vehicleid)-400][vtankklasse])
		{
			case 1:{kraftstoff="Benzin";}
			case 2:{kraftstoff="Diesel";}
			case 3:{kraftstoff="Turbobenzin";}
			case 4:{kraftstoff="Kerosin";}
			default:{kraftstoff="ERROR";}
		}
		format(string,sizeof(string),"Fahrzeug: %s | Tank: %.2fL/%.2fL | Tankverbrauch: %.2fL/Km | Treibstoff: %s | Verbleibende Km: %iKm",VehicleDefinations[GetVehicleModel(vehicleid)-400],vFahrzeug[vehicleid][Tank],VehicleInfo[GetVehicleModel(vehicleid)-400][vtankvolumen],VehicleInfo[GetVehicleModel(vehicleid)-400][vtankverbrauch],kraftstoff,kmgoeson);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
   	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /cv [Motor/Licht/Motorhaube/Kofferraum/Radio/Handbremse/Info]");
}
COMMAND:cancel(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new pID,cmd[30],string[128];
    if(sscanf(params,"s[30]",cmd))
	{
		SCM(playerid,SAMP_WEISS,""IINFO" /cancel [Frisk/Ticket/Interview/Fahrstunde/SAPD/Medic/Feuer/Race/Freebl/Sinlist/Befreiung]");
		return SCM(playerid,SAMP_WEISS,"[Abschleppen/Taxi/Mechaniker/Elektriker/Rubbish/Repair/Refill/Immobilie/Vertrag/Alkoholtest/Whack]");
	}
	if(strcmp(cmd,"Frisk",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 8)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir eine Durchsuchung an.");
	    pID = Spieler[playerid][pSeller];
	    if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    format(string,sizeof(string),""IINFO" du hast die Durchsuchung von %s (ID:%i) abgelehnt!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat deine Durchsuchung abgelehnt!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		Spieler[playerid][pMenge2] = 0;
		Spieler[playerid][pVerbrauch] = 0;
		return 1;
	}
	if(strcmp(cmd,"Alkoholtest",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 16)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir einen Alkoholtest an.");
		pID = Spieler[playerid][pSeller];
	    if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    format(string,sizeof(string),""IINFO" du hast den Alkoholtest von %s (ID:%i) abgelehnt!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat deinen Alkoholtest abgelehnt!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		Spieler[playerid][pMenge2] = 0;
		Spieler[playerid][pVerbrauch] = 0;
		return 1;
	}
	if(strcmp(cmd,"Whack",true) == 0)
   	{
		if(Spieler[playerid][pAngebot] != 23)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir das Wantedhacking an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    format(string,sizeof(string),""IINFO" du hast das Wantedhacking von %s (ID:%i) abgelehnt.",SpielerFraktionsRangName(playerid),SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dein Angebot zum Wantedhacking abgelehnt!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[pID][pSeller] = -1;
	    Spieler[pID][pAngebot] = 0;
	 	Spieler[pID][pMenge] = 0;
		return 1;
	}
	if(strcmp(cmd,"Ticket",true) == 0)
   	{
		if(Spieler[playerid][pAngebot] != 12)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir ein Ticket an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    format(string,sizeof(string),""IINFO" du hast das von %s (ID:%i) gestellte Ticket abgelehnt!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dein gestelltes Ticket abgelehnt!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		Spieler[playerid][pMenge2] = 0;
		Spieler[playerid][pVerbrauch] = 0;
		return 1;
	}
	if(strcmp(cmd,"Interview",true) == 0)
   	{
		if(Spieler[playerid][InviteInterView] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bittet dir ein Interview an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast das Interview von %s (ID:%i) abgelehnt!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dein gestelltes Interview abgelehnt!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][LiveView] = 0;
		Spieler[playerid][InviteInterView] = 0;
		Spieler[playerid][pSeller] = -1;
		return 1;
	}
	if(strcmp(cmd,"Fahrstunde",true) == 0)
   	{
	    if(Spieler[playerid][pAngebot] != 7)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bittet dir eine Lehrstunde/Fahrprüfung an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    format(string,sizeof(string),""IINFO" du hast die Fahrstunde von %s (ID:%i) abgelehnt!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat die Fahrstunde nicht entgegengenomen!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][InFahrSchulPruefung] = 0;
		Spieler[playerid][pAngebot] = 0;
		return 1;
	}
	if(strcmp(cmd,"Repair",true) == 0)
   	{
	    if(Spieler[playerid][pAngebot] != 4)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bittet dir eine Reperatur an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast die von %s (ID:%i) angebotene Reperatur abgelehnt!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat die Reperatur abgelehnt!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		return 1;
	}
	if(strcmp(cmd,"Refill",true) == 0)
   	{
	    if(Spieler[playerid][pAngebot] != 5)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bittet dir eine Reperatur an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast die von %s (ID:%i) angebotene Tankfüllung abgelehnt!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat die Tankfüllung abgelehnt!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		return 1;
	}
	if(strcmp(cmd,"Immobilie",true) == 0)
   	{
	   	new besitzerid = Immobilienbesitzer[playerid],kundenid = Immobilienkunde[playerid],seller = Immobilienseller[playerid];
		if(Immobiliensell[playerid] == 0)return SCM(playerid,SAMP_WEISS,"In keiner Kaufauktion Aktiv.");
		if(playerid == besitzerid)
		{
			SCM(playerid,SAMP_WEISS,""IINFO" du hast die Kaufauktion beendet!");
			format(string,sizeof(string),"%s (ID:%i) hat die Kaufauktion beendet!",SpielerName(playerid),playerid);
			SCM(seller,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) hat die Kaufauktion beendet!",SpielerName(playerid),playerid);
			SCM(kundenid,SAMP_WEISS,string);
		}
		if(playerid == kundenid)
		{
			SCM(playerid,SAMP_WEISS,""IINFO" du hast die Kaufauktion beendet!");
			format(string,sizeof(string),"%s (ID:%i) hat die Kaufauktion beendet!",SpielerName(playerid),playerid);
			SCM(seller,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) hat die Kaufauktion beendet!",SpielerName(playerid),playerid);
			SCM(besitzerid,SAMP_WEISS,string);
		}
		if(playerid == seller)
		{
			SCM(playerid,SAMP_WEISS,""IINFO" du hast die Kaufauktion beendet!");
			format(string,sizeof(string),"%s (ID:%i) hat die Kaufauktion beendet!",SpielerName(playerid),playerid);
			SCM(kundenid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) hat die Kaufauktion beendet!",SpielerName(playerid),playerid);
			SCM(besitzerid,SAMP_WEISS,string);
		}
	    Immobilienart[playerid] = 0;
		Immobiliensell[playerid] = 0;
		Immobilienseller[playerid] = -1;
		Immobilienbesitzer[playerid] = -1;
		Immobilienkunde[playerid] = -1;
		Immobilienpreis[playerid] = 0;
		Immobilienid[playerid] = -1;
		Immobilienbesitzeraccepted[playerid] = 0;
		Immobilienart[besitzerid] = 0;
		Immobiliensell[besitzerid] = 0;
		Immobilienseller[besitzerid] = -1;
		Immobilienbesitzer[besitzerid] = -1;
		Immobilienkunde[besitzerid] = -1;
		Immobilienpreis[besitzerid] = 0;
		Immobilienid[besitzerid] = -1;
		Immobilienbesitzeraccepted[besitzerid] = 0;
		Immobilienart[seller] = 0;
		Immobiliensell[seller] = 0;
		Immobilienseller[seller] = -1;
		Immobilienbesitzer[seller] = -1;
		Immobilienkunde[seller] = -1;
		Immobilienpreis[seller] = 0;
		Immobilienid[seller] = -1;
		Immobilienbesitzeraccepted[seller] = 0;
		return 1;
	}
	if(strcmp(cmd,"Vertrag",true) == 0)
   	{
	    if(Spieler[playerid][pAngebot] != 13)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir einen Vertrag an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    format(string,sizeof(string),""IINFO" du hast den Vertrag von %s (ID:%i) abgelehnt!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat deinen gestellten Vertrag abgelehnt!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		return 1;
	}
	if(strcmp(cmd,"Race",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 14)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir eine Einladung zu einem Rennen an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(10.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast die Einladung von %s (ID:%i) zu einem Rennen abgelehnt.",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s hat deine von dir aus gestellte Einladung zu einem Rennen abelehnt.",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		return 1;
	}
	if(strcmp(cmd,"Segen",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 19)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir eine Einladung zu einem Rennen an.");
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(10.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast den Segen von %s (ID:%i) abgelehnt.",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s hat deinen Segen abgelehnt.",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		return 1;
	}
	if(strcmp(cmd,"Freebl",true) == 0)
   	{
	    if(Spieler[playerid][pAngebot] != 15)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir einen Freikauf von einer Blacklist an.");
	    pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    format(string,sizeof(string),"%s hat den von dir aus gestellten Freikauf von der Blacklist der Fraktion %s abgelehnt.",SpielerName(playerid),FraktionsName(Spieler[pID][pFraktion]));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast den von %s aus gestellten Freikauf von der Blacklist der Fraktion %s abgelehnt.",SpielerName(pID),FraktionsName(Spieler[pID][pFraktion]));
		SCM(playerid,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		return 1;
	}
	if(strcmp(cmd,"Sinlist",true) == 0)
   	{
	    if(Spieler[playerid][pAngebot] != 20)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir einen Freikauf von einer Sinlist an.");
	    pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    format(string,sizeof(string),"%s hat den von dir aus gestellten Freikauf von der Sinlist der Fraktion %s abgelehnt.",SpielerName(playerid),FraktionsName(Spieler[pID][pFraktion]));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast den von %s aus gestellten Freikauf von der Sinlist der Fraktion %s abgelehnt.",SpielerName(pID),FraktionsName(Spieler[pID][pFraktion]));
		SCM(playerid,SAMP_WEISS,string);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		return 1;
	}
	if(strcmp(cmd,"Befreiung",true) == 0)
	{
	    if(Spieler[playerid][pCallServiceWheelman] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Wheelman angefordert.");
	    SCM(playerid,SAMP_WEISS,"{FF6666}SMS:{FFFFFF} Ich brauche doch keine Hilfe mehr.");
	    Spieler[playerid][pCallServiceWheelman] = false;
	    return 1;
	}
	if(strcmp(cmd,"SAPD",true) == 0)
   	{
	   	if(Spieler[playerid][pCallServicSAPD] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Streifenwagen angefordert.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Danke für die Info,dass Sie keinen Streifenwagen mehr benötigen.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Falls Sie später dennoch einen brauchen sollten wir für Sie da.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Auf wiederhören,im Namen des San Andreas Police Departments.");
		Spieler[playerid][pCallServicSAPD] = false;
		return 1;
	}
	if(strcmp(cmd,"Medic",true) == 0)
   	{
	   	if(Spieler[playerid][pCallServiceMedic] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen RTW angefordert.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Danke für die Info,dass Sie keinen RTW mehr benötigen.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Falls Sie später dennoch einen brauchen sollten wir für Sie da.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Auf wiederhören,im Namen des San Andreas Fire Department.");
		Spieler[playerid][pCallServiceMedic] = false;
		return 1;
	}
	if(strcmp(cmd,"Verstaerkung",true) == 0)
	{
	    if(Spieler[playerid][pCallVaersterkung] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Verstärkung angefordert.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Danke für die Info,dass Sie keine Verstärkung mehr benötigen.");
		Spieler[playerid][pCallVaersterkung] = false;
		return 1;
	}
	if(strcmp(cmd,"Feuer",true) == 0)
   	{
	    if(Spieler[playerid][pCallServicFireBrigade] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Löschzug angefordert.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Danke für die Info,dass Sie keinen Löschzug mehr benötigen.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Falls Sie später dennoch einen brauchen sollten wir für Sie da.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Auf wiederhören,im Namen des San Andreas Fire Department.");
		Spieler[playerid][pCallServicFireBrigade] = false;
		return 1;
	}
	if(strcmp(cmd,"pod",true) == 0)
   	{
	    if(Spieler[playerid][pCallServicOAmt] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Abschlepper angefordert.");
	    SCM(playerid,SAMP_WEISS,""IINFO2"Angestellte:"#HTML_WEISS" Danke für die Info,dass Sie keinen POD Mitarbeiter mehr benötigen.");
		Spieler[playerid][pCallServicOAmt] = false;
		return 1;
	}
	if(strcmp(cmd,"Taxi",true) == 0)
   	{
	    if(Spieler[playerid][pCallServiceTaxi] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast kein Taxi angefordert.");
	    SCM(playerid,SAMP_WEISS,""IINFO2"Angestellte:"#HTML_WEISS" Danke für die Info,dass Sie keinen Taxi Mitarbeiter mehr benötigen.");
		Spieler[playerid][pCallServiceTaxi] = false;
		return 1;
	}
	if(strcmp(cmd,"Mechaniker",true) == 0)
   	{
	    if(Spieler[playerid][pCallServicMechanic] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Mechaniker angefordert.");
	    SCM(playerid,SAMP_WEISS,""IINFO2"Angestellte:"#HTML_WEISS" Danke für die Info,dass Sie keinen Mechaniker Mitarbeiter mehr benötigen.");
		Spieler[playerid][pCallServicMechanic] = false;
		return 1;
	}
	if(strcmp(cmd,"Elektriker",true) == 0)
   	{
	    if(Spieler[playerid][pCallServicElektrik] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Elektriker angefordert.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Danke für die Info,dass Sie keinen Elektriker mehr benötigen.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Falls Sie später dennoch einen brauchen sollten sind wir für Sie da.");
	    SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Auf wiederhören,im Namen des San Andreas Electrical Service.");
		Spieler[playerid][pCallServicElektrik] = false;
		return 1;
	}
	if(strcmp(cmd,"Rubbish",true) == 0)
   	{
	    if(Spieler[playerid][pCallServiceRubbishMen] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Müllman angefordert.");
	    SCM(playerid,SAMP_WEISS,"{FF6666}Unternehmen:{FFFFFF} Danke für die Info,dass Sie keinen Müllwagen mehr benötigen.");
	    SCM(playerid,SAMP_WEISS,"{FF6666}Unternehmen:{FFFFFF} Falls Sie später dennoch einen brauchen sollten sind wir für Sie da.");
	    SCM(playerid,SAMP_WEISS,"{FF6666}Unternehmen:{FFFFFF} Auf wiederhören,mit vielen Grüßen die San Andreas Müll Konzerne.");
		Spieler[playerid][pCallServiceRubbishMen] = false;
		return 1;
	}
	SCM(playerid,SAMP_WEISS,""IINFO" /cancel [Frisk/Ticket/Interview/Fahrstunde/SAPD/Medic/Feuer/Race/Freebl/Sinlist/Befreiung]");
	return SCM(playerid,SAMP_WEISS,"[Abschleppen/Taxi/Mechaniker/Elektriker/Rubbish/Repair/Refill/Immobilie/Vertrag/Alkoholtest]");
}
COMMAND:op(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new cmd[10],onlinecounter = 0,string[6000];
    if(sscanf(params,"s[10]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /op [Fraktion/Job]");
    if(strcmp(cmd,"Fraktion",true) == 0)
   	{
	   	switch(Spieler[playerid][pFraktion])
	   	{
		   	case 1:
		   	{
			   	ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && Spieler[i][pCallServicSAPD] == true)
				    {
					    format(string,sizeof(string),""#HTML_WEISS"ID: "IINFO2"%i"#HTML_WEISS"\nName: "IINFO2"%s",i,SpielerName(i));
					    ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" S.A.P.D - Aufträge",string,"Okay","");
					    onlinecounter++;
				    }
				}
				if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Polizisten angefordert.");
				return 1;
		   	}
		   	case 3:
		   	{
			    ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && (Spieler[i][pCallServiceMedic] == true || Spieler[i][pCallServicFireBrigade] == true))
				    {
					    new rescuestate[32];
					    if(Spieler[i][pCallServiceMedic] == true){rescuestate="Krankenwagen";}
					    if(Spieler[i][pCallServicFireBrigade] == true){rescuestate="Feuerwehr";}
						format(string,sizeof(string),""#HTML_WEISS"ID: "IINFO2"%i"#HTML_WEISS"\nName: "IINFO2"%s"#HTML_WEISS" Benötigt wird: "IINFO2"%s",i,SpielerName(i),rescuestate);
						ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Taxi - Aufträge",string,"Okay","");
					    onlinecounter++;
				    }
				}
				if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Notarzt/Löschzug angefordert.");
				return 1;
		   	}
		   	case 11:
			{
			    ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && Spieler[i][pCallServicOAmt] == true)
				    {
					    format(string,sizeof(string),""#HTML_WEISS"ID: "IINFO2"%i"#HTML_WEISS"\nName: "IINFO2"%s",i,SpielerName(i));
					    ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Public Order Department - Aufträge",string,"Okay","");
					    onlinecounter++;
				    }
				}
			    if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Abschlepper angefordert.");
			    return 1;
		   	}
		   	case 12:
		   	{
			   	SCM(playerid,SAMP_WEISS,"|______ Offene Aufträge ______|");
			    ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && Spieler[i][pCallServiceWheelman] == true)
				    {
					    format(string,sizeof(string),"%i. %s | Wantedlevel: %i | Derzeitiges Fahndungslevel: %i",i,SpielerName(i),GetPlayerWantedLevel(i),Spieler[i][pWantedPoints]);
					    SCM(playerid,SAMP_WEISS,string);
					    onlinecounter++;
				    }
				}
				if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Befreiung angefordert.");
				return 1;
		   	}
		   	case 15:
		   	{
			    ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && Spieler[i][pCallServicElektrik] == true)
				    {
					    format(string,sizeof(string),""#HTML_WEISS"ID: "IINFO2"%i"#HTML_WEISS"\nName: "IINFO2"%s",i,SpielerName(i));
					    ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Elektriker - Aufträge",string,"Okay","");
					    onlinecounter++;
				    }
				}
			    if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Elektriker angefordert.");
			    return 1;
		   	}
		   	case 18:
		   	{
			   	SCM(playerid,SAMP_WEISS,"|______ Offene Aufträge ______|");
			    for(new deather;deather<MAX_TOTEN;deather++)
				{
					if(TotenInfo[deather][totenlevel] != 0)
					{
						if((TotenInfo[deather][totenxpos] > -992.5172 && TotenInfo[deather][totenxpos] < 4000.0000) && (TotenInfo[deather][totenypos] < 528.0000 && TotenInfo[deather][totenypos] > -4000.0000))//Los Santos
						{
							format(string,sizeof(string),"%i. Ort: Los Santos",deather);
					    }
						if((TotenInfo[deather][totenxpos] > -4000.0000 && TotenInfo[deather][totenxpos] < -992.5172) && (TotenInfo[deather][totenypos] < 4000.0000 && TotenInfo[deather][totenypos] > -4000.0000))//San Fierro
						{
							format(string,sizeof(string),"%i. Ort: San Fierro",deather);
						}
						if((TotenInfo[deather][totenxpos] > -992.5172 && TotenInfo[deather][totenxpos] < 4000.0000) && (TotenInfo[deather][totenypos] < 4000.0000 && TotenInfo[deather][totenypos] > 528.0000))//Las Venturas
						{
							format(string,sizeof(string),"%i. Ort: Las Venturas",deather);
					    }
					    SCM(playerid,SAMP_WEISS,string);
					    onlinecounter++;
					}
				}
			    if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Leichenbestatter angefordert.");
				return 1;
   			}
	   	}
	   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
   	}
   	if(strcmp(cmd,"Job",true) == 0)
   	{
	    if(isPlayerInJob(playerid,1))
	    {
		    ForEachPlayer(i)
		    {
			    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && Spieler[i][pCallServiceRubbishMen] == true)
			    {
				    format(string,sizeof(string),""#HTML_WEISS"ID: "IINFO2"%i"#HTML_WEISS"\nName: "IINFO2"%s",i,SpielerName(i));
				    ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Straßenkehrer - Aufträge",string,"Okay","");
				    onlinecounter++;
			    }
			}
		    if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Müllwagen angefordert.");
			return 1;
	    }
	    if(isPlayerInJob(playerid,12))
	    {
		    ForEachPlayer(i)
		    {
			    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && Spieler[i][pCallServicMechanic] == true)
			    {
				    format(string,sizeof(string),""#HTML_WEISS"ID: "IINFO2"%i"#HTML_WEISS"\nName: "IINFO2"%s",i,SpielerName(i));
				    ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Mechaniker - Aufträge",string,"Okay","");
				    onlinecounter++;
			    }
			}
		    if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Mechaniker angefordert.");
			return 1;
	    }
	    if(isPlayerInJob(playerid,17))
	    {
		    ForEachPlayer(i)
		    {
			    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && Spieler[i][pCallServiceTaxi] == true)
			    {
				    format(string,sizeof(string),""#HTML_WEISS"ID: "IINFO2"%i"#HTML_WEISS"\nName: "IINFO2"%s",i,SpielerName(i));
				    ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Taxi - Aufträge",string,"Okay","");
				    onlinecounter++;
			    }
			}
		    if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat ein Taxi angefordert.");
			return 1;
	    }
	    if(isPlayerInJob(playerid,27))
	   	{
	   		SCM(playerid,SAMP_WEISS,"|______ Offene Aufträge ______|");
		    for(new deather;deather<MAX_TOTEN;deather++)
			{
				if(TotenInfo[deather][totenlevel] != 0)
				{
					if((TotenInfo[deather][totenxpos] > -992.5172 && TotenInfo[deather][totenxpos] < 4000.0000) && (TotenInfo[deather][totenypos] < 528.0000 && TotenInfo[deather][totenypos] > -4000.0000))//Los Santos
					{
						format(string,sizeof(string),"%i. Ort: Los Santos",deather);
				    }
					if((TotenInfo[deather][totenxpos] > -4000.0000 && TotenInfo[deather][totenxpos] < -992.5172) && (TotenInfo[deather][totenypos] < 4000.0000 && TotenInfo[deather][totenypos] > -4000.0000))//San Fierro
					{
						format(string,sizeof(string),"%i. Ort: San Fierro",deather);
					}
					if((TotenInfo[deather][totenxpos] > -992.5172 && TotenInfo[deather][totenxpos] < 4000.0000) && (TotenInfo[deather][totenypos] < 4000.0000 && TotenInfo[deather][totenypos] > 528.0000))//Las Venturas
					{
						format(string,sizeof(string),"%i. Ort: Las Venturas",deather);
				    }
				    SCM(playerid,SAMP_WEISS,string);
				    onlinecounter++;
				}
			}
   			if(onlinecounter == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Leichenbestatter angefordert.");
			return 1;
		}
	   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im jeweiligen Job.");
   	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /op [Fraktion/Job]");
}
COMMAND:xmas(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(monat != 12)return SCM(playerid,SAMP_WEISS,"Es ist nicht Dezember.");
	for(new i=0;i<sizeof(XmasPresents);i++)
	{
	    if(IsPlayerInRangeOfPoint(playerid,1.5,XmasPresents[i][xmas_x],XmasPresents[i][xmas_y],XmasPresents[i][xmas_z]))
	    {
		    if(Spieler[playerid][pStartbonus] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits einen Startbonus/ein Weihnachtsgeschenk erhalten.");
		    ShowPlayerDialog(playerid,DIALOG_XMAS_PRESENT,DIALOG_STYLE_LIST,""ClanTagDialoge" Weihnachten","Sechs Respektpunkte\n10.000$\nEine Woche Donator Status","Auswählen","Abbrechen");
		    return 1;
	    }
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Weihnachtsbaum.");
}

COMMAND:accept(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new pID,cmd[30],string[128];
	if(sscanf(params,"s[30]",cmd))
	{
		SCM(playerid,SAMP_WEISS,""IINFO" /accept [Ganja/Kokain/Opium/Spice/Sex/Ice/Frisk/Ticket/Interview/Schein/Elektriker/Race/Freebl/Alkoholtest/Befreiung/Dice/Segen/Sinlist]");
		return SCM(playerid,SAMP_WEISS,"[Fahrstunde/SAPD/Medic/Feuer/Abschleppen/Taxi/Bestatten/Mechaniker/Rubbish/Waffe/Repair/Refill/Immobilie/Vertrag/Orginvite/Nacho/Whack]");
	}
	if(strcmp(cmd,"Schein",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 1)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bittet dir eine Lizens an.");
		if((GetACMoney(playerid) - Spieler[playerid][pKaufPreis]) < 0)
		{
		    PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
			return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld dabei.");
		}
		pID = Spieler[playerid][pSeller];
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Scheine verkaufen!");
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		if(Spieler[playerid][pMenge] == 1)
		{
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) einen Führerschein für %i$ angenommen.",SpielerName(pID),pID,Spieler[playerid][pKaufPreis]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) hat deinen Führerschein für %i$ angenommen.",SpielerName(playerid),playerid,Spieler[playerid][pKaufPreis]);
			SCM(pID,SAMP_WEISS,string);
			Spieler[playerid][pAutoLic] = 1;
			ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
			fverwaltungen[14][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			fverwaltungen[16][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			Spieler[playerid][pSeller] = -1;
			Spieler[playerid][pAngebot] = 0;
			Spieler[playerid][pKaufPreis] = 0;
			Spieler[playerid][pMenge] = 0;
		}
		if(Spieler[playerid][pMenge] == 2)
		{
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) einen Motorradschein für %i$ angenommen.",SpielerName(pID),pID,Spieler[playerid][pKaufPreis]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) hat deinen Motorradschein für %i$ angenommen.",SpielerName(playerid),playerid,Spieler[playerid][pKaufPreis]);
			SCM(pID,SAMP_WEISS,string);
			Spieler[playerid][pBikeLic] = 1;
			ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
			fverwaltungen[14][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			fverwaltungen[16][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			Spieler[playerid][pSeller] = -1;
			Spieler[playerid][pAngebot] = 0;
			Spieler[playerid][pKaufPreis] = 0;
			Spieler[playerid][pMenge] = 0;
		}
		if(Spieler[playerid][pMenge] == 3)
		{
		    format(string,sizeof(string),""IINFO" du hast %s (ID:%i) einen Flugzeugschein für %i$ angenommen.",SpielerName(pID),pID,Spieler[playerid][pKaufPreis]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) hat deinen Flugzeugschein für %i$ angenommen.",SpielerName(playerid),playerid,Spieler[playerid][pKaufPreis]);
			SCM(pID,SAMP_WEISS,string);
			Spieler[playerid][pPlaneLic] = 1;
			ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
			fverwaltungen[14][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			fverwaltungen[16][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			Spieler[playerid][pSeller] = -1;
			Spieler[playerid][pAngebot] = 0;
			Spieler[playerid][pKaufPreis] = 0;
			Spieler[playerid][pMenge] = 0;
		}
		if(Spieler[playerid][pMenge] == 4)
		{
		    format(string,sizeof(string),""IINFO" du hast %s (ID:%i) einen Helikopterschein für %i$ angenommen.",SpielerName(pID),pID,Spieler[playerid][pKaufPreis]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) hat deinen Helikopterschein für %i$ angenommen.",SpielerName(playerid),playerid,Spieler[playerid][pKaufPreis]);
			SCM(pID,SAMP_WEISS,string);
			Spieler[playerid][pHeliLic] = 1;
			ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
			fverwaltungen[14][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			fverwaltungen[16][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			Spieler[playerid][pSeller] = -1;
			Spieler[playerid][pAngebot] = 0;
			Spieler[playerid][pKaufPreis] = 0;
			Spieler[playerid][pMenge] = 0;
		}
		if(Spieler[playerid][pMenge] == 5)
		{
		    format(string,sizeof(string),""IINFO" du hast %s (ID:%i) einen Bootsschein für %i$ angenommen.",SpielerName(pID),pID,Spieler[playerid][pKaufPreis]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) hat deinen Bootsschein für %i$ angenommen.",SpielerName(playerid),playerid,Spieler[playerid][pKaufPreis]);
			SCM(pID,SAMP_WEISS,string);
			Spieler[playerid][pBoatLic] = 1;
			ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
			fverwaltungen[14][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			fverwaltungen[16][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			Spieler[playerid][pSeller] = -1;
			Spieler[playerid][pAngebot] = 0;
			Spieler[playerid][pKaufPreis] = 0;
			Spieler[playerid][pMenge] = 0;
		}
		if(Spieler[playerid][pMenge] == 6)
		{
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) einen Rollerschein für %i$ angenommen.",SpielerName(pID),pID,Spieler[playerid][pKaufPreis]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s (ID:%i) hat deinen Rollerschein für %i$ angenommen.",SpielerName(playerid),playerid,Spieler[playerid][pKaufPreis]);
			SCM(pID,SAMP_WEISS,string);
			Spieler[playerid][pRollerLic] = 1;
			ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
			fverwaltungen[14][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			fverwaltungen[16][Geld] += floatround(Spieler[playerid][pKaufPreis]/60);
			Spieler[playerid][pSeller] = -1;
			Spieler[playerid][pAngebot] = 0;
			Spieler[playerid][pKaufPreis] = 0;
			Spieler[playerid][pMenge] = 0;
		}
		return 1;
	}
    if(strcmp(cmd,"Nacho",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 22)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir einen Nacho an.");
		if((GetACMoney(playerid) - Spieler[playerid][pKaufPreis]) < 0)
		{
		    PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
			return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld dabei");
		}
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast ein Nacho von %s (ID:%i) für %i$ gekauft.",SpielerName(pID),pID,Spieler[playerid][pKaufPreis]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir ein Nacho für %i$ abgekauft.",SpielerName(playerid),playerid,Spieler[playerid][pKaufPreis]);
		SCM(pID,SAMP_WEISS,string);
		SCM(pID,SAMP_WEISS,"Info: Das Geld wurde in die Fraktionsbank eingezahlt.");
		SetPlayerACHealth(playerid,100);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(pID),SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
		fverwaltungen[17][Geld] += Spieler[playerid][pKaufPreis];
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		return 1;
	}
	if(strcmp(cmd,"Ice",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 2)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir Ice an.");
		if((GetACMoney(playerid) - Spieler[playerid][pKaufPreis]) < 0)
		{
		    PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
			return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld dabei");
		}
		if(gettime() < Spieler[playerid][pAntiHealInFight])
		{
			new time = Spieler[playerid][pAntiHealInFight] - gettime();
			format(string,sizeof(string),""IINFO" du kannst dich erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten heilen oder dir eine Rüstung überziehen.",time/60,time%60);
			return SCM(playerid,SAMP_WEISS,string);
		}
		pID = Spieler[playerid][pSeller];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast ein Eis von %s (ID:%i) für %i$ gekauft.",SpielerName(pID),pID,Spieler[playerid][pKaufPreis]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir ein Eis für %i$ abgekauft.",SpielerName(playerid),playerid,Spieler[playerid][pKaufPreis]);
		SCM(pID,SAMP_WEISS,string);
		SCM(pID,SAMP_WEISS,"Info: Die Auszahlung wird am Zahltag auf dein Konto überwiesen.");
		SetPlayerACHealth(playerid,100);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(pID),SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		ACMoney(playerid,- Spieler[playerid][pKaufPreis]);
		Spieler[pID][pLohn] += Spieler[playerid][pKaufPreis];
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		Spieler[playerid][pKaufPreis] = 0;
		Spieler[playerid][pMenge] = 0;
		return 1;
	}
	if(strcmp(cmd,"Whack",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 23)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir das Wantedhacking an.");
		if((GetACMoney(playerid) - Spieler[playerid][pKaufPreis]) < 0)
		{
		    PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
