		if((Spieler[pID][pGanjaSammen] + menge) > 100)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Ganjasamen gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %i Ganjasamen gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pGanjaSammen] -= menge;
		Spieler[pID][pGanjaSammen] += menge;
		return 1;
	}
	if(strcmp(cmd,"Materials",true) == 0)
	{
	    if((Spieler[playerid][pMaterials] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viele Materials bei dir!");
		if((Spieler[pID][pMaterials] + menge) > 10000)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Materials gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %i Materials gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pMaterials] -= menge;
		Spieler[pID][pMaterials] += menge;
		return 1;
	}
	if(strcmp(cmd,"Werkzeugkasten",true) == 0)
	{
	    if((Spieler[playerid][pRepairVehBoxes] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viele Werkzeugkästen bei dir!");
		if((Spieler[pID][pRepairVehBoxes] + menge) > 10)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Werkzeugkästen gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %i Werkzeugkästen gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pRepairVehBoxes] -= menge;
		Spieler[pID][pRepairVehBoxes] += menge;
		return 1;
	}
	if(strcmp(cmd,"Benzinkanister",true) == 0)
	{
	    if((Spieler[playerid][pTankFillBoxes] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viele Benzinkanister bei dir!");
		if((Spieler[pID][pTankFillBoxes] + menge) > 10)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Benzinkanister gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %i Benzinkanister gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pTankFillBoxes] -= menge;
		Spieler[pID][pTankFillBoxes] += menge;
		return 1;
	}
	if(strcmp(cmd,"Köder",true) == 0)
	{
	    if((Spieler[playerid][pAngelKoeder] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viele Fischköder bei dir!");
		if((Spieler[pID][pAngelKoeder] + menge) > 200)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Angelköder gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %i Angelköder gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pAngelKoeder] -= menge;
		Spieler[pID][pAngelKoeder] += menge;
		return 1;
	}
	if(strcmp(cmd,"Opiumsamen",true) == 0)
	{
	    if((Spieler[playerid][pOpiumSammen] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viele Opiumsamen bei dir!");
		if((Spieler[pID][pOpiumSammen] + menge) > 100)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Opiumsamen gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %i Opiumsamen gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pOpiumSammen] -= menge;
		Spieler[pID][pOpiumSammen] += menge;
		return 1;
	}
	if(strcmp(cmd,"Spicesamen",true) == 0)
	{
	    if((Spieler[playerid][pSpiceSammen] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viele Spicesamen bei dir!");
		if((Spieler[pID][pSpiceSammen] + menge) > 100)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Spicesamen gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %i Spicesamen gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pSpiceSammen] -= menge;
		Spieler[pID][pSpiceSammen] += menge;
		return 1;
	}
	SCM(playerid,SAMP_WEISS,""IINFO" /give [playerid/Name][Sache][Menge]");
	SCM(playerid,SAMP_WEISS,"Sache:");
    SCM(playerid,SAMP_WEISS,"[Ganja/Kokain/Opium/Lunch/Zigarette/Kokainsamen/Ganjasamen/Coins/Spice]");
    return SCM(playerid,SAMP_WEISS,"[Materials/Werkzeugkasten/Benzinkanister/Köder/Opiumsamen/Spicesamen]");
}

COMMAND:deljobtime(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128];
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /deljobtime [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(gettime() > Spieler[pID][pJobSperre])return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler hat keine Jobsperre.");
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat dir deine Jobsperre gelöscht.",Spieler[playerid][pName],playerid);
    SCM(pID,SAMP_WEISS,string);
    format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) die Jobsperre gelöscht.",Spieler[pID][pName],pID);
    SCM(playerid,SAMP_WEISS,string);
    Spieler[pID][pJobSperre] = 0;
	return 1;
}
COMMAND:set(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    new pID,string[8500],cmd[30],menge;
    if(sscanf(params,"us[30]i",pID,cmd,menge))
    {
	    SCM(playerid,SAMP_WEISS,""IINFO" /set [playerid | Name][Aktion][Menge | Betrag | Stand | Rang | Tage]");
	    SCM(playerid,SAMP_WEISS,"Bank | Level | Skin | FSkin | JokeSkin | Geld | Gwd | Zivinote | Respektpunkte | DonatorZeit | Fraktionssperre | Lunchpakete | Opium | Spice | Spicesamen | Coins");
		SCM(playerid,SAMP_WEISS,"Kokain | C4 | Ganja | Materials | Bier | Zigaretten | Werkzeugkästen | Benzinkanister | Opiumsamen | Ganjasamen | Kokainsamen | Gutschein | Job");
	    return 1;
    }
 	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(strcmp(cmd,"Bank",true) == 0)
	{
		if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	    if(Spieler[pID][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt kein Konto bei der Bank of San Andreas.");
		Spieler[pID][pBank] = menge;
	    format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS" hat dir dein Bankkonto auf %i$ gesetzt.",Spieler[playerid][pName],menge);
	    SCM(pID,SAMP_WEISS,string);
	    format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS" Bankkonto auf %i$ gesetzt",Spieler[pID][pName],menge);
	    SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"Admin: "IINFO2"%s"#HTML_WEISS" | Spieler: "IINFO2"%s"#HTML_WEISS" | Menge: "IINFO2"%i"#HTML_WEISS" | Art: /set ["IINFO2"%s"#HTML_WEISS"/%i]["IINFO2"%s"#HTML_WEISS"][%i]",Spieler[playerid][pName],Spieler[pID][pName],menge,Spieler[pID][pName],pID,cmd,menge);
		Log("script_aset.txt",string);
		return 1;
	}
	if(strcmp(cmd,"Level",true) == 0)
	{
		if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	    if(menge<1||menge>100)return SCM(playerid,SAMP_WEISS,""IINFO" /set level [playerid/Name][Level 1-100]");
	    format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS"  hat dein Level auf "IINFO2"%i"#HTML_WEISS" gesetzt.",Spieler[playerid][pName],menge);
	    SCM(pID,SAMP_WEISS,string);
	    format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS"  das Level auf "IINFO2"%i"#HTML_WEISS" gesetzt.",Spieler[pID][pName],menge);
	    SCM(playerid,SAMP_WEISS,string);
	    SetPlayerLevel(pID,menge);
	    Spieler[pID][pTimeAfterRegister] = 60*60*GetPlayerLevel(pID);
		if(Spieler[pID][HatGeworben] == 2 && GetPlayerLevel(pID) >= 5)
		{
			new personalid = GetPlayerID(Spieler[pID][GeworbenPlaya]);
			if(personalid == -1)
			{
				mysql_format(MySQL_R394,string,sizeof(string),"SELECT * FROM spieler WHERE Name='%e'",Spieler[pID][GeworbenPlaya]);
				mysql_function_query(MySQL_R394,string,true,"sql_array2","siii",string,_SQL_SETPREMIUM,0,MySQL_R394);
			}
			else
			{
                format(string,sizeof(string),"{00F0FF}* Da du {33CC00}"IINFO2"%s"#HTML_WEISS"{00F0FF} geworben hast bekommst du nun 30 Coins *",Spieler[pID][GeworbenPlaya]);
		    	SCM(personalid,WEISS,string);
			    Spieler[personalid][pCoins] += 30;
			}
		}
		format(string,sizeof(string),"Admin: "IINFO2"%s"#HTML_WEISS" | Spieler: "IINFO2"%s"#HTML_WEISS" | Menge: "IINFO2"%i"#HTML_WEISS" | Art: /set ["IINFO2"%s"#HTML_WEISS"/%i]["IINFO2"%s"#HTML_WEISS"][%i]",Spieler[playerid][pName],Spieler[pID][pName],menge,Spieler[pID][pName],pID,cmd,menge);
		Log("script_aset.txt",string);
		return 1;
	}
	if(strcmp(cmd,"job",true) == 0)
	{
		if(menge > 15 || menge < 0)
		{
			SCM(playerid,SAMP_WEISS,""IINFO" es gibt nur 15 Jobs!");
			return 1;
		}
		Spieler[playerid][pJob] = menge;
		format(string,sizeof(string),""ACINFO" der Admin "IINFO2""IINFO2"%s"#HTML_WEISS""#HTML_WEISS" hat deinen Job auf "IINFO2""IINFO2"%s"#HTML_WEISS""#HTML_WEISS" gesetzt.",Spieler[playerid][pName],SpielerJob(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2""IINFO2"%s"#HTML_WEISS""#HTML_WEISS" seinen Job "IINFO2""IINFO2"%s"#HTML_WEISS""#HTML_WEISS" gesetzt.",Spieler[pID][pName],SpielerJob(playerid));
		SCM(playerid,SAMP_WEISS,string);
	}
	if(strcmp(cmd,"Skin",true) == 0)
	{
	    if(menge<1||menge>299)return SCM(playerid,SAMP_WEISS,""IINFO" /set skin [playerid/Name][Skinid 1-299]");
		SetPlayerSkin(pID,menge);
		Spieler[pID][pSkin] = GetPlayerSkin(pID);
		format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS"  hat dir den Skin "IINFO2"%i"#HTML_WEISS" zugewiesen.",Spieler[playerid][pName],menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS"  den Skin "IINFO2"%i"#HTML_WEISS" zugewiesen.",Spieler[pID][pName],menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Admin: "IINFO2"%s"#HTML_WEISS" | Spieler: "IINFO2"%s"#HTML_WEISS" | Menge: "IINFO2"%i"#HTML_WEISS" | Art: /set ["IINFO2"%s"#HTML_WEISS"/%i]["IINFO2"%s"#HTML_WEISS"][%i]",Spieler[playerid][pName],Spieler[pID][pName],menge,Spieler[pID][pName],pID,cmd,menge);
		Log("script_aset.txt",string);
		return 1;
	}
 	if(strcmp(cmd,"Gutschein",true) == 0)
	{
	    if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	    if(menge<0||menge>1)return SCM(playerid,SAMP_WEISS,""IINFO" /set gutschein [playerid/Name][0/1]");
		Spieler[pID][pGutschein] = menge;
		format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS"  hat dir den Gutschein "IINFO2"%i"#HTML_WEISS" zugewiesen.",Spieler[playerid][pName],menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS"  den Gutschein "IINFO2"%i"#HTML_WEISS" zugewiesen.",Spieler[pID][pName],menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Admin: "IINFO2"%s"#HTML_WEISS" | Spieler: "IINFO2"%s"#HTML_WEISS" | Menge: "IINFO2"%i"#HTML_WEISS" | Art: /set ["IINFO2"%s"#HTML_WEISS"/%i]["IINFO2"%s"#HTML_WEISS"][%i]",Spieler[playerid][pName],Spieler[pID][pName],menge,Spieler[pID][pName],pID,cmd,menge);
		Log("script_aset.txt",string);
		return 1;
	}
	if(strcmp(cmd,"Coins",true) == 0)
	{
	    if(!isPlayerAnAdmin(playerid,7) || !isPlayerAnAdmin(playerid,-1))return ADMIN_MSG(playerid);
	    if(menge<0||menge>100000000)return SCM(playerid,SAMP_WEISS,""IINFO" /set coins [playerid/Name][0-100000000]");
		Spieler[pID][pCoins] = menge;
		format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS"  hat dir deine Coins auf "IINFO2"%i"#HTML_WEISS" gesetzt.",Spieler[playerid][pName],menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS"  die Coins auf "IINFO2"%i"#HTML_WEISS" gesetzt.",Spieler[pID][pName],menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Admin: "IINFO2"%s"#HTML_WEISS" | Spieler: "IINFO2"%s"#HTML_WEISS" | Menge: "IINFO2"%i"#HTML_WEISS" | Art: /set ["IINFO2"%s"#HTML_WEISS"/%i]["IINFO2"%s"#HTML_WEISS"][%i]",Spieler[playerid][pName],Spieler[pID][pName],menge,Spieler[pID][pName],pID,cmd,menge);
		Log("script_aset.txt",string);
		return 1;
	}
	if(strcmp(cmd,"FSkin",true) == 0)
	{
	    if(menge<1||menge>299)return SCM(playerid,SAMP_WEISS,""IINFO" /set skin [playerid/Name][Skinid 1-299]");
		SetPlayerSkin(pID,menge);
		Spieler[pID][pFraktSkin] = GetPlayerSkin(pID);
		format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS"  hat dir den Fraktionsskin "IINFO2"%i"#HTML_WEISS" zugewiesen.",Spieler[playerid][pName],menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS"  den Fraktionsskin "IINFO2"%i"#HTML_WEISS" zugewiesen.",Spieler[pID][pName],menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Admin: "IINFO2"%s"#HTML_WEISS" | Spieler: "IINFO2"%s"#HTML_WEISS" | Menge: "IINFO2"%i"#HTML_WEISS" | Art: /set ["IINFO2"%s"#HTML_WEISS"/%i]["IINFO2"%s"#HTML_WEISS"][%i]",Spieler[playerid][pName],Spieler[pID][pName],menge,Spieler[pID][pName],pID,cmd,menge);
		Log("script_aset.txt",string);
		return 1;
	}
	if(strcmp(cmd,"JokeSkin",true) == 0)
	{
	    if(menge<1||menge>299)return SCM(playerid,SAMP_WEISS,""IINFO" /set skin [playerid/Name][Skinid 1-299]");
		SetPlayerSkin(pID,menge);
		format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS"  hat dir einen Jokeskin [%i] zugewiesen! Ein Jokeskin wird nicht gespeichert.",Spieler[playerid][pName],menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS"  den einen Jokeskin [%i] zugewiesen! Ein Jokeskin wird nicht gespeichert.",Spieler[pID][pName],menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Admin: "IINFO2"%s"#HTML_WEISS" | Spieler: "IINFO2"%s"#HTML_WEISS" | Menge: "IINFO2"%i"#HTML_WEISS" | Art: /set ["IINFO2"%s"#HTML_WEISS"/%i]["IINFO2"%s"#HTML_WEISS"][%i]",Spieler[playerid][pName],Spieler[pID][pName],menge,Spieler[pID][pName],pID,cmd,menge);
		Log("script_aset.txt",string);
		return 1;
	}
	if(strcmp(cmd,"Geld",true) == 0)
	{
		if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	    SetACMoney(pID,menge);
	    format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS"  hat dir dein Geld auf %i$ gesetzt.",Spieler[playerid][pName],menge);
	    SCM(pID,SAMP_WEISS,string);
	    format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS"  Geld auf %i$ gesetzt",Spieler[pID][pName],menge);
	    SCM(playerid,SAMP_WEISS, string);
	    format(string,sizeof(string),"Admin: "IINFO2"%s"#HTML_WEISS" | Spieler: "IINFO2"%s"#HTML_WEISS" | Menge: "IINFO2"%i"#HTML_WEISS" | Art: /set ["IINFO2"%s"#HTML_WEISS"/%i]["IINFO2"%s"#HTML_WEISS"][%i]",Spieler[playerid][pName],Spieler[pID][pName],menge,Spieler[pID][pName],pID,cmd,menge);
		Log("script_aset.txt",string);
		return 1;
	}
	if(strcmp(cmd,"Gwd",true) == 0)
	{
		if(menge<0||menge>6)return SCM(playerid,SAMP_WEISS,""IINFO" /set gwd [playerid/Name][Grundwehrdienstnote 0-6]");
	    Spieler[pID][pGrundwehrdienst] = menge;
	    format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS"  hat dir deine Grundwehrdienstnote auf "IINFO2"%i"#HTML_WEISS" gesetzt.",Spieler[playerid][pName],menge);
	    SCM(pID,SAMP_WEISS,string);
	    format(string,sizeof(string),""IINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS"  die Grundwehrdienstnote auf "IINFO2"%i"#HTML_WEISS" gesetzt",Spieler[pID][pName],menge);
	    SCM(playerid,SAMP_WEISS,string);
