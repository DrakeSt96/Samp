COMMAND:afrangs(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[256],fID;
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	if(sscanf(params,"i",fID))return SCM(playerid,SAMP_WEISS,""IINFO" /afrangs [FraktionsID]");
	if(fID<1||fID>18)return SCM(playerid,SAMP_WEISS,""IINFO" /afrangs [FraktionsID 1-18]");
	format(string,sizeof(string),"%s\nRang | Rangname\n\n0 | %s\n1 | %s\n2 | %s\n3 | %s\n4 | %s\n5 | %s\n6 | %s",
	FraktionsName(fID),frank0[fID],frank1[fID],frank2[fID],frank3[fID],frank4[fID],frank5[fID],frank6[fID]);
    ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"Fraktionsrangnamen",string,"Verlassen","");
	return 1;
}

COMMAND:aflimit(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[256],fID,limit;
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	if(sscanf(params,"ii",fID,limit))return SCM(playerid,SAMP_WEISS,""IINFO" /aflimit [FraktionsID] [Limit]");
	if(fID<1||fID>18)return SCM(playerid,SAMP_WEISS,""IINFO" /aflimit [FraktionsID 1-18] [Limit]");
    fverwaltungen[Spieler[playerid][pFraktion]][FrakLimit] = limit;
    format(string,sizeof(string),"%s %s hat das Memberlimit der Fraktion %s auf %d gesetzt!",Adminrang(playerid),SpielerName(playerid),FraktionsName(fID),fverwaltungen[Spieler[playerid][pFraktion]][FrakLimit]);
    SendAdminMessage(GELB,string);
    SendFraktionsMessage(fID,SAMP_WEISS,string);
	return 1;
}

COMMAND:fverwaltung(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		return ShowPlayerDialog(playerid,DIALOG_FVERWALTUNG,DIALOG_STYLE_LIST,""ClanTagDialoge" Fraktionsverwaltung",""#HTML_BLAU"1."#HTML_WEISS" Fraktionswaffen\n"#HTML_BLAU"2."#HTML_WEISS" Fraktion Heal\n"#HTML_BLAU"3."#HTML_WEISS" Fraktion Rüstung","Auswählen","Abbrechen");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:porten(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[1800];
	if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
	for(new i=0;i<sizeof(APorten);i++)
	{
    	if(isPlayerAnAdmin(playerid,APorten[i][APortAlevel])) strcat(string,APorten[i][Portname]); strcat(string,"\n");
	}
	ShowPlayerDialog(playerid,DIALOG_APORTEN,DIALOG_STYLE_LIST,"Porten...",string,"Porten","Abbrechen");
	return 1;
}
COMMAND:bank_3(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!IsPlayerInRangeOfPoint(playerid,2,1106.6384,1529.5654,4452.4810))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Bank of San Andreas.");
 	if(Spieler[playerid][pTalkwithBankbitch] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du redest bereits mit der Bankangestellten.");
    //SCM(playerid,SAMP_WEISS,""#HTML_BLAU"[Schantal]:"#HTML_WEISS" Herzlich Willkommen in der Bank of San Andreas.");
    //SCM(playerid,SAMP_WEISS,""#HTML_BLAU"[Schantal]:"#HTML_WEISS" Um Überweisungen durchführen zu können benutzen Sie '/weisung' | '/fraktueberweisung'.");
	PlayerPlaySound(playerid,8002,0.0,0.0,0.0);
	ShowPlayerBankMenu(playerid);
	return 1;
}
COMMAND:safe(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!IsPlayerInRangeOfPoint(playerid,2,1103.0515,1529.5653,4452.4810) && GetPlayerVirtualWorld(playerid) != 0)return SCM(playerid,SAMP_WEISS,"Nicht in der Bank of San Andreas.");
 	if(Spieler[playerid][pBankSafeSafe] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Bankschließfach.");
 	ShowSafeMenu(playerid);
	return 1;
}
COMMAND:bankpin(playerid,const params[])
{
    #pragma unused params
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(Spieler[playerid][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Konto bei der Bank of San Andreas.");
    if(Spieler[playerid][pWrongBankPinEntry] >= 3)
	{
		SCM(playerid,SAMP_WEISS,"Ihr Bankkonto wurde gesperrt,da Sie Ihren Bank-Pin 3 mal falsch eingegeben haben.");
		return SCM(playerid,SAMP_WEISS,"Lasse dein Bankkonto in der Bank of San Andreas entsperren um dein Konto wieder verwalten zu können. Dort wird Ihnen dan ein neuer Pin zugestellt.");
	}
	new string[64];
	format(string,sizeof(string),"Dein Bankpin: %i",Spieler[playerid][pBankPin]);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:bankmenu(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new nearestatm = ReturnATMID(playerid);
    if(nearestatm == -1)return SCM(playerid,SAMP_WEISS,"An keinem Bankautomaten.");
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst vom Fahrzeug aus auf keine Bankautomaten zugreifen.");
    if(Spieler[playerid][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Konto bei der Bank of San Andreas.");
	if(ATMInfo[nearestatm][EGmBhHp] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Bankautomat ist defekt,rufe einen Elektroniker!");
    if(Spieler[playerid][pWrongBankPinEntry] >= 3)
	{
		SCM(playerid,SAMP_WEISS,""IINFO" Ihr Bankkonto wurde soeben gesperrt,da du 3 mal den Bank-Pin falsch eingegeben hast.");
		return SCM(playerid,SAMP_WEISS,""IINFO" Lasse dein Bankkonto in der Bank of San Andreas entsperren um dein Konto wieder verwalten zu können. Dort wird Ihnen dan ein neuer Pin zugestellt.");
	}
	ShowPlayerDialog(playerid,DIALOG_BANK_PINENTRY,DIALOG_STYLE_PASSWORD,""ClanTagDialoge" ATM",""#HTML_WEISS"Geben Sie Ihren gültigen "IINFO2"Bank-Pin"#HTML_WEISS" ein,um extern auf ihr Bankkonto zugreifen zu können.","Absenden","Abbrechen");
	return 1;
}
COMMAND:weisung(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,menge,gebuer,string[128];
    if(!IsPlayerInRangeOfPoint(playerid,2,1106.6384,1529.5654,4452.4810) && GetPlayerVirtualWorld(playerid) != 0)return SCM(playerid,SAMP_WEISS,"Nicht in der Bank of San Andreas.");
    if(Spieler[playerid][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Konto bei der Bank of San Andreas.");
	if(sscanf(params,"ui",pID,menge))return SCM(playerid,SAMP_WEISS,""IINFO" /weisung [playerid/Name][Betrag]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie können sich selbst kein Geld überweisen.");
    if(Spieler[pID][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Dieser Spieler besitzt kein Konto bei der Bank of San Andreas.");
	if(menge<=0)return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie müssen schon einen Betrag angeben.");
	if(GetPlayerLevel(playerid) <= ENABLE_KILLORPAY_BYLEVEL)
	{
		if(menge>500)
		{
			format(string,sizeof(string),"ACHTUNG: Du kannst mit Level %i nicht mehr als 500$ ausgeben!",GetPlayerLevel(playerid));
			return SCM(playerid,SAMP_WEISS,string);
		}
	}
	if((Spieler[playerid][pBank] - menge) < 0)return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie haben nicht genug Geld auf ihrem Bankkonto.");
    format(string,sizeof(string),"Überweisung -- Spieler: %s User: %s * Betrag: %i",Spieler[playerid][pName],Spieler[pID][pName],menge);
	Log("Ueberweisungssql",string);
    SCM(playerid,SAMP_WEISS,"|___KONTOSTAND___|");
    format(string,sizeof(string),"Alter Kontostand: %i$",Spieler[playerid][pBank]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"Überweisung an %s: %i$",SpielerName(pID),menge);
	SCM(playerid,SAMP_WEISS,string);
	if(menge >= 50000)
	{
		gebuer = menge/1000;
		format(string,sizeof(string),"Überweisungsgebühr: %i$",floatround(gebuer));
		SCM(playerid,SAMP_WEISS,string);
		Spieler[playerid][pBank] -= floatround(gebuer);
		fverwaltungen[16][Geld] -= floatround(gebuer);
	}
	Spieler[playerid][pBank] -= menge;
	SCM(playerid,SAMP_WEISS,"|-----------|");
	format(string,sizeof(string),"Neuer Kontostand: %i$",Spieler[playerid][pBank]);
	SCM(playerid,SAMP_WEISS,string);
	Spieler[pID][pBank] += menge;
    format(string,sizeof(string),"%s hat dir gerade %i$ überwiesen! Bankkonto: %i$",SpielerName(playerid),menge,Spieler[pID][pBank]);
    SCM(pID,WEISS,string);
    SaveAccount(playerid);
	SaveAccount(pID);
	SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Für weiter Transaktionen stehen wir Ihnen zu verfügung,ihre Bank of San Andreas.");
	ApplyAnimation(GetPlayerID("[BOT]Bank"),"PED","IDLE_CHAT",4.0,false,false,false,false,0,SYNC_ALL);
	return 1;
}
COMMAND:fraktueberweisung(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new fID,menge,gebuer,string[128];
    if(!IsPlayerInRangeOfPoint(playerid,2,1106.6384,1529.5654,4452.4810) && GetPlayerVirtualWorld(playerid) != 0)return SCM(playerid,SAMP_WEISS,"Nicht in der Bank of San Andreas.");
    if(Spieler[playerid][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Konto bei der Bank of San Andreas.");
	if(Spieler[playerid][pTalkwithBankbitch] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du redest nicht mit der Bankangestellten.");
	gettime(stunde);
	if(stunde<12||stunde>18)return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Man kann Fraktionskassen Überweisungen nur zwischen 12:00 Uhr Mittags und 18:00 Uhr Abends vollziehen.");
	if(sscanf(params,"ii",fID,menge))return SCM(playerid,SAMP_WEISS,""IINFO" /fraktueberweisung [FraktionsID][Betrag]");
	if(menge<=0)return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Bitte geben Sie einen gueltigen Betrag an.");
	if((Spieler[playerid][pBank] - menge) < 0)return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie haben nicht genug Geld auf ihrem Bankkonto.");
    if(fID == 4 || fID == 5 || fID == 7 || fID == 8 || fID == 9 || fID == 10 || fID == 12 || fID == 13 || fID == 15 || fID == 16 || fID == 17)
	{
		format(string,sizeof(string),"Überweisung -- Spieler: %s * ZielPerson(Fraktion): %s * Betrag: %i",Spieler[playerid][pName],FraktionsName(fID),menge);
		Log("Ueberweisungssql",string);
	    SCM(playerid,SAMP_WEISS,"|___KONTOSTAND___|");
	    format(string,sizeof(string),"Alter Kontostand: %i$",Spieler[playerid][pBank]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Überweisung an Fraktion %s: %i$",FraktionsName(fID),menge);
		SCM(playerid,SAMP_WEISS,string);
		if(menge >= 25000)
		{
			gebuer = menge/50;
			format(string,sizeof(string),"Überweisungsgebühr: %i$",floatround(gebuer));
			SCM(playerid,SAMP_WEISS,string);
			Spieler[playerid][pBank] -= floatround(gebuer);
			fverwaltungen[16][Geld] -= floatround(gebuer);
		}
		Spieler[playerid][pBank] -= menge;
		SCM(playerid,SAMP_WEISS,"|-----------|");
		format(string,sizeof(string),"Neuer Kontostand: %i$",Spieler[playerid][pBank]);
		SCM(playerid,SAMP_WEISS,string);
		fverwaltungen[fID][Geld] += menge;
		format(string,sizeof(string),"%s -- GELD Fkassenstand(nach Überweisung): %i | Spieler: %s * Einzahlung: %i | Fkassenstand(nach Überweisung): %i",FraktionsName(fID),fverwaltungen[fID][Geld]-menge,Spieler[playerid][pName],menge,fverwaltungen[fID][Geld]);
		Log("Fkassensqllog",string);
		format(string,sizeof(string),"%s hat euch %i$ überwiesen! Fraktionkassenstand(Geld): %i$",SpielerName(playerid),menge,fverwaltungen[fID][Geld]);
	    SendFraktionsMessage(fID,FMELDUNG,string);
	    ApplyAnimation(GetPlayerID("[BOT]Bank"),"PED","IDLE_CHAT",4.0,false,false,false,false,0,SYNC_ALL);
		SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Für weiter Transaktionen stehen wir Ihnen zu verfügung,ihre Bank of San Andreas.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,"Angegebene Fraktion besitzt keine Fraktionsbank.(/fraktionen)");
}
COMMAND:saveme(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(gettime() < Spieler[playerid][pSavePlayerCmd])
	{
		new time = Spieler[playerid][pSavePlayerCmd] - gettime(),string[128];
		format(string,sizeof(string),""IINFO" du kannst deinen Spielstand erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten speichern.",time/60,time%60);
		return SCM(playerid,SAMP_WEISS,string);
	}
	Spieler[playerid][pSavePlayerCmd] = gettime() + (60*2);
	SCM(playerid,SAMP_WEISS,""IINFO" dein Spielstand wurde erfolgreich gespeichert.");
	SaveAccount(playerid);
	return 1;
}
COMMAND:gangfight(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new fID,string[128];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID] != 0)return SCM(playerid,SAMP_WEISS,"Deine Fraktion ist berreits in einem Gangfight vertreten.");
	    if(sscanf(params,"i",fID))return SCM(playerid,SAMP_WEISS,""IINFO" /ganfight [FraktionsID]");
	    if(fID == 4 || fID == 5 || fID == 7 || fID == 9 || fID == 12 || fID == 13 || fID == 17)
		{
			if(fverwaltungen[fID][GangFightfID] != 0)return SCM(playerid,SAMP_WEISS,"Die angegebene Fraktion ist bereits in einem Gangfight vertreten.");
			format(string,sizeof(string),"%s hat ein Gangfight mit der Fraktion %s gestartet.",Spieler[playerid][pName],FraktionsName(fID));
		    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
		    format(string,sizeof(string),"Die Fraktion %s hat ein Gangfight mit eurer Fraktion gestartet.",FraktionsName(Spieler[playerid][pFraktion]));
		    SendFraktionsMessage(fID,FMELDUNG,string);
		    fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID] = fID;
		    fverwaltungen[Spieler[playerid][pFraktion]][GangFightOwner] = Spieler[playerid][pFraktion];
		    fverwaltungen[Spieler[playerid][pFraktion]][GangFightKills] = 0;
		    fverwaltungen[Spieler[playerid][pFraktion]][GangFightDeaths] = 0;
		    fverwaltungen[fID][GangFightfID] = Spieler[playerid][pFraktion];
		    fverwaltungen[fID][GangFightOwner] = Spieler[playerid][pFraktion];
		    fverwaltungen[fID][GangFightKills] = 0;
		    fverwaltungen[fID][GangFightDeaths] = 0;
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,"Angegebene Fraktion besitzt keine Fraktionsbank.(/fraktionen)");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:stopgangfight(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(fverwaltungen[Spieler[playerid][pFraktion]][GangFightOwner] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,"Deine Fraktion ist nicht der Herrausforderer.");
	    format(string,sizeof(string),"%s hat den Gangfight mit der Fraktion %s beendet.",Spieler[playerid][pName],FraktionsName(fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]));
	    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	    format(string,sizeof(string),"Entstand: %s: %i Morde,%i Tode | %s: %i Morde,%i Tode",
	    FraktionsName(Spieler[playerid][pFraktion]),fverwaltungen[Spieler[playerid][pFraktion]][GangFightKills],fverwaltungen[Spieler[playerid][pFraktion]][GangFightDeaths],FraktionsName(fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]),fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightKills],fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightDeaths]);
	    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	    format(string,sizeof(string),"Die Fraktion %s den das Gangfight beendet.",FraktionsName(Spieler[playerid][pFraktion]));
	    SendFraktionsMessage(fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID],FMELDUNG,string);
	    format(string,sizeof(string),"Entstand: %s: %i Morde,%i Tode | %s: %i Morde,%i Tode",
		FraktionsName(Spieler[playerid][pFraktion]),fverwaltungen[Spieler[playerid][pFraktion]][GangFightKills],fverwaltungen[Spieler[playerid][pFraktion]][GangFightDeaths],FraktionsName(fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]),fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightKills],fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightDeaths]);
	    SendFraktionsMessage(fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID],FMELDUNG,string);
	    fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightfID] = 0;
	    fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightOwner] = 0;
	    fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightKills] = 0;
	    fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightDeaths] = 0;
	    fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID] = 0;
	    fverwaltungen[Spieler[playerid][pFraktion]][GangFightOwner] = 0;
	    fverwaltungen[Spieler[playerid][pFraktion]][GangFightKills] = 0;
	    fverwaltungen[Spieler[playerid][pFraktion]][GangFightDeaths] = 0;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:gangfightinfo(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
	    if(fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID] == 0)return SCM(playerid,SAMP_WEISS,"Deine Fraktion ist in keinem Gangfight vertreten.");
	    format(string,sizeof(string),"|______ Gangfight gegen %s ______|",FraktionsName(fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]));
	    SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s: %i Morde,%i Tode",FraktionsName(Spieler[playerid][pFraktion]),fverwaltungen[Spieler[playerid][pFraktion]][GangFightKills],fverwaltungen[Spieler[playerid][pFraktion]][GangFightDeaths]);
	    SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"%s: %i Morde,%i Tode",FraktionsName(fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]),fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightKills],fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][GangFightfID]][GangFightDeaths]);
	    SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:jtmenu(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
