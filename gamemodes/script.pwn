stock SetDrunkLevel(playerid,drunklevel)
{
	SetPlayerDrunkLevel(playerid,drunklevel);
	if(GetPlayerDrunkLevel(playerid) >= 32000)
	{
		SetPlayerACHealth(playerid,0.0);
		SCM(playerid,SAMP_WEISS,"Dein Rausch von Alkohol/Drogen war so hoch das du ins Komma fällst.");
	}
	return 1;
}


stock GiveWeapon(playerid,waffe,munition,bool:saveguns)
{
    new slot = Script_GetWeaponSlot(waffe);
    if(slot<0||slot>12)return 1;
    Spieler[playerid][pAcPause][AC_WEAPONPAUSE] = gettime() + 10;
	Spieler[playerid][pAnticheatWeap][slot] = waffe,Spieler[playerid][pAnticheatWeapAmmo][slot] += munition,GivePlayerWeapon(playerid,WEAPON:waffe,munition);
    if(saveguns == true)
    {
	    Spieler[playerid][pPlayerWeapon][slot] = WEAPON:waffe;
		Spieler[playerid][pPlayerWeaponAmmo][slot] = munition;
    }
    return waffe;
}

stock ResetWeapons(playerid,bool:saveguns)
{
    Spieler[playerid][pAcPause][AC_WEAPONPAUSE] = gettime() + 5;
    ResetPlayerWeapons(playerid);
	for(new slot=0;slot<13;slot++)
	{
		Spieler[playerid][pAnticheatWeap][slot] = 0;
		Spieler[playerid][pAnticheatWeapAmmo][slot] = 0;
	}
	if(saveguns == true)
	{
		for(new slot=0;slot<13;slot++)
		{
			Spieler[playerid][pPlayerWeapon][slot] = WEAPON_FIST;
			Spieler[playerid][pPlayerWeaponAmmo][slot] = 0;
		}
	}
    return 1;
}

stock Script_RemovePlayerWeapon(playerid,weaponid)
{
	new WEAPON:plyWeapons[13],plyAmmo[13] = 0;
	for(new sslot=0;sslot<13;sslot++)
	{
		new WEAPON:wep,ammo;
		GetPlayerWeaponData(playerid,WEAPON_SLOT:sslot,wep,ammo);
		if(wep != WEAPON:weaponid && ammo != 0) GetPlayerWeaponData(playerid,WEAPON_SLOT:sslot,plyWeapons[sslot],plyAmmo[sslot]);
	}
	ResetWeapons(playerid,true);
	for(new sslot=0;sslot<13;sslot++) if(plyAmmo[sslot] != 0) GiveWeapon(playerid,plyWeapons[sslot],plyAmmo[sslot],true);
	return 1;
}

stock CreateDroppedGun(playerid,GunID,GunAmmo,Float:gPosX,Float:gPosY,Float:gPosZ)
{
	new f = MAX_WAFFENDROP+1;
	if(IsWeaponEnable(GunID) == 1 && GunID != 0 && GetPlayerState(playerid) == PLAYER_STATE_SPAWNED)
	{
		Script_RemovePlayerWeapon(playerid,GunID);
		return SCM(playerid,SAMP_WEISS,""ACINFO" Eine von deinen Waffen wird vom System als unangemessen empfunden!");
 	}
    for(new a=0;a<MAX_WAFFENDROP;a++)
    {
	    if(dGunData[a][ObjPos][0] == 0.0)
	    {
		    f = a;
		    break;
	    }
    }
    if(f > MAX_WAFFENDROP)return 1;
    dGunData[f][ObjData][0] = GunID;
	dGunData[f][ObjData][1] = GunAmmo;
	dGunData[f][ObjPos][0] = gPosX;
	dGunData[f][ObjPos][1] = gPosY;
	dGunData[f][ObjPos][2] = gPosZ;
	dGunData[f][ObjID] = CreateDynamicObject(GunObjects[GunID],dGunData[f][ObjPos][0],dGunData[f][ObjPos][1],dGunData[f][ObjPos][2]-1,93.7,120.0,random(360));
	return 1;
}
stock CreateOfflineInfo(playerid)
{
	new string[256];
	for(new oi=1;oi<MAX_OFFLINEPICKUPS;oi++)
	{
	    if(OfflineInfo[oi][Ocreated] == false)
	    {
	        OfflineInfo[oi][Ocreated] = true;
	        GetPlayerPos(playerid,OfflineInfo[oi][Opos][0],OfflineInfo[oi][Opos][1],OfflineInfo[oi][Opos][2]);
	        OfflineInfo[oi][Ovirtualworld] = GetPlayerVirtualWorld(playerid);
	        strmid(OfflineInfo[oi][Oname],Spieler[playerid][pName],0,strlen(Spieler[playerid][pName]),24);
	        OfflineInfo[oi][Owanteds] = Spieler[playerid][pWantedPoints];
	        OfflineInfo[oi][Odeletetime] = gettime() + (60);
			OfflineInfo[oi][Opickup] = CreatePickup(1277,0,OfflineInfo[oi][Opos][0],OfflineInfo[oi][Opos][1],OfflineInfo[oi][Opos][2],OfflineInfo[oi][Ovirtualworld]);
			new time = OfflineInfo[oi][Odeletetime] - gettime();
			format(string,sizeof(string),""#HTML_WHITE"Offline Information\n"#HTML_BLAU"Name"#HTML_WHITE": %s\n"#HTML_BLAU"Wantedpunkte"#HTML_WHITE": %i\n"#HTML_BLAU"Offlinezeit"#HTML_WHITE": "IINFO2"%i:%02d"#HTML_WEISS" Minuten",OfflineInfo[oi][Oname],OfflineInfo[oi][Owanteds],time/60,time%60);
			OfflineInfo3Dtext[oi] = CreateDynamic3DTextLabel(string,WEISS,OfflineInfo[oi][Opos][0],OfflineInfo[oi][Opos][1],OfflineInfo[oi][Opos][2],15.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,OfflineInfo[oi][Ovirtualworld]);
		    return 1;
		}
	}
	return 0;
}
stock CheckPlayerOfflineInfo(playerid)
{
    for(new oi=1;oi<MAX_OFFLINEPICKUPS;oi++)
	{
	    if(OfflineInfo[oi][Ocreated] == true)
	    {
	        if(!strcmp(SpielerName(playerid),OfflineInfo[oi][Oname],true))
			{
			    if(gettime() < OfflineInfo[oi][Odeletetime])return oi;
			}
		}
	}
	return -1;
}
stock DeleteOfflineInfo(oi)
{
    if(OfflineInfo[oi][Ocreated] == false)return 1;
    OfflineInfo[oi][Opos][0] = 0;
	OfflineInfo[oi][Opos][1] = 0;
	OfflineInfo[oi][Opos][2] = 0;
	OfflineInfo[oi][Ovirtualworld] = 0;
    strmid(OfflineInfo[oi][Oname],"Niemand",0,strlen("Niemand"),24);
    OfflineInfo[oi][Owanteds] = 0;
    OfflineInfo[oi][Odeletetime] = 0;
    DestroyPickup(OfflineInfo[oi][Opickup]);
    DestroyDynamic3DTextLabel(OfflineInfo3Dtext[oi]);
    OfflineInfo[oi][Ocreated] = false;
	return 1;
}

