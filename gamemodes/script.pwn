		{
			cache_get_field_content(0,"Name",ppname);
			cache_get_field_content(0,"PropertyClearTime",result);
			zeit = strval(result);
			if(!strcmp(ppname,HausInfo[extraid][haus_besitzer],true) && gettime() > zeit)
			{
		    DestroyDynamicPickup(HausInfo[extraid][haus_pickup]);
			HausInfo[extraid][haus_Owned] = 0;
			HausInfo[extraid][haus_eingemitetenzaehler] = 0;
			HausInfo[extraid][haus_locked] = 0;
			strmid(HausInfo[extraid][haus_besitzer],"Niemand",0,strlen("Niemand"),24);
			strmid(HausInfo[extraid][haus_beschreibung],"Keine",0,strlen("Keine"),150);
			strmid(HausInfo[extraid][haus_msg],"Keine",0,strlen("Keine"),150);
			UpdateHausLabel(extraid,1);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
		    HausInfo[extraid][haus_pickup] = CreateDynamicPickup(Server_Haus_Frei_Pickup,1,HausInfo[extraid][haus_x],HausInfo[extraid][haus_y],HausInfo[extraid][haus_z],0);
		    SaveOnlyOneHaus(extraid);
