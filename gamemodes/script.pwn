			{
				MotorDown[Leichenwagen[i]] = 0;
				vFahrzeug[Leichenwagen[i]][FailGas] = 0;
				vFahrzeug[Leichenwagen[i]][Tank] = VehicleInfo[GetVehicleModel(Leichenwagen[i])-400][vtankvolumen];
				SetVehicleToRespawn(Leichenwagen[i]);
