stock GiveHandy(playerid)
{
	switch(Spieler[playerid][pHandy])
	{
		case 1: SetPlayerAttachedObject(playerid,8,18866,6,0.106000,-0.019000,0.028000,85.300003,-175.599975,-3.300000,1.000000,1.000000,1.000000);
		case 2: SetPlayerAttachedObject(playerid,8,18871,6,0.106000,-0.019000,0.028000,85.300003,-175.599975,-3.300000,1.000000,1.000000,1.000000);
		case 3: SetPlayerAttachedObject(playerid,8,18872,6,0.106000,-0.019000,0.028000,85.300003,-175.599975,-3.300000,1.000000,1.000000,1.000000);
		case 4: SetPlayerAttachedObject(playerid,8,18870,6,0.106000,-0.019000,0.028000,85.300003,-175.599975,-3.300000,1.000000,1.000000,1.000000);
	}
	return 1;
}
stock UpdateFbase3DText(i)
{
	if(Fraktionsbase[i][fbaselocked] == 1)
	{
		format(GlobalString,sizeof(GlobalString),""#HTML_WEISS"[ "#IINFO2"Tür Eingang"#HTML_WEISS" ]\nFraktion: "IINFO2"%s"#HTML_WEISS"\nVerwendung\nTaste: "IINFO2"F"#HTML_WEISS"\nStatus: "HTML_ROT"Abgeschlossen",Fraktionsbase[i][fbase3DText]);
		UpdateDynamic3DTextLabelText(Fraktionsbase3DText[i][0],SAMP_WEISS,GlobalString);
		format(GlobalString,sizeof(GlobalString),""#HTML_WEISS"[ "#IINFO2"Tür Ausgang"#HTML_WEISS" ]\nFraktion: "IINFO2"%s"#HTML_WEISS"\nVerwendung\nTaste: "IINFO2"F"#HTML_WEISS"\nStatus: "HTML_ROT"Abgeschlossen",Fraktionsbase[i][fbase3DText]);
		UpdateDynamic3DTextLabelText(Fraktionsbase3DText[i][1],SAMP_WEISS,GlobalString);
	}
	else
	{
		format(GlobalString,sizeof(GlobalString),""#HTML_WEISS"[ "#IINFO2"Tür Eingang"#HTML_WEISS" ]\nFraktion: "IINFO2"%s"#HTML_WEISS"\nVerwendung\nTaste: "IINFO2"F"#HTML_WEISS"\nStatus: "HTML_GRUEN"Aufgeschlossen",Fraktionsbase[i][fbase3DText]);
		UpdateDynamic3DTextLabelText(Fraktionsbase3DText[i][0],SAMP_WEISS,GlobalString);
		format(GlobalString,sizeof(GlobalString),""#HTML_WEISS"[ "#IINFO2"Tür Ausgang"#HTML_WEISS" ]\nFraktion: "IINFO2"%s"#HTML_WEISS"\nVerwendung\nTaste: "IINFO2"F"#HTML_WEISS"\nStatus: "HTML_GRUEN"Aufgeschlossen",Fraktionsbase[i][fbase3DText]);
		UpdateDynamic3DTextLabelText(Fraktionsbase3DText[i][1],SAMP_WEISS,GlobalString);
	}
	return 1;
}
stock GetFraktionSmarkCount(fID)
{
	new count = 0;
	for(new sm=1;sm<MAX_SMARKETS;sm++)
	{
		if(SmarkInfo[sm][screatet] == 1)
		{
			if(SmarkInfo[sm][sfraktid] == fID || SmarkInfo[sm][sbdfraktid] == fID)
			count++;
		}
	}
	return count;
}
