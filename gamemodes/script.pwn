COMMAND:setflyorder(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,command[15],cmd[6],string[128];
    if(!isPlayerInFrakt(playerid,6))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
    if(sscanf(params,"us[6]s[15]",pID,cmd,command))return SCM(playerid,SAMP_WEISS,""IINFO" /setflyorder [playerid/Name][Give/Take][Flugzeug/Helikopter]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler nicht in deiner Fraktion.");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(strcmp(cmd,"Give",true) == 0)
	{
		if(strcmp(command,"Flugzeug",true) == 0)
		{
			if(Spieler[pID][pArmyPlaneOrder] == 1)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits eine Flugberechtigung (Flugzeug).");
			Spieler[pID][pArmyPlaneOrder] = 1;
			format(string,sizeof(string),""IINFO" du hast %s die Flugberechtigung (Flugzeug) zugewiesen.",SpielerName(pID));
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s hat dir die Flugberechtigung (Flugzeug) zugewiesen.",SpielerName(playerid));
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"%s %s hat %s die Flugberechtigung (Flugzeug) zugewiesen.",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
		    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
			return 1;
		}
		if(strcmp(command,"Helikopter",true) == 0)
		{
			if(Spieler[pID][pArmyHeliOrder] == 1)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits eine Flugberechtigung (Helikopter).");
			Spieler[pID][pArmyHeliOrder] = 1;
			format(string,sizeof(string),""IINFO" du hast %s die Flugberechtigung (Helikopter) zugewiesen.",SpielerName(pID));
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s hat dir die Flugberechtigung (Helikopter) zugewiesen.",SpielerName(playerid));
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"%s %s hat %s die Flugberechtigung (Helikopter) zugewiesen.",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
		    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" /setflyorder [playerid/Name][Give][Flugzeug/Helikopter]");
	}
	if(strcmp(cmd,"Take",true) == 0)
	{
	    if(strcmp(command,"Flugzeug",true) == 0)
		{
			if(Spieler[pID][pArmyPlaneOrder] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt keine Flugberechtigung (Flugzeug).");
			Spieler[pID][pArmyPlaneOrder] = 0;
			format(string,sizeof(string),""IINFO" du hast %s die Flugberechtigung (Flugzeug) abgenommen.",SpielerName(pID));
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s hat dir die Flugberechtigung (Flugzeug) abgenommen.",SpielerName(playerid));
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"%s %s hat %s die Flugberechtigung (Flugzeug) abgenommen.",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
		    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
			return 1;
		}
		if(strcmp(command,"Helikopter",true) == 0)
		{
			if(Spieler[pID][pArmyHeliOrder] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt keine Flugberechtigung (Helikopter).");
			Spieler[pID][pArmyHeliOrder] = 0;
			format(string,sizeof(string),""IINFO" du hast %s die Flugberechtigung (Helikopter) abgenommen.",SpielerName(pID));
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s hat dir die Flugberechtigung (Helikopter) abgenommen.",SpielerName(playerid));
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"%s %s hat %s die Flugberechtigung (Helikopter) abgenommen.",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
		    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" /setflyorder [playerid/Name][Take][Flugzeug/Helikopter]");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /setflyorder [playerid/Name][Give/Take][Flugzeug/Helikopter]");
}

COMMAND:setgwdnote(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,Menge,string[128];
    if(!isPlayerInFrakt(playerid,6))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
    if(sscanf(params,"ui",pID,Menge))return SCM(playerid,SAMP_WEISS,""IINFO" /setgwdnote [playerid/Name][Note]");
    if(Menge<0||Menge>6)return SCM(playerid,SAMP_WEISS,""IINFO" /setgwdnote [playerid/Name][Note 0-6]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler nicht in deiner Fraktion.");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	Spieler[pID][pGrundwehrdienst] = Menge;
	format(string,sizeof(string),""IINFO" du hast %s die Grundwehrdienstnote %i zugewiesen.",SpielerName(pID),Menge);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s hat dir die Grundwehrdienstnote %i zugewiesen.",SpielerName(playerid),Menge);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),"%s %s hat %s die Grundwehrdienstnote %i zugewiesen.",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID),Menge);
    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	return 1;
}

COMMAND:setzivinote(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,Menge,string[128];
    if(!isPlayerInFrakt(playerid,3))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
    if(sscanf(params,"ui",pID,Menge))return SCM(playerid,SAMP_WEISS,""IINFO" /setzivinote [playerid/Name][Note]");
    if(Menge< 0||Menge>10)return SCM(playerid,SAMP_WEISS,""IINFO" /setzivinote [playerid/Name][Note 0-10]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler nicht in deiner Fraktion.");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	Spieler[pID][pZiviNote] = Menge;
	format(string,sizeof(string),""IINFO" du hast %s die Zivildienstnote %i zugewiesen.",SpielerName(pID),Menge);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s hat dir die Zivildienstnote %i zugewiesen.",SpielerName(playerid),Menge);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),"%s %s hat %s die Zivildienstnote %i zugewiesen.",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID),Menge);
    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	return 1;
}

COMMAND:show(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,cmd[30],string[128];
	if(sscanf(params,"s[30]u",cmd,pID))return SCM(playerid,SAMP_WEISS,""IINFO" /show [Finanzen/Lizensen/Perso/Visitenkarte/Marke/Presseausweis][playerid/Name]");
	if(pID == playerid) return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir deine Lizensen nicht selber zeigen.");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(strcmp(cmd,"Finanzen",true) == 0)
   	{
	   	format(string,sizeof(string),"|_______Finanzen von %s_______|",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"Geld dabei %i$",GetACMoney(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"Auf dem Bank-Konto %i$",Spieler[playerid][pBank]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du zeigst %s deine Finanzen.",SpielerName(pID));
		SCM(playerid,WEISS,string);
		format(string,sizeof(string),"** %s zeigt %s seine Finanzen **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	if(strcmp(cmd,"Marke",true) == 0)
   	{
	   	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,16))
		{
		   	new status[50];
		    switch(Spieler[playerid][pDuty])
			{
				case 0:{status="{FFFFFF}Offduty{C9C9C9}";}
				case 1:{status="{FFFF00}Onduty{C9C9C9}";}
				case 2:{status="{FFFF00}Onduty{C9C9C9}";}
				default:{status="ERROR";}
			}
		   	format(string,sizeof(string),"|_______Dienstmarke von %s_______|",SpielerName(playerid));
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"{C9C9C9}Name: %s    Fraktion: %s    Rang: %s[%i]",
			SpielerName(playerid),FraktionsName(Spieler[playerid][pFraktion]),SpielerFraktionsRangName(playerid),Spieler[playerid][pFraktRang]);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"{C9C9C9}Grundwehrdienstnote: %i	Zivildienstnote: %i    Status: %s",
			Spieler[playerid][pGrundwehrdienst],Spieler[playerid][pZiviNote],status);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du zeigst %s deine Dienstmarke.",SpielerName(pID));
			SCM(playerid,WEISS,string);
			format(string,sizeof(string),"** %s zeigt %s seine Dienstmarke **",SpielerName(playerid),SpielerName(pID));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	}
	if(strcmp(cmd,"Visitenkarte",true) == 0)
   	{
	   	format(string,sizeof(string),"|_______Visitenkarte von %s_______|",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"Name: %s    Level: %i    Telefonnummer: %i",SpielerName(playerid),GetPlayerLevel(playerid),Spieler[playerid][pPhonenumber]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du zeigst %s deine Visitenkarte.",SpielerName(pID));
		SCM(playerid,WEISS,string);
		format(string,sizeof(string),"** %s zeigt %s seine Visitenkarte **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	if(strcmp(cmd,"Perso",true) == 0)
   	{
	   	format(string,sizeof(string),"|_______Personalausweis von %s_______|",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"Name: %s  Alter: %i  Fraktion: %s  Job: %s",SpielerName(playerid),AgeOfPlayer(playerid),FraktionsName(Spieler[playerid][pFraktion]),SpielerJob(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du zeigst %s deinen Personalausweis **",SpielerName(pID));
		SCM(playerid,WEISS,string);
		format(string,sizeof(string),"** %s zeigt %s seinen Personalausweis **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	if(strcmp(cmd,"Lizensen",true) == 0)
	{
		ShowLicenses(playerid,pID);
		format(string,sizeof(string),""IINFO" du zeigst %s deine Lizensen.",SpielerName(pID));
		SCM(playerid,WEISS,string);
		format(string,sizeof(string),"** %s zeigt %s seine Lizensen **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	if(strcmp(cmd,"Presseausweis",true) == 0)
	{
		if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	    SCM(pID,SAMP_WEISS,"|__Presseausweis__|");
		format(string,sizeof(string),"%s",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"%s | %s",FraktionsName(Spieler[playerid][pFraktion]),SpielerFraktionsRangName(playerid));
		SCM(pID,SAMP_WEISS,string);
		SCM(pID,SAMP_WEISS,"|__________________|");
		format(string,sizeof(string),""IINFO" du zeigst %s deinen Presseausweis.",SpielerName(pID));
		SCM(playerid,WEISS,string);
		format(string,sizeof(string),"** %s zeigt %s seinen Presseausweis **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
    return SCM(playerid,SAMP_WEISS,""IINFO" /show [Finanzen/Lizensen/Perso/Visitenkarte/Marke/Presseausweis][playerid/Name]");
}

COMMAND:awiederbeleben_3(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /awiederbeleben [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[playerid][pAdmin] == 1 || Spieler[playerid][pAdmin] == 2)
	{
		if(GetPlayerLevel(pID) > 3)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur Level 1´er 2´er oder 3´er wiederbeleben!");
	}
    if(Spieler[pID][pDeath] == 0)return SCM(playerid,SAMP_WEISS,"Spieler muss nicht Reanimiert werden.");
	format(string,sizeof(string),"** %s hat %s reaniemiert(Adminbefehl) **",SpielerName(playerid),SpielerName(pID));
	PlayerTalkPublic(pID,SAMP_PublicChatColor,string,10);
	SetPlayerACHealth(pID,20);
	Spieler[pID][pRevived] = 0;
	Spieler[pID][pInHospital] = 0;
	Spieler[pID][pNextDeath] = 0;
	Spieler[pID][pDeath] = 0;
	Spieler[pID][pFriedhofTime] = 0;
	Spieler[pID][pDeathTime] = 0;
	format(string,sizeof(string),""IINFO" du hast %s wiederbelebt.",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:fverkaufen(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new query[64],string[128],fv = IsAFraktionsVeh(playerid);
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	    if(fv == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
		if(Fahrzeug[fv][Fraktion] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
	 	if(!IsPlayerInRangeOfPoint(playerid,5,-1986.1769,273.2683,35.1794))return SCM(playerid,SAMP_WEISS,"Nicht am Fraktionsautohaus.");
	 	if(Fahrzeug[fv][modelid] >= 400 && Fahrzeug[fv][modelid] <= 611)
	    {
	  	format(string,sizeof(string),""IINFO" du hast das Fahrzeug %s verkauft.",VehicleDefinations[Fahrzeug[fv][modelid]-400]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" der Fahrzeughändler schrieb dir %i$ gut.",Fahrzeug[fv][Preis]/2);
	    SCM(playerid,SAMP_WEISS,string);
	    ACMoney(playerid,Fahrzeug[fv][Preis]/2);
		Fahrzeug[fv][Fraktion] = 0;
		Fahrzeug[fv][FraktionsRang] = 0;
		Fahrzeug[fv][modelid] = -1;
		Fahrzeug[fv][Colour1] = -1;
		Fahrzeug[fv][Colour2] = -1;
		Fahrzeug[fv][Paintjob] = -1;
		Fahrzeug[fv][posx] = -1;
		Fahrzeug[fv][posy] = -1;
		Fahrzeug[fv][posz] = -1;
		Fahrzeug[fv][posa] = -1;
		Fahrzeug[fv][Interior] = 0;
		Fahrzeug[fv][VirtualWorld] = 0;
		Fahrzeug[fv][Abgeschlossen] = 0;
		vFahrzeug[Fahrzeug[fv][Vehicle]][Abgeschleppt] = 0;
		vFahrzeug[Fahrzeug[fv][Vehicle]][AbgeschlepptPreis] = 0;
		Fahrzeug[fv][Spoiler] = 0;
		Fahrzeug[fv][Wheels] = 0;
		Fahrzeug[fv][Nitro] = 0;
		Fahrzeug[fv][Roof] = 0;
		Fahrzeug[fv][Hood] = 0;
		Fahrzeug[fv][Sideskirt] = 0;
		Fahrzeug[fv][Lamps] = 0;
		Fahrzeug[fv][Exhaust] = 0;
		Fahrzeug[fv][Stereo] = 0;
		Fahrzeug[fv][Hydraulics] = 0;
		Fahrzeug[fv][VentRight] = 0;
		Fahrzeug[fv][VentLeft] = 0;
		Fahrzeug[fv][FrontBumper] = 0;
		Fahrzeug[fv][RearBumper] = 0;
		Fahrzeug[fv][Preis] = 0;
		strmid(Fahrzeug[fv][Nummernschild],"-",0,strlen("-"),64);
	    DeleteVehicle(Fahrzeug[fv][Vehicle]);
	    Fahrzeug[fv][Vehicle] = -1;
	    format(query,sizeof(query),"DELETE FROM server_ffahrzeuge WHERE id = '%d'",Fahrzeug[fv][Carkey]);
	   	mysql_function_query(MySQL_R394,query,false,"","");
	    return 1;
	    }
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:ovehlist(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[512],vehiclesspawned = 0;
    if(!isPlayerInFrakt(playerid,11))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    SCM(playerid,SAMP_WEISS,"||__________Abgeschleppte Privatfahrzeuge__________||");
    ForEachPlayer(i)
	{
		for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
			if(IsValidVehicle(Pfahrzeug[slot][i][Vehicle]))
			{
				if(vFahrzeug[Pfahrzeug[slot][i][Vehicle]][Abgeschleppt] == 1)
				{
					vehiclesspawned++;
				    format(string,sizeof(string),"{C9C9C9}%s : Besitzer: %s ID: %i  Freikaufpreis: %i$  Grund: %s",VehicleDefinations[Pfahrzeug[slot][i][modelid]-400],Pfahrzeug[slot][i][Besitzer],Pfahrzeug[slot][i][Vehicle],vFahrzeug[Pfahrzeug[slot][i][Vehicle]][AbgeschlepptPreis],vFahrzeug[Pfahrzeug[slot][i][Vehicle]][AbgeschlepptGrund]);
					SCM(playerid,SAMP_WEISS,string);
				}
			}
		}
	}
	if(vehiclesspawned == 0)return SCM(playerid,SAMP_WEISS,"Keine Vorhanden.");
	return 1;
}

COMMAND:ofvehlist(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[256],status1[30],vehiclesspawned = 0;
    if(!isPlayerInFrakt(playerid,11))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    SCM(playerid,SAMP_WEISS,"||__________Abgeschleppte Fraktionsfahrzeuge__________||");
    for(new fv;fv<MAX_FVEHS;fv++)
    {
		if(vFahrzeug[Fahrzeug[fv][Vehicle]][Abgeschleppt] == 1)
		{
			if(Fahrzeug[fv][Fraktion] != 0)
			{
				vehiclesspawned++;
				switch(Fahrzeug[fv][Abgeschlossen])
				{
					case 0:{status1="{66CD00}Auf{C9C9C9}";}
					case 1:{status1="{FF0000}Zu{C9C9C9}";}
					default:{status1="ERROR";}
				}
			    format(string,sizeof(string),"{C9C9C9}%s : ID: %i Fraktion: %s  Freikaufpreis: %i$  Status: %s  Grund: %s",VehicleDefinations[Fahrzeug[fv][modelid]-400],Fahrzeug[fv][Vehicle],FraktionsName(Fahrzeug[fv][Fraktion]),vFahrzeug[Fahrzeug[fv][Vehicle]][AbgeschlepptPreis],status1,vFahrzeug[Fahrzeug[fv][Vehicle]][AbgeschlepptGrund]);
				SCM(playerid,SAMP_WEISS,string);
			}
		}
	}
	if(vehiclesspawned == 0)return SCM(playerid,SAMP_WEISS,"Keine Vorhanden.");
	return 1;
}
COMMAND:acheckvehicleowner(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],vehicleid;
	if(!isPlayerAnAdmin(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein "#SERVERTAG" Teammitglied./Du hast nicht den jeweiligen Adminrang.");
	if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" /checkvehicleowner [Vehicleid]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
    for(new fv;fv<MAX_FVEHS;fv++)
    {
	    if(Fahrzeug[fv][Vehicle] == vehicleid)
	    {
		    format(string,sizeof(string),"%s,Besitzer: %s",VehicleDefinations[Fahrzeug[fv][modelid]-400],FraktionsName(Fahrzeug[fv][Fraktion]));
		    SCM(playerid,WEISS,string);
		    return 1;
	    }
    }
    ForEachPlayer(i)
	{
		for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
			if(Pfahrzeug[slot][i][Vehicle] == vehicleid)
			{
			    format(string,sizeof(string),"%s,Besitzer: %s",VehicleDefinations[Pfahrzeug[slot][i][modelid]-400],Pfahrzeug[slot][i][Besitzer]);
			    SCM(playerid,WEISS,string);
				return 1;
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug gehört weder einer Fraktion noch einem Spieler.");
}

COMMAND:samenkaufen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[15],menge,string[128];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(sscanf(params,"s[15]i",cmd,menge))return SCM(playerid,SAMP_WEISS,""IINFO" /samenkaufen [Ganja/Kokain/Opium/Spice][Menge]");
		if(menge<1||menge>100)return SCM(playerid,SAMP_WEISS,""IINFO" /samenkaufen [Ganja/Kokain/Opium/Spice][Menge 1-100]");
		if(strcmp(cmd,"Ganja",true) == 0)
		{
			if(!IsPlayerInRangeOfPoint(playerid,1.0,1298.9716,-854.7413,43.5083))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Ganjasamen kaufen."),SCM(playerid,SAMP_WEISS,"Diese kann man nur beim Dealer in Los Santos erkaufen.");
		    if(isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12))return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} Habe leider nichts mehr sry.");
			new preiberechnung = menge*150;
			if((GetACMoney(playerid) - preiberechnung) < 0)return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} Cho´ so viel Geld hast du gar nicht.");
			if((Spieler[playerid][pGanjaSammen] + menge) > 100)return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} So viel schaffst du nicht zu tragen.");
		    Spieler[playerid][pGanjaSammen] += menge;
		    SetPlayerPosEx(playerid,1298.7894,-854.7486,43.5029);
		    SetPlayerFacingAngle(playerid,310.5711);
		    InterpolateCameraPos(playerid,1298.9716,-854.7413,43.5083,1300.6304,-856.3292,44.1327,2000,CAMERA_MOVE);
			InterpolateCameraLookAt(playerid,1298.9716,-854.7413,43.5083,1297.5085,-853.1715,43.4663,2000,CAMERA_MOVE);
			ApplyAnimation(playerid,"DEALER","DEALER_DEAL",4.0,false,true,true,true,5000,SYNC_ALL);
			TogglePlayerControllable(playerid,false);
			SetTimerEx("UnTazer",3000,false,"i",playerid);
		    format(string,sizeof(string),""IINFO" du hast soeben %i Ganjasamen für %i$ gekauft",menge,preiberechnung);
		    SCM(playerid,SAMP_WEISS,string);
		    ACMoney(playerid,-preiberechnung);
			return 1;
		}
		if(strcmp(cmd,"Kokain",true) == 0)
		{
		    if(!IsPlayerInRangeOfPoint(playerid,1.0,1298.9716,-854.7413,43.5083))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Kokainsamen kaufen."),SCM(playerid,SAMP_WEISS,"Diese kann man nur beim Dealer in Los Santos erkaufen.");
		    if(isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12))return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} Habe leider nichts mehr sry.");
			new preiberechnung = menge*200;
		    if((GetACMoney(playerid) - preiberechnung) < 0)return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} Cho´ so viel Geld hast du gar nicht.");
			if((Spieler[playerid][pKokainSammen] + menge) > 100)return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} So viel schaffst du nicht zu tragen.");
		    Spieler[playerid][pKokainSammen] += menge;
		    SetPlayerPosEx(playerid,1298.7894,-854.7486,43.5029);
		    SetPlayerFacingAngle(playerid,310.5711);
		    InterpolateCameraPos(playerid,1298.9716,-854.7413,43.5083,1300.6304,-856.3292,44.1327,2000,CAMERA_MOVE);
			InterpolateCameraLookAt(playerid,1298.9716,-854.7413,43.5083,1297.5085,-853.1715,43.4663,2000,CAMERA_MOVE);
			ApplyAnimation(playerid,"DEALER","DEALER_DEAL",4.0,false,true,true,true,5000,SYNC_ALL);
			TogglePlayerControllable(playerid,false);
			SetTimerEx("UnTazer",3000,false,"i",playerid);
		    format(string,sizeof(string),""IINFO" du hast soeben %i Kokainsamen für %i$ gekauft",menge,preiberechnung);
		    SCM(playerid,SAMP_WEISS,string);
		    ACMoney(playerid,-preiberechnung);
			return 1;
		}
		if(strcmp(cmd,"Opium",true) == 0)
		{
		    if(!IsPlayerInRangeOfPoint(playerid,1.0,-1889.9170,-202.2443,14.3792))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Opiumsamen kaufen."),SCM(playerid,SAMP_WEISS,"Diese kann man nur beim Dealer in San Fierro erkaufen.");
		    if(isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12))
		    {
				new preiberechnung = menge*300;
			    if((GetACMoney(playerid) - preiberechnung) < 0)return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} Cho´ so viel Geld hast du gar nicht.");
				if((Spieler[playerid][pOpiumSammen] + menge) > 100)return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} So viel schaffst du nicht zu tragen.");
			    Spieler[playerid][pOpiumSammen] += menge;
			    SetPlayerPosEx(playerid,-1889.9354,-202.2174,14.3744);
			    SetPlayerFacingAngle(playerid,90.2736);
			    InterpolateCameraPos(playerid,-1889.9170,-202.2443,14.3792,-1889.4138,-196.1063,18.3959,2000,CAMERA_MOVE);
				InterpolateCameraLookAt(playerid,-1889.9170,-202.2443,14.3792,-1889.3230,-203.4034,14.5326,2000,CAMERA_MOVE);
				ApplyAnimation(playerid,"DEALER","DEALER_DEAL",4.0,false,true,true,true,5000,SYNC_ALL);
				TogglePlayerControllable(playerid,false);
				SetTimerEx("UnTazer",3000,false,"i",playerid);
			    format(string,sizeof(string),""IINFO" du hast soeben %i Opiumsamen für %i$ gekauft",menge,preiberechnung);
			    SCM(playerid,SAMP_WEISS,string);
			    ACMoney(playerid,-preiberechnung);
				return 1;
			}
			return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} Habe leider nichts mehr sry.");
		}
		if(strcmp(cmd,"Spice",true) == 0)
		{
		    if(!IsPlayerInRangeOfPoint(playerid,1.0,-1889.9170,-202.2443,14.3792))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Spicesamen kaufen."),SCM(playerid,SAMP_WEISS,"Diese kann man nur beim Dealer in San Fierro erkaufen.");
		    if(isPlayerInFrakt(playerid,13))
		    {
				new preiberechnung = menge*300;
			    if((GetACMoney(playerid) - preiberechnung) < 0)return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} Cho´ so viel Geld hast du gar nicht.");
				if((Spieler[playerid][pSpiceSammen] + menge) > 100)return SCM(playerid,SAMP_WEISS,"{FF6666}Dealer:{FFFFFF} So viel schaffst du nicht zu tragen.");
			    Spieler[playerid][pSpiceSammen] += menge;
			    SetPlayerPosEx(playerid,-1889.9354,-202.2174,14.3744);
			    SetPlayerFacingAngle(playerid,90.2736);
			    InterpolateCameraPos(playerid,-1889.9170,-202.2443,14.3792,-1889.4138,-196.1063,18.3959,2000,CAMERA_MOVE);
				InterpolateCameraLookAt(playerid,-1889.9170,-202.2443,14.3792,-1889.3230,-203.4034,14.5326,2000,CAMERA_MOVE);
				ApplyAnimation(playerid,"DEALER","DEALER_DEAL",4.0,false,true,true,true,5000,SYNC_ALL);
				TogglePlayerControllable(playerid,false);
				SetTimerEx("UnTazer",3000,false,"i",playerid);
			    format(string,sizeof(string),""IINFO" du hast soeben %i Spicesamen für %i$ gekauft",menge,preiberechnung);
			    SCM(playerid,SAMP_WEISS,string);
			    ACMoney(playerid,-preiberechnung);
				return 1;
			}
			return SCM(playerid,SAMP_WEISS,"Dealer: habe leider nichts mehr sry.");
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" /samenkaufen [Ganja/Kokain/Opium/Spice][Menge]");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:ortsamen(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12))
		{
			SetPlayerCheckpoint(playerid,-1889.9170,-202.2443,14.3792,3.0);
		}
		else
		{
			SetPlayerCheckpoint(playerid,1298.9716,-854.7413,43.5083,3.0);
		}
		SCM(playerid,WEISS,""IINFO" der Drogensamenpunkt wurde auf deiner Karte markiert.");
		Spieler[playerid][pIsearch] = 1;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:ortpflanze(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new drg,string[128];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(DrugFromFraktionCount(Spieler[playerid][pFraktion]) <= 0)return SCM(playerid,SAMP_WEISS,"Deine Fraktion hat keine Drogenpflanze angepflanzt.");
		if(sscanf(params,"i",drg))return SCM(playerid,SAMP_WEISS,""IINFO" /ortpflanze [ 1/3 ]");
		if(IsPlayerAtDrugPflanze(playerid) == drg)return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits an der angegebenen Drogenpflanze.");
	    if(DrugInfo[drg][drgfraktid] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,"Drogenpflanze gehört nicht deiner Fraktion an.");
		format(string,sizeof(string),""IINFO" die Pflanze "IINFO2"%i"#HTML_WEISS" wurde auf deiner Karte markiert!",drg);
		SCM(playerid,WEISS,string);
		SetPlayerCheckpoint(playerid,DrugInfo[drg][drgXpos],DrugInfo[drg][drgYpos],DrugInfo[drg][drgZpos],3.0);
		Spieler[playerid][pIsearch] = 1;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:pflanzen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[15];
	if(gettime() < Spieler[playerid][PWeedWait])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du eine neue Pflanze pflanzen kannst!");
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(GetPlayerInterior(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Drogen-Pflanzen pflanzen.");
		if(sscanf(params,"s[15]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /pflanzen [Ganja/Kokain/Opium/Spice]");
		if(DrugFromFraktionCount(Spieler[playerid][pFraktion]) >= 3)return SCM(playerid,SAMP_WEISS,"Deine Fraktion hat bereits 3 Pflanzen gepflanzt.");
		if(strcmp(cmd,"Ganja",true) == 0)
		{
			if((Spieler[playerid][pGanjaSammen] - MAX_DRUGSEPPLES_GANJA) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Ganjasamen("#MAX_DRUGSEPPLES_GANJA").");
			CreateDrugVegancy(playerid,1,MAX_DRUGSEPPLES_GANJA);//drugart 1 = dop,2 = kokain,3 = opium,4 = Spice
            Spieler[playerid][PWeedWait] = gettime() + 20;
			return 1;
		}
		if(strcmp(cmd,"Kokain",true) == 0)
		{
		    if((Spieler[playerid][pKokainSammen] - MAX_DRUGSEPPLES_KOKAIN) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Kokainsamen("#MAX_DRUGSEPPLES_KOKAIN").");
		    CreateDrugVegancy(playerid,2,MAX_DRUGSEPPLES_KOKAIN);//drugart 1 = dop,2 = kokain,3 = opium,4 = Spice
            Spieler[playerid][PWeedWait] = gettime() + 20;
			return 1;
		}
		if(strcmp(cmd,"Opium",true) == 0)
		{
		    if((Spieler[playerid][pOpiumSammen] - MAX_DRUGSEPPLES_OPIUM) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Opiumsamen("#MAX_DRUGSEPPLES_OPIUM").");
		    CreateDrugVegancy(playerid,3,MAX_DRUGSEPPLES_OPIUM);//drugart 1 = dop,2 = kokain,3 = opium,4 = Spice
            Spieler[playerid][PWeedWait] = gettime() + 20;
			return 1;
		}
		if(strcmp(cmd,"Spice",true) == 0)
		{
		    if(!isPlayerInFrakt(playerid,13))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
		    if((Spieler[playerid][pSpiceSammen] - MAX_DRUGSEPPLES_SPICE) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Spicesamen("#MAX_DRUGSEPPLES_SPICE").");
		    CreateDrugVegancy(playerid,4,MAX_DRUGSEPPLES_SPICE);//drugart 1 = dop,2 = kokain,3 = opium,4 = Spice
            Spieler[playerid][PWeedWait] = gettime() + 20;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" /pflanzen [Ganja/Kokain/Opium/Spice]");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:giessen(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pflanze = IsPlayerAtDrugPflanze(playerid),string[128];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(DrugFromFraktionCount(Spieler[playerid][pFraktion]) <= 0)return SCM(playerid,SAMP_WEISS,"Deine Fraktion hat keine Drogenpflanze angepflanzt.");
		if(pflanze == -1)return SCM(playerid,SAMP_WEISS,"An keiner Drogenpflanze.");
		if(DrugInfo[pflanze][drgfraktid] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,"Drogenpflanze gehört nicht deiner Fraktion an.");
		if(DrugInfo[pflanze][drgWasserzustand] >= 50)return SCM(playerid,SAMP_WEISS,"Drogenpflanze muss noch nicht gegossen werden.");
	    format(string,sizeof(string),"** %s gießt eine %s Pflanze **",SpielerName(playerid),DrugArtByName(DrugInfo[pflanze][drgArt]));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	    format(string,sizeof(string),"**(( %s %s: Eine %s Pflanze wurde soeben gegossen! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],DrugArtByName(DrugInfo[pflanze][drgArt]));
	    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
		DrugInfo[pflanze][drgWasserzustand] = 100;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:dpflanze(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pflanze = IsPlayerAtDrugPflanze(playerid),string[128];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(DrugFromFraktionCount(Spieler[playerid][pFraktion]) <= 0)return SCM(playerid,SAMP_WEISS,"Deine Fraktion hat keine Drogenpflanze angepflanzt.");
		if(pflanze == -1)return SCM(playerid,SAMP_WEISS,"An keiner Drogenpflanze.");
		if(DrugInfo[pflanze][drgfraktid] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,"Drogenpflanze gehört nicht deiner Fraktion an.");
		if((Spieler[playerid][pDuenger] - 5) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Dünger.");
		format(string,sizeof(string),"** %s schüttet Dünger auf eine %s Pflanze **",SpielerName(playerid),DrugArtByName(DrugInfo[pflanze][drgArt]));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	    format(string,sizeof(string),"**(( %s %s: Eine %s Pflanze wurde soeben mit Dünger beschüttet! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],DrugArtByName(DrugInfo[pflanze][drgArt]));
	    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
	    DrugInfo[pflanze][drgNextDrugsIn] = floatround(DrugInfo[pflanze][drgNextDrugsIn]/4);
		Spieler[playerid][pDuenger] -= 5;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:tdrogen(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pflanze = IsPlayerAtDrugPflanze(playerid),string[128];
 	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(DrugFromFraktionCount(Spieler[playerid][pFraktion]) <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" deine Fraktion hat keine Drogenpflanze angepflanzt.");
		if(pflanze == -1)return SCM(playerid,SAMP_WEISS,"An keiner Drogenpflanze.");
		if(DrugInfo[pflanze][drgfraktid] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,""IINFO" Drogenpflanze gehört nicht deiner Fraktion an.");
		if(isPlayerAMember(playerid,4) || !strcmp(Spieler[playerid][pName],DrugInfo[pflanze][drgOwner],true))
		{
			if(DrugInfo[pflanze][drgProduceDrugs] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" Drogenpflanze hat noch keine Drogen produziert.");
		    format(string,sizeof(string),"**(( %s %s: Habe soeben %ig %s von der Pflanzen-ID: %i abgeflückt! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],DrugInfo[pflanze][drgProduceDrugs],DrugArtByName(DrugInfo[pflanze][drgArt]),pflanze);
		    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
			switch(DrugInfo[pflanze][drgArt])
			{
				case 1:Spieler[playerid][pGanja] += DrugInfo[pflanze][drgProduceDrugs];
				case 2:Spieler[playerid][pKokain] += DrugInfo[pflanze][drgProduceDrugs];
				case 3:Spieler[playerid][pOpium] += DrugInfo[pflanze][drgProduceDrugs];
				case 4:Spieler[playerid][pSpice] += DrugInfo[pflanze][drgProduceDrugs];
			}
		 	DrugInfo[pflanze][drgProduceDrugs] = 0;
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" nicht den jeweiligen Rang/Nicht der Ersteller der Pflanze!");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:kpflanze(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pflanze = IsPlayerAtDrugPflanze(playerid),string[128];
 	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(DrugFromFraktionCount(Spieler[playerid][pFraktion]) <= 0)return SCM(playerid,SAMP_WEISS,"Deine Fraktion hat keine Drogenpflanze angepflanzt.");
		if(pflanze == -1)return SCM(playerid,SAMP_WEISS,"An keiner Drogenpflanze.");
		if(DrugInfo[pflanze][drgfraktid] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,"Drogenpflanze gehört nicht deiner Fraktion an.");
	    if(isPlayerAMember(playerid,5) || !strcmp(Spieler[playerid][pName],DrugInfo[pflanze][drgOwner],true))
		{
		    format(string,sizeof(string),"**(( %s %s: Habe die %s Pflanze(Pflanzen-ID:%i) zerstört! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],DrugArtByName(DrugInfo[pflanze][drgArt]),pflanze);
		    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
		    format(string,sizeof(string),"** %s zerstört eine %s Pflanze **",SpielerName(playerid),DrugArtByName(DrugInfo[pflanze][drgArt]));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			DestroyDrugVegancy(pflanze);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang/Nicht der Ersteller der Pflanze!");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:destroypflanze(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pflanze = IsPlayerAtDrugPflanze(playerid),string[128];
 	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6))
	{
		if(pflanze == -1)return SCM(playerid,SAMP_WEISS,"An keiner Drogenpflanze.");
	    format(string,sizeof(string),"**(( %s %s: Habe die %s Pflanze(Pflanzen-ID:%i) der Fraktion %s zerstört! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],DrugArtByName(DrugInfo[pflanze][drgArt]),pflanze,FraktionsName(DrugInfo[pflanze][drgfraktid]));
	    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
	    format(string,sizeof(string),"** %s zerstört eine %s Pflanze **",SpielerName(playerid),DrugArtByName(DrugInfo[pflanze][drgArt]));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		DestroyDrugVegancy(pflanze);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:shplfanzen(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[6200];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(DrugFromFraktionCount(Spieler[playerid][pFraktion]) <= 0)return SCM(playerid,SAMP_WEISS,"Deine Fraktion hat keine Drogenpflanze angepflanzt.");
	    for(new drg=0;drg<MAX_DRUGS;drg++)
		{
			if(DrugInfo[drg][drgfraktid] == Spieler[playerid][pFraktion])
			{
				format(string,sizeof(string),"Pflanze: "IINFO2"%i"HTML_WEISS" | Produziert "IINFO2"%s "HTML_WEISS"|"IINFO2" %ig"HTML_WEISS" | Wasserzustand: "IINFO2"%i"HTML_WEISS" | Neues: "IINFO2"%s"HTML_WEISS" in "IINFO2"%i:%02d"#HTML_WEISS" Minuten\n%s",
				drg,DrugArtByName(DrugInfo[drg][drgArt]),DrugInfo[drg][drgProduceDrugs],DrugInfo[drg][drgWasserzustand],DrugArtByName(DrugInfo[drg][drgArt]),DrugInfo[drg][drgNextDrugsIn]/60,DrugInfo[drg][drgNextDrugsIn]%60,string);
			    ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Drogenplfanzen - Übersicht",string,"Okay","");
			}
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:lastcp(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new r = RaceStarted;
	if(r == -1)return SCM(playerid,SAMP_WEISS,""IINFO" es findet kein Rennen statt.");
	new var_last_cp = RaceCps[playerid]-1;
	new vehicleid = GetPlayerVehicleID(playerid);
	if(InviteInRace[playerid] == 1)
	{
		if(IsPlayerInAnyVehicle(playerid) == true)
		{
		    if(vehicleid == RaceFahrzeug[playerid])
			{
			    MotorDown[GetPlayerVehicleID(playerid)] = 0;
    			RepairVehicle(GetPlayerVehicleID(playerid));
    			vFahrzeug[GetPlayerVehicleID(playerid)][FailGas] = 0;
                SetVehiclePosEx(vehicleid,RaceInfo[r][var_last_cp][0],RaceInfo[r][var_last_cp][1],RaceInfo[r][var_last_cp][2]+5);
                SetPlayerPos(playerid,RaceInfo[r][var_last_cp][0],RaceInfo[r][var_last_cp][1],RaceInfo[r][var_last_cp][2]+5);
    			PutPlayerInVehicleEx(playerid, RaceFahrzeug[playerid], 0);
    			SCM(playerid,SAMP_WEISS,""IINFO" du wurdest zum letzten Checkpoint teleportiert!");
			}
			else
			{
				SCM(playerid,SAMP_WEISS,"Dieses Fahrzeug ist nicht dein Rennfahrzeug.");
				return 1;
			}
		}
		else
		{
			SCM(playerid,SAMP_WEISS,""IINFO" du musst in einem Fahrzeug sitzen.");
			return 1;
		}
	}
	else
	{
		SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Teilnehmer eines Rennens.");
		return 1;
	}
	return 1;
}
COMMAND:verstaerkung(playerid, const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    if(Spieler[playerid][pCallVaersterkung] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits Verstärkung angefordert.(/cancel)");
	ServiceCall(playerid,10);
    return 1;
}
COMMAND:tune(playerid, const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(InviteInRace[playerid] == 1) return SCM(playerid,SAMP_WEISS,""IINFO" du kannst während eines Rennens dein Fahrzeug nicht tunen.");
    if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	new string[128];
    if(!IsNosVehicleInvalid(GetVehicleModel(GetPlayerVehicleID(playerid)))){
    	AddVehicleComponent(GetPlayerVehicleID(playerid), 1010);
	}
    format(string,sizeof(string),"%s hat sein Fahrzeug %s [%i] getuned. (Adminbefehl)",SpielerName(playerid),VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(playerid))-400],GetVehicleModel(GetPlayerVehicleID(playerid)));
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
    return 1;
}

COMMAND:teilnehmen(playerid, const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    new r = RaceStarted,string[128];
	if(RaceInfoUsed[r][0] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Rennen besitzt keinen Start/Ziel. Bitte Fehlermeldung abscreenen und im Bugtracker posten!");
	if(r == -1)return SCM(playerid,SAMP_WEISS,"Es findet kein Rennen statt.");
    format(string,sizeof(string),""IINFO" der Startpunkt des Rennens "IINFO2"%s"#HTML_WEISS" wurde auf deiner Karte markiert.",RaceName[r]);
	SCM(playerid,WEISS,string);
	SetPlayerCheckpoint(playerid,RaceInfo[r][0][0],RaceInfo[r][0][1],RaceInfo[r][0][2],5.0);
	Spieler[playerid][pIsearch] = 1;
    return 1;
}


COMMAND:aflip(playerid,const params[])
{
    #pragma unused params
   	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
 	if(IsPlayerInAnyVehicle(playerid) == true)
	{
		new Float:Angle,string[128];
		GetVehicleZAngle(GetPlayerVehicleID(playerid), Angle);
		SetVehicleZAngle(GetPlayerVehicleID(playerid), Angle);
		format(string,sizeof(string),"** %s dreht ein Fahrzeug [%s] (Adminbefehl) **",SpielerName(playerid),VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(playerid))-400]);
    	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		SCM(playerid, GELB,"Dein Fahrzeug wurde wieder gedreht!");
		return 1;
	}
	else
	{
		SCM(playerid, GRAU,"Du musst in einem Fahrzeug sein!");
		return 1;
	}
}

COMMAND:flip(playerid,const params[])
{
    #pragma unused params
   	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(InviteInRace[playerid] == 1)
	{
	    if(IsPlayerInAnyVehicle(playerid) == true)
		{
		 	new Float:Angle;
	 		GetVehicleZAngle(GetPlayerVehicleID(playerid), Angle);
			SetVehicleZAngle(GetPlayerVehicleID(playerid), Angle);
			SCM(playerid, GELB,"Dein Fahrzeug wurde wieder gedreht!");
		}
		else
		{
			SCM(playerid, GRAU,"Du musst in einem Fahrzeug sein!");
			return 1;
		}
	}
	else
	{
 		SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Teilnehmer eines Rennens.");
 		return 1;
	}
	return 1;
}

COMMAND:racecars(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
 	new string[2600],stext[16];
	if(isPlayerInFrakt(playerid,17))
	{
		for(new r=0;r<sizeof(RaceFC);r++)
		{
		    switch(RaceFC[r][race_cartyp])
		    {
		        case 0:{stext="Boot";}
				case 1:{stext="Flug";}
				case 2:{stext="Bikes";}
				case 3:{stext="Sport";}
				case 4:{stext="Gelände";}
				case 5:{stext="Standard";}
				case 6:{stext="Sonstige";}
				default:{stext="ERROR";}
			}
			format(string,sizeof(string),"%s |:  %s (ID: %i)\n%s",stext,VehicleDefinations[RaceFC[r][race_modelid]-400],RaceFC[r][race_modelid],string);
   			ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"{00AFFF}Rennfahrzeuge:",string,"Verlassen","");
		}
		return 1;
	}
 	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}



COMMAND:racelist(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
 	new string[512],cpcount[MAX_RACES] = 0,cpcounts = 0;
	if(isPlayerInFrakt(playerid,17))
	{
		for(new r=0;r<MAX_RACES;r++)
		{
			if(isPlayerInFrakt(playerid,RaceFromFraktion[r]))
			{
			 	if(RaceCreated[r] == 1)
				{
				for(new rcp=0;rcp<MAX_RACECPS;rcp++)
				{
			 		if(RaceInfoUsed[r][rcp] == 1) cpcount[r]++, cpcounts++;
			 	}
				format(string,sizeof(string),"%i. %s | %i Checkpoints\n%s",r,RaceName[r],cpcount[r],string);
			    ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"{00AFFF}Rennen:",string,"Verlassen","");
			 	}
			}
		}
		if(cpcounts == 0)return SCM(playerid,SAMP_WEISS,"Es wurden keine Rennen erstellt.");
		return 1;
	}
 	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:rinvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(isPlayerInFrakt(playerid,17))
	{
	    if(RaceStarted == -1)return SCM(playerid,SAMP_WEISS,"Es wurde kein Rennen ausgewählt.");
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /rinvite [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(!ProxDetectorS(15.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du wurdest von %s in ein Rennen eingeladen.(/accept race) | Startgebühr: %d$",SpielerName(playerid),RaceGebuehr);
	    SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast %s in ein Rennen "IINFO2"%s"#HTML_WEISS" eingeladen.",SpielerName(pID),RaceName[RaceStarted]);
	    SCM(playerid,SAMP_WEISS,string);
	    Spieler[pID][pSeller] = playerid;
	    Spieler[pID][pAngebot] = 14;
	   	return 1;
   	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:rinviteall(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],Float:Pos[3];
	if(isPlayerInFrakt(playerid,17))
	{
	    if(RaceStarted == -1)return SCM(playerid,SAMP_WEISS,"Es wurde kein Rennen ausgewählt.");
		GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
		ForEachPlayer(players)
		{
		    if(IsPlayerConnected(players))
		    {
		        if(!IsPlayerNPC(players))
		        {
		    		if(GetPVarInt(players,"Eingeloggt") == 1)
		    		{
		 				if(IsPlayerInRangeOfPoint(players,20.0, Pos[0], Pos[1], Pos[2]))
	 					{
							format(string,sizeof(string),""IINFO" du wurdest von %s in ein Rennen eingeladen.(/accept race) | Startgebühr: %d$",SpielerName(playerid),RaceGebuehr);
				    		SCM(players,SAMP_WEISS,string);
							format(string,sizeof(string),""IINFO" du hast %s in ein Rennen "IINFO2"%s"#HTML_WEISS" eingeladen.",SpielerName(players),RaceName[RaceStarted]);
				    		SCM(playerid,SAMP_WEISS,string);
				    		Spieler[players][pSeller] = playerid;
				    		Spieler[players][pAngebot] = 14;
				   			return 1;
						}
					}
				}
			}
		}
		return 1;
   	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:runinvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,stringuninv[128];
    if(isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(RaceStarted == -1)return SCM(playerid,SAMP_WEISS,"Es wurde kein Rennen ausgewählt.");
		if(sscanf(params,"u",pID)) return SCM(playerid,SAMP_WEISS,""IINFO" /runinvite [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	 	if(InviteInRace[pID] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist in keinem Rennen Aktiv.");
		format(stringuninv,sizeof(stringuninv),""IINFO" du hast %s aus dem Rennen gehauen.",SpielerName(pID));
	  	SCM(playerid,SAMP_WEISS,stringuninv);
		format(stringuninv,sizeof(stringuninv),"%s hat dich aus dem Rennen gehauen.",SpielerName(playerid));
	 	SCM(pID,SAMP_WEISS,stringuninv);
		DisablePlayerRaceCheckpoint(pID);
	    if(RaceFahrzeug[playerid] != 0) DestroyVehicle(RaceFahrzeug[playerid]);
		InviteInRace[playerid] = 0;
		for(new t=0;t<6;t++){ PlayerTextDrawHide(playerid,RACEdraw[playerid][t]); }
		RaceCps[pID] = 0;
	    return 1;
    }
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:selectrace(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128], modus[16],r,model,gebuehr,count = 0;
	if(isPlayerInFrakt(playerid,17))
	{
	    if(gettime() > RaceStatusTimer)
 		{
		    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
			if(sscanf(params,"iii",r,model,gebuehr))return SCM(playerid,SAMP_WEISS,""IINFO" /selectrace [RennID][FahrzeugID][Gebühr]");
		    if(RaceCreated[r] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Rennen existiert nicht.");
		    if(!isPlayerInFrakt(playerid,RaceFromFraktion[r]))return SCM(playerid,SAMP_WEISS,""IINFO" das Rennen steht deiner Fraktion nicht zur verfügung.");
			if(MakeRace[playerid] != -1)return SCM(playerid,SAMP_WEISS,""IINFO" du erstellt momentan ein Rennen.");
			if(RaceStarted != -1)return SCM(playerid,SAMP_WEISS,"Es findet bereits ein Rennen statt.");
			if(model<400||model>611)return SCM(playerid,SAMP_WEISS,"Die Fahrzeug Model ID muss zwischen 400 und 611 betragen");
			if(gebuehr<1||gebuehr>5000) return SCM(playerid, GRAU,"Die Startgebühr muss zwischen 1$ und 5000$ betragen.");
            for(new cm=0;cm<sizeof(RaceFC);cm++)
			{
		    	if(RaceFC[cm][race_modelid] == model) count++;
			}
			if(count == 0) return SCM(playerid, GRAU,"Dieses Fahrzeug kann nicht verwendet werden. (/racecars)");
			RaceStarted	= r;
			RaceGebuehr = gebuehr;
			RaceCarType = model;
			InviteInRace[playerid] = 1;
			RaceStatusTimer = gettime() + (60*30);
		    for(new rcp=0;rcp<MAX_RACECPS;rcp++)
			{
		 		if(RaceInfoUsed[r][rcp] == 1) RaceMaxCps++;
		 	}
		 	switch(RaceMode[r])
		 	{
		 	    case 0:{modus="Normal";}
		 	    case 1:{modus="Flugmode";}
		 	    case 2:{modus="Verfolgung";}
		 	    case 3:{modus="Drift";}
		 	    case 4:{modus="Runden";}
	 	    	default:{modus="ERROR";}
		 	}
		    format(string,sizeof(string),"%s hat das Rennen "IINFO2"%s"#HTML_WEISS" mit %i Checkpoints ausgewählt. Racemodus: %s | Fahrzeug: %s(ID:%d) | Gebühr: %d$",SpielerName(playerid),modus,RaceMaxCps,modus,VehicleDefinations[model-400],model, gebuehr);
		 	SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
		 	SCM(playerid,SAMP_WEISS,"Renneinladung: /rinvite,Rennausladung: /runinvite,Rennen starten: /startrace,Rennen beenden: /stoprace");
			format(string,sizeof(string),""#SAMP_BLAU"Wetter Station"#HTML_WEISS": Ein Illegales Rennen wurde gestartet. (Racemodus: %s | Gebühr: %d$ | Fahrzeug: %s(ID: %d))", RaceName[r], RaceGebuehr, VehicleDefinations[model-400], model);
 			SendClientMessageToAll(ORANGE,string);
 			SendClientMessageToAll(ORANGE,"INFO: Um den Standort zu ermitteln, gib /teilnehmen ein!");
		 	ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,11))
					{
		    			if(Spieler[i][pDuty] != 0)
						{
			    			SCM(i,0x000FFF87,"HQ: An alle Einheiten, Ein Illegales Rennen wurde gestartet.");
			    			format(string,sizeof(string),"HQ: An alle Einheiten, das Rennen %s wurde ausgewählt. (Veranstalter: %s)", RaceName[r], FraktionsName(RaceFromFraktion[r]));
							SCM(i,0x000FFF87,string);
						}
					}
				}
			}
		}
		else
		{
		    new racetimer = RaceStatusTimer-gettime();
			format(string,sizeof(string),""IINFO" du kannst erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten ein Rennen starten.",floatround(racetimer/60),floatround(racetimer%60));
			SCM(playerid,SAMP_WEISS,string);
		}
		return 1;
	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:startrace(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new r = RaceStarted,string[128];
	if(isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(MakeRace[playerid] != -1)return SCM(playerid,SAMP_WEISS,""IINFO" du erstellt momentan ein Rennen.");
		if(RaceStarted == -1)return SCM(playerid,SAMP_WEISS,"Es wurde kein Rennen ausgewählt.");
		if(RaceTeilnehmer() < 2)return SCM(playerid,SAMP_WEISS,"Es müssen mehr Spieler am Rennen teilnehmen!");
	    ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(InviteInRace[i] == 1)
				{
					format(string,sizeof(string),"%s hat den Countdown für das Rennen "IINFO2"%s"#HTML_WEISS" gestartet.",SpielerName(playerid),RaceName[r]);
					SCM(i,SAMP_WEISS,string);
					GameTextForPlayer(i,"~g~10",1000,3);
				    PlayerPlaySound(i,1056,0.0,0.0,0.0);
				    TogglePlayerControllable(i,false);
				}
			}
		}
		RCountdownSec = 10;
		RCountDownTimer = SetTimerEx("CountDown",1000,true,"i",1);
	   	return 1;
   	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:stoprace(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string1[500],string2[64];
	if(isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(MakeRace[playerid] != -1)return SCM(playerid,SAMP_WEISS,""IINFO" du erstellt momentan ein Rennen.");
		if(RaceStarted == -1)return SCM(playerid,SAMP_WEISS,"Es findet momentan kein Rennen statt.");
	    ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(InviteInRace[i] == 1)
				{
					format(string2,sizeof(string2),"%s hat das Rennen "IINFO2"%s"#HTML_WEISS" beendet.",SpielerName(playerid),RaceName[RaceStarted]);
					DisablePlayerRaceCheckpoint(i);
					InviteInRace[i] = 0;
					BeforeRace[i] = true;
					RaceCps[i] = 0;
					gPlayerProgress[i]=0;
					for(new cpm; cpm < MAX_RACECPS; cpm++) gRaceCheckpoints[cpm] = 0;
					if(RaceFahrzeug[i] != 0) DestroyVehicle(RaceFahrzeug[i]);
				 	for(new t=0;t<6;t++){ PlayerTextDrawHide(i,RACEdraw[i][t]); }
					format(string1,sizeof(string1),"%s | %i.%02d Minuten\n%s",SpielerName(i),RaceZeitAfterRace[i]/60,RaceZeitAfterRace[i]%60,string1);
					ShowPlayerDialog(i,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,RaceName[RaceStarted],string1,"Verlassen","");
					RaceZeitAfterRace[i] = 0;
				}
			}
		}
		SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string2);
		format(string2,sizeof(string2),""IINFO" du hast das Rennen "IINFO2"%s"#HTML_WEISS" beendet.",RaceName[RaceStarted]);
		SCM(playerid,SAMP_WEISS,string2);
		RaceWinner = 0;
		RaceStarted = -1;
		RaceCarType = 0;
		RaceMaxCps = 0;
	   	return 1;
   	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:searchracecp(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new rcp,r = MakeRace[playerid],string[64];
	if(isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(MakeRace[playerid] == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du erstellt momentan kein Rennen.");
		if(sscanf(params,"i",rcp))return SCM(playerid,SAMP_WEISS,""IINFO" /searchracecp [CheckpointID]");
		if(RaceInfoUsed[r][rcp] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Renncheckpoint existiert nicht.");
		format(string,sizeof(string),""IINFO" der Checkpoint Nummer %i wurde auf deiner Karte markiert.",rcp);
		SCM(playerid,WEISS,string);
		SetPlayerCheckpoint(playerid,RaceInfo[r][rcp][0],RaceInfo[r][rcp][1],RaceInfo[r][rcp][2],3.0);
		Spieler[playerid][pIsearch] = 1;
		return 1;
	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:predigt(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[15],string[128];
	if(isPlayerInFrakt(playerid,18))
	{
	    if(!isPlayerAMember(playerid,2))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(sscanf(params,"s[15]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /predigt [chat/ausrufen]");
		if(strcmp(cmd,"chat",true) == 0)
		{
		    if(chatpredigt[playerid] == true)
		    {
		        chatpredigt[playerid] = false;
		        SCM(playerid,WEISS,"Predigt Chat ausgeschaltet.");
			}
			else if(chatpredigt[playerid] == false)
		    {
		        chatpredigt[playerid] = true;
		        SCM(playerid,WEISS,"Predigt Chat eingeschaltet.");
			}
			return 1;
		}
		if(strcmp(cmd,"ausrufen",true) == 0)
		{
		    new time = lastpredigt - gettime();
			if(lastpredigt < gettime())
			{
			    SendClientMessageToAll(SEKTEFARBE,"Die Sekte ruft zum Gottesdienst auf");
			    lastpredigt = gettime() + (60*30);
			}
			else
			{
				format(string,sizeof(string),"Sie müssen noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten warten bis du deine nächste Predigt ausrufen kannst.",time/60,time%60);
				SCM(playerid,WEISS,string);
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" /predigt [chat/ausrufen]");
	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:searchrace(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new r,rcpcount = 0,cmd[15],string[128];
	if(isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(sscanf(params,"is[15]",r,cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /searchrace [RennID][Startpunkt/Finishpunkt]");
		if(RaceCreated[r] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Rennen existiert nicht.");
		if(!isPlayerInFrakt(playerid,RaceFromFraktion[r]))return SCM(playerid,SAMP_WEISS,""IINFO" das Rennen steht deiner Fraktion nicht zur verfügung.");
		if(strcmp(cmd,"Startpunkt",true) == 0)
		{
			if(RaceInfoUsed[r][0] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Rennen besitzt keinen Start/Ziel.");
			format(string,sizeof(string),""IINFO" der Startpunkt des Rennens "IINFO2"%s"#HTML_WEISS" wurde auf deiner Karte markiert.",RaceName[r]);
			SCM(playerid,WEISS,string);
			SetPlayerCheckpoint(playerid,RaceInfo[r][0][0],RaceInfo[r][0][1],RaceInfo[r][0][2],3.0);
			Spieler[playerid][pIsearch] = 1;
			return 1;
		}
		if(strcmp(cmd,"Finishpunkt",true) == 0)
		{
			if(RaceInfoUsed[r][0] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Rennen besitzt keinen Start/Ziel.");
			for(new rcp=0;rcp<MAX_RACECPS;rcp++)
			{
		 		if(RaceInfoUsed[r][rcp] == 1) rcpcount++;
		 	}
			format(string,sizeof(string),""IINFO" das Ziel des Rennens "IINFO2"%s"#HTML_WEISS" wurde auf deiner Karte markiert.",RaceName[r]);
			SCM(playerid,WEISS,string);
			SetPlayerCheckpoint(playerid,RaceInfo[r][rcpcount-1][0],RaceInfo[r][rcpcount-1][1],RaceInfo[r][rcpcount-1][2],3.0);
			Spieler[playerid][pIsearch] = 1;
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" /searchrace [RennID][Startpunkt/Finishpunkt]");
	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:newracetrack(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new nameofrace[31],string[128],moduss[11],query[128],modus;
    if(isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(MakeRace[playerid] != -1)return SCM(playerid,SAMP_WEISS,""IINFO" du erstellt momentan ein Rennen.");
	    if(sscanf(params,"s[31]i",nameofrace,modus))return SCM(playerid,SAMP_WEISS,""IINFO" /crace [Rennname][Racemodus]");
	    if(strlen(nameofrace) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /crace [Rennname darf maximal 30 Zeichen beinhalten][Racemodus]");
		if(modus<0||modus>0)return SCM(playerid,SAMP_WEISS,""IINFO" /crace [Rennname][0 Normal | 1 Flugmode | 2 Verfolgung | 3 Drift | 4 Runden]");
	    for(new r=0;r<MAX_RACES;r++)
		{
		 	if(RaceCreated[r] == 0)
			{
			    switch(modus)
			 	{
			 	    case 0:{moduss="Normal";}
			 	    case 1:{moduss="Flugmode";}
			 	    case 2:{moduss="Verfolgung";}
			 	    case 3:{moduss="Drift";}
			 	    case 4:{moduss="Runden";}
		 	    	default:{moduss="ERROR";}
			 	}
				RaceCreated[r] = 1;
				RaceMode[r] = modus;
				RaceFromFraktion[r] = Spieler[playerid][pFraktion];
				MakeRace[playerid] = r;
				CP_MakeRace[playerid] = true;
				format(RaceName[r],32,"%s",nameofrace);
				format(string,sizeof(string),"%s hat das Rennen "IINFO2"%s"#HTML_WEISS" erstellt. Rennmodus: %s",SpielerName(playerid),RaceName[r],moduss);
			 	SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
				for(new rcp=0;rcp<MAX_RACECPS;rcp++)
				{
				 	RaceInfoUsed[r][rcp] = 0;
				 	RaceInfo[r][rcp][0] = 0;
				 	RaceInfo[r][rcp][1] = 0;
				 	RaceInfo[r][rcp][2] = 0;
				 	RACE_CP_TYP[r][rcp] = 0;
					RACE_CP_SIZE[r][rcp] = 0.0;
			 	}
			    mysql_format(MySQL_R394,query,sizeof(query),"SELECT * FROM server_bestenlisteraces WHERE race='%e'",nameofrace);
				mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",nameofrace,s_script_rennen,Spieler[playerid][pFraktion],MySQL_R394);
				return 1;
			}
		}
		return SCM(playerid,SAMP_WEISS,"Es wurde bereits die maximale Anzahl an Rennen erstellt.");
	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:drace(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new r,query[128],string[64];
    if(isPlayerInFrakt(playerid,17))
	{
	    if(Spieler[playerid][pLeader] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Leader.");
		if(MakeRace[playerid] != -1)return SCM(playerid,SAMP_WEISS,""IINFO" du erstellt momentan ein Rennen.");
	    if(sscanf(params,"i",r))return SCM(playerid,SAMP_WEISS,""IINFO" /drace [RennID]");
	 	if(RaceCreated[r] == 0)return SCM(playerid,SAMP_WEISS,"Rennen existiert nicht.");
	    if(!isPlayerInFrakt(playerid,RaceFromFraktion[r]))return SCM(playerid,SAMP_WEISS,""IINFO" das Rennen steht deiner Fraktion nicht zur verfügung.");
		MakeRace[playerid] = -1;
		format(string,sizeof(string),"%s hat das Rennen "IINFO2"%s"#HTML_WEISS" gelöscht.",SpielerName(playerid),RaceName[r]);
	 	SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	 	RaceCreated[r] = 0;
		for(new rcp=0;rcp<MAX_RACECPS;rcp++)
		{
		 	RaceInfoUsed[r][rcp] = 0;
		 	RaceInfo[r][rcp][0] = 0;
		 	RaceInfo[r][rcp][1] = 0;
		 	RaceInfo[r][rcp][2] = 0;
	 	}
	    mysql_format(MySQL_R394,query,sizeof(query),"SELECT * FROM server_race WHERE race='%e'",RaceName[r]);
		mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",RaceName[r],d_script_rennen,Spieler[playerid][pFraktion],MySQL_R394);
		return 1;
    }
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:cp(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],rennid = MakeRace[playerid], ctype, Float:amount,cptyps[32];
	if(isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
        if(sscanf(params,"fi",amount,ctype))return SCM(playerid,SAMP_WEISS,""IINFO" /cp [Größe: mind 5.0][Type 0-Normal, 1-Repair, 2-Nos, 3-Nitro+Repair]");
        if(ctype<0||ctype>3)return SCM(playerid,SAMP_WEISS,""IINFO" /cp [Größe: mind 5.0][Type 0-Normal, 1-Repair, 2-Nitro, 3-Nitro+Repair]");
        if(amount<5.0||amount>30.0)return SCM(playerid,SAMP_WEISS,""IINFO" /cp [Größe: mind 5.0][Type 0-Normal, 1-Repair, 2-Nitro, 3-Nitro+Repair]");
		if(MakeRace[playerid] == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du erstellt momentan kein Rennen.");
		if(RaceCreated[rennid] == 1)
		{
		    for(new rcp=0;rcp<MAX_RACECPS;rcp++)
			{
			 	if(RaceInfoUsed[rennid][rcp] == 0)
			 	{
				 	RaceInfoUsed[rennid][rcp] = 1;
					RACE_CP_TYP[rennid][rcp] = ctype;
					RACE_CP_SIZE[rennid][rcp] = amount;
					switch(ctype)
				 	{
				 	    case 0:{cptyps="Normal-CP";}
				 	    case 1:{cptyps="Repair-CP";}
				 	    case 2:{cptyps="Nitro-CP";}
				 	    case 3:{cptyps="Nitro+Repair - CP";}
			 	    	default:{cptyps="ERROR";}
				 	}
					if(amount < 5.0)
					{
					    RACE_CP_SIZE[rennid][rcp] = 7.5;
					}
				 	GetPlayerPos(playerid,RaceInfo[rennid][rcp][0],RaceInfo[rennid][rcp][1],RaceInfo[rennid][rcp][2]);
				 	if(CP_MakeRace[playerid] == true)
				 	{
					 	DisablePlayerCheckpoint(playerid);
				 	    SetPlayerCheckpoint(playerid,RaceInfo[rennid][rcp][0],RaceInfo[rennid][rcp][1],RaceInfo[rennid][rcp][2],RACE_CP_SIZE[rennid][rcp]);
				 	}
				 	format(string,sizeof(string),""IINFO" du hast den Checkpoint Nummer '%i' für das Rennen "IINFO2"%s"#HTML_WEISS" erstellt.",rcp+1,RaceName[rennid]);
				 	SCM(playerid,SAMP_WEISS,string);
				 	return 1;
				}
			}
		}
	    return SCM(playerid,SAMP_WEISS,"Es wurde bereits die maximale Anzahl an RennCheckpoints erstellt.");
    }
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:delcp(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new rennid = MakeRace[playerid],rcp,string[128];
	if(isPlayerInFrakt(playerid,17))
	{
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(MakeRace[playerid] == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du erstellt momentan kein Rennen.");
	    if(sscanf(params,"i",rcp))return SCM(playerid,SAMP_WEISS,""IINFO" /delcp [RennCheckpointID]");
		if(RaceCreated[rennid] == 1)
		{
		 	if(RaceInfoUsed[rennid][rcp] == 1)
		 	{
			 	RaceInfoUsed[rennid][rcp] = 0;
			 	RaceInfo[rennid][rcp][0] = 0;
			 	RaceInfo[rennid][rcp][1] = 0;
			 	RaceInfo[rennid][rcp][2] = 0;
			 	format(string,sizeof(string),""IINFO" du hast den Checkpoint Nummer '%i' für das Rennen "IINFO2"%s"#HTML_WEISS" entfernt.",rcp+1,RaceName[rennid]);
			 	SCM(playerid,SAMP_WEISS,string);
			 	return 1;
			}
		}
	    return SCM(playerid,SAMP_WEISS,"RennCheckpoint existiert nicht.");
    }
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:saverace(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(isPlayerInFrakt(playerid,17))
	{
		if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(MakeRace[playerid] == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du erstellt momentan kein Rennen.");
	    format(string,sizeof(string),"%s hat das Rennen "IINFO2"%s"#HTML_WEISS" fertiggestellt.",SpielerName(playerid),RaceName[MakeRace[playerid]]);
	    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	    DisablePlayerCheckpoint(playerid);
	    MakeRace[playerid] = -1;
		return 1;
	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:fvehlist(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[200],status1[30],status2[30],fraktvehiclesspawned = 0;
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    SCM(playerid,SAMP_WEISS,"||__________Fraktionsfahrzeuge__________||");
    for(new fv;fv<MAX_FVEHS;fv++)
    {
		if(Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		{
			switch(Fahrzeug[fv][Abgeschlossen])
			{
				case 0:{status1="{66CD00}Auf{C9C9C9}";}
				case 1:{status1="{FF0000}Zu{C9C9C9}";}
				default:{status1="ERROR";}
			}
			switch(vFahrzeug[Fahrzeug[fv][Vehicle]][Abgeschleppt])
			{
				case 0:{status2="{66CD00}Nein{C9C9C9}";}
				case 1:{status2="{FF0000}Ja{C9C9C9}";}
				default:{status2="ERROR";}
			}
		    format(string,sizeof(string),"{C9C9C9}%s: ID:%i | Tank: %.2fL/%.2fL | Rang: %i | Abgeschleppt: %s | Status: %s",VehicleDefinations[Fahrzeug[fv][modelid]-400],Fahrzeug[fv][Vehicle],vFahrzeug[Fahrzeug[fv][Vehicle]][Tank],VehicleInfo[Fahrzeug[fv][modelid]-400][vtankvolumen],Fahrzeug[fv][FraktionsRang],status2,status1);
			SCM(playerid,SAMP_WEISS,string);
			fraktvehiclesspawned++;
		}
	}
	if(fraktvehiclesspawned == 0)return SCM(playerid,SAMP_WEISS,"Keine Vorhanden.");
	return 1;
}

