		    else ShowMenuForPlayer(DriveinMenu[1],playerid);
		    TogglePlayerControllable(playerid,false);
		    return SetPlayerCheckpoint(playerid,DriveInPos[did][Deatx],DriveInPos[did][Deaty],DriveInPos[did][Deatz],2.0);
		}
		new nearestzig = ReturnZTM(playerid);
	    if(nearestzig != -1)
		{
			if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst vom Fahrzeug aus auf keine Zigarettenautomat zugreifen.");
		    if(ZigAutomatInfo[nearestzig][Zigarrets] <= 0)return SCM(playerid,SAMP_WEISS,"Zigarettenautomat nicht mit genug Zigarenschachteln befüllt!");
			if((GetACMoney(playerid) - 8) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
			if((Spieler[playerid][pZigarets] + 10) > 100)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen!");
			Spieler[playerid][pZigarets] += 10;
		    ACMoney(playerid,-8);
		    ZigAutomatInfo[nearestzig][Zigarrets]--;
		    return SCM(playerid,SAMP_WEISS,""IINFO" du hast dir eine Packung Zigaretten für 8$ gekauft! Nutze sie mit '/use zigarette'.");
		}
		if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
		{
 			if(ReturnFbankPointID(playerid) != -1)
			{
				if(!isPlayerInFrakt(playerid,Fraktionsbase[ReturnFbankPointID(playerid)][fbasefraktid]))return SCM(playerid,SAMP_WEISS,""IINFO" das gehört nicht deiner Fraktion!");
				{
					OnPlayerCommandText(playerid,"/frakmenu");
				}
				return 1;
			}
		}
		new jobtime = Spieler[playerid][pJobSperre]-gettime(),jobinviteid = ReturnJobInviteID(playerid);
		if(jobinviteid != -1)
		{
			//if(!isPlayerInJob(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits in einem Job tätig.");
			if(Spieler[playerid][WorkInJob] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du arbeitest momentan und kannst somit keinen Job annehmen! (Kündigen mit /quitjob)");
			if(gettime() < jobtime)
			{
				format(string,sizeof(string),""IINFO" du kannst erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten wieder einen neuen Job annehmen!",floatround(jobtime/60),floatround(jobtime%60));
				return SCM(playerid,SAMP_WEISS,string);
			}
	 		if(Spieler[playerid][pPersoLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Personalausweis.");
			ShowPlayerJobAnnahme(playerid);
			return 1;
		}
	}
    if(newkeys & KEY_FIRE)
    {
        if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
		    if(((isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,15)) && Spieler[playerid][pDuty] != 0) || isPlayerInJob(playerid,12))
		    {
				if(GetVehicleModel(vehicleid) == 525)
				{
					new Float:x,Float:y,Float:z;
					if(IsTrailerAttachedToVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits ein Fahrzeug angehängt.");
	                GetVehiclePos(vehicleid,x,y,z);
				    for(new i=0;i<MAX_VEHICLES;i++)
				    {
					    if(IsValidVehicle(i) && i != vehicleid)
					    {
						    if(IsVehicleInRangeOfPoint(i,7.5,x,y,z))
							{
							    if(isPlayerInJob(playerid,12) && Spieler[playerid][pDuty] == 0 && vFahrzeug[i][FailGas] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug hat keine falsche Tankfüllung getankt.");
								AttachTrailerToVehicle(i,vehicleid);
							    format(string,sizeof(string),""IINFO" du hast ein Fahrzeug: "IINFO2"%s"#HTML_WEISS" angehängt.",VehicleDefinations[GetVehicleModel(i)-400]);
							    SCM(playerid,SAMP_WEISS,string);
							    return 1;
						    }
					    }
				    }
			    }
		    }
	    }
	    if(GetPlayerWeapon(playerid) == WEAPON_SPRAYCAN)
	    {
		    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
		    {
			    KillTimer(Spieler[playerid][pSpraytagTimer]);
				Spieler[playerid][pSpraytagTimer]=SetTimerEx("Spraytag",5000,false,"ii",playerid,0);
			}
			if((isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,11)) && Spieler[playerid][pDuty] != 0)
			{
			    KillTimer(Spieler[playerid][pSpraytagTimer]);
				Spieler[playerid][pSpraytagTimer]=SetTimerEx("Spraytag",5000,false,"ii",playerid,1);
			}
	    }
    }
    if(newkeys & KEY_NO)
    {
    	if(IsPlayerInRangeOfPoint(playerid,9,1396.1912,-1146.7310,-82.6553)){
			OnPlayerCommandText(playerid,"/stadthalle_3");
		}
		else if(IsPlayerInRangeOfPoint(playerid,3,1106.6384,1529.5654,4452.4810)){
			OnPlayerCommandText(playerid,"/bank_3");
		}
  		else if(IsPlayerInRangeOfPoint(playerid,2,2295.8540,746.2546,1011.4030)){
			OnPlayerCommandText(playerid,"/klingel");
		}
		else if(IsPlayerInRangeOfPoint(playerid,2,939.1341,-1661.2390,13.5491)){
			OnPlayerCommandText(playerid,"/woistetwaswoistwas");
		}
		else if(IsPlayerInRangeOfPoint(playerid,2,2006.7079,-1784.2205,13.6013)){
			OnPlayerCommandText(playerid,"/jtmenu");
		}
 		else if(IsPlayerInRangeOfPoint(playerid,2,580.9268,-1807.8909,6.0779)){
			OnPlayerCommandText(playerid,"/mfahrzeug");
		}
 		else if(IsPlayerInRangeOfPoint(playerid,2,1103.0515,1529.5653,4452.4810)){
			OnPlayerCommandText(playerid,"/safe");
		}
 		else if(IsPlayerInRangeOfPoint(playerid,2,-2033.4276,-117.4092,1035.1719)){
			OnPlayerCommandText(playerid,"/fahrschule");
		}
		if(Spieler[playerid][pTazerInorOutbag] == 1)
        {
	        if(Spieler[playerid][pDeath] == 0)
	        {
			    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
				{
				    if(Spieler[playerid][pTazer] == 0 && Spieler[playerid][pTazerInorOutbag] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Tazer dabei/rausgelegt.");
				    if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
				    new Float:x,Float:y,Float:z;
				    GetPlayerPos(playerid,x,y,z);
					ForEachPlayer(i)
					{
						if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i)
					 	{
							if(IsPlayerInRangeOfPoint(i,3.0,x,y,z) && Spieler[i][pDuty] == 0 && Spieler[i][pTazerd] == 0)
							{
								if(IsPlayerInAnyVehicle(i))return SCM(playerid,SAMP_WEISS,"Spieler sitzt in einem Fahrzeug.");
								if(Spieler[i][pTazerd] != 0 && Spieler[i][pDeath] != 0)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits getazert./Spieler ist verletzt.");
								if(Spieler[playerid][pTazerAkku] != 0)
								{
									if(Spieler[playerid][pTazerAkku] <= 5)
									{
										TazerTimer[i] = SetTimerEx("UnTazer",2000,false,"i",i);
										format(string,sizeof(string),"** %s streckt %s mit einem mildem Stromschock nieder **",SpielerName(playerid),SpielerName(i));
										PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
										SCM(playerid,SAMP_WEISS,"Dein Tazerakku gibt langsam den Geist auf,lade ihn in einem Fahrzeug auf!");
									}
									else if(Spieler[playerid][pTazerAkku] <= 30)
									{
										TazerTimer[i] = SetTimerEx("UnTazer",10000,false,"i",i);
										format(string,sizeof(string),"** %s streckt %s mit einem beschränktem Stromschock nieder **",SpielerName(playerid),SpielerName(i));
										PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
									}
									else if(Spieler[playerid][pTazerAkku] <= 90)
									{
										TazerTimer[i] = SetTimerEx("UnTazer",20000,false,"i",i);
										format(string,sizeof(string),"** %s streckt %s mit einem teilweise starken Stromschock nieder **",SpielerName(playerid),SpielerName(i));
										PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
									}
									else if(Spieler[playerid][pTazerAkku] >= 90)
									{
									    TazerTimer[i] = SetTimerEx("UnTazer",30000,false,"i",i);
										format(string,sizeof(string),"** %s streckt %s mit einem starken Stromschock nieder **",SpielerName(playerid),SpielerName(i));
										PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
									}
									format(string,sizeof(string),"** %s hat dich getazert sodass du nicht flüchten kannst **",SpielerName(playerid));
									SCM(i,SAMP_WEISS,string);
									GameTextForPlayer(i,"~r~Geschockt",3000,3);
									TogglePlayerControllable(i,false);
									Spieler[i][pTazerd] = 1;
									LoopingAnim(i,"CRACK","crckdeth2",4.0,1,0,0,0,0);
								}
								else
								{
									format(string,sizeof(string),"** %s versucht %s niederzustrecken,vergeblich **",SpielerName(playerid),SpielerName(i));
									PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
									SCM(playerid,SAMP_WEISS,"Dein Tazerakku ist leer,lade ihn auf bevor du versuchst Leute niederzustrecken!");
								}
								return 1;
							}
						}
					}
					return SCM(playerid,SAMP_WEISS,"Kein Spieler in reichweite für einen Tazer.");
			    }
		    }
	    }
    }
    if(newkeys & KEY_NO)
    {
    	if(Spieler[playerid][pViewStats] != false)
		{
		    Spieler[playerid][pViewStats] = false;
			for(new i=0;i<19;i++)
			{
			    PlayerTextDrawHide(playerid,STATSdraw[playerid][i]);
				PlayerTextDrawDestroy(playerid,STATSdraw[playerid][i]);
			}
		}
		return 1;
	}
    if(newkeys & KEY_SECONDARY_ATTACK)
    {
 	 	new nearestsprunk = ReturnSPRUNKID(playerid);
	 	if(nearestsprunk != -1)
	 	{
	 	    if(GetPVarInt(playerid,"UseSprunk") == 0)
	 	    {
		 	    if(SprunkInfo[nearestsprunk][EGmBhHp] <= 0)
		 	    {
		 	        SCM(playerid,SAMP_WEISS,""IINFO" der Sprunkautomat ist kaputt, bitte rufe den "IINFO2"Techniker"#HTML_WEISS" an!");
		 	        return 1;
		 	    }
		  		if(SprunkInfo[nearestsprunk][SprunkInhalt] <= 0)
		 	    {
			 		SCM(playerid,SAMP_WEISS,""IINFO" der Sprunkautomat ist leer!");
			 		return 1;
				}
				if(GetACMoney(playerid) < 15)
				{
				    SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genügend Geld dabei! (15$)");
				    PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
				    return 1;
				}
				SprunkInfo[nearestsprunk][SprunkInhalt] --;
				SetTimerEx("GetSprunk",3329,false,"i",playerid);
				ApplyAnimation(playerid,"VENDING","VEND_Use_pt2",4.0,false,true,true,false,0,SYNC_ALL);
				PlayerPlaySound(playerid,1054,0.0,0.0,0.0);
				SetPVarInt(playerid,"Sprunkcooldown",gettime()+(60*1));
				SCM(playerid,SAMP_WEISS,""IINFO" du hast ein Dose "IINFO2"Sprunk"#HTML_WEISS" gekauft!");
				ACMoney(playerid, -15);
				//BizzInfo[5][bKasse] += 15;
				new Float:Leben;
				GetPlayerHealth(playerid,Leben);
				if(Leben + 15 >=100)
				{
					SetPlayerACHealth(playerid,100);
				}
				else
				{
					SetPlayerACHealth(playerid,Leben+15);
				}
				SetPVarInt(playerid,"UseSprunk",1);
			}
	  	}
        if(Spieler[playerid][pDeath] != 0)return 1;
	    if(gPlayerUsingLoopingAnim[playerid] == true) StopLoopingAnim(playerid),TextDrawHideForPlayer(playerid,InfoSign),PlayerTextDrawHide(playerid,INFOdraw[playerid][2]);
		for(new haus=1;haus<MAX_HAUS;haus++)
		{
			if(HausInfo[haus][hauscreatet] == 1)
			{
			 	if(IsPlayerInRangeOfPoint(playerid,1.5,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]))
				{
					if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
					if(HausInfo[haus][haus_innenraum] == 255)return GameTextForPlayer(playerid,"~r~unbetrettbar",1000,1);
				    new hausrent = Spieler[playerid][pRentHome];
				    if(HausInfo[haus][haus_locked] == 1)
					{
						if(!strcmp(HausInfo[haus][haus_besitzer],Spieler[playerid][pName],true))
						{
							//if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du das Haus betrittst/verlässt!");
						    SetPlayerPosEx(playerid,Homestore[HausInfo[haus][haus_innenraum]][Hx],Homestore[HausInfo[haus][haus_innenraum]][Hy],Homestore[HausInfo[haus][haus_innenraum]][Hz]);
						    SetPlayerInterior(playerid,Homestore[HausInfo[haus][haus_innenraum]][Hint]);
						    SetPlayerVirtualWorld(playerid,haus);
						    format(string,sizeof(string),""IINFO" du hast das Haus von %s betreten.",HausInfo[haus][haus_besitzer]);
						    SCM(playerid,SAMP_WEISS,string);
						    SpielerSicherheit(playerid);
						    return 1;
						}
						if(haus == hausrent)
						{
							//if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du das Haus betrittst/verlässt!");
						    SetPlayerPosEx(playerid,Homestore[HausInfo[haus][haus_innenraum]][Hx],Homestore[HausInfo[haus][haus_innenraum]][Hy],Homestore[HausInfo[haus][haus_innenraum]][Hz]);
						    SetPlayerInterior(playerid,Homestore[HausInfo[haus][haus_innenraum]][Hint]);
						    SetPlayerVirtualWorld(playerid,haus);
						    format(string,sizeof(string),""IINFO" du hast das Haus von %s betreten.",HausInfo[haus][haus_besitzer]);
						    SCM(playerid,SAMP_WEISS,string);
						    SpielerSicherheit(playerid);
							return 1;
						}
						return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
					}
					//if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du das Haus betrittst/verlässt!");
				    SetPlayerPosEx(playerid,Homestore[HausInfo[haus][haus_innenraum]][Hx],Homestore[HausInfo[haus][haus_innenraum]][Hy],Homestore[HausInfo[haus][haus_innenraum]][Hz]);
				    SetPlayerInterior(playerid,Homestore[HausInfo[haus][haus_innenraum]][Hint]);
				    SetPlayerVirtualWorld(playerid,haus);
				    format(string,sizeof(string),""IINFO" du hast das Haus von %s betreten.",HausInfo[haus][haus_besitzer]);
				    SCM(playerid,SAMP_WEISS,string);
				    SpielerSicherheit(playerid);
				    return 1;
			    }
			 	if(HausInfo[haus][haus_innenraum] != 255)
			    {
				    if(IsPlayerInRangeOfPoint(playerid,1.5,Homestore[HausInfo[haus][haus_innenraum]][Hx],Homestore[HausInfo[haus][haus_innenraum]][Hy],Homestore[HausInfo[haus][haus_innenraum]][Hz]) && GetPlayerVirtualWorld(playerid) == haus)
					{
						if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
					    new hausrent = Spieler[playerid][pRentHome];
					    if(HausInfo[haus][haus_locked] == 1)
						{
							if(!strcmp(HausInfo[haus][haus_besitzer],Spieler[playerid][pName],true))
							{
								//if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du das Haus betrittst/verlässt!");
								SetPlayerPosEx(playerid,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]);
								format(string,sizeof(string),""IINFO" du hast das Haus von %s verlassen.",HausInfo[haus][haus_besitzer]);
							    SCM(playerid,SAMP_WEISS,string);
								SetPlayerVirtualWorld(playerid,0);
								SetPlayerInterior(playerid,0);
								SpielerSicherheit(playerid);
								return 1;
							}
							if(haus == hausrent)
							{
								//if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du das Haus betrittst/verlässt!");
								SetPlayerPosEx(playerid,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]);
								format(string,sizeof(string),""IINFO" du hast das Haus von %s verlassen.",HausInfo[haus][haus_besitzer]);
							    SCM(playerid,SAMP_WEISS,string);
								SetPlayerVirtualWorld(playerid,0);
								SetPlayerInterior(playerid,0);
								SpielerSicherheit(playerid);
								return 1;
							}
							return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
						}
						//if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du das Haus betrittst/verlässt!");
						SetPlayerPosEx(playerid,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]);
						format(string,sizeof(string),""IINFO" du hast das Haus von %s verlassen.",HausInfo[haus][haus_besitzer]);
					    SCM(playerid,SAMP_WEISS,string);
						SetPlayerVirtualWorld(playerid,0);
						SetPlayerInterior(playerid,0);
						SpielerSicherheit(playerid);
						return 1;
					}
				}
			}
		}
		for(new biz=1;biz<MAX_BIZ;biz++)
		{
			if(BizInfo[biz][bizcreatet] == 1)
			{
				if(BizInfo[biz][biz_art] != 10 && BizInfo[biz][biz_art] != 11 && BizInfo[biz][biz_art] != 12 && BizInfo[biz][biz_art] != 14)//tankstelle//Fahrzeugvermietung//paintball
				{
					if(IsPlayerInRangeOfPoint(playerid,1.5,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]))
					{
						if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
						if(BizInfo[biz][biz_locked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
						//if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du das Business betrittst/verlässt!");
						if(BizInfo[biz][biz_art] == 7 || BizInfo[biz][biz_art] == 15)//club,Kart-Bahn
						{
							if((GetACMoney(playerid) - BizInfo[biz][biz_artikel][0]) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Geld.");
							ACMoney(playerid,-BizInfo[biz][biz_artikel][0]);
						    BizInfo[biz][biz_geldkasse] += BizInfo[biz][biz_artikel][0];
						    format(string,sizeof(string),""IINFO" du hast %i$ als Eintrittsgeld gezahlt.",BizInfo[biz][biz_artikel][0]);
						    SCM(playerid,SAMP_WEISS,string);
						}
						SetPlayerPosEx(playerid,bIntInfo[BizInfo[biz][biz_interior]][bIntX],bIntInfo[BizInfo[biz][biz_interior]][bIntY],bIntInfo[BizInfo[biz][biz_interior]][bIntZ]);
					    SetPlayerInterior(playerid,bIntInfo[BizInfo[biz][biz_interior]][bInt]);
					    SetPlayerVirtualWorld(playerid,biz);
					    format(string,sizeof(string),"Willkommen im %s!",BizName(biz));
					    SCM(playerid,SAMP_WEISS,string);
					    SpielerSicherheit(playerid);
					    return 1;
				    }
				    if(IsPlayerInRangeOfPoint(playerid,1.5,bIntInfo[BizInfo[biz][biz_interior]][bIntX],bIntInfo[BizInfo[biz][biz_interior]][bIntY],bIntInfo[BizInfo[biz][biz_interior]][bIntZ]) && GetPlayerVirtualWorld(playerid) == biz)
					{
						if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
						if(BizInfo[biz][biz_locked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
						//if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du das Business betrittst/verlässt!");
						SetPlayerPosEx(playerid,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]);
						SetPlayerVirtualWorld(playerid,0);
						SetPlayerInterior(playerid,0);
						SpielerSicherheit(playerid);
						return 1;
					}
				}
			}
		}
		for(new sm=1;sm<MAX_SMARKETS;sm++)
		{
			if(SmarkInfo[sm][screatet] == 1)
			{
				if(IsPlayerInRangeOfPoint(playerid,1.5,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]))
				{
					if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
					if(SmarkInfo[sm][sfraktid] == 0)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
					if(SmarkInfo[sm][slocked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
					if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du den Schwarzmarkt betrittst/verlässt!");
				    SetPlayerPosEx(playerid,944.8334,788.1722,-18.9141);
				    SetPlayerInterior(playerid,0);
				    SetPlayerVirtualWorld(playerid,sm);
				    format(string,sizeof(string),"Willkommen im Schwarzmarkt der Fraktion %s!",FraktionsName(SmarkInfo[sm][sfraktid]));
				    SCM(playerid,SAMP_WEISS,string);
				    PlayerTextDrawShow(playerid,INFOdraw[playerid][0]);
					PlayerTextDrawSetString(playerid,INFOdraw[playerid][0],"~b~Taste N:~n~~w~beliebigen Gegenstand kaufen");
				    SpielerSicherheit(playerid);
				    return 1;
			    }
			    if(IsPlayerInRangeOfPoint(playerid,1.5,944.8334,788.1722,-18.9141) && GetPlayerVirtualWorld(playerid) == sm)
				{
					if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
					if(SmarkInfo[sm][slocked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
					if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten bevor du den Schwarzmarkt betrittst/verlässt!");
					SetPlayerPosEx(playerid,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]);
					SetPlayerVirtualWorld(playerid,0);
					SetPlayerInterior(playerid,0);
					PlayerTextDrawHide(playerid,INFOdraw[playerid][0]);
					SpielerSicherheit(playerid);
					return 1;
				}
			}
		}
		for(new i=0;i<MAX_ENTERS;i++)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.5,enterexits[i][aX],enterexits[i][aY],enterexits[i][aZ]) && GetPlayerVirtualWorld(playerid) == enterexits[i][aVirtualWorld] && GetPlayerInterior(playerid) == enterexits[i][aInterior])
			{
				if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
				if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten, bevor du das Gebäude betrittst/verlässt!");
				SetPlayerPosEx(playerid,enterexits[i][iX],enterexits[i][iY],enterexits[i][iZ]);
				SetPlayerInterior(playerid,enterexits[i][iInterior]);
				SetPlayerVirtualWorld(playerid,enterexits[i][iVirtualworld]);
				GameTextForPlayer(playerid,enterexits[i][EintrittsText],2000,1);
				SpielerSicherheit(playerid);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,1.5,enterexits[i][iX],enterexits[i][iY],enterexits[i][iZ]) && GetPlayerVirtualWorld(playerid) == enterexits[i][iVirtualworld] && GetPlayerInterior(playerid) == enterexits[i][iInterior])
			{
				if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
				if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten, bevor du das Gebäude betrittst/verlässt!");
				SetPlayerPosEx(playerid,enterexits[i][aX],enterexits[i][aY],enterexits[i][aZ]);
				SetPlayerInterior(playerid,enterexits[i][aInterior]);
				SetPlayerVirtualWorld(playerid,enterexits[i][aVirtualWorld]);
				GameTextForPlayer(playerid,enterexits[i][AustrittsText],2000,1);
				SpielerSicherheit(playerid);
				if(i == 1 && Spieler[playerid][pTrainingFightstyle] != 0)
				{
					Spieler[playerid][pTrainingFightstyle] = 0;
				    Spieler[playerid][pFightstyleEinheiten] = 0;
				    Spieler[playerid][pFightstyleArt] = 0;
				    DisablePlayerCheckpoint(playerid);
					SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Wenn du meinst nicht trainieren zu müssen ... Okay!");
				}
				return 1;
			}
		}
		for(new i=0;i<sizeof(Fraktionsbase);i++)
		{
		if(IsPlayerInRangeOfPoint(playerid,1.5,Fraktionsbase[i][fbaseenterX],Fraktionsbase[i][fbaseenterY],Fraktionsbase[i][fbaseenterZ]) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
		{
			if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
			if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten, bevor du das Gebäude betrittst/verlässt!");
			if(!isPlayerInFrakt(playerid,Fraktionsbase[i][fbasefraktid]))
			{
				if(Fraktionsbase[i][fbaselocked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
			}
			SetPlayerPosEx(playerid,Fraktionsbase[i][fbaseexitX],Fraktionsbase[i][fbaseexitY],Fraktionsbase[i][fbaseexitZ]);
			SetPlayerInterior(playerid,Fraktionsbase[i][fbaseinterior]);
			SetPlayerVirtualWorld(playerid,Fraktionsbase[i][fbasevirtualworld]);
			format(string,sizeof(string),"~g~%s",Fraktionsbase[i][fbase3DText]);
			GameTextForPlayer(playerid,string,2000,1);
			SpielerSicherheit(playerid);
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,1.5,Fraktionsbase[i][fbaseexitX],Fraktionsbase[i][fbaseexitY],Fraktionsbase[i][fbaseexitZ]) && GetPlayerVirtualWorld(playerid) == Fraktionsbase[i][fbasevirtualworld] && GetPlayerInterior(playerid) == Fraktionsbase[i][fbaseinterior])
		{
			if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
			if(gettime() < Spieler[playerid][pEnterExits])return SCM(playerid,SAMP_WEISS,""IINFO" du musst warten, bevor du das Gebäude betrittst/verlässt!");
		    if(!isPlayerInFrakt(playerid,Fraktionsbase[i][fbasefraktid]))
			{
				if(Fraktionsbase[i][fbaselocked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
			}
			SetPlayerPosEx(playerid,Fraktionsbase[i][fbaseenterX],Fraktionsbase[i][fbaseenterY],Fraktionsbase[i][fbaseenterZ]);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			SpielerSicherheit(playerid);
			return 1;
		}
		}
		if(IsPlayerInRangeOfPoint(playerid,1,-219.6105,1408.2527,27.7656) && GetPlayerInterior(playerid) == 18 && PlayerInNewsVan[playerid] != -1 && GetPlayerVirtualWorld(playerid) == PlayerInNewsVan[playerid]+1000)
		{
			new Float:VehPos[3];
			GetVehiclePos(PlayerInNewsVan[playerid],VehPos[0],VehPos[1],VehPos[2]);
			SetPlayerPosEx(playerid,VehPos[0] + 2,VehPos[1] + 2,VehPos[2]);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			PlayerInNewsVan[playerid] = -1;
		}
		if(IsPlayerInRangeOfPoint(playerid,1,767.9480,1402.6608,-4.5741) && GetPlayerInterior(playerid) == 0 && PlayerInJourney[playerid] != -1 && GetPlayerVirtualWorld(playerid) == PlayerInJourney[playerid])
		{
			new Float:VehPos[3];
			GetVehiclePos(PlayerInJourney[playerid],VehPos[0],VehPos[1],VehPos[2]);
			SetPlayerPosEx(playerid,VehPos[0] + 2,VehPos[1] + 2,VehPos[2]);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			PlayerInJourney[playerid] = -1;
		}
    }
    if(Spieler[playerid][pTrainingFightstyle] != 0)
    {
	    if(newkeys & KEY_CROUCH)
	    {
	        if(IsPlayerInCheckpoint(playerid) && IsPlayerInRangeOfPoint(playerid,1.0,772.4760,5.4098,1000.7802))
	        {
			    Spieler[playerid][pFightstyleEinheiten]++;
			    format(string,sizeof(string),"{FF6666}Trainer:{FFFFFF} Noch %i !!!",20-Spieler[playerid][pFightstyleEinheiten]);
			    SCM(playerid,0x4BB400FF,string);
			    if(Spieler[playerid][pFightstyleEinheiten] >= 20)
			    {
				    SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} So,nun laufe eine Minute auf dem Laufband.");
				    SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Drücke immer nacheinander die 'SPRINT-TASTE'.");
				    Spieler[playerid][pTrainingFightstyle] = 2;
				    Spieler[playerid][pFightstyleEinheiten] = 0;
				    DisablePlayerCheckpoint(playerid);
				    SetPlayerCheckpoint(playerid,773.4308,-2.8368,1000.8479,1.0);
			    }
		    }
	    }
	    if(newkeys & KEY_SPRINT)
	    {
		    if(IsPlayerInCheckpoint(playerid) && IsPlayerInRangeOfPoint(playerid,2.0,773.4308,-2.8368,1000.8479))
		    {
			    Spieler[playerid][pFightstyleEinheiten]++;
			    switch(Spieler[playerid][pFightstyleEinheiten])
			    {
				    case 20: SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Komm schon noch 80 mal!");
				    case 40: SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Komm schon noch 60 mal!");
				    case 60: SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Komm schon noch 40 mal!");
				    case 80: SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Komm schon noch 20 mal!");
				    case 90: SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Komm schon noch 10 mal!");
			    }
			    if(Spieler[playerid][pFightstyleEinheiten] >= 100)
			    {
				    SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Gut an mangelnder Kondition leidest du wohl nicht.");
				    SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Jetzt schlägst du 10 mal gegen den Boxsack.");
					Spieler[playerid][pTrainingFightstyle] = 3;
				    Spieler[playerid][pFightstyleEinheiten] = 0;
				    DisablePlayerCheckpoint(playerid);
				    SetPlayerCheckpoint(playerid,769.5408,-2.5419,1000.7239,1.0);
			    }
		    }
		}
	    if(newkeys & KEY_FIRE)
	    {
	        if(IsPlayerInCheckpoint(playerid) && IsPlayerInRangeOfPoint(playerid,1.0,769.5408,-2.5419,1000.7239))
	        {
			    Spieler[playerid][pFightstyleEinheiten]++;
			    format(string,sizeof(string),"{FF6666}Trainer:{FFFFFF} Komm schon noch %i mal!",10-Spieler[playerid][pFightstyleEinheiten]);
			    SCM(playerid,0x4BB400FF,string);
			    if(Spieler[playerid][pFightstyleEinheiten] >= 10)
			    {
				    SCM(playerid,0x4BB400FF,"{FF6666}Trainer:{FFFFFF} Schönes Training,ich glaube du kannst soweit alles.");
					switch(Spieler[playerid][pFightstyleArt])
					{
					case 1:
					{
						if((GetACMoney(playerid) - 5000) < 0)
						{
							Spieler[playerid][pTrainingFightstyle] = 0;
						    Spieler[playerid][pFightstyleEinheiten] = 0;
						    Spieler[playerid][pFightstyleArt] = 0;
						    DisablePlayerCheckpoint(playerid);
							return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
						}
						ACMoney(playerid,-5000);
						SCM(playerid,0x4BB400FF,"Herzlichen Glückwunsch,du hast den Kampfstyle <Boxen> erlernt.");
						SetPlayerFightingStyle(playerid,FIGHT_STYLE_BOXING);
					}
					case 2:
					{
					    if((GetACMoney(playerid) - 5000) < 0)
						{
							Spieler[playerid][pTrainingFightstyle] = 0;
						    Spieler[playerid][pFightstyleEinheiten] = 0;
						    Spieler[playerid][pFightstyleArt] = 0;
						    DisablePlayerCheckpoint(playerid);
							return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
						}
						ACMoney(playerid,-5000);
						SCM(playerid,0x4BB400FF,"Herzlichen Glückwunsch,du hast den Kampfstyle <Kung Fu> erlernt.");
						SetPlayerFightingStyle(playerid,FIGHT_STYLE_KUNGFU);
					}
					case 3:
					{
					    if((GetACMoney(playerid) - 5000) < 0)
						{
							Spieler[playerid][pTrainingFightstyle] = 0;
						    Spieler[playerid][pFightstyleEinheiten] = 0;
						    Spieler[playerid][pFightstyleArt] = 0;
						    DisablePlayerCheckpoint(playerid);
							return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
						}
						ACMoney(playerid,-5000);
						SCM(playerid,0x4BB400FF,"Herzlichen Glückwunsch,du hast den Kampfstyle <Kneehead> erlernt.");
						SetPlayerFightingStyle(playerid,FIGHT_STYLE_KNEEHEAD);
					}
					case 4:
					{
					    if((GetACMoney(playerid) - 5000) < 0)
						{
							Spieler[playerid][pTrainingFightstyle] = 0;
						    Spieler[playerid][pFightstyleEinheiten] = 0;
						    Spieler[playerid][pFightstyleArt] = 0;
						    DisablePlayerCheckpoint(playerid);
							return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
						}
						ACMoney(playerid,-5000);
						SCM(playerid,0x4BB400FF,"Herzlichen Glückwunsch,du hast den Kampfstyle <Grabkick> erlernt.");
						SetPlayerFightingStyle(playerid,FIGHT_STYLE_GRABKICK);
					}
					case 5:
					{
					    if((GetACMoney(playerid) - 5000) < 0)
						{
							Spieler[playerid][pTrainingFightstyle] = 0;
						    Spieler[playerid][pFightstyleEinheiten] = 0;
						    Spieler[playerid][pFightstyleArt] = 0;
						    DisablePlayerCheckpoint(playerid);
							return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
						}
						ACMoney(playerid,-5000);
						SCM(playerid,0x4BB400FF,"Herzlichen Glückwunsch,du hast den Kampfstyle <Elbow> erlernt.");
						SetPlayerFightingStyle(playerid,FIGHT_STYLE_ELBOW);
					}
					}
					Spieler[playerid][pTrainingFightstyle] = 0;
				    Spieler[playerid][pFightstyleEinheiten] = 0;
				    Spieler[playerid][pFightstyleArt] = 0;
				    DisablePlayerCheckpoint(playerid);
				}
		    }
	    }
    }

    if(newkeys & KEY_SUBMISSION)
    {
	   	if(IsVehicleATransportplane3(vehicleid) && isPlayerInJob(playerid,3) && fjobgo2[playerid] != 0)
	    {
		    if(fjobgoaktivatewater[playerid] == 0) fjobgoaktivatewater[playerid] = 1;
			else fjobgoaktivatewater[playerid] = 0;
		}
	}

	if(newkeys & KEY_HANDBRAKE)
	{
		if(Spieler[playerid][pTankArt] != 0)
		{
			if(IsPlayerInVehicle(playerid,Spieler[playerid][pTankVehicle]))
		    {
			    if(Spieler[playerid][pTankState] == false) Spieler[playerid][pTankState] = true;
			    else if(Spieler[playerid][pTankState] == true) Spieler[playerid][pTankState] = false;
		    }
	    }
    }
	if(newkeys & KEY_CTRL_BACK)
	{
		if(ReturnATMID(playerid) != -1 && !IsPlayerInAnyVehicle(playerid))
		{
			if(Spieler[playerid][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Konto bei der Bank of San Andreas.");
			if(ATMInfo[ReturnATMID(playerid)][EGmBhHp] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Bankautomat ist defekt,rufe einen Elektroniker!");
		    if(Spieler[playerid][pWrongBankPinEntry] >= 3)
			{
				SCM(playerid,SAMP_WEISS,"Ihr Bankkonto wurde soeben gesperrt,da du 3 mal den Bank-Pin falsch eingegeben hast.");
				return SCM(playerid,SAMP_WEISS,"Lasse dein Bankkonto in der Bank of San Andreas entsperren um dein Konto wieder verwalten zu können. Dort wird Ihnen dan ein neuer Pin zugestellt.");
			}
			return ShowPlayerDialog(playerid,DIALOG_BANK_PINENTRY,DIALOG_STYLE_PASSWORD,""ClanTagDialoge" ATM",""#HTML_WEISS"Geben Sie Ihren gültigen "IINFO2"Bank-Pin"#HTML_WEISS" ein,um extern auf ihr Bankkonto zugreifen zu können.","Absenden","Abbrechen");
		}
		if(!IsPlayerInAnyVehicle(playerid) && Spieler[playerid][pFreezedInNoDmZone] == 0 && Spieler[playerid][pFreezed] == false && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
		{
			gPlayerUsingLoopingAnim[playerid] = true,SetPlayerSpecialAction(playerid,SPECIAL_ACTION_HANDSUP);
			return 1;
		}
	}
    return 1;
}

public OnRconLoginAttempt(ip[],password[],success)
{
    new string[300];
	if(!success)
	{
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i))
			{
				if(strcmp(ip,SpielerIP(i),true) == 0)
				{
				    Spieler[i][pAntiRconLogins]++;
				    if(Spieler[i][pAntiRconLogins] >= 3)
				    {
					    format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: 3 fehlerhafte RCON-Login Versuche",Spieler[i][pName],i);
						SendClientMessageToAll(SAMP_WEISS,string);
						format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nDer Grund für den Bann von dem Admin System war: 3 fehlerhafte RCON-Login Versuche.\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[i][pName]);
						ShowPlayerDialog(i,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
						BanUser(i,"System","3 fehlerhafte RCON-Login Versuche");
					}
					return 1;
				}
			}
		}
	}
    return 1;
}

public Tutorial4All(playerid,tut)
{
    new Float:Pos[3];
	if(!IsPlayerConnected(playerid))return 1;
	if(IsPlayerNPC(playerid))return 1;
	switch(tut)
	{
		case 1://Gangwar Einführung
		{
			Spieler[playerid][pTutTime4All]++;
			if(Spieler[playerid][pTutTime4All] == 3)
			{
				new gwzone = GWIsPlayerInWarArea(playerid);
				InterpolateCameraPos(playerid,GangwarZones[gwzone][War_FlagX1],GangwarZones[gwzone][War_FlagY1],GangwarZones[gwzone][War_FlagZ1],GangwarZones[gwzone][War_FlagX2],GangwarZones[gwzone][War_FlagY2],GangwarZones[gwzone][War_FlagZ2],2000,CAMERA_MOVE);
				InterpolateCameraLookAt(playerid,GangwarZones[gwzone][War_FlagX1],GangwarZones[gwzone][War_FlagY1],GangwarZones[gwzone][War_FlagZ1],GangwarZones[gwzone][War_FlagX2],GangwarZones[gwzone][War_FlagY2],GangwarZones[gwzone][War_FlagZ2],2000,CAMERA_MOVE);
			}
			if(Spieler[playerid][pTutTime4All] == 6)
			{
				new gwzone = GWIsPlayerInWarArea(playerid);
			    InterpolateCameraPos(playerid,GangwarZones[gwzone][War_FlagX2],GangwarZones[gwzone][War_FlagY2],GangwarZones[gwzone][War_FlagZ2],GangwarZones[gwzone][War_FlagX3],GangwarZones[gwzone][War_FlagY3],GangwarZones[gwzone][War_FlagZ3],2000,CAMERA_MOVE);
				InterpolateCameraLookAt(playerid,GangwarZones[gwzone][War_FlagX2],GangwarZones[gwzone][War_FlagY2],GangwarZones[gwzone][War_FlagZ2],GangwarZones[gwzone][War_FlagX3],GangwarZones[gwzone][War_FlagY3],GangwarZones[gwzone][War_FlagZ3],2000,CAMERA_MOVE);
			}
			if(Spieler[playerid][pTutTime4All] == 9)
			{
				new gwzone = GWIsPlayerInWarArea(playerid);
				GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
			    InterpolateCameraPos(playerid,GangwarZones[gwzone][War_FlagX3],GangwarZones[gwzone][War_FlagY3],GangwarZones[gwzone][War_FlagZ3],Pos[0],Pos[1],Pos[2],2000,CAMERA_MOVE);
				InterpolateCameraLookAt(playerid,GangwarZones[gwzone][War_FlagX3],GangwarZones[gwzone][War_FlagY3],GangwarZones[gwzone][War_FlagZ3],Pos[0],Pos[1],Pos[2],2000,CAMERA_MOVE);
			}
			if(Spieler[playerid][pTutTime4All] >= 11)
			{
				TextDrawHideForPlayer(playerid,InfoSign);
			    PlayerTextDrawHide(playerid,INFOdraw[playerid][2]);
			    Spieler[playerid][pTutTime4All] = 0;
			    TextDrawHideForPlayer(playerid,Introdraw[0]);
			    TextDrawHideForPlayer(playerid,Introdraw[1]);
			    SetPlayerVirtualWorld(playerid,0);
			    SetCameraBehindPlayer(playerid);
			    TogglePlayerControllable(playerid,true);
			    KillTimer(Spieler[playerid][pTutTimer4All]);
			}
			return 1;
		}
		case 2://S-Fight Einführung
		{
			Spieler[playerid][pTutTime4All]++;
			if(Spieler[playerid][pTutTime4All] == 3)
			{
			    for(new sm=1;sm<MAX_SMARKETS;sm++)
			    {
				    if(SmarkInfo[sm][screatet] == 1)
				    {
					    if(IsPlayerInRangeOfPoint(playerid,2.0,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]))
					    {
							GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
						    InterpolateCameraPos(playerid,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz],Pos[0],Pos[1],Pos[2],2000,CAMERA_MOVE);
							InterpolateCameraLookAt(playerid,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz],Pos[0],Pos[1],Pos[2],2000,CAMERA_MOVE);
							return 1;
						}
					}
				}
			}
			if(Spieler[playerid][pTutTime4All] >= 5)
			{
				TextDrawHideForPlayer(playerid,InfoSign);
			    PlayerTextDrawHide(playerid,INFOdraw[playerid][2]);
			    Spieler[playerid][pTutTime4All] = 0;
			    TextDrawHideForPlayer(playerid,Introdraw[0]);
			    TextDrawHideForPlayer(playerid,Introdraw[1]);
			    SetPlayerVirtualWorld(playerid,0);
			    SetCameraBehindPlayer(playerid);
			    TogglePlayerControllable(playerid,true);
			    KillTimer(Spieler[playerid][pTutTimer4All]);
			}
			return 1;
		}
		case 3://Drogen Einführung
		{
			Spieler[playerid][pTutTime4All]++;
			if(Spieler[playerid][pTutTime4All] >= 5)
			{
			    Spieler[playerid][pTutTime4All] = 0;
			    TextDrawHideForPlayer(playerid,InfoSign);
			    TextDrawHideForPlayer(playerid,Introdraw[0]);
			    TextDrawHideForPlayer(playerid,Introdraw[1]);
			    SetPlayerVirtualWorld(playerid,0);
			    SetCameraBehindPlayer(playerid);
			    TogglePlayerControllable(playerid,true);
			    KillTimer(Spieler[playerid][pTutTimer4All]);
			}
			return 1;
		}
		case 4://Szenarion Cam
		{
			SetCameraBehindPlayer(playerid);
			TogglePlayerControllable(playerid,true);
			return 1;
		}
		case 5://Szenario Schiffuntergang
		{
			Spieler[playerid][pTutTime4All]++;
			if(Spieler[playerid][pTutTime4All] == 4)
			{
			}
			if(Spieler[playerid][pTutTime4All] == 8)
			{
			}
			if(Spieler[playerid][pTutTime4All] == 11)
			{
			}
			if(Spieler[playerid][pTutTime4All] >= 12)
			{
			for(new i=0;i<3;i++)
			{
			DestroyPlayerObject(playerid,Spieler[playerid][pTutorialObject][i]);
			}
			TextDrawHideForPlayer(playerid,Introdraw[0]);
		    TextDrawHideForPlayer(playerid,Introdraw[1]);
			KillTimer(Spieler[playerid][pTutTimer4All]);
			}
			return 1;
		}
	}
	return printf("ERROR: Tutorial4All(%i,%i) public nicht erkannt!",playerid,tut);
}
public PlayerLoseHeal()
{
    ForEachPlayer(playerid)
	{
		if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
		{
			if(GetPVarInt(playerid,"Eingeloggt") == 1)
			{
				SetPlayerACHealth(playerid,GetPlayerACHealth(playerid)-2);
			}
		}
	}
	SetTimer("PlayerLoseHeal",59688*2,false);
	return 1;
}
public Server()
{
	ForEachPlayer(playerid)
	{
		if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
		{
			if(GetPVarInt(playerid,"Eingeloggt") == 1)
			{
				UpdatePlayer(playerid);
		    }
	    }
    }
	return 1;
}
public AntiCheat()
{
    ForEachPlayer(playerid)
	{
		if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
		{
			if(GetPVarInt(playerid,"Eingeloggt") == 1 && PlayerSpawned[playerid] == 1)
			{
				UpdateAntiCheat(playerid);
			}
		}
	}
	return 1;
}
public AntiCheat2()
{
    ForEachPlayer(playerid)
	{
		if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
		{
			if(GetPVarInt(playerid,"Eingeloggt") == 1 && PlayerSpawned[playerid] == 1)
			{
				UpdateAntiCheat2(playerid);
			}
		}
	}
	return 1;
}
public ServerTutorial()
{
    ForEachPlayer(playerid)
	{
		if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid) && Spieler[playerid][pViewTutorial] == 0 && ImTutorial[playerid] != 0)
		{
			Spieler[playerid][pTutorialTime]++;
			if(Spieler[playerid][pTutorialTime] >= 1 && Spieler[playerid][AmUmkleiden] == 0)
			{
			    TogglePlayerControllable(playerid,true);
				StopAudioStreamForPlayer(playerid);
				SpamChat(playerid,0);
				TogglePlayerSpectating(playerid,false);
				StopPlayerPlaySound(playerid);
				SetPlayerACHealth(playerid,100);
			    SetPlayerACArmour(playerid,0);
				SetPlayerSkin(playerid,BincoSystemZiviSkins[0][Skinid]);
				SetPlayerPosEx(playerid,1364.5292,-768.7048,98.0179);
				SetPlayerCameraPos(playerid, 1364.9459, -756.2587, 101.8932);
				SetPlayerCameraLookAt(playerid, 1364.8932, -757.2617, 101.6330);
				SetPlayerFacingAngle(playerid,350.3375);
				SetPlayerInterior(playerid,0);
			  	BincoSystem(playerid);
			  	PlayerPlaySound(playerid, 1062, 0.0, 0.0, 10.0);
			}
		}
	}
	return 1;
}
public PayDay()
{
	new string[128];
	ForEachPlayer(playerid)
	{
		if(IsPlayerConnected(playerid) && !IsPlayerNPC(playerid))
		{
			if(GetPVarInt(playerid,"Eingeloggt") == 1)
			{
				if(Spieler[playerid][pAFKPDAYDOWN] == false && Spieler[playerid][pInPrison] == 0 && Spieler[playerid][pStonedAntiSpam] == 0 && Spieler[playerid][pViewTutorial] != 0)
				{
					if(Spieler[playerid][pMinutesAfterPayday] >= 3600)
					{
						new geld = Spieler[playerid][pFraktionsGehalt],price = GetPlayerLevel(playerid) * 25,lohnsteuer,kirchensteuer,solidsteuer;
						SetTimerEx("StopPlayerPlaySound",5000,false,"i",playerid);
