					GiveWeapon(playerid,41,500,false);
					fverwaltungen[Spieler[playerid][pFraktion]][WaffenSlots]--;
					SCM(playerid,SAMP_WEISS,"Waffen erhalten: Deagle,MP-5,Baseballschläger,Spraydose,Shotgun,M4,Messer");
				}
			    if(isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,12))
			    {
			        ResetWeapons(playerid,true);
			    	SaveAccount(playerid);
					GiveWeapon(playerid,24,150,false);
					GiveWeapon(playerid,29,250,false);
					GiveWeapon(playerid,5,1,false);
					GiveWeapon(playerid,25,35,false);
					GiveWeapon(playerid,31,200,false);
					GiveWeapon(playerid,5,1,false);
					fverwaltungen[Spieler[playerid][pFraktion]][WaffenSlots]--;
					//SCM(playerid,SAMP_WEISS,"Waffen erhalten: Deagle,MP-5,Baseballschläger,Shotgun,M4,Messer");
				}
			}
			case 6:
			{
				if(isPlayerInFrakt(playerid,9))
			    {
			        ResetWeapons(playerid,true);
			    	SaveAccount(playerid);
					GiveWeapon(playerid,24,150,false);
					GiveWeapon(playerid,29,250,false);
					GiveWeapon(playerid,8,1,false);
					GiveWeapon(playerid,25,35,false);
					GiveWeapon(playerid,31,200,false);
					GiveWeapon(playerid,8,1,false);
					GiveWeapon(playerid,33,15,false);
					fverwaltungen[Spieler[playerid][pFraktion]][WaffenSlots]--;
					//SCM(playerid,SAMP_WEISS,"Waffen erhalten: Deagle,MP-5,Katana,Shotgun,M4,Messer,Country Rifle");
				}
				if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
			    {
			        ResetWeapons(playerid,true);
			    	SaveAccount(playerid);
					GiveWeapon(playerid,24,150,false);
					GiveWeapon(playerid,29,250,false);
					GiveWeapon(playerid,5,1,false);
					GiveWeapon(playerid,25,35,false);
					GiveWeapon(playerid,31,200,false);
					GiveWeapon(playerid,5,1,false);
					GiveWeapon(playerid,33,15,false);
					GiveWeapon(playerid,41,500,false);
					fverwaltungen[Spieler[playerid][pFraktion]][WaffenSlots]--;
					//SCM(playerid,SAMP_WEISS,"Waffen erhalten: Deagle,MP-5,Baseballschläger,Spraydose,Shotgun,M4,Messer,Country Rifle");
				}
			    if(isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,12))
			    {
			        ResetWeapons(playerid,true);
			    	SaveAccount(playerid);
					GiveWeapon(playerid,24,150,false);
					GiveWeapon(playerid,29,250,false);
					GiveWeapon(playerid,5,1,false);
					GiveWeapon(playerid,25,35,false);
					GiveWeapon(playerid,31,200,false);
					GiveWeapon(playerid,5,1,false);
					GiveWeapon(playerid,33,15,false);
					fverwaltungen[Spieler[playerid][pFraktion]][WaffenSlots]--;
					//SCM(playerid,SAMP_WEISS,"Waffen erhalten: Deagle,MP-5,Baseballschläger,Shotgun,M4,Messer,Country Rifle");
				}
			}
		}
		format(string,sizeof(string),""IINFO" Waffenpack: "IINFO2"%i"#HTML_WEISS" Waffenslots vorhanden: "IINFO2"%i",fverwaltungen[Spieler[playerid][pFraktion]][WaffenPack],fverwaltungen[Spieler[playerid][pFraktion]][WaffenSlots]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" Mitglied: "IINFO2"%s"#HTML_WEISS" hat sich Fraktionswaffen aus der Fraktionsbank genommen.",Spieler[playerid][pName]);
	    SendFraktionsMessage(Spieler[playerid][pFraktion],SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:frakmenu(playerid,const params[])
{
    #pragma unused params
   	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    ShowPlayerFraktionsMenu(playerid);
	}else{
		SCM(playerid,SAMP_WEISS,""IINFO" du darfst das nicht!");
	}
	return 1;
}
COMMAND:fbank(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    if(ReturnFbankPointID(playerid) == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier nicht auf die Fraktionsbank zugreifen!");
	    if(!isPlayerInFrakt(playerid,Fraktionsbase[ReturnFbankPointID(playerid)][fbasefraktid]))return SCM(playerid,SAMP_WEISS,"Frakionsbank ist nicht im besitz deiner Fraktion.");
	    if(isPlayerAMember(playerid,4)){return ShowPlayerDialog(playerid,DIALOG_FKASSE2,DIALOG_STYLE_LIST,""ClanTagDialoge" Fraktionsbank",""#HTML_BLAU"1."#HTML_WEISS" Einzahlen\n"#HTML_BLAU"2."#HTML_WEISS" Auszahlen","Auswählen","Abbrechen");}
		if(isPlayerAMember(playerid,1)){return ShowPlayerDialog(playerid,DIALOG_FKASSE2,DIALOG_STYLE_LIST,""ClanTagDialoge" Fraktionsbank",""#HTML_BLAU"1."#HTML_WEISS" Einzahlen","Auswählen","Abbrechen");}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
