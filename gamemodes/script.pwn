				    return SCM(playerid,SAMP_WEISS,"Bitte gebe nur eine Slot anzahl zwischen 0 und 10 Mietern ein.");
				}
				else
				{
				    HausInfo[MakeHaus[playerid]][haus_slots] = mieter;
				    HausInfo[MakeHaus[playerid]][haus_level] = 0;
				    for(new i=0;i<sizeof(Homestore);i++)
				    {
					    if(HausInfo[MakeHaus[playerid]][haus_slots] >= Homestore[i][Hselectmatch])
					    {
						    strcat(homestorestring,Homestore[i][HInnenraum]);
						    strcat(homestorestring,"\n");
