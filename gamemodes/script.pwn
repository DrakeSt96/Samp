public HideInfoBox(playerid)
{
    new bool:skillgesetzt[MAX_PLAYERS];
	if(!IsPlayerConnected(playerid))return 1;
	if(IsPlayerNPC(playerid))return 1;
	TextDrawHideForPlayer(playerid,InfoSign);
	PlayerTextDrawHide(playerid,INFOdraw[playerid][2]);
	if(skillgesetzt[playerid] == false)
	{
	    SetPlayerWaffenSkill(playerid);
	    skillgesetzt[playerid] = true;
	}
	return 1;
}

public UnTazer(playerid)
{
    if(!IsPlayerConnected(playerid))return 1;
	if(IsPlayerNPC(playerid))return 1;
	SetCameraBehindPlayer(playerid);
	TogglePlayerControllable(playerid,true);
    if(Spieler[playerid][pCuffed] == 1 || Spieler[playerid][pTazerd] == 1)
    {
	    Spieler[playerid][pCuffed] = 0;
	    Spieler[playerid][pTazerd] = 0;
 	}
	//TextDrawHideForPlayer(playerid,BlackScreendraw);
	if(Spieler[playerid][pFreezedInNoDmZone] == 1) Spieler[playerid][pFreezedInNoDmZone] = 0;
	if(!IsPlayerInAnyVehicle(playerid)) ClearAnimations(playerid);
	return 1;
}

public HttpResponse(playerid,response_code,const data[])
{
	printf("Data:%s | %i",data,response_code);
	return 1;
}

public AimbotTest(playerid,Float:x,Float:y,Float:z,Float:rotz)
{
    SetPlayerPos(playerid,x,y,z);
	SetPlayerFacingAngle(playerid,rotz);
	SetCameraBehindPlayer(playerid);
	return 1;
}
