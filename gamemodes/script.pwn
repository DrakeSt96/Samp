					if(strcmp(cmd,"Benzinkanister",true) == 0)
					{
					    if((vFahrzeug[i][KofferraumBenzinkanister] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug  im Fahrzeug.");
					    if((Spieler[playerid][pTankFillBoxes] + Menge) > 10)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
						vFahrzeug[i][KofferraumBenzinkanister] -= Menge;
						Spieler[playerid][pTankFillBoxes] += Menge;
						format(string,sizeof(string),""IINFO" du hast %d Benzinkanister aus dem Fahrzeug genommen! Fahrzeug(Benzinkanister): %d",Menge,vFahrzeug[i][KofferraumBenzinkanister]);
						SCM(playerid,SAMP_WEISS,string);
						format(string,sizeof(string),"** %s nimmt etwas aus dem Kofferraum **",SpielerName(playerid));
						PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
						return 1;
					}
					return SCM(playerid,SAMP_WEISS,""IINFO" /kraum [rausnehmen][Ganja/Kokain/Materials/Opium/Spice/Lunchpakete/C4/Werkzeugkästen/Benzinkanister][Menge]");
				}
			    return SCM(playerid,SAMP_WEISS,""IINFO" /kraum [reinlegen/rausnehmen][Ganja/Kokain/Materials/Spice/Opium/Lunchpakete/C4/Werkzeugkästen/Benzinkanister][Menge]");
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe deines Fahrzeuges oder der Kofferraum eines Fahrzeuges ist nicht geöffnet.");
}
COMMAND:slap(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	if(Paintball[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst das nicht.");
	new pSize,Float:x,Float:y,Float:z;
	if(sscanf(params,"i",pSize))return SCM(playerid,SAMP_WEISS,""IINFO" /slap [Höhe]");
	GetPlayerPos(playerid,x,y,z);
	if(IsPlayerInAnyVehicle(playerid))
	{
		new seatid = GetPlayerVehicleSeat(playerid);
		SetPlayerPosEx(playerid,x,y,z+pSize);
		SetVehiclePosEx(GetPlayerVehicleID(playerid),x,y,z+pSize);
		PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),seatid);
	}
	else SetPlayerPosEx(playerid,x,y,z+pSize);
	return 1;
}
COMMAND:reloadveh(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid,string[128];
    if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" /reloadveh [vehicleid]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
	MotorDown[vehicleid] = 0;
	vFahrzeug[vehicleid][FailGas] = 0;
	vFahrzeug[vehicleid][Tank] = VehicleInfo[GetVehicleModel(vehicleid)-400][vtankvolumen];
	SetVehicleToRespawn(vehicleid);
	format(string,sizeof(string),""IINFO" du hast das Fahrzeug %s (ID:%i) zurück gespawned.",VehicleDefinations[GetVehicleModel(vehicleid)-400],vehicleid);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:gotoveh(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:vehx,Float:vehy,Float:vehz,vehicleid,string[128];
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
	if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" /gotoveh [vehicleid]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
    GetVehiclePos(vehicleid,vehx,vehy,vehz);
	SetPlayerPosEx(playerid,vehx,vehy,vehz);
	SetPlayerInterior(playerid,0);
	SetPlayerVirtualWorld(playerid,GetVehicleVirtualWorld(vehicleid));
	format(string,sizeof(string),""IINFO" du hast dich zum Fahrzeug %s (ID:%i) geportet.",VehicleDefinations[GetVehicleModel(vehicleid)-400],vehicleid);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:getvehhere(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid,Float:x,Float:y,Float:z,Float:a,string[128];
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" /getvehhere [vehicleid]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
	GetPlayerPos(playerid,x,y,z);
    GetPlayerFacingAngle(playerid,a);
	SetVehiclePosEx(vehicleid,x,y,z);
	SetVehicleZAngleEx(vehicleid,a);
	LinkVehicleToInterior(vehicleid,GetPlayerInterior(playerid));
	SetVehicleVirtualWorld(vehicleid,GetPlayerVirtualWorld(playerid));
	format(string,sizeof(string),""IINFO" du hast das Fahrzeug %s (ID:%i) zu dir geportet.",VehicleDefinations[GetVehicleModel(vehicleid)-400],vehicleid);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:beamtenstore(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16))
	{
		if(!IsPlayerInRangeOfPoint(playerid,2.0,2503.9663,-2640.3894,13.8623))return SCM(playerid,SAMP_WEISS,"Nicht am Beamtenstore.");
		return ShowPlayerDialog(playerid,BEAMTEN_STORE,DIALOG_STYLE_LIST,"Beamtenstore","Messer (50$)\nSniper Rifle (3350$)\n9mm Pistole (250$)\nShotgun (1000$)\nDeagle (350$)\nMP-5 (700$)\nAK-47 (2500$)\nM4 (2500$)\nCountry Rifle (1250$)\nSilend 9mm Pistole (150$)\nPfefferspray (50$)\nLunchpakete (100$)","Auswählen","Abbrechen");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:supmobil(playerid,const params[])
{
    if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	ShowPlayerSupMobilMenu(playerid);
	return 1;
}
COMMAND:supmobil_2(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	new string[128],cmd[12],Float:x,Float:y,Float:z;
	if(sscanf(params,"s[12]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /supmobil_2 [Add/Lock/Del]");
    if(strcmp(cmd,"Add",true) == 0)
	{
		if(Spieler[playerid][pSupcar] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits ein Supporter Mobil erstellt.");
		if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
		if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt bereits in einem Fahrzeug.");
		ShowPlayerDialog(playerid,DIALOG_SUPMOB,DIALOG_STYLE_LIST,""#HTML_BLAU"Supporter Mobil",""#HTML_BLAU"1."HTML_WHITE" Sultan\n"#HTML_BLAU"2."HTML_WHITE" Infernus\n"#HTML_BLAU"3."HTML_WHITE" Golf-Wagen\n"#HTML_BLAU"4."HTML_WHITE" Stratum\n"#HTML_BLAU"5."HTML_WHITE" Tug\n"#HTML_BLAU"6."HTML_WHITE" Club\n"#HTML_BLAU"7."HTML_WHITE" Greenwood\n"#HTML_BLAU"8."HTML_WHITE" Hotring Racer\n"#HTML_BLAU"9."HTML_WHITE" Mountain Bike\n"#HTML_BLAU"10."HTML_WHITE" Traktor","Spawn","Abbrechen");
		return 1;
	}
	if(strcmp(cmd,"Lock",true) == 0)
	{
		if(Spieler[playerid][pSupcar] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast kein Supporter Mobil erstellt.");
		GetVehiclePos(Spieler[playerid][pSupcarVehicle],x,y,z);
		GetVehicleParamsEx(Spieler[playerid][pSupcarVehicle],engine,lights,alarm,doors,bonnet,boot,objective);
		if(IsPlayerInRangeOfPoint(playerid,3.0,x,y,z))
		{
			if(lockedveh[Spieler[playerid][pSupcarVehicle]] == false)
			{
			    SetVehicleParamsEx(Spieler[playerid][pSupcarVehicle],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
			    lockedveh[Spieler[playerid][pSupcarVehicle]] = true;
			    GameTextForPlayer(playerid,"~w~Supmobil ~r~abgeschlossen",2000,6);
			    PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
			}
			else if(lockedveh[Spieler[playerid][pSupcarVehicle]] == true)
			{
			    SetVehicleParamsEx(Spieler[playerid][pSupcarVehicle],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
			    lockedveh[Spieler[playerid][pSupcarVehicle]] = false;
			    GameTextForPlayer(playerid,"~w~Supmobil ~g~aufgeschlossen",2000,6);
			    PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe deines Supporter Mobils.");
	}
	if(strcmp(cmd,"Del",true) == 0)
	{
		if(Spieler[playerid][pSupcar] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast kein Supporter Mobil erstellt.");
		if(GetVehicleModel(Spieler[playerid][pSupcarVehicle]) >= 400 && GetVehicleModel(Spieler[playerid][pSupcarVehicle]) <= 611)
		{
		format(string,sizeof(string),""IINFO" du hast dein Supporter Fahrzeug: "IINFO2"%s"#HTML_WEISS" gelöscht.",VehicleDefinations[GetVehicleModel(Spieler[playerid][pSupcarVehicle])-400]);
		SCM(playerid,SAMP_WEISS,string);
		if(IsValidDynamic3DTextLabel(supmobil3Dtext[Spieler[playerid][pSupcarVehicle]])) DestroyDynamic3DTextLabel(supmobil3Dtext[Spieler[playerid][pSupcarVehicle]]);
		DeleteVehicle(Spieler[playerid][pSupcarVehicle]);
		Spieler[playerid][pSupcarVehicle] = -1;
		Spieler[playerid][pSupcar] = false;
		return 1;
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /supmobil_2 [Add/Lock/Del]");
}
COMMAND:delveh(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"In keinem Adminfahrzeug.");
	if(IsAAdminVeh(GetPlayerVehicleID(playerid)) == -1)return SCM(playerid,SAMP_WEISS,"In keinem Adminfahrzeug.");
	DestroyDynamic3DTextLabel(adminveh3Dtext[IsAAdminVeh(GetPlayerVehicleID(playerid))]);
	DeleteVehicle(adminmobile[IsAAdminVeh(GetPlayerVehicleID(playerid))]);
	adminmobile[IsAAdminVeh(GetPlayerVehicleID(playerid))] = -1;
	return 1;
}
COMMAND:delallveh(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],count = 0;
    if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
    for(new a=0;a<MAX_ADMINVEHS;a++)
   	{
	   	if(adminmobile[a] != -1)
	   	{
		   	if(IsVehicleEmpty(adminmobile[a]))
			{
				DestroyDynamic3DTextLabel(adminveh3Dtext[a]);
				DeleteVehicle(adminmobile[a]);
				adminmobile[a] = -1;
				count++;
			}
		}
	}
	format(string,sizeof(string),""ACINFO" %s hat alle Adminfahrzeuge vom Server gelöscht.",Spieler[playerid][pName]);
	SendAdminMessage(GELB,string);
	return 1;
}
COMMAND:reporten(playerid,const params[])
{
	#pragma unused params
    if(isPlayerAnAdmin(playerid,1))
    {
    	ShowPlayerDialog(playerid,DIALOG_REPORTS,DIALOG_STYLE_LIST,"Report - System",""#HTML_BLAU"1. "#HTML_WEISS"Fragen\n"#HTML_BLAU"2. "#HTML_WEISS"Einweisung\n"#HTML_BLAU"3. "#HTML_WEISS"Regelmeldung\n"#HTML_BLAU"4. "#HTML_WEISS"Fraktion\n"#HTML_BLAU"5. "#HTML_WEISS"Donator","Annehmen","Verlassen");
	}
	else
	{
		SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Admin!");
	}
	return 1;
}
COMMAND:veh(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new model,farbe1,farbe2,string[128],index = 0,Float:x,Float:y,Float:z,Float:Angle;
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits in einem Fahrzeug.");
	if(sscanf(params,"iii",model,farbe1,farbe2))return SCM(playerid,SAMP_WEISS,""IINFO" /veh [Model][Farbe1][Farbe2]");
	if(model<400||model>611)return SCM(playerid,SAMP_WEISS,""IINFO" /veh [Model 400-611][Farbe1][Farbe2]");
	if((farbe1<0||farbe1>255) || (farbe2<0||farbe2>255))return SCM(playerid,SAMP_WEISS,""IINFO" /veh [Model][Farbe1 0-255][Farbe2 0-255]");
    for(new a=0;a<MAX_ADMINVEHS;a++)
   	{
	   	if(adminmobile[a] != -1) index++;
   	}
   	if(index == MAX_ADMINVEHS)return SCM(playerid,SAMP_WEISS,""IINFO" es wurde bereits die maximale Anzahl an Adminfahrzeugen erstellt!");
    GetPlayerPos(playerid,x,y,z);
   	GetPlayerFacingAngle(playerid,Angle);
   	format(string,sizeof(string),""IINFO" du hast einen "IINFO2"%s"#HTML_WEISS" erstellt.",VehicleDefinations[model-400]);
   	for(new a=0;a<MAX_ADMINVEHS;a++)
   	{
	   	if(adminmobile[a] == -1)
	   	{
		   	adminmobile[a] = CreateVehicleEx(model,x,y,z,Angle,farbe1,farbe2,-1,false);
		   	GetVehicleParamsEx(adminmobile[a],engine,lights,alarm,doors,bonnet,boot,objective);
			SetVehicleParamsEx(adminmobile[a],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
			lockedveh[adminmobile[a]] = true;
		   	format(string,sizeof(string),"Adminfahrzeug\n"IINFO2"%s",Spieler[playerid][pName]);
		   	adminveh3Dtext[a] = CreateDynamic3DTextLabel(string,SAMP_WEISS,x,y,z,25.0,INVALID_PLAYER_ID,adminmobile[a],1,GetPlayerVirtualWorld(playerid),-1);
			SetVehicleNumberPlate(adminmobile[a],""HTML_WEISS"Admin");
		   	SetVehicleVirtualWorld(adminmobile[a],GetPlayerVirtualWorld(playerid));
		   	LinkVehicleToInterior(adminmobile[a],GetPlayerInterior(playerid));
		   	AddVehicleComponent(adminmobile[a],1010);
		   	PutPlayerInVehicleEx(playerid,adminmobile[a],0);
		   	break;
	   	}
   	}
	return 1;
}
COMMAND:deleventveh(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" in keinem Eventfahrzeug.");
	if(IsAEventVeh(GetPlayerVehicleID(playerid)) == -1)return SCM(playerid,SAMP_WEISS,""IINFO" In keinem Eventfahrzeug.");
	DestroyDynamic3DTextLabel(eventveh3Dtext[IsAEventVeh(GetPlayerVehicleID(playerid))]);
	DeleteVehicle(eventmobile[IsAEventVeh(GetPlayerVehicleID(playerid))]);
	eventmobile[IsAEventVeh(GetPlayerVehicleID(playerid))] = -1;
	return 1;
}
COMMAND:delalleventveh(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],count = 0;
    if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
    for(new e=0;e<MAX_EVENTVEHS;e++)
   	{
	   	if(eventmobile[e] != -1)
	   	{
			DestroyDynamic3DTextLabel(eventveh3Dtext[e]);
			DeleteVehicle(eventmobile[e]);
			eventmobile[e] = -1;
			count++;
		}
	}
	format(string,sizeof(string),""IINFO" %s hat alle Eventfahrzeuge vom Server gelöscht.",Spieler[playerid][pName]);
	SendAdminMessage(SAMP_WEISS,string);
	return 1;
}
COMMAND:eventveh(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new model,string[128],index = 0,Float:x,Float:y,Float:z,Float:Angle;
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits in einem Fahrzeug.");
	if(sscanf(params,"i",model))return SCM(playerid,SAMP_WEISS,""IINFO" /eventveh [Model]");
	if(model<400||model>611)return SCM(playerid,SAMP_WEISS,"Wähle bitte nur Modelid´s zwischen 400 und 611 aus.");
    for(new e=0;e<MAX_EVENTVEHS;e++)
   	{
   	if(eventmobile[e] != -1) index++;
   	}
   	if(index == MAX_EVENTVEHS)return SCM(playerid,SAMP_WEISS,"Es wurde bereits die maximale Anzahl an Eventfahrzeugen erstellt!");
    GetPlayerPos(playerid,x,y,z);
   	GetPlayerFacingAngle(playerid,Angle);
   	format(string,sizeof(string),""IINFO" du hast eine/n %s als Eventfahrzeug erstellt.",VehicleDefinations[model-400]);
   	SCM(playerid,SAMP_WEISS,string);
   	SCM(playerid,SAMP_WEISS,"Benutze '/deleventveh' um ein Eventfahrzeug zu zerstören.");
   	for(new e=0;e<MAX_EVENTVEHS;e++)
   	{
	   	if(eventmobile[e] == -1)
	   	{
		   	eventmobile[e] = CreateVehicleEx(model,x,y,z,Angle,0,0,60,false);
		   	format(string,sizeof(string),""IINFO2"Eventfahrzeug");
		   	eventveh3Dtext[e] = CreateDynamic3DTextLabel(string,SERVERFARBEHEX,x,y,z,25.0,INVALID_PLAYER_ID,eventmobile[e],1,GetPlayerVirtualWorld(playerid),-1,-1);
			SetVehicleNumberPlate(eventmobile[e],""HTML_WEISS"EVT");
		   	SetVehicleVirtualWorld(eventmobile[e],GetPlayerVirtualWorld(playerid));
		   	LinkVehicleToInterior(eventmobile[e],GetPlayerInterior(playerid));
		   	PutPlayerInVehicleEx(playerid,eventmobile[e],0);
		   	break;
	   	}
   	}
	return 1;
}
COMMAND:garage(playerid,const params[])
{
    #pragma unused params
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerInFrakt(playerid,8))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(IsPlayerInRangeOfPoint(playerid,5,313.5800,2832.8267,28.0487))
	{
		if(IsPlayerInAnyVehicle(playerid))
		{
			SetPlayerPosEx(playerid,2309.9966,1796.3206,10.5362);
			SetVehiclePosEx(GetPlayerVehicleID(playerid),2309.9966,1796.3206,10.5362);
	        SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			LinkVehicleToInterior(GetPlayerVehicleID(playerid),0);
			SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),0);
			PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),0);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i) && !IsPlayerNPC(i) && i != playerid)
				{
					if(IsPlayerInVehicle(i,GetPlayerVehicleID(playerid)))
					{
				  		SetPlayerInterior(i,0);
						SetPlayerVirtualWorld(i,0);
					}
				}
			}
		}
		else
		{
			SetPlayerPosEx(playerid,2309.9966,1796.3206,10.5362);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
		}
		return 1;
 	}
 	if(IsPlayerInRangeOfPoint(playerid,5,2309.9966,1796.3206,10.5362))
	{
		if(IsPlayerInAnyVehicle(playerid))
		{
			SetPlayerPosEx(playerid,313.5800,2832.8267,28.0487);
			SetVehiclePosEx(GetPlayerVehicleID(playerid),313.5800,2832.8267,28.0487);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,1);
			LinkVehicleToInterior(GetPlayerVehicleID(playerid),0);
			SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),1);
			PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),0);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i) && !IsPlayerNPC(i) && i != playerid)
				{
					if(IsPlayerInVehicle(i,GetPlayerVehicleID(playerid)))
					{
						SetPlayerInterior(i,0);
						SetPlayerVirtualWorld(i,0);
					}
				}
			}
		}
		else
		{
			SetPlayerPosEx(playerid,313.5800,2832.8267,28.0487);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,1);
		}
		return 1;
 	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keiner Garage.");
}
COMMAND:tresorgate(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:x,Float:y,Float:z;
    GetPlayerPos(playerid,x,y,z);
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,2))
	{
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(robsec != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst während einem Bankraub das Tresorgate nicht schließen.");
    if(!IsPlayerInRangeOfPoint(playerid,5,1472.04,-998.54,44.58))return SCM(playerid,SAMP_WEISS,"Nicht am Tresor.");
	if(torstatus[17] == 0)
	{
		MoveDynamicObject(tor[17],1472.04,-998.54,44.58+6,1);
		torstatus[17] = 1;
		PlayerHearMusicInRange(x,y,z,1035,5,1,500);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
	}
	else
	{
		MoveDynamicObject(tor[17],1472.04,-998.54,44.58,1);
		torstatus[17] = 0;
		PlayerHearMusicInRange(x,y,z,1035,5,1,500);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
	}
	return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:zollinfo(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[8500],closeoropen[25];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst..");
		for(new zollid=0;zollid<MAX_ZOLL;zollid++)
	  	{
		  	switch(Zoll[zollid][zollgesperrt])
		  	{
			  	case 0:{closeoropen="Geöffnet";}
			  	case 1:{closeoropen="Geschlossen";}
		  	}
			format(string,sizeof(string),""#HTML_WEISS"Zoll: "IINFO2"%i"#HTML_WEISS" Kosten: "IINFO2"%i$"#HTML_WEISS" Status: "IINFO2"%s",zollid,Zoll[zollid][zollcash],closeoropen);
			strcat(edit_2,string);
			ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Zoll-Informationen",edit_2,"Okay","");
	  	}
	  	return 1;
  	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:searchzoll(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new zollid,string[650];
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
	{
		if(sscanf(params,"i",zollid))return SCM(playerid,SAMP_WEISS,""IINFO" /searchzoll [Zollid]");
		if(zollid<0||zollid>MAX_ZOLL)
		{
			format(string,sizeof(string),""IINFO" /searchzoll [Zollid 0-%i]",MAX_ZOLL);
			SCM(playerid,SAMP_WEISS,string);
		}
		format(string,sizeof(string),""IINFO" der Zoll: "IINFO2"%i"#HTML_WEISS" in Richtung: "IINFO2"%s"#HTML_WEISS" wurde auf deiner Karte markiert.",zollid,Zoll[zollid][zollbeschriftung]);
		SCM(playerid,WEISS,string);
		SetPlayerCheckpoint(playerid,Zoll[zollid][zollx],Zoll[zollid][zolly],Zoll[zollid][zollz],3.0);
		Spieler[playerid][pIsearch] = 1;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:ramzoll(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new zollid = ReturnZollID(playerid),string[64];
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2)|| isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,16))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(zollid == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keinem Zoll!");
		if(Zoll[zollid][zollopenorclose] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" der Zoll ist bereits offen.");
		if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	    format(string,sizeof(string),""IINFO" der Zoll: "IINFO2"%i"#HTML_WEISS" wurde geöffnet.",zollid);
		SCM(playerid,ZOLLGRUEN,string);
		Zoll[zollid][zollopenorclose] = 1;
		MoveDynamicObject(ZollSchranke[zollid],Zoll[zollid][zollx],Zoll[zollid][zolly],Zoll[zollid][zollz] -2,2.0,Zoll[zollid][zollax],Zoll[zollid][zollay],Zoll[zollid][zollaz]);
		SetTimerEx("MoveZoll",5000,false,"i",zollid);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:czoll(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new zollid = ReturnZollID(playerid),string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
	{
		if(zollid == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keinem Zoll!");
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(Zoll[zollid][zollgesperrt] == 0)
		{
			format(string,sizeof(string),""ShowMeldungText" %s %s hat den Zoll %i in Richtung %s gesperrt.",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],zollid,Zoll[zollid][zollbeschriftung]);
			SendClientMessageToAll(SAMP_WEISS,string);
			Zoll[zollid][zollgesperrt] = 1;
			UpdateDynamic3DTextLabelText(ZollSchrankeLabel[zollid],SAMP_WEISS,"ZOLL GESPERRT!");
		}
		else
		{
			format(string,sizeof(string),""ShowMeldungText" %s %s hat den Zoll %i in Richtung %s geöffnet.",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],zollid,Zoll[zollid][zollbeschriftung]);
			SendClientMessageToAll(ZOLLGRUEN,string);
			Zoll[zollid][zollgesperrt] = 0;
			format(string,sizeof(string),"Zoll %i in Richtung %s\nÜbergangskosten: %i$\nGeöffnet",zollid,Zoll[zollid][zollbeschriftung],Zoll[zollid][zollcash]);
			UpdateDynamic3DTextLabelText(ZollSchrankeLabel[zollid],SAMP_WEISS,string);
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:czollall(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
	{
		if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		for(new zollid=0;zollid<MAX_ZOLL;zollid++)
	  	{
			if(Zoll[zollid][zollgesperrt] == 0)
			{
				Zoll[zollid][zollgesperrt] = 1;
				format(string,sizeof(string),"Zoll %i in Richtung %s\nÜbergangskosten: %i$\nGesperrt",zollid,Zoll[zollid][zollbeschriftung],Zoll[zollid][zollcash]);
				UpdateDynamic3DTextLabelText(ZollSchrankeLabel[zollid],SAMP_WEISS,string);
				if(zollid == 0)
				{
					format(string,sizeof(string),""ShowMeldungText" %s %s hat alle Zölle gesperrt.",SpielerFraktionsRangName(playerid),Spieler[playerid][pName]);
					SendClientMessageToAll(SAMP_WEISS,string);
				}
			}
			else
			{
				Zoll[zollid][zollgesperrt] = 0;
				format(string,sizeof(string),"Zoll %i in Richtung %s\nÜbergangskosten: %i$\nGeöffnet",zollid,Zoll[zollid][zollbeschriftung],Zoll[zollid][zollcash]);
				UpdateDynamic3DTextLabelText(ZollSchrankeLabel[zollid],SAMP_WEISS,string);
				if(zollid == 0)
				{
				    format(string,sizeof(string),""ShowMeldungText" %s %s hat alle Zölle geöffnet.",SpielerFraktionsRangName(playerid),Spieler[playerid][pName]);
					SendClientMessageToAll(SAMP_WEISS,string);
				}
			}
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:zoll(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new zollid = ReturnZollID(playerid),string[200];
	if(zollid == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keinem Zoll!");
	if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	if(InviteInRace[playerid] == 0)
	{
	    if(Zoll[zollid][zollgesperrt] == 1)return SCM(playerid,SAMP_WEISS,"{FF6666}Zollbeamter:{FFFFFF} Der Zoll wurde gesperrt.");
		if(Zoll[zollid][zollopenorclose] == 1)return SCM(playerid,SAMP_WEISS,"{FF6666}Zollbeamter:{FFFFFF} Der Zoll ist bereits geöffnet.");
		if((GetACMoney(playerid) - Zoll[zollid][zollcash]) < 0)return SCM(playerid,SAMP_WEISS,"{FF6666}Zollbeamter:{FFFFFF} Sie haben nicht genug Geld.");
		ACMoney(playerid,-Zoll[zollid][zollcash]);
		fverwaltungen[16][Geld] += Zoll[zollid][zollcash];
		SCM(playerid,SAMP_WEISS,"{007dff}Zollbeamter:{FFFFFF} Gute Weiterfahrt!");
		format(string,sizeof(string),""IINFO" der Zoll %i wurde geöffnet. Kosten %i$",zollid,Zoll[zollid][zollcash]);
		SCM(playerid,ZOLLGRUEN,string);
		Zoll[zollid][zollopenorclose] = 1;
		MoveDynamicObject(ZollSchranke[zollid],Zoll[zollid][zollx],Zoll[zollid][zolly],Zoll[zollid][zollz] -2,2.0,Zoll[zollid][zollax],Zoll[zollid][zollay],Zoll[zollid][zollaz]);
		SetTimerEx("MoveZoll",5000,false,"i",zollid);
		if(Spieler[playerid][pWantedPoints] >= 30)
		{
			format(string,sizeof(string),"HQ: An alle Einheiten, %s wurde am Zoll %i in Richtung %s mit %i Wantedpunkte gesichtet.",SpielerName(playerid),zollid,Zoll[zollid][zollbeschriftung],Spieler[playerid][pWantedPoints]);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,16))
					{
						SCM(i,0x000FFF87,string);
					}
				}
			}
		}
	}
	else
	{
	    if(Zoll[zollid][zollopenorclose] == 1)return SCM(playerid,SAMP_WEISS,"{FF6666}Zollbeamter:{FFFFFF} Der Zoll ist bereits geöffnet.");
        format(string,sizeof(string),"HQ: An alle Einheiten, %s wurde am Zoll %i in Richtung %s bei einem Illegalen Straßenrennen gesichtet.",SpielerName(playerid),zollid,Zoll[zollid][zollbeschriftung]);
        Zoll[zollid][zollopenorclose] = 1;
		MoveDynamicObject(ZollSchranke[zollid],Zoll[zollid][zollx],Zoll[zollid][zolly],Zoll[zollid][zollz] -2,2.0,Zoll[zollid][zollax],Zoll[zollid][zollay],Zoll[zollid][zollaz]);
		SetTimerEx("MoveZoll",5000,false,"i",zollid);
		SCM(playerid,SAMP_WEISS,"{FF6666}Zollbeamter:{FFFFFF} Stehen Bleiben! Ich informiere die Polizei!");
		SCM(playerid,ZOLLGRUEN,""IINFO" du bist ohne zu bezahlen durch den Zoll gefahren!");
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i))
			{
				if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,11))
				{
				    if(Spieler[i][pDuty] != 0)
					{
						SCM(i,0x000FFF87,string);
						SCM(i,0x000FFF87,"HQ: An alle Einheiten, der Spieler ist ohne zu bezahlen durch den Zoll gefahren!");
					}
				}
			}
		}
	}
	return 1;
}
COMMAND:csiwaffen(playerid,const params[])
{
    #pragma unused params
	if(IsPlayerInRangeOfPoint(playerid,10,226.7648,74.0639,1005.0391))
    {
        if(isPlayerInFrakt(playerid,2))
        {
        	GiveWeapon(playerid,31,6500,true);
        	GiveWeapon(playerid,34,350,true);
        	GiveWeapon(playerid,24,980,true);
        	GiveWeapon(playerid,3,1,true);
        	GiveWeapon(playerid,41,9874,true);
        	SCM(playerid,SAMP_WEISS,"Waffen erhalten.");
			return 1;
		}
		else
		{
		    SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Fraktion: CSI");
		}
	}
	else
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am WaffenPoint");
	}
	return 1;
}
