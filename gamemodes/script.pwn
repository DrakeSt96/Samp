								    SetVehicleParamsEx(Pfahrzeug[slot][playerid][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
								    Pfahrzeug[slot][playerid][Abgeschlossen] = 0;
