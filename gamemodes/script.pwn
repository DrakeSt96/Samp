COMMAND:sellfish(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new biz = ReturnBizID(playerid),fishid,string[128];
    if(biz == -1)return SCM(playerid,SAMP_WEISS,"In keinem 24/7!");
    if(BizInfo[biz][biz_art] == 2)//24/7
	{
	    if(sscanf(params,"i",fishid))return SCM(playerid,SAMP_WEISS,""IINFO" /sellfish [Fisch]");
	    if(fishid<1||fishid>5)return SCM(playerid,SAMP_WEISS,""IINFO" /sellfish [Fisch 1-5]");
	    if(Spieler[playerid][pFishID][fishid] == -1)return SCM(playerid,SAMP_WEISS,"Fisch nicht im Inventar!");
	    new cash = Spieler[playerid][pFischgewicht][fishid]*2+random(37);
	    format(string,sizeof(string),""IINFO" du hast einen %s für %i$ verkauft!",Fische[Spieler[playerid][pFishID][fishid]],cash);
	    SCM(playerid,SAMP_WEISS,string);
	    ACMoney(playerid,cash);
	    if(BizInfo[biz][biz_geldkasse] < cash)return SCM(playerid,SAMP_WEISS,""IINFO" die Ladenkasse hat nicht genug Geld fuer den Ankauf.");
	    BizInfo[biz][biz_geldkasse] -= cash;
		Spieler[playerid][pFishID][fishid] = -1;
		Spieler[playerid][pFischgewicht][fishid] = 0;
	    return 1;
    }
    return SCM(playerid,SAMP_WEISS,"In keinem 24/7!");
}

COMMAND:threwback(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[64],fishid;
    if(sscanf(params,"i",fishid))return SCM(playerid,SAMP_WEISS,""IINFO" /threwback [Fisch]");
    if(fishid<1||fishid>5)return SCM(playerid,SAMP_WEISS,""IINFO" /threwback [Fisch 1-5]");
    if(Spieler[playerid][pFishID][fishid] == -1)return SCM(playerid,SAMP_WEISS,"Fisch nicht im Inventar!");
    format(string,sizeof(string),""IINFO" du hast einen %s weggeworfen!",Fische[Spieler[playerid][pFishID][fishid]]);
    SCM(playerid,SAMP_WEISS,string);
    Spieler[playerid][pFishID][fishid] = -1;
	Spieler[playerid][pFischgewicht][fishid] = 0;
	return 1;
}

COMMAND:fishinfo(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[64],fische;
	SCM(playerid,SAMP_WEISS,"|_________Fische_________|");
	for(new fishid=1;fishid<MAX_FISHING_FISHES;fishid++)
	{
	 	if(Spieler[playerid][pFishID][fishid] != -1)
	    {
		    format(string,sizeof(string),"%i. %s %i kg",fishid,Fische[Spieler[playerid][pFishID][fishid]],Spieler[playerid][pFischgewicht][fishid]);
		    SCM(playerid,SAMP_WEISS,string);
			fische++;
		}
	}
    if(fische == 0)return SCM(playerid,SAMP_WEISS,"Keine Fische vorhanden!");
	return 1;
}

COMMAND:fish(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(!IstSpielerAmFischerPlatz(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur am Los Santos Pier angeln.");
    if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in einem Fahrzeug!");
    if(Spieler[playerid][pAngel] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Angel.");
    if(Spieler[playerid][pAngelKoeder] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Fischköder.");
	if(gettime() < Spieler[playerid][pPremium])
	{
		if(gettime() < Spieler[playerid][pFischingAntiSpam]/2)
	    {
			new timestamp = (Spieler[playerid][pFischingAntiSpam]/2) - gettime();
			format(string,sizeof(string),""IINFO" du kannst erst in %02d Sekunden wieder angeln.",floatround(timestamp%60));
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
	}
	else
	{
		if(gettime() < Spieler[playerid][pFischingAntiSpam])
	    {
			new timestamp = Spieler[playerid][pFischingAntiSpam] - gettime();
			format(string,sizeof(string),""IINFO" du kannst erst in %02d Sekunden wieder angeln.",floatround(timestamp%60));
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
	}
	if(Spieler[playerid][pFishID][1] != -1 && Spieler[playerid][pFishID][2] != -1 && Spieler[playerid][pFishID][3] != -1 && Spieler[playerid][pFishID][4] != -1 && Spieler[playerid][pFishID][5] != -1)
	{
		return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits 5 Fische gefangen.");
	}
	Spieler[playerid][pFischingAntiSpam] = gettime() + 10;
 	format(string,sizeof(string),"** %s wirft seine Angelschnur aus **",SpielerName(playerid));
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	if(Spieler[playerid][pFishingLic] == 1)
	{
		SetTimerEx("Angeln",2500,false,"i",playerid);
	}
	else SetTimerEx("Angeln",5000,false,"i",playerid);
	TogglePlayerControllable(playerid,false);
	SetCameraBehindPlayer(playerid);
	SetPlayerAttachedObject(playerid,6,18632,5,0.085999,0.024000,-0.028000,-23.600000,0.000000,102.399971,1.000000,1.000000,1.000000);//fischanimations angel für rp aktion :D
	return 1;
}

COMMAND:delclothes(playerid,const params[])
{
	#pragma unused params
	if(!IsPlayerAttachedObjectSlotUsed(playerid,0) && Spieler[playerid][pBuyClothes] == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Kopfbekleidung übergezogen.");
	SCM(playerid,WEISS,""IINFO" du hast deine Kopfbekleidung entfernt.");
	RemovePlayerAttachedObject(playerid,0),Spieler[playerid][pBuyClothes] = -1;
	return 1;
}

COMMAND:kartbahn(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[32];
	if(IsPlayerInRangeOfPoint(playerid,1.5,2308.4192,-1238.2944,-30.9800) && GetPlayerVirtualWorld(playerid) != 0)
	{
		Spieler[playerid][pKart] = CreateVehicleEx(571,2277.3469,-1240.8942,-31.4207,177.2516,-1,-1,-1,false);
		SetVehicleVirtualWorld(Spieler[playerid][pKart],GetPlayerVirtualWorld(playerid));
		format(string,sizeof(string),"%i",MAX_VEHICLES-Spieler[playerid][pKart]);
	 	SetVehicleNumberPlate(Spieler[playerid][pKart],string);
	 	PutPlayerInVehicleEx(playerid,Spieler[playerid][pKart],0);
	 	GetVehicleParamsEx(Spieler[playerid][pKart],engine,lights,alarm,doors,bonnet,boot,objective);
	 	SetVehicleParamsEx(Spieler[playerid][pKart],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
	    lockedveh[Spieler[playerid][pKart]] = true;
	    GetVehicleParamsEx(Spieler[playerid][pKart],engine,lights,alarm,doors,bonnet,boot,objective);
		SetVehicleParamsEx(Spieler[playerid][pKart],VEHICLE_PARAMS_ON,lights,alarm,doors,bonnet,boot,objective);
	    Motor[Spieler[playerid][pKart]] = true;
	   	Spieler[playerid][pKartCountdown] = 0;
		GameTextForPlayer(playerid,"~g~5",1000,3);
	    PlayerPlaySound(playerid,1056,0.0,0.0,0.0);
	    TogglePlayerControllable(playerid,false);
		Spieler[playerid][pKartTimer] = SetTimerEx("StartKartRace",1000,true,"ii",playerid,1);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keiner Kart-Bahn.");
}

COMMAND:parachute(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[200],givemwst;
    for(new biz=1;biz<MAX_BIZ;biz++)
    {
	    if(BizInfo[biz][biz_art] == 14)//Base-Jump Business
		{
			if(IsPlayerInRangeOfPoint(playerid,2.0,BizInfo[biz][tPos][0],BizInfo[biz][tPos][1],BizInfo[biz][tPos][2]) || IsPlayerInRangeOfPoint(playerid,2.0,BizInfo[biz][tPos][3],BizInfo[biz][tPos][4],BizInfo[biz][tPos][5]))
		    {
			    if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in einem Fahrzeug.");
			    if((GetACMoney(playerid) - BizInfo[biz][biz_artikel][0]) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
			    givemwst = floatround((BizInfo[biz][biz_artikel][0]/100)*fsteuern[Mwst],floatround_ceil);
				ACMoney(playerid,-BizInfo[biz][biz_artikel][0]);
			    BizInfo[biz][biz_geldkasse] += floatround(BizInfo[biz][biz_artikel][0]-givemwst);
			    fverwaltungen[16][Geld] += givemwst;
			    format(string,sizeof(string),""IINFO" du hast dir einen Fallschirm für %i$(davon versteuert: %i$) gekauft!",BizInfo[biz][biz_artikel][0],givemwst);
			    SCM(playerid,SAMP_WEISS,string);
			    GiveWeapon(playerid,46,1,true);
				return 1;
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keinem Base-Jump Business.");
}

COMMAND:tanken(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid),erweitstr[1024];
    for(new biz=1;biz<MAX_BIZ;biz++)
    {
	    if(BizInfo[biz][biz_art] == 10)//Tankstellen
		{
			if(IsPlayerInRangeOfPoint(playerid,10.0,BizInfo[biz][tPos][0],BizInfo[biz][tPos][1],BizInfo[biz][tPos][2]) || IsPlayerInRangeOfPoint(playerid,10.0,BizInfo[biz][tPos][3],BizInfo[biz][tPos][4],BizInfo[biz][tPos][5]))
		    {
				if(BizInfo[biz][biz_locked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
			    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
			    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
			    if(vFahrzeug[vehicleid][Tank] == VehicleInfo[GetVehicleModel(GetPlayerVehicleID(playerid))-400][vtankvolumen])return SCM(playerid,SAMP_WEISS,"Fahrzeug bereits befüllt!");
				if(RefillVehicle[vehicleid] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug wird bereits betankt.");
				if(Motor[vehicleid] == true)return SCM(playerid,SAMP_WEISS,""IINFO" der Motor muss aus sein.");
				format(erweitstr,sizeof(erweitstr),""#HTML_BLAU"1."#HTML_WEISS" Benzin: %i$ Pro_L\n"#HTML_BLAU"2."#HTML_WEISS" Diesel: %i$ Pro_L\n"#HTML_BLAU"3."#HTML_WEISS" TurboBenzin: %i$ Pro_L\n"#HTML_BLAU"4."#HTML_WEISS" Kerosin: %i$ Pro_L"
				,BizInfo[biz][biz_artikel][0],BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3]);
				ShowPlayerDialog(playerid,DIALOG_TANKOPTION,DIALOG_STYLE_LIST,""ClanTagDialoge" Tankenstelle - Art",erweitstr,"Tanken","Abbrechen");
			    return 1;
		    }
	    }
    }
    return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keiner Tankstelle.");
}
COMMAND:kanister(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],Menge,givemwst;
    for(new biz=1;biz<MAX_BIZ;biz++)
    {
	    if(BizInfo[biz][biz_art] == 10)//tankstelle
		{
			if(IsPlayerInRangeOfPoint(playerid,2.0,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]))
			{
			    if(BizInfo[biz][biz_locked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
			    if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in einem Fahrzeug.");
				if(sscanf(params,"i",Menge))return SCM(playerid,SAMP_WEISS,""IINFO" /kanister [Menge]");
				if(Menge<1||Menge>10)return SCM(playerid,SAMP_WEISS,""IINFO" /kanister [Menge 1-10]");
			    if((Spieler[playerid][pTankFillBoxes] + Menge) > 10)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen!");
				if((GetACMoney(playerid) - BizInfo[biz][biz_artikel][4]*Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
			    givemwst = floatround((BizInfo[biz][biz_artikel][4]/100)*fsteuern[Mwst],floatround_ceil);
				ACMoney(playerid,-BizInfo[biz][biz_artikel][4]*Menge);
				StopAudioStreamForPlayer(playerid);
				PlayAudioStreamForPlayer(playerid,ServerSounds[2],0.0,0.0,0.0);
			    BizInfo[biz][biz_geldkasse] += floatround((BizInfo[biz][biz_artikel][4]*Menge)-(givemwst*Menge));
			    fverwaltungen[16][Geld] += givemwst*Menge;
			    format(string,sizeof(string),""IINFO" du hast dir %i Benzinkanister für %i$(davon versteuert: %i$) gekauft! Nutze sie/ihn mit '/fillveh'",Menge,BizInfo[biz][biz_artikel][4]*Menge,givemwst*Menge);
			    SCM(playerid,SAMP_WEISS,string);
			    Spieler[playerid][pTankFillBoxes] += Menge;
			    return 1;
		    }
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keiner Tankstelle.");
}
COMMAND:ktank(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],kraftstoff[25];
	for(new biz=1;biz<MAX_BIZ;biz++)
    {
	    if(BizInfo[biz][biz_art] == 10)//tankstelle
		{
			if(IsPlayerInRangeOfPoint(playerid,2.0,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]))
			{
				if(Spieler[playerid][pTankArt] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast doch gar nicht getankt.");
				if(RefillVehicle[Spieler[playerid][pTankVehicle]] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast doch gar nicht getankt.");
			    if((GetACMoney(playerid) - floatround(BizInfo[biz][biz_artikel][Spieler[playerid][pTankArt]]*(vFahrzeug[Spieler[playerid][pTankVehicle]][Tank]-Tankcount[playerid]))) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld dabei.");
				ACMoney(playerid,-floatround(BizInfo[biz][biz_artikel][Spieler[playerid][pTankArt]]*(vFahrzeug[Spieler[playerid][pTankVehicle]][Tank]-Tankcount[playerid]),floatround_ceil));
				StopAudioStreamForPlayer(playerid);
				PlayAudioStreamForPlayer(playerid,ServerSounds[2],0.0,0.0,0.0);
				BizInfo[biz][biz_geldkasse] += floatround(BizInfo[biz][biz_artikel][Spieler[playerid][pTankArt]]*(vFahrzeug[Spieler[playerid][pTankVehicle]][Tank]-Tankcount[playerid]),floatround_ceil);
			    switch(Spieler[playerid][pTankArt])
				{
					case 1:{kraftstoff="Benzin";}
					case 2:{kraftstoff="Diesel";}
					case 3:{kraftstoff="Turbobenzin";}
					case 4:{kraftstoff="Kerosin";}
					default:{kraftstoff="ERROR";}
				}
				format(string,sizeof(string),""IINFO" du hast %.1f Liter %s für %i$ getankt",vFahrzeug[Spieler[playerid][pTankVehicle]][Tank]-Tankcount[playerid],kraftstoff,floatround(BizInfo[biz][biz_artikel][Spieler[playerid][pTankArt]]*(vFahrzeug[Spieler[playerid][pTankVehicle]][Tank]-Tankcount[playerid]),floatround_ceil));
				SCM(playerid,SAMP_WEISS,string);
				if(VehicleInfo[GetVehicleModel(Spieler[playerid][pTankVehicle])-400][vtankklasse] != Spieler[playerid][pTankArt])
				{
					SCM(playerid,WEISS,""IINFO" du hast den falschen Kraftstoff getankt ... Suche die nächste Werkstatt auf um einen Motorschaden zu umgehen.");
				}
				vFahrzeug[Spieler[playerid][pTankVehicle]][FailGas] = Spieler[playerid][pTankArt];
				Tankcount[playerid] = 0;
				RefillVehicle[Spieler[playerid][pTankVehicle]] = 0;
				DestroyDynamic3DTextLabel(TankenLabel[Spieler[playerid][pTankVehicle]]);
			 	Spieler[playerid][pTankArt] = 0;
			 	Spieler[playerid][pTankState] = false;
				Spieler[playerid][pTankVehicle] = 0;
				return 1;
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keiner Tankstelle/Kasse.");
}

COMMAND:pbenter(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(Spieler[playerid][pDuty] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im Dienst und kannst somit die Paintball Arena nicht betreten.");
    if(Spieler[playerid][pWantedPoints] >= 10)return SCM(playerid,SAMP_WEISS,""IINFO" du hast zu viele Wanteds und kannst somit die Paintball Arena nicht betreten.");
    if(Spieler[playerid][pMaske] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst eine Maske und kannst somit die Paintball-Arena nicht betreten.");
	if(Paintball[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits in der Paintball Arena.");
	new string[256];
    for(new biz=1;biz<MAX_BIZ;biz++)
	{
		if(IsPlayerInRangeOfPoint(playerid,2.0,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]))
		{
			if(BizInfo[biz][biz_art] == 12)//paintball
			{
				if(BizInfo[biz][biz_locked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
				format(string,sizeof(string),"Paintball (%i Spieler)\nTeam-Death-Match (%i Spieler)",GetPaintballTeilnehmer(1),GetPaintballTeilnehmer(2));
				ShowPlayerDialog(playerid,DIALOG_PAINTBALL,DIALOG_STYLE_LIST,"Paintball-Arena",string,"Auswählen","Abbrechen");
				return 1;
			}
		}
	}
    return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keiner Paintball-Arena.");
}

COMMAND:pbexit(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],biz = PaintballEntered[playerid];
    if(Paintball[playerid] == 0)return SCM(playerid,SAMP_WEISS,"Nicht in der Paintball-Arena");
    SetPlayerPosEx(playerid,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]);
    SetPlayerInterior(playerid,0);
    SetPlayerWorldBounds(playerid,20000.0000,-20000.0000,20000.0000,-20000.0000);
    SetPlayerVirtualWorld(playerid,0);
    ResetWeapons(playerid,false);
    SaveAccount(playerid);
    SetPlayerWaffenSkill(playerid);
    for(new slot=0;slot<13;slot++)
	{
		if(Spieler[playerid][pPlayerWeapon][slot] != WEAPON_FIST && Spieler[playerid][pPlayerWeaponAmmo][slot] != 0)
		{
			GiveWeapon(playerid,Spieler[playerid][pPlayerWeapon][slot],Spieler[playerid][pPlayerWeaponAmmo][slot],false);
		}
	}
    SetPlayerACHealth(playerid,100);
    SetPlayerACArmour(playerid,0);
    if(Paintball[playerid] == 1)
	{
		SCM(playerid,SAMP_WEISS,""IINFO" du hast die Paintball Arena verlassen.");
		ResetWeapons(playerid,false);
    	SaveAccount(playerid);
		GameTextForPlayer(playerid,"~b~Paintball ausstieg",1000,4);
		format(string,sizeof(string),"** Paintball: %s hat die Paintball Arena verlassen **",SpielerName(playerid));
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(playerid))
			{
				if(Paintball[i] == 1)
			    {
					SCM(i,PAINTBALL,string);
				}
			}
		}
	}
	if(Paintball[playerid] == 2)
	{
		switch(Spieler[playerid][pFraktion])
		{
			case 0:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//
		    case 1:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//SAPD
		    case 2:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//FBI
		    case 3:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//MEDIC
		    case 4:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);}//LSV
		    case 5:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);}//GSF
		    case 6:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//ARMY
		    case 7:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);}//BALLAS
		    case 8:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//TERRORS
		    case 9:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);}//YAKUZA
		    case 10:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//SANEWSAG
		    case 11:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//OAMT
		    case 12:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);}//LCN
      		case 13:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);}//Sons of Anarchy
		    case 14:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//FAHRSCHULE
		    case 15:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);}//SA ELEKTRONIK GmBh
		    case 16:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]),Spieler[playerid][pDuty] = 1;}//Regierung
		    case 17:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);}//Sureño Syndikat
		}
		SCM(playerid,SAMP_WEISS,""IINFO" du hast die Team-Death-Match Arena verlassen.");
		ResetWeapons(playerid,false);
    	SaveAccount(playerid);
		GameTextForPlayer(playerid,"~r~Team-Death-Match ausstieg",1000,4);
		format(string,sizeof(string),"** Team-Death-Match: %s hat die Team-Death-Match Arena verlassen **",SpielerName(playerid));
	    ForEachPlayer(i)
		{
			if(IsPlayerConnected(playerid))
			{
				if(Paintball[i] == 2)
			    {
					SCM(i,PAINTBALL,string);
				}
			}
		}
	}
	Paintball[playerid] = 0;
	return 1;
}

COMMAND:buy(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[512];
	new biz = ReturnBizID(playerid);
	if(biz == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Laden / Business.");
	switch(BizInfo[biz][biz_art])
	{
	    case 1://ammu
		{
			if(Spieler[playerid][pWaffenLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Waffenschein!");
			format(string,sizeof(string),"Baseball Schläger --> %i$\n9mm --> %i$\nSilenced Pistole --> %i$\nDeagle --> %i$\nShotgun --> %i$\nMP-5 --> %i$\nAk-47 --> %i$\nM4 --> %i$\nCountry Rifle --> %i$\nSniper --> %i$\nLunchpakete --> %i$",
			BizInfo[biz][biz_artikel][0],BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3],BizInfo[biz][biz_artikel][4],BizInfo[biz][biz_artikel][5],
			BizInfo[biz][biz_artikel][6],BizInfo[biz][biz_artikel][7],BizInfo[biz][biz_artikel][8],BizInfo[biz][biz_artikel][9],BizInfo[biz][biz_artikel][10]);
			ShowPlayerDialog(playerid,DIALOG_BUWTHINGSINBIZ,DIALOG_STYLE_LIST,""ClanTagDialoge" Ammunation",string,"Kaufen","Abbrechen");
			return 1;
	    }
		case 2://24/7
		{
			format(string,sizeof(string),"Telefonbuch --> %i$\nNavigationsgerät --> %i$\nSchokolade --> %i$\nLunchpaket --> %i$\nRoter Helm --> %i$\nGrüner Helm --> %i$\nBlauer Helm --> %i$\nCross Helm --> %i$\nWerkzeugkasten --> %i$\nKoffer --> %i$\nAngel --> %i$\nPackung Zigaretten --> %i$\n20 Fischköder --> %i$\nLottoschein\nKondome --> %i$",
			BizInfo[biz][biz_artikel][0],BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3],BizInfo[biz][biz_artikel][4],BizInfo[biz][biz_artikel][5],
			BizInfo[biz][biz_artikel][6],BizInfo[biz][biz_artikel][7],BizInfo[biz][biz_artikel][8],BizInfo[biz][biz_artikel][9],BizInfo[biz][biz_artikel][10],BizInfo[biz][biz_artikel][11],BizInfo[biz][biz_artikel][12],BizInfo[biz][biz_artikel][14]);
			ShowPlayerDialog(playerid,DIALOG_BUWTHINGSINBIZ,DIALOG_STYLE_LIST,""ClanTagDialoge" 24/7 Market",string,"Kaufen","Abbrechen");
			return 1;
		}
		case 3://clucking bell
		{
			format(string,sizeof(string),"Sprite --> %i$\nCrispy Chicken --> %i$\nChicken Wings --> %i$\nChicken Nuggets --> %i$\nChicken Burger   %i$\nChicken Tripple Burger --> %i$",
			BizInfo[biz][biz_artikel][0],BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3],BizInfo[biz][biz_artikel][4],BizInfo[biz][biz_artikel][5]);
			ShowPlayerDialog(playerid,DIALOG_BUWTHINGSINBIZ,DIALOG_STYLE_LIST,""ClanTagDialoge" Clucking Bell",string,"Kaufen","Abbrechen");
			return 1;
		}
		case 4://Burger Shot
		{
			format(string,sizeof(string),""#HTML_BLAU"1."#HTML_WEISS" Cola "IINFO2"%i$\n"#HTML_BLAU"2."#HTML_WEISS" Cheeseburger "IINFO2"%i$\n"#HTML_BLAU"3."#HTML_WEISS" Pommes "IINFO2"%i$\n"#HTML_BLAU"4."#HTML_WEISS" Bigmac "IINFO2"%i$\n"#HTML_BLAU"5."#HTML_WEISS" Hamburger "IINFO2"%i$\n"#HTML_BLAU"6."#HTML_WEISS" Hamburger Royal "IINFO2"%i$",
			BizInfo[biz][biz_artikel][0],BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3],BizInfo[biz][biz_artikel][4],BizInfo[biz][biz_artikel][5]);
			ShowPlayerDialog(playerid,DIALOG_BUWTHINGSINBIZ,DIALOG_STYLE_LIST,""ClanTagDialoge" Burger Shot",string,"Kaufen","Abbrechen");
			return 1;
		}
		case 5://handyladen
		{
		    ShowPlayerHandyMenu(playerid);
			return 1;
		}
	    case 6://well staked pizza
		{
			format(string,sizeof(string),"Pizza Napoli --> %i$\nPizza Margherita --> %i$\nPizza Romana --> %i$\nPizza Spezial --> %i$\nPizza Super --> %i$\nPizza De Luxe --> %i$",
			BizInfo[biz][biz_artikel][0],BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3],BizInfo[biz][biz_artikel][4],BizInfo[biz][biz_artikel][5]);
			ShowPlayerDialog(playerid,DIALOG_BUWTHINGSINBIZ,DIALOG_STYLE_LIST,""ClanTagDialoge" Well Staked Pizza",string,"Kaufen","Abbrechen");
			return 1;
		}
	    case 7://club
		{
			format(string,sizeof(string),"Bier Flasche --> %i$\nRum --> %i$\nSekt --> %i$\nWhiskey --> %i$\nVodka --> %i$\nWein --> %i$",
			BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3],BizInfo[biz][biz_artikel][4],BizInfo[biz][biz_artikel][5],BizInfo[biz][biz_artikel][6]);
			ShowPlayerDialog(playerid,DIALOG_BUWTHINGSINBIZ,DIALOG_STYLE_LIST,""ClanTagDialoge" Club",string,"Kaufen","Abbrechen");
			return 1;
		}
		case 8://Donut laden
		{
			format(string,sizeof(string),"Vanille Donut --> %i$\nSchoko Donut --> %i$\nStrawberry Donut --> %i$\nStrawberry Frosted Donut --> %i$\nBlueberry Crunch Donut --> %i$\nSpecial Delux Donut --> %i$",
			BizInfo[biz][biz_artikel][0],BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3],BizInfo[biz][biz_artikel][4],BizInfo[biz][biz_artikel][5]);
			ShowPlayerDialog(playerid,DIALOG_BUWTHINGSINBIZ,DIALOG_STYLE_LIST,""ClanTagDialoge" Donut Laden",string,"Kaufen","Abbrechen");
			return 1;
		}
	    case 9://Restaurant
		{
			format(string,sizeof(string),"Fleischburger --> %i$\nSalat --> %i$\nBarguette --> %i$\nBelegtes Brot --> %i$\nRemuladen Brot --> %i$\nFrikadele --> %i$",
			BizInfo[biz][biz_artikel][0],BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3],BizInfo[biz][biz_artikel][4],BizInfo[biz][biz_artikel][5]);
			ShowPlayerDialog(playerid,DIALOG_BUWTHINGSINBIZ,DIALOG_STYLE_LIST,""ClanTagDialoge" Restaurant",string,"Kaufen","Abbrechen");
			return 1;
		}
		case 15://Kart-Bahn
		{
			format(string,sizeof(string),"Pommes --> %i$\nKart-Menu --> %i$\nSieger-Menu --> %i$",
			BizInfo[biz][biz_artikel][1],BizInfo[biz][biz_artikel][2],BizInfo[biz][biz_artikel][3]);
			ShowPlayerDialog(playerid,DIALOG_BUWTHINGSINBIZ,DIALOG_STYLE_LIST,""ClanTagDialoge" Kart-Bahn",string,"Kaufen","Abbrechen");
			return 1;
		}
	}
	return SCM(playerid,SAMP_WEISS,"Diese Business verkauft nichts.");
}

COMMAND:bizmenu(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new biz = GetBusinessOwnerOrCoOwner(playerid,Spieler[playerid][pName]);
    if(biz == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht Besitzer des Business./Du bist nicht Teilhaber des Business./Du musst in deinem Business/an deinem Business sein.");
	ShowPlayerDialog(playerid,DIALOG_BIZ_MENU,DIALOG_STYLE_LIST,""ClanTagDialoge"Businessverwaltung",""#HTML_BLAU"1."#HTML_WEISS" Einzahlen\n"#HTML_BLAU"2."#HTML_WEISS" Auszahlen\n"#HTML_BLAU"3."#HTML_WEISS" Preise ändern","Auswählen","Abbrechen");
    return 1;
}

COMMAND:mybizpartner(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new biz = GetBusinessOwner(playerid,Spieler[playerid][pName]),pID,string[128];
	if(biz == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht Besitzer des Business./Du bist nicht Teilhaber des Business./Du musst in deinem Business/an deinem Business sein.");
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /mybizpartner [playerid/Name]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst als eigener Businessteilhaber benennen.");
    if(strcmp(BizInfo[biz][biz_teilhaber],"Niemand",false))return SCM(playerid,SAMP_WEISS,""IINFO" das Business hat bereits einen Teilhaber.");
	if(Spieler[pID][GeworbenPlaya] > gettime())
	{
		if(IsPlayerAnyBusinessCoOwner(Spieler[pID][pName]) >= MAX_BUSINESS_COOWNER)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits "#MAX_BUSINESS_OWNER" mal Business-Teilhaber.");
	}
	else
	{
		if(IsPlayerAnyBusinessCoOwner(Spieler[pID][pName]) >= MAX_BUSINESS_COOWNER/2)
		{
			format(string,sizeof(string),"Spieler ist bereits %i mal Business-Teilhaber.",MAX_BUSINESS_OWNER/2);
			return SCM(playerid,SAMP_WEISS,string);
		}
	}
	strmid(BizInfo[biz][biz_teilhaber],Spieler[pID][pName],0,strlen(Spieler[pID][pName]),24);
    format(string,sizeof(string),""IINFO" du hast %s als Teilhaber deines Businesses gemacht!",BizInfo[biz][biz_teilhaber]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s hat dich zum Teilhaber seines %s´s gemacht!",SpielerName(playerid),BizName(biz));
	SCM(pID,SAMP_WEISS,string);
    UpdateBizLabel(biz,2);//funktion 1 wenn das biz ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
    SaveOnlyOneBiz(biz);
    return 1;
}

COMMAND:kickmybizpartner(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new biz = GetBusinessOwner(playerid,Spieler[playerid][pName]),string[128];
	if(biz == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht Besitzer des Business./Du bist nicht Teilhaber des Business./Du musst in deinem Business/an deinem Business sein.");
	if(strcmp(BizInfo[biz][biz_teilhaber],"Niemand",true))
	{
	    format(string,sizeof(string),""IINFO" du hast %s als Teilhaber deines Businesses gekickt!",BizInfo[biz][biz_teilhaber]);
		SCM(playerid,SAMP_WEISS,string);
		strmid(BizInfo[biz][biz_teilhaber],"Niemand",0,strlen("Niemand"),24);
	    UpdateBizLabel(biz,2);//funktion 1 wenn das biz ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
	    SaveOnlyOneBiz(biz);
	    return 1;
	}
	return SCM(playerid,SAMP_WEISS,"Dein Business hat keinen Teilhaber bzw. hast du Niemanden als Teilhaber ernannt.");
}

COMMAND:bizlock(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new biz = GetBusinessOwnerOrCoOwner(playerid,Spieler[playerid][pName]);
	if(biz == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht Besitzer des Business./Du bist nicht Teilhaber des Business./Du musst in deinem Business/an deinem Business sein.");
	if(BizInfo[biz][biz_locked] == 0)
	{
		BizInfo[biz][biz_locked] = 1;
		SCM(playerid,SAMP_WEISS,"* Du hast dein Business geschlossen. Niemand kann es betreten oder verlassen.");
		return 1;
	}
	else if(BizInfo[biz][biz_locked] == 1)
	{
		BizInfo[biz][biz_locked] = 0;
		SCM(playerid,SAMP_WEISS,"* Du hast dein Business geöffnet. Man kann es wieder betreten.");
		return 1;
	}
	return 1;
}

COMMAND:buyrentvehs(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	for(new biz=1;biz<MAX_BIZ;biz++)
	{
		if(BizInfo[biz][bizcreatet] == 1)
		{
			if(!strcmp(BizInfo[biz][biz_besitzer],Spieler[playerid][pName],true))
			{
				if(BizInfo[biz][biz_art] == 11)//Fahrzeugvermietung
				{
					switch(ReturnBIZRENTVEHBUYID(playerid))
					{
						case 0:return ShowPlayerDialog(playerid,DIALOG_BIZRENTVEHSBUY,DIALOG_STYLE_LIST,"Fahrzeugauswahl [Autohaus am Hotel]","Emperor	5999$\nBF Injection	7499$\nPerenniel	649$\nPCJ-600	1499$\nQuad		849$\nTahoma	6500$\nSentinel	17999$\nClover		499$\nLandstalker	9465$","Kaufen","Schließen");
						case 1:return ShowPlayerDialog(playerid,DIALOG_BIZRENTVEHSBUY,DIALOG_STYLE_LIST,"Fahrzeugauswahl [Autohaus Grotti]","Sunrise	14999$\nRanger	14599$\nSultan	44500$\nHuntley	40000$\nJester	38999$\nEuros	29999$\nStratum	17200$\nPhoenix	54900$\nElegant	24900$\nClub	1999$","Kaufen","Schließen");
						case 2:return ShowPlayerDialog(playerid,DIALOG_BIZRENTVEHSBUY,DIALOG_STYLE_LIST,"Fahrzeugauswahl [Otto´s Autos]","ZR-350	119000$\nTurismo	239000$\nSuper GT	109000$\nNRG-500	104999$\nCheetah	209000$\nInfernus	424999$\nBroadway	129499$\nWindsor	129499$\nStretch	159000$","Kaufen","Schließen");
						case 3:return ShowPlayerDialog(playerid,DIALOG_BIZRENTVEHSBUY,DIALOG_STYLE_LIST,"Fahrzeugauswahl [Autohaus Valle Ocutado]","Elegy	27999$\nJourney	22900$\nBurrito	19699$\nDune	56230$","Kaufen","Schließen");
					}
					return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Fahrzeuge für dein Business kaufen.");
				}
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Besitzer eines Business./Du besitzt keine Fahrzeugvermietung.");
}

COMMAND:erstellen_3(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[25],query[256];
    if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(sscanf(params,"s[25]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /erstellen [Haus/Business]");
    if(strcmp(cmd,"Haus",true) == 0)
   	{
		for(new haus=1;haus<MAX_HAUS;haus++)
		{
			if(HausInfo[haus][hauscreatet] != 1)
			{
				format(query,sizeof(query),"INSERT INTO server_haus (id) VALUES ('%d')",haus);
			    mysql_function_query(MySQL_R394,query,false,"","");
			    MakeHaus[playerid] = haus;
			    GetPlayerPos(playerid,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]);
			    HausInfo[haus][hauscreatet] = 1;
			    strmid(HausInfo[haus][haus_besitzer],"Niemand",0,strlen("Niemand"),24);
				//strmid(HausInfo[haus][haus_beschreibung],"Keine",0,strlen("Keine"),150);
				strmid(HausInfo[haus][haus_msg],"Keine",0,strlen("Keine"),150);
			    HausInfo[haus][haus_Owned] = 0;
			    HausInfo[haus][haus_innenraum] = 255;
			    HausInfo[haus][haus_miete] = 0;
			    HausInfo[haus][haus_locked] = 1;
			    HausInfo[haus][haus_slots] = 0;
			    HausInfo[haus][haus_eingemitetenzaehler] = 0;
				HausInfo[haus][haus_preis] = 0;
				HausInfo[haus][haus_level] = 0;
				HausInfo[haus][haus_geldkasse] = 0;
				HausInfo[haus][haus_Opium] = 0;
				HausInfo[haus][haus_Spice] = 0;
			    HausInfo[haus][haus_c4] = 0;
				HausInfo[haus][haus_Ganja] = 0;
				HausInfo[haus][haus_Kokain] = 0;
			    HausInfo[haus][haus_materials] = 0;
				HausInfo[haus][haus_heal] = 0;
				HausInfo[haus][haus_armour] = 0;
				HausInfo[haus][haus_hatheal] = 0;
				HausInfo[haus][haus_hatarmour] = 0;
				HausInfo[haus][hausmull] = 0;
				HausLabel[haus] = CreateDynamic3DTextLabel("../..",SAMP_WEISS,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z] +1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
				HausInfo[haus][haus_pickup] = CreateDynamicPickup(Server_Haus_Frei_Pickup,1,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]);
				ShowPlayerDialog(playerid,HCREATE_DIALOG_PREIS,DIALOG_STYLE_INPUT,""ClanTagDialoge" Hauserstellung -> Preis",""#HTML_WEISS"Gib den Preis an,\nfür den das Haus zum verkauf freigestellt werden soll","Weiter","Haus löschen");
				return 1;
			}
		}
		return SCM(playerid,SAMP_WEISS,"Die maximale Anzahl an erstellten Häusern ist erreicht!");
	}
	if(strcmp(cmd,"Business",true) == 0)
   	{
		for(new biz=1;biz<MAX_BIZ;biz++)
		{
			if(BizInfo[biz][bizcreatet] != 1)
			{
				format(query,sizeof(query),"INSERT INTO server_bizes (id) VALUES ('%d')",biz);
			    mysql_function_query(MySQL_R394,query,false,"","");
				MakeBiz[playerid] = biz;
				GetPlayerPos(playerid,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]);
				BizInfo[biz][bizcreatet] = 1;
				strmid(BizInfo[biz][biz_besitzer],"Niemand",0,strlen("Niemand"),24);
				strmid(BizInfo[biz][biz_teilhaber],"Niemand",0,strlen("Niemand"),24);
				//strmid(BizInfo[biz][biz_beschreibung],"Keine",0,strlen("Keine"),150);
			    BizInfo[biz][biz_Owned] = 0;
			    for(new i=0;i<15;i++) BizInfo[biz][biz_artikel][i] = 0;
			 	BizLabel[biz][0] = CreateDynamic3DTextLabel("BUSINESS ERSTELLUNG",SAMP_WEISS,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z] +1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
				BizInfo[biz][biz_pickup][0] = CreateDynamicPickup(Server_Business_Frei_Pickup,1,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z],-1);
				ShowPlayerBusiness(playerid);
				return 1;
			}
		}
		return SCM(playerid,SAMP_WEISS,"Die maximale Anzahl an erstellten Businessen ist erreicht!");
	}
	if(strcmp(cmd,"Schwarzmarkt",true) == 0)
   	{
	   	for(new sm=1;sm<MAX_SMARKETS;sm++)
	   	{
		   	if(SmarkInfo[sm][screatet] != 1)
			{
				format(query,sizeof(query),"INSERT INTO server_schwarzmarkt (id) VALUES ('%d')",sm);
			    mysql_function_query(MySQL_R394,query,false,"","");
			    MakeSmarkt[playerid] = sm;
			    GetPlayerPos(playerid,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]);
			    SmarkInfo[sm][screatet] = 1;
			    strmid(SmarkInfo[sm][swerbetext],"Keine",0,strlen("Keine"),64);
			    SmarkInfo[sm][sartikel][0] = 60;
				SmarkInfo[sm][sartikel][1] = 20;
				SmarkInfo[sm][sartikel][2] = 150;
				SmarkInfo[sm][sartikel][3] = 120;
				SmarkInfo[sm][sartikel][4] = 400;
				SmarkInfo[sm][sartikel][5] = 350;
				SmarkInfo[sm][sartikel][6] = 550;
				SmarkInfo[sm][sartikel][7] = 1250;
				SmarkInfo[sm][sartikel][8] = 1399;
				SmarkInfo[sm][sartikel][9] = 2001;
				SmarkInfo[sm][sartikel][10] = 2565;
				SmarkInfo[sm][sartikel][11] = 100;
				SmarkInfo[sm][sartikel][12] = 4997;
				SmarkInfo[sm][sattackerfraktid] = 0;
				SmarkInfo[sm][swarownerpoints] = 0;
				SmarkInfo[sm][swarattackerpoints] = 0;
				SmarkInfo[sm][swartime] = 0;
				SmarkInfo[sm][swarsleep] = 0;
			    SmarktLabel[sm] = CreateDynamic3DTextLabel("SCHWARZMARKT ERSTELLUNG",SMARKCOLOR,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz] +1,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
			    for(new i=0;i<sizeof(sBuyInfo);i++){ SmartkWaffenLabel[sm][i] = CreateDynamic3DTextLabel(sBuyInfo[i][sbuyweaponname],SMARKWEAPONCOLOR,sBuyInfo[i][sbuyx],sBuyInfo[i][sbuyy],sBuyInfo[i][sbuyz],1.5,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,sm); }
				SmarkInfo[sm][spickup] = CreateDynamicPickup(OWNEDSMARKTPICKUP,1,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz],0);
				ShowPlayerDialog(playerid,SCREATE_DIALOG_PREIS,DIALOG_STYLE_INPUT,"Smarkterstellung Schritt 1","Gib den Preis an,\nfür den der Schwarzmarkt zum verkauf freigestellt werden soll:","Weiter","Smarkt löschen");
				return 1;
		   	}
	   	}
	   	return SCM(playerid,SAMP_WEISS,"Die maximale Anzahl an erstellten Schwarzmärkten ist erreicht!");
	}
 	if(strcmp(cmd,"Gutschein",true) == 0)
   	{
	   	for(new g=1;g<MAX_GUTSCHEIN;g++)
	   	{
		   	if(Gutschein[g][gutscheincreatet] != 1)
			{
				format(query,sizeof(query),"INSERT INTO server_gutscheine (id) VALUES ('%d')",g);
			    mysql_function_query(MySQL_R394,query,false,"","");
			    MakeGutschein[playerid] = g;
			    Gutschein[g][gutscheincreatet] = 1;
			    strmid(Gutschein[g][gutscheincode],"Unbekannt",0,strlen("Unbekannt"),16);
			    strmid(Gutschein[g][gutscheinname],"Unbekannt",0,strlen("Unbekannt"),32);
				strmid(Gutschein[g][gutscheindesc],"Unbekannt",0,strlen("Unbekannt"),64);
				Gutschein[g][gutscheintyp] = 0;
				Gutschein[g][gutscheinmenge] = 0;
				Gutschein[g][gutscheinanzahl] = 0;
				ShowPlayerDialog(playerid,GUTSCHEIN_CREATE_CODE,DIALOG_STYLE_INPUT,"Gutscheinerstellung Schritt 1","Gib deinen Gutscheincode ein:","Weiter","Gutschein löschen");
				return 1;
		   	}
	   	}
	   	return SCM(playerid,SAMP_WEISS,"Die maximale Anzahl an erstellten Gutscheinen ist erreicht!");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /erstellen [Haus/Business/Schwarzmarkt/Gutschein]");
}

COMMAND:kaufen(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    for(new haus=1;haus<MAX_HAUS;haus++)
	{
		if(HausInfo[haus][hauscreatet] == 1)
		{
			if(IsPlayerInRangeOfPoint(playerid,2,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]))
			{
				if(Spieler[playerid][pPersoLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Personalausweis.");
			    if(strcmp(HausInfo[haus][haus_besitzer],Spieler[playerid][pName],false) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Haus hast du bereits gekauft.");
				if(strcmp(HausInfo[haus][haus_besitzer],"Niemand",false))return GameTextForPlayer(playerid,"~r~Haus bereits verkauft!",2000,1);
			    ReturnPropertyData(playerid);
				new count = Spieler[playerid][pReturnPropertyDataHausCount];
				if(count >= MAX_HAUS_OWNER)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt bereits ein Haus.");
				if(HausInfo[haus][haus_Owned] == 1)return GameTextForPlayer(playerid,"~r~Haus bereits verkauft!",2000,1);
			    //if(GetPlayerLevel(playerid) < HausInfo[haus][haus_level])return GameTextForPlayer(playerid,"~r~Level ~n~ reicht nicht aus.",1000,3);
			    if((GetACMoney(playerid) - HausInfo[haus][haus_preis]) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" Nicht genug Geld auf der Hand");
				format(string,sizeof(string),""IINFO" du hast dir ein Haus für "IINFO2"%i$"#HTML_WEISS" gekauft.",HausInfo[haus][haus_preis]);
				SCM(playerid,SAMP_WEISS,string);
				ACMoney(playerid,- HausInfo[haus][haus_preis]);
				HausInfo[haus][haus_Owned] = 1;
				DestroyDynamicPickup(HausInfo[haus][haus_pickup]);
				HausInfo[haus][haus_pickup] = CreateDynamicPickup(Server_Haus_Besetzt_Pickup,1,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z],-1);
				strmid(HausInfo[haus][haus_besitzer],Spieler[playerid][pName],0,strlen(Spieler[playerid][pName]),24);
			    UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
			    SaveOnlyOneHaus(haus);
			    SaveAccount(playerid);
			    return 1;
		    }
	    }
    }
    for(new biz=1;biz<MAX_BIZ;biz++)
	{
		if(BizInfo[biz][bizcreatet] == 1)
		{
			if(IsPlayerInRangeOfPoint(playerid,2,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]))
			{
				if(Spieler[playerid][pPersoLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Personalausweis.");
			  	if(strcmp(BizInfo[biz][biz_besitzer],Spieler[playerid][pName],false) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Business hast du bereits gekauft.");
				if(strcmp(BizInfo[biz][biz_besitzer],"Niemand",false))return GameTextForPlayer(playerid,"~r~Business bereits verkauft!",2000,1);
				if(BizInfo[biz][biz_Owned] == 1)return GameTextForPlayer(playerid,"~r~Business bereits verkauft!",2000,1);
				if(Spieler[playerid][pPremium] > gettime())
				{
					if(IsPlayerAnyBusinessOwner(Spieler[playerid][pName]) >= MAX_BUSINESS_OWNER)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt bereits "#MAX_BUSINESS_OWNER" Businesse.");
				}
				else
				{
				if(IsPlayerAnyBusinessOwner(Spieler[playerid][pName]) >= MAX_BUSINESS_OWNER/2)
				{
					format(string,sizeof(string),""IINFO" du besitzt bereits %i Businesse.",MAX_BUSINESS_OWNER/2);
					return SCM(playerid,SAMP_WEISS,string);
				}
				}
				//if(GetPlayerLevel(playerid) < BizInfo[biz][biz_level])return GameTextForPlayer(playerid,"~r~Level ~n~ reicht nicht aus.",1000,3);
			    if((GetACMoney(playerid) - BizInfo[biz][biz_preis]) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" Nicht genug Geld auf der Hand");
			    format(string,sizeof(string),""IINFO" du hast dir ein Business [%s] für %i$ gekauft.",BizName(biz),BizInfo[biz][biz_preis]);
				SCM(playerid,SAMP_WEISS,string);
				ACMoney(playerid,- BizInfo[biz][biz_preis]);
				BizInfo[biz][biz_Owned] = 1;
				DestroyDynamicPickup(BizInfo[biz][biz_pickup][0]);
				BizInfo[biz][biz_pickup][0] = CreateDynamicPickup(Server_Business_Besetzt_Pickup,1,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z],-1);
				strmid(BizInfo[biz][biz_besitzer],Spieler[playerid][pName],0,strlen(Spieler[playerid][pName]),24);
			    UpdateBizLabel(biz,2);//funktion 1 wenn das biz ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
			    SaveOnlyOneBiz(biz);
			    SaveAccount(playerid);
			    return 1;
		    }
	    }
    }
    for(new sm=1;sm<MAX_SMARKETS;sm++)
    {
	    if(SmarkInfo[sm][screatet] == 1)
	    {
		    if(IsPlayerInRangeOfPoint(playerid,5.0,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]))
		    {
			    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
				{
				    if(GetFraktionSmarkCount(Spieler[playerid][pFraktion]) >= MAX_SMARKETSBYFRAKTION)return SCM(playerid,SAMP_WEISS,"Deine fraktion besitzt bereits die maximale Anzahl an Partnerschaften oder besitzt schon zu viele Schwarzmärkte.");
					if(SmarkInfo[sm][sfraktid] == Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,"Dieser Schwarzmarkt gehört bereits eurer Fraktion.");
				    if(SmarkInfo[sm][sbdfraktid] == Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,"Ihr seid bereits Teilhaber dieses Schwarzmarktes.");
				    if((GetACMoney(playerid) - SmarkInfo[sm][sprice]) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" Nicht genug Geld auf der Hand");
				    format(string,sizeof(string),"%s (ID:%i) hat einen Schwarzmarkt (ID:%i) für %i$ gekauft. | Er gehört nun euch.",Spieler[playerid][pName],playerid,sm,SmarkInfo[sm][sprice]);
				    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
				    ACMoney(playerid,- SmarkInfo[sm][sprice]);
				    SmarkInfo[sm][sfraktid] = Spieler[playerid][pFraktion];
				    SmarkInfo[sm][sbdfraktid] = 0;
				    SmarkInfo[sm][sartikel][0] = 60;
					SmarkInfo[sm][sartikel][1] = 20;
					SmarkInfo[sm][sartikel][2] = 150;
					SmarkInfo[sm][sartikel][3] = 120;
					SmarkInfo[sm][sartikel][4] = 400;
					SmarkInfo[sm][sartikel][5] = 350;
					SmarkInfo[sm][sartikel][6] = 550;
					SmarkInfo[sm][sartikel][7] = 1250;
					SmarkInfo[sm][sartikel][8] = 1399;
					SmarkInfo[sm][sartikel][9] = 2001;
					SmarkInfo[sm][sartikel][10] = 2565;
					SmarkInfo[sm][sartikel][11] = 100;
					SmarkInfo[sm][sartikel][12] = 4997;
					DestroyDynamicPickup(SmarkInfo[sm][spickup]);
				    SmarkInfo[sm][spickup] = CreateDynamicPickup(OWNEDSMARKTPICKUP,1,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz],0);
					UpdateSmarkLabel(sm,2);//funktion 1 wenn der smark ohne frakt ist,funktion 2 wenn der smarkt mit frakt besetzt ist
				    SaveOnlyOneSmarkt(sm);
					return 1;
			    }
			    return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
		    }
	    }
    }
    return 1;
}

COMMAND:bizverkaufen(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new biz = GetBusinessOwner(playerid,Spieler[playerid][pName]),string[128];
    if(biz == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht Besitzer des Business./Du bist nicht Teilhaber des Business./Du musst in deinem Business/an deinem Business sein.");
	if(IsPlayerInRangeOfPoint(playerid,2,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]))
	{
	    ACMoney(playerid,floatround(BizInfo[biz][biz_preis]/2));
		format(string,sizeof(string),""IINFO" du erhälst einen Bruchteil vom Kaufpreis zurück.(%i$)",BizInfo[biz][biz_preis]/2);
	 	SCM(playerid,SAMP_WEISS,string);
		BizInfo[biz][biz_Owned] = 0;
		BizInfo[biz][biz_locked] = 0;
		strmid(BizInfo[biz][biz_besitzer],"Niemand",0,strlen("Niemand"),24);
		strmid(BizInfo[biz][biz_teilhaber],"Niemand",0,strlen("Niemand"),24);
		//strmid(BizInfo[biz][biz_beschreibung],"Keine",0,strlen("Keine"),150);
		UpdateBizLabel(biz,1);//funktion 1 wenn das biz ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
	    DestroyDynamicPickup(BizInfo[biz][biz_pickup][0]);
		BizInfo[biz][biz_pickup][0] = CreateDynamicPickup(Server_Business_Frei_Pickup,1,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z],-1);
	    SaveOnlyOneBiz(biz);
		SaveAccount(playerid);
	    return 1;
    }
    return SCM(playerid,SAMP_WEISS,""IINFO" du musst an deinem Business sein.");
}

COMMAND:averkaufen(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],query[128];
    if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    for(new haus=1;haus<MAX_HAUS;haus++)
    {
	    if(HausInfo[haus][hauscreatet] == 1)
		{
		    if(IsPlayerInRangeOfPoint(playerid,1,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]))
			{
				if(HausInfo[haus][haus_Owned] != 1)return SCM(playerid,SAMP_WEISS,"Haus bereits ohne Inhaber.");
			    format(string,sizeof(string),""IINFO" du hast die Hausnummer %i wieder zum verkauf freigemacht!",haus);
			    SCM(playerid,SAMP_WEISS,string);
			    DestroyDynamicPickup(HausInfo[haus][haus_pickup]);
				HausInfo[haus][haus_Owned] = 0;
				HausInfo[haus][haus_eingemitetenzaehler] = 0;
				HausInfo[haus][haus_locked] = 1;
				new pID = GetPlayerID(HausInfo[haus][haus_besitzer]);
				if(pID != -1)
				{
					Spieler[pID][pSpawn] = 0;
				}
				else mysql_SetInt("spieler","Spawn",0 ,"Name",HausInfo[haus][haus_besitzer]);
				strmid(HausInfo[haus][haus_besitzer],"Niemand",0,strlen("Niemand"),24);
				//strmid(HausInfo[haus][haus_beschreibung],"Keine",0,strlen("Keine"),150);
				strmid(HausInfo[haus][haus_msg],"Keine",0,strlen("Keine"),150);
				UpdateHausLabel(haus,1);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
			    HausInfo[haus][haus_pickup] = CreateDynamicPickup(Server_Haus_Frei_Pickup,1,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z],-1);
			    SaveOnlyOneHaus(haus);
				format(query,sizeof(query),"SELECT Name FROM spieler WHERE HausMieter='%d'",haus);
			    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,k_script_mieterkick,playerid,MySQL_R394);
				return 1;
		    }
	    }
    }
    for(new biz=1;biz<MAX_BIZ;biz++)
    {
	    if(BizInfo[biz][bizcreatet] == 1)
	    {
		    if(IsPlayerInRangeOfPoint(playerid,2,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z]))
			{
				if(BizInfo[biz][biz_Owned] != 1)return SCM(playerid,SAMP_WEISS,"Business bereits ohne Inhaber.");
			    format(string,sizeof(string),""IINFO" du hast die Businessnummer %i wieder zum verkauf freigemacht!",biz);
			    SCM(playerid,SAMP_WEISS,string);
				BizInfo[biz][biz_Owned] = 0;
				BizInfo[biz][biz_locked] = 0;
				strmid(BizInfo[biz][biz_besitzer],"Niemand",0,strlen("Niemand"),24);
				strmid(BizInfo[biz][biz_teilhaber],"Niemand",0,strlen("Niemand"),24);
				//strmid(BizInfo[biz][biz_beschreibung],"Keine",0,strlen("Keine"),150);
				UpdateBizLabel(biz,1);//funktion 1 wenn das biz ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
				DestroyDynamicPickup(BizInfo[biz][biz_pickup][0]);
			    BizInfo[biz][biz_pickup][0] = CreateDynamicPickup(Server_Business_Frei_Pickup,1,BizInfo[biz][biz_x],BizInfo[biz][biz_y],BizInfo[biz][biz_z],-1);
			    SaveOnlyOneBiz(biz);
				return 1;
			}
		}
	}
	for(new sm=1;sm<MAX_SMARKETS;sm++)
    {
	    if(SmarkInfo[sm][screatet] == 1)
	    {
		    if(IsPlayerInRangeOfPoint(playerid,5.0,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]))
		    {
				if(SmarkInfo[sm][sfraktid] == 0)return SCM(playerid,SAMP_WEISS,"Dieser Schwarzmarkt gehört bereits keiner Fraktion.");
				format(string,sizeof(string),""IINFO" du hast den Schwarzmarkt (ID:%i) wieder zum verkauf freigemacht!",sm);
			    SCM(playerid,SAMP_WEISS,string);
			    SmarkInfo[sm][sfraktid] = 0;
			    SmarkInfo[sm][sbdfraktid] = 0;
			    SmarkInfo[sm][slocked] = 0;
			    SmarkInfo[sm][sartikel][0] = 60;
				SmarkInfo[sm][sartikel][1] = 20;
				SmarkInfo[sm][sartikel][2] = 150;
				SmarkInfo[sm][sartikel][3] = 120;
				SmarkInfo[sm][sartikel][4] = 400;
				SmarkInfo[sm][sartikel][5] = 350;
				SmarkInfo[sm][sartikel][6] = 550;
				SmarkInfo[sm][sartikel][7] = 1250;
				SmarkInfo[sm][sartikel][8] = 1399;
				SmarkInfo[sm][sartikel][9] = 2001;
				SmarkInfo[sm][sartikel][10] = 2565;
				SmarkInfo[sm][sartikel][11] = 100;
				SmarkInfo[sm][sartikel][12] = 4997;
				strmid(SmarkInfo[sm][swerbetext],"Keine",0,strlen("Keine"),64);
			    DestroyDynamicPickup(SmarkInfo[sm][spickup]);
			    SmarkInfo[sm][spickup] = CreateDynamicPickup(NOTOWNEDSMARKTPICKUP,1,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz],0);
				UpdateSmarkLabel(sm,1);//funktion 1 wenn der smark ohne frakt ist,funktion 2 wenn der smarkt mit frakt besetzt ist
			    SaveOnlyOneSmarkt(sm);
				return 1;
		    }
	    }
    }
    return 1;
}

COMMAND:apropertydelete(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new id,string[128],query[128],cmd[15];
    if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(sscanf(params,"s[15]i",cmd,id))return SCM(playerid,SAMP_WEISS,""IINFO" /apropertydelete [Haus/Business/Schwarzmarkt][Hausnummer/ID/ID]");
    if(strcmp(cmd,"Haus",true) == 0)
	{
		if(id >= MAX_HAUS)return SCM(playerid,SAMP_WEISS,"Hausnummer über maximaler Hausanzahl!");
	    if(HausInfo[id][hauscreatet] != 1)return SCM(playerid,SAMP_WEISS,"Haus existiert nicht!");
		if(!IsPlayerInRangeOfPoint(playerid,2,HausInfo[id][haus_x],HausInfo[id][haus_y],HausInfo[id][haus_z]))return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe der Hausnummer!");
		new pID = GetPlayerID(HausInfo[id][haus_besitzer]);
		if(pID != -1)
		{
			Spieler[pID][pSpawn] = 0;
		}
		else mysql_SetInt("spieler","Spawn",0 ,"Name",HausInfo[id][haus_besitzer]);
	   	format(string,sizeof(string),""IINFO" du hast das Haus %i erfolgreich gelöscht!",id);
	    SCM(playerid,SAMP_WEISS,string);
	    DestroyDynamicPickup(HausInfo[id][haus_pickup]);
	    DestroyDynamic3DTextLabel(HausLabel[id]);
	    format(query,sizeof(query),"DELETE FROM server_haus WHERE id = '%d'",id);
	   	mysql_function_query(MySQL_R394,query,false,"","");
	    HausInfo[id][hauscreatet] = 0;
	    HausInfo[id][haus_x] = -1;
	    HausInfo[id][haus_y] = -1;
	    HausInfo[id][haus_z] = -1;
	    HausInfo[id][haus_Owned] = 0;
	    HausInfo[id][haus_innenraum] = 255;
	    HausInfo[id][haus_miete] = 0;
	    HausInfo[id][haus_locked] = 1;
	    HausInfo[id][haus_slots] = 0;
	    HausInfo[id][haus_eingemitetenzaehler] = 0;
		HausInfo[id][haus_preis] = 0;
		HausInfo[id][haus_level] = 0;
		HausInfo[id][haus_geldkasse] = 0;
		HausInfo[id][haus_Opium] = 0;
		HausInfo[id][haus_Spice] = 0;
	    HausInfo[id][haus_c4] = 0;
		HausInfo[id][haus_Ganja] = 0;
		HausInfo[id][haus_Kokain] = 0;
	    HausInfo[id][haus_materials] = 0;
		HausInfo[id][haus_heal] = 0;
		HausInfo[id][haus_armour] = 0;
		HausInfo[id][haus_hatheal] = 0;
		HausInfo[id][haus_hatarmour] = 0;
		HausInfo[id][hausmull] = 0;
		strmid(HausInfo[id][haus_besitzer],"Niemand",0,strlen("Niemand"),24);
		strmid(HausInfo[id][haus_beschreibung],"Keine",0,strlen("Keine"),150);
		strmid(HausInfo[id][haus_msg],"Keine",0,strlen("Keine"),150);
		format(query,sizeof(query),"SELECT Name FROM spieler WHERE HausMieter='%d'",id);
	    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,k_script_mieterkick,playerid,MySQL_R394);
	    mysql_format(MySQL_R394,query,sizeof(query),"DELETE FROM server_housemoebel WHERE haus_dbid='%d'",HausInfo[id][dbhaus_id]);
	    mysql_function_query(MySQL_R394,query,false,"","");
	    for(new hobj=0;hobj<MAX_HAUSOBJECTS;hobj++)
	    {
			if(HausmoebelInfo[hobj][hmhaus_dbid] == HausInfo[id][dbhaus_id] && HausmoebelInfo[hobj][hmmodelid] != 0)
			{
				DestroyDynamicObject(HausmoebelInfo[hobj][hmobjectid]);
			    HausmoebelInfo[hobj][hmmodelid] = 0;
			}
		}
	 	return 1;
    }
    if(strcmp(cmd,"Business",true) == 0)
	{
		if(id >= MAX_BIZ)return SCM(playerid,SAMP_WEISS,"Bizid über maximaler Businessanzahl!");
		if(BizInfo[id][bizcreatet] != 1)return SCM(playerid,SAMP_WEISS,"Business existiert nicht!");
		if(!IsPlayerInRangeOfPoint(playerid,2,BizInfo[id][biz_x],BizInfo[id][biz_y],BizInfo[id][biz_z]))return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe der Bizid!");
	   	format(string,sizeof(string),""IINFO" du hast das Business %i erfolgreich gelöscht!",id);
	    SCM(playerid,SAMP_WEISS,string);
	    if(BizInfo[id][biz_art] == 13)//Hotel
	    {
		    format(query,sizeof(query),"SELECT Name FROM spieler WHERE Hotel='%d'",id);
		    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,a_script_hotelkick,id,MySQL_R394);
		}
		strmid(BizInfo[id][biz_besitzer],"Niemand",0,strlen("Niemand"),24);
		strmid(BizInfo[id][biz_teilhaber],"Niemand",0,strlen("Niemand"),24);
		strmid(BizInfo[id][biz_beschreibung],"Keine",0,strlen("Keine"),150);
	    DestroyDynamicPickup(BizInfo[id][biz_pickup][0]);
	    DestroyDynamic3DTextLabel(BizLabel[id][0]);
	    DestroyDynamicPickup(BizInfo[id][biz_pickup][1]);
	    DestroyDynamic3DTextLabel(BizLabel[id][1]);
	    DestroyDynamicPickup(BizInfo[id][biz_pickup][2]);
	    DestroyDynamic3DTextLabel(BizLabel[id][2]);
	    format(query,sizeof(query),"DELETE FROM server_bizes WHERE id = '%d'",id);
	   	mysql_function_query(MySQL_R394,query,false,"","");
	    BizInfo[id][biz_art] = 0;
	   	BizInfo[id][bizcreatet] = 0;
	    BizInfo[id][biz_Owned] = 0;
	    BizInfo[id][biz_locked] = 0;
	    BizInfo[id][biz_x] = -1;
	    BizInfo[id][biz_y] = -1;
	    BizInfo[id][biz_z] = -1;
	    BizInfo[id][tPos][0] = 0;
	    BizInfo[id][tPos][1] = 0;
	    BizInfo[id][tPos][2] = 0;
	    BizInfo[id][tPos][3] = 0;
	    BizInfo[id][tPos][4] = 0;
	    BizInfo[id][tPos][5] = 0;
	    BizInfo[id][biz_interior] = 0;
		BizInfo[id][biz_preis] = 0;
		BizInfo[id][biz_level] = 0;
		BizInfo[id][biz_geldkasse] = 0;
	    return 1;
    }
    if(strcmp(cmd,"Schwarzmarkt",true) == 0)
	{
		if(id >= MAX_SMARKETS)return SCM(playerid,SAMP_WEISS,"Smarktid über maximaler Schwarzmarktanzahl!");
		if(SmarkInfo[id][screatet] != 1)return SCM(playerid,SAMP_WEISS,"Schwarzmarkt existiert nicht!");
		if(!IsPlayerInRangeOfPoint(playerid,2,SmarkInfo[id][sx],SmarkInfo[id][sy],SmarkInfo[id][sz]))return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe des Schwarzmarktes!");
	    format(string,sizeof(string),""IINFO" du hast den Schwarzmarkt %i erfolgreich gelöscht!",id);
	    SCM(playerid,SAMP_WEISS,string);
		format(query,sizeof(query),"DELETE FROM server_schwarzmarkt WHERE id = '%d'",id);
	   	mysql_function_query(MySQL_R394,query,false,"","");
		for(new i=0;i<sizeof(sBuyInfo);i++){ DestroyDynamic3DTextLabel(SmartkWaffenLabel[id][i]); }
		DestroyDynamic3DTextLabel(SmarktLabel[id]);
		DestroyDynamicPickup(SmarkInfo[id][spickup]);
		SmarkInfo[id][screatet] = 0;
	    SmarkInfo[id][sfraktid] = 0;
	    SmarkInfo[id][sbdfraktid] = 0;
	    SmarkInfo[id][sx] = 0.0;
	    SmarkInfo[id][sy] = 0.0;
	    SmarkInfo[id][sz] = 0.0;
	    SmarkInfo[id][slocked] = 0;
	    SmarkInfo[id][smaterials] = 0;
	    strmid(SmarkInfo[id][swerbetext],"Keine",0,strlen("Keine"),64);
	    SmarkInfo[id][sprice] = 0;
	    SmarkInfo[id][skasse] = 0;
		for(new i=0;i<14;i++){ SmarkInfo[id][sartikel][i] = 0; }
		if(SmarkInfo[id][sattackerfraktid] != 0) GangZoneDestroy(SmarkInfo[id][swarzone]);
		SmarkInfo[id][sattackerfraktid] = 0;
		SmarkInfo[id][swarownerpoints] = 0;
		SmarkInfo[id][swarattackerpoints] = 0;
		SmarkInfo[id][swartime] = 0;
		SmarkInfo[id][swarsleep] = 0;
		return 1;
	}
    return SCM(playerid,SAMP_WEISS,""IINFO" /apropertydelete [Haus/Business/Schwarzmarkt][Hausnummer/ID/ID]");
}

COMMAND:allownedsmarkets(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],counter = 0;
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	SCM(playerid,SAMP_WEISS,"|_______Besetzte Schwarzmärkte auf "#SERVERNAME"_______|");
	for(new sm=1;sm<MAX_SMARKETS;sm++)
	{
	    if(SmarkInfo[sm][sfraktid] != 0 && SmarkInfo[sm][screatet] == 1)
		{
		    format(string,sizeof(string),"ID:%i | Besitzer:%s | Partner:%s | Kosten:%i$ | Beschreibung:%s",sm,FraktionsName(SmarkInfo[sm][sfraktid]),FraktionsName(SmarkInfo[sm][sbdfraktid]),SmarkInfo[sm][sprice],SmarkInfo[sm][swerbetext]);
		    SCM(playerid,SAMP_WEISS,string);
		    counter++;
	    }
	    }
    if(counter == 0)return SCM(playerid,SAMP_WEISS,"Keine vorhanden!");
	return 1;
}
