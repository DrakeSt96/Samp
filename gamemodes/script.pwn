            SCM(playerid,SAMP_WEISS,"Warte einen Moment! Die Waren werden aufgeladen.");
			fjobgo1[playerid] = 6;
			DisablePlayerCheckpoint(playerid);
			SetTimerEx("UnTazer",7500,false,"i",playerid);
			TogglePlayerControllable(playerid,false);
			SetPlayerCheckpoint(playerid,1730.8606,-2421.1853,13.7313,7.5);
		}
	}
	else if(fjobgo1[playerid] == 6)
	{
	    if(IsVehicleATransportplane2(vehicleid))
	    {
	        new randcash = random(600) + 150;
	        SCM(playerid,SAMP_WEISS,"Ladung wird entladen!");
            SCM(playerid,SAMP_WEISS,""IINFO" du hast die Route erfolgreich abgeflogen!");
            format(string,sizeof(string),"Verdienst: %i$",randcash);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[playerid][pLohn] += randcash;
			SCM(playerid,SAMP_WEISS,"Info: Die Auszahlung wird am Zahltag auf dein Konto überwiesen.");
			fjobgo1[playerid] = 0;
			SetTimerEx("UnTazer",2000,false,"i",playerid);
			TogglePlayerControllable(playerid,false);
			DisablePlayerCheckpoint(playerid);
			ShowPlayerDialog(playerid,DIALOG_JOB_START_AUSWAHL,DIALOG_STYLE_MSGBOX,"Versorgungslieferant","Entscheide dich ob du den Job ´Starten´ oder ´Abbrechen´ willst !?","Starten","Abbrechen");
		}
	}

	if(farmjobgo[playerid] == 1)
	{
	    if(IsVehicleAFarmCar(vehicleid))
	    {
	        new rErnte = random(10) + 2;
	        if((VehicleLoadTank[vehicleid] + rErnte) >= 500)
	        {
	        farmjobgo[playerid] = 2;
	        VehicleLoadTank[vehicleid] = 500;
	        if(farmpflanze[playerid] != -1) DestroyDynamicObject(farmpflanze[playerid]);
	        PlayerTextDrawSetString(playerid,VEHJOBTANKdraw[playerid],"500kg");
	        DisablePlayerCheckpoint(playerid);
	        SetPlayerCheckpoint(playerid,-398.6879,-1456.4888,25.7266,7.5);
	        SCM(playerid,SAMP_WEISS,""IINFO" der Erntetank deines Mähdreschers ist voll. Fahr zum Entladepunkt, und gebe '/entladen' ein.");
	        return 1;
	        }
	        farmjobgo[playerid] = 1;
	        VehicleLoadTank[vehicleid] += rErnte;
	        format(string,sizeof(string),"%ikg",VehicleLoadTank[vehicleid]);
   	 		PlayerTextDrawSetString(playerid,VEHJOBTANKdraw[playerid],string);
			DisablePlayerCheckpoint(playerid);
			if(farmpflanze[playerid] != -1) DestroyDynamicObject(farmpflanze[playerid]);
			new rSpawn = random(sizeof(farmcheckpoints1));
			SetPlayerCheckpoint(playerid,farmcheckpoints1[rSpawn][0],farmcheckpoints1[rSpawn][1],farmcheckpoints1[rSpawn][2],7.5);
            farmpflanze[playerid] = CreateDynamicObject(823,farmcheckpoints1[rSpawn][0],farmcheckpoints1[rSpawn][1],farmcheckpoints1[rSpawn][2],0,0,0);
		}
	}
	else if(farmjobgo[playerid] == 2)
	{
	    if(IsVehicleAFarmCar(vehicleid))
	    {
	    SCM(playerid,SAMP_WEISS,"Zum entladen /entladen!");
	    farmjobgo[playerid] = 1;
	    DisablePlayerCheckpoint(playerid);
	    }
	}

	if(farmjobgo2[playerid] == 1)
	{
	    if(IsVehicleAFarmCar2(vehicleid))
	    {
	        new rErnte = random(10) + 2;
	        if((VehicleLoadTank[vehicleid] + rErnte) >= 500)
	        {
	        farmjobgo2[playerid] = 2;
	        VehicleLoadTank[vehicleid] = 500;
	        if(farmpflanze[playerid] != -1) DestroyDynamicObject(farmpflanze[playerid]);
	        PlayerTextDrawSetString(playerid,VEHJOBTANKdraw[playerid],"500kg");
	        DisablePlayerCheckpoint(playerid);
	        SetPlayerCheckpoint(playerid,-71.4187,-32.5338,3.1172,7.5);
	        SCM(playerid,SAMP_WEISS,""IINFO" der Erntetank deines Mähdreschers ist voll fahre zum Entladepunkt.");
	        return 1;
	        }
	        farmjobgo2[playerid] = 1;
	        VehicleLoadTank[vehicleid] += rErnte;
	        format(string,sizeof(string),"%ikg",VehicleLoadTank[vehicleid]);
   			PlayerTextDrawSetString(playerid,VEHJOBTANKdraw[playerid],string);
			DisablePlayerCheckpoint(playerid);
			if(farmpflanze[playerid] != -1) DestroyDynamicObject(farmpflanze[playerid]);
			new rSpawn = random(sizeof(farmcheckpoints2));
			SetPlayerCheckpoint(playerid,farmcheckpoints2[rSpawn][0],farmcheckpoints2[rSpawn][1],farmcheckpoints2[rSpawn][2],7.5);
			farmpflanze[playerid] = CreateDynamicObject(823,farmcheckpoints2[rSpawn][0],farmcheckpoints2[rSpawn][1],farmcheckpoints2[rSpawn][2],0,0,0);
		}
	}
	else if(farmjobgo2[playerid] == 2)
	{
	    if(IsVehicleAFarmCar2(vehicleid))
	    {
	    SCM(playerid,SAMP_WEISS,"Zum entladen /entladen!");
	    farmjobgo2[playerid] = 1;
	    DisablePlayerCheckpoint(playerid);
	    }
	}
	}
   	return 1;
}

public Other2()
{
	new string[650];
	if(gettime() > GeneratedKeyTstamp)
	{
    	GeneratedKey = 100000 + random(50000);
	}
    for(new drg=0;drg<MAX_DRUGS;drg++)
	{
		if(DrugInfo[drg][drgfraktid] != 0)
		{
			new timerand = random(30) + 30,drugrand = random(50) + 100;
			DrugInfo[drg][drgNextDrugsIn]--;
			if(DrugInfo[drg][drgNextDrugsIn] <= 0)
			{
				DrugInfo[drg][drgProduceDrugs] += drugrand;
				DrugInfo[drg][drgNextDrugsIn] = (60*timerand);
			}
		 	format(string,sizeof(string),"[ "IINFO2"Drogen Pflanze"#HTML_WEISS" ]\nPflanze: "IINFO2"%i"#HTML_WEISS"\nArt: "IINFO2"%s"#HTML_WEISS"\nBesitzer: "IINFO2"%s"#HTML_WEISS"\nFraktion: "IINFO2"%s"#HTML_WEISS"\nDrogenmenge: "IINFO2"%ig"#HTML_WEISS"\nDrogen in "IINFO2"%i:%02d"#HTML_WEISS" Minuten\nWasserzustand: "IINFO2"%i%",
		 	drg,DrugArtByName(DrugInfo[drg][drgArt]),DrugInfo[drg][drgOwner],FraktionsName(DrugInfo[drg][drgfraktid]),DrugInfo[drg][drgProduceDrugs],DrugInfo[drg][drgNextDrugsIn]/60,DrugInfo[drg][drgNextDrugsIn]%60,DrugInfo[drg][drgWasserzustand]);
			UpdateDynamic3DTextLabelText(DrugLabel[drg],SAMP_WEISS,string);
		}
	}
	/*
	for(new oi=1;oi<MAX_OFFLINEPICKUPS;oi++)
	{
	    if(OfflineInfo[oi][Ocreated] == true)
	    {
	        if(gettime() > OfflineInfo[oi][Odeletetime]){ DeleteOfflineInfo(oi); }
	        else
	        {
	            new time = OfflineInfo[oi][Odeletetime] - gettime();
				format(string,sizeof(string),""#HTML_WHITE"Offline Information\n"#HTML_BLAU"Name"#HTML_WHITE": %s\n"#HTML_BLAU"Wantedpunkte"#HTML_WHITE": %i\n"#HTML_BLAU"Offlinezeit"#HTML_WHITE": "IINFO2"%i:%02d"#HTML_WEISS" Minuten",OfflineInfo[oi][Oname],OfflineInfo[oi][Owanteds],time/60,time%60);
				UpdateDynamic3DTextLabelText(OfflineInfo3Dtext[oi],WEISS,string);
	        }
		}
	}*/
	return 1;
}
public Other()
{
    new Float:Pos[3],armybaseschwulies = 0,alkaschwulies = 0;
    for(new i=0;i<MAX_RUBBISH;i++)
	{
		if(SRubbishInfo[i][RubbishCreated] == false && gettime() > SRubbishInfo[i][NextRubbishIn])
		{
			SRubbishInfo[i][RubbishCreated] = true;
			SRubbishInfo[i][RubbishObject] = CreateDynamicObject(2672,SRubbishInfo[i][RposX],SRubbishInfo[i][RposY],SRubbishInfo[i][RposZ]-0.3,0.0,0.0,0.0);
		}
	}
	for(new msten=0;msten<MAX_MASTEN;msten++)
	{
		if(FMastenInfo[msten][Erstellt] == 1 && FMastenInfo[msten][EGmBhHp] > 0)
		{
			if(gettime() > FMastenInfo[msten][EGmBhTstamp])
			{
				FMastenInfo[msten][EGmBhHp]--;
				FMastenInfo[msten][EGmBhTstamp] = gettime() + ((random(3) + 3)*60);
				if(FMastenInfo[msten][EGmBhHp] <= 0)
				{
					FMastenInfo[msten][EGmBhHp] = 0;
			    	FMastenInfo[msten][EGmBhRubbishObject] = CreateDynamicObject(18727,FMastenInfo[msten][sperreX],FMastenInfo[msten][sperreY],FMastenInfo[msten][sperreZ],0,0,0);
   					FMastenInfo[msten][RubLabel] = CreateDynamic3DTextLabel("Funkmast Kaputt!",SAMP_WEISS,FMastenInfo[msten][sperreX],FMastenInfo[msten][sperreY],FMastenInfo[msten][sperreZ]+0.5, 10.0);
				}
			}
		}
	}
	for(new i=0;i<MAX_BLITZER;i++)
	{
	 	if(Blitzer[i][Erstellt] == 1 &&  Blitzer[i][EGmBhHp] > 0)
		{
			if(gettime() > Blitzer[i][EGmBhTstamp])
			{
				Blitzer[i][EGmBhHp]--;
				Blitzer[i][EGmBhTstamp] = gettime() + ((random(3) + 3)*60);
				if(Blitzer[i][EGmBhHp] <= 0)
				{
					Blitzer[i][EGmBhHp] = 0;
   					Blitzer[i][RubLabel] = CreateDynamic3DTextLabel("Blitzer Kaputt!",SAMP_WEISS,Blitzer[i][sperreX],Blitzer[i][sperreY],Blitzer[i][sperreZ]+0.5, 10.0);
				    Blitzer[i][EGmBhRubbishObject] = CreateDynamicObject(18727,Blitzer[i][sperreX],Blitzer[i][sperreY],Blitzer[i][sperreZ],0,0,0);
				}
			}
		}
	}
	for(new s=0;s<MAX_ATMS;s++)
	{
		if(gettime() > ATMInfo[s][EGmBhTstamp] && ATMInfo[s][EGmBhHp] > 0)
		{
			if(ATMInfo[s][ATMmoney] > 100)
			{
				ATMInfo[s][ATMmoney] -= 100;

			}
			ATMInfo[s][EGmBhHp]--;
			ATMInfo[s][EGmBhTstamp] = gettime() + ((random(3) + 5)*60);
			if(ATMInfo[s][EGmBhHp] <= 0)
			{
				ATMInfo[s][RubLabel] = CreateDynamic3DTextLabel("ATM Automat Kaputt!",SAMP_WEISS,ATM[s][_posx],ATM[s][_posy],ATM[s][_posz]+0.5, 10.0);
				ATMInfo[s][EGmBhHp] = 0;
				ATMInfo[s][EGmBhRubbishObject] = CreateDynamicObject(18727,ATM[s][_posx],ATM[s][_posy],ATM[s][_posz],ATM[s][_posrx],ATM[s][_posry],ATM[s][_posrz]);
			}
		}
	}
	for(new s=0;s<MAX_TELEFONZELLEN;s++)
	{
		if(gettime() > TeleZelleInfo[s][EGmBhTstamp] && TeleZelleInfo[s][EGmBhHp] > 0)
		{
			TeleZelleInfo[s][EGmBhHp]--;
			TeleZelleInfo[s][EGmBhTstamp] = gettime() + ((random(3) + 3)*60);
			if(TeleZelleInfo[s][EGmBhHp] <= 0)
			{
				TeleZelleInfo[s][EGmBhHp] = 0;
				//TeleZelleInfo[s][RubLabel] = CreateDynamic3DTextLabel("Telefonzelle Defekt",SAMP_WEISS,TeleFonPunkte[s][_posx],TeleFonPunkte[s][_posy],TeleFonPunkte[s][_posz]+0.5, 10.0);
				TeleZelleInfo[s][RubLabel] = CreateDynamic3DTextLabel("Telefonzelle Kaputt!",SAMP_WEISS,TeleFonPunkte[s][_posx],TeleFonPunkte[s][_posy],TeleFonPunkte[s][_posz]+0.5, 10.0);
				TeleZelleInfo[s][EGmBhRubbishObject] = CreateDynamicObject(18727,TeleFonPunkte[s][_posx],TeleFonPunkte[s][_posy],TeleFonPunkte[s][_posz],TeleFonPunkte[s][_posrx],TeleFonPunkte[s][_posry],TeleFonPunkte[s][_posrz]);
			}
		}
	}
	for(new s=0;s<MAX_SPRUNKS;s++)
	{
		if(gettime() > SprunkInfo[s][EGmBhTstamp] && SprunkInfo[s][EGmBhHp] > 0)
		{
			if(SprunkInfo[s][SprunkInhalt] > 0)
			{
				SprunkInfo[s][SprunkInhalt]--;
			}
			SprunkInfo[s][EGmBhHp] --;
			SprunkInfo[s][EGmBhTstamp] = gettime() + ((random(3) + 3)*60);
			if(SprunkInfo[s][EGmBhHp] <= 0)
			{
				SprunkInfo[s][EGmBhHp] = 0;
				SprunkInfo[s][RubLabel] = CreateDynamic3DTextLabel("Sprunk Automat Kaputt!",SAMP_WEISS,Sprunk[s][_posx],Sprunk[s][_posy],Sprunk[s][_posz]+0.5, 10.0);
				SprunkInfo[s][EGmBhRubbishObject] = CreateDynamicObject(18727,Sprunk[s][_posx],Sprunk[s][_posy],Sprunk[s][_posz],Sprunk[s][_posrx],Sprunk[s][_posry],Sprunk[s][_posrz]);

			}
		}
	}
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
            if(Spieler[i][pJailed] == 2 && PlayerSpawned[i] == 1)
			{
				if(!IsPlayerInZone(i,-2989.536,-233.5575,35.03363,2977.858) && GetPlayerInterior(i) != 2)
				{
				Spieler[i][pJailed] = 0;
				Spieler[i][pKaution] = 0;
				Spieler[i][pJailTime] = 0;
				SCM(i,SAMP_WEISS,""IINFO" du bist aus dem Alkatraz entkommen!");
				}
			}
			if(Spieler[i][pDeath] == 0)
			{
				GetPlayerPos(i,Pos[0],Pos[1],Pos[2]);
				if(IsPlayerInZone(i,-128.4566,1646.58,467.115,2172.085) && Pos[2] < 175)
				{
					if(isPlayerInFrakt(i,0) || (isPlayerInFrakt(i,1) && Spieler[i][pDuty] != 4) || isPlayerInFrakt(i,3) || isPlayerInFrakt(i,4) || isPlayerInFrakt(i,5) || isPlayerInFrakt(i,7) || isPlayerInFrakt(i,8) || isPlayerInFrakt(i,9) || isPlayerInFrakt(i,10) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,12) || isPlayerInFrakt(i,13) || isPlayerInFrakt(i,14) || isPlayerInFrakt(i,15) || isPlayerInFrakt(i,16) || isPlayerInFrakt(i,17))
					{
					    if(Spieler[i][pSpectate] == -1)
					    {
						    if(Spieler[i][pAllowSperrZone] != 1)
						    {
								armybaseschwulies++;
								StopAudioStreamForPlayer(i);
								PlayAudioStreamForPlayer(i,ServerSounds[0],214.5937,1909.3901,17.6406,350.0,true);
								SCM(i,SAMP_WEISS,"ACHTUNG: Du hast das Sperrgebiet betreten.");
							}
						}
					}
				}
				if(IsPlayerInZone(i,-2977.858,1529.802,-2755.979,1985.239) && Pos[2] < 215 && Spieler[i][pJailed] == 0)
				{
					if(isPlayerInFrakt(i,0) || isPlayerInFrakt(i,3) || isPlayerInFrakt(i,4) || isPlayerInFrakt(i,5) || isPlayerInFrakt(i,7) || isPlayerInFrakt(i,8) || isPlayerInFrakt(i,9) || isPlayerInFrakt(i,10) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,12) || isPlayerInFrakt(i,13) || isPlayerInFrakt(i,14) || isPlayerInFrakt(i,15) || isPlayerInFrakt(i,16) || isPlayerInFrakt(i,17))
					{
					    if(Spieler[i][pSpectate] == -1)
					    {
					        if(Spieler[i][pAllowSperrZone] != 1)
						    {
							    alkaschwulies++;
							    SCM(i,SAMP_WEISS,"ACHTUNG: Du hast das Sperrgebiet betreten.");
						    }
						}
					}
				}
			}
			if(armybaseschwulies > 0)
			{
				if(Spieler[i][pDuty] != 0)
				{
				    if((isPlayerInFrakt(i,1) && Spieler[i][pDuty] == 4) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
				    {
						if(Spieler[i][pFunkgeraet] == 1 || (IsAFraktionsVeh(i) != -1 && Fahrzeug[IsAFraktionsVeh(i)][Fraktion] == Spieler[i][pFraktion]) || FraktionsAktenPCs(i))
						{
					    	SCM(i,DUNKELBLAU,"HQ: Ein Unbefugter befindet sich im Sperrgebiet der Army-Base.");
						}
						GetPlayerPos(i,Pos[0],Pos[1],Pos[2]);
						if(IsPlayerInZone(i,-128.4566,1646.58,467.115,2172.085) && Pos[2] < 175)
						{
							StopAudioStreamForPlayer(i);
							PlayAudioStreamForPlayer(i,ServerSounds[0],214.5937,1909.3901,17.6406,350.0,true);
						}
					}
				}
			}
			if(alkaschwulies > 0)
			{
				if(Spieler[i][pDuty] != 0)
				{
				    if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
				    {
						if(Spieler[i][pFunkgeraet] == 1 || (IsAFraktionsVeh(i) != -1 && Fahrzeug[IsAFraktionsVeh(i)][Fraktion] == Spieler[i][pFraktion]) || FraktionsAktenPCs(i))
						{
					    	SCM(i,DUNKELBLAU,"HQ: Ein Unbefugter befindet sich im Sperrgebiet des Alkatraz.");
						}
					}
				}
			}
		}
	}
	SetTimer("Other",30569,false);
	return 1;
}
public OnPlayerLeaveCheckpoint(playerid)
{

	return 1;
}
public OnPlayerEnterRaceCheckpoint(playerid)
{
    new string[256];
    if(IsPlayerInAnyVehicle(playerid))
	{
		if(GetVehicleSpeed(GetPlayerVehicleID(playerid)) == 0)
		{
		    if(InviteInRace[playerid] == 0)
	    	{
				Spieler[playerid][pAntiCheckPointWarns]++;
				format(string,sizeof(string),"Warnung %i/"#MAX_CHECKPOINT_TELEPORTS" erhalten. Grund: Teleporthack",Spieler[playerid][pAntiCheckPointWarns]);
	        	SetPlayerChatBubble(playerid,string,SAMP_WEISS,MAX_STREAM_NAME_DISTANCE,5000);
	        	format(string,sizeof(string),"ACHTUNG: Teleporthack(Checkpoint-Teleport) ist verboten und führt zu einem Bann! Warnungen bis zum Bann(%i/%i)",Spieler[playerid][pAntiCheckPointWarns],MAX_CHECKPOINT_TELEPORTS);
				SCM(playerid,SAMP_WEISS,string);
				if(Spieler[playerid][pAntiCheckPointWarns] >= MAX_CHECKPOINT_TELEPORTS)
				{
					format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: Teleporthack",Spieler[playerid][pName],playerid);
					SendClientMessageToAll(SAMP_WEISS,string);
					format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nDer Grund für den Bann von dem Admin System war: Teleporthack(Checkpoint-Teleport).\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[playerid][pName]);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
					BanUser(playerid,"System","Teleporthack(Checkpoint-Teleport)");
					return 1;
				}
			}
		}
	}
	else
	{
	    if(InviteInRace[playerid] == 0)
    	{
			if(GetPlayerSpeed(playerid) == 0)
			{
				Spieler[playerid][pAntiCheckPointWarns]++;
				format(string,sizeof(string),"Warnung %i/"#MAX_CHECKPOINT_TELEPORTS" erhalten. Grund: Teleporthack",Spieler[playerid][pAntiCheckPointWarns]);
	        	SetPlayerChatBubble(playerid,string,SAMP_WEISS,MAX_STREAM_NAME_DISTANCE,5000);
	        	format(string,sizeof(string),"ACHTUNG: Teleporthack(Checkpoint-Teleport) ist verboten und führt zu einem Bann! Warnungen bis zum Bann(%i/%i)",Spieler[playerid][pAntiCheckPointWarns],MAX_CHECKPOINT_TELEPORTS);
				SCM(playerid,SAMP_WEISS,string);
				if(Spieler[playerid][pAntiCheckPointWarns] >= MAX_CHECKPOINT_TELEPORTS)
				{
					format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: Teleporthack",Spieler[playerid][pName],playerid);
					SendClientMessageToAll(SAMP_WEISS,string);
					format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nDer Grund für den Bann von dem Admin System war: Teleporthack(Checkpoint-Teleport).\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[playerid][pName]);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
					BanUser(playerid,"System","Teleporthack(Checkpoint-Teleport)");
					return 1;
				}
			}
		}
	}
	if(Spieler[playerid][pKartracingCP1] != 0)
	{
	 	DisablePlayerRaceCheckpoint(playerid);
	    if(Spieler[playerid][pKartracingCP1] < sizeof(KartRace)-1)
		{
		if((Spieler[playerid][pKartracingCP1]+1) == sizeof(KartRace)-1)
		{
			SetPlayerRaceCheckpoint(playerid,CP_TYPE_GROUND_FINISH,KartRace[Spieler[playerid][pKartracingCP1]][0],KartRace[Spieler[playerid][pKartracingCP1]][1],KartRace[Spieler[playerid][pKartracingCP1]][2],0.0,0.0,0.0,6.0);
		}
		else
		{
			SetPlayerRaceCheckpoint(playerid,CP_TYPE_GROUND_NORMAL,KartRace[Spieler[playerid][pKartracingCP1]][0],KartRace[Spieler[playerid][pKartracingCP1]][1],KartRace[Spieler[playerid][pKartracingCP1]][2],0.0,0.0,0.0,6.0);
		}
 		}
	 	Spieler[playerid][pKartracingCP1]++;
	 	if(Spieler[playerid][pKartracingCP1] >= sizeof(KartRace))
		{
			new time = gettime() - Spieler[playerid][pKartCountdown];
			DisablePlayerRaceCheckpoint(playerid);
			format(string,sizeof(string),""IINFO" du hast eine Rundenzeit von %i Sekunden abgefahren.",time);
			SCM(playerid,SAMP_WEISS,string);
			if(time < fsteuern[KartTime1] || fsteuern[KartTime1] == 0)
			{
				format(string,sizeof(string),""IINFO" du hast den Rundenrekord von %s (%i Sekunden) auf der Strecke 1 geschlagen.",fsteuern[Kartfahrer1],fsteuern[KartTime1]);
				SCM(playerid,SAMP_WEISS,string);
				strmid(fsteuern[Kartfahrer1],Spieler[playerid][pName],0,strlen(Spieler[playerid][pName]),24);
				fsteuern[KartTime1] = time;
				DestroyDynamicObject(Kartbahntafelobject);
				Kartbahntafelobject = CreateDynamicObject(10671,2287.9824,-1249.5228,-29.7802,-179.5999,179.4999,179.0680);
				format(string,sizeof(string),"%s: %i Sekunden",fsteuern[Kartfahrer1],fsteuern[KartTime1]);
			    SetDynamicObjectMaterialText(Kartbahntafelobject,0,string,110,"Arial",25,1,-256,-8092540,1);
			}
			Spieler[playerid][pKartCountdown] = gettime();
			Spieler[playerid][pKartracingCP1] = 1;
			SetPlayerRaceCheckpoint(playerid,CP_TYPE_GROUND_NORMAL,KartRace[0][0],KartRace[0][1],KartRace[0][2],KartRace[1][0],KartRace[1][1],KartRace[1][2],6.0);
			return 1;
 		}
	}
    if(InviteInRace[playerid] == 1)
    {
        if(BeforeRace[playerid] == true)return 0;
	    new r = RaceStarted;
	 	DisablePlayerRaceCheckpoint(playerid);
	    PlayerPlaySound(playerid,1058,0.0,0.0,0.0);
	    switch(RACE_CP_TYP[r][RaceCps[playerid]])
	    {
	        case 0:{}
	        case 1:{
				SetVehicleHealth(RaceFahrzeug[playerid], 1500);
				RepairVehicle(RaceFahrzeug[playerid]);
				SCM(playerid, GELB,"Fahrzeug wurde repariert und eine neue Ladung Nitro steht bereit!");
			}
	        case 2:{
	            if(!IsNosVehicleInvalid(GetVehicleModel(RaceFahrzeug[playerid]))){
	                AddVehicleComponent(RaceFahrzeug[playerid], 1010);
	                SCM(playerid, GELB,"Eine neue Ladung Nitro steht bereit!");
				}
			}
	        case 3:{
	            if(!IsNosVehicleInvalid(GetVehicleModel(RaceFahrzeug[playerid]))){
	                AddVehicleComponent(RaceFahrzeug[playerid], 1010);
				}
				SetVehicleHealth(RaceFahrzeug[playerid], 1500);
				RepairVehicle(RaceFahrzeug[playerid]);
				SCM(playerid, GELB,"Fahrzeug wurde repariert!");
	        }
		}

	   	RaceCps[playerid]++;
	   	if(RaceCps[playerid] < MAX_RACECPS)
	   	{
	   	    if(RaceMode[r] == 0 || RaceMode[r] == 2 || RaceMode[r] == 3)
	   	    {
		    	if(RaceCps[playerid] == RaceMaxCps-1)//zielcp
		    	{
		    		SetRaceCheckpoint(playerid,RaceCps[playerid],-1);
		    	}
		    	else
		    	{
		    		SetRaceCheckpoint(playerid,RaceCps[playerid],RaceCps[playerid]+1);
				}
			}
			else if(RaceMode[r] == 1)
			{
			    if(RaceCps[playerid] == RaceMaxCps-1)//zielcp
		    	{
		    		SetAirRaceCheckPoint(playerid,RaceCps[playerid],-1);
		    	}
		    	else
		    	{
		    		SetAirRaceCheckPoint(playerid,RaceCps[playerid],RaceCps[playerid]+1);
				}
			}
		}
	 	format(string,sizeof(string),"%i/%i ~y~Cps",RaceCps[playerid],RaceMaxCps);
		PlayerTextDrawSetString(playerid,RACEdraw[playerid][2],string);

		//Platzvergabe
		gPlayerProgress[playerid]++;
		gRaceCheckpoints[gPlayerProgress[playerid]]++;
		RacePosition[playerid]=floatround(gRaceCheckpoints[gPlayerProgress[playerid]],floatround_floor);



		format(string,sizeof(string),"~w~Platz: ~r~%i/%i",RacePosition[playerid],RaceTeilnehmer());
		PlayerTextDrawSetString(playerid,RACEdraw[playerid][3],string);

		if(RaceMode[r] == 0)
		{
			format(string,sizeof(string),"~w~Runden: ~r~1/1");
			PlayerTextDrawSetString(playerid,RACEdraw[playerid][4],string);
		}


		if(RaceCps[playerid] >= RaceMaxCps)
		{
			RaceZeitAfterRace[playerid] = gettime()-RaceBestzeit[playerid];
			BeforeRace[playerid] = true;
			RaceWinner++;
			if(RaceFahrzeug[playerid] != 0) DestroyVehicle(RaceFahrzeug[playerid]);
			for(new t=0;t<6;t++){ PlayerTextDrawHide(playerid,RACEdraw[playerid][t]); }
			if(RaceWinner == 1)
			{
				ForEachPlayer(i)
				{
					if(IsPlayerConnected(i) && !IsPlayerNPC(i))
					{
						if(InviteInRace[i] == 1)
						{
							format(string,sizeof(string),"%s hat den 1.Platz gemacht. Zeit: %i.%02d Minuten",SpielerName(playerid),RaceZeitAfterRace[playerid]/60,RaceZeitAfterRace[playerid]%60);
							SCM(i,SAMP_WEISS,string);
						}
					}
				}
				fverwaltungen[17][Geld] -= fsteuern[RennGewinn1];
				SendFraktionsMessage(17,FMELDUNG,string);
				ACMoney(playerid, fsteuern[RennGewinn1]);
				format(string,sizeof(string),""IINFO" du hast %d$ gewonnen!",fsteuern[RennGewinn1]);
				SCM(playerid,SAMP_WEISS,string);
			}
			else if(RaceWinner == 2)
			{
			    ForEachPlayer(i)
				{
					if(IsPlayerConnected(i) && !IsPlayerNPC(i))
					{
						if(InviteInRace[i] == 1)
						{
							format(string,sizeof(string),"%s hat den 2.Platz gemacht. Zeit: %i.%02d Minuten",SpielerName(playerid),RaceZeitAfterRace[playerid]/60,RaceZeitAfterRace[playerid]%60);
							SCM(i,SAMP_WEISS,string);
						}
					}
				}
				SendFraktionsMessage(17,FMELDUNG,string);
				fverwaltungen[17][Geld] -= fsteuern[RennGewinn2];
				ACMoney(playerid, fsteuern[RennGewinn2]);
				format(string,sizeof(string),""IINFO" du hast %d$ gewonnen!",fsteuern[RennGewinn2]);
				SCM(playerid,SAMP_WEISS,string);
			}
			else if(RaceWinner == 3)
			{
			    ForEachPlayer(i)
				{
					if(IsPlayerConnected(i) && !IsPlayerNPC(i))
					{
						if(InviteInRace[i] == 1)
						{
							format(string,sizeof(string),"%s hat den 3.Platz gemacht. Zeit: %i.%02d Minuten",SpielerName(playerid),RaceZeitAfterRace[playerid]/60,RaceZeitAfterRace[playerid]%60);
							SCM(i,SAMP_WEISS,string);
						}
					}
				}
				SendFraktionsMessage(17,FMELDUNG,string);
				fverwaltungen[17][Geld] -= fsteuern[RennGewinn3];
				ACMoney(playerid, fsteuern[RennGewinn3]);
				format(string,sizeof(string),""IINFO" du hast %d$ gewonnen!",fsteuern[RennGewinn3]);
				SCM(playerid,SAMP_WEISS,string);
			}
			else
			{
			    ForEachPlayer(i)
				{
					if(IsPlayerConnected(i) && !IsPlayerNPC(i))
					{
						if(InviteInRace[i] == 1)
						{
							format(string,sizeof(string),"%s hat das Rennen beendet. Zeit: %i.%02d Minuten",SpielerName(playerid),RaceZeitAfterRace[playerid]/60,RaceZeitAfterRace[playerid]%60);
							SCM(i,SAMP_WEISS,string);
						}
					}
				}
				SendFraktionsMessage(17,FMELDUNG,string);
			}
			InviteInRace[playerid]=0;
			gPlayerProgress[playerid]=0;
			DisablePlayerRaceCheckpoint(playerid);
		}
    }

