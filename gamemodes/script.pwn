			    for(new rcp=1;rcp<MAX_RACECPS;rcp++)
			    {
				    new savestring[15];
				    format(savestring,sizeof(savestring),"X%i",rcp);
					cache_get_field_content(r,savestring,result);
				    RaceInfo[r][rcp-1][0] = floatstr(result);
				    strdel(result,0,sizeof(result));
				    strdel(savestring,0,sizeof(savestring));
				    format(savestring,sizeof(savestring),"Y%i",rcp);
					cache_get_field_content(r,savestring,result);
				    RaceInfo[r][rcp-1][1] = floatstr(result);
