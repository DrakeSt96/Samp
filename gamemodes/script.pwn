					    strcat(string,"Waffen-Pack 4(MP-5,Deagle,Spraydose,Shotgun,AK-47,Messer)30000 Materials\nWaffen-Pack 5(MP-5,Deagle,Spraydose,Shotgun,M4,Messer)40000 Materials\nWaffen-Pack 6(MP-5,Deagle,Spraydose,Shotgun,M4,Messer,C-Rifle)50000 Materials");
					    return ShowPlayerDialog(playerid,DIALOG_BUYWSLOTS_WAFFENPACKS,DIALOG_STYLE_LIST,"Fraktionsverwaltung",string,"Auswählen","Zurück");
					    }
