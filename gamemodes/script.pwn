}

public OnSmarkFightUpdate()
{
	new string[128],warownermember = 0,warattackermember = 0;
	gettime(stunde,minute,sekunde);
    for(new sm=1;sm<MAX_SMARKETS;sm++)
    {
	    if(SmarkInfo[sm][screatet] == 1 && SmarkInfo[sm][sattackerfraktid] != 0)
	    {
	    UpdateSmarkLabel(sm,2);//funktion 1 wenn der smark ohne frakt ist,funktion 2 wenn der smarkt mit frakt besetzt ist
	    if(stunde<23||stunde>10)
	    {
			ForEachPlayer(i)
		    {
			    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			    {
				    if(isPlayerInFrakt(i,SmarkInfo[sm][sfraktid]) || isPlayerInFrakt(i,SmarkInfo[sm][sattackerfraktid]))
				    {
				    	if(isPlayerInFrakt(i,SmarkInfo[sm][sfraktid])) warownermember++;
				    	if(isPlayerInFrakt(i,SmarkInfo[sm][sattackerfraktid])) warattackermember++;
				    }
				}
			}
			if(SmarkInfo[sm][sdontenter] == 0)
			{
				if((warownermember == 0 && warattackermember != 0) || (warattackermember == 0 && warownermember != 0))
				{
					SmarkInfo[sm][sdontenter] = 1;
					SmarkInfo[sm][sdontentertime] = gettime() + (60*5);
				}
			}
			if(SmarkInfo[sm][sdontenter] == 1 && gettime() > SmarkInfo[sm][sdontentertime])
			{
				if(warownermember == 0 && warattackermember != 0) SmarkInfo[sm][swarattackerpoints] += 3;
				if(warattackermember == 0 && warownermember != 0) SmarkInfo[sm][swarownerpoints] += 3;
				SmarkInfo[sm][sdontenter] = 0;
				SmarkInfo[sm][sdontentertime] = 0;
			}
		}
		if(gettime() > SmarkInfo[sm][swartime])
	    {
		    if(SmarkInfo[sm][swarownerpoints] > SmarkInfo[sm][swarattackerpoints])
		    {
			    ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
				    {
					    if(isPlayerInFrakt(i,SmarkInfo[sm][sfraktid]))
					    {
						    format(string,sizeof(string),"Ihr habt den Kampf um den Schwarzmarkt (ID:%i) gegen die Fraktion %s mit %i Punkten für euch entschieden. | Ihr bleibt Besitzer des Schwarzmarktes,",sm,FraktionsName(SmarkInfo[sm][sattackerfraktid]),SmarkInfo[sm][swarownerpoints]);
						    SCM(i,FMELDUNG,string);
						    new time = SmarkInfo[sm][swarsleep]-gettime();
						    format(string,sizeof(string),""IINFO" der Schwarzmarkt (ID:%i) kann erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten versucht eingenommen zu werden.",sm,time/60,time%60);
						    SCM(i,FMELDUNG,string);
					    }
					    if(isPlayerInFrakt(i,SmarkInfo[sm][sattackerfraktid]))
					    {
						    format(string,sizeof(string),"Die Fraktion %s hat den Kampf um den Schwarzmarkt (ID:%i) mit %i Punkten für sich entschieden. | Sie bleiben Besitzer des Schwarzmarkets.",FraktionsName(SmarkInfo[sm][sfraktid]),sm,SmarkInfo[sm][swarownerpoints]);
						    SCM(i,FMELDUNG,string);
						    new time = SmarkInfo[sm][swarsleep]-gettime();
						    format(string,sizeof(string),""IINFO" der Schwarzmarkt (ID:%i) kann erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten versucht eingenommen zu werden.",sm,time/60,time%60);
						    SCM(i,FMELDUNG,string);
					    }
				    }
				}
		    }
		    if(SmarkInfo[sm][swarownerpoints] < SmarkInfo[sm][swarattackerpoints])
		    {
			    SmarkInfo[sm][sfraktid] = SmarkInfo[sm][sattackerfraktid];
			    SmarkInfo[sm][sbdfraktid] = 0;
			    SmarkInfo[sm][sartikel][0] = 60;
				SmarkInfo[sm][sartikel][1] = 20;
				SmarkInfo[sm][sartikel][2] = 150;
				SmarkInfo[sm][sartikel][3] = 120;
				SmarkInfo[sm][sartikel][4] = 400;
				SmarkInfo[sm][sartikel][5] = 350;
				SmarkInfo[sm][sartikel][6] = 550;
				SmarkInfo[sm][sartikel][7] = 1250;
				SmarkInfo[sm][sartikel][8] = 1399;
				SmarkInfo[sm][sartikel][9] = 2001;
				SmarkInfo[sm][sartikel][10] = 2565;
				SmarkInfo[sm][sartikel][11] = 100;
				SmarkInfo[sm][sartikel][12] = 4997;
			    strmid(SmarkInfo[sm][swerbetext],"Keine",0,strlen("Keine"),64);
			    ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
				    {
					    if(isPlayerInFrakt(i,SmarkInfo[sm][sfraktid]))
					    {
						    format(string,sizeof(string),"Die Fraktion %s hat den Kampf um den Schwarzmarkt (ID:%i) mit %i Punkten für sich entschieden. | Sie sind nun Besitzer des Schwarzmarkets.",FraktionsName(SmarkInfo[sm][sattackerfraktid]),sm,SmarkInfo[sm][swarattackerpoints]);
						    SCM(i,FMELDUNG,string);
						    new time = SmarkInfo[sm][swarsleep]-gettime();
						    format(string,sizeof(string),""IINFO" der Schwarzmarkt (ID:%i) kann erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten versucht eingenommen zu werden.",sm,time/60,time%60);
						    SCM(i,FMELDUNG,string);
					    }
					    if(isPlayerInFrakt(i,SmarkInfo[sm][sattackerfraktid]))
					    {
						    format(string,sizeof(string),"Ihr habt den Kampf um den Schwarzmarkt (ID:%i) gegen die Fraktion %s mit %i Punkten für euch entschieden. | Ihr bleibt Besitzer des Schwarzmarktes,",sm,FraktionsName(SmarkInfo[sm][sattackerfraktid]),SmarkInfo[sm][swarattackerpoints]);
						    SCM(i,FMELDUNG,string);
						    new time = SmarkInfo[sm][swarsleep]-gettime();
						    format(string,sizeof(string),""IINFO" der Schwarzmarkt (ID:%i) kann erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten versucht eingenommen zu werden.",sm,time/60,time%60);
						    SCM(i,FMELDUNG,string);
					    }
				    }
				}
		    }
		    if(SmarkInfo[sm][swarownerpoints] == SmarkInfo[sm][swarattackerpoints])
		    {
			    ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
				    {
					    if(isPlayerInFrakt(i,SmarkInfo[sm][sfraktid]))
					    {
						    format(string,sizeof(string),""IINFO" der Kampf um den Schwarzmarkt (ID:%i) endete mit %i (%s) zu %i (%s) Punkten Unentschieden. | Die Fraktion %s bleibt Besitzer des Schwarzmarkets.",sm,SmarkInfo[sm][swarownerpoints],FraktionsName(SmarkInfo[sm][sfraktid]),SmarkInfo[sm][swarattackerpoints],FraktionsName(SmarkInfo[sm][sattackerfraktid]),FraktionsName(SmarkInfo[sm][sfraktid]));
						    SCM(i,FMELDUNG,string);
						    new time = SmarkInfo[sm][swarsleep]-gettime();
						    format(string,sizeof(string),""IINFO" der Schwarzmarkt (ID:%i) kann erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten versucht eingenommen zu werden.",sm,time/60,time%60);
						    SCM(i,FMELDUNG,string);
					    }
					    if(isPlayerInFrakt(i,SmarkInfo[sm][sattackerfraktid]))
					    {
						    format(string,sizeof(string),""IINFO" der Kampf um den Schwarzmarkt (ID:%i) endete mit %i (%s) zu %i (%s) Punkten Unentschieden. | Die Fraktion %s bleibt Besitzer des Schwarzmarkets.",sm,SmarkInfo[sm][swarownerpoints],FraktionsName(SmarkInfo[sm][sfraktid]),SmarkInfo[sm][swarattackerpoints],FraktionsName(SmarkInfo[sm][sattackerfraktid]),FraktionsName(SmarkInfo[sm][sfraktid]));
						    SCM(i,FMELDUNG,string);
						    new time = SmarkInfo[sm][swarsleep]-gettime();
						    format(string,sizeof(string),""IINFO" der Schwarzmarkt (ID:%i) kann erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten versucht eingenommen zu werden.",sm,time/60,time%60);
						    SCM(i,FMELDUNG,string);
					    }
				    }
				}
		  	}
		   	GangZoneStopFlashForAll(SmarkInfo[sm][swarzone]);
		   	GangZoneHideForAll(SmarkInfo[sm][swarzone]);
		    GangZoneDestroy(SmarkInfo[sm][swarzone]);
		    SmarkInfo[sm][sattackerfraktid] = 0;
			SmarkInfo[sm][swarownerpoints] = 0;
			SmarkInfo[sm][swarattackerpoints] = 0;
			SmarkInfo[sm][slocked] = 0;
			SmarkInfo[sm][swartime] = 0;
			SmarkInfo[sm][swarsleep] = 0;
		 	UpdateSmarkLabel(sm,2);//funktion 1 wenn der smark ohne frakt ist,funktion 2 wenn der smarkt mit frakt besetzt ist
		  	}
	    }
	}
	return 1;
}

public Taxometer(playerid,fahrerid)
{
	new string[150];
	if(!IsPlayerConnected(fahrerid))
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" du musstes nichts für deine Taxifahrt bezahlen,da der Taxifahrer die Verbindung trennte!");
		PlayerTextDrawHide(playerid,TAXOdraw[playerid][0]);
		PlayerTextDrawHide(playerid,TAXOdraw[playerid][1]);
	    Spieler[playerid][pTaxiBeifahrerPreis] = 0;
	    Spieler[playerid][pTaxiSeat] = -1;
	    KillTimer(Spieler[playerid][pTaxiTimer]);
		return RemovePlayerFromVehicle(playerid);
	}
	if(!IsPlayerConnected(playerid))
	{
		switch(Spieler[playerid][pTaxiSeat])
		{
			case 1:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][0],"Frei...");
			case 2:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][2],"Frei...");
			case 3:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][3],"Frei...");
		}
	    KillTimer(Spieler[playerid][pTaxiTimer]);
		return 1;
	}
	if(Spieler[fahrerid][pTaxiDuty] == 0)
	{
		switch(Spieler[playerid][pTaxiSeat])
		{
			case 1:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][0],"Frei...");
			case 2:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][2],"Frei...");
			case 3:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][3],"Frei...");
		}
	 	format(string,sizeof(string),""IINFO" %s musste %i$ für eine Taxifahrt in deinem Taxi bezahlen! Dienstpreis : %i$ (Dienstpreis + Fahrzeit alle 15 Sekunden)",SpielerName(playerid),Spieler[playerid][pTaxiBeifahrerPreis],MAX_TAXI_PRICE);
	    SCM(fahrerid,SAMP_WEISS,string);
	    format(string,sizeof(string),""IINFO" du musstes %i$ für eine Taxifahrt in %s Taxi bezahlen! Dienstpreis : %i$ (Dienstpreis + Fahrzeit alle 15 Sekunden)",Spieler[playerid][pTaxiBeifahrerPreis],SpielerName(fahrerid),MAX_TAXI_PRICE);
	    SCM(playerid,SAMP_WEISS,string);
		PlayerTextDrawHide(playerid,TAXOdraw[playerid][0]);
		PlayerTextDrawHide(playerid,TAXOdraw[playerid][1]);
		SCM(fahrerid,SAMP_WEISS,"Info: Die Auszahlung wird am Zahltag auf dein Konto überwiesen.");
	    ACMoney(playerid,-Spieler[playerid][pTaxiBeifahrerPreis]);
	    Spieler[fahrerid][pLohn] += Spieler[playerid][pTaxiBeifahrerPreis];
	    Spieler[playerid][pTaxiBeifahrerPreis] = 0;
	    Spieler[playerid][pTaxiSeat] = -1;
	    KillTimer(Spieler[playerid][pTaxiTimer]);
		return RemovePlayerFromVehicle(playerid);
	}
	if(!IsPlayerInVehicle(playerid,GetPlayerVehicleID(fahrerid)))
	{
		switch(Spieler[playerid][pTaxiSeat])
		{
			case 1:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][0],"Frei...");
			case 2:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][2],"Frei...");
			case 3:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][3],"Frei...");
		}
	 	format(string,sizeof(string),"%s musste %i$ für eine Taxifahrt in deinem Taxi bezahlen! Dienstpreis : %i$ (Dienstpreis + Fahrzeit alle 15 Sekunden)",SpielerName(playerid),Spieler[playerid][pTaxiBeifahrerPreis],MAX_TAXI_PRICE);
	    SCM(fahrerid,SAMP_WEISS,string);
	    format(string,sizeof(string),""IINFO" du musstes %i$ für eine Taxifahrt in %s Taxi bezahlen! Dienstpreis : %i$ (Dienstpreis + Fahrzeit alle 15 Sekunden)",Spieler[playerid][pTaxiBeifahrerPreis],SpielerName(fahrerid),MAX_TAXI_PRICE);
	    SCM(playerid,SAMP_WEISS,string);
		PlayerTextDrawHide(playerid,TAXOdraw[playerid][0]);
		PlayerTextDrawHide(playerid,TAXOdraw[playerid][1]);
	    ACMoney(playerid,-Spieler[playerid][pTaxiBeifahrerPreis]);
	    Spieler[fahrerid][pLohn] += Spieler[playerid][pTaxiBeifahrerPreis];
	    Spieler[playerid][pTaxiBeifahrerPreis] = 0;
	    Spieler[playerid][pTaxiSeat] = -1;
	    KillTimer(Spieler[playerid][pTaxiTimer]);
		return RemovePlayerFromVehicle(playerid);
	}
    if((GetACMoney(playerid) - Spieler[playerid][pTaxiBeifahrerPreis]) <= 0)
	{
		switch(Spieler[playerid][pTaxiSeat])
		{
			case 1:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][0],"Frei...");
			case 2:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][2],"Frei...");
			case 3:PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][3],"Frei...");
		}
	 	format(string,sizeof(string),""IINFO" %s musste %i$ für eine Taxifahrt in deinem Taxi bezahlen! Dienstpreis : %i$ (Dienstpreis + Fahrzeit alle 15 Sekunden)",SpielerName(playerid),Spieler[playerid][pTaxiBeifahrerPreis],MAX_TAXI_PRICE);
	    SCM(fahrerid,SAMP_WEISS,string);
	    format(string,sizeof(string),""IINFO" du musstes %i$ für eine Taxifahrt in %s Taxi bezahlen! Dienstpreis : %i$ (Dienstpreis + Fahrzeit alle 15 Sekunden)",Spieler[playerid][pTaxiBeifahrerPreis],SpielerName(fahrerid),MAX_TAXI_PRICE);
	    SCM(playerid,SAMP_WEISS,string);
		PlayerTextDrawHide(playerid,TAXOdraw[playerid][0]);
		PlayerTextDrawHide(playerid,TAXOdraw[playerid][1]);
	    ACMoney(playerid,-Spieler[playerid][pTaxiBeifahrerPreis]);
	    Spieler[fahrerid][pLohn] += Spieler[playerid][pTaxiBeifahrerPreis];
	    Spieler[playerid][pTaxiBeifahrerPreis] = 0;
	    Spieler[playerid][pTaxiSeat] = -1;
	    KillTimer(Spieler[playerid][pTaxiTimer]);
		return RemovePlayerFromVehicle(playerid);
	}
	if(gettime() > Spieler[playerid][pTaxiTimerPause])
	{
		Spieler[playerid][pTaxiTimerPause] = gettime() + (1*15);
	   	if(GetVehicleSpeed(GetPlayerVehicleID(fahrerid)) > 0)
	   	{
		   	Spieler[playerid][pTaxiBeifahrerPreis] += MAX_TAXI_PRICE;
		   	format(string,sizeof(string),"Fahrpreis: %i$",Spieler[playerid][pTaxiBeifahrerPreis]);
		   	PlayerTextDrawSetString(playerid,TAXOdraw[playerid][0],string);
	   	}
	   	else
	   	{
		   	Spieler[playerid][pTaxiBeifahrerPreis] += floatround(MAX_TAXI_PRICE/2);
		   	format(string,sizeof(string),"Fahrpreis: %i$",Spieler[playerid][pTaxiBeifahrerPreis]);
		   	PlayerTextDrawSetString(playerid,TAXOdraw[playerid][0],string);
	   	}
	    switch(Spieler[playerid][pTaxiSeat])
	    {
		   	case 1:
		   	{
			 	format(string,sizeof(string),"%s %i$",SpielerName(playerid),Spieler[playerid][pTaxiBeifahrerPreis]);
			 	PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][0],string);
		 	}
		   	case 2:
		   	{
			  	format(string,sizeof(string),"%s %i$",SpielerName(playerid),Spieler[playerid][pTaxiBeifahrerPreis]);
			  	PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][2],string);
		  	}
			case 3:
			{
				format(string,sizeof(string),"%s %i$",SpielerName(playerid),Spieler[playerid][pTaxiBeifahrerPreis]);
				PlayerTextDrawSetString(fahrerid,TAXOdraw[fahrerid][3],string);
			}
		}
	}
	return 1;
}
public l_script_account(playerid,const pass[],passwortstate)
{
    new query[356],result[25],rows,fields;
    if(mysql_errno(MySQL_R394) != 0)
	{
		getdate(tag,monat,jahr);
		gettime(stunde,minute,sekunde);
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && GetPVarInt(i,"Eingeloggt") == 1)
			{
				SaveAccount(i);
			}
		}
	    Log("gmx.txt","Admin");
	    OnGameModeSave();
	    GameModeExit();
		return 1;
	}
    cache_get_data(rows,fields);
	if(rows)
	{
		if(passwortstate == 1)
		{
			new gespeichert[SCRIPT_PW_BUF],pwstatus;
			cache_get_field_content(0,"Passwort",gespeichert);
			pwstatus = ScriptPW_Verify(gespeichert,pass);
			if(pwstatus == 2)
			{
			    mysql_format(MySQL_R394,query,sizeof(query),"UPDATE spieler SET Passwort='%s' WHERE Name='%e'",ScriptPW_CreateStr(pass),SpielerName(playerid));
			    mysql_function_query(MySQL_R394,query,false,"","");
			}
			if(pwstatus)
		    {
			    SetAccountPasswortHash(playerid,pass);
			    format(query,sizeof(query),"SELECT * FROM spieler WHERE Name='%s'",SpielerName(playerid));
			    LoginFehlversuche[playerid] = 0;
			   	mysql_function_query(MySQL_R394,query,true,"l_script_account","isi",playerid," ",0);
			   	return 1;
			}
		    LoginFehlversuche[playerid]++;
		    new loginlog[160];
		    format(loginlog,sizeof(loginlog),"Falsches Passwort (Versuch %d von %d) - Spieler: %s | IP: %s",LoginFehlversuche[playerid],MAX_LOGIN_VERSUCHE,SpielerName(playerid),SpielerIP(playerid));
		    Log("Login_Fehlversuche.txt",loginlog);
		    if(LoginFehlversuche[playerid] >= MAX_LOGIN_VERSUCHE)
		    {
		        LoginSperre_Setzen(playerid);
		        SCM(playerid,SAMP_WEISS,""ACINFO" Zu viele fehlgeschlagene Login-Versuche! Du wirst vom Server geworfen.");
		        format(loginlog,sizeof(loginlog),"KICK nach %d Fehlversuchen - Spieler: %s | IP: %s",MAX_LOGIN_VERSUCHE,SpielerName(playerid),SpielerIP(playerid));
		        Log("Login_Fehlversuche.txt",loginlog);
		        TogglePlayerControllable(playerid,false);
		        SetTimerEx("KickDenSpieler",2000,false,"i",playerid);
		        return 1;
		    }
		    format(loginlog,sizeof(loginlog),""#ERROR" Falsches Passwort! Versuch %d von %d.",LoginFehlversuche[playerid],MAX_LOGIN_VERSUCHE);
		    SCM(playerid,SAMP_WEISS,loginlog);
		    format(query,sizeof(query),""#HTML_WEISS"Name: "IINFO2"%s"#HTML_WEISS"\nSpielerID die bekommst nach dem einloggen: "IINFO2"%d"#HTML_WEISS"\nDein Account wurde in unsere Datenbank gefunden!\nBitte logge dich nun mit deinen "IINFO2"Daten"#HTML_WEISS" ein!",SpielerName(playerid),playerid);
			ShowPlayerDialog(playerid,DIALOG_LOGIN,DIALOG_STYLE_PASSWORD,""#HTML_BLAU""#ClanTag":"#HTML_WEISS" Login - Panel",query,"Login","Abbrechen");
			return 1;
		}
		cache_get_field_content(0,"Tutorial",result);
		Spieler[playerid][pViewTutorial] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"Admin",result);
		Spieler[playerid][pAdmin] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"Verwarnungen",result);
		Spieler[playerid][pWarns] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"FLeaderRechte",result);
		Spieler[playerid][pLeader] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"Fraktion",result);
		Spieler[playerid][pFraktion] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"FraktionsRang",result);
		Spieler[playerid][pFraktRang] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"FraktionsURang",result);
		Spieler[playerid][pFraktURang] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"FraktionsSperre",result);
		Spieler[playerid][pFraktionSperre] = strval(result);
		strdel(result,0,sizeof(result));
