								{
									format(string,sizeof(string),""#HTML_WEISS"Fahrzeug: "IINFO2"%s"#HTML_WEISS" Besitzer: "IINFO2"%s",VehicleDefinations[Pfahrzeug[slot][i][modelid]-400],Pfahrzeug[slot][i][Besitzer]);
