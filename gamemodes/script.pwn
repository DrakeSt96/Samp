COMMAND:arefill(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
 	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
    format(string,sizeof(string),"** %s befüllt ein Fahrzeug [%s] (Adminbefehl) **",SpielerName(playerid),VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(playerid))-400]);
    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
    vFahrzeug[GetPlayerVehicleID(playerid)][Tank] = VehicleInfo[GetVehicleModel(GetPlayerVehicleID(playerid))-400][vtankvolumen];
    return 1;
}

COMMAND:avehfix(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
    new vehicleid,string[128];
	if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" /avehfix [vehicleid]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
    MotorDown[vehicleid] = 0;
    vFahrzeug[vehicleid][FailGas] = 0;
    vFahrzeug[vehicleid][Tank] = VehicleInfo[GetVehicleModel(vehicleid)-400][vtankvolumen];
    format(string,sizeof(string),""IINFO" du hast eine/n %s (ID:%i) repariert.",VehicleDefinations[GetVehicleModel(vehicleid)-400],vehicleid);
	SCM(playerid,SAMP_WEISS,string);
    RepairVehicle(vehicleid);
	return 1;
}

COMMAND:acolor(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
    new vehicleid,color1,color2,string[128];
	if(sscanf(params,"iii",vehicleid,color1,color2))return SCM(playerid,SAMP_WEISS,""IINFO" /acolor [vehicleid] [Farbe 1] [Farbe 2]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
    vFahrzeug[vehicleid][Colour1] = color1;
    vFahrzeug[vehicleid][Colour2] = color2;
    ChangeVehicleColours(vehicleid, color1, color2);
    format(string,sizeof(string),""IINFO" du hast eine/n %s (ID:%i) umgefärbt.",VehicleDefinations[GetVehicleModel(vehicleid)-400],vehicleid);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:arepair(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
 	if(InviteInRace[playerid] == 1) return SCM(playerid,SAMP_WEISS,""IINFO" du kannst während eines Rennens dein Fahrzeug nicht reparieren.");
	new string[128];
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
    RepairVehicle(GetPlayerVehicleID(playerid));
    ForEachPlayer(i)
	{
	   	for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
			if(GetPlayerVehicleID(playerid) == Pfahrzeug[slot][i][Vehicle])
			{
				Pfahrzeug[slot][i][HP] = 1000.0;
				break;
			}
		}
	}
	for(new fv;fv<MAX_FVEHS;fv++)
	{
		if(Fahrzeug[fv][Fraktion] != 0 && Fahrzeug[fv][Vehicle] == GetPlayerVehicleID(playerid))
	   	{
		   	Fahrzeug[fv][HP] = 1000.0;
		   	break;
		}
	}
    MotorDown[GetPlayerVehicleID(playerid)] = 0;
    vFahrzeug[GetPlayerVehicleID(playerid)][FailGas] = 0;
    format(string,sizeof(string),"Teammitglied: "IINFO2"%s"#HTML_WEISS" hat sein Fahrzeug: "IINFO2"%s"#HTML_WEISS" per Admin befehl repariert!",SpielerName(playerid),VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(playerid))-400]);
    SendAdminMessage(SAMP_WEISS,string);
    Log("AD_FReapir.txt",string);
    SCM(playerid,SAMP_WEISS,""IINFO" das ausnutzen deses Befehl "IINFO2"/arepair"#HTML_WEISS" kann zur einer Sanktion führen!");
    return 1;
}
COMMAND:aduty(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128];
	if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	if(GetPVarInt(playerid,"admind")==1)
	{
		if(Spieler[playerid][pAdminOnduty] == false)
		{
			SCM(playerid,SAMP_WEISS,""IINFO" du bist nun in den "IINFO2"Admin"#HTML_WEISS" Dienst gegangen!");
			SetPlayerScore(playerid,GetPlayerLevel(playerid));
			Spieler[playerid][pAdminOnduty] = true;
		    new Float:Admin3DText_X,Float:Admin3DText_Y,Float:Admin3DText_Z;
		    GetPlayerPos(playerid,Admin3DText_X,Admin3DText_Y,Admin3DText_Z);
	 		switch(Spieler[playerid][pAdmin])
	 		{
				case 1: AdminDuty_3DText[playerid] = Create3DTextLabel(""#IINFO2"[ "#HTML_WEISS"Teammitglied"#HTML_WEISS" "#HTML_BLAU"]"#HTML_WEISS"\n"#IINFO2" "Admin_1"\n "#HTML_GRUEN"Duty",SAMP_WEISS,Admin3DText_X,Admin3DText_Y,Admin3DText_Z,50.0,0,false);
				case 2: AdminDuty_3DText[playerid] = Create3DTextLabel(""#IINFO2"[ "#HTML_WEISS"Teammitglied"#HTML_WEISS" "#HTML_BLAU"]"#HTML_WEISS"\n"#IINFO2" "Admin_2"\n "#HTML_GRUEN"Duty",SAMP_WEISS,Admin3DText_X,Admin3DText_Y,Admin3DText_Z,50.0,0,false);
				case 3: AdminDuty_3DText[playerid] = Create3DTextLabel(""#IINFO2"[ "#HTML_WEISS"Teammitglied"#HTML_WEISS" "#HTML_BLAU"]"#HTML_WEISS"\n "#IINFO2" "Admin_3"\n"#HTML_GRUEN"Duty",SAMP_WEISS,Admin3DText_X,Admin3DText_Y,Admin3DText_Z,50.0,0,false);
				case 4: AdminDuty_3DText[playerid] = Create3DTextLabel(""#IINFO2"[ "#HTML_WEISS"Teammitglied"#HTML_WEISS" "#HTML_BLAU"]"#HTML_WEISS"\n"#IINFO2" "Admin_4"\n"#HTML_GRUEN"Duty",SAMP_WEISS,Admin3DText_X,Admin3DText_Y,Admin3DText_Z,50.0,0,false);
				case 5: AdminDuty_3DText[playerid] = Create3DTextLabel(""#IINFO2"[ "#HTML_WEISS"Teammitglied"#HTML_WEISS" "#HTML_BLAU"]"#HTML_WEISS"\n"#IINFO2" "Admin_5"\n"#HTML_GRUEN"Duty",SAMP_WEISS,Admin3DText_X,Admin3DText_Y,Admin3DText_Z,50.0,0,false);
				case 6: AdminDuty_3DText[playerid] = Create3DTextLabel(""#IINFO2"[ "#HTML_WEISS"Teammitglied"#HTML_WEISS" "#HTML_BLAU"]"#HTML_WEISS"\n"#IINFO2" "Admin_6"\n"#HTML_GRUEN"Duty",SAMP_WEISS,Admin3DText_X,Admin3DText_Y,Admin3DText_Z,50.0,0,false);
				case 7: AdminDuty_3DText[playerid] = Create3DTextLabel(""#IINFO2"[ "#HTML_WEISS"Teammitglied"#HTML_WEISS" "#HTML_BLAU"]"#HTML_WEISS"\n"#IINFO2" "Admin_7"\n"#HTML_GRUEN"Duty",SAMP_WEISS,Admin3DText_X,Admin3DText_Y,Admin3DText_Z,50.0,0,false);
				case 8: AdminDuty_3DText[playerid] = Create3DTextLabel(""#IINFO2"[ "#HTML_WEISS"Teammitglied"#HTML_WEISS" "#HTML_BLAU"]"#HTML_WEISS"\n"#IINFO2" "Admin_8"\n"#HTML_GRUEN"Duty",SAMP_WEISS,Admin3DText_X,Admin3DText_Y,Admin3DText_Z,50.0,0,false);
	 		}
	 		Attach3DTextLabelToPlayer(AdminDuty_3DText[playerid],playerid,0.0,0.0,0.75);
		}
		else if(Spieler[playerid][pAdminOnduty] == true)
		{
			SCM(playerid,SAMP_WEISS,""IINFO" du bist nun aus dem "IINFO2"Admin"#HTML_WEISS" Dienst gegangen!");
	        Delete3DTextLabel(AdminDuty_3DText[playerid]);
			Spieler[playerid][pAdminOnduty] = false;
			SetPlayerName(playerid,Spieler[playerid][pName]);
			SetPlayerScore(playerid,GetPlayerLevel(playerid));
			if(Spieler[playerid][pMaske] == 1 && Spieler[playerid][pFraktion] != 6)
			{
				SetPlayerScore(playerid,random(50) + 122);
				format(string,sizeof(string),"NichtErkennbar((%i))",random(50) + 122);
				SetPlayerName(playerid,string);
			}
			if(Spieler[playerid][pDuty] == 4 && Spieler[playerid][pFraktion] != 6)
			{
				SetPlayerScore(playerid,random(50) + 122);
				format(string,24,"S.W.A.T((%i))",random(50) + 122);
				SetPlayerName(playerid,string);
			}
			if(Spieler[playerid][pDuty] == 4 && Spieler[playerid][pFraktion] == 6 && Spieler[playerid][pMaske] == 1)
			{
				SetPlayerScore(playerid,random(50) + 122);
				format(string,24,"Seal((%i))",random(50) + 122);
				SetPlayerName(playerid,string);
			}
			if(Spieler[playerid][pDuty] == 5 && Spieler[playerid][pFraktion] == 6 && Spieler[playerid][pMaske] == 1)
			{
				SetPlayerScore(playerid,random(50) + 122);
				format(string,24,"Ranger((%i))",random(50) + 122);
				SetPlayerName(playerid,string);
			}
		}
	}
	else{
		ShowPlayerDialog(playerid,ADMIN_PASSWORT,DIALOG_STYLE_PASSWORD,""ClanTagDialoge" Admin Passwort",""#HTML_WEISS"Bitte gib dein "IINFO2"Accountpasswort"#HTML_WEISS" ein um in den Admindienst zu gehen!\nNach mehreren Fehlversuchen wirst du vom Server gekickt!","Bestätigen","Abbrechen");
	}
	return 1;
}
COMMAND:admins(playerid,const params[])
{
    #pragma unused params
	new string[350];
	mysql_format(MySQL_R394,string,sizeof(string),"SELECT * FROM `spieler` ORDER BY `Admin` DESC");
	mysql_tquery(MySQL_R394,string,"GetAdmins","i",playerid);
	return 1;
}
COMMAND:apremium(playerid,const params[])
{
    #pragma unused params
	if(isPlayerAnAdmin(playerid,1)){
		new string[350];
		mysql_format(MySQL_R394,string,sizeof(string),"SELECT * FROM `spieler` ORDER BY `pPremium` DESC");
		mysql_tquery(MySQL_R394,string,"GetPremiums","i",playerid);
	}else SCM(playerid,SAMP_WEISS,""IINFO" das darfst du nicht!");
	return 1;
}
COMMAND:fahrlehrer(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[1000],status[50],onlineFahrlehrerer = 0;
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(isPlayerInFrakt(i,14))
				{
					switch(Spieler[i][pDuty])
					{
						case 0:{status=""#HTML_ROT"Offduty";}
						case 1:{status=""#HTML_GRUEN"Onduty";}
						default:{status="ERROR";}
					}
					if(Spieler[i][pHandy] == 0)
					{
						format(string,sizeof(string),""#HTML_WEISS"Fahrlehrer: "IINFO2"%s"#HTML_WEISS" Dienststatus: %s\n%s",SpielerName(i),status,string);
					}
					else format(string,sizeof(string),""#HTML_WEISS"Fahrlehrer: "IINFO2"%s"#HTML_WEISS"  Handy: "IINFO2"%i"#HTML_WEISS" Dienststatus: %s\n%s",SpielerName(i),Spieler[i][pPhonenumber],status,string);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Fahrlehrer",string,"Verlassen","");
					onlineFahrlehrerer++;
				}
			}
		}
	}
	if(onlineFahrlehrerer == 0)return SCM(playerid,SAMP_WEISS,"Keine Fahrlehrer Online.");
	return 1;
}
COMMAND:medics(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[400],status[50],onlineMedics = 0;
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(isPlayerInFrakt(i,3))
				{
					switch(Spieler[i][pDuty])
					{
						case 0:{status="{FFFFFF}Offduty{C9C9C9}";}
						case 1:{status="{FFFF00}Onduty{C9C9C9}";}
						case 2:{status="{FFFF00}Feuerduty{C9C9C9}";}
						default:{status="ERROR";}
					}
					if(Spieler[i][pHandy] == 0)
					{
					format(string,sizeof(string),"{C9C9C9}%s (ID:%i) | Dienst:%s\n%s",SpielerName(i),i,status,string);
					}
					else format(string,sizeof(string),"{C9C9C9}%s (ID:%i) | Handy:%i | Dienst:%s\n%s",SpielerName(i),i,Spieler[i][pPhonenumber],status,string);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_LIST,""ClanTagDialoge" Medics",string,"Verlassen","");
					onlineMedics++;
				}
			}
		}
	}
	if(onlineMedics == 0)return SCM(playerid,SAMP_WEISS,"Keine Medics Online.");
	return 1;
}

