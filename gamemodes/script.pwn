			SCM(playerid,SAMP_WEISS,string);
			SCM(playerid,SAMP_WEISS,"Fahre nun zum Abgabepunkt, um den Treibstoff auszuliefern.");
			return 1;
	  	}
	  	case 5://eisen
	 	{
		  	TogglePlayerControllable(playerid,true);
			SetPlayerCheckpoint(playerid,823.6282,-1550.7629,13.5172,7.5);
			truckerjobgo5[playerid] = 3;
			ACMoney(playerid,-rcash);
			SCM(playerid,SAMP_WEISS,"Eisen aufgeladen !!!");
			format(string,sizeof(string),""IINFO" du musstest %i$ vorrauszahlen um das Eisen entgegen zunehmen!",rcash);
