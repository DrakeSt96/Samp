COMMAND:changepasswort(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID[24],passwort[31],query[128];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(sscanf(params,"s[24]s[31]",pID,passwort))return SCM(playerid,SAMP_WEISS,""#IINFO" /changepasswort [Name][Neuespasswort]");
	if(strlen(passwort) > 30)return SCM(playerid,SAMP_WEISS,""#IINFO" /changepasswort [Name][Neuespasswort darf maximal 30 Zeichen beinhalten]");
	mysql_format(MySQL_R394,query,sizeof(query),"SELECT * FROM spieler WHERE Name = '%e'",pID);
    mysql_function_query(MySQL_R394,query,true,"sql_array","ssiiii",pID,passwort,d_script_passwort,playerid,0,MySQL_R394);
    return 1;
}
COMMAND:changename(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,name[MAX_PLAYER_NAME],query[256];
	if(!isPlayerAnAdmin(playerid,7) || !isPlayerAnAdmin(playerid,-1))return ADMIN_MSG(playerid);
    if(sscanf(params,"us[24]",pID,name))return SCM(playerid,SAMP_WEISS,""#IINFO" /changename [playerid/Name][Neuername]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    if(Spieler[pID][pAdminOnduty] == true)return SCM(playerid,SAMP_WEISS,"Spieler ist im Admindienst.");
	if(!strcmp(name,Spieler[pID][pName],true))return SCM(playerid,SAMP_WEISS,"Spieler hat bereits den selben Namen!");
	mysql_format(MySQL_R394,query,sizeof(query),"SELECT * FROM spieler WHERE Name = '%e'",name);
	mysql_function_query(MySQL_R394,query,true,"sql_array","ssiiii",query,name,d_script_name,playerid,pID,MySQL_R394);
	return 1;
}
COMMAND:mute(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,zeit,reason[31],string[128];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"uds[31]",pID,zeit,reason))return SCM(playerid,SAMP_WEISS,""#IINFO" /mute [playerid/Name][Zeit in Minuten][Grund]");
	if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""#IINFO" /mute [playerid/Name][Zeit][Grund darf maximal 30 Zeichen beinhalten]");
	if(zeit<1||zeit>100)return SCM(playerid,SAMP_WEISS,"Bitte nur zwischen 1 und 100 Minuten angeben.");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) für %i Minuten gemutet. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,zeit,reason);
	SendClientMessageToAll(SAMP_WEISS,string);
	Spieler[pID][pMuteTime] += zeit*60;
	Spieler[pID][pMuted] = 1;
	return 1;
}
COMMAND:unmute(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,reason[31],string[128];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""#IINFO" /unmute [playerid/Name][Grund]");
	if(!isPlayerAnAdmin(playerid,5))
	{
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst unmuten!");
	}
	if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""#IINFO" /unmute [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pMuted] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht gemutet.");
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) ungemutet. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,reason);
	SendClientMessageToAll(SAMP_WEISS,string);
	Spieler[pID][pMuted] = 0;
	Spieler[pID][pMuteTime] = 0;
	return 1;
}
COMMAND:outfit(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(IsPlayerInRangeOfPoint(playerid,2,161.4407,-83.2631,1001.8047))//zip
	{
		SetPlayerPosEx(playerid,182.4923,-87.8844,1002.0234);
		SetPlayerCameraPos(playerid,177.9503,-88.1474,1001.8047);
		SetPlayerCameraLookAt(playerid,182.6175,-88.1204,1002.0234);
		SetPlayerFacingAngle(playerid,89.0834);
		SetPlayerInterior(playerid,18);
	    BincoSystem(playerid);
	   	return 1;
    }
    if(IsPlayerInRangeOfPoint(playerid,2,207.4263,-100.3614,1005.2578))//binco
	{
	 	SetPlayerPosEx(playerid,218.0456,-98.1021,1005.2578);
		SetPlayerCameraPos(playerid,214.3568,-101.5178,1005.2578);
		SetPlayerCameraLookAt(playerid,218.0456,-98.1021,1005.2578);
		SetPlayerFacingAngle(playerid,123.0581);
		SetPlayerInterior(playerid,15);
	  	BincoSystem(playerid);
	   	return 1;
 	}
 	if(IsPlayerInRangeOfPoint(playerid,2,207.1219,-129.1989,1003.5078))//los santos fashion
	{
	 	SetPlayerPosEx(playerid,199.0418,-126.6537,1003.5152);
		SetPlayerCameraPos(playerid,199.0223,-131.0329,1003.5152);
		SetPlayerCameraLookAt(playerid,199.0418,-126.6537,1003.5152);
		SetPlayerFacingAngle(playerid,183.3549);
		SetPlayerInterior(playerid,3);
	  	BincoSystem(playerid);
	   	return 1;
 	}
 	if(IsPlayerInRangeOfPoint(playerid,2,204.5884,-159.3604,1000.5234))//Didiersachs
	{
	 	SetPlayerPosEx(playerid,199.1759,-157.6042,1000.5234);
		SetPlayerCameraPos(playerid,202.5683,-160.4692,1000.5234);
		SetPlayerCameraLookAt(playerid,199.1759,-157.6042,1000.5234);
		SetPlayerFacingAngle(playerid,227.5519);
		SetPlayerInterior(playerid,14);
	  	BincoSystem(playerid);
	   	return 1;
 	}
 	return SCM(playerid,SAMP_WEISS,"In keinem Fashionstore!");
}
COMMAND:kick(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[256],reason[31];
	if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""#IINFO" /kick [playerid/Name][Grund]");
	if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""#IINFO" /kick [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(playerid != pID)
	{
		if(Spieler[pID][pAdmin] > Spieler[playerid][pAdmin])return SCM(playerid,SAMP_WEISS,""IINFO" du kannst keine Ranghöherern Admins kicken!");
	}
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) gekickt. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,reason);
	SendClientMessageToAll(SAMP_WEISS,string);
	format(string,sizeof(string),"Admin: %s User: %s * Grund: %s",Spieler[playerid][pName],Spieler[pID][pName],reason);
	ShowPlayerDialog(pID,DIALOG_BANKICK,DIALOG_STYLE_MSGBOX,"PR - Du wurdest gekickt",string,"OK","");
	Log("Kick_Log.txt",string);
	KickUser(pID,SpielerName(playerid), reason);
	return 1;
}
