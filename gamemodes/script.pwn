public BauarbeiterLadung(playerid, count)
{
	switch(count)
	{
	    case 1:
	    {
	        BauarbeiterCheckpoint[playerid] = 3;
        	BHausObject[playerid] = CreateDynamicObject(3504,0,0,0,0,0,0);
        	BHaus2Object[playerid] = CreateDynamicObject(3504,0,0,0,0,0,0);
        	AttachDynamicObjectToVehicle(BHausObject[playerid],GetPlayerVehicleID(playerid),0.0, -1.0,1.0,0.0,0.0,0.0);
        	AttachDynamicObjectToVehicle(BHaus2Object[playerid],GetPlayerVehicleID(playerid),0.0, -3.0,1.0,0.0,0.0,0.0);
        	SCM(playerid,SAMP_WEISS,"Transportiere die Klohäusschen nun zum gewünschten Ort.");
        	TogglePlayerControllable(playerid,true);
        	new spawnrand = random(sizeof(BauarbeiterABP));
			SetPlayerCheckpoint(playerid,BauarbeiterABP[spawnrand][0],BauarbeiterABP[spawnrand][1],BauarbeiterABP[spawnrand][2],7.5);
			BauarbeiterEntladenPunkt[playerid] = spawnrand;
        	return 1;
		}
		case 2:
		{
		    BauarbeiterEntladenPunkt[playerid] = -1;
		    if(IsValidDynamicObject(BHaus2Object[playerid])) DestroyDynamicObject(BHaus2Object[playerid]);
		    BauarbeiterCheckpoint[playerid] = 5;
		    if(IsValidDynamicObject(BHausObject[playerid])) DestroyDynamicObject(BHausObject[playerid]);
		    SCM(playerid,SAMP_WEISS,"Bringe den Truck nun zurück zum Job Standort!");
		    TogglePlayerControllable(playerid,true);
		    SetPlayerCheckpoint(playerid, 2139.8379,-1191.7671,23.9922, 7.5);
		    return 1;
		}
	}
	return print("ERROR: BauarbeiterLadung public nicht erkannt");
}

public TruckerTimer(playerid,tourid)
{
	new string[128],rcash = random(10) + 25;
	switch(tourid)
	{
		case 1://waren
	 	{
		  	TogglePlayerControllable(playerid,true);
		   	new rSpawn = random(sizeof(TruckerLine1));
			SetPlayerCheckpoint(playerid,TruckerLine1[rSpawn][0],TruckerLine1[rSpawn][1],TruckerLine1[rSpawn][2],7.5);
			truckerjobgo[playerid] = 3;
			ACMoney(playerid,-rcash);
			SCM(playerid,SAMP_WEISS,"Ware aufgeladen !!!");
			format(string,sizeof(string),""IINFO" du musstest %i$ vorrauszahlen um die Waren entgegen zunehmen!",rcash);
			SCM(playerid,SAMP_WEISS,string);
			SCM(playerid,SAMP_WEISS,"Fahre nun zum Abgabepunkt! Um die Ware auszuliefern.");
