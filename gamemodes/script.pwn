stock CreateTmasten(playerid)
{
	new query[256],Float:Pos[3];
    for(new msten=0;msten<MAX_MASTEN;msten++)
	{
	 	if(FMastenInfo[msten][Erstellt] == 0)
		{
			GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
		  	FMastenInfo[msten][sperreX] = Pos[0];
		   	FMastenInfo[msten][sperreY] = Pos[1];
		    FMastenInfo[msten][sperreZ] = Pos[2];
		    FMastenInfo[msten][Erstellt] = 1;
 	    	FMastenInfo[msten][RubLabel] = INVALID_3D_TEXT;
		    FMastenInfo[msten][EGmBhHp] = 100;
		    FMastenInfo[msten][EGmBhRubbishObject] = -1;
		    FMastenInfo[msten][ID] = CreateDynamicObject(3876,FMastenInfo[msten][sperreX],FMastenInfo[msten][sperreY],FMastenInfo[msten][sperreZ]-1,0.0,0.0,15.0);
		    FMastenInfo[msten][EGmBhMastenZone] = GangZoneCreate(FMastenInfo[msten][sperreX]-600,FMastenInfo[msten][sperreY]-600,FMastenInfo[msten][sperreX]+600,FMastenInfo[msten][sperreY]+600);
			FMastenInfo[msten][EGmBhTstamp] = gettime() + ((random(10) + 10)*60);
			ForEachPlayer(i)
			{
			    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && Spieler[playerid][ShowNetworks] != 0)
			    {
			        GangZoneShowForPlayer(playerid,FMastenInfo[msten][EGmBhMastenZone],0xB9FF006A);
			    }
			}
			fverwaltungen[Spieler[playerid][pFraktion]][Geld] -= MAX_TMASTENPRICE;
			fverwaltungen[16][Geld] += MAX_TMASTENPRICE;
			SCM(playerid,SAMP_WEISS,"Funkmast aufgestellt!");
			SCM(playerid,SAMP_WEISS,"Im Umkreis von "#MAX_TMASTENRANGE" Metern ist mit Handyempfang zu rechnen!");
			format(query,sizeof(query),""#HTML_WEISS"Arbeiter: "#HTML_BLAU"%s"#HTML_WEISS" [ %i ] hat einen Funkmast aufgestellt. Das hat die Firma "#HTML_ROT""#MAX_TMASTENPRICE""#HTML_WEISS" gekostet.",SpielerName(playerid),playerid);
			SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,query);
			format(query,sizeof(query),"INSERT INTO server_netzwerk (`id`,`X`,`Y`,`Z`,`HP`) VALUES ('%d','%f','%f','%f','%d')",msten,FMastenInfo[msten][sperreX],FMastenInfo[msten][sperreY],FMastenInfo[msten][sperreZ],FMastenInfo[msten][EGmBhHp]);
		    mysql_function_query(MySQL_R394,query,false,"","");
			return 1;
		}
	}
	return 1;
}
stock DeleteTMasten(playerid)
{
    new query[128];
    for(new msten=0;msten<MAX_MASTEN;msten++)
	{
	  	if(IsPlayerInRangeOfPoint(playerid,5,FMastenInfo[msten][sperreX],FMastenInfo[msten][sperreY],FMastenInfo[msten][sperreZ]))
	   	{
		    if(FMastenInfo[msten][Erstellt] == 1)
		    {
			    FMastenInfo[msten][Erstellt] = 0;
			    FMastenInfo[msten][sperreX] = -1;
			    FMastenInfo[msten][sperreY] = -1;
			    FMastenInfo[msten][sperreZ] = -1;
			    FMastenInfo[msten][EGmBhHp] = 0;
			    if(FMastenInfo[msten][EGmBhRubbishObject] != -1) DestroyDynamicObject(FMastenInfo[msten][EGmBhRubbishObject]);
			    FMastenInfo[msten][EGmBhRubbishObject] = -1;
			    GangZoneHideForAll(FMastenInfo[msten][EGmBhMastenZone]);
			    GangZoneDestroy(FMastenInfo[msten][EGmBhMastenZone]);
				DestroyDynamicObject(FMastenInfo[msten][ID]);
				SCM(playerid,SAMP_WEISS,"Funkmast entfernt!");
				SCM(playerid,SAMP_WEISS,"Im Umkreis von "#MAX_TMASTENRANGE" Metern ist kein Handyempfang zu erreichen!");
				format(query,sizeof(query),"DELETE FROM server_netzwerk WHERE id = '%d'",msten);
			   	mysql_function_query(MySQL_R394,query,false,"","");
				return 1;
		    }
	    }
    }
	return SCM(playerid,SAMP_WEISS,"An keinem Funkmasten.");
}
stock ReturnTMastenID(playerid)
{
    for(new msten=0;msten<MAX_MASTEN;msten++)
	{
		if(FMastenInfo[msten][Erstellt] == 1)
		{
			if(IsPlayerInRangeOfPoint(playerid,30.0,FMastenInfo[msten][sperreX],FMastenInfo[msten][sperreY],FMastenInfo[msten][sperreZ]))
			return msten;
		}
	}
	return -1;
