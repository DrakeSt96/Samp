			SendAdminMessage(GRUEN,string);
			SendClientMessageToAll(ORANGE,""#HTML_BLAU"Wetter Station"#HTML_WEISS": Es liegt eine Wetteränderung in ganz San Andreas vor.");
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""#IINFO" /setweather [Normal/Regen/Sturm/Nebel/Schnee/Zufall][LS]");
	}
