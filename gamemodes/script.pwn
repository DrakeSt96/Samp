stock SpielerFraktionsRangName(playerid)
{
	new rang[32];
	strmid(rang,"Keinen",0,strlen("Keinen"),sizeof(rang));
	if(!isPlayerInFrakt(playerid,0))
	{
		if(Spieler[playerid][pFraktRang] == 6) strmid(rang,frank6[Spieler[playerid][pFraktion]],0,strlen(frank6[Spieler[playerid][pFraktion]]),sizeof(rang));
		if(Spieler[playerid][pFraktRang] == 5) strmid(rang,frank5[Spieler[playerid][pFraktion]],0,strlen(frank5[Spieler[playerid][pFraktion]]),sizeof(rang));
		if(Spieler[playerid][pFraktRang] == 4) strmid(rang,frank4[Spieler[playerid][pFraktion]],0,strlen(frank4[Spieler[playerid][pFraktion]]),sizeof(rang));
		if(Spieler[playerid][pFraktRang] == 3) strmid(rang,frank3[Spieler[playerid][pFraktion]],0,strlen(frank3[Spieler[playerid][pFraktion]]),sizeof(rang));
		if(Spieler[playerid][pFraktRang] == 2) strmid(rang,frank2[Spieler[playerid][pFraktion]],0,strlen(frank2[Spieler[playerid][pFraktion]]),sizeof(rang));
		if(Spieler[playerid][pFraktRang] == 1) strmid(rang,frank1[Spieler[playerid][pFraktion]],0,strlen(frank1[Spieler[playerid][pFraktion]]),sizeof(rang));
		if(Spieler[playerid][pFraktRang] == 0) strmid(rang,frank0[Spieler[playerid][pFraktion]],0,strlen(frank0[Spieler[playerid][pFraktion]]),sizeof(rang));
		if(Spieler[playerid][pDuty] == 4 && isPlayerInFrakt(playerid,1))//SWAT
		{
		    switch(Spieler[playerid][pFraktRang])
			{
				case 0:{rang="Sturmtrupp C";}
				case 1:{rang="Sturmtrupp B";}
				case 2:{rang="Sturmtrupp A";}
				case 3:{rang="Stellv. Einsatzleiter";}
				case 4:{rang="Einsatzleiter";}
				case 5:{rang="Stellv. Abteilungsleiter";}
				case 6:{rang="Abteilungsleiter";}
				default:{rang="ERROR";}
			}
		}
	 	if(Spieler[playerid][pDuty] == 2 && isPlayerInFrakt(playerid,3))//feuerwehr
		{
		    switch(Spieler[playerid][pFraktRang])
			{
				case 0:{rang="Feuerwehr-Anwärter";}
				case 1:{rang="Feuerwehrmann";}
				case 2:{rang="Hauptfeuerwehrmann";}
				case 3:{rang="Brandmeister";}
				case 4:{rang="Oberbrandmeister";}
				case 5:{rang="Branddirektor";}
				case 6:{rang="Leiter der Feuerwehr";}
				default:{rang="ERROR";}
			}
		}
		if(Spieler[playerid][pDuty] == 3 && isPlayerInFrakt(playerid,6))//bundeswehr - airforce
		{
		    switch(Spieler[playerid][pFraktURang])
			{
    			case 0:{rang="Airman Recruit";}
				case 1:{rang="Airman Basic";}
				case 2:{rang="Airman";}
				case 3:{rang="Airman First Class";}
				case 4:{rang="Senior Airman";}
				case 5:{rang="Staff Sergeant";}
				case 6:{rang="Technical Sergeant";}
				case 7:{rang="Master Sergeant";}
				case 8:{rang="Senior Master Sergeant";}
				case 9:{rang="Second Lieutenant";}
				case 10:{rang="First Lieutenant";}
				case 11:{rang="Major";}
				case 12:{rang="Colonel";}
				case 13:{rang="Lieutenant General";}
				case 14:{rang="General";}
				default:{rang="ERROR";}
			}
		}
		if(Spieler[playerid][pDuty] == 4 && isPlayerInFrakt(playerid,6))//bundeswehr navyseals
		{
		    switch(Spieler[playerid][pFraktURang])
			{
				case 0:{rang="Seaman Recriut";}
				case 1:{rang="Seaman Basic";}
				case 2:{rang="Seaman Apprentice";}
				case 3:{rang="Seaman";}
				case 4:{rang="Petty Officer Third Class";}
				case 5:{rang="Petty Officer Second Class";}
				case 6:{rang="Petty Officer First Class";}
				case 7:{rang="Chief Petty Officer";}
				case 8:{rang="Senior Chief Petty Officer";}
				case 9:{rang="Second Lieutenant";}
				case 10:{rang="First Lieutenant";}
				case 11:{rang="Major";}
				case 12:{rang="Colonel";}
				case 13:{rang="Lieutenant General";}
				case 14:{rang="General";}
				default:{rang="ERROR";}
			}
		}
		if(Spieler[playerid][pDuty] == 5 && isPlayerInFrakt(playerid,6))//bundeswehr ranger
		{
		    switch(Spieler[playerid][pFraktURang])
			{
				case 0:{rang="Corporal";}
				case 1:{rang="Sergeant";}
				case 2:{rang="Staff Sergeant";}
				case 3:{rang="Sergeant First Class";}
				case 4:{rang="Master Sergeant";}
				case 5:{rang="First Sergeant";}
				case 6:{rang="Sergeant Major";}
				case 7:{rang="Second Lieutenant";}
				case 8:{rang="First Lieutenant";}
				default:{rang="ERROR";}
			}
		}
	}
	return rang;
}
stock isPlayerAnAdmin(playerid,rang)
{
	if(Spieler[playerid][pAdmin] >= rang)return 1;
	return 0;
}
stock isPlayerInJob(playerid,jobid)
{
	if(Spieler[playerid][pJob] == jobid)return 1;
	return 0;
}
stock isPlayerInFrakt(playerid,fraktid)
{
	if(Spieler[playerid][pFraktion] == fraktid)return 1;
	return 0;
}
stock isPlayerAMember(playerid,rang)
{
	if(Spieler[playerid][pFraktRang] >= rang)return 1;
	return 0;
}
stock CreateAccount(playerid)
{
    new query[512];
    SetAccountPasswortHash(playerid,Spieler[playerid][pPassword]);
    mysql_format(MySQL_R394,query,sizeof(query),"INSERT INTO spieler (Name,Passwort,Email,Geschlecht) VALUES ('%e','%s','%e','%i')",SpielerName(playerid),ScriptPW_CreateStr(Spieler[playerid][pPassword]),Spieler[playerid][pEmail],Spieler[playerid][pSex]);
    mysql_function_query(MySQL_R394,query,false,"","");
    format(query,sizeof(query),"SELECT * FROM spieler_waffen WHERE Name='%s'",SpielerName(playerid));
    mysql_function_query(MySQL_R394,query,true,"l_script_swaffen","i",playerid);
    format(query,sizeof(query),"SELECT * FROM spieler_fishe WHERE Name='%s'",SpielerName(playerid));
    mysql_function_query(MySQL_R394,query,true,"l_script_sfish","i",playerid);
    format(query,sizeof(query),"SELECT * FROM spieler_koffer WHERE Name='%s'",SpielerName(playerid));
    mysql_function_query(MySQL_R394,query,true,"l_script_skoffer","i",playerid);
	format(query,sizeof(query),"SELECT * FROM spieler_schwarzeliste WHERE Name = '%s'",SpielerName(playerid));
 	mysql_function_query(MySQL_R394,query,true,"l_script_sblacklist","i",playerid);
  	format(query,sizeof(query),"SELECT * FROM spieler_tasche WHERE Name = '%s'",SpielerName(playerid));
  	mysql_function_query(MySQL_R394,query,true,"l_script_sinventar","i",playerid);
   	format(query,sizeof(query),"SELECT * FROM spieler_scheine WHERE Name = '%s'",SpielerName(playerid));
   	mysql_function_query(MySQL_R394,query,true,"l_script_sscheine","i",playerid);
    format(query,sizeof(query),"SELECT * FROM spieler_bsafe WHERE Name = '%s'",SpielerName(playerid));
    mysql_function_query(MySQL_R394,query,true,"l_script_ssafe","i",playerid);
	return 1;
}
stock mysql_SetInt(const Table[],const Field[],To,const Where[],const Where2[])
{
    new query[512];
    new sTable[64],sField[64],sWhere[64],sWhere2[64];
    mysql_escape_string(Table, sTable);
    mysql_escape_string(Field, sField);
    mysql_escape_string(Where, sWhere);
    mysql_escape_string(Where2, sWhere2);
    format(query,sizeof(query),"UPDATE %s SET %s='%d' WHERE %s='%s'",sTable,sField,To,sWhere,sWhere2);
    mysql_function_query(MySQL_R394,query,false,"","");
    return 1;
}
stock mysql_SetString(const Table[],const Field[],const To[],const Where[],const Where2[])
{
    new query[512];
    new sTable[64],sField[64],sWhere[64],sWhere2[64],sTo[64];
    mysql_escape_string(Table, sTable);
    mysql_escape_string(Field, sField);
    mysql_escape_string(Where, sWhere);
    mysql_escape_string(Where2, sWhere2);
    mysql_escape_string(To, sTo);
    format(query,sizeof(query),"UPDATE %s SET %s='%s' WHERE %s='%s'",sTable,sField,sTo,sWhere,sWhere2);
    mysql_function_query(MySQL_R394,query,false,"","");
    return 1;
}
stock mysql_SetFloat(const Table[],const Field[],Float:To,const Where[],const Where2[])
{
    new query[512];
    new sTable[64],sField[64],sWhere[64],sWhere2[64];
    mysql_escape_string(Table, sTable);
    mysql_escape_string(Field, sField);
    mysql_escape_string(Where, sWhere);
    mysql_escape_string(Where2, sWhere2);
    format(query,sizeof(query),"UPDATE %s SET %s='%.1f' WHERE %s='%s'",sTable,sField,To,sWhere,sWhere2);
    mysql_function_query(MySQL_R394,query,false,"","");
    return 1;
}
stock ShowOldStatiks(playerid,showplayerid)
{
	new headerstring[64],string[800],stringall[2000];
	getdate(jahr,monat,tag);
	gettime(stunde,minute,sekunde);
	new premium[55];
	if(gettime() > Spieler[playerid][pPremium])
	{
		premium = "User";
	}
	else
	{
	new time = Spieler[playerid][pPremium]-gettime();
	if(floatround(time/86400) >= 1)
	{
		format(premium,sizeof(premium),"{99FF00}Donator: %i Tag/e{D9CCD9}",floatround(time/86400));
	}
	else if(floatround(time/3600) >= 1)
	{
		format(premium,sizeof(premium),"{99FF00}Donator: %i Stunde/n{D9CCD9}",floatround(time/3600));
	}
	else if(floatround(time/60) >= 1)
	{
    	format(premium,sizeof(premium),"{99FF00}Donator: "IINFO2"%i:%02d"#HTML_WEISS" Minute/n{D9CCD9}",floatround(time/60),floatround(time%60));
	}
 	}
	new sex[10];
	switch(Spieler[playerid][pSex])
	{
		case 1:{sex="Männlich";}
		case 2:{sex="Weiblich";}
	}
	new fsperre[96],fraktsperre = Spieler[playerid][pFraktionSperre]-gettime();
	if(gettime() < Spieler[playerid][pFraktionSperre])
	{
		format(fsperre,sizeof(fsperre),"Vorhanden "IINFO2"%i:%02d"#HTML_WEISS" Minuten",fraktsperre/60,fraktsperre%60);
	}
	else {fsperre="Keine";}
	new fstyle[16];
	switch(GetPlayerFightingStyle(playerid))
	{
		case 4:{fstyle="Normal";}
		case 5:{fstyle="Boxing";}
		case 6:{fstyle="Kungfu";}
		case 7:{fstyle="Kneehead";}
		case 15:{fstyle="Grabkick";}
		case 16:{fstyle="Elbow";}
		default:{fstyle="ERROR";}
	}
	new spawn[20];
	switch(Spieler[playerid][pSpawn])
	{
		case 0:{spawn="MainSpawn";}
		case 1:{spawn="Haus";}
		case 2:{spawn="Fraktion";}
		case 3:{spawn="Hotel";}
		case 4:{spawn="Mietshaus";}
		case 5:{spawn="Wohnwagen";}
	}

	new handyortbarkeit[35];
	switch(Spieler[playerid][pHandystate])
	{
		case 0:{handyortbarkeit="{FF0000}Ausgeschaltet{D9CCD9}";}
		case 1:{handyortbarkeit="{66CD00}Eingeschaltet{D9CCD9}";}
	}
	new hatflat[35];
	switch(Spieler[playerid][pHandyFlat])
	{
		case 0:{hatflat="{FF0000}Keine{D9CCD9}";}
		case 1:{hatflat="{66CD00}Vorhanden{D9CCD9}";}
	}
	new pbrang[64];
	switch(Spieler[playerid][pPBRang])
	{
	    case 0:{pbrang="Neuankömmling";}
	    case 1:{pbrang="Anfänger";}
	    case 2:{pbrang="Fortgeschrittener";}
	    case 3:{pbrang="Skiller";}
	    case 4:{pbrang="Profi";}
	    case 5:{pbrang="High Skiller";}
	    case 6:{pbrang="Elite";}
	    case 7:{pbrang="ProHighSkiller";}
	    case 8:{pbrang="["#SERVERTAG"]Elite";}
    }

    new bizowner[25],bizcoowner[25],bcounter[2] = 0;
    for(new biz=1;biz<MAX_BIZ;biz++)
	{
		if(BizInfo[biz][bizcreatet] == 1)
		{
			if(strcmp(BizInfo[biz][biz_besitzer],Spieler[playerid][pName],true) == 0)
			{
			    format(bizowner,sizeof(bizowner),"ID:%i,%s",biz,bizowner);
			    bcounter[0]++;
		    }
		    if(strcmp(BizInfo[biz][biz_teilhaber],Spieler[playerid][pName],true) == 0)
			{
			 	format(bizcoowner,sizeof(bizcoowner),"ID:%i,%s",biz,bizcoowner);
				bcounter[1]++;
			}
		}
	}
	if(bcounter[0] == 0) format(bizowner,sizeof(bizowner),"Keins");
	if(bcounter[1] == 0) format(bizcoowner,sizeof(bizcoowner),"Keins");

	new immobilie[25],hcounter = 0;
    for(new haus=1;haus<MAX_HAUS;haus++)
	{
		if(HausInfo[haus][hauscreatet] == 1)
		{
			if(!strcmp(HausInfo[haus][haus_besitzer],Spieler[playerid][pName],true))
			{
		    format(immobilie,sizeof(immobilie),"Nummer:%i,%s",haus,immobilie);
		    hcounter++;
		    }
		}
	}
	if(hcounter == 0) format(immobilie,sizeof(immobilie),"Keins");

 	new lotterieschein[7];
 	if(Spieler[playerid][pLottonumber] == 0)
 	{
 		lotterieschein="Keinen";
 	}
 	else
 	{
 		format(lotterieschein,sizeof(lotterieschein),"%i",Spieler[playerid][pLottonumber]);
 	}
 	new banksafe[35];
 	switch(Spieler[playerid][pBankSafeSafe])
 	{
	 	case 0:{banksafe="Keins";}
		case 1:{banksafe="{19FF00}Vorhanden";}
		default:{banksafe="ERROR";}
 	}

	format(string,sizeof(string),""#HTML_BLAU"Profil\n{D9CCD9}Name: %s ID:%i Geschlecht: %s Alter: %i Level: %i Adminstatus: %s{D9CCD9}\n\n",Spieler[playerid][pName],playerid,sex,AgeOfPlayer(playerid),Spieler[playerid][pLevel],Adminrang(playerid));
    strcat(stringall,string);
    format(string,sizeof(string),""#HTML_BLAU"Account\n{D9CCD9}Status: %s	Geworbener: %s	Zeit seit PayDay: %i  Spielzeit Insgesamt: %i\nRespektpunkte: %i/%i	Levelkosten: %i$ Verwarnungen: %i Kampfstil: %s	Spawn: %s{D9CCD9}\n\n",
	premium,Spieler[playerid][GeworbenPlaya],Spieler[playerid][pMinutesAfterPayday]/60,Spieler[playerid][pTimeAfterRegister]/60,Spieler[playerid][pRespektFromPayday],Spieler[playerid][pRespektToLevelUp],Spieler[playerid][pLevelKosten],GetPVarInt(playerid,"Warns"),fstyle,spawn);
    strcat(stringall,string);
	format(string,sizeof(string),""#HTML_BLAU"Berufsleben\n{D9CCD9}Fraktion: %s Rang: %s[%i] Fraktionssperre: %s Beruf: %s{D9CCD9}\n\n",
	FraktionsName(Spieler[playerid][pFraktion]),SpielerFraktionsRangName(playerid),Spieler[playerid][pFraktRang],fsperre,SpielerJob(playerid));
    strcat(stringall,string);
 	format(string,sizeof(string),""#HTML_BLAU"Fahndung\n{D9CCD9}Wantedlevel(Sterne): %i Wantedpunkte: %i STVO-Punkte: %i Verbrechen: %i\nLetzte Verbrechen: >%s >%s >%s >%s >%s{D9CCD9}\n\n",
 	GetPlayerWantedLevel(playerid),Spieler[playerid][pWantedPoints],Spieler[playerid][pSTVOpoints],Spieler[playerid][pSuspectPoints],pWantedReason1[playerid],pWantedReason2[playerid],pWantedReason3[playerid],pWantedReason4[playerid],pWantedReason5[playerid]);
 	strcat(stringall,string);
	format(string,sizeof(string),""#HTML_BLAU"Finanzen\n{D9CCD9}Bargeld: %i$	Bankguthaben: %i$	Gesamt: %i$	Bankpin:/bankpin	Bankschließfach: %s  {D9CCD9}Coins: %d{D9CCD9}\n\n",
	GetACMoney(playerid),Spieler[playerid][pBank],GetACMoney(playerid) + Spieler[playerid][pBank],banksafe,Spieler[playerid][pCoins]);
    strcat(stringall,string);
	format(string,sizeof(string),""#HTML_BLAU"Paintball\n{D9CCD9}Morde: %i Tode: %i Rang: %s K/D:%.2f	Besuche: %i{D9CCD9}\n\n",
	Spieler[playerid][pPBKills],Spieler[playerid][pPBDeaths],pbrang,Float:Spieler[playerid][pPBKills]/Float:Spieler[playerid][pPBDeaths],Spieler[playerid][pPBVisits]);
    strcat(stringall,string);
	format(string,sizeof(string),""#HTML_BLAU"Sonstiges\n{D9CCD9}Leben: %.1f Rüstung: %.1f Morde: %i Tode: %i	K/D: %.2f Skin(ID): %i\nHaus: %s Business(Besitzer): %s	Business(Teilhaber): %s\nGrundwehrdienstnote: %i Zivildienstnote: %i Lottonummer: %s{D9CCD9}\n\n",
	GetPlayerACHealth(playerid),GetPlayerACArmour(playerid),Spieler[playerid][pMorde],Spieler[playerid][pTode],Float:Spieler[playerid][pMorde]/Float:Spieler[playerid][pTode],GetPlayerSkin(playerid),immobilie,bizowner,bizcoowner,Spieler[playerid][pGrundwehrdienst],Spieler[playerid][pZiviNote],lotterieschein);
    strcat(stringall,string);
	if(Spieler[playerid][pHandy] != 0)
    {
	    format(string,sizeof(string),""#HTML_BLAU"Telefon\n{D9CCD9}Handy:%s Nummer:%i	Guthaben: %i$ Akkustand:%.1f% Status:%s Flatrate:%s{D9CCD9}",
		HandyInfo[Spieler[playerid][pHandy]][Handyname],Spieler[playerid][pPhonenumber],Spieler[playerid][pHandyCoins],Spieler[playerid][pHandyakku],handyortbarkeit,hatflat);
	    strcat(stringall,string);
    }
    strcat(stringall,"");
    format(headerstring,sizeof(headerstring),""#HTML_BLAU"Statistiken (%02d.%02d.%04d - %02d:%02d:%02d)",tag,monat,jahr,stunde,minute,sekunde);
	ShowPlayerDialog(showplayerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,headerstring,stringall,"Verlassen","");
	return 1;
}
stock ShowStatiks(playerid,showplayerid)
{
	new headerstring[64],string[800];
	getdate(jahr,monat,tag);
	gettime(stunde,minute,sekunde);
	Spieler[showplayerid][pViewStats] = true;
	STATSdraw[showplayerid][0] = CreatePlayerTextDraw(showplayerid,180.0,140.0,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~");
    PlayerTextDrawUseBox(showplayerid,STATSdraw[showplayerid][0],true);
    PlayerTextDrawBoxColour(showplayerid,STATSdraw[showplayerid][0],0x00000067);
	PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][0],TEXT_DRAW_FONT_0);
	PlayerTextDrawSetShadow(showplayerid,STATSdraw[showplayerid][0],0);
    PlayerTextDrawSetOutline(showplayerid,STATSdraw[showplayerid][0],0);
    PlayerTextDrawTextSize(showplayerid,STATSdraw[showplayerid][0],460.0,480.0);

    STATSdraw[showplayerid][1] = CreatePlayerTextDraw(showplayerid,180.0,125.0,"_");
    PlayerTextDrawUseBox(showplayerid,STATSdraw[showplayerid][1],false);
	PlayerTextDrawLetterSize(showplayerid,STATSdraw[showplayerid][1],0.399990,1.199990);
	PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][1],TEXT_DRAW_FONT_1);
	PlayerTextDrawSetShadow(showplayerid,STATSdraw[showplayerid][1],0);
    PlayerTextDrawSetOutline(showplayerid,STATSdraw[showplayerid][1],0);
    PlayerTextDrawColour(showplayerid,STATSdraw[showplayerid][1],0x00000067);

    STATSdraw[showplayerid][2] = CreatePlayerTextDraw(showplayerid,180.0,125.0,"_");
    PlayerTextDrawUseBox(showplayerid,STATSdraw[showplayerid][2],true);
    PlayerTextDrawBoxColour(showplayerid,STATSdraw[showplayerid][2],SERVERFARBEHEX);
	PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][2],TEXT_DRAW_FONT_0);
	PlayerTextDrawSetShadow(showplayerid,STATSdraw[showplayerid][2],0);
    PlayerTextDrawSetOutline(showplayerid,STATSdraw[showplayerid][2],0);
    PlayerTextDrawTextSize(showplayerid,STATSdraw[showplayerid][2],460.0,140.0);

    STATSdraw[showplayerid][3] = CreatePlayerTextDraw(showplayerid,185.0,140.0,"_");
    PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][3],TEXT_DRAW_FONT_MODEL_PREVIEW);
    PlayerTextDrawColour(showplayerid,STATSdraw[showplayerid][3],0xFFFFFFFF);
    PlayerTextDrawTextSize(showplayerid,STATSdraw[showplayerid][3],80.0,80.0);
    PlayerTextDrawSetPreviewModel(showplayerid,STATSdraw[showplayerid][3],GetPlayerSkin(playerid));

    STATSdraw[showplayerid][4] = CreatePlayerTextDraw(showplayerid,185.0,220.0,"_");
    PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][4],TEXT_DRAW_FONT_1);
    PlayerTextDrawColour(showplayerid,STATSdraw[showplayerid][4],WEISS);
    PlayerTextDrawAlignment(showplayerid,STATSdraw[showplayerid][4],TEXT_DRAW_ALIGN:0);
	PlayerTextDrawLetterSize(showplayerid,STATSdraw[showplayerid][4],0.25,0.59);
	PlayerTextDrawSetProportional(showplayerid,STATSdraw[showplayerid][4],true);
	PlayerTextDrawSetShadow(showplayerid,STATSdraw[showplayerid][4],0);

	STATSdraw[showplayerid][5] = CreatePlayerTextDraw(showplayerid,185.0,237.0,"_");
    PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][5],TEXT_DRAW_FONT_1);
    PlayerTextDrawColour(showplayerid,STATSdraw[showplayerid][5],WEISS);
    PlayerTextDrawAlignment(showplayerid,STATSdraw[showplayerid][5],TEXT_DRAW_ALIGN:0);
	PlayerTextDrawLetterSize(showplayerid,STATSdraw[showplayerid][5],0.25,0.59);
	PlayerTextDrawSetProportional(showplayerid,STATSdraw[showplayerid][5],true);
	PlayerTextDrawSetShadow(showplayerid,STATSdraw[showplayerid][5],0);

	STATSdraw[showplayerid][6] = CreatePlayerTextDraw(showplayerid,185.0,260.0,"_");
    PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][6],TEXT_DRAW_FONT_1);
    PlayerTextDrawColour(showplayerid,STATSdraw[showplayerid][6],WEISS);
    PlayerTextDrawAlignment(showplayerid,STATSdraw[showplayerid][6],TEXT_DRAW_ALIGN:0);
	PlayerTextDrawLetterSize(showplayerid,STATSdraw[showplayerid][6],0.25,0.59);
	PlayerTextDrawSetProportional(showplayerid,STATSdraw[showplayerid][6],true);
	PlayerTextDrawSetShadow(showplayerid,STATSdraw[showplayerid][6],0);

	STATSdraw[showplayerid][7] = CreatePlayerTextDraw(showplayerid,185.0,280.0,"_");
    PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][7],TEXT_DRAW_FONT_1);
    PlayerTextDrawColour(showplayerid,STATSdraw[showplayerid][7],WEISS);
