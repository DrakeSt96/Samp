							    SetPlayerACArmour(playerid,100);
							    format(string,sizeof(string),"** Paintball: %s hat die Paintball Arena betreten **",SpielerName(playerid));
								ForEachPlayer(i)
								{
									if(IsPlayerConnected(playerid))
