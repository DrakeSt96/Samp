			else
			{
				switch(listitem)
				{
					case 0:
					{
						for(new i=0;i<sizeof(sBuyInfo);i++){ format(string,sizeof(string),"%s\n%s	%i$",string,sBuyInfo[i][sbuyweaponname],SmarkInfo[sm][sartikel][i]); }
						ShowPlayerDialog(playerid,SMARK_MENU_PREISE,DIALOG_STYLE_LIST,"Schwarzmarkt (Preise)",string,"Auswählen","Zurück");
						return 1;
					}
					case 1:
					{
					    ShowPlayerDialog(playerid,SMARK_MENU_BESCHREIBUNG,DIALOG_STYLE_INPUT,"Schwarzmarkt (Beschreibung)","Hier kannst du die Beschreibung des Schwarzmarkts umändern\nGebe deinen gewünschten Text ein(Beleidigunen sind zu unterlassen):","Ändern","Zurück");
						return 1;
					}
					case 2:
					{
						format(string,sizeof(string),"Kassenstand(Geld): %i$\nGeld auf der Hand: %i$\nGib bitte den Betrag an Geld ein den du in die Schwarzmarktkasse einzahlen möchtest:",SmarkInfo[sm][skasse],GetACMoney(playerid));
					    ShowPlayerDialog(playerid,SMARK_MENU_GELD_EINZAHLEN,DIALOG_STYLE_INPUT,"Schwarzmarkt (Einzahlung von Geld)",string,"Einzahlen","Zurück");
						return 1;
					}
					case 3:
					{
						format(string,sizeof(string),"Kassenstand(Geld): %i$\nGeld auf der Hand: %i$\nGib bitte den Betrag an Geld ein den du aus der Schwarzmarktkasse auszahlen möchtest:",SmarkInfo[sm][skasse],GetACMoney(playerid));
					    ShowPlayerDialog(playerid,SMARK_MENU_GELD_AUSZAHLEN,DIALOG_STYLE_INPUT,"Schwarzmarkt (Auszahlung von Geld)",string,"Auszahlen","Zurück");
						return 1;
					}
