	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(Spieler[pID][pBL][Spieler[playerid][pFraktion]] == 1)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits auf der Blacklist deiner Fraktion!");
		if(isPlayerInFrakt(playerid,Spieler[pID][pFraktion]))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst keine Leute aus deiner eigenen Fraktion auf die Blacklist setzen.");
		if(isPlayerInFrakt(pID,4) || isPlayerInFrakt(pID,5) || isPlayerInFrakt(pID,7) || isPlayerInFrakt(pID,9) || isPlayerInFrakt(pID,12) || isPlayerInFrakt(pID,13) || isPlayerInFrakt(pID,17))
		{
		    SCM(playerid,SAMP_WEISS,"Gang/Mafien Mitglieder können nicht auf die Blacklist gesetzt werden.");
		    return 1;
		}
		format(string,sizeof(string),""IINFO" du wurdest von %s auf die Blacklist der %s gesetzt. Grund: %s",SpielerName(playerid),FraktionsName(Spieler[playerid][pFraktion]),reason);
		SCM(pID,FMELDUNG,string);
		format(string,sizeof(string),"%s hat %s auf die Blacklist gesetzt. Grund: %s",SpielerName(playerid),SpielerName(pID),reason);
	 	SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	    Spieler[pID][pBL][Spieler[playerid][pFraktion]] = 1;
	    strmid(pBLReason[pID][Spieler[playerid][pFraktion]],reason,0,strlen(reason),32);
	    return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

