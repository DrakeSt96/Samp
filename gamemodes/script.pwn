		    }
		    if(response == 1)
		    {
			    switch(listitem)
			    {
			        case 0:{
					    if(Spieler[playerid][pCallServicOAmt] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits POD angefordert! "IINFO2"/cancel");
						ServiceCall(playerid,5);//Public Order Deparmtent
					}
					case 1:{
					    if(Spieler[playerid][pCallServicMechanic] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits einen Mechaniker angefordert. "IINFO2"/cancel");
						ServiceCall(playerid,4);//Mechatroniker
					}
					case 2:{
					    if(Spieler[playerid][pCallServiceTaxi] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits ein Taxi angefordert. "IINFO2"/cancel");
						ServiceCall(playerid,8);//Taxi
					}
					case 3:{
					    if(Spieler[playerid][pCallServicMechanic] == true)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits einen Mechaniker angefordert. "IINFO2"/cancel");
						ServiceCall(playerid,4);//Electrical Services
					}
					case 4:{
						SCM(playerid,SAMP_WEISS,""IINFO" Fehler 106 (nicht fertig)");
					}
					case 5:{
						//ShowPlayerWeitereDienstLeistungen(playerid);
					}
			    }
			}
	    }
		case DIALOG_MUSIK:
		{
		    if(response == 0)
		    {
				ShowPlayerHandyMenu2(playerid);
			    return 1;
		    }
		    if(response == 1)
		    {
			    if(listitem < 0 || listitem > sizeof(Radio)-1)
				{
					StopAudioStreamForPlayer(playerid);
					return ShowPlayerHandyMenu2(playerid);
				}
				StopAudioStreamForPlayer(playerid);
			    PlayAudioStreamForPlayer(playerid,Radio[listitem][url]);
				ShowPlayerHandyMenu2(playerid);
			}
			return 1;
		}

		case DIALOG_vehMUSIK:
		{
			new vehicleid = GetPlayerVehicleID(playerid);
		    if(response == 0)return 1;
			else
		    {
				if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
				if(listitem < 0 || listitem > sizeof(Radio)-1)
				{
					ForEachPlayer(i)
					{
						if(IsPlayerConnected(i) && !IsPlayerNPC(i))
						{
							if(GetPVarInt(i,"Eingeloggt") == 1)
							{
								if(GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid))
								{
									if(IsPlayerInVehicle(i,GetPlayerVehicleID(playerid)))
									{
										StopAudioStreamForPlayer(i);
									}
								}
							}
						}
					}
					return format(VehicleRadioStream[vehicleid],128,"NONE");
				}
    			ForEachPlayer(i)
				{
					if(IsPlayerConnected(i) && !IsPlayerNPC(i))
					{
						if(GetPVarInt(i,"Eingeloggt") == 1)
						{
							if(GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid))
							{
								if(IsPlayerInVehicle(i,GetPlayerVehicleID(playerid)))
								{
								    
									StopAudioStreamForPlayer(playerid);
									PlayAudioStreamForPlayer(i,Radio[listitem][url]);
									format(VehicleRadioStream[vehicleid],128,Radio[listitem][url]);

								}
							}
						}
					}
				}
			}
			return 1;
		}

		case DIALOG_TELEFONZELLE_CALL://gehört noch zu den handy dialogen,weil dieser sehr identisch wie der call dieloag des handysystems ist !
		{
			new savetime;
			if(response == 0)return 1;
		    else
		    {
			    if(!strlen(inputtext))
			    {
					return ShowPlayerDialog(playerid,DIALOG_TELEFONZELLE_CALL,DIALOG_STYLE_INPUT,"Telefon","Gib nun bitte die Nummer des Spielers ein,denn du anrufen willst!","Anrufen","Zurück");
				}
				if(!IsNumeric(inputtext))
				{
					return ShowPlayerDialog(playerid,DIALOG_TELEFONZELLE_CALL,DIALOG_STYLE_INPUT,"Telefon","Gebe nur Zahlen ein !\nGib nun bitte die Nummer des Spielers ein,denn du anrufen willst!","Anrufen","Zurück");
				}
			    SCM(playerid,SAMP_WEISS,"Verbinde...");
			    PlayerPlaySound(playerid,3600,0.0,0.0,0.0);
			    Spieler[playerid][pCallEntry] = strval(inputtext);
			    if(Spieler[playerid][pCallEntry] == 911 || Spieler[playerid][pCallEntry] == 110)
				{
					SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Was ist geschehen ?");
					return ShowPlayerDialog(playerid,DIALOG_HANDY_CALL911,DIALOG_STYLE_LIST,"Telefon","Mord\nKörperverletzung\nSachbeschädigung\nUnfall\nSchiesserei","Auswählen","Abbrechen");
				}
				if(IsHandyNummerEnable(Spieler[playerid][pCallEntry]) == -1)
				{
					ShowPlayerDialog(playerid,DIALOG_TELEFONZELLE_CALL,DIALOG_STYLE_INPUT,"Telefon","Gib nun bitte die Nummer des Spielers ein,den du anrufen willst!","Anrufen","Abbrechen");
					return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
				}
				new pID = IsHandyNummerEnable(Spieler[playerid][pCallEntry]),time = ReturnHempfangRate(pID);
				if(time == -1)
				{
					savetime = 10;
				}
				else
				{
					savetime = ReturnHempfangRate(pID);
				}
				SetTimerEx("HandySendConnect",savetime*1000,false,"ii",playerid,2);
			}
		}

	    case DIALOG_LS_AUFZUG:
