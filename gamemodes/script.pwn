				}
				else
				{
				    strmid(HausInfo[haus][haus_beschreibung],inputtext,0,strlen(inputtext),150);
				    format(string,sizeof(string),""IINFO" du hast deine Hausbeschreibung in "IINFO2"%s"#HTML_WEISS" umgeändert.",HausInfo[haus][haus_beschreibung]);
					SCM(playerid,SAMP_WEISS,string);
