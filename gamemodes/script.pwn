				    	ShowPlayerDialog(playerid,H_INTERIOR_KAUFEN_HEAL,DIALOG_STYLE_LIST,"HomeStore","25% Heal (10.000$)\n50% Heal (20.000$)\n100% Heal (40.000$)","Kaufen","Zurück");
