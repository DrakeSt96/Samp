COMMAND:aorgmakeleader(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],org;
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	if(sscanf(params,"ui",pID,org))return SCM(playerid,SAMP_WEISS,""IINFO" /aorgmakeleader [playerid/Name][Unternehmen]");
	if(org < 1 || org >= MAX_ORGANISATIONS || OrgInfo[org][OrgCreatet] != 1)return SCM(playerid,SAMP_WEISS,"Die von dir angegebene Organisation existiert nicht.(/organisationen)");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pOrgMember] != org)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Organisation Mitglied.");
	if(Spieler[pID][pOrgLeader] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast schon eine Firma");
	format(string,sizeof(string),""IINFO" Du wurdest von "IINFO2"%s"#HTML_WEISS" zum Leiter der Firma: "IINFO2"%s"#HTML_WEISS" ernannt.",Spieler[playerid][pName],OrgInfo[org][OrgName]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" %s hat %s zum Leiter der Firma ernannt.",Spieler[playerid][pName],Spieler[pID][pName]);
	SendOrganisationsMessage(org,SAMP_WEISS,string);
	Spieler[pID][pOrgLeader] = org;
	return 1;
}

COMMAND:aparteimakeleader(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],p;
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	if(sscanf(params,"ui",pID,p))return SCM(playerid,SAMP_WEISS,""IINFO" /aparteimakeleader [playerid/Name][Partei]");
	if(p < 1 || p >= MAX_PARTEI || PartInfo[p][ParteiCreatet] != 1)return SCM(playerid,SAMP_WEISS,"Die von dir angegebene Partei existiert nicht.(/parteien)");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pParteiMember] != p)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Partei Mitglied.");
	if(Spieler[pID][pParteiLeader] != 0)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits Leiter der Partei.");
	format(string,sizeof(string),""ACINFO" Du wurdest von %s (ID:%i) zum Leiter der Partei "IINFO2"%s"#HTML_WEISS" ernannt.",Spieler[playerid][pName],playerid,PartInfo[p][ParteiName]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),""ACINFO" %s hat %s zum Leiter der Firma: ernannt.",Spieler[playerid][pName],Spieler[pID][pName]);
	SendOrganisationsMessage(p,SAMP_WEISS,string);
	Spieler[pID][pParteiLeader] = p;
	return 1;
}

COMMAND:aorgtakeleader(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],org;
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	if(sscanf(params,"ui",pID,org))return SCM(playerid,SAMP_WEISS,""IINFO" /aorgtakeleader [playerid/Name][Unternehmen]");
	if(org < 1 || org >= MAX_ORGANISATIONS || OrgInfo[org][OrgCreatet] != 1)return SCM(playerid,SAMP_WEISS,"Die von dir angegebene Organisation existiert nicht.(/organisationen)");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pOrgMember] != org)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Organisation Mitglied.");
	if(Spieler[pID][pOrgLeader] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht Leiter der Organisation.");
	if(strcmp(Spieler[pID][pName],OrgInfo[org][OrgOwner],true) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst den Inhaber der Orgnisation nicht als Leiter abweisen.");
	format(string,sizeof(string),""ACINFO" Du wurdest von %s (ID:%i) als Leiter der Organisation "IINFO2"%s"#HTML_WEISS" abgewiesen.",Spieler[playerid][pName],playerid,OrgInfo[org][OrgName]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),""ACINFO" %s wurde von %s als Leiter der Organisation abgewiesen.",Spieler[pID][pName],Spieler[playerid][pName]);
	SendOrganisationsMessage(org,SAMP_WEISS,string);
	Spieler[pID][pOrgLeader] = 0;
	return 1;
}

