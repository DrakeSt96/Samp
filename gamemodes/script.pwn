	    case DIALOG_STADTHALLE:
	    {
		    new string[256];
			if(response == 0)return 1;
		    if(response == 1)
		    {
			    switch(listitem)
			    {
				    case 0://personauswahlweis
				    {
						if(Spieler[playerid][pPersoLic] == 1)return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben bereits einen Personalausweis.");
					    if((GetACMoney(playerid) - fsteuern[PersoLicPrice]) < 0)return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben nicht genug Geld.");
						if(Spieler[playerid][WaitPerso] == 0 && Spieler[playerid][WaitPersoReadyMsg] == 0)
						{
							SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Schön das Sie Ihren Personalausweis beantragt haben.");
						    SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Kommen Sie doch so in 15 Minuten wieder vorbei um den Personalausweis abzuholen.");
						    Spieler[playerid][WaitPerso] = gettime() + (60*15);
						    Spieler[playerid][WaitPersoReadyMsg] = 0;
						    return 1;
						}
						if(Spieler[playerid][WaitPerso] < gettime() && Spieler[playerid][WaitPersoReadyMsg] == 1)
						{
							ACMoney(playerid,-fsteuern[PersoLicPrice]);
							fverwaltungen[16][Geld] += fsteuern[PersoLicPrice];
						  	PlayerPlaySound(playerid,1183,0.0,0.0,0.0);
						  	SetTimerEx("StopPlayerPlaySound",5000,false,"i",playerid);
						  	SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben sich den Personalausweis erfolgreich beschafft.");
						  	SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Diesen brauchen Sie für viele wichtige Dinge.");
						  	SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Beispielsweise bei der Berufswahl oder einmieten in ein Haus.");
						  	Spieler[playerid][pPersoLic] = 1;
						  	Spieler[playerid][WaitPerso] = 0;
						  	Spieler[playerid][WaitPersoReadyMsg] = 0;
						  	return 1;
					    }
					    new time = Spieler[playerid][WaitPerso] - gettime();
					    format(string,sizeof(string),""IINFO2"Sekretärin:"#HTML_WEISS" Sie müssen noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten warten bis Ihr Personalausweis erstellt ist.",time/60,time%60);
					    SCM(playerid,SAMP_WEISS,string);
						ShowPlayerStadthalleMenu(playerid);
					}
				    case 1://jobangebote
				    {
					    if(Spieler[playerid][pPersoLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie brauchen einen Personalausweis um einen Beruf annehmen zu können.");
					  	if(!isPlayerInJob(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben bereits einen Job.");
					  	ShowPlayerJobMenu(playerid);
				    }
				    case 2://angelschein
				    {
					    if(Spieler[playerid][pFishingLic] == 1)return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben bereits einen Angelschein.");
					    if((GetACMoney(playerid) - fsteuern[AngelLicPrice]) < 0)return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben nicht genug Geld.");
					    ACMoney(playerid,-fsteuern[AngelLicPrice]);
						fverwaltungen[16][Geld] += fsteuern[AngelLicPrice];
					    Spieler[playerid][pFishingLic] = 1;
					    SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben sich den Angelschein erfolgreich beschaffen.");
					    SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Mit diesem verkürzt sich die Angelzeit um die Hälfte.");
						ShowPlayerStadthalleMenu(playerid);
					}
				    case 3://arbeitslosengeld
				    {
					    if(Spieler[playerid][pPersoLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie besitzen keinen Personalausweis.");
					 	if(Spieler[playerid][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie besitzen kein Bankkonto.");
					    if(Spieler[playerid][pWorkLess] == 1)
					    {
							ShowPlayerStadthalleMenu(playerid);
							SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben ihr Arbeitslosen-Geld abgewählt.");
						 	return Spieler[playerid][pWorkLess] = 0;
					    }
						ShowPlayerDialog(playerid,DIALOG_ARBEITSLOSENGELD,DIALOG_STYLE_MSGBOX,"Arbeitslosegeld Beantragung","Möchtest du Arbeitslosengeld beantragen?\nFalls ja,tippe 'ja' ein und wenn nicht,dann 'zurück'.\nInfo: Du erhälst nur Arbeitslosengeld,wenn du keinen Job hast.\nFalls du doch einen Job beanträgst,wird dein Arbeitslosengeld gestrichen!","Ja","Zurück");
					}
					case 4://Jobsperre
					{
						if(!isPlayerInJob(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie sind bereits in einem Job tätig.");
						if((GetACMoney(playerid) - fsteuern[JobSperreFree]) < 0)return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben nicht genug Geld.");
					    if(gettime() > Spieler[playerid][pJobSperre])return SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben keine Jobsperre.");
					    SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie haben sich die Jobsperre löschen lassen.");
					    SCM(playerid,SAMP_WEISS,""IINFO2"Sekretärin:"#HTML_WEISS" Sie können nun wieder Jobs annehmen.");
					    ACMoney(playerid,-fsteuern[JobSperreFree]);
					    fverwaltungen[16][Geld] += fsteuern[JobSperreFree];
						Spieler[playerid][pJobSperre] = 0;
					}
					case 5:{
						ShowPlayerCreateFirma(playerid);
					}//Firma
			    }
			    return 1;
		    }
	    }
