			if(strcmp(cmd,"Funkgerät",true) == 0)
			{
				if(Spieler[pID][pFunkgeraet] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt kein Funkgerät.");
			    format(string,sizeof(string),""IINFO" du hast %s (ID:%i) das Funkgerät entnommen und hast es anschließend auf den Boden geworfen.",SpielerName(pID),pID);
				SCM(playerid,SAMP_WEISS,string);
				format(string,sizeof(string),"%s (ID:%i) hat dir dein Funkgerät entnommen und es auf den Boden geworfen.",SpielerName(playerid),playerid);
				SCM(pID,SAMP_WEISS,string);
				format(string,sizeof(string),"** %s nimmt %s Funkgerät und wirft es auf den Boden **",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				Spieler[pID][pFunkgeraet] = 0;
				return 1;
			}
			if(strcmp(cmd,"Tazer",true) == 0)
			{
				if(Spieler[pID][pTazer] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt kein Tazer.");
			    format(string,sizeof(string),""IINFO" du hast %s (ID:%i) den Tazer entnommen und hast es anschließend auf den Boden geworfen.",SpielerName(pID),pID);
				SCM(playerid,SAMP_WEISS,string);
				format(string,sizeof(string),"%s (ID:%i) hat dir deinen Tazer entnommen und es auf den Boden geworfen.",SpielerName(playerid),playerid);
				SCM(pID,SAMP_WEISS,string);
				format(string,sizeof(string),"** %s nimmt %s Tazer und wirft es auf den Boden **",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			    Spieler[pID][pTazer] = 0;
				return 1;
			}
			SCM(playerid,SAMP_WEISS,""IINFO" /detachthings [playerid/Name][Sache]");
			SCM(playerid,SAMP_WEISS,"Sache:");
		    SCM(playerid,SAMP_WEISS,"[Ganja/Kokain/Opium/Spice/Lunch/Zigarette/Kokainsamen/Ganjasamen/Funkgerät/Tazer]");
		    return SCM(playerid,SAMP_WEISS,"[Materials/Werkzeugkasten/Benzinkanister/Köder/OpiumsamenSpicesamen/Handy]");
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines getazerten/gefesselten Spielers.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:take(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,16) || isPlayerAnAdmin(playerid,5) && Spieler[playerid][pAdminOnduty] == true)
	{
		new pID,string[128],cmd[30];
		if(Spieler[playerid][pDuty] == 0 && Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(sscanf(params,"us[30]",pID,cmd))
		{
			SCM(playerid,SAMP_WEISS,""IINFO" /take [playerid/Name][Handlung]");
			SCM(playerid,SAMP_WEISS,"Handlungen:");
			SCM(playerid,SAMP_WEISS,"Führerschein/Motorradschein/Rollerschein/Flugschein/Helikopterschein/Scheinsperre");
			return SCM(playerid,SAMP_WEISS,"Bootsschein/Waffenschein/Waffen/Rüstung/Drogen/Materials/MatsPackete/C4");
		}
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	   	if(strcmp(cmd,"Führerschein",true) == 0)
	   	{
		   	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,11) || isPlayerAnAdmin(playerid,6) && Spieler[playerid][pAdminOnduty] == true)
		   	{
			   	if(Spieler[playerid][pAdminOnduty] == false)
			   	{
				   	if(!isPlayerAMember(playerid,1))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
				   	if(Spieler[playerid][pFunkgeraet] == 0)return SCM(playerid,SAMP_WEISS,"Kein Funktgerät.");
					if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
					if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Scheine abnehmen.");
				}
				if(Spieler[pID][pAutoLic] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keinen Führerschein.");
			   	format(string,sizeof(string),"%s hat dir dein Führerschein abgenommen.",SpielerName(playerid));
			   	SCM(pID,SAMP_WEISS,string);
			   	Spieler[pID][pScheinSperre] = gettime() + (60*60*2);
			  	Spieler[pID][pAutoLic] = 0;
			  	format(string,sizeof(string),"%s hat %s den Führerschein abgenommen.",SpielerName(playerid),SpielerName(pID));
			    ForEachPlayer(i)
				{
					if(IsPlayerConnected(i))
					{
					 	if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,3) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,16))
						{
							if(Spieler[i][pDuty] != 0)
							{
								if(Spieler[i][pFunkgeraet] == 1 || (IsAFraktionsVeh(i) != -1 && Fahrzeug[IsAFraktionsVeh(i)][Fraktion] == Spieler[i][pFraktion]) || FraktionsAktenPCs(i))
								{
							 		SCM(i,SAMP_WEISS,string);
							  	}
						  	}
					  	}
				  	}
			  	}
			  	return 1;
		  	}
		 	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion./Du bist nicht im Admindienst.");
		}
	   	if(strcmp(cmd,"Motorradschein",true) == 0)
	   	{
		   	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,11) || isPlayerAnAdmin(playerid,6) && Spieler[playerid][pAdminOnduty] == true)
