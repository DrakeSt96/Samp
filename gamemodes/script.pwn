	format(string,sizeof(string),""ACINFO" Du wurdest von %s (ID:%i) aus der Partei "IINFO2"%s"#HTML_WEISS" geschmissen.",Spieler[playerid][pName],playerid,PartInfo[p][ParteiName]);
