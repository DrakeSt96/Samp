COMMAND:fparken(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new fv = IsAFraktionsVeh(playerid),vehicleid = GetPlayerVehicleID(playerid);
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pLeader] == 0)return SCM(playerid,SAMP_WEISS,"Kein Leader.");
	if(fv == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
	if(Fahrzeug[fv][Fraktion] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
 	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(Motor[vehicleid] == true)return SCM(playerid,SAMP_WEISS,""IINFO" der Motor muss aus sein,bevor du das Fahrzeug parkst.");
	GetVehiclePos(Fahrzeug[fv][Vehicle],Fahrzeug[fv][posx],Fahrzeug[fv][posy],Fahrzeug[fv][posz]);
	GetVehicleZAngle(Fahrzeug[fv][Vehicle],Fahrzeug[fv][posa]);
	Fahrzeug[fv][Interior] = GetPlayerInterior(playerid);
	Fahrzeug[fv][VirtualWorld] = GetVehicleVirtualWorld(vehicleid);
	SCM(playerid,SAMP_WEISS,""IINFO" du hast das Fahrzeug erfolgreich umgeparkt.");
	GetVehicleHealth(Fahrzeug[fv][Vehicle],Fahrzeug[fv][HP]);
	FVehicleSpawner(fv);
	SaveOnlyOneFveh(fv);
	PutPlayerInVehicleEx(playerid,Fahrzeug[fv][Vehicle],0);
	return 1;
}
COMMAND:fsetrang(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new fv = IsAFraktionsVeh(playerid),rank,string[128];
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pLeader] == 0)return SCM(playerid,SAMP_WEISS,"Kein Leader.");
	if(fv == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
	if(Fahrzeug[fv][Fraktion] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
 	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(sscanf(params,"i",rank))return SCM(playerid,SAMP_WEISS,""IINFO" /fsetrang [Rang]");
    if(!isPlayerInFrakt(playerid,6) && !isPlayerInFrakt(playerid,13) && !isPlayerInFrakt(playerid,1) && !isPlayerInFrakt(playerid,3))
	{
	    if(rank<0||rank>6)return SCM(playerid,SAMP_WEISS,""IINFO" /fsetrang [Rang 0-6]");
    }
    if(isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,13))
	{
	    if(rank<0||rank>14)return SCM(playerid,SAMP_WEISS,""IINFO" /fsetrang [Rang 0-14]");
	}
    if(isPlayerInFrakt(playerid,1))
	{
	    if(rank<0||rank>18)return SCM(playerid,SAMP_WEISS,""IINFO" /fsetrang [Rang 0-18]");
	}
	if(isPlayerInFrakt(playerid,3))
	{
	    if(rank<0||rank>18)return SCM(playerid,SAMP_WEISS,""IINFO" /fsetrang [Rang 0-12]");
	}
	Fahrzeug[fv][FraktionsRang] = rank;
	SaveOnlyOneFveh(fv);
	format(string,sizeof(string),""IINFO" du hast den Rang um das Fahrzeug aufzuschließen auf den Rang "IINFO2"%i"#HTML_WEISS" gesetzt.",rank);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:flock(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:x,Float:y,Float:z,string[64];
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    for(new fv;fv<MAX_FVEHS;fv++)
	{
		if(IsValidVehicle(Fahrzeug[fv][Vehicle]))
		{
		   	GetVehiclePos(Fahrzeug[fv][Vehicle],x,y,z);
			GetVehicleParamsEx(Fahrzeug[fv][Vehicle],engine,lights,alarm,doors,bonnet,boot,objective);
			if(IsPlayerInRangeOfPoint(playerid,3.5,x,y,z))
			{
				if(Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion] && isPlayerAMember(playerid,Fahrzeug[fv][FraktionsRang]))
				{
					if(Fahrzeug[fv][Abgeschlossen] == 0)
					{
					    SetVehicleParamsEx(Fahrzeug[fv][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
					    Fahrzeug[fv][Abgeschlossen] = 1;
					    format(string,sizeof(string),"~w~%s~n~~r~abgeschlossen",VehicleDefinations[Fahrzeug[fv][modelid]-400]);
					    GameTextForPlayer(playerid,string,2000,6);
					    PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
						return 1;
					}
					else if(Fahrzeug[fv][Abgeschlossen] == 1)
					{
					    SetVehicleParamsEx(Fahrzeug[fv][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
					    Fahrzeug[fv][Abgeschlossen] = 0;
						format(string,sizeof(string),"~w~%s~n~~g~aufgeschlossen",VehicleDefinations[Fahrzeug[fv][modelid]-400]);
					    GameTextForPlayer(playerid,string,2000,6);
					    PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
					    return 1;
					}
				}
				return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Fraktionsfahrzeuges.");
}

COMMAND:anmelden(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
    if(IsVehicleACar(GetPlayerVehicleID(playerid)) || IsVehABike(GetPlayerVehicleID(playerid)))
    {
		if(!IsPlayerInRangeOfPoint(playerid,5.0,594.2240,-1244.5668,18.0797))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Fahrzeuganmeldeamt.");
	    for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
		 	if(!strcmp(Spieler[playerid][pName],Pfahrzeug[slot][playerid][Besitzer],true))
			{
			   	if(GetPlayerVehicleID(playerid) == Pfahrzeug[slot][playerid][Vehicle])
			   	{
					if(Pfahrzeug[slot][playerid][Angemeldet] == 0)return ShowPlayerDialog(playerid,DIALOG_FPLAYAanmeldung,DIALOG_STYLE_INPUT,"Fahrzeuganmeldung","Gebe nun dein gewünschtes Kennzeichen ein.\nEs darf maximal 2 Zeichen haben!","Bestätigen","Abbrechen");
					return ShowPlayerDialog(playerid,DIALOG_FPLAYAabmeldung,DIALOG_STYLE_MSGBOX,"Fahrzeugabmeldung","Möchtest du dein Fahrzeug abmelden ?\nFalls ja klicke *BESTÄTIGEN* falls nicht *ABBRECHEN*\nInfo: Das fahren mit nicht angemeldeten Fahrzeugen wird bestraft!","Bestätigen","Abbrechen");
				}
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du kannst das Fahrzeug nicht anmelden.");
}
COMMAND:frespawn(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[650];
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht den jeweiligen Rang.");
    if(gettime() > FRespawnTimer[Spieler[playerid][pFraktion]] && GWisStarted4Fraktion[Spieler[playerid][pFraktion]] != 1)
	{
	    for(new fv;fv<MAX_FVEHS;fv++)
		{
			if(Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
			{
				if(IsVehicleEmpty(Fahrzeug[fv][Vehicle]))
				{
					GetVehicleHealth(Fahrzeug[fv][Vehicle],Fahrzeug[fv][HP]);
				 	FVehicleSpawner(fv);
				}
			}
		}
		if(isPlayerInFrakt(playerid,1))
		{
			for(new i=0;i<sizeof(PolizeiWaffentransport);i++)
			{
				if(IsVehicleEmpty(PolizeiWaffentransport[i]))
				{
					MotorDown[PolizeiWaffentransport[i]] = 0;
					vFahrzeug[PolizeiWaffentransport[i]][FailGas] = 0;
					vFahrzeug[PolizeiWaffentransport[i]][HP] = 3500.0;
					vFahrzeug[PolizeiWaffentransport[i]][Tank] = VehicleInfo[GetVehicleModel(PolizeiWaffentransport[i])-400][vtankvolumen];
					SetVehicleToRespawn(PolizeiWaffentransport[i]);
				}
			}
		}
		FRespawnTimer[Spieler[playerid][pFraktion]] = gettime() + (60*10);
		format(string,sizeof(string),""#HTML_WEISS" Rang: "IINFO2"%s"#HTML_WEISS" Name: "IINFO2"%s"#HTML_WEISS" hat alle unbenutzten Fraktionsfahrzeuge von: "IINFO2"%s"#HTML_WEISS" zurückgesetzt.",SpielerFraktionsRangName(playerid),SpielerName(playerid),FraktionsName(Spieler[playerid][pFraktion]));
	    SendFraktionsMessage(Spieler[playerid][pFraktion],SAMP_WEISS,string);
	}
	else
	{
		new timestampfvs = FRespawnTimer[Spieler[playerid][pFraktion]]-gettime();
		format(string,sizeof(string),""IINFO" die Fraktionsfahrzeuge können erst in "IINFO2""IINFO2"%i:%02d"#HTML_WEISS""#HTML_WEISS" Minuten respawnt werden.",floatround(timestampfvs/60),floatround(timestampfvs%60));
		SCM(playerid,SAMP_WEISS,string);
	}
	return 1;
}
COMMAND:orespawn(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(!isPlayerInFrakt(playerid,11))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	for(new i=0;i<MAX_VEHICLES;i++)
	{
		if(IsValidVehicle(i))
		{
			if(vFahrzeug[i][Abgeschleppt] == 1)
			{
				SetVehicleToRespawn(i);
			}
		}
	}
	format(string,sizeof(string),"Rang: "IINFO2"%s"#HTML_WEISS" Name: "IINFO2"%s"#HTML_WEISS" hat alle Abgeschleppten Fahrzeuge im POD respawnt!",SpielerFraktionsRangName(playerid),SpielerName(playerid));
    SendFraktionsMessage(Spieler[playerid][pFraktion],SAMP_WEISS,string);
	return 1;
}
stock VehicleOwnedByPlayer(playerid, vehicleid)
{
	if(IsSpielerCar[vehicleid])
	{
		if(SpielerAutoInfo[vehicleid][Besitzer] == Spieler[playerid][pSaveID]) return true;
	}
	return false;
}
COMMAND:abschleppen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new preis,reason[60],string[256],vehicleid = GetVehicleTrailer(GetPlayerVehicleID(playerid));
    if(!isPlayerInFrakt(playerid,11))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(IsPlayerInZone(playerid,1046, -1707, 1140, -1667))
	{
		if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 525)return SCM(playerid,SAMP_WEISS,"In keinem Tow Truck.");
		if(!IsTrailerAttachedToVehicle(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Kein Fahrzeug am Haken.");
		if(sscanf(params,"is[60]",preis,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /abschleppen [Preis][Grund]");
	    if(strlen(reason) > 60)return SCM(playerid,SAMP_WEISS,""IINFO" /abschleppen [Preis][Grund]");
		if(preis<1||preis>5000)return SCM(playerid,SAMP_WEISS,""IINFO" bitte wähle einen Preis von 1-5000 $ ein.");
		if(vFahrzeug[vehicleid][Abgeschleppt] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" Fahrzeug wurde bereits abgeschleppt.");
		for(new fv;fv<MAX_FVEHS;fv++)
		{
			if(Fahrzeug[fv][Vehicle] == vehicleid && Fahrzeug[fv][Fraktion] != 0)
		 	{
			 	vFahrzeug[Fahrzeug[fv][Vehicle]][Abgeschleppt] = 1;
				vFahrzeug[Fahrzeug[fv][Vehicle]][AbgeschlepptPreis] = preis;
			    format(vFahrzeug[Fahrzeug[fv][Vehicle]][AbgeschlepptGrund],128,"%s | %s",reason,Spieler[playerid][pName]);
				GetVehiclePos(Fahrzeug[fv][Vehicle],Fahrzeug[fv][posx],Fahrzeug[fv][posy],Fahrzeug[fv][posz]);
				GetVehicleZAngle(Fahrzeug[fv][Vehicle],Fahrzeug[fv][posa]);
			    DetachTrailerFromVehicle(GetPlayerVehicleID(playerid));
				format(string,sizeof(string),""IINFO" du hast hast das Fahrzeug: "IINFO2"%s"#HTML_WEISS" für "IINFO2"%i$"#HTML_WEISS" mit dem Grund: "IINFO2"%s"#HTML_WEISS" abgeschleppt.",
				VehicleDefinations[Fahrzeug[fv][modelid]-400],vFahrzeug[Fahrzeug[fv][Vehicle]][AbgeschlepptPreis],vFahrzeug[Fahrzeug[fv][Vehicle]][AbgeschlepptGrund]);
				SCM(playerid,SAMP_WEISS,string);
				GetVehicleHealth(Fahrzeug[fv][Vehicle],Fahrzeug[fv][HP]);
				FVehicleSpawner(fv);
				SaveOnlyOneFveh(fv);
				return 1;
			}
		}
		ForEachPlayer(i)
		{
			for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
			{
				if(vehicleid == Pfahrzeug[slot][i][Vehicle])
				{
					vFahrzeug[Pfahrzeug[slot][i][Vehicle]][Abgeschleppt] = 1;
					vFahrzeug[Pfahrzeug[slot][i][Vehicle]][AbgeschlepptPreis] = preis;
					format(vFahrzeug[Pfahrzeug[slot][i][Vehicle]][AbgeschlepptGrund],128,"%s | %s",reason,Spieler[playerid][pName]);
					GetVehiclePos(Pfahrzeug[slot][i][Vehicle],Pfahrzeug[slot][i][posx],Pfahrzeug[slot][i][posy],Pfahrzeug[slot][i][posz]);
					GetVehicleZAngle(Pfahrzeug[slot][i][Vehicle],Pfahrzeug[slot][i][posa]);
				    DetachTrailerFromVehicle(GetPlayerVehicleID(playerid));
					format(string,sizeof(string),""IINFO" du hast einen %s für %i$ mit dem Grund: "IINFO2"%s"#HTML_WEISS" abgeschleppt.",VehicleDefinations[Pfahrzeug[slot][i][modelid]-400],vFahrzeug[vehicleid][AbgeschlepptPreis],vFahrzeug[vehicleid][AbgeschlepptGrund]);
					SCM(playerid,SAMP_WEISS,string);
					GetVehicleHealth(Pfahrzeug[slot][i][Vehicle],Pfahrzeug[slot][i][HP]);
					VehicleSpawner(i,slot);
					SaveOnlyOnePveh(i,slot);
					return 1;
				}
			}
		}
		return SCM(playerid,SAMP_WEISS,"Fahrzeug ist kein Fraktionsfahrzeug./Fahrzeug ist kein Spielerfahrzeug.");
	}
	return SCM(playerid,SAMP_WEISS,"Nicht am Ordungsamtstellplatz.");
}
COMMAND:oentsperren(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetVehicleTrailer(GetPlayerVehicleID(playerid));
    if(!isPlayerInFrakt(playerid,11))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(!IsTrailerAttachedToVehicle(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Kein Fahrzeug am Haken.");
    if(IsPlayerInZone(playerid,1046, -1707, 1140, -1667))
	{
		if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 525)return SCM(playerid,SAMP_WEISS,""IINFO" In keinem Tow Truck.");
		if(vFahrzeug[vehicleid][Abgeschleppt] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" Fahrzeug wurde nicht abgeschleppt.");
	    vFahrzeug[vehicleid][Abgeschleppt] = 0;
		vFahrzeug[vehicleid][AbgeschlepptPreis] = 0;
	    DetachTrailerFromVehicle(GetPlayerVehicleID(playerid));
	    SCM(playerid,SAMP_WEISS,""IINFO" Fahrzeug entsperrt.");
    	return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" nicht am Ordungsamtstellplatz.");
}
COMMAND:opark(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetVehicleTrailer(GetPlayerVehicleID(playerid));
    if(!isPlayerInFrakt(playerid,11))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(!IsTrailerAttachedToVehicle(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Kein Fahrzeug am Haken.");
    if(IsPlayerInZone(playerid,1046, -1707, 1140, -1667))
	{
		if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 525)return SCM(playerid,SAMP_WEISS,"In keinem Tow Truck.");
		if(vFahrzeug[vehicleid][Abgeschleppt] == 0)return SCM(playerid,SAMP_WEISS,"Fahrzeug wurde nicht abgeschleppt.");
		for(new fv;fv<MAX_FVEHS;fv++)
		{
			if(Fahrzeug[fv][Fraktion] != 0 && Fahrzeug[fv][Vehicle] == vehicleid)
			{
				GetVehiclePos(Fahrzeug[fv][Vehicle],Fahrzeug[fv][posx],Fahrzeug[fv][posy],Fahrzeug[fv][posz]);
				GetVehicleZAngle(Fahrzeug[fv][Vehicle],Fahrzeug[fv][posa]);
			    DetachTrailerFromVehicle(GetPlayerVehicleID(playerid));
			    SCM(playerid,SAMP_WEISS,""IINFO" Fahrzeug geparkt.");
			    GetVehicleHealth(Fahrzeug[fv][Vehicle],Fahrzeug[fv][HP]);
			    FVehicleSpawner(fv);
			    return 1;
		    }
	    }
		ForEachPlayer(i)
		{
			for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
			{
				if(vehicleid == Pfahrzeug[slot][i][Vehicle])
				{
					GetVehiclePos(Pfahrzeug[slot][i][Vehicle],Pfahrzeug[slot][i][posx],Pfahrzeug[slot][i][posy],Pfahrzeug[slot][i][posz]);
					GetVehicleZAngle(Pfahrzeug[slot][i][Vehicle],Pfahrzeug[slot][i][posa]);
				    DetachTrailerFromVehicle(GetPlayerVehicleID(playerid));
					SCM(playerid,SAMP_WEISS,""IINFO" Fahrzeug geparkt.");
					GetVehicleHealth(Pfahrzeug[slot][i][Vehicle],Pfahrzeug[slot][i][HP]);
					VehicleSpawner(i,slot);
					return 1;
				}
			}
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dieses Fahrzeug nicht abschleppen.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" nicht am Ordungsamtstellplatz.");
}
COMMAND:respawnjobveh_3(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new cmd[20];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"s[20]",cmd))
	{
		SCM(playerid,SAMP_WEISS,""IINFO" /respawnjobveh [Job]");
		SCM(playerid,SAMP_WEISS,"Job:");
		return SCM(playerid,SAMP_WEISS,"Müll/Bestatter/Cleaner/Fluglierferant/Postbote/Landwirt/Eis/Bank/Truck/Bus/KFZ/Taxi/ZigTransport/Erzbagger/Bauarbeiter");
	}
	if(strcmp(cmd,"Bestatter",true) == 0)
	{
		for(new i=0;i<sizeof(Leichenwagen);i++)
