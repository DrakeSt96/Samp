			    HausInfo[haus][hausmull]++;
			    if(HausInfo[haus][hausmull] >= 25)
				{
				SetPlayerACHealth(playerid,10);
				SCM(playerid,SAMP_WEISS,""IINFO" der Müll staut sich bis an die Decke. | Du spawnest mit wenig Leben(-90).");
				}
