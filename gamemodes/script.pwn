					ShowPlayerDialog(playerid,DIALOG_WANTEDAKTE,DIALOG_STYLE_INPUT,""ClanTagDialoge" MDC - Spieler Akte",""#HTML_WEISS"Gebe nun die "IINFO2"id"#HTML_WEISS" oder den "IINFO2"Name"#HTML_WEISS" der Person ein dessen Akten du anschauen möchtest.","Auswählen","Abbrechen");
				    return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht eingeloggt!");
