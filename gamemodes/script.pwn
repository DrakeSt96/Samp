		ACMoney(pID,Spieler[playerid][pKaufPreis]);
	    Spieler[playerid][pBL][Spieler[pID][pFraktion]] = 0;
	    strmid(pBLReason[playerid][Spieler[pID][pFraktion]],"Keinen",0,strlen("Keinen"),32);
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
