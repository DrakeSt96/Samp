					}
					else format(string,sizeof(string),""#HTML_WEISS"Name: "IINFO2"%s"#HTML_WEISS" Level: "IINFO2"%i"#HTML_WEISS" Handy: "IINFO2"%i"#HTML_WEISS"\n%s",SpielerName(i),GetPlayerLevel(i),Spieler[i][pPhonenumber],string);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_LIST,""ClanTagDialoge" Neulinge - Liste",string,"Verlassen","");
