				    SCM(playerid,SAMP_WEISS,"|___JACKPOT___|");
				    format(string,sizeof(string),"Alter Jackpotstand: %i$",fsteuern[Lottojackpot]);
					SCM(playerid,SAMP_WEISS,string);
					format(string,sizeof(string),"Einzahlung: %i$",geld);
