public OnPlayerLeaveRaceCheckpoint(playerid)
{

	return 1;
}
public OnPlayerClickMap(playerid,Float:fX,Float:fY,Float:fZ)
{
    if(isPlayerAnAdmin(playerid,6) && Spieler[playerid][pAdminOnduty] == true)
    {
	    if(IsPlayerInAnyVehicle(playerid))
		{
			new seatid = GetPlayerVehicleSeat(playerid);
			SetPlayerPosFindZEx(playerid,fX,fY,fZ);
			SetVehiclePosEx(GetPlayerVehicleID(playerid),fX,fY,fZ);
			PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),seatid);
			SetPlayerInterior(playerid,0);
		    SetPlayerVirtualWorld(playerid,0);
			LinkVehicleToInterior(GetPlayerVehicleID(playerid),0);
			SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),0);
			SCM(playerid,SAMP_WEISS,""IINFO" du hast dich zum markierten Punkt geportet!");
		    return 1;
		}
		else
		{
		    SetPlayerPosFindZEx(playerid,fX,fY,fZ);
			SetPlayerInterior(playerid,0);
		    SetPlayerVirtualWorld(playerid,0);
		    SCM(playerid,SAMP_WEISS,""IINFO" du hast dich zum markierten Punkt geportet!");
		    return 1;
	    }
    }
    return 0;
}
public OnPlayerClickPlayer(playerid,clickedplayerid,CLICK_SOURCE:source)
{
	AP[playerid] = clickedplayerid;
	if(Spieler[playerid][pLevel]>=3){
		ShowPlayerDialog(playerid,DIALOG_PM,DIALOG_STYLE_INPUT,""ClanTagDialoge" Nachricht Senden",""#HTML_WEISS"Gebe den Text ein, den du den Spieler schreiben möchtest.","Senden","Abbrechen");
	}
	return 1;
}
public OnPlayerClickPlayerTextDraw(playerid,PlayerText:playertextid)
{
    new string[256];
    if(playertextid == PlayerText:65535)
    {
	    for(new sm=1;sm<MAX_SMARKETS;sm++)
	   	{
		   	if(SmarkInfo[sm][screatet] == 1)
		   	{
			   	for(new i=0;i<sizeof(sBuyInfo);i++)
				{
					if(IsPlayerInRangeOfPoint(playerid,1.5,sBuyInfo[i][sbuyx],sBuyInfo[i][sbuyy],sBuyInfo[i][sbuyz]) && GetPlayerVirtualWorld(playerid) == sm)
					{
					    PlayerTextDrawHide(playerid,BUYSMARKTWEAPONdraw[playerid][0]);
						PlayerTextDrawHide(playerid,BUYSMARKTWEAPONdraw[playerid][1]);
					}
				}
			}
		}
		return 1;
	}
    if(playertextid == BUYSMARKTWEAPONdraw[playerid][0])
	{
		TogglePlayerControllable(playerid,true);
		PlayerTextDrawHide(playerid,BUYSMARKTWEAPONdraw[playerid][0]);
		PlayerTextDrawHide(playerid,BUYSMARKTWEAPONdraw[playerid][1]);
		CancelSelectTextDraw(playerid);
		PlayerTextDrawSetString(playerid,INFOdraw[playerid][0],"~b~Taste N:~n~~w~beliebigen Gegenstand kaufen");
		for(new sm=1;sm<MAX_SMARKETS;sm++)
	   	{
		   	if(SmarkInfo[sm][screatet] == 1)
		   	{
			   	for(new i=0;i<sizeof(sBuyInfo);i++)
				{
					if(IsPlayerInRangeOfPoint(playerid,1.5,sBuyInfo[i][sbuyx],sBuyInfo[i][sbuyy],sBuyInfo[i][sbuyz]) && GetPlayerVirtualWorld(playerid) == sm)
					{
						if((GetACMoney(playerid) - SmarkInfo[sm][sartikel][i]) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei!");
						if((SmarkInfo[sm][smaterials] - sBuyInfo[i][smaterialsverbrauch]) < 0)return SCM(playerid,SAMP_WEISS,"Diese Waffe ist nicht mehr im Lager vorhanden.");
						ACMoney(playerid,-SmarkInfo[sm][sartikel][i]);
					    SmarkInfo[sm][skasse] += SmarkInfo[sm][sartikel][i];
					    SmarkInfo[sm][smaterials] -= sBuyInfo[i][smaterialsverbrauch];
					    format(string,sizeof(string),""IINFO" du hast dir den Gegenstand %s für %i$ gekauft!",sBuyInfo[i][sbuyweaponname],SmarkInfo[sm][sartikel][i]);
					    SCM(playerid,SAMP_WEISS,string);
					    if(i >= sizeof(sBuyInfo)-1)
					    {
					    format(string,sizeof(string),""IINFO" das %s kannst du mit '/dpflanze' auf eine Drogenpflanze schütten.",sBuyInfo[i][sbuyweaponname]);
					    SCM(playerid,SAMP_WEISS,string);
					    SCM(playerid,SAMP_WEISS,"Es bewirkt das die Produktion von Drogen um ein Viertel verschnellert wird.");
                        Spieler[playerid][pDuenger]++;
						}
					    else GiveWeapon(playerid,sBuyInfo[i][sbuyweapon],sBuyInfo[i][sbuyammo],true);
						return 1;
					}
				}
			}
		}
		return 1;
	}
	if(playertextid == BUYSMARKTWEAPONdraw[playerid][1])
	{
		TogglePlayerControllable(playerid,true);
		PlayerTextDrawHide(playerid,BUYSMARKTWEAPONdraw[playerid][0]);
		PlayerTextDrawHide(playerid,BUYSMARKTWEAPONdraw[playerid][1]);
		CancelSelectTextDraw(playerid);
		PlayerTextDrawSetString(playerid,INFOdraw[playerid][0],"~b~Taste N:~n~~w~beliebigen Gegenstand kaufen");
		return 1;
	}
	return 1;
}
public OnPlayerClickTextDraw(playerid,Text:clickedid)
{
	if(clickedid == TD_LOGIN[17])
	{
		new query[128];
		SpamChat(playerid,0);
		format(query,sizeof(query),"SELECT * FROM spieler WHERE Name = '%s'",SpielerName(playerid));
		mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,a_script_user,playerid,MySQL_R394);
		CancelSelectTextDraw(playerid);
		HideLoginScreen(playerid);
		return 1;
	}
 	if(clickedid == TD_LOGIN[18])//Serverstatus
	{
		strdel(edit_2,0,sizeof(edit_2));
		strcat(edit_2,""HTML_WEISS"Teamspeak 3: "#HTML_GRUEN"(ONLINE) "#HTML_WEISS"IP: "IINFO2""Teamspeak3"\n");
		strcat(edit_2,""HTML_WEISS"Forum: "#HTML_GRUEN"(ONLINE) "#HTML_WEISS"Adresse: "IINFO2""Forum"\n");
		strcat(edit_2,""HTML_WEISS"User Control Panel: "#HTML_ROT"(OFFLINE) "#HTML_WEISS"Grund: "HTML_ROT"In Programmierung\n");
		ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Serverstatus",edit_2,"Okay","");
		return 1;
	}
	if(clickedid == TD_LOGIN[12])//Serverinformationen
	{
		strdel(edit_2,0,sizeof(edit_2));
		strcat(edit_2,""HTML_WEISS"Projektleiter:"#IINFO2" AdamRuzek | Cryless\n");
		strcat(edit_2,""HTML_WEISS"Scripter:"#IINFO2" require aka. MinzGaming\n");
		strcat(edit_2,""HTML_WEISS"Mapper:"#IINFO2" Derzeit keinen\n");
		strcat(edit_2,""HTML_WEISS"Coder (UCP):"#IINFO2" require aka. MinzGaming\n");
		strcat(edit_2,""HTML_WEISS"Version:"#IINFO2" 1.6.6\n");
		strcat(edit_2,""HTML_WEISS"MySQLVersion:"#IINFO2" R39-5\n");
		strcat(edit_2,""HTML_WEISS"Scrip Zeilen:"#IINFO2" -/-\n");
		ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Serverinformationen",edit_2,"Okay","");
		return 1;
	}
 	if(clickedid == Text:65535)
	{
		if(Spieler[playerid][AmUmkleiden] == 1)
		{
			return SelectTextDraw(playerid,GRAU);
		}
	}
	new query[256],string[1000];
	if(clickedid == Skinauswahl[8])//skin nach hinten wechseln
	{
		if(Spieler[playerid][AmUmkleiden] == 1)
	 	{
		    if(GetPlayerVirtualWorld(playerid) != 0)
		    {
			    Spieler[playerid][Skin]--;
			    if(Spieler[playerid][Skinchange] == 1 || ImTutorial[playerid] != 0)
				{
					if(Spieler[playerid][pDuty] <= 0)
					{
					    if(Spieler[playerid][Skin] < 0) Spieler[playerid][Skin] = sizeof(BincoSystemZiviSkins);
					    SetPlayerSkin(playerid,BincoSystemZiviSkins[Spieler[playerid][Skin]][Skinid]);
					    format(query,sizeof(query),"SELECT * FROM spieler WHERE SkinID='%d' OR FraktionSkinID='%d'",GetPlayerSkin(playerid),GetPlayerSkin(playerid));
					    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,a_script_binco,playerid,MySQL_R394);
						return 1;
					}
				}
			}
		    if(Spieler[playerid][FSkinchange] == 1)
			{
			    if(Spieler[playerid][Skin] >= 0 && isPlayerInFrakt(playerid,BincoSystemFraktionsSkins[Spieler[playerid][Skin]][Fraktid]))
				{
					SetPlayerSkin(playerid,BincoSystemFraktionsSkins[Spieler[playerid][Skin]][Skinid]);
				}
				else
				{
					new skincounter = 0;
					for(new i=0;i<sizeof(BincoSystemFraktionsSkins);i++)
					{
						if(isPlayerInFrakt(playerid,BincoSystemFraktionsSkins[i][Fraktid]))
						{
							skincounter = i;
						}
					}
					Spieler[playerid][Skin] = skincounter;
					SetPlayerSkin(playerid,BincoSystemFraktionsSkins[skincounter][Skinid]);
				}
			    format(query,sizeof(query),"SELECT * FROM spieler WHERE SkinID='%d' OR FraktionSkinID='%d'",GetPlayerSkin(playerid),GetPlayerSkin(playerid));
			    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,a_script_binco,playerid,MySQL_R394);
			    return 1;
	  		}
	   	}
	}
	if(clickedid == Skinauswahl[7])//skin nach vorne wechseln
	{
	    if(Spieler[playerid][AmUmkleiden] == 1)
	 	{
		    if(GetPlayerVirtualWorld(playerid) != 0)
		    {
		    	Spieler[playerid][Skin]++;
			    if(Spieler[playerid][Skinchange] == 1 || ImTutorial[playerid] != 0)
				{
					if(Spieler[playerid][pDuty] == 0)
					{
					    if(Spieler[playerid][Skin] >= sizeof(BincoSystemZiviSkins)) Spieler[playerid][Skin] = 0;
					    SetPlayerSkin(playerid,BincoSystemZiviSkins[Spieler[playerid][Skin]][Skinid]);
						format(query,sizeof(query),"SELECT * FROM spieler WHERE SkinID='%d' OR FraktionSkinID='%d'",GetPlayerSkin(playerid),GetPlayerSkin(playerid));
					    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,a_script_binco,playerid,MySQL_R394);
						return 1;
					}
				}
			}
		    if(Spieler[playerid][FSkinchange] == 1)
			{
			    if(Spieler[playerid][Skin] >= sizeof(BincoSystemFraktionsSkins))
			    {
			        for(new i=0;i<sizeof(BincoSystemFraktionsSkins);i++)
					{
						if(!isPlayerInFrakt(playerid,BincoSystemFraktionsSkins[i][Fraktid]))
						{
							Spieler[playerid][Skin] = i;
						}
					}
			    }
				if(!isPlayerInFrakt(playerid,BincoSystemFraktionsSkins[Spieler[playerid][Skin]][Fraktid]))
				{
					for(new i=0;i<sizeof(BincoSystemFraktionsSkins);i++)
					{
						if(isPlayerInFrakt(playerid,BincoSystemFraktionsSkins[i][Fraktid]))
						{
							Spieler[playerid][Skin] = i;
							SetPlayerSkin(playerid,BincoSystemFraktionsSkins[i][Skinid]);
							break;
						}
					}
				}
				else
				{
					SetPlayerSkin(playerid,BincoSystemFraktionsSkins[Spieler[playerid][Skin]][Skinid]);
				}
			    format(query,sizeof(query),"SELECT * FROM spieler WHERE SkinID='%d' OR FraktionSkinID='%d'",GetPlayerSkin(playerid),GetPlayerSkin(playerid));
			    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,a_script_binco,playerid,MySQL_R394);
			    return 1;
		   	}
	   	}
	}
	if(clickedid == Skinauswahl[9])//skin bestätigen
	{
		CancelSelectTextDraw(playerid);
	    if(Spieler[playerid][AmUmkleiden] == 1)
	 	{
			if(GetPlayerVirtualWorld(playerid) != 0)
			{
				if(ImTutorial[playerid] != 0)
				{
				    //Show_Informationen(playerid);
					SetPVarInt(playerid,"Eingeloggt",1);
					SetPlayerColor(playerid,SAMP_WEISS);
					HideBinco(playerid);
				  	PlayerTextDrawHide(playerid,BINCOplayerdraw[playerid]);
					SetCameraBehindPlayer(playerid);
					TogglePlayerControllable(playerid,true);
					Spieler[playerid][Skin] = 0;
					Spieler[playerid][pSkin] = GetPlayerSkin(playerid);
					ImTutorial[playerid] = 0;
					Spieler[playerid][pTutorialTime] = 0;
					Spieler[playerid][AmUmkleiden] = 0;
					Spieler[playerid][pBank] = 0;
					Spieler[playerid][pRollerLic] = 1;
					SetPlayerFightingStyle(playerid,FIGHT_STYLE_NORMAL);
					SetPlayerLevel(playerid,1);
					Spieler[playerid][pMinutesAfterPayday] = 0;
					Spieler[playerid][pTimeAfterRegister] = 0;
					Spieler[playerid][pRespektFromPayday] = 0;
					//Spieler[playerid][pTutorialObject][3] = CreatePlayerObject(playerid,19394,778.75,-2899.57,0.84, 0.00,0.00,0.00,1);
					StopAudioStreamForPlayer(playerid);
					SetPlayerPosEx(playerid,3562.4568,-987.5737,618.4721);
					SetPlayerFacingAngle(playerid,358.8263);
					SetPlayerInterior(playerid,0);
					SetPlayerVirtualWorld(playerid,100+playerid);
					Spieler[playerid][pTutMissionComplete][0] = true;
					SetPlayerCheckpoint(playerid,3562.4568,-987.5737,618.4721,3.0);
					SetPlayerWaffenSkill(playerid);
					SaveAccount(playerid);
				    if(GetPlayerLevel(playerid) <= ENABLE_KILLORPAY_BYLEVEL)
					{
					}
					//ShowPlayerDialog(playerid,DIALOG_REGISTER_GEWORBEN,DIALOG_STYLE_INPUT,""ClanTagDialoge" User werben User","{C9C9C9}Wurdest du auf unserem Server geworben.\nWenn ja von wem ?\nDu und der angegebene Spieler erhaltet sobald du Level 3 und 5 erreicht hast Donatorpaydays !\nSprich man erhält 2 Respektpunkte mehr als gewöhnlich.\n"#HTML_BLAU"Wichtig{C9C9C9}: Der angegebene Spieler muss registriert sein!","Absenden","Niemand");
				    return 1;
				}
				if(Spieler[playerid][Skinchange] == 1)
				{
					if((GetACMoney(playerid) - BincoSystemZiviSkins[Spieler[playerid][Skin]][SkinPreis]) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei.");
					SCM(playerid,SAMP_WEISS,""IINFO" du hast deinen Skin gewechselt.");
					ACMoney(playerid,-BincoSystemZiviSkins[Spieler[playerid][Skin]][SkinPreis]);
					HideBinco(playerid);
				  	PlayerTextDrawHide(playerid,BINCOplayerdraw[playerid]);
					SetCameraBehindPlayer(playerid);
					SetPlayerVirtualWorld(playerid,0);
					TogglePlayerControllable(playerid,true);
					Spieler[playerid][Skin] = 0;
					Spieler[playerid][Skinchange] = 0;
					Spieler[playerid][AmUmkleiden] = 0;
					Spieler[playerid][pSkin] = GetPlayerSkin(playerid);
					SaveAccount(playerid);
					return 1;
				}
				if(Spieler[playerid][FSkinchange] == 1)
				{
				SCM(playerid,SAMP_WEISS,""IINFO" du hast deinen FraktionsSkin gewechselt.");
				HideBinco(playerid);
			  	PlayerTextDrawHide(playerid,BINCOplayerdraw[playerid]);
				SetCameraBehindPlayer(playerid);
				SetPlayerVirtualWorld(playerid,0);
				TogglePlayerControllable(playerid,true);
				Spieler[playerid][Skin] = 0;
				Spieler[playerid][FSkinchange] = 0;
				Spieler[playerid][AmUmkleiden] = 0;
				Spieler[playerid][pFraktSkin] = GetPlayerSkin(playerid);
				if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
				{
					for(new gw;gw<sizeof(GangwarZones);gw++)
					{
						GangZoneShowForPlayer(playerid,GangwarZones[gw][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gw][War_Owner]));
						if(GangwarZones[gw][War_Started] == 1)
						{
						    if(isPlayerInFrakt(playerid,GangwarZones[gw][War_Owner]) || isPlayerInFrakt(playerid,GangwarZones[gw][War_Attacker]) && GangwarZones[gw][War_Started] == 1)
							{
								TextDrawShowForPlayer(playerid,GangwarZones[gw][WARdraw][0]);
								TextDrawShowForPlayer(playerid,GangwarZones[gw][WARdraw][1]);
								TextDrawShowForPlayer(playerid,GangwarZones[gw][WARdraw][2]);
								TextDrawShowForPlayer(playerid,GangwarZones[gw][WARdraw][3]);
							 	TextDrawShowForPlayer(playerid,GangwarZones[gw][WARdraw][4]);
							 	TextDrawShowForPlayer(playerid,GangwarZones[gw][WARdraw][5]);
							 	TextDrawShowForPlayer(playerid,GangwarZones[gw][WARdraw][6]);
							 	TextDrawShowForPlayer(playerid,GangwarZones[gw][WARdraw][7]);
							 	TextDrawShowForPlayer(playerid,GangwarZones[gw][WARdraw][8]);
								GangZoneFlashForPlayer(playerid,GangwarZones[gw][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gw][War_Attacker]));
						    }
						    else
							{
								TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][0]);
								TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][1]);
								TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][2]);
								TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][3]);
							 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][4]);
							 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][5]);
							 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][6]);
							 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][7]);
							 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][8]);
								GangZoneHideForPlayer(playerid,GangwarZones[gw][War_ZoneID]);
							}
					    }
				 	}
				}
				else
				{
					for(new gw;gw<sizeof(GangwarZones);gw++)
					{
						TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][0]);
						TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][1]);
						TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][2]);
						TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][3]);
					 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][4]);
					 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][5]);
					 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][6]);
					 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][7]);
					 	TextDrawHideForPlayer(playerid,GangwarZones[gw][WARdraw][8]);
						GangZoneHideForPlayer(playerid,GangwarZones[gw][War_ZoneID]);
					}
				}
				if(Spieler[playerid][ImInvite] == 1)
				{
					format(string,sizeof(string),"SELECT * FROM server_fnachicht WHERE fID='%d'",Spieler[playerid][pFraktion]);
					mysql_function_query(MySQL_R394,string,true,"sql_array2","siii",string,db_script_fmessage,playerid,MySQL_R394);
					SetPlayerColor(playerid,SAMP_WEISS);
					SetPlayerPosEx(playerid,Spieler[playerid][LastInGamePos_x],Spieler[playerid][LastInGamePos_y],Spieler[playerid][LastInGamePos_z]);
					SetPlayerInterior(playerid,Spieler[playerid][LastInGamePos_int]);
					SetPlayerVirtualWorld(playerid,Spieler[playerid][LastInGamePos_world]);
					Spieler[playerid][ImInvite] = 0;
					Spieler[playerid][pDuty] = 0;
					switch(Spieler[playerid][pFraktion])
					{
					    case 1:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);SCM(playerid,SAMP_WEISS,"");}//SAPD
					    case 2:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);SCM(playerid,SAMP_WEISS,"");}//FBI
					    case 3:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);SCM(playerid,SAMP_WEISS,"");}//MEDIC
					    case 4:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);SCM(playerid,SAMP_WEISS,"");}//LSV
					    case 5:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);SCM(playerid,SAMP_WEISS,"");}//GSF
					    case 6:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);SCM(playerid,SAMP_WEISS,"");}//ARMY
					    case 7:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);SCM(playerid,SAMP_WEISS,"");}//BALLAS
					    case 8:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);SCM(playerid,SAMP_WEISS,"");}//TERRORS
					    case 9:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);SCM(playerid,SAMP_WEISS,"");}//YAKUZA
					    case 10:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);SCM(playerid,SAMP_WEISS,"");}//SANEWSAG
					    case 11:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);SCM(playerid,SAMP_WEISS,"");}//OAMT
					    case 12:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);SCM(playerid,SAMP_WEISS,"");}//LCN
					    case 13:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);SCM(playerid,SAMP_WEISS,"");}//Sons of Anarchy
					    case 14:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);SCM(playerid,SAMP_WEISS,"");}//FAHRSCHULE
					    case 15:{SetPlayerSkin(playerid,Spieler[playerid][pSkin]);SCM(playerid,SAMP_WEISS,"");}//SA ELEKTRONIK GmBh
					    case 16:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);SCM(playerid,SAMP_WEISS,"");}//Regierung
					    case 17:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);SCM(playerid,SAMP_WEISS,"");}//Sureño Syndikat
					    case 18:{SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);SCM(playerid,SAMP_WEISS,"");}//Die Sekte
					}
				}
				SaveAccount(playerid);
				return 1;
				}
		 	}
	 	}
	}
	return 1;
}
