	if(sscanf(params,"s[90]",motto))return SCM(playerid,SAMP_WEISS,""IINFO" /firmbeschreibung [Motto]");
	if(strlen(motto) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /firmbeschreibung [text]");
