					return SCM(playerid,SAMP_WEISS,"Gebe nur Zahlen ein!");
				}
				else
				{
				    HausInfo[MakeHaus[playerid]][haus_level] = buylevel;
				    //format(string,sizeof(string),"Hauserstellungs Fortschritt:\nPreis: %i$\nLevel zum kauf: %i\nGebe nun die Slots an Mietern ein,\ndie sich ins Haus einmieten können:",HausInfo[MakeHaus[playerid]][haus_preis],HausInfo[MakeHaus[playerid]][haus_level]);
				    ShowPlayerDialog(playerid,HCREATE_DIALOG_HAUSSLOTS,DIALOG_STYLE_INPUT,""ClanTagDialoge" Hauserstellung -> Mieter",""#HTML_WEISS"Wie viele Mieter darf das Haus maximal haben?","Weiter","Zurück");
				    UpdateHausLabel(MakeHaus[playerid],1);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
					return 1;
				}
			}
		}
		case HCREATE_DIALOG_HAUSSLOTS:
		{
			new homestorestring[600],mieter = strval(inputtext);
			if(response == 0)
		    {
			    //format(string,sizeof(string),"Hauserstellungs Fortschritt:\nPreis: %i$\nGebe nun das Level ein,\ndass man benötigt um das Haus zu kaufen:",HausInfo[MakeHaus[playerid]][haus_preis]);#
			    //ShowPlayerDialog(playerid,HCREATE_DIALOG_BUYLEVEL,DIALOG_STYLE_INPUT,""ClanTagDialoge" Hauserstellung -> Level",""#HTML_WEISS"Gebe nun das Level ein.","Weiter","Zurück");
   				ShowPlayerDialog(playerid,HCREATE_DIALOG_PREIS,DIALOG_STYLE_INPUT,""ClanTagDialoge" Hauserstellung -> Preis",""#HTML_WEISS"Gib den Preis an,\nfür den das Haus zum verkauf freigestellt werden soll","Weiter","Haus löschen");
