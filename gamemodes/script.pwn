COMMAND:freilassen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],pID,reason[31];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6))
	{                              //sapd  zellen seite 1                                             //sapd zellen seite 2                                    //alka                                                              //fbi einjail punkt
		if(IsPlayerInRangeOfPoint(playerid,15,194.9551,158.5136,1003.0234) || IsPlayerInRangeOfPoint(playerid,15,194.1721,179.3675,1003.0234) || IsPlayerInRangeOfPoint(playerid,15,2581.0930,-1288.2515,1044.1250) || IsPlayerInRangeOfPoint(playerid,15,221.5675,113.1803,999.0156))
	    {
			if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
			if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		    if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /freilassen [playerid/Name][Grund]");
		    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /freilassen [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
			if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
		    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
			if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
			if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst aus dem Gefängnis entlassen.");
			if(Spieler[pID][pJailed] == 0)return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht im Gefängnis.");
			if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
			switch(Spieler[pID][pJailed])
			{
				case 1:
				{
					SetPlayerPosEx(pID,1758.0619,-1645.6868,13.4559);
					SetPlayerInterior(pID,0);
					SetPlayerVirtualWorld(pID,0);
				}
				case 2:
				{
					SetPlayerPosEx(pID,-2160.9009,1352.4110,7.8327);
					SetPlayerInterior(pID,0);
					SetPlayerVirtualWorld(pID,0);
				}
				case 3:
				{
					SetPlayerPosEx(pID,1050.6272,1183.8065,10.8203);
					SetPlayerInterior(pID,0);
					SetPlayerVirtualWorld(pID,0);
				}
			}
			Spieler[pID][pJailed] = 0;
			Spieler[pID][pJailTime] = 0;
			Spieler[pID][pKaution] = 0;
			format(string,sizeof(string),"%s %s hat dich aus dem Gefängnis entlassen. Grund: %s ",SpielerFraktionsRangName(playerid),SpielerName(playerid),reason);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"%s %s hat den Verdächtigen %s aus dem Gefängnis entlassen. Grund: %s ",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID),reason);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
				   	if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,16))
				   	{
				   		SCM(i,SAMP_WEISS,string);
				   	}
			   	}
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht an den Zellen.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:afreilassen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	new string[128],pID,reason[31];
	if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
 	if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /freilassen [playerid/Name][Grund]");
 	if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /afreilassen [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
 	if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst aus dem Gefängnis entlassen.");
	if(Spieler[pID][pJailed] == 0)return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht im Gefängnis.");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	switch(Spieler[pID][pJailed])
	{
		case 1:
		{
			SetPlayerPosEx(pID,1758.0619,-1645.6868,13.4559);
			SetPlayerInterior(pID,0);
			SetPlayerVirtualWorld(pID,0);
		}
		case 2:
		{
			SetPlayerPosEx(pID,-2160.9009,1352.4110,7.8327);
			SetPlayerInterior(pID,0);
			SetPlayerVirtualWorld(pID,0);
		}
		case 3:
		{
			SetPlayerPosEx(pID,1050.6272,1183.8065,10.8203);
			SetPlayerInterior(pID,0);
			SetPlayerVirtualWorld(pID,0);
		}
	}
	Spieler[pID][pJailed] = 0;
	Spieler[pID][pJailTime] = 0;
	Spieler[pID][pKaution] = 0;
	format(string,sizeof(string),"%s %s hat dich aus dem Gefängnis entlassen. Grund: %s ",Adminrang(playerid),SpielerName(playerid),reason);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),"%s %s hat den Verdächtigen %s aus dem Gefängnis entlassen. Grund: %s ",Adminrang(playerid),SpielerName(playerid),SpielerName(pID),reason);
	SendAdminMessage(SAMP_WEISS,string);
	return 1;
}

COMMAND:einsperren(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new kaution,pID,string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6))
	{                             //sapd  zellen seite 1                                             //sapd zellen seite 2                                    //alka                                                              //fbi einjail punkt
		if(IsPlayerInRangeOfPoint(playerid,15,194.9551,158.5136,1003.0234) || IsPlayerInRangeOfPoint(playerid,15,194.1721,179.3675,1003.0234) || IsPlayerInRangeOfPoint(playerid,15,2581.0930,-1288.2515,1044.1250) || IsPlayerInRangeOfPoint(playerid,15,221.5675,113.1803,999.0156))
	    {
		    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
			if(sscanf(params,"ui",pID,kaution))return SCM(playerid,SAMP_WEISS,""IINFO" /einsperren [playerid/Name][Kaution 1 = gestellt,2 = nicht gestellt]");
			if(kaution<1||kaution>2)return SCM(playerid,SAMP_WEISS,""IINFO" /einsperren [playerid/Name][Kaution 1 = gestellt,2 = nicht gestellt]");
			if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
		    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
			if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
			if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst ins Gefängnis einsperren.");
			if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
			if(Spieler[pID][pJailed] != 0)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits im Gefängnis.");
			if(Spieler[pID][pWantedPoints] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keine Wanteds.");
			if(kaution == 1){Spieler[pID][pJailTime] = Spieler[pID][pWantedPoints]*30; Spieler[pID][pKaution] = 1;}
			else Spieler[pID][pJailTime] = Spieler[pID][pWantedPoints]*45; Spieler[pID][pKaution] = 2;
		    if(IsPlayerInRangeOfPoint(pID,15,194.9551,158.5136,1003.0234) || IsPlayerInRangeOfPoint(pID,15,194.1721,179.3675,1003.0234)) Spieler[pID][pJailed] = 1;
			if(IsPlayerInRangeOfPoint(pID,15,221.5675,113.1803,999.0156)) Spieler[pID][pJailed] = 3;
		    if(IsPlayerInRangeOfPoint(pID,15,2581.0930,-1288.2515,1044.1250)) Spieler[pID][pJailed] = 2;
		    format(string,sizeof(string),""IINFO" du hast den Gesuchten %s eingesperrt. Wert: %i$",SpielerName(pID),Spieler[pID][pWantedPoints] * 5);
			SCM(playerid,SAMP_WEISS,string);
			SendClientMessageToAll(SAMP_WEISS,"*----------[ "#HTML_ROT"Goverment Meldung"#HTML_WEISS" ]----------*");
			format(string,sizeof(string),"%s %s hat den Gesuchten %s eingesperrt!",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
			SendClientMessageToAll(0x00489184,string);
			ACMoney(pID,-Spieler[pID][pWantedPoints] * 5);
			fverwaltungen[16][Geld] += Spieler[pID][pWantedPoints] * 5;
			Spieler[pID][pWantedPoints] = 0;
			SetPlayerWantedLevel(pID,0);
			Spieler[pID][pJailedCount]++;
			SpawnPlayerEx(pID);
			format(string,sizeof(string),"HQ: An alle Einheiten, %s %s hat die gesuchte Person %s eingesperrt.",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,16))
					{
						SCM(i,0x000FFF87,string);
					}
				}
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,"Nicht an den Zellen.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:oeinsperren(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6))
	{
		for(new oi=1;oi<MAX_OFFLINEPICKUPS;oi++)
		{
		    if(OfflineInfo[oi][Ocreated] == true)
		    {
			    if(IsPlayerInRangeOfPoint(playerid,1.5,OfflineInfo[oi][Opos][0],OfflineInfo[oi][Opos][1],OfflineInfo[oi][Opos][2]) && GetPlayerVirtualWorld(playerid) == OfflineInfo[oi][Ovirtualworld])
				{
				    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
					if(OfflineInfo[oi][Owanteds] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keine Wanteds.");
					format(string,sizeof(string),""IINFO" du hast den Gesuchten %s (Offline-)eingesperrt. Wert: %i$",OfflineInfo[oi][Oname],OfflineInfo[oi][Owanteds] * 5);
					SCM(playerid,SAMP_WEISS,string);
					format(string,sizeof(string),"Er/Sie muss eine %i sekündige Strafe absitzen.",OfflineInfo[oi][Owanteds] * 45);
					SCM(playerid,SAMP_WEISS,string);
					format(string,sizeof(string),"<< %s %s hat den Gesuchten %s (Offline-)eingesperrt >>",SpielerFraktionsRangName(playerid),SpielerName(playerid),OfflineInfo[oi][Oname]);
					SendClientMessageToAll(WANTEDDEATHERROT,string);
					fverwaltungen[16][Geld] += OfflineInfo[oi][Owanteds] * 5;
					format(string,sizeof(string),"SELECT * FROM spieler WHERE Name = '%s'",OfflineInfo[oi][Oname]);
				    mysql_function_query(MySQL_R394,string,true,"sql_array2","siii",string,_SQL_OFFLINEARREST,oi,MySQL_R394);
					format(string,sizeof(string),"HQ: An alle Einheiten, %s %s hat die gesuchte Person %s eingesperrt.",SpielerFraktionsRangName(playerid),SpielerName(playerid),OfflineInfo[oi][Oname]);
					ForEachPlayer(i)
					{
						if(IsPlayerConnected(i))
						{
							if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,16))
							{
								SCM(i,0x000FFF87,string);
							}
						}
					}
					return 1;
				}
			}
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier Niemanden Offline einsperren.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:orten(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,nummer,ortungsstring[128],Float:x,Float:y,Float:z;
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,16))
	{
		if(Spieler[playerid][pOrtungsgeraet] == 0)return SCM(playerid,SAMP_WEISS,"Kein Ortungsgerät dabei.");
		if(sscanf(params,"i",nummer))return SCM(playerid,SAMP_WEISS,""IINFO" /orten [Handynummer]");
		if(IsHandyNummerEnable(nummer) == -1)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
		pID = IsHandyNummerEnable(nummer);
		format(ortungsstring,sizeof(ortungsstring),""IINFO" du versuchst %s (ID:%i) zu orten...",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,ortungsstring);
		if(Spieler[pID][pHandy] == 0)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
		if(Spieler[pID][pHandystate] == 0)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
		if(Spieler[pID][pDeath] == 1)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
		if(Spieler[pID][pFriedhof] == 1)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
		format(ortungsstring,sizeof(ortungsstring),""IINFO" du hast %s (ID:%i) geortet. Nutze '/delcheck' um den Checkpoint zu entfernen.",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,ortungsstring);
		KillTimer(SpielerOrtenTimer[playerid]);
		GetPlayerPos(pID,x,y,z);
		SetPlayerCheckpoint(playerid,x,y,z,3);
		Spieler[playerid][pOrtenVehORPlayer] = 1;//1 playerid 2 veh 3 service accept
	    Spieler[playerid][pOrtenVehIDplayerid] = pID;
		SpielerOrtenTimer[playerid] = SetTimerEx("SpielerOderFahrzeugOrten",1000,true,"iii",playerid,pID,1);
		Spieler[playerid][pIsearch] = 1;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:ortenveh(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid,ortungsstring[128],Float:x,Float:y,Float:z;
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,16))
	{
		if(Spieler[playerid][pOrtungsgeraet] == 0)return SCM(playerid,SAMP_WEISS,"Kein Ortungsgerät dabei.");
		if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" /ortenveh [vehicleid]");
		if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug nicht ortbar.");
		format(ortungsstring,sizeof(ortungsstring),""IINFO" du hast einen %s [Fahrzeugid:%i] geortet. Nutze '/delcheck' um den Checkpoint zu entfernen.",VehicleDefinations[GetVehicleModel(vehicleid)-400],vehicleid);
		SCM(playerid,SAMP_WEISS,ortungsstring);
		KillTimer(SpielerOrtenTimer[playerid]);
		GetVehiclePos(vehicleid,x,y,z);
		SetPlayerCheckpoint(playerid,x,y,z,3);
		Spieler[playerid][pOrtenVehORPlayer] = 2;//1 playerid 2 veh 3 service accept
	    Spieler[playerid][pOrtenVehIDplayerid] = vehicleid;
		SpielerOrtenTimer[playerid] = SetTimerEx("SpielerOderFahrzeugOrten",1000,true,"iii",playerid,vehicleid,2);
		Spieler[playerid][pIsearch] = 1;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:bounce(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(isPlayerInFrakt(playerid,1)|| isPlayerInFrakt(playerid,2)|| isPlayerInFrakt(playerid,6))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
	    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /bounce [playerid/Name]");
	    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst das nicht!");
	    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(!ProxDetectorS(3.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    if(!IsPlayerInAnyVehicle(pID))return SCM(playerid,SAMP_WEISS,"Spieler sitzt in keinem Fahrzeug.");
	    if(GetPlayerVehicleSeat(pID) != 0)return SCM(playerid,SAMP_WEISS,"Spieler nicht der Fahrer des Fahrzeugs.");
		RemovePlayerFromVehicle(pID);
	    format(string,sizeof(string),""IINFO" du hast %s aus dem Fahrzeug geworfen.",SpielerName(pID));
	    SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"** %s wurde von %s überwältigt und aus dem Fahrzeug geworfen **",SpielerName(pID),SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
    return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:grab(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,seatid,string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	    if(sscanf(params,"ui",pID,seatid))return SCM(playerid,SAMP_WEISS,""IINFO" /grab [playerid/Name][Sitzplatz]");
	    if(seatid<1||seatid>3)return SCM(playerid,SAMP_WEISS,"Sitzplätze bitte nur zwischen 1-3.");
	    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(Spieler[pID][pTazerd] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht getazer.");
	    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    if(IsPlayerInAnyVehicle(pID))return SCM(playerid,SAMP_WEISS,"Spieler ist bereits in einem Fahrzeug!");
	    SetPlayerSpecialAction(pID,SPECIAL_ACTION_CUFFED);
	    SetPlayerAttachedObject(pID,0,19418,6,-0.011000,0.028000,-0.022000,-15.600012,-33.699977,-81.700035,0.891999,1.000000,1.168000);
	    TogglePlayerControllable(pID,false);
	    KillTimer(TazerTimer[pID]);
	    Spieler[pID][pTazerd] = 0;
	    Spieler[pID][pCuffed] = 1;
	    PutPlayerInVehicleEx(pID,GetPlayerVehicleID(playerid),seatid);
	    format(string,sizeof(string),"%s hat dich ins Fahrzeug gezogen,sodass du dich nicht bewegen kannst.",SpielerName(playerid));
	    SCM(pID,SAMP_WEISS,string);
	    format(string,sizeof(string),""IINFO" du hast %s ins Fahrzeug gezogen,sodass er sich nicht bewegen kann.",SpielerName(pID));
	    SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"** %s zieht %s ins Fahrzeug **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
    return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:gov(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],text[91];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,16))
	{
 		if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(Spieler[playerid][pMuted] == 1)
		{
		 	format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
			return SCM(playerid,WEISS,string);
		}
		if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /gov(erment) [Text]");
		if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /gov(erment) [Text darf maximal 90 Zeichen beinhalten]");
		for(new i=0;i<sizeof(BadWord);i++)
		{
			if(strfind(text,BadWord[i],true) != -1)
		  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(ROT,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /gov(erment)",BadWord[i],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
		    }
		}
		new strpos = strfind(text,"www",true);
		if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
		{
			strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
			return 1;
		}
		SendClientMessageToAll(SAMP_WEISS,"*----------[ "#HTML_ROT"Goverment Meldung"#HTML_WEISS" ]----------*");
		format(string,sizeof(string),"%s %s: %s",FraktionsName(Spieler[playerid][pFraktion]),Spieler[playerid][pName],text);
		SendClientMessageToAll(0x00489184,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:cs(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],text[91],fv = IsAFraktionsVeh(playerid);
	if(isPlayerInFrakt(playerid,2))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(Spieler[playerid][pMegaphon] != 0 || fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		{
			if(Spieler[playerid][pMuted] == 1)
			{
			 	format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
				return SCM(playerid,WEISS,string);
			}
			if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /cs(egaphone) [Text]");
			if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /cs(cs megaphone) [Text darf maximal 90 Zeichen beinhalten]");
			for(new b=0;b<sizeof(BadWord);b++)
			{
				if(strfind(text,BadWord[b],true) != -1)
			  	{
				  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
				   	SendClientMessageToAll(SAMP_WEISS,string);
					format(string,sizeof(string),"Beleidigung: %s | %s | Art: /cs(Megaphone)",BadWord[b],text);
					SendAdminMessage(SAMP_WEISS,string);
				    Spieler[playerid][pMuteTime] += 15*60;
					Spieler[playerid][pMuted] = 1;
					return 1;
			    }
			}
			new strpos = strfind(text,"www",true);
			if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
			{
				strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
				return 1;
			}
			format(string,sizeof(string),"*"#HTML_ROT"[ "#HTML_WEISS"Crime Scene Investigation "#HTML_ROT"]"#HTML_WEISS"* %s: %s",SpielerName(playerid),text);
			PlayerTalkPublic(playerid,SAMP_WEISS,string,75);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du trägst kein Megaphon mit dir./Du sitzt in keinem Fraktionsfahrzeug.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
