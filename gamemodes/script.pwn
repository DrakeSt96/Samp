COMMAND:tban(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,reason[31],zeit,string[256],cmd[15],zeitdauer;
 	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
  	if(sscanf(params,"uds[15]s[31]",pID,zeit,cmd,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /tban [playerid/Name][Zeit][Minuten/Stunden/Tage/Wochen][Grund]");
    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /tban [playerid/Name][Zeit][Minuten/Stunden/Tage][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[playerid][pAdmin] == 2)
	{
		if(Spieler[pID][pAdmin] > Spieler[playerid][pAdmin])return SCM(playerid,SAMP_WEISS,""IINFO" du kannst keine Ranghöherern Admins Bannen!");
	}
	if(strcmp(cmd,"Wochen",true) == 0)
	{
		zeitdauer = gettime()+(60*60*24*7*zeit);//in wochen
	    format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) für %i Woche/n gebannt. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,zeit,reason);
		SendClientMessageToAll(SAMP_WEISS,string);
		format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\nDauer: %i Woche/n\nGrund: %s\nAdmin: %s\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[pID][pName],zeit,reason,Spieler[playerid][pName]);
		ShowPlayerDialog(pID,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
		BanUser(pID,Spieler[playerid][pName],reason,zeitdauer);
		return 1;
	}
    if(strcmp(cmd,"Tage",true) == 0)
	{
		zeitdauer = gettime()+(60*60*24*zeit);//in tagen
	    format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) für %i Tag/e gebannt. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,zeit,reason);
		SendClientMessageToAll(SAMP_WEISS,string);
		format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\nDauer: %i Tag/e\nGrund: %s\nAdmin: %s\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[pID][pName],zeit,reason,Spieler[playerid][pName]);
		ShowPlayerDialog(pID,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
		BanUser(pID,Spieler[playerid][pName],reason,zeitdauer);
		return 1;
	}
	if(strcmp(cmd,"Stunden",true) == 0)
	{
		zeitdauer = gettime()+(60*60*zeit);//in stunden
	    format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) für %i Stunde/n gebannt. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,zeit,reason);
		SendClientMessageToAll(SAMP_WEISS,string);
		format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\nDauer: %i Stunde/n\nGrund: %s\nAdmin: %s\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[pID][pName],zeit,reason,Spieler[playerid][pName]);
		ShowPlayerDialog(pID,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
		BanUser(pID,Spieler[playerid][pName],reason,zeitdauer);
		return 1;
	}
	if(strcmp(cmd,"Minuten",true) == 0)
	{
		zeitdauer = gettime()+(60*zeit);//in minuten
	    format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) für %i Minute/n gebannt. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,zeit,reason);
		SendClientMessageToAll(SAMP_WEISS,string);
		format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\nDauer: %i Minute/n\nGrund: %s\nAdmin: %s\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[pID][pName],zeit,reason,Spieler[playerid][pName]);
		ShowPlayerDialog(pID,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
		BanUser(pID,Spieler[playerid][pName],reason,zeitdauer);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /tban [playerid/Name][Zeit][Minuten/Stunden/Tage/Wochen][Grund]");
}
COMMAND:ban(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
   	new pID,reason[31],string[256];
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /ban [playerid/Name][Grund]");
	if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /ban [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[playerid][pAdmin] == 3)
	{
		if(Spieler[pID][pAdmin] > Spieler[playerid][pAdmin])return SCM(playerid,SAMP_WEISS,""IINFO" du kannst keine Ranghöherern Admins Bannen!");
	}
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) gebannt. Grund: %s",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,reason);
	SendClientMessageToAll(SAMP_WEISS,string);
	BanUser(pID,Spieler[playerid][pName],reason);
	HDDBan(pID);
	return 1;
}
COMMAND:unban(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new namestring[24],reason[31],query[256];
 	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
  	if(sscanf(params,"s[24]s[31]",namestring,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /unban [Spielername][Grund]");
    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /unban [Spielername][Grund darf maximal 30 Zeichen beinhalten]");
    mysql_format(MySQL_R394,query,sizeof(query),"SELECT * FROM server_bans WHERE Name='%e'",namestring);
	mysql_function_query(MySQL_R394,query,true,"sql_array","ssiiii",namestring,reason,db_script_uban,playerid,0,MySQL_R394);
 	return 1;
}

