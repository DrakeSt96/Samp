		    SetPlayerPosEx(playerid,2574.3333,-1294.8170,1054.6406);
			SetPlayerCameraPos(playerid,2577.2009,-1287.4562,1044.1250);
			SetPlayerCameraLookAt(playerid,2573.1411,-1301.0428,1044.1250);
			TogglePlayerControllable(playerid,false);
			SetPlayerInterior(playerid,2);
			SetPlayerVirtualWorld(playerid,0);
			UseCam[playerid] = 1;
			return 1;
		}
		if(strcmp(cmd,"11",true) == 0)
		{
		    SetPlayerPosEx(playerid,2562.5952,-1298.8199,1071.4879);
			SetPlayerCameraPos(playerid,2531.5913,-1285.6827,1047.9233);
			SetPlayerCameraLookAt(playerid,2562.2681,-1298.7257,1044.1250);
			TogglePlayerControllable(playerid,false);
			SetPlayerInterior(playerid,2);
			SetPlayerVirtualWorld(playerid,0);
			UseCam[playerid] = 1;
			return 1;
		}
		if(strcmp(cmd,"AUS",true) == 0)
		{
			if(UseCam[playerid] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du schaust auf keinen Bildschirm.");
			UseCam[playerid] = 0;
			SetCameraBehindPlayer(playerid);
			TogglePlayerControllable(playerid,true);
			SetPlayerPosEx(playerid,Spieler[playerid][LastInGamePos_x],Spieler[playerid][LastInGamePos_y],Spieler[playerid][LastInGamePos_z]);
		    SetPlayerVirtualWorld(playerid,0);
			SetPlayerInterior(playerid,0);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" /bildschirm [1-11 ('/bildschirm aus' um die Kamera auszuschalten)]");
	}
	return SCM(playerid,SAMP_WEISS,"Nicht am Bildschirm.");
}

COMMAND:wiederbeleben(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],pID;
 	if(isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
	    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /wiederbeleben [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst wiederbeleben.");
	    if(!ProxDetectorS(3.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    if(Spieler[pID][pDeath] == 0)return SCM(playerid,SAMP_WEISS,"Spieler muss nicht Reanimiert werden.");
		if(Spieler[pID][pRevived] == 1)return SCM(playerid,SAMP_WEISS,"Spieler muss nicht Reanimiert werden.");
		ApplyAnimation(playerid,"MEDIC","CPS",4.0,false,true,true,true,5000,SYNC_ALL);
		format(string,sizeof(string),"** %s %s beginnt mit der Reanimation **",SpielerFraktionsRangName(playerid),SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		SetTimerEx("SpielerWiederbeleben",5000,false,"ii",playerid,pID);
		format(string,sizeof(string),""IINFO" du beginnst mit der Reanimation von %s.",SpielerName(pID));
		SCM(playerid,SAMP_WEISS,string);
		SCM(playerid,SAMP_WEISS,""IINFO" du musst 5 Sekunden an dieser Position bleiben!");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:retten(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128];
	if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /retten [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(RescueState[pID] == false)return SCM(playerid,SAMP_WEISS,""IINFO" der Spieler muss nicht befreit werden!");
	if(isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6))
	{
		format(string,sizeof(string),""IINFO" du versuchst %s[ID: %i] aus dem Fahrzeug zu retten.",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s[ID: %i] versucht dich aus dem Fahrzeug zu retten.",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s versucht %s aus dem Fahrzeug zu retten. **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		if(gPlayerUsingLoopingAnim[playerid] == false && animak[playerid] == false && Spieler[playerid][RpChat] == 1 && !IsPlayerInVehicle(playerid,GetPlayerVehicleID(playerid)))
 		{
 			OnePlayAnim(playerid,"DEALER","DEALER_DEAL",4.0,0,0,0,0,0);
  			animak[playerid] = true,StopAudioStreamForPlayer(playerid);
		}
        SetTimerEx("PersonRetten",30000,false,"ii",playerid,pID);
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:rescue(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],pID;
 	if(isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6))
	{
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
		if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
		if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 416)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Krankenwagen.");
	    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /rescue [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst wiederbeleben.");
	    if(!ProxDetectorS(3.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    if(Spieler[pID][pRevived] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht in der Lage um abtransportiert zu werden.");
		new seat = GetFreeVehicleSeat(GetPlayerVehicleID(playerid));
		if((seat+1) > 4)return SCM(playerid,SAMP_WEISS,"Es sind bereits alle Krankenliegen belegt.");
		Spieler[pID][pRevived] = 0;
		StopLoopingAnim(pID);
		TogglePlayerControllable(pID,false);
		PutPlayerInVehicleEx(pID,GetPlayerVehicleID(playerid),seat+1);
		SetPlayerCheckpoint(playerid,1155.8502,-1352.2446,14.1776,1.0);
		Spieler[playerid][pIsearch] = 1;
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) in den Krankenwagen geladen.",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dich in den Krankenwagen eingeladen.",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s %s lädt %s in den Krankenwagen ein **",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:hospital(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],pID;
 	if(isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6))
	{
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
		if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
		if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 416)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Krankenwagen.");
		if(!IsPlayerInRangeOfPoint(playerid,7.5,1785.0271,-1118.7469,24.0859))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht an der Notaufnamhe.");
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /hospital [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst wiederbeleben.");
	    if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht in deinem Fahrzeug.");
		new randspawn = random(sizeof(Krankenbetten));
		SetPlayerPos(pID,Krankenbetten[randspawn][0],Krankenbetten[randspawn][1],Krankenbetten[randspawn][2]);
		SetPlayerVirtualWorld(pID,1);
		SetPlayerInterior(pID,0);
		Spieler[pID][pInHospital] = 10;
		TogglePlayerControllable(pID,false);
		ACMoney(pID,-100);
	 	fverwaltungen[16][Geld] += 100;
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) ins Krankenhaus eingewiesen.",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du wurdest von %s (ID:%i) ins Krankenhaus eingewiesen ... Du liegst nun im Koma!",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		return 1;
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:heilen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst keine Befehle nutzen, da du im Tutorial bist.");
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],fv = IsAFraktionsVeh(playerid);
	if(!isPlayerInFrakt(playerid,3))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(fv == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
	if(Fahrzeug[fv][Fraktion] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
 	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /heilen [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
   	if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht in deinem Fahrzeug.");
	if(GetPlayerACHealth(pID) == 100)return SCM(playerid,SAMP_WEISS,"Spieler muss nicht geheilt werden!");
	if((GetACMoney(pID) - 50) < 0)return SCM(playerid,SAMP_WEISS,"Spieler hat nicht genug Geld.");
	format(string,sizeof(string),"%s hat dich für 50$ geheilt.",SpielerName(playerid));
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" du hast %s für 50$ geheilt.",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,string);
 	ACMoney(pID,-50);
 	fverwaltungen[16][Geld] += 50;
	format(string, sizeof(string),"** %s %s behandelt %s im Rettungswagen **",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
   	if((GetPlayerACHealth(pID) + 50) > 100)return SetPlayerACHealth(pID,100);
	SetPlayerACHealth(pID,GetPlayerACHealth(pID)+50);
	return 1;
}

COMMAND:sellgun(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,preis,string[128],cmd[30],mats = Spieler[playerid][pMaterials];
	if(isPlayerInJob(playerid,14) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13))
	{
		if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in einem Fahrzeug.");
		if(isell[playerid] > gettime())return SCM(playerid,SAMP_WEISS,""IINFO" du kannst erst nach 10 Sekunden etwas verkaufen.");
		if(sscanf(params,"us[30]i",pID,cmd,preis))
		{
			if(isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12))
			{
				SCM(playerid,SAMP_WEISS,""IINFO" /sellgun [playerid/Name][Waffennamen] [Preis]");
			 	SCM(playerid,SAMP_WEISS,"Waffenname (benötigte Materials):");
			 	SCM(playerid,SAMP_WEISS,"[Messer (410),Baseballschläger (150),Deagle (900)]");
			 	SCM(playerid,SAMP_WEISS,"[Schaufel (260),9mm (550),SD-Pistole (420)]");
			 	SCM(playerid,SAMP_WEISS,"[Shotgun (1250),MP-5 (2500),AK-47 (3500),M4 (3500)]");
			 	return SCM(playerid,SAMP_WEISS,"[Sniper (8000),Rifle (3000),Spray (360),Katana (300)]");
			}
			else
			{
			 	SCM(playerid,SAMP_WEISS,""IINFO" /sellgun [playerid/Name][Waffennamen] [Preis]");
			 	SCM(playerid,SAMP_WEISS,"Waffenname (benötigte Materials):");
			 	SCM(playerid,SAMP_WEISS,"[Messer (410),Baseballschläger (150),Deagle (900)]");
			 	SCM(playerid,SAMP_WEISS,"[Schaufel (260),9mm (550),SD-Pistole (420)]");
			 	SCM(playerid,SAMP_WEISS,"[Shotgun (1250),MP-5 (2500),AK-47 (3500),M4 (3500)]");
			 	return SCM(playerid,SAMP_WEISS,"[Sniper (8000),Rifle (3000),Spray (360)]");
		 	}
		}
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Waffen selber verkaufen!");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		if(GetPlayerLevel(pID) < 2)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht Level 2.(mindestens Level 2)");
		if(preis<0||preis>100000)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur einen Preis von 0-100000$ wählen.");
		if(strcmp(cmd,"Deagle",true) == 0)
		{
			if(mats < 900)return SCM(playerid,SAMP_WEISS,"Nicht genug Materials");
			format(string,sizeof(string),"%s (ID:%i) bietet dir eine Deagle für %i$ an.(/accept Waffe)",SpielerName(playerid),playerid,preis);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) eine Deagle für %i$ an.",SpielerName(pID),pID,preis);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[pID][pSeller] = playerid;
			Spieler[pID][pAngebot] = 6;
			Spieler[pID][pKaufPreis] = preis;
			Spieler[pID][pMenge] = 24;//deagle
			Spieler[pID][pVerbrauch] = 900;//materials verbrauch nach accept ^^
			isell[playerid] = gettime() + (10);
			if(isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12))
			{
				Spieler[pID][pMenge2] = 86*2;//muni
			}
			else Spieler[pID][pMenge2] = 86;//muni
			return 1;
		}
		if(strcmp(cmd,"Messer",true) == 0)
		{
			if(mats < 410)return SCM(playerid,SAMP_WEISS,"Nicht genug Materials");
		    format(string,sizeof(string),"%s (ID:%i) bietet dir ein Messer für %i$ an.(/accept Waffe)",SpielerName(playerid),playerid,preis);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) ein Messer für %i$ an.",SpielerName(pID),pID,preis);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[pID][pSeller] = playerid;
			Spieler[pID][pAngebot] = 6;
			Spieler[pID][pKaufPreis] = preis;
			Spieler[pID][pMenge] = 4;//messer
			Spieler[pID][pMenge2] = 1;//muni
			Spieler[pID][pVerbrauch] = 410;//materials verbrauch nach accept ^^
			isell[playerid] = gettime() + (10);
			return 1;
		}
		if(strcmp(cmd,"Baseballschläger",true) == 0)
		{
			if(mats < 150)return SCM(playerid,SAMP_WEISS,"Nicht genug Materials");
			format(string,sizeof(string),"%s (ID:%i) bietet dir einen Baseball Schläger für %i$ an.(/accept Waffe)",SpielerName(playerid),playerid,preis);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) einen Baseball Schläger für %i$ an.",SpielerName(pID),pID,preis);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[pID][pSeller] = playerid;
