			    {
					format(string,sizeof(string),"%s\nBusinesskasse(Geld): %i$\nGeld auf der Hand: %i$\nGib bitte den Betrag an Geld ein den du in deine Businesskasse einzahlen möchtest:",BizName(biz),BizInfo[biz][biz_geldkasse],GetACMoney(playerid));
					ShowPlayerDialog(playerid,BIZ_DIALOG_AUSWAHL_EINZAHLEN,DIALOG_STYLE_INPUT,"Businessverwaltung (Einzahlung)",string,"Einzahlen","Zurück");
					return 1;
				}
				if(!IsNumeric(inputtext))
				{
					format(string,sizeof(string),"%s\nBusinesskasse(Geld): %i$\nGeld auf der Hand: %i$\nGib bitte den Betrag an Geld ein den du in deine Businesskasse einzahlen möchtest:",BizName(biz),BizInfo[biz][biz_geldkasse],GetACMoney(playerid));
					ShowPlayerDialog(playerid,BIZ_DIALOG_AUSWAHL_EINZAHLEN,DIALOG_STYLE_INPUT,"Businessverwaltung (Einzahlung)",string,"Einzahlen","Zurück");
					return 1;
				}
				else
				{
					if((GetACMoney(playerid) - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei.");
					BizInfo[biz][biz_geldkasse] += Menge;
					ACMoney(playerid,- Menge);
					format(string,sizeof(string),""IINFO" du hast %i$ in deine Businesskasse eingezahlt! Businesskasse(Geld): %d$",Menge,BizInfo[biz][biz_geldkasse]);
					SCM(playerid,SAMP_WEISS,string);
					ShowPlayerDialog(playerid,DIALOG_BIZ_MENU,DIALOG_STYLE_LIST,""ClanTagDialoge"Businessverwaltung",""#HTML_BLAU"1."#HTML_WEISS" Einzahlen\n"#HTML_BLAU"2."#HTML_WEISS" Auszahlen\n"#HTML_BLAU"3."#HTML_WEISS" Preise ändern","Auswählen","Abbrechen");
					SaveOnlyOneBiz(biz);
