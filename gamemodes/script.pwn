	    PlayerTextDrawSetOutline(showplayerid,STATSdraw[showplayerid][17],0);
	    PlayerTextDrawTextSize(showplayerid,STATSdraw[showplayerid][17],390.0,210.0);
	}
	if(Spieler[playerid][pAngel] != 0)
	{
	    STATSdraw[showplayerid][18] = CreatePlayerTextDraw(showplayerid,405.0,140.0,"_");
	    PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][18],TEXT_DRAW_FONT_MODEL_PREVIEW);
	    PlayerTextDrawColour(showplayerid,STATSdraw[showplayerid][18],0xFFFFFFFF);
	    PlayerTextDrawTextSize(showplayerid,STATSdraw[showplayerid][18],30.0,30.0);
    	PlayerTextDrawSetPreviewModel(showplayerid,STATSdraw[showplayerid][18],18632);
    	PlayerTextDrawSetPreviewRot(showplayerid,STATSdraw[showplayerid][18],-15.0,0.0,0.0,0.6);
	}
	else
	{
	    STATSdraw[showplayerid][18] = CreatePlayerTextDraw(showplayerid,405.0,140.0,"N");
	    PlayerTextDrawBoxColour(showplayerid,STATSdraw[showplayerid][18],SERVERFARBEHEX);
		PlayerTextDrawFont(showplayerid,STATSdraw[showplayerid][18],TEXT_DRAW_FONT_1);
		PlayerTextDrawSetShadow(showplayerid,STATSdraw[showplayerid][18],0);
	    PlayerTextDrawSetOutline(showplayerid,STATSdraw[showplayerid][18],0);
	    PlayerTextDrawTextSize(showplayerid,STATSdraw[showplayerid][18],435.0,170.0);
	}
	SCM(showplayerid,DUNKELGRUEN,"Benutze die 'N-TASTE' um die Statistiken zu schließen.");
	new premium[64];
	if(gettime() > Spieler[playerid][pPremium])
	{
		premium = "User";
	}
	else
	{
	new time = Spieler[playerid][pPremium]-gettime();
	if(floatround(time/86400) >= 1)
	{
		format(premium,sizeof(premium),"~y~Donator:%i Tag/e~w~",floatround(time/86400));
	}
	else if(floatround(time/3600) >= 1)
	{
		format(premium,sizeof(premium),"~y~Donator:%i Stunde/n~w~",floatround(time/3600));
	}
	else if(floatround(time/60) >= 1)
	{
    	format(premium,sizeof(premium),"~y~Donator:"IINFO2"%i:%02d"#HTML_WEISS" Minute/n~w~",floatround(time/60),floatround(time%60));
	}
 	}
	new sex[10];
	switch(Spieler[playerid][pSex])
	{
		case 1:{sex="Maennlich";}
		case 2:{sex="Weiblich";}
		default:{sex="ERROR";}
	}
	new fsperre[96],fraktsperre = Spieler[playerid][pFraktionSperre]-gettime();
	if(gettime() < Spieler[playerid][pFraktionSperre])
	{
		format(fsperre,sizeof(fsperre),"Vorhanden "IINFO2"%i:%02d"#HTML_WEISS" Minuten",fraktsperre/60,fraktsperre%60);
	}
	else {fsperre="Keine";}
	new fstyle[16];
	switch(GetPlayerFightingStyle(playerid))
	{
		case 4:{fstyle="Normal";}
		case 5:{fstyle="Boxing";}
		case 6:{fstyle="Kungfu";}
		case 7:{fstyle="Kneehead";}
		case 15:{fstyle="Grabkick";}
		case 16:{fstyle="Elbow";}
		default:{fstyle="ERROR";}
	}
	new spawn[20];
	switch(Spieler[playerid][pSpawn])
	{
		case 0:{spawn="MainSpawn";}
		case 1:{spawn="Haus";}
		case 2:{spawn="Fraktion";}
		case 3:{spawn="Hotel";}
		case 4:{spawn="Mietshaus";}
		case 5:{spawn="Wohnwagen";}
		default:{spawn="ERROR";}
	}

	new handyortbarkeit[35];
	switch(Spieler[playerid][pHandystate])
	{
		case 0:{handyortbarkeit="~r~Ausgeschaltet~w~";}
		case 1:{handyortbarkeit="~g~Eingeschaltet~w~";}
		default:{handyortbarkeit="ERROR";}
	}
	new hatflat[35];
	switch(Spieler[playerid][pHandyFlat])
	{
		case 0:{hatflat="Keine";}
		case 1:{hatflat="~g~Vorhanden~w~";}
		default:{hatflat="ERROR";}
	}
	new pbrang[64];
	switch(Spieler[playerid][pPBRang])
	{
	    case 0:{pbrang="~p~Neuankoemmling~w~";}
	    case 1:{pbrang="~p~Anfaenger~w~";}
	    case 2:{pbrang="~y~Fortgeschrittener~w~";}
	    case 3:{pbrang="~y~Skiller~w~";}
	    case 4:{pbrang="~g~Profi~w~";}
	    case 5:{pbrang="~g~High Skiller~w~";}
	    case 6:{pbrang="~b~Elite~w~";}
	    case 7:{pbrang="~b~ProHighSkiller~w~";}
	    case 8:{pbrang="~r~["#SERVERTAG"]Elite~w~";}
		default:{pbrang="ERROR";}
    }

    new bizowner[25],bizcoowner[25],bcounter[2] = 0;
    for(new biz=1;biz<MAX_BIZ;biz++)
	{
		if(BizInfo[biz][bizcreatet] == 1)
		{
			if(strcmp(BizInfo[biz][biz_besitzer],Spieler[playerid][pName],true) == 0)
			{
			    format(bizowner,sizeof(bizowner),"ID:%i,%s",biz,bizowner);
			    bcounter[0]++;
		    }
		    if(strcmp(BizInfo[biz][biz_teilhaber],Spieler[playerid][pName],true) == 0)
			{
			 	format(bizcoowner,sizeof(bizcoowner),"ID:%i,%s",biz,bizcoowner);
				bcounter[1]++;
			}
		}
	}
	if(bcounter[0] == 0) format(bizowner,sizeof(bizowner),"Keins");
	if(bcounter[1] == 0) format(bizcoowner,sizeof(bizcoowner),"Keins");

	new immobilie[25],hcounter = 0;
    for(new haus=1;haus<MAX_HAUS;haus++)
	{
		if(HausInfo[haus][hauscreatet] == 1)
		{
			if(!strcmp(HausInfo[haus][haus_besitzer],Spieler[playerid][pName],true))
			{
		    format(immobilie,sizeof(immobilie),"Nummer:%i,%s",haus,immobilie);
		    hcounter++;
		    }
		}
	}
	if(hcounter == 0) format(immobilie,sizeof(immobilie),"Keins");

 	new lotterieschein[7];
 	if(Spieler[playerid][pLottonumber] == 0)
 	{
 		lotterieschein="Keinen";
 	}
 	else format(lotterieschein,sizeof(lotterieschein),"%i",Spieler[playerid][pLottonumber]);
 	new banksafe[35];
 	switch(Spieler[playerid][pBankSafeSafe])
 	{
	 	case 0:{banksafe="Keins";}
		case 1:{banksafe="~g~Vorhanden~w~";}
		default:{banksafe="ERROR";}
 	}

 	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][0]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][1]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][2]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][3]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][4]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][5]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][6]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][7]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][8]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][9]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][10]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][11]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][12]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][13]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][14]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][15]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][16]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][17]);
	PlayerTextDrawShow(showplayerid,STATSdraw[showplayerid][18]);

	format(string,sizeof(string),"~r~Profil~w~~n~Name:%s	ID:%i	Geschlecht:%s		Alter:%i	Level:%i~n~Adminstatus:%s~n~~n~",Spieler[playerid][pName],playerid,sex,AgeOfPlayer(playerid),Spieler[playerid][pLevel],Adminrang(playerid));
    PlayerTextDrawSetString(showplayerid,STATSdraw[showplayerid][4],string);
    format(string,sizeof(string),"~r~Account~w~~n~Status:%s	Geworbener:%s	Payday:%i Minuten~n~Spielzeit:%i Minuten	Respektpunkte:%i/%i	Levelkosten:%i$~n~Verwarnungen:%i	Kampfstil:%s	Spawn:%s~n~",
	premium,Spieler[playerid][GeworbenPlaya],Spieler[playerid][pMinutesAfterPayday]/60,Spieler[playerid][pTimeAfterRegister]/60,Spieler[playerid][pRespektFromPayday],Spieler[playerid][pRespektToLevelUp],Spieler[playerid][pLevelKosten],Spieler[playerid][pWarns],fstyle,spawn);
    PlayerTextDrawSetString(showplayerid,STATSdraw[showplayerid][5],string);
	format(string,sizeof(string),"~r~Berufsleben~w~~n~Fraktion:%s	Rang:%s[%i]~n~Fraktionssperre:%s		Beruf:%s~n~~n~",
	FraktionsName(Spieler[playerid][pFraktion]),SpielerFraktionsRangName(playerid),Spieler[playerid][pFraktRang],fsperre,SpielerJob(playerid));
    PlayerTextDrawSetString(showplayerid,STATSdraw[showplayerid][6],string);
 	format(string,sizeof(string),"~r~Fahndung~w~~n~Wantedpunkte:%i	STVO-Punkte:%i	Verbrechen:%i~n~~n~",
 	Spieler[playerid][pWantedPoints],Spieler[playerid][pSTVOpoints],Spieler[playerid][pSuspectPoints]);
 	PlayerTextDrawSetString(showplayerid,STATSdraw[showplayerid][7],string);
	format(string,sizeof(string),"~r~Finanzen~w~~n~Bargeld:%i$	Bankguthaben:%i$	Gesamt:%i$~n~Bankpin:/bankpin	Bankschliessfach:%s~n~",
	GetACMoney(playerid),Spieler[playerid][pBank],GetACMoney(playerid) + Spieler[playerid][pBank],banksafe);
    PlayerTextDrawSetString(showplayerid,STATSdraw[showplayerid][8],string);
	format(string,sizeof(string),"~r~Paintball~w~~n~Morde:%i	Tode:%i	Rang:%s	K/D:%.2f	Besuche:%i~n~~n~",
	Spieler[playerid][pPBKills],Spieler[playerid][pPBDeaths],pbrang,Float:Spieler[playerid][pPBKills]/Float:Spieler[playerid][pPBDeaths],Spieler[playerid][pPBVisits]);
    PlayerTextDrawSetString(showplayerid,STATSdraw[showplayerid][9],string);
	format(string,sizeof(string),"~r~Sonstiges~w~~n~Morde:%i	Tode:%i	K/D:%.2f~n~Haus:%s		Business(Besitzer):%s	Business(Teilhaber):%s~n~Grundwehrdienstnote:%i	Zivildienstnote:%i	Lottonummer:%s~n~~n~",
	Spieler[playerid][pMorde],Spieler[playerid][pTode],Float:Spieler[playerid][pMorde]/Float:Spieler[playerid][pTode],immobilie,bizowner,bizcoowner,Spieler[playerid][pGrundwehrdienst],Spieler[playerid][pZiviNote],lotterieschein);
    PlayerTextDrawSetString(showplayerid,STATSdraw[showplayerid][10],string);
	if(Spieler[playerid][pHandy] != 0)
    {
	    format(string,sizeof(string),"~r~Telefon~w~~n~Handy:%s	Nummer:%i	Guthaben: %i$~n~Akkustand:%.1f%		Status:%s	Flatrate:%s",
		HandyInfo[Spieler[playerid][pHandy]][Handyname],Spieler[playerid][pPhonenumber],Spieler[playerid][pHandyCoins],Spieler[playerid][pHandyakku],handyortbarkeit,hatflat);
	    PlayerTextDrawSetString(showplayerid,STATSdraw[showplayerid][11],string);
    }
    format(headerstring,sizeof(headerstring),"Statistiken (%02d.%02d.%04d - %02d:%02d:%02d)",tag,monat,jahr,stunde,minute,sekunde);
    PlayerTextDrawSetString(showplayerid,STATSdraw[showplayerid][1],headerstring);
    return 1;
}
stock KHZeichen(playerid,showplayerid)
{
	return 1;
}
stock ShowAkte(playerid,showplayerid)
{
	new string[3000],stringname[3000],stringall[3000];
	new sex[3000];
	switch(Spieler[playerid][pSex])
	{
		case 1:{sex="Männlich";}
		case 2:{sex="Weiblich";}
		default:{sex="ERROR";}
 	}
	new waffenschein[250];
    switch(Spieler[playerid][pWaffenLic])
	{
		case 0:{waffenschein=""#HTML_ROT"Nicht Vorhanden"#HTML_WEISS"";}
		case 1,2,3:{format(waffenschein,sizeof(waffenschein),"Klasse "IINFO2"%i"#HTML_WEISS"",Spieler[playerid][pWaffenLic]);}
		default:{waffenschein="ERROR";}
	}
	new carschein[250];
	switch(Spieler[playerid][pAutoLic])
