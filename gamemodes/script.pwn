stock MaxIpsConnected(playerid)
{
    new ipcounter;
	if(strcmp(SpielerIP(playerid),"127.0.0.1",true) == 0){ return 0; }
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i))
		{
			if(strcmp(SpielerIP(playerid),SpielerIP(i),true) == 0)
			ipcounter++;
		}
	}
	return ipcounter;
}
stock GetRegisteredCount()
{
	new count = 0;
    ForEachPlayer(i)
	{
		if(IsPlayerConnected(i))
		{
			if(Spieler[i][pOnRegister] == true)
			count++;
		}
	}
	return count;
}
