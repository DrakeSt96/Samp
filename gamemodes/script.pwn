	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],reason[31];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /delbl [playerid/Name][Grund]");
	    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /delbl [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst von Blacklist löschen.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(Spieler[pID][pBL][Spieler[playerid][pFraktion]] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht auf der Blacklist deiner Fraktion!");
		format(string,sizeof(string),""IINFO" du wurdest von %s von der Blacklist der Fraktion %s gelöscht. Grund: %s",SpielerName(playerid),FraktionsName(Spieler[playerid][pFraktion]),reason);
		SCM(pID,FMELDUNG,string);
		format(string,sizeof(string),"%s hat %s von der Blacklist gelöscht. Grund: %s",SpielerName(playerid),SpielerName(pID),reason);
	    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	    Spieler[pID][pBL][Spieler[playerid][pFraktion]] = 0;
	    strmid(pBLReason[pID][Spieler[playerid][pFraktion]],"Keinen",0,strlen("Keinen"),32);
	    return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:freesinlist(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],preis;
    if(isPlayerInFrakt(playerid,18))
	{
		if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		if(sscanf(params,"ui",pID,preis))return SCM(playerid,SAMP_WEISS,""IINFO" /freesinlist [playerid/Name][Preis]");
		if(preis<0||preis>10000000)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur einen Preis von 0-10.000.000$ waehlen.");
	    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst von Blacklist löschen.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(Spieler[pID][pBL][Spieler[playerid][pFraktion]] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht auf der Sinlist deiner Fraktion!");
	    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),"%s bietet dir eine Freikauf für %i$ von der Sinlist der Fraktion %s an.(/accept sinlist | /cancel sinlist)",SpielerName(playerid),preis,FraktionsName(Spieler[playerid][pFraktion]));
		SCM(pID,FMELDUNG,string);
		format(string,sizeof(string),""IINFO" du bietest %s eine Freikauf eurer Sinlist für %i$ an.",SpielerName(pID),preis);
	    SCM(playerid,FMELDUNG,string);
	    Spieler[pID][pSeller] = playerid;
		Spieler[pID][pAngebot] = 20;
		Spieler[pID][pKaufPreis] = preis;
	    return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

