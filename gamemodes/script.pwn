	    case DIALOG_FVERWALTUNG_Motd:
		{
			new string[150];
			if(response == 0)return 1;
			else
		    {
			    if(!strlen(inputtext) || strlen(inputtext) > 64)
			    {
					return ShowPlayerDialog(playerid,DIALOG_FVERWALTUNG_Motd,DIALOG_STYLE_INPUT,"Fraktionsverwaltung Spawnnachricht","Gebe nun hier den Text ein den deine Fraktionsmitglieder beim ersten Spawn auf dem Server sehen sollen.\nDer Text darf nicht mehr als 64 Zeichen haben!","Absenden","Zurück");
				}
				else
				{
					for(new i=0;i<sizeof(BadWord);i++)
					{
						if(strfind(inputtext,BadWord[i],true) != -1)
					  	{
						  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
						   	SendClientMessageToAll(SAMP_WEISS,string);
							format(string,sizeof(string),"Beleidigung: %s | %s | Art: /fspawnmsg",BadWord[i],inputtext);
							SendAdminMessage(SAMP_WEISS,string);
						    Spieler[playerid][pMuteTime] += 15*60;
							Spieler[playerid][pMuted] = 1;
							return 1;
					    }
					}
					new strpos = strfind(inputtext,"www",true);
					if(strfind(inputtext,".",true) != -1 && strfind(inputtext,":",true) != -1 && strlen(inputtext) > 8 && strfind(inputtext,TSIP,false) == -1)
					{
						strdel(inputtext,strpos,strfind(inputtext,".",true) && strfind(inputtext,":",true));
						return 1;
					}
					SCM(playerid,SAMP_WEISS,""IINFO" du hast den Text der Spawnnachricht folgendermaßen geändert:");
					format(string,sizeof(string),"%s",inputtext);
					SCM(playerid,SAMP_WEISS,string);
