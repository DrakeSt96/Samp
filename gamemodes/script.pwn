							ShowPlayerDialog(playerid,DIALOG_AutoKaufen_Liste,DIALOG_STYLE_LIST,""ClanTagDialoge" Auothaus - Hauptmenü",""#HTML_BLAU"1."#HTML_WEISS" Auto Kaufen\n"#HTML_BLAU"2."#HTML_WEISS" Probefahrt\n"#HTML_BLAU"3."#HTML_WEISS" Fahrzeug Papiere","Nehmen","Abbrechen");
							return SCM(playerid,SAMP_GRAU,"[Arabischer Akzent]"#HTML_WEISS" Fahrzeughändler: Sorry, ich kann dich leider nicht ohne Personalausweis Fahren lassen.");
							
						}
					 	if(Spieler[playerid][pWantedPoints] >= 1)
						{
							ShowPlayerDialog(playerid,DIALOG_AutoKaufen_Liste,DIALOG_STYLE_LIST,""ClanTagDialoge" Auothaus - Hauptmenü",""#HTML_BLAU"1."#HTML_WEISS" Auto Kaufen\n"#HTML_BLAU"2."#HTML_WEISS" Probefahrt\n"#HTML_BLAU"3."#HTML_WEISS" Fahrzeug Papiere","Nehmen","Abbrechen");
							return SCM(playerid,SAMP_GRAU,"[Arabischer Akzent]"#HTML_WEISS" Fahrzeughändler: Ich werde dich nicht Probefahren lassen! Da du Wanteds hast.");
							
						}
						format(string,sizeof(string),"[Arabischer Akzent]:"#HTML_WEISS" Fahrzeughändler: Okay, du darfst mein Fahrzeug: "#HTML_GRAU"%s"#HTML_WEISS" jetzt 2 Minuten lang testen.",VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(playerid))-400]);
						SCM(playerid,SAMP_GRAU,string);
						SCM(playerid,SAMP_WEISS,"");
						for(new v=0;v<sizeof(AutohausVehicle);v++)
						{
							if(GetPlayerVehicleID(playerid) == Pvehicles[v])
							{
							    Spieler[playerid][PprobefahrtVeh] = CreateVehicleEx(AutohausVehicle[v][modelid],AutohausVehicle[v][buyspawnX],AutohausVehicle[v][buyspawnY],AutohausVehicle[v][buyspawnZ],AutohausVehicle[v][buyspawnA],-1,-1,-1,false);
							    SetVehicleNumberPlate(Spieler[playerid][PprobefahrtVeh],"Testfahrt");
								Spieler[playerid][PprobefahrtTime] = gettime() + (60*2);
								Spieler[playerid][PprobefahrtVehID] = v;
								GetVehicleParamsEx(Spieler[playerid][PprobefahrtVeh],engine,lights,alarm,doors,bonnet,boot,objective);
							 	SetVehicleParamsEx(Spieler[playerid][PprobefahrtVeh],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
								SetPlayerPosEx(playerid,AutohausVehicle[v][buyspawnX],AutohausVehicle[v][buyspawnY],AutohausVehicle[v][buyspawnZ]);
								PutPlayerInVehicleEx(playerid,Spieler[playerid][PprobefahrtVeh],0);
								TextDrawHideForPlayer(playerid,Introdraw[0]);
							    TextDrawHideForPlayer(playerid,Introdraw[1]);
								SetCameraBehindPlayer(playerid);
								TogglePlayerControllable(playerid,true);
								return 1;
							}
						}
						for(new i=0;i<sizeof(FvehicleBuyVehicles);i++)
						{
							if(GetPlayerVehicleID(playerid) == Fvehicles[i])
							{
								new rSpawn = random(sizeof(FvehicleAutoHausSpawn));
							    Spieler[playerid][PprobefahrtVeh] = CreateVehicleEx(GetVehicleModel(GetPlayerVehicleID(playerid)),FvehicleAutoHausSpawn[rSpawn][0],FvehicleAutoHausSpawn[rSpawn][1],FvehicleAutoHausSpawn[rSpawn][2],FvehicleAutoHausSpawn[rSpawn][3],-1,-1,-1,false);
							    SetVehicleNumberPlate(Spieler[playerid][PprobefahrtVeh],"Testfahrt");
								Spieler[playerid][PprobefahrtTime] = gettime() + (60*2);
