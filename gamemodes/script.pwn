				format(string,sizeof(string),"%s hat dir deine %ikg C4 abgenommen.",SpielerName(playerid),Spieler[pID][pC4]);
				SCM(pID,SAMP_WEISS,string);
				format(string,sizeof(string),""IINFO" du hast %s %ikg C4 abgenommen.",SpielerName(pID),Spieler[pID][pC4]);
			    SCM(playerid,SAMP_WEISS,string);
			    Spieler[pID][pC4] = 0;
			    format(string,sizeof(string),"** %s nimmt %s das C4 ab **",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				return 1;
			}
			return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion./Du bist nicht im Admindienst.");
		}
		if(strcmp(cmd,"Materials",true) == 0)
		{
			if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerAnAdmin(playerid,6) && Spieler[playerid][pAdminOnduty] == true)
		   	{
				if(Spieler[playerid][pAdminOnduty] == false)
			   	{
				   	if(!isPlayerAMember(playerid,1))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
				   	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
					if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Scheine abnehmen.");
				}
				if(Spieler[pID][pMaterials] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keinen Materials.");
				format(string,sizeof(string),"%s hat dir deine %i Materials abgenommen.",SpielerName(playerid),Spieler[pID][pMaterials]);
				SCM(pID,SAMP_WEISS,string);
				format(string,sizeof(string),""IINFO" du hast %s %i Materials abgenommen.",SpielerName(pID),Spieler[pID][pMaterials]);
			    SCM(playerid,SAMP_WEISS,string);
			    Spieler[pID][pMaterials] = 0;
			    format(string,sizeof(string),"** %s nimmt %s die Materials ab **",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				return 1;
			}
			return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion./Du bist nicht im Admindienst.");
		}
		if(strcmp(cmd,"MatsPackete",true) == 0)
		{
			if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerAnAdmin(playerid,6) && Spieler[playerid][pAdminOnduty] == true)
		   	{
				if(Spieler[playerid][pAdminOnduty] == false)
			   	{
				   	if(!isPlayerAMember(playerid,1))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
				   	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
					if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Scheine abnehmen.");
				}
				if(Spieler[pID][MatsPackete] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keinen MatsPackete.");
				format(string,sizeof(string),"%s hat dir deine %i MatsPackete abgenommen.",SpielerName(playerid),Spieler[pID][MatsPackete]);
				SCM(pID,SAMP_WEISS,string);
				format(string,sizeof(string),""IINFO" du hast %s %i MatsPackete abgenommen.",SpielerName(pID),Spieler[pID][MatsPackete]);
			    SCM(playerid,SAMP_WEISS,string);
			    Spieler[pID][MatsPackete] = 0;
			    format(string,sizeof(string),"** %s nimmt %s die MatsPackete ab **",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				return 1;
			}
			return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion./Du bist nicht im Admindienst.");
		}
		if(strcmp(cmd,"Drogen",true) == 0)
		{
			if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerAnAdmin(playerid,6) && Spieler[playerid][pAdminOnduty] == true)
		   	{
				if(Spieler[playerid][pAdminOnduty] == false)
			   	{
				   	if(!isPlayerAMember(playerid,1))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
				   	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
					if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Scheine abnehmen.");
				}
				if(Spieler[pID][pGanja] + Spieler[pID][pKokain] + Spieler[pID][pOpium] + Spieler[pID][pGanjaSammen] + Spieler[pID][pOpiumSammen] + Spieler[pID][pKokainSammen] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keine Drogen.");
				format(string,sizeof(string),"%s hat dir deine%i Opium Pillen,%ig Ganja,%ig Kokain,%ig Spice abgenommen.",SpielerName(playerid),Spieler[pID][pOpium],Spieler[pID][pGanja],Spieler[pID][pKokain],Spieler[pID][pSpice]);
				SCM(pID,SAMP_WEISS,string);
				format(string,sizeof(string),""IINFO" du hast %s %i Opium Pillen,%ig Ganja,%ig Kokain,%ig Spice abgenommen.",SpielerName(pID),Spieler[pID][pOpium],Spieler[pID][pGanja],Spieler[pID][pKokain],Spieler[pID][pSpice]);
			    SCM(playerid,SAMP_WEISS,string);
				Spieler[pID][pOpium] = 0;
			    Spieler[pID][pGanja] = 0;
			    Spieler[pID][pKokain] = 0;
			    Spieler[pID][pSpice] = 0;
			    Spieler[pID][pGanjaSammen] = 0;
			    Spieler[pID][pSpiceSammen] = 0;
				Spieler[pID][pOpiumSammen] = 0;
				Spieler[pID][pKokainSammen] = 0;
			    format(string,sizeof(string),"** %s nimmt %s die Drogen ab **",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				return 1;
			}
			return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion./Du bist nicht im Admindienst.");
		}
		if(strcmp(cmd,"Waffenschein",true) == 0)
		{
			if(isPlayerInFrakt(playerid,1) || isPlayerAnAdmin(playerid,6) && Spieler[playerid][pAdminOnduty] == true)
			{
				if(Spieler[playerid][pAdminOnduty] == false)
			   	{
				   	if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
				   	if(Spieler[playerid][pFunkgeraet] == 0)return SCM(playerid,SAMP_WEISS,"Kein Funktgerät.");
					if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
					if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Scheine abnehmen.");
				}
				if(Spieler[pID][pWaffenLic] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keinen Waffenschein.");
				format(string,sizeof(string),"%s hat dir dein Waffenschein abgenommen.",SpielerName(playerid));
				SCM(pID,SAMP_WEISS,string);
				Spieler[pID][pWaffenLic] = 0;
			    SetPlayerWaffenSkill(pID);
				format(string,sizeof(string),"%s hat %s den Waffenschein abgenommen.",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				ForEachPlayer(i)
				{
					if(IsPlayerConnected(i))
					{
					 	if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,3) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,16))
						{
							if(Spieler[i][pDuty] != 0)
							{
								if(Spieler[i][pFunkgeraet] == 1 || (IsAFraktionsVeh(i) != -1 && Fahrzeug[IsAFraktionsVeh(i)][Fraktion] == Spieler[i][pFraktion]) || FraktionsAktenPCs(i))
								{
							 		SCM(i,SAMP_WEISS,string);
							  	}
						  	}
					  	}
				  	}
			  	}
			  	return 1;
		  	}
			return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion./Du bist nicht im Admindienst.");
		}
		if(strcmp(cmd,"Scheinsperre",true) == 0)
		{
			if(isPlayerInFrakt(playerid,1) || isPlayerAnAdmin(playerid,6) && Spieler[playerid][pAdminOnduty] == true)
			{
				if(Spieler[playerid][pAdminOnduty] == false)
			   	{
				   	if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
				   	if(Spieler[playerid][pFunkgeraet] == 0)return SCM(playerid,SAMP_WEISS,"Kein Funktgerät.");
					if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
					if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Scheine abnehmen.");
				}
				if(gettime() > Spieler[pID][pScheinSperre])return SCM(playerid,SAMP_WEISS,"Spieler hat keine Scheinsperre.");
				format(string,sizeof(string),"%s hat dir deine Scheinsperre abgenommen.",SpielerName(playerid));
				SCM(pID,SAMP_WEISS,string);
			    Spieler[pID][pScheinSperre] = 0;
				format(string,sizeof(string),"%s hat %s den Scheinsperre abgenommen.",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				ForEachPlayer(i)
				{
					if(IsPlayerConnected(i))
					{
					 	if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,3) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,16))
						{
							if(Spieler[i][pDuty] != 0)
							{
								if(Spieler[i][pFunkgeraet] == 1 || (IsAFraktionsVeh(i) != -1 && Fahrzeug[IsAFraktionsVeh(i)][Fraktion] == Spieler[i][pFraktion]) || FraktionsAktenPCs(i))
								{
							 		SCM(i,SAMP_WEISS,string);
							  	}
						  	}
					  	}
				  	}
			  	}
				return 1;
		  	}
			return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion./Du bist nicht im Admindienst.");
		}
	    SCM(playerid,SAMP_WEISS,""IINFO" /take [playerid/Name][Handlung]");
		SCM(playerid,SAMP_WEISS,"Handlungen:");
		SCM(playerid,SAMP_WEISS,"Führerschein/Motorradschein/Rollerschein/Flugschein/Helikopterschein/Scheinsperre");
		return SCM(playerid,SAMP_WEISS,"Bootsschein/Waffenschein/Waffen/Rüstung/Drogen/Materials/MatsPackete/C4");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion./Du bist nicht im Admindienst.");
}

COMMAND:segen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
 	if(isPlayerInFrakt(playerid,18))
	{
		if(sscanf(params,"i",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /segen [playerid/Name]");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selber segnen.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),"%s (ID:%i) möchte dich segnen.(/accept segen)",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		SCM(pID,SAMP_WEISS,"Um den Segen abzulehnen Tippe '/cancel segen'");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) einen Segen angeboten. Warte auf Annahme!",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pSeller] = playerid;
		Spieler[pID][pAngebot] = 19;
		return 1;
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:ticket(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,preis,string[650],reason[31];
 	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	  	if(sscanf(params,"uis[31]",pID,preis,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /ticket [playerid/Name][Preis][Grund]");
		if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /ticket [playerid/Name][Preis][Grund]");
		if(preis<1||preis>2000)return SCM(playerid,SAMP_WEISS,"Ticketpreis muss zwischen 1- und 2000 $ sein!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst kein Ticket anbieten.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		if((Spieler[pID][pWantedPoints]) > 10)return SCM(playerid,SAMP_WEISS,"Angegebenem Spieler kann kein Ticket anboten werden!");
		format(string,sizeof(string),"%s bietet dir ein Ticket mit dem Grund: "IINFO2"%s"#HTML_WEISS" für "IINFO2"%i$"#HTML_WEISS" an. "IINFO2"/accept ticket",SpielerName(playerid),reason,preis);
		SCM(pID,SAMP_WEISS,string);
		SCM(pID,SAMP_WEISS,""IINFO" um das Ticket abzulehnen Tippe "IINFO2"/cancel ticket");
		format(string,sizeof(string),""IINFO" du hast "IINFO2"%s"#HTML_WEISS" ein Ticket mit dem Grund: "IINFO2"%s"#HTML_WEISS" für "IINFO2"%i$"#HTML_WEISS" angeboten. Warte auf Annahme!",SpielerName(pID),reason,preis);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pSeller] = playerid;
		Spieler[pID][pAngebot] = 12;
		Spieler[pID][pKaufPreis] = preis;
		return 1;
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:su(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,Menge,reason[31],string[128],fv = IsAFraktionsVeh(playerid);
 	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(Spieler[playerid][pFunkgeraet] != 0 || FraktionsAktenPCs(playerid) || fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		{
		  	if(sscanf(params,"uds[31]",pID,Menge,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /su(spect) [playerid/Name][Menge][Grund]");
		    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /su(spect) [playerid/Name][Menge][Grund darf maximal 30 Zeichen beinhalten]");
			if(Menge<1||Menge>60)return SCM(playerid,SAMP_WEISS,"Gebe bitte eine Anzahl von Wantedpunkten zwischen 1 und 60 Wantedpunkten an.");
			if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selber keine Wantedpunkte geben.");
			if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
		    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
			if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
			if(Spieler[pID][pMaske] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" der Spieler besitzt keine Identität.");
		    if((Spieler[pID][pWantedPoints] + Menge) > 60)
			{
				format(string,sizeof(string),"Falsche Angabe./Spieler kann maximal nur 60 Wanteds haben./Wanteds von %s (ID:%i) : %i.",SpielerName(pID),pID,Spieler[pID][pWantedPoints]);
				return SCM(playerid,SAMP_WEISS,string);
			}
			format(string,sizeof(string),"Fahndung: Fall bearbeitet vom Beamten %s | Wanteds vergabe : %i | Wanteds gesamt: %i | Grund: %s",SpielerName(playerid),Menge,Spieler[pID][pWantedPoints]+Menge,reason);
			SCM(pID,SAMP_WEISS,string);
			GivePlayerWPS(pID,Menge,reason);
			format(string,sizeof(string),"Fahndung: %s | Beamter: %s | Wanteds vergabe : %i | Wanteds gesamt: %i | Grund: %s",SpielerName(pID),SpielerName(playerid),Menge,Spieler[pID][pWantedPoints],reason);
		    ForEachPlayer(p)
			{
				if(IsPlayerConnected(p))
				{
					if(isPlayerInFrakt(p,1) || isPlayerInFrakt(p,2) || isPlayerInFrakt(p,6) || isPlayerInFrakt(p,11))
					{
						if(Spieler[p][pDuty] != 0)
						{
							if(Spieler[p][pFunkgeraet] == 1 || (IsAFraktionsVeh(p) != -1 && Fahrzeug[IsAFraktionsVeh(p)][Fraktion] == Spieler[p][pFraktion]) || FraktionsAktenPCs(p))
							{
						   		SCM(p,SAMP_WEISS,string);
						   	}
					    }
				    }
				}
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du trägst kein Funkgerät mit dir./Du sitzt in keinem Fraktionsfahrzeug./Du bist an keinem Aktencomputer.");
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:pfreikaufen(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in einem Fahrzeug!");
	new Menge, string[128];
    if(!IsPlayerInRangeOfPoint(playerid,3.0,-2031.9979,-59.2937,35.3205))return SCM(playerid,SAMP_WEISS,"Hier kannst du deine STVO-Punkte nicht freikaufen!");
    if(sscanf(params,"i",Menge))return SCM(playerid,SAMP_WEISS,""IINFO" /pfreikaufen [Punkte]");
    format(string,sizeof(string),""IINFO" du kannst keine %d STVO-Punkte freikaufen, da du nur %d hast!",Menge,Spieler[playerid][pSTVOpoints]);
	if(Spieler[playerid][pSTVOpoints] < Menge)return SCM(playerid,SAMP_WEISS,string);
	if(Menge < 1 || Menge > 10) return SCM(playerid,SAMP_WEISS,"Die angegebene STVO-Punkte Menge ist ungültig!");
    format(string,sizeof(string),""IINFO" du hast %d STVO-Punkte für %d$ freigekauft! Bitte fahre nun vorsichtig!",Menge,Menge*MAX_PRICE_PER_POINT);
    SCM(playerid,SAMP_WEISS,string);
    Spieler[playerid][pSTVOpoints] -= Menge;
    ACMoney(playerid, -(Menge*MAX_PRICE_PER_POINT));
    fverwaltungen[16][Geld] += (Menge*MAX_PRICE_PER_POINT);
	return 1;
}
COMMAND:clear(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,reason[31],string[128],Menge,fv = IsAFraktionsVeh(playerid);
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11))
	{
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(Spieler[playerid][pFunkgeraet] != 0 || FraktionsAktenPCs(playerid) || fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		{
			if(!isPlayerAMember(playerid,1))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		    if(sscanf(params,"uis[31]",pID,Menge,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /clear [playerid/Name][Menge][Grund]");
		    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /clear [playerid/Name][Menge][Grund darf maximal 30 Zeichen beinhalten]");
			if(Menge<1||Menge>60)return SCM(playerid,SAMP_WEISS,""IINFO" /clear [playerid/Name][Menge 1-60][Grund]");
		    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir deine Akte nicht selber reinigen.");
			if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
		    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
			if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		 	if(Spieler[pID][pMaske] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" der Spieler besitzt keine Identität.");
		    if(Spieler[pID][pWantedPoints] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keine Wanteds.");
			if((Spieler[pID][pWantedPoints] - Menge) < 0)
			{
				format(string,sizeof(string),"Falsche Angabe./Spieler kann nicht weniger als 0 Wanteds haben./Wanteds von %s (ID:%i) : %i.",SpielerName(pID),pID,Spieler[pID][pWantedPoints]);
				return SCM(playerid,SAMP_WEISS,string);
		 	}
			format(string,sizeof(string),"Aktenbereinigung | Bearbeitet vom Beamten %s | Wanteds bereinigt: %i | Wanteds gesamt: %i | Grund: %s",SpielerName(playerid),Menge,Spieler[pID][pWantedPoints]-Menge,reason);
		    SCM(pID,SAMP_WEISS,string);
		    GivePlayerWPS(pID,-Menge,reason);
		    format(string,sizeof(string),"Aktenbereinigung: %s | Bearbeitet vom Beamten %s | Wanteds bereinigt: %i | Wanteds gesamt: %i | Grund: %s",SpielerName(pID),SpielerName(playerid),Menge,Spieler[pID][pWantedPoints],reason);
			ForEachPlayer(p)
			{
				if(IsPlayerConnected(p))
				{
					if(isPlayerInFrakt(p,1) || isPlayerInFrakt(p,2) || isPlayerInFrakt(p,3) || isPlayerInFrakt(p,6) || isPlayerInFrakt(p,11))
					{
						if(Spieler[p][pDuty] != 0)
						{
							if(Spieler[p][pFunkgeraet] == 1 || (IsAFraktionsVeh(p) != -1 && Fahrzeug[IsAFraktionsVeh(p)][Fraktion] == Spieler[p][pFraktion]) || FraktionsAktenPCs(p))
							{
							    SCM(p,SAMP_WEISS,string);
							    PlayCrimeReportForPlayer(p,p,3);
						    }
					    }
				    }
				}
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du trägst kein Funkgerät mit dir./Du sitzt in keinem Fraktionsfahrzeug./Du bist an keinem Aktencomputer.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:ram(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,3))
	{
		if(isPlayerInFrakt(playerid,3))
		{
			if(Spieler[playerid][pFraktABTInvite] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Abteilung.");
			if(Spieler[playerid][pDuty] != 2)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht als Feuerwehrman im Dienst.");
		}
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht, da du im Fahrzeug sitzt!");
	    for(new haus=1;haus<MAX_HAUS;haus++)
		{
			if(HausInfo[haus][hauscreatet] == 1)
			{
			 	if(IsPlayerInRangeOfPoint(playerid,2,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]))
				{
					if(HausInfo[haus][haus_Owned] == 0)return GameTextForPlayer(playerid,"~r~abgeschlossen!",2000,1);
					if(HausInfo[haus][haus_innenraum] == 255)return GameTextForPlayer(playerid,"~r~unbetrettbar",2000,1);
					if(HausInfo[haus][haus_locked] == 0)return GameTextForPlayer(playerid,"~r~Haus nicht abgeschlossen!",2000,1);
				    PlayerHearMusicInRange(HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z],15805,15.0,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
					SetPlayerPosEx(playerid,Homestore[HausInfo[haus][haus_innenraum]][Hx],Homestore[HausInfo[haus][haus_innenraum]][Hy],Homestore[HausInfo[haus][haus_innenraum]][Hz]);
				    SetPlayerInterior(playerid,Homestore[HausInfo[haus][haus_innenraum]][Hint]);
				    SetPlayerVirtualWorld(playerid,haus);
				    HausInfo[haus][haus_locked] = 0;
				    UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
				    format(string,sizeof(string),"** %s tritt die Tür der Hausnummer %i ein **",SpielerName(playerid),haus);
				    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				 	return 1;
			    }
			    if(HausInfo[haus][haus_innenraum] != 255)
			    {
				    if(IsPlayerInRangeOfPoint(playerid,2,Homestore[HausInfo[haus][haus_innenraum]][Hx],Homestore[HausInfo[haus][haus_innenraum]][Hy],Homestore[HausInfo[haus][haus_innenraum]][Hz]) && GetPlayerVirtualWorld(playerid) == haus)
				    {
						if(HausInfo[haus][haus_locked] == 0)return GameTextForPlayer(playerid,"~r~Haus nicht abgeschlossen!",2000,1);
						PlayerHearMusicInRange(Homestore[HausInfo[haus][haus_innenraum]][Hx],Homestore[HausInfo[haus][haus_innenraum]][Hy],Homestore[HausInfo[haus][haus_innenraum]][Hz],15805,15.0,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
						SetPlayerPosEx(playerid,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]);
						SetPlayerVirtualWorld(playerid,0);
						SetPlayerInterior(playerid,0);
						HausInfo[haus][haus_locked] = 0;
						UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
						format(string,sizeof(string),"** %s tritt die Tür der Hausnummer %i ein **",SpielerName(playerid),haus);
					    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
						return 1;
					}
				}
			}
		}
		for(new i=0;i<sizeof(Fraktionsbase);i++)
		{
			if(IsPlayerInRangeOfPoint(playerid,1,Fraktionsbase[i][fbaseenterX],Fraktionsbase[i][fbaseenterY],Fraktionsbase[i][fbaseenterZ]) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
			{
				if(Fraktionsbase[i][fbaselocked] == 0)return GameTextForPlayer(playerid,"~r~Base nicht abgeschlossen!",1000,1);
				PlayerHearMusicInRange(Fraktionsbase[i][fbaseenterX],Fraktionsbase[i][fbaseenterY],Fraktionsbase[i][fbaseenterZ],15805,15.0,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
				SetPlayerPosEx(playerid,Fraktionsbase[i][fbaseexitX],Fraktionsbase[i][fbaseexitY],Fraktionsbase[i][fbaseexitZ]);
				SetPlayerInterior(playerid,Fraktionsbase[i][fbaseinterior]);
				SetPlayerVirtualWorld(playerid,Fraktionsbase[i][fbasevirtualworld]);
				Fraktionsbase[i][fbaselocked] = 0;
				UpdateFbase3DText(i);
				format(string,sizeof(string),"** %s tritt die Tür der %s ein **",SpielerName(playerid),FraktionsName(Fraktionsbase[i][fbasefraktid]));
			    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				return 1;
			}
			if(IsPlayerInRangeOfPoint(playerid,1,Fraktionsbase[i][fbaseexitX],Fraktionsbase[i][fbaseexitY],Fraktionsbase[i][fbaseexitZ]) && GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == Fraktionsbase[i][fbaseinterior])
			{
				if(Fraktionsbase[i][fbaselocked] == 0)return GameTextForPlayer(playerid,"~r~Base nicht abgeschlossen!",1000,1);
				PlayerHearMusicInRange(Fraktionsbase[i][fbaseexitX],Fraktionsbase[i][fbaseexitY],Fraktionsbase[i][fbaseexitZ],15805,15.0,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
				SetPlayerPosEx(playerid,Fraktionsbase[i][fbaseenterX],Fraktionsbase[i][fbaseenterY],Fraktionsbase[i][fbaseenterZ]);
				SetPlayerInterior(playerid,0);
				SetPlayerVirtualWorld(playerid,0);
				Fraktionsbase[i][fbaselocked] = 0;
				UpdateFbase3DText(i);
				format(string,sizeof(string),"** %s tritt die Tür der %s ein **",SpielerName(playerid),FraktionsName(Fraktionsbase[i][fbasefraktid]));
			    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				return 1;
			}
		}
		for(new sm=1;sm<MAX_SMARKETS;sm++)
		{
			if(SmarkInfo[sm][screatet] == 1)
			{
				if(IsPlayerInRangeOfPoint(playerid,1.5,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]))
				{
					if(SmarkInfo[sm][sfraktid] == 0)return GameTextForPlayer(playerid,"~r~unbetrettbar",2000,1);
					if(SmarkInfo[sm][slocked] == 0)return GameTextForPlayer(playerid,"~r~Schwarzmarkt nicht abgeschlossen!",1000,1);
				    PlayerHearMusicInRange(SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz],15805,15.0,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
					SetPlayerPosEx(playerid,944.8334,788.1722,-18.9141);
				    SetPlayerInterior(playerid,0);
				    SetPlayerVirtualWorld(playerid,sm);
				    PlayerTextDrawShow(playerid,INFOdraw[playerid][0]);
					PlayerTextDrawSetString(playerid,INFOdraw[playerid][0],"~b~Taste N:~n~~w~beliebigen Gegenstand kaufen");
					SmarkInfo[sm][slocked] = 0;
					UpdateSmarkLabel(sm,1);//funktion 1 wenn der smark ohne frakt ist,funktion 2 wenn der smarkt mit frakt besetzt ist
				    format(string,sizeof(string),"** %s tritt die Tür des Schwarzmarktes der %s ein **",SpielerName(playerid),FraktionsName(SmarkInfo[sm][sfraktid]));
				    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
					return 1;
				}
				if(IsPlayerInRangeOfPoint(playerid,1.5,944.8334,788.1722,-18.9141) && GetPlayerVirtualWorld(playerid) == sm)
				{
					if(SmarkInfo[sm][slocked] == 0)return GameTextForPlayer(playerid,"~r~Schwarzmarkt nicht abgeschlossen!",1000,1);
				    PlayerHearMusicInRange(944.8334,788.1722,-18.9141,15805,15.0,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
					SetPlayerPosEx(playerid,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]);
					SetPlayerVirtualWorld(playerid,0);
					SetPlayerInterior(playerid,0);
					PlayerTextDrawHide(playerid,INFOdraw[playerid][0]);
					SmarkInfo[sm][slocked] = 0;
					UpdateSmarkLabel(sm,1);//funktion 1 wenn der smark ohne frakt ist,funktion 2 wenn der smarkt mit frakt besetzt ist
				    format(string,sizeof(string),"** %s tritt die Tür des Schwarzmarktes der %s ein **",SpielerName(playerid),FraktionsName(SmarkInfo[sm][sfraktid]));
				    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
					return 1;
				}
			}
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Hauses/Schwarzmarktes oder eines Fraktionshauses.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:tazer(playerid,const params[])
{
 	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16)){
		strdel(edit_2,0,sizeof(edit_2));
		strcat(edit_2,""HTML_BLAU"1."HTML_WEISS" Aus dem Holster nehmen\n");
		strcat(edit_2,""HTML_BLAU"2."HTML_WEISS" In dem Holster stecken\n");
		strcat(edit_2,""HTML_BLAU"2."HTML_WEISS" Batterie\n");
		strcat(edit_2,""HTML_BLAU"2."HTML_WEISS" Informationen\n");
		ShowPlayerDialog(playerid,DIALOG_TAZERSYS,DIALOG_STYLE_LIST,""ClanTagDialoge" Tazer",edit_2,"Aktion","Abbrechen");
	}else{
		SCM(playerid,SAMP_WEISS,""IINFO" du darfst das nicht!");
	}
	return 1;
}
COMMAND:tazer_3(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[10],string[350];
 	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    if(Spieler[playerid][pTazer] == 0)return SCM(playerid,SAMP_WEISS,"Kein Tazer dabei.");
	    if(Spieler[playerid][pTazerd] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist getazert.");
	    if(sscanf(params,"s[10]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /tazer [rauslegen/reinlegen/Akku/Info]");
	    if(strcmp(cmd,"rauslegen",true) == 0)
		{
			if(Spieler[playerid][pTazerInorOutbag] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast deinen Tazer bereits rausgenommen.");
			format(string,sizeof(string),"** %s holt seinen Tazer aus dem Holster raus **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			SCM(playerid,SAMP_WEISS,"Mit der Taste "IINFO2"N"#HTML_WEISS" kannst du den Tazer verwenden!");
			Spieler[playerid][pTazerTimer] = SetTimerEx("TazerAkku",30000,true,"i",playerid);
			SetPlayerAttachedObject(playerid,4,18642,5,0.088999,0.039999,-0.028000);
			Spieler[playerid][pTazerInorOutbag] = 1;
			return 1;
		}
	    if(strcmp(cmd,"reinlegen",true) == 0)
		{
			if(Spieler[playerid][pTazerInorOutbag] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast deinen Tazer bereits in deinem Holster.");
		    format(string,sizeof(string),"** %s legt seinen Tazer in seinem Holster **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		    RemovePlayerAttachedObject(playerid,4);
		    KillTimer(Spieler[playerid][pTazerTimer]);
		    Spieler[playerid][pTazerInorOutbag] = 0;
			return 1;
		}
		if(strcmp(cmd,"Akku",true) == 0)
		{
			if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Fahrzeug!");
		    if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 509 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 481 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 510 || IsVehABike(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Nur in Überdachten Fahrzeugen möglich.");
			if(Spieler[playerid][pTazerAkku] == 100)return SCM(playerid,SAMP_WEISS,""IINFO" dein Tazer hat noch genug Power!");
		    Spieler[playerid][pTazerAkku] = 100;
		    SCM(playerid,SAMP_WEISS,""IINFO" Tazerakku wurde aufgeladen.");
			return 1;
		}
		if(strcmp(cmd,"Info",true) == 0)
		{
			format(string,sizeof(string),""#HTML_WEISS"Name: "IINFO2"Tazer"#HTML_WEISS"\nAkkuzustand: "IINFO2"%i",Spieler[playerid][pTazerAkku]);
			ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Mein Tazer",string,"Okay","");
			return 1;
		}
	    return SCM(playerid,SAMP_WEISS,"");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:checkpunkte(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,11))
    {
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /checkpunkte [playerid/Name]");
	    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(Spieler[pID][pSTVOpoints] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keine STVO-Punkte.");
		format(string,sizeof(string),"%s (ID:%i) | %i STVO-Punkte",SpielerName(pID),pID,Spieler[pID][pSTVOpoints]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:checkgun(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],index = 0;
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
    {
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /checkgun [playerid/Name]");
	    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    new WEAPON:waffe,muni;
	    format(string,sizeof(string),"[_____Waffen von %s_____]",SpielerName(pID));
	    SCM(playerid,SAMP_WEISS,string);
		for(new i=0;i<13;i++)
		{
			GetPlayerWeaponData(pID,WEAPON_SLOT:i,waffe,muni);
			if(waffe != WEAPON_FIST)
			{
				format(string,sizeof(string)," %i: %s %i Munition",i,SpielerWaffenName(waffe),muni);
				SCM(playerid,SAMP_WEISS,string);
				index++;
			}
		}
		if(index == 0)return SCM(playerid,SAMP_WEISS,"Keine.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:checkwanteds(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
    {
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /checkwanteds [playerid/Name]");
	    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(Spieler[pID][pWantedPoints] == 0)return SCM(playerid,SAMP_WEISS,"Spieler hat keine Wanteds.");
		format(string,sizeof(string),"%s (ID:%i) | %i Wantedpunkte | %s,%s,%s,%s,%s",SpielerName(pID),pID,Spieler[pID][pWantedPoints],pWantedReason1[pID],pWantedReason2[pID],pWantedReason3[pID],pWantedReason4[pID],pWantedReason5[pID]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:gesuchte(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[950],gesuchtewpsplayer = 0;//fv = IsAFraktionsVeh(playerid);
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
	{
	   	//if(Spieler[playerid][pFunkgeraet] != 0 || FraktionsAktenPCs(playerid) || fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		//{
		   	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
			//SCM(playerid,SAMP_WEISS,"Gesuchte Personen:");
		    ForEachPlayer(p)
		    {
				if(IsPlayerConnected(p) && !IsPlayerNPC(p))
				{
					if(GetPVarInt(p,"Eingeloggt") == 1)
					{
	        			if(Spieler[playerid][pAdminOnduty] == false)
				        {
	        				if(Spieler[p][pAtReport] == 0)
		        			{
								if(Spieler[p][pWantedPoints] > 0)
								{
									format(string,sizeof(string),"%s%s (ID:%i) | %i Wantedpunkte | %s,%s,%s,%s,%s",string,SpielerName(p),p,Spieler[p][pWantedPoints],pWantedReason1[p],pWantedReason2[p],pWantedReason3[p],pWantedReason4[p],pWantedReason5[p]);
									//SCM(playerid,SAMP_WEISS,string);
									ShowPlayerDialog(playerid,9945,DIALOG_STYLE_LIST,"w",string,"Okay","");
									gesuchtewpsplayer++;
								}
							}
						}
					}
				}
			}
			if(gesuchtewpsplayer == 0)return SCM(playerid,SAMP_WEISS,""IINFO" zurzeit kein Spieler in Fahndung.");
			return 1;
		//}
		//return SCM(playerid,SAMP_WEISS,""IINFO" du trägst kein Funkgerät mit dir./Du sitzt in keinem Fraktionsfahrzeug./Du bist an keinem Aktencomputer.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
