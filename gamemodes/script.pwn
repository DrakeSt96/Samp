					    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][0]);
					    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][1]);
					    TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][2]);
						TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][3]);
