COMMAND:delmoney(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new geld,string[128];
	//if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
    if(sscanf(params,"i",geld))return SCM(playerid,SAMP_WEISS,""IINFO" /delmoney [Betrag]");
	if(geld <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" /delmoney [Betrag 0-unbegrenzt]");
	if((GetACMoney(playerid) - geld) < 0)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht löschen!");
    format(string,sizeof(string),"** Du hast %s$ vom Server gelöscht **",geld);
    SCM(playerid,0xAF2800FF,string);
    format(string,sizeof(string),"** %s hat %i$ vom Server gelöscht **",SpielerName(playerid),geld);
    SendAdminMessage(0xAF2800FF,string);
    ACMoney(playerid,-geld);
    return 1;
}
COMMAND:cc(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[128],text[91];
    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
    if(Spieler[playerid][pMuted] == 1)
	{
		format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		return SCM(playerid,WEISS,string);
	}
	if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /cc(carchat) [Text]");
	if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /cc(carchat) [Text darf maximal 90 Zeichen beinhalten]");
	for(new i=0;i<sizeof(BadWord);i++)
	{
	 	if(strfind(text,BadWord[i],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /cc(carchat)",BadWord[i],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
    }
    new strpos = strfind(text,"www",true);
	if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
	{
		strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
		return 1;
	}
	if(GetPlayerVehicleSeat(playerid) == 0)format(string,sizeof(string),"Fahrer %s: %s",SpielerName(playerid),text);
	else format(string,sizeof(string),"{6F7374}Beifahrer %s:{fafafa} %s",SpielerName(playerid),text);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid))
				{
					if(IsPlayerInVehicle(i,GetPlayerVehicleID(playerid)))
					{
						SCM(i,SAMP_WEISS,string);
					}
				}
				if(Spieler[i][IreadALL] == 1)
				{
					SCM(i,SAMP_WEISS,string);
				}
			}
		}
	}
	return 1;
}
COMMAND:s(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[128],text[91];
    if(Spieler[playerid][pMuted] == 1)
	{
		format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		SCM(playerid,WEISS,string);
		format(string,sizeof(string),"** %s kann nicht schreien,da er gemutet ist **",SpielerName(playerid));
		return PlayerTalkOnly(playerid,0xF0F0F0FF,string,10);
	}
	if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /s(chreien) [Text]");
	if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /s(chreien) [Text darf maximal 90 Zeichen beinhalten]");
	for(new i=0;i<sizeof(BadWord);i++)
	{
	 	if(strfind(text,BadWord[i],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /s(houtchat)",BadWord[i],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
    }
    new strpos = strfind(text,"www",true);
	if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
	{
		strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
		return 1;
	}
	if(Spieler[playerid][pAdminOnduty] == false)
	{
		format(string,sizeof(string),"{6F7374}%s (schreit):{fafafa} %s!",SpielerName(playerid),text);
		PlayerTalkPublic(playerid,SAMP_WEISS,string,50);
	}
	else
	{
		format(string,sizeof(string),"{6F7374}%s (schreit):{fafafa} %s!",SpielerName(playerid),text);
		PlayerTalkPublic(playerid,SAMP_WEISS,string,50);
	}
	return 1;
}
