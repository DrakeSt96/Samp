				for(new i=0;i<sizeof(sBuyInfo);i++){ SmartkWaffenLabel[sm+1][i] = CreateDynamic3DTextLabel(sBuyInfo[i][sbuyweaponname],SMARKWEAPONCOLOR,sBuyInfo[i][sbuyx],sBuyInfo[i][sbuyy],sBuyInfo[i][sbuyz],1.5,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,sm+1); }
