			if((Pos[0] > -992.5172 && Pos[0] < 4000.0000) && (Pos[1] < 528.0000 && Pos[1] > -4000.0000)) //Los Santos
			{
				format(GlobalString,sizeof(GlobalString),"SA-LS-%i",MAX_VEHICLES-i);
			}
			if((Pos[0] > -4000.0000 && Pos[0]< -992.5172) && (Pos[1] < 4000.0000 && Pos[1] > -4000.0000)) //San Fierro
			{
				format(GlobalString,sizeof(GlobalString),"SA-SF-%i",MAX_VEHICLES-i);
			}
			if((Pos[0] > -992.5172 && Pos[0]< 4000.0000) && (Pos[1] < 4000.0000 && Pos[1] > 528.0000)) //Las Venturas
			{
				format(GlobalString,sizeof(GlobalString),"SA-LV-%i",MAX_VEHICLES-i);
			}
			SetVehicleNumberPlate(i,GlobalString);
