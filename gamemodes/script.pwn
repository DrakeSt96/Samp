				    strdel(result,0,sizeof(result));
				    strdel(savestring,0,sizeof(savestring));
				    format(savestring,sizeof(savestring),"CP_SIZE%i",rcp);
					cache_get_field_content(r,savestring,result);
				    RACE_CP_SIZE[r][rcp-1] = floatstr(result);
				    strdel(result,0,sizeof(result));
				    strdel(savestring,0,sizeof(savestring));
					if(RaceInfo[r][rcp-1][0] != 0.0 && RaceInfo[r][rcp-1][1] != 0.0 && RaceInfo[r][rcp-1][2] != 0.0)
					{
						RaceInfoUsed[r][rcp-1] = 1;
					}
			    }
			    RaceCreated[r] = 1;
				r++;
			}
		}
