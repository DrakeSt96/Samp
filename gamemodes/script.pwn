COMMAND:help(playerid,const params[])
{
	#pragma unused params
	strdel(edit_2,0,sizeof(edit_2));
	strcat(edit_2,""HTML_BLAU"1."HTML_WEISS" Allgemeine | Befehle\n");
	strcat(edit_2,""HTML_BLAU"2."HTML_WEISS" Job | Befehle\n");
	strcat(edit_2,""HTML_BLAU"3."HTML_WEISS" Haus | Befehle\n");
	strcat(edit_2,""HTML_BLAU"4."HTML_WEISS" Business | Befehl\n");
	strcat(edit_2,""HTML_BLAU"5."HTML_WEISS" Animation | Befehle\n");
	strcat(edit_2,""HTML_BLAU"6."HTML_WEISS" Fischesys | Befehle\n");
	strcat(edit_2,""HTML_BLAU"8."HTML_WEISS" Handy | Befehle\n");
	strcat(edit_2,""HTML_BLAU"9."HTML_WEISS" Bankkonto | Befehle\n");
	strcat(edit_2,""HTML_BLAU"10."HTML_WEISS" Mieter | Befehle\n");
	strcat(edit_2,""HTML_BLAU"11."HTML_WEISS" Fraktions | Befehle\n");
	strcat(edit_2,""HTML_BLAU"12."HTML_WEISS" Fahrzeug | Befehle\n");
	strcat(edit_2,""HTML_BLAU"13."HTML_WEISS" Firma | Befehle\n");
	ShowPlayerDialog(playerid,DIALOG_HELPSYS32,DIALOG_STYLE_LIST,""ClanTagDialoge" Hilfestellung",edit_2,"Ansehen","Abbrechen");
	return 1;
}
COMMAND:freundhelp(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	strdel(edit_2,0,sizeof(edit_2));
	strcat(edit_2,""#HTML_WEISS" /freund hinzufügen (playerid) "#HTML_GRAU"- um ein Freund hinzuzufügen\n");
	strcat(edit_2,""#HTML_WEISS" /freund löschen (playerid) "#HTML_GRAU"- um ein Freund zu entfernen.\n");
	strcat(edit_2,""#HTML_WEISS" /faccept "#HTML_GRAU"- um die Freundschaftsanfrage zu acceptieren.\n");
	strcat(edit_2,""#HTML_WEISS" /fonline "#HTML_GRAU"- um zu sehen wer von deine Freunde Online sind.\n");
	strcat(edit_2,""#HTML_WEISS" /fsend "#HTML_GRAU"- um einem Freund eine Nachricht zu senden.\n");
	strcat(edit_2,""#HTML_WEISS" /fsendall "#HTML_GRAU"- um alle deine Freunde eine Nachricht zu senden.\n");
	ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Freundschafts -> Help",edit_2,"Zurück","Abbrechen");
	return 1;
}
COMMAND:ghelp_3(playerid,const params[])
{
	#pragma unused params
	new string[2600];
	strcat(string,""#HTML_WEISS"Allgemein{FFFFFF}:\n/stats | /id | /myfps | /aimbottest | /muenze | /scheine | /tasche | /blacklists\n/show | /use | /buylevel | /outfit | /fightstyle | /stadthalle | /rob | /driveby | /afk | /back\n");
	strcat(string,""#HTML_WEISS"/lock | /fahrlehrer | /medics | /admins | /anwaelte | /makler | /fillveh | /repairveh | /rent | /unrent\n/helm | /knastzeit | /friedhofzeit | /fraktionen | /give | /rentveh \n");
	strcat(string,""#HTML_WEISS"/stadium | /accept | /cancel | /job | /waffenschein | /anmelden | /gwdnote | /zivinote | /aufzug\n/delcheck | /pbexit | /pbenter | /telefonzelle | /telefonbuch | /service | /saveme | /streamfix | /delclothes\n\n");
	strcat(string,""#HTML_WEISS"Drop-Pickupsystem{FFFFFF}:\n/koffer | /ownkofferinfo | /kofferinfo\n\n");
	strcat(string,""#HTML_WEISS"Extras{FFFFFF}:\n/spawnchange | /tog | /vertrag | /jackpot | /zoll | /me | /oc | /s | /cc | /r | /c | /b\n/wiw | /geworben\n\n");
	strcat(string,""#HTML_WEISS"Support{FFFFFF}:\n/report | /cheater | /melden | /rtclose\n\n");
	strcat(string,""#HTML_WEISS"Unterwegs{FFFFFF}:\n/drivein | /navi | /driveby | /readnewspaper | /buyzig | /dice | /wuerfeln | /parachute | /kartbahn | /eh | /pfreikaufen\n\n");
	strcat(string,""#HTML_WEISS"Kaufen:\n/buy\n\n");
	strcat(string,""#HTML_WEISS"Hitman:\n/contract\n\n");
	strcat(string,""#HTML_WEISS"Sounds:\n/audiomsg\n\n");
	if(Spieler[playerid][pPremium] > gettime())
	{
		strcat(string,"{99FF00}Donator Status{FFFFFF}:\nDu hast mit dem Donator Status folgende Vorteile:\n - Mehr Zinsen am Zahltag\n - Doppelte Respektpunkte am Zahltag\n - Du kannst "#MAX_BUSINESS_OWNER" Businesse besitzen\n");
		strcat(string,"{FFFFFF} - Du kannst bei "#MAX_BUSINESS_COOWNER" Businessen nebenbei Teilhaber sein\n - Du kannst "#MAX_PLAYER_VEHS" Fahrzeuge besitzen\n - Du kannst die Ego Perspektive benutzen (/firstperson)\n\n");
	}
	ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Hilfe Allgemein",string,"Zurück","Abbrechen");
	return 1;
}
COMMAND:handyhelp_3(playerid,const params[])
{
	#pragma unused params
    if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
    ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Handyhilfe",""#HTML_BLAU"Befehle{FFFFFF}:\n/handy | /akku | /pickup | /hangup | /nummer | /call | /sms | /service | /quitflat | /befreien","Zurück","Abbrechen");
	return 1;
}
COMMAND:jobhelp_3(playerid,const params[])
{
	#pragma unused params
	new string[2600];
    if(isPlayerInJob(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Job.");
	switch(Spieler[playerid][pJob])
	{
		case 1:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Müllmann/frau hast du die Aufgabe die Häuser in San Andreas anzufahren und deren Müll abzuholen.\nSollte dein Müllwagen voll sein so fahre zur Mülldeponie in Los Santos und bringe den Müll dort hin.\nBefehle: /loadrubbish,/unloadrubbish,/loadrubbishstatus,/landfill,/op,/accept rubbish\nKündigen: /quitjob\nChat: /j(obchat)","Zurück","Abbrechen");
	    case 2:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Stadtreiniger/in hast du die Aufgabe die Straßen von San Andreas sauber zu halten !\nSteige um den Job auszuführen in ein Reinigungsfahrzeug und befolge die weiteren Anweisungen.\nBefehle: /loaddirtstatus,/unloaddirt,/cleanmachine\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 3:
		{
		strcat(string,"Als Fluglieferant|Versorgungsflieger|Feldbewässerer/in hast du viele verschiedene Aufgaben. Jede dieser Jobunterteilungen hat eine andere wichtige Aufgabe!\nNutze '/stopjob' um den Job zu beenden !\nKündigen: /quitjob\nChat: /j(obchat)\n");
		strcat(string,"Als Fluglieferant|Versorgungsflieger hast du die Aufgabe mehrere Punkte abzufliegen und Waren auszuliefern.\nAls Feldbewässerer hast du die Aufgabe Felder mit Pestiziden zu besprühen.");
		ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe",string,"Zurück","Abbrechen");
		}
	    case 4:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Postbote hast du die Aufgabe Los Santos mit Papieren/Briefen/Paketen zu versorgen.\nJob: Steige in einen Transporter (Boxville) und wähle aus welche Route du fahren willst.\nFahre anschließend die angegebenen Häuser/Orte ab um die Papieren/Briefen/Paketen auszuliefern.\nNutze '/stopjob' um den Job zu beenden.\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 5:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Detektiv hast du die Aufgabe gestellt Aufträge von Spielern anzunehmen und erfolgreich auszuführen.\nDie Aufträge können natürlich auch gegen entgegenzahlung ausgeführt werden.\nBefehle: /find,/findveh,/delcheck\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 6:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Landwirt/in hast du die Aufgabe die Farmen von San Andreas erfolgreich abzuernten.\nSteige in ein Mähdrescher und entscheide ob du den Job starten oder auch abbrechen willst !?\nBefehle: /entladen\nNutze '/stopjob' um den Job zu beenden !\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 7:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Eisverkäufer/in hast du die Aufgabe San Andreas an heißen Sommertagen kühl zu halten.\nBringe dein Eis unter das Volk und verdiene dir deinen hart erarbeiteten Lohn.\nBefehle: /sellice\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 8:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Bauarbeiterbelieferer/in hast du die Aufgabe Klohäusschen zur Baustelle zu fahren.\nDu musst mit einem Truck das Klohäuschen abholen und sicher zum Abgabepunkt fahren\nBefehle: /bstarten,/baufladen,/\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 9:
		{
			strdel(edit_2,0,sizeof(edit_2));
            strcat(edit_2,""#HTML_WEISS" Steige in einem Geldtransporter und fülle die Geldautomaten auf, dies ist ein sehr gefährlicher Job!\n\n");
            strcat(edit_2,""#HTML_WEISS" /j(text) "#HTML_GRAU"- mit Leuten schreiben die den gleichen Job machen.\n");
            strcat(edit_2,""#HTML_WEISS" /jtmenu "#HTML_GRAU"- ein Menü mit erweiterte Funktionen.\n");
            strcat(edit_2,""#HTML_WEISS" /fillatm "#HTML_GRAU"- um ein Geldautomat zu befüllen.\n");
            strcat(edit_2,""#HTML_ORANGE" Wenn du deinen Job kündigen möchtest, gehe hierfür zum deinem Icon.\n");
			ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Jobhilfe -> Geldtransporter",edit_2,"Zurück","Abbrechen");
		}
	    case 10:
		{
		strcat(string,"Als Trucker/in hast du die Aufgabe Waren,Autoteile,Bauschutt,Kraftstoff sowie Eisen in ganz San Andreas auszuliefern.\n");
		strcat(string,"Je nach Route entscheidet sich,was du wohin ausliefern musst.\nDie verschiedenen Routen kannst du beim besteigen eines Trucks auswählen.\nBefehle: /ladung,/searchtrailer\nNutze '/stopjob' um den Job zu beenden !\nKündigen: /quitjob\nChat: /j(obchat)");
		ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe",string,"Zurück","Abbrechen");
		}
		case 11:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Busfahrer/in hast du die Aufgabe viele Bushaltestellen in San Andreas anzufahren.\nSteige in ein Bus und wähle aus welche Linie du fahren willst! Gebe anschließend den Fahrticketpreis an.\nKündigen: /quitjob\nChat: /j(obchat)","Zurück","Abbrechen");
	    case 12:{
			strdel(edit_2,0,sizeof(edit_2));
            strcat(edit_2,""#HTML_WEISS"Als KFZ-Mechaniker/in hast du die Aufgabe kaputte sowie zerstörte Fahrzeuge wieder herzurichten,\nsowohl auch zu betanken.\n\n");
            strcat(edit_2,""#HTML_WEISS" /j(text) "#HTML_GRAU"- mit Leuten schreiben die den gleichen Job machen.\n");
            strcat(edit_2,""#HTML_WEISS" /msellrepair "#HTML_GRAU"- eine Fahrzeug reperatur anbieten.\n");
            strcat(edit_2,""#HTML_WEISS" /msellrefill "#HTML_GRAU"- um jemand eine Tankfüllung anzubieten.\n");
            strcat(edit_2,""#HTML_WEISS" /op job "#HTML_GRAU"- um dir die eingekommende Aufträge anzusehen.\n");
            strcat(edit_2,""#HTML_WEISS" /accept mechaniker "#HTML_GRAU"- um ein Auftrag anzunehmen.\n");
            strcat(edit_2,""#HTML_WEISS" /mauspumpen "#HTML_GRAU"- um das Fahrzeug von einer falschen Tankfüllung leer zu pumpen.\n");
            strcat(edit_2,""#HTML_ORANGE" Wenn du deinen Job kündigen möchtest, gehe hierfür zum deinem Icon.\n");
			ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Jobhilfe -> Geldtransporter",edit_2,"Zurück","Abbrechen");
		}
	    case 13:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Prostituierte hast du die Aufgabe Bedürfnisse von Spielern zu erfüllen.\nBefehle: /sex\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 14:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Waffendealer hast du die Aufgabe so geheim wie möglich Waffen unter das Volk zu bringen.\nDoch wie kann man mit Waffen dealen,wenn man nicht die nötigen Materialien hat ?!\nFahre die Materialpunkte ab um Materials herzustellen.\nMaterials: /getmats,/delmats\nBefehle: /eisenlager,/sellgun,/gunlist,/showgunlist\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 15:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Drogendealer hast du die Aufgabe mit geschick die Drogen unter das Volk zu mischen.\nUm an Drogen ran zu kommen solltes du dich kundig machen.\nMan munckelt drüber das Gangs/Mafien Drogen verkaufen.\nVersuche mit Ihnen Kontakt aufzunehmen um an die Drogen herran zukommen.\nBefehle: /selldrugs\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 16:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Anwalt/Anwältin hast du die Aufgabe deine Clienten durch Kaution aus dem Gefängnis freizuklagen !\nJedoch brauchst du dafür eine Genehmigung eines Staatsbeamten.\nBefehle: /kaution,/gefangene\nKündigen: /quitjob","Zurück","Abbrechen");
	    case 17:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Taxifahrer/in hast du die Aufgabe.\nDie Aufträge von Spielern die in Eile sind anzunehmen.\nUnd sie zu ihrem gewünschten Ort zu fahren.\nBefehle: /fare,/op,/accept taxi\nKündigen: /quitjob\nChat: /j(obchat)","Zurück","Abbrechen");
	    case 18:
		{
		strcat(string,"Als Immobilienmakler/in hast du die Aufgabe Immobilien sprich Häuser/Businesse im Auftrag des Besitzers an andere User zuverkaufen.\n");
		strcat(string,""IINFO" du kannst auch Schlüssel von der Stadt anfordern um beispielsweise Besichtigungstouren zu verstanstalten.\nDen Schlüssel kann man in jeder Stadthalle im 3´ten Stockwerk anfordern.\nBefehle: /immobilie,/applyforhousekey,/maklerlock\nKündigen: /quitjob");
		ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe",string,"Zurück","Abbrechen");
		}
	    case 19:
		{
			ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Steige in einen der Transporter und fahre zur Fabrik.\nSolltest du dort sein so belädst du deinen Transport mit /loadzig.\nSolltest du deinen Transporter beladen haben so fahre zu einem Zigarettenautomat und fülle ihn mit /fillztm auf.\nBefehle: /loadzig,/fillztm,/loadzigstatus,/loadzigpoint,/allthinginfo\nKündigen: /quitjob\nChat: /j(obchat)","Zurück","Abbrechen");
		}
		case 20:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Minenarbeiter/in hast du die Aufgabe die Erzberge in der Las Venturas Erzgrube nach und nach Abzubaggern.\nBefehle: /startbaggern\nKündigen: /quitjob\nChat: /j(obchat)","Zurück","Abbrechen");
		case 27:ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Jobhilfe","Als Bestatter/in hast du die Aufgabe die Leichen in San Andreas in das Leichenbestatterhaus zu liefern.\nBefehle: /bestatten, /op, /leiche, /accept bestatten\nKündigen: /quitjob\nChat: /j(obchat)","Zurück","Abbrechen");
    }
	return 1;
}
COMMAND:bankhelp_3(playerid,const params[])
{
	#pragma unused params
	ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Bank-/Geldhilfe",""#HTML_BLAU"Befehle{FFFFFF}:\n/bankmenu | /pay | /bankraub | /bank | /safe | /bankpin","Zurück","Abbrechen");
	return 1;
}
COMMAND:haushelp_3(playerid,const params[])
{
	#pragma unused params
    ReturnPropertyData(playerid);
    new count = Spieler[playerid][pReturnPropertyDataHausCount],string[356];
    if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
    strcat(string,""#IINFO2"Haus Menü: "HTML_GRAU"/haus\n");
    strcat(string,""#IINFO2"Mieter: "HTML_GRAU"/mieter | /rauswerfen | /allerauswerfen | /listhausguns | /hausgun\n");
	ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Hilfestellung -> Haushilfe",string,"Zurück","Abbrechen");
	return 1;
}
COMMAND:renthelp_3(playerid,const params[])
{
	#pragma unused params
    new haus = Spieler[playerid][pRentHome];
    if(haus == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Haus eingemietet.");
    ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Hausmieter",""#HTML_BLAU"Befehle{FFFFFF}:\n/haus heal | /haus armour | /rent zimmer/room | /unrent zimmer/room","Zurück","Abbrechen");
	return 1;
}

COMMAND:bizhelp_3(playerid,const params[])
{
	#pragma unused params
	new biz = IsPlayerAnyBusinessOwner(Spieler[playerid][pName]);
	if(biz == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Business.");
	ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Businesshilfe",""#HTML_BLAU"Kaufen/Verkaufen{FFFFFF}:\n/kaufen | /bizverkaufen\n\n"#HTML_BLAU"Businessverwaltung{FFFFFF}:\n/bizmenu | /bizlock | /mybizpartner | /kickmybizpartner | /buyrentvehs","Zurück","Abbrechen");
	return 1;
}

