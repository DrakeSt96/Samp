COMMAND:spawnall(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new string[128];
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
    format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat alle Spieler zum Spawn geschickt.",Spieler[playerid][pName],playerid);
    SendClientMessageToAll(0x4BB400FF,string);
    ForEachPlayer(i)
    {
	    if(IsPlayerConnected(i)&& !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
			    if(playerid != i)
			  	{
					Spieler[i][pIssureKiller] = -1;
					Spieler[i][pRevived] = 0;
					Spieler[i][pRobProtect] = 0;
					Spieler[i][pInHospital] = 0;
					Spieler[i][pNextDeath] = 0;
				    Spieler[i][pDeath] = 0;
				    Spieler[i][pDeathTime] = 0;
				    Spieler[i][pFriedhof] = 0;
					Spieler[i][pFriedhofTime] = 0;
					SpawnPlayerEx(i);
			    }
		    }
	    }
    }
    return 1;
}

COMMAND:buylevel(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new string[128];
    if(Spieler[playerid][pRespektFromPayday] < Spieler[playerid][pRespektToLevelUp])return SCM(playerid,SAMP_WEISS,"Nicht genügend Respektpunkte.");
	if((GetACMoney(playerid) - Spieler[playerid][pLevelKosten]) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei.");
	ACMoney(playerid,-Spieler[playerid][pLevelKosten]);
	SetPlayerLevel(playerid,GetPlayerLevel(playerid) + 1);
	format(string,sizeof(string),"~w~Level ~b~%i ~w~erreicht",GetPlayerLevel(playerid));
    GameTextForPlayer(playerid,string,5000,1);
    format(string,sizeof(string),""IINFO" du hast dir das Level "HTML_BLAU"%i"HTML_WEISS" gekauft!",GetPlayerLevel(playerid));
    SCM(playerid,SAMP_WEISS,string);
	SetPlayerChatBubble(playerid,"Level Up",SAMP_WEISS,MAX_STREAM_NAME_DISTANCE,10000);
	if(Spieler[playerid][HatGeworben] == 2 && GetPlayerLevel(playerid) == 5)
	{
		new personalid = GetPlayerID(Spieler[playerid][GeworbenPlaya]);
		if(personalid == -1)
		{
			mysql_format(MySQL_R394,string,sizeof(string),"SELECT * FROM spieler WHERE Name='%e'",Spieler[playerid][GeworbenPlaya]);
			mysql_function_query(MySQL_R394,string,true,"sql_array2","siii",string,_SQL_SETPREMIUM,0,MySQL_R394);
		}
		else
		{
 			format(string,sizeof(string),""IINFO" da du "HTML_BLAU"%s"HTML_WEISS" geworben hast bekommst du nun 30 Coins!",Spieler[playerid][GeworbenPlaya]);
			SCM(personalid,WEISS,string);
		    Spieler[personalid][pCoins] += 30;
		}
	}
	switch(GetPlayerLevel(playerid))
	{
	    case 5:
	    {
			SCM(playerid,SAMP_WEISS,""IINFO" Klasse, du hast Level 5 erreicht du bekommst von uns als dankeschön [1000 Euro + 30 Coins]");
			Spieler[playerid][pCoins] += 30;
			ACMoney(playerid,1000);
		}
	    case 10:
	    {
	        SCM(playerid,SAMP_WEISS,""IINFO" Klasse, du hast Level 10 erreicht du bekommst von uns als dankeschön [2000 Euro + 70 Coins]");
	        Spieler[playerid][pCoins] += 70;
	        ACMoney(playerid,2000);
		}
	    case 15:
	    {
			SCM(playerid,SAMP_WEISS,""IINFO" Klasse, du hast Level 15 erreicht du bekommst von uns als dankeschön [3000 Euro + 140 Coins]");
			Spieler[playerid][pCoins] += 140;
			ACMoney(playerid,3000);
		}
	    case 20:
	    {
    		SCM(playerid,SAMP_WEISS,""IINFO" Klasse, du hast Level 20 erreicht du bekommst von uns als dankeschön [100000 Euro + 280 Coins]");
    		Spieler[playerid][pCoins] += 280;
    		ACMoney(playerid,100000);
		}
	}
    return 1;
}
COMMAND:animlist(playerid,const params[])
{
    #pragma unused params
    if(IsPlayerInWater(playerid))return SCM(playerid,SAMP_WEISS,"Im Wasser sind keine Animationen möglich!");
    SCM(playerid,SAMP_WEISS,"--> Animationen <--");
	SCM(playerid,SAMP_WEISS,"[/handsup /piss /wank /callanim /stopcall /drink /bomb /getarrested /laugh /lockat /aim /crossarms]");
	SCM(playerid,SAMP_WEISS,"[/lay /hide /eat /puke /wave /slapass /deal /die /kiss1-4 /police1-8 /blow1-12 /smoke1-2 /groundsit]");
	SCM(playerid,SAMP_WEISS,"[/fucku /chat /taichi /chairsit /revive /dance1-4] /push /dig");
    return 1;
}
COMMAND:handsup(playerid,const params[])
{
	#pragma unused params
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst im Auto keine Animation abspielen.");
	if(IsPlayerInWater(playerid))return SCM(playerid,SAMP_WEISS,"Im Wasser sind keine Animationen möglich!");
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	gPlayerUsingLoopingAnim[playerid] = true,SetPlayerSpecialAction(playerid,SPECIAL_ACTION_HANDSUP);
	animak[playerid] = true;
	HandsUpPerson[playerid] = true;
	return 1;
}

