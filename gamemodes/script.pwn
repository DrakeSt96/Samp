public ShowWerbeTextDraw()
{
	TextDrawHideForAll(WERBEdraw);
	TextDrawShowForAll(CHANGEDraw);
	return 1;
}

public Stoned(playerid,drugart)//drugart = 1 = Ganja,2 = kokain,3 = opium
{
	new string[32];
	switch(drugart)
	{
		case 1://Ganja
		{
			format(string,sizeof(string),"~r~PayDay: ~w~%i~r~/~w~60",Spieler[playerid][pMinutesAfterPayday]/60);
			PlayerTextDrawSetString(playerid,PAYDAYdraw[playerid],string);
			SetDrunkLevel(playerid,GetPlayerDrunkLevel(playerid)+10000);
			Spieler[playerid][pStonedCount] = 0;
		}
		case 2://kokain
		{
			format(string,sizeof(string),"~r~PayDay: ~w~%i~r~/~w~60",Spieler[playerid][pMinutesAfterPayday]/60);
			PlayerTextDrawSetString(playerid,PAYDAYdraw[playerid],string);
			SetDrunkLevel(playerid,GetPlayerDrunkLevel(playerid)+15000);
		}
		case 3://opium
		{
			format(string,sizeof(string),"~r~PayDay: ~w~%i~r~/~w~60",Spieler[playerid][pMinutesAfterPayday]/60);
			PlayerTextDrawSetString(playerid,PAYDAYdraw[playerid],string);
			SetPlayerDrunkLevel(playerid,0);
			if(GetPlayerACHealth(playerid) > Spieler[playerid][StonedHP])
			{
				SetPlayerACHealth(playerid,Spieler[playerid][StonedHP]);
			}
		    Spieler[playerid][pStonedAntiSpam] = 0;
			Spieler[playerid][StonedHP] = 0.0;
		}
		case 4://spice
		{
			format(string,sizeof(string),"~r~PayDay: ~w~%i~r~/~w~60",Spieler[playerid][pMinutesAfterPayday]/60);
			PlayerTextDrawSetString(playerid,PAYDAYdraw[playerid],string);
			SetPlayerDrunkLevel(playerid, 0);
			if(GetPlayerACHealth(playerid) > Spieler[playerid][StonedHP])
			{
				SetPlayerACHealth(playerid,Spieler[playerid][StonedHP]);
			}
			if(GetPlayerACArmour(playerid) > Spieler[playerid][StonedArmour])
			{
			    SetPlayerACArmour(playerid,Spieler[playerid][StonedArmour]);
			}
		    Spieler[playerid][pStonedAntiSpam] = 0;
			Spieler[playerid][StonedHP] = 0.0;
			Spieler[playerid][StonedArmour] = 0.0;
			
		}
	}
	return 1;
}
public Bomb()
{
	new string[64];
	BombSeconds++;
	if(BombSeconds > 330)
    {
	    BombState = false;
		BombDraht[0] = 0;//rot
		BombDraht[1] = 0;//gelb
		BombDraht[2] = 0;//grün
		BombDraht[3] = 0;//blau
		GangZoneStopFlashForAll(BombZone);
		GangZoneHideForAll(BombZone);
		GangZoneDestroy(BombZone);
		DestroyDynamicPickup(BombPickup);
		TextDrawHideForAll(Bombdraw);
		KillTimer(BombTimer);
		BombSeconds = 0;
    }
    if(BombSeconds == 292)
    {
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		    {
			    if(IsPlayerInRangeOfPoint(i,25.0,BombeX,BombeY,BombeZ))
			    {
					StopAudioStreamForPlayer(i);
			    	PlayAudioStreamForPlayer(i,ServerSounds[1],BombeX,BombeY,BombeZ,25.0,true);
			    }
		    }
	    }
    }
    if(BombSeconds > 300)
    {
	    new randompos = random(20),randexploderadius = random(40)+10;
	    for(new i=0;i<2;i++)
	    {
			CreateExplosion(BombeX+randompos,BombeY+randompos,BombeZ+randompos,7,randexploderadius);
