COMMAND:require4(playerid,const params[])
{
	#pragma unused params
	ShowPlayerNonHandyBusiness(playerid);
	return 1;
}
COMMAND:zustand(playerid,const params[])
{
	#pragma unused params
	format(SP_INFO,sizeof(SP_INFO),"%s",params);
	new Text3D:PlayerZZ = Create3DTextLabel(SP_INFO,0xFFFF00FF,30.0,40.0, 50.0,10.0,0);
	Attach3DTextLabelToPlayer(PlayerZZ,playerid,0.0,0.0,0.7);
	format(SP_INFO,sizeof(SP_INFO),""IINFO" du hast dein Zustand auf: "IINFO2"%s"#HTML_WEISS" geändert.",params);
	SCM(playerid,SAMP_WEISS,SP_INFO);
	return 1;
}
COMMAND:bstart(playerid,const params[])
{
	#pragma unused params
	if(IsPlayerInRangeOfPoint(playerid,1,591.8946,-1819.1985,6.6346)){
		if(BallongBesetzt == 0){
			if(Spieler[playerid][sp_ballong] == 1){
		        MoveDynamicObject(map_noobi[89],1130.45422, -1488.94507, 312.42508,1.0);
		        SetTimer("Ballong1",480000,false);
				BallongBesetzt = 1;
				Spieler[playerid][sp_ballong] = 0;
				format(SP_INFO,sizeof(SP_INFO),"[ "IINFO2"Ballong Fahrt"#HTML_WEISS" ]\nVerwendung\n"IINFO2"/bstart\n"#HTML_WEISS"Status: "#HTML_ROT"Besetzt\n"#HTML_WEISS"von: "HTML_GRUEN"%s",SpielerName(playerid));
				UpdateDynamic3DTextLabelText(BallongBesetztText,SAMP_WEISS,SP_INFO);
			}else SCM(playerid,SAMP_WEISS,""IINFO" du hast kein Ballong Ticket! Kaufe dir den beim Neulings Menü.");
		}else SCM(playerid,SAMP_WEISS,""IINFO" Ballong ist derzeit schon unterwegs...");
	}else SCM(playerid,SAMP_WEISS,""IINFO" Du bist nicht am Ballong!");
	return 1;
}
COMMAND:sup(playerid,const params[])
{
	if(Spieler[playerid][pAtReport] == 1)
	{
		new pID = Spieler[playerid][pReportPartner],string[650];
		format(string,sizeof(string),""#HTML_GREEN"[Support Modus]:"#HTML_WEISS" %s schrieb: %s",SpielerName(playerid),params);
		SCM(pID,SAMP_WEISS,string);
		SCM(playerid,SAMP_WEISS,string);
	}else{
		SCM(playerid,SAMP_WEISS,""IINFO" du bist derzeit in keinem Support tätig!");
	}
	return 1;
}
COMMAND:neuerfreund(playerid,const params[])
{
    if(GetPVarInt(playerid,"Eingeloggt") == 0)return SendClientMessage(playerid,SAMP_WEISS,"Du bist nicht eingeloggt!");
    if(Spieler[playerid][pFriedhof]!=0)return SendClientMessage(playerid,SAMP_WEISS,"Tote können keine Befehle nutzen!");
    if(Spieler[playerid][pInPrison]==1)return SendClientMessage(playerid,SAMP_WEISS,"Du kannst im Prison keine Befehle nutzen!");
    if(GetPlayerLevel(playerid) < 2)return SendClientMessage(playerid,SAMP_WEISS,"Diese Funktion ist erst ab Level 2 verfügbar.");
    ShowPlayerDialog(playerid,DIALOG_FRIEND_ADD,DIALOG_STYLE_INPUT,"Freundeliste","Gib nun den Namen des Spielers ein, dieser wird in deine Freundeliste eingetragen:","Eintragen","Abbrechen");
    return 1;
}
COMMAND:freunde(playerid,const params[])
{
    if(GetPVarInt(playerid,"Eingeloggt") == 0)return SendClientMessage(playerid,SAMP_WEISS,"Du bist nicht eingeloggt!");
    if(Spieler[playerid][pFriedhof]!=0)return SendClientMessage(playerid,SAMP_WEISS,"Tote können keine Befehle nutzen!");
    if(Spieler[playerid][pInPrison]==1)return SendClientMessage(playerid,SAMP_WEISS,"Du kannst im Prison keine Befehle nutzen!");
    if(GetPlayerLevel(playerid) < 2)return SendClientMessage(playerid,SAMP_WEISS,"Diese Funktion ist erst ab Level 2 verfügbar.");
	new query[128];
    mysql_format(MySQL_R394,query,sizeof(query),"SELECT * FROM spieler_freund WHERE username='%s'",SpielerName(playerid));
    mysql_function_query(MySQL_R394,query,true,"ShowFreundeListe","i",playerid);
    return 1;
}
COMMAND:forten(playerid,const params[])
{
	#pragma unused params
	new Float:Pos[3],slot;
	if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
	if(Spieler[playerid][pHandyFortung] == 0) return SCM(playerid,SAMP_WEISS,""IINFO" du verfügst nicht über die Fahrzeug Lokalisierungs App!");
	if(Spieler[playerid][pHandystate] == 0) return SCM(playerid, SAMP_WEISS, ""IINFO" dein Handy ist aus bitte schalte es zuerst ein!");
	if(Spieler[playerid][pHandyakku] == 0) return SCM(playerid,SAMP_WEISS, ""IINFO" dein Handy Akku ist leer!");
	if(sscanf(params,"d",slot)) return SCM(playerid,SAMP_WEISS,""IINFO" /forten [ Deinen Fahrzeug Slot ]");
	if(slot >= 0 && slot <= 5)
	{
 		if(Spieler[playerid][pIsearch] == 0)
		{
			if(IsValidVehicle(Pfahrzeug[slot][playerid][Vehicle]))
			{
			    PlayerPlaySound(playerid,1057,0.0,0.0,0.0);
		 		GetVehiclePos(Pfahrzeug[slot][playerid][Vehicle],Pos[0],Pos[1],Pos[2]);
				SetPlayerCheckpoint(playerid, Pos[0],Pos[1],Pos[2], 3.0);
				Spieler[playerid][pIsearch] = 1;
				SCM(playerid,SAMP_WEISS,""IINFO" dein Fahrzeug wurde erkannt und Markiert!");
				return 1;
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" Fehler bei Verbinden mit dem GPS!");
}
COMMAND:nb(playerid,const params[])
{
	new string[950],text[2500];
	if(Spieler[playerid][pNeuling] == 1) return SCM(playerid,SAMP_WEISS,""IINFO" bitte aktiviere zuerst den Neulingschat!");
 	if(Spieler[playerid][pMuted] == 1)
	{
		format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		return SCM(playerid,WEISS,string);
	}
	if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /nb(neulingschat) [Text]");
	if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /j(obchat) [Text darf maximal 90 Zeichen beinhalten]");
	for(new b=0;b<sizeof(BadWord);b++)
	{
		if(strfind(text,BadWord[b],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /nb(neulingschat)",BadWord[b],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
	}
	new strpos = strfind(text,"www",true);
	if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
	{
		strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
		return 1;
	}
	else if(Spieler[playerid][pAdmin] > 0){
 		format(string, sizeof(string), ""#HTML_ORANGE"[Neuling]"#HTML_WEISS" %s: %s",SpielerName(playerid),text);
	}
	else{
	    format(string, sizeof(string), ""#HTML_ORANGE"[Neuling]"#HTML_WEISS" %s: %s",SpielerName(playerid),text);
	}
	SendLevelMessage(SAMP_WEISS,string);
	return 1;
}
COMMAND:spawnchange_4(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return SCM(playerid,GRAU,""IINFO" Du kannst keine Befehle nutzen,da du im Tutorial bist.");
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist nicht eingeloggt!");
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist im AFK-Modus und kannst somit keine Befehle nutzen."),SCM(playerid,WRONGCMD,"BENUTZE: /back");
	if(Spieler[playerid][pInPrison] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist im Prison.");
	if(Spieler[playerid][pFriedhof] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist Tot.");
	if(Spieler[playerid][pDeath] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist verletzt.");
	if(Spieler[playerid][pJailed] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist im Gefängnis.");
	if(Spieler[playerid][pTazerd] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist K.O/getazert.");
	if(Spieler[playerid][pCuffed] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist gefesselt.");
	new cmd[15],string[128];
	if(sscanf(params,"s[15]",cmd))return SCM(playerid,SAMP_WEISS,"");
	if(strcmp(cmd,"Spawn",true) == 0 || strcmp(cmd,"Zivispawn",true) == 0)
   	{
	    Spieler[playerid][pSpawn] = 0;
		SCM(playerid,SAMP_WEISS,""IINFO" Nach deinem Tod wirst du am Zivilisten Spawn landen.");
		return 1;
    }
   	if(strcmp(cmd,"Base",true) == 0 || strcmp(cmd,"Fraktion",true) == 0)
   	{
	   	if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" Du bist in keiner Fraktion.");
	   	Spieler[playerid][pSpawn] = 2;
		SCM(playerid,SAMP_WEISS,"IINFO" "Nach deinem Tod wirst du bei deinem Berufsort landen.");
	    return 1;
	}
   	if(strcmp(cmd,"Haus",true) == 0 || strcmp(cmd,"Wohnung",true) == 0)
    {
	    ReturnPropertyData(playerid);
	 	new haus = Spieler[playerid][pReturnPropertyDataHaus],count = Spieler[playerid][pReturnPropertyDataHausCount];
	    if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" Du besitzt kein Haus.");
	    if(haus == 0)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist nicht in/an deinem Haus.");
	    Spieler[playerid][pSpawn] = 1;
	    Spieler[playerid][pSelectHome] = haus;
	    format(string,sizeof(string),""IINFO" Nach deinem Tod wirst du bei deinem Haus (ID:%i) landen.",haus);
		SCM(playerid,SAMP_WEISS,string);
	    return 1;
    }
    if(strcmp(cmd,"Miethaus",true) == 0 || strcmp(cmd,"MHaus",true) == 0 || strcmp(cmd,"Renthaus",true) == 0)
   	{
	   	new haus = Spieler[playerid][pRentHome];
	    if(haus == 0)return SCM(playerid,SAMP_WEISS,""IINFO" Du bist in keinem Haus eingemietet!");
	    if(HausInfo[haus][haus_innenraum] == 255)return SCM(playerid,SAMP_WEISS,""IINFO" Haus hat kein Innenraum.");
	    Spieler[playerid][pSpawn] = 4;
		SCM(playerid,SAMP_WEISS,""IINFO" Nach deinem Tod wirst du bei deinem gemieteten Haus landen.");
		return 1;
	}
   	if(strcmp(cmd,"Hotel",true) == 0 || strcmp(cmd,"Motel",true) == 0)
   	{
	   	if(Spieler[playerid][pHotel] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" In keinem Hotel eingemietet.");
	   	Spieler[playerid][pSpawn] = 3;
		SCM(playerid,SAMP_WEISS,"Nach deinem Tod wirst du in deinem Hotel landen.");
		return 1;
  	}
  	if(strcmp(cmd,"Wohnwagen",true) == 0 || strcmp(cmd,"Wohnmobil",true) == 0)
   	{
	   	if(GetPlayerVehicleCount(playerid) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" Du besitzt keinen Wohnwagen!");
	   	if(HavePlayerALivinvehicle(playerid) == -1)return SCM(playerid,SAMP_WEISS,""IINFO" Du besitzt keinen Wohnwagen!");
		SCM(playerid,SAMP_WEISS,""IINFO" Nach deinem Tod wirst du in deinem Wohnwagen landen.");
		Spieler[playerid][pSpawn] = 5;
		return 1;
  	}
	return SCM(playerid,SAMP_WEISS,"");
}
COMMAND:mdc(playerid,const params[])
{
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3)|| isPlayerInFrakt(playerid,16))
    {
        ShowPlayerMDC(playerid);
		format(SP_INFO,sizeof(SP_INFO),"** %s %s betätigt den Mobilen Daten Computer **",SpielerFraktionsRangName(playerid),SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,SP_INFO,10);
	}else{
		SCM(playerid,SAMP_WEISS,""IINFO" du darfst das MDC System nicht verwenden!");
	}
	return 1;
}
