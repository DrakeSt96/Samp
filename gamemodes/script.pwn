				BizInfo[biz+1][biz_pickup][0] = CreateDynamicPickup(Server_Business_Frei_Pickup,1,BizInfo[biz+1][biz_x],BizInfo[biz+1][biz_y],BizInfo[biz+1][biz_z],0);
