COMMAND:setpunkte(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],Menge,Grund[31],fv = IsAFraktionsVeh(playerid);
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11))
	{
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(Spieler[playerid][pFunkgeraet] != 0 || FraktionsAktenPCs(playerid) || fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		{
			if(sscanf(params,"uds[31]",pID,Menge,Grund))return SCM(playerid,SAMP_WEISS,""IINFO" /setpunkte [playerid/Name][Punkte][Grund]");
		    if(strlen(Grund) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /setpunkte [playerid/Name][Punkte][Grund darf maximal 30 Zeichen beinhalten]");
			if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
		    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
			if((Spieler[pID][pAutoLic] == 0 && Spieler[pID][pBikeLic] == 0 && Spieler[pID][pRollerLic] == 0) || (Spieler[pID][pBikeLic] == 0 && Spieler[pID][pAutoLic] == 0 && Spieler[pID][pRollerLic] == 0) || (Spieler[pID][pRollerLic] == 0 && Spieler[pID][pAutoLic] == 0 && Spieler[pID][pBikeLic] == 0))return SCM(playerid,SAMP_WEISS,"Spieler besitzt keinen Führerschein/Motorradschein/Rollerschein.");
			if((Spieler[pID][pSTVOpoints] + Menge) > 10)return SCM(playerid,SAMP_WEISS,"Falsche Angabe!");
			Spieler[pID][pSTVOpoints] += Menge;
			format(string,sizeof(string),"STVO-Verstoß: Fall bearbeitet vom Beamten %s | Punkte vergabe: %i | Punkte gesamt: %i | Grund: %s",SpielerName(playerid),Menge,Spieler[pID][pSTVOpoints],Grund);
			SCM(pID,SAMP_WEISS,string);
			ForEachPlayer(p)
			{
				if(IsPlayerConnected(p))
				{
					if(isPlayerInFrakt(p,1) || isPlayerInFrakt(p,2) || isPlayerInFrakt(p,6) || isPlayerInFrakt(p,11))
					{
						if(Spieler[p][pDuty] != 0)
						{
							if(Spieler[p][pFunkgeraet] == 1 || (IsAFraktionsVeh(p) != -1 && Fahrzeug[IsAFraktionsVeh(p)][Fraktion] == Spieler[p][pFraktion]) || FraktionsAktenPCs(p))
							{
								format(string,sizeof(string),"STVO-Verstoß: %s | Fall bearbeitet vom Beamten %s | Punkte vergabe: %i | Punkte gesamt: %i | Grund: %s",SpielerName(pID),SpielerName(playerid),Menge,Spieler[pID][pSTVOpoints],Grund);
								SCM(p,SAMP_WEISS,string);
								if(Spieler[pID][pSTVOpoints] >= 10)
								{
									if(Spieler[pID][pBikeLic] == 1 || Spieler[pID][pAutoLic] == 1 || Spieler[pID][pRollerLic] == 1)
									{
										format(string,sizeof(string),"%s wurden die Scheine: ´Motorrad´ und ´Autoschein´ und ´Rollerschein´ abgenommen. Grund: 10 Punkte",SpielerName(pID));
								    	SCM(p,SAMP_WEISS,string);
								    }
								}
							}
						}
					}
				}
			}
			if(Spieler[pID][pSTVOpoints] >= 10)
			{
				if(Spieler[pID][pBikeLic] == 1 || Spieler[pID][pAutoLic] == 1 || Spieler[pID][pRollerLic] == 1)
				{
					SCM(pID,SAMP_WEISS,"STVO-Verstoß: Dir wurden die Scheine: ´Motorrad´ und ´Autoschein´ und ´Rollerschein´ abgenommen. Grund: 10 Punkte");
					Spieler[pID][pAutoLic] = 0;
					Spieler[pID][pBikeLic] = 0;
					Spieler[pID][pRollerLic] = 0;
				}
				Spieler[pID][pSTVOpoints] = 0;
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du trägst kein Funkgerät mit dir./Du sitzt in keinem Fraktionsfahrzeug./Du bist an keinem Aktencomputer.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:delpunkte(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],Menge,Grund[31],fv = IsAFraktionsVeh(playerid);
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11))
	{
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(Spieler[playerid][pFunkgeraet] != 0 || FraktionsAktenPCs(playerid) || fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		{
			if(sscanf(params,"uds[31]",pID,Menge,Grund))return SCM(playerid,SAMP_WEISS,""IINFO" /delpunkte [playerid/Name][Punkte][Grund]");
		    if(strlen(Grund) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /delpunkte [playerid/Name][Punkte][Grund darf maximal 30 Zeichen beinhalten]");
			if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
		    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
			if((Spieler[pID][pSTVOpoints] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Falsche Angabe!");
			Spieler[pID][pSTVOpoints] -= Menge;
			format(string,sizeof(string),"STVO-Bereinigung: Fall bearbeitet vom Beamten %s | Punkte bereinigt: %i | Punkte gesamt: %i | Grund: %s",SpielerName(playerid),Menge,Spieler[pID][pSTVOpoints],Grund);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"STVO-Bereinigung: %s | Fall bearbeitet vom Beamten %s | Punkte bereinigt: %i | Punkte gesamt: %i | Grund: %s",SpielerName(pID),SpielerName(playerid),Menge,Spieler[pID][pSTVOpoints],Grund);
			ForEachPlayer(p)
			{
				if(IsPlayerConnected(p))
				{
					if(isPlayerInFrakt(p,1) || isPlayerInFrakt(p,2) || isPlayerInFrakt(p,6) || isPlayerInFrakt(p,11))
					{
						if(Spieler[p][pDuty] != 0)
						{
							if(Spieler[p][pFunkgeraet] == 1 || (IsAFraktionsVeh(p) != -1 && Fahrzeug[IsAFraktionsVeh(p)][Fraktion] == Spieler[p][pFraktion]) || FraktionsAktenPCs(p))
							{
								SCM(p,SAMP_WEISS,string);
							}
						}
					}
				}
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du trägst kein Funkgerät mit dir./Du sitzt in keinem Fraktionsfahrzeug./Du bist an keinem Aktencomputer.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:anwalterlaubnis(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	  	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /anwalterlaubniss [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Anwalterlaubnis erteilen.");
		if(pAnwaltallow[pID] == 1)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits eine Anwaltserlaubnis.");
		if(!isPlayerInJob(pID,16))return SCM(playerid,SAMP_WEISS,"Spieler ist kein Anwalt.");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),""IINFO" du hast dem %s (ID:%i) eine Anwaltserlaubnis erteilt.",SpielerName(pID),pID);
	    SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast vom Staatsbeamten %s (ID:%i) eine Anwaltserlaubnis erteilt bekommen",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		pAnwaltallow[pID] = 1;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:vehtake(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],Float:Cords[3];
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6))
   	{
		if(!isPlayerAMember(playerid,2))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		for(new i=0;i<MAX_VEHICLES;i++)
	    {
		    if(IsValidVehicle(i))
		    {
				GetVehiclePos(i,Cords[0],Cords[1],Cords[2]);
				if(IsPlayerInRangeOfPoint(playerid,5.0,Cords[0],Cords[1],Cords[2]) && IsVehicleACar(i) && kofferraum[i] == true)
				{
					if(vFahrzeug[i][KofferraumGanja] + vFahrzeug[i][KofferraumKokain] + vFahrzeug[i][KofferraumMaterials] + vFahrzeug[i][KofferraumOpium] + vFahrzeug[i][KofferraumSpice] + vFahrzeug[i][KofferraumLunchpakete] + vFahrzeug[i][KofferraumC4] + vFahrzeug[i][KofferraumWerkzeugkasten] + vFahrzeug[i][KofferraumBenzinkanister] > 0)
					{
						format(string,sizeof(string),""IINFO" du hast dem Fahrzeug [%s] %ig Ganja,%ig Kokain,%i Pillen Opium,%ig Spice,%i Materials,%i Lunchpakete,%ikg C4,%i Werkzeugkästen,%i Benzinkanister entnommen.",
						VehicleDefinations[GetVehicleModel(i)-400],vFahrzeug[i][KofferraumGanja],vFahrzeug[i][KofferraumKokain],vFahrzeug[i][KofferraumOpium],vFahrzeug[i][KofferraumSpice],vFahrzeug[i][KofferraumMaterials],vFahrzeug[i][KofferraumLunchpakete],vFahrzeug[i][KofferraumC4],vFahrzeug[i][KofferraumWerkzeugkasten],vFahrzeug[i][KofferraumBenzinkanister]);
					    SCM(playerid,SAMP_WEISS,string);
					    format(string,sizeof(string),"** %s entnimmt einem Fahrzeug [%s] alle beinhaltenden Gegenstände **",SpielerName(playerid),VehicleDefinations[GetVehicleModel(i)-400]);
						PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
						vFahrzeug[i][KofferraumGanja] = 0;
						vFahrzeug[i][KofferraumKokain] = 0;
						vFahrzeug[i][KofferraumMaterials] = 0;
						vFahrzeug[i][KofferraumOpium] = 0;
						vFahrzeug[i][KofferraumSpice] = 0;
						vFahrzeug[i][KofferraumLunchpakete] = 0;
						vFahrzeug[i][KofferraumC4] = 0;
						vFahrzeug[i][KofferraumWerkzeugkasten] = 0;
						vFahrzeug[i][KofferraumBenzinkanister] = 0;
						return 1;
					}
					return SCM(playerid,SAMP_WEISS,"Kofferraum beinhaltet nichts!");
				}
			}
		}
		return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe eine Fahrzeuges oder der Kofferraum eines Fahrzeuges ist nicht geöffnet.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:takemaske(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],Float:x,Float:y,Float:z;
   	GetPlayerPos(playerid,x,y,z);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16) || isPlayerAnAdmin(playerid,5))
   	{
		if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i))
			{
				if(playerid != i)
			  	{
					if(IsPlayerInRangeOfPoint(i,2.0,x,y,z))
					{
						if(Spieler[i][pTazerd] == 1 && Spieler[i][pMaske] == 1 || Spieler[i][pDeath] == 1 && Spieler[i][pMaske] == 1 || Spieler[i][pCuffed] == 1 && Spieler[i][pMaske] == 1)
						{
							SetPlayerName(i,Spieler[i][pName]);
							SetPlayerScore(i,GetPlayerLevel(i));
							RemovePlayerAttachedObject(i,1);
							Spieler[i][pMaske] = 0;
							format(string,sizeof(string),"%s hat dir deine Maske abgenommen. Du wurdest entarnt!",SpielerName(playerid));
							SCM(i,SAMP_WEISS,string);
							format(string,sizeof(string),""IINFO" du hast %s die Maske abgenommen. Er wurde entarnt!",SpielerName(i));
						    SCM(playerid,SAMP_WEISS,string);
						    format(string,sizeof(string),"** %s nimmt einem Unbekannten die Maskierung ab **",SpielerName(playerid));
							PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
							return 1;
						}
					}
				}
			}
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines getazerten/gefesselten/verletzten Maskierten Spielers.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:detachthings(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],cmd[30];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		if(sscanf(params,"us[30]",pID,cmd))
		{
			SCM(playerid,SAMP_WEISS,""IINFO" /detachthings [playerid/Name][Sache]");
			SCM(playerid,SAMP_WEISS,"Sache:");
		    SCM(playerid,SAMP_WEISS,"[Ganja/Kokain/Opium/Spice/Lunch/Zigarette/Kokainsamen/Ganjasamen/Funkgerät/Tazer]");
		    return SCM(playerid,SAMP_WEISS,"[Materials/Werkzeugkasten/Benzinkanister/Köder/Spicesamen/Opiumsamen/Handy]");
		}
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst nichts geben!");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(Spieler[pID][pTazerd] == 1 || Spieler[pID][pCuffed] == 1)
		{
			if(strcmp(cmd,"Ganja",true) == 0)
			{
				if(Spieler[pID][pGanja] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Spieler trägt nicht so viel Ganja mit sich!");
			    if((Spieler[playerid][pGanja] + Spieler[pID][pGanja]) > 2500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
				format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %ig Ganja entnommen.",SpielerName(pID),pID,Spieler[pID][pGanja]);
				SCM(playerid,SAMP_WEISS,string);
				format(string,sizeof(string),"%s (ID:%i) hat dir soeben %ig Ganja entnommen.",SpielerName(playerid),playerid,Spieler[pID][pGanja]);
				SCM(pID,SAMP_WEISS,string);
				format(string,sizeof(string),"** %s nimmt %s etwas weg **",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				Spieler[playerid][pGanja] += Spieler[pID][pGanja];
				Spieler[pID][pGanja] = 0;
				return 1;
			}
			if(strcmp(cmd,"Spice",true) == 0)
			{
				if(Spieler[pID][pSpice] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Spieler trägt nicht so viel Spice mit sich!");
			    if((Spieler[playerid][pSpice] + Spieler[pID][pSpice]) > 500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
				format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %ig Spice entnommen.",SpielerName(pID),pID,Spieler[pID][pSpice]);
				SCM(playerid,SAMP_WEISS,string);
				format(string,sizeof(string),"%s (ID:%i) hat dir soeben %ig Spice entnommen.",SpielerName(playerid),playerid,Spieler[pID][pSpice]);
				SCM(pID,SAMP_WEISS,string);
				format(string,sizeof(string),"** %s nimmt %s etwas weg **",SpielerName(playerid),SpielerName(pID));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				Spieler[playerid][pSpice] += Spieler[pID][pSpice];
				Spieler[pID][pSpice] = 0;
