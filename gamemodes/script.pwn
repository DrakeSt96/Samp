}
COMMAND:flastdriver(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[200],fv = IsAFraktionsVeh(playerid),vehicleid = GetPlayerVehicleID(playerid);
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(fv == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
	if(Fahrzeug[fv][Fraktion] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
	if(strcmp(Flastdriver[vehicleid],"Niemand",true) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat dieses Fahrzeug benutzt!");
	format(string,sizeof(string),"%s | Fahrer: %s",VehicleDefinations[GetVehicleModel(vehicleid)-400],Flastdriver[vehicleid]);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:fvl(playerid,const params[])
{
	#pragma unused params
 	if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Fraktion.");
	{
	    ShowPlayerDialog(playerid,DIALOG_FRAKTIONS_VERWALTUNG_MENU,DIALOG_STYLE_LIST,""#ClanTagDialoge" Fraktions Verwaltung",""#HTML_BLAU"1."#HTML_WEISS" Fraktion (Member_Online)\n"#HTML_BLAU"2."#HTML_WEISS" Fraktionsbank_Status(Gang/Mafien)\n"HTML_BLAU"3."#HTML_WEISS" Fraktionsbank_Einzahlen(Gang/Mafien)\n"#HTML_BLAU"4."#HTML_WEISS" Fraktionsbank_Auszahlen(Gang/Mafien)\nWeiter","Nehmen","Abbrechen");
	}
	return 1;
}
COMMAND:fmember(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[1000],onlinemembers = 0;
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Fraktion.");
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(isPlayerInFrakt(i,Spieler[playerid][pFraktion]))
				{
					format(string,sizeof(string),""#HTML_WEISS"Rang: "IINFO2"%s"#HTML_WEISS" Name: "IINFO2"%s"#HTML_WEISS" RangID: "IINFO2"%i\n%s",SpielerFraktionsRangName(i),SpielerName(i),Spieler[i][pFraktRang],string);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_LIST,""ClanTagDialoge" Mitglieder-Liste",string,"Okay","");
					onlinemembers++;
				}
			}
		}
	}
	if(onlinemembers == 0)return SCM(playerid,SAMP_WEISS,"Kein Fraktionsmitglied Online.");
	return 1;
}
COMMAND:leader(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[1000],onlineleader = 0,leaderorcoleader[26];
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(isPlayerAMember(i,5) && !isPlayerInFrakt(i,8))
				{
					switch(Spieler[i][pFraktRang])
					{
						case 5:{leaderorcoleader="Co-Leader";}
						case 6:{leaderorcoleader="Leader";}
						default:{leaderorcoleader="ERROR";}
					}
					format(string,sizeof(string),""#HTML_WEISS"Fraktion: "IINFO2"%s"#HTML_WEISS" Name: "IINFO2"%s"#HTML_WEISS" Status: "IINFO2"%s\n%s",FraktionsName(Spieler[i][pFraktion]),Spieler[i][pName],leaderorcoleader,string);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_LIST,""ClanTagDialoge" Leader-Liste",string,"Verlassen","");
					onlineleader++;
				}
			}
		}
	}
	if(onlineleader == 0)return SCM(playerid,SAMP_WEISS,""IINFO" kein Leader einer Fraktion Online.");
	return 1;
}
COMMAND:leiche(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,18) || isPlayerInJob(playerid,27))
	{
	    if(!IsVehicleADeathCar(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"In keinem Leichenwagen.");
	    if(Leichen[playerid] != -1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits eine Leiche im Kofferraum.");
	    if(ReturnTotenID(playerid) == -1)return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe einer Leiche!");
		if(kofferraum[GetPlayerVehicleID(playerid)] == false)return SCM(playerid,SAMP_WEISS,""IINFO" der Kofferraum muss geöffnet sein.");
		Leichen[playerid] = ReturnTotenID(playerid);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast die Leiche in den Leichenwagen gelegt.");
		SCM(playerid,SAMP_WEISS,"Fahre nun zum Friedhof.");
		format(string,sizeof(string),"** %s legt eine Leiche in seinen Leichenwagen **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		DestroyDynamicPickup(TotenInfo[Leichen[playerid]][totenpickup]);
		DestroyDynamic3DTextLabel(TotenLabel[Leichen[playerid]]);
		TotenInfo[Leichen[playerid]][totenxpos] = -1;
		TotenInfo[Leichen[playerid]][totenypos] = -1;
		TotenInfo[Leichen[playerid]][totenzpos] = -1;
		TotenInfo[Leichen[playerid]][totenvworld] = -1;
	}
	else
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion/Du besitzt nicht den jeweiligen Job.");
	    return 1;
	}
	return 1;
}
COMMAND:bestatten(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,18) || isPlayerInJob(playerid,27))
	{
	    if(IsPlayerInRangeOfPoint(playerid,5,940.3944,-1086.9818,24.2962) || IsPlayerInRangeOfPoint(playerid,5,-2585.4595,15.2741,4.4406))
	    {
		    if(!IsVehicleADeathCar(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"In keinem Leichenwagen.");
		    if(Leichen[playerid] == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Leiche im Kofferraum.");
			if(kofferraum[GetPlayerVehicleID(playerid)] == false)return SCM(playerid,SAMP_WEISS,""IINFO" der Kofferraum muss geöffnet sein.");
			SCM(playerid,SAMP_WEISS,""IINFO" du hast die Leiche ins Leichenschauhaus gebracht!");
			format(string,sizeof(string),"Verdienst: %i$",TotenInfo[Leichen[playerid]][totenlevel]*30);
			SCM(playerid,SAMP_WEISS,string);
			if(isPlayerInFrakt(playerid,18))
			{
				fverwaltungen[18][Geld] += (TotenInfo[Leichen[playerid]][totenlevel]*30);
				SCM(playerid,SAMP_WEISS,""IINFO" das Geld wurde in die Fraktionskasse eingezahlt!");
			}
			else
			{
			    Spieler[playerid][pLohn] += (TotenInfo[Leichen[playerid]][totenlevel]*30);
			}
			TotenInfo[Leichen[playerid]][totenlevel] = 0;
			Leichen[playerid] = -1;
		}
		else
		{
  			SCM(playerid,SAMP_WEISS,"Nicht am Leichenschauhaus.");
  			return 1;
		}
	}
	else
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion/Du besitzt nicht den jeweiligen Job.");
	    return 1;
	}
	return 1;
}
COMMAND:lastdriver(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],vehicleid = GetPlayerVehicleID(playerid);
    if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
    if(strcmp(Flastdriver[vehicleid],"Niemand",true) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat dieses Fahrzeug benutzt!");
	format(string,sizeof(string),"%s | Fahrer: %s",VehicleDefinations[GetVehicleModel(vehicleid)-400],Flastdriver[vehicleid]);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:a(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new text[91],string[128];
	if(isPlayerAnAdmin(playerid,1) || Spieler[playerid][pAdmin] == -1)
	{
		if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /a(dmin Chat) [Text]");
		if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /a(dmin Chat) [Text darf maximal 90 Zeichen beinhalten]");
		format(string,sizeof(string),""#HTML_LIGHTYELLOW"»"#HTML_WEISS" %s "#HTML_LIGHTYELLOW"%s"#HTML_WEISS": %s",Adminrang(playerid),Spieler[playerid][pName],text);
		SendAdminMessage(0x2FB0D0C8,string);
		format(string,sizeof(string),"%s %s: %s",Adminrang(playerid),Spieler[playerid][pName],text);
		Log("Admin-Chatsqllog",string);
	}
	else
	{
		SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Amdin Team des '"ClanTag"' !");
		return 1;
	}
	return 1;
}
COMMAND:afix(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new cmd[30];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"s[30]",cmd))
	{
		return SCM(playerid,SAMP_WEISS,""IINFO" /afix[Blitzer/Funkmasten/Telefonzellen/ATM/alle]");
	}
	if(strcmp(cmd,"Blitzer",true) == 0)
    {
        for(new msten=0;msten<MAX_BLITZER;msten++)
		{
	    	if(Blitzer[msten][EGmBhHp] < 50)
	    	{
	    	    Blitzer[msten][EGmBhHp] = 100;
				DestroyDynamicObject(Blitzer[msten][EGmBhRubbishObject]);
				DestroyDynamic3DTextLabel(Blitzer[msten][RubLabel]);
				Blitzer[msten][RubLabel] = INVALID_3D_TEXT;
			}
		}
		SCM(playerid,SAMP_WEISS,""IINFO" alle Blitzer wurden repariert!");
		return 1;
	}
	else if(strcmp(cmd,"Funkmasten",true) == 0)
    {
        for(new msten=0;msten<MAX_MASTEN;msten++)
		{
		    if(FMastenInfo[msten][EGmBhHp] < 50)
		    {
		        FMastenInfo[msten][EGmBhHp] = 100;
		        DestroyDynamicObject(FMastenInfo[msten][EGmBhRubbishObject]);
				DestroyDynamic3DTextLabel(FMastenInfo[msten][RubLabel]);
				FMastenInfo[msten][RubLabel] = INVALID_3D_TEXT;
			}
		}
		SCM(playerid,SAMP_WEISS,""IINFO" alle Funkmasten wurden repariert!");
		return 1;
	}
	else if(strcmp(cmd,"Telefonzellen",true) == 0)
    {
        for(new i=0;i<MAX_TELEFONZELLEN;i++)
		{
		    if(TeleZelleInfo[i][EGmBhHp] < 50)
		    {
		        TeleZelleInfo[i][EGmBhHp] = 100;
		        DestroyDynamicObject(TeleZelleInfo[i][EGmBhRubbishObject]);
				DestroyDynamic3DTextLabel(TeleZelleInfo[i][RubLabel]);
				TeleZelleInfo[i][RubLabel] = INVALID_3D_TEXT;
			}
		}
		SCM(playerid,SAMP_WEISS,""IINFO" alle Telefonzellen wurden repariert!");
		return 1;
	}
	else if(strcmp(cmd,"ATM",true) == 0)
    {
        for(new i=0;i<MAX_ATMS;i++)
		{
		    if(ATMInfo[i][EGmBhHp] < 50)
		    {
		    	ATMInfo[i][EGmBhHp] = 100;
		    	DestroyDynamicObject(ATMInfo[i][EGmBhRubbishObject]);
				DestroyDynamic3DTextLabel(ATMInfo[i][RubLabel]);
				ATMInfo[i][RubLabel] = INVALID_3D_TEXT;
			}
		}
		SCM(playerid,SAMP_WEISS,""IINFO" alle Bankautomaten wurden repariert!");
		return 1;
	}
	else if(strcmp(cmd,"alle",true) == 0)
    {
        OnPlayerCommandText(playerid,"/afix blitzer");
        OnPlayerCommandText(playerid,"/afix funkmasten");
        OnPlayerCommandText(playerid,"/afix telefonzellen");
        OnPlayerCommandText(playerid,"/afix atm");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /afix[Blitzer/Funkmasten/Telefonzellen/ATM/alle]");
}
COMMAND:afeuer(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    new Float:x,Float:y,Float:z;
	GetPlayerPos(playerid,x,y,z);
	AddFire(x+2,y,z,GetPlayerVirtualWorld(playerid),false);
	AddFire(x+7,y-3,z,GetPlayerVirtualWorld(playerid),false);
	AddFire(x+1,y+2,z,GetPlayerVirtualWorld(playerid),false);
	AddFire(x-2,y+3,z,GetPlayerVirtualWorld(playerid),false);
	AddFire(x-2,y,z,GetPlayerVirtualWorld(playerid),true);
	SCM(playerid,SAMP_WEISS,""IINFO" du hast ein feuer gelegt!");
	return 1;
}
COMMAND:unprison(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new pID,reason[31],string[128];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /unprison [playerid/Name][Grund]");
    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /unprison [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht.");
	if(Spieler[pID][pInPrison] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht im Prison.");
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat den Spieler %s (ID:%i) aus dem Prison entlassen. Grund: %s ",Spieler[playerid][pName],playerid,Spieler[pID][pName],pID,reason);
	SendClientMessageToAll(SAMP_WEISS,string);
	StopAudioStreamForPlayer(pID);
	RemovePlayerAttachedObject(pID,0);
	Spieler[pID][pPrisonCPsgelaufen] = 0;
	Spieler[pID][pPrisonCPsgegeben] = 0;
	Spieler[pID][pInPrison] = 0;
	PlayerTextDrawHide(pID,PRISONdraw[pID]);
	DisablePlayerCheckpoint(pID);
	SetPlayerVirtualWorld(pID,0);
	SpawnPlayerEx(pID);
	GameTextForPlayer(pID,"~w~Du wurdest aus dem ~g~Prison~w~ entlassen!",1500,3);
	format(string,sizeof(string),"Admin %s User: %s * Grund: %s",Spieler[playerid][pName],Spieler[pID][pName],reason);
	Log("UnPrisonsqllog",string);
	return 1;
}
COMMAND:prison(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new pID,cps,string[650],reason[650];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"uis[31]",pID,cps,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /prison [playerid/Name][Checkpoints][Grund]");
    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /prison [playerid/Name][Checkpoints][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(playerid != pID)
	{
		if(Spieler[pID][pAdmin] > Spieler[playerid][pAdmin])return SCM(playerid,SAMP_WEISS,""IINFO" du kannst keine Ranghöherern Admins in Prison stecken!");
	}
	if(cps<1||cps>3000)return SCM(playerid,SAMP_WEISS,""IINFO" /prison [playerid/Name][Checkpoints 1-3000][Grund]");
	if(Spieler[pID][pInPrison] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" Spieler ist bereits im Prison.");
	format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS" hat den Spieler "IINFO2"%s"#HTML_WEISS" für "IINFO2"%i"#HTML_WEISS" CP´s ins Prison geschickt. Grund: "IINFO2"%s",Spieler[playerid][pName],Spieler[pID][pName],cps,reason);
	SendClientMessageToAll(SAMP_WEISS,string);
	format(string,sizeof(string),""#HTML_WEISS"Beschuldigter: "IINFO2"%s"#HTML_WEISS" Strafe: "IINFO2"%i"#HTML_WEISS" Checkpoint's\nDu wurdest von Admin: "IINFO2"%s"#HTML_WEISS" in's Prison gesteckt.\nDer Grund dafür lautete von seiner Seite: "IINFO2"%s"#HTML_WEISS"\nFalls es nicht mit Rechten dingen gelaufen ist, melde dich bitte dich an einem Admin!",Spieler[pID][pName],cps,Spieler[playerid][pName],reason);
	ShowPlayerDialog(pID,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Prison - Angeklagter",string,"Verlassen","");
	Spieler[pID][pPrisonCPsgegeben] = cps;
	Spieler[pID][pPrisonCPsgelaufen] = cps;
	Spieler[pID][pInPrison] = 1;
	Spieler[pID][pHandystate] = 0;
	PlayerTextDrawHide(pID,Handy_Draw_Info[pID]);
	KillTimer(AkkuTimer[pID]);
	if(Spieler[pID][pCallHim] == 1)
	{
		new pID2 = Spieler[pID][pCall];
		Spieler[pID][pCallHim] = 0;
		Spieler[pID2][pCallHim] = 0;
		Spieler[pID2][pCall] = -1;
		Spieler[pID][pCall] = -1;
		SetPlayerSpecialAction(pID,SPECIAL_ACTION_STOPUSECELLPHONE);
		SetPlayerSpecialAction(pID2,SPECIAL_ACTION_STOPUSECELLPHONE);
		SCM(pID2,SAMP_WEISS,""IINFO" der Gesprächspartner hat aufgelegt.");
		PlayerPlaySound(pID,1077,0.0,0.0,0.0);
		PlayerPlaySound(pID2,1077,0.0,0.0,0.0);
		RemovePlayerAttachedObject(pID,8);
		RemovePlayerAttachedObject(pID2,8);
	}
	SpawnPlayerEx(pID);
	GameTextForPlayer(pID,"~w~Im ~r~Prison",1500,3);
	format(string,sizeof(string),"Admin %s User: %s * Checkpoints: %i * Grund: %s",Spieler[playerid][pName],Spieler[pID][pName],cps,reason);
	Log("Prisonsqllog",string);
	return 1;
}

COMMAND:breakprison(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Prison.");
    StopAudioStreamForPlayer(playerid);
	RemovePlayerAttachedObject(playerid,0);
	Spieler[playerid][pPrisonCPsgelaufen] = 0;
	Spieler[playerid][pPrisonCPsgegeben] = 0;
	Spieler[playerid][pInPrison] = 0;
	PlayerTextDrawHide(playerid,PRISONdraw[playerid]);
	DisablePlayerCheckpoint(playerid);
	SetPlayerVirtualWorld(playerid,0);
	SpawnPlayerEx(playerid);
	GameTextForPlayer(playerid,"~w~Du hast dich aus dem ~g~Prison~w~ entlassen!",1500,3);
	format(string,sizeof(string),"Breakprison -- Admin %s User: %s * Grund: Keinen",Spieler[playerid][pName],Spieler[playerid][pName]);
	Log("UnPrisonsqllog",string);
	return 1;
}

COMMAND:checkprison(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128],pID;
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /checkprison [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pInPrison] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht im Prison.");
	format(string,sizeof(string),"%s ist %i von %i Checkpoints abgelaufen!",Spieler[pID][pName],Spieler[pID][pPrisonCPsgelaufen],Spieler[pID][pPrisonCPsgegeben] );
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}

COMMAND:pay(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
 	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,menge,string[128];
	if(sscanf(params,"ud",pID,menge))return SCM(playerid,SAMP_WEISS,""IINFO" /pay [playerid/Name][Betrag]'");
    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selber kein Geld geben.");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(menge<=0)return SCM(playerid,SAMP_WEISS,""IINFO" du musst schon einen Betrag angeben.");
	if(GetPlayerLevel(playerid) <= ENABLE_KILLORPAY_BYLEVEL)
	{
		if(menge > 250)
		{
			format(string,sizeof(string),"ACHTUNG: Du kannst mit Level %i nicht mehr als 250$ ausgeben!",GetPlayerLevel(playerid));
			return SCM(playerid,SAMP_WEISS,string);
		}
	}
	else if(menge>10000)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nicht mehr als 10.000$ ausgeben!");
	if((GetACMoney(playerid) - menge ) < 0)
	{
	 	PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
		return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Geld.");
	}
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	ACMoney(playerid,-menge);
	ACMoney(pID,menge);
	PlayerPlaySound(pID,1054,0.0,0.0,0.0);
	PlayerPlaySound(playerid,1054,0.0,0.0,0.0);
	format(string,sizeof(string),"* %s du hast gerade %i$ von %s bekommen *",SpielerName(pID),menge,SpielerName(playerid));
	SCM(pID,SAMP_WEISS,string);
  	format(string,sizeof(string),"* Du hast %s %i$ gegeben *",SpielerName(pID),menge);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"** %s nimmt Geld aus der Tasche und gibt es %s **",SpielerName(playerid),SpielerName(pID));
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	format(string,sizeof(string),"Spieler: %s User: %s * Betrag: %i",Spieler[playerid][pName],Spieler[pID][pName],menge);
	Log("Paysqllog",string);
	SaveAccount(playerid);
	SaveAccount(pID);
	return 1;
}

