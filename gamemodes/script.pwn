	format(string,sizeof(string),""ACINFO" Du wurdest von %s (ID:%i) als Leiter der Partei "IINFO2"%s"#HTML_WEISS" abgewiesen.",Spieler[playerid][pName],playerid,PartInfo[p][ParteiName]);
