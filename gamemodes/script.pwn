public Bankraub(playerid)
{
    new string[128];
	robsec++;
	if(Spieler[playerid][pBankRobState] != false)
	{
		if(IsPlayerInRangeOfPoint(playerid,10,269.0677,164.7019,989.6183) && GetPlayerVirtualWorld(playerid) == 0)
		{
			Spieler[playerid][pRobTimeInTresor]++;
			format(string,sizeof(string),"~n~~n~~n~~n~~n~~g~Neues Geld in ~b~%i~y~ Sekunden",60-Spieler[playerid][pRobTimeInTresor]);
		    GameTextForPlayer(playerid,string,1000,3);
		    Spieler[playerid][pRobBackwardTimeTresor] = 0;
		    if(Spieler[playerid][pRobTimeInTresor] >= 60)
		    {
			    new gZufallGehalt = random(500) + 2500;
			    format(string,sizeof(string),"~g~Geld erhalten: ~y~%i$",gZufallGehalt);
			    GameTextForPlayer(playerid,string,1000,3);
				Spieler[playerid][pRobOtherThing] += gZufallGehalt;
			    Spieler[playerid][pRobTimeInTresor] = 0;
			    format(string,sizeof(string),""IINFO" du hast eine Ladung mit %i$ geklaut,bisheriger Gesamtbetrag: %i$.",gZufallGehalt,Spieler[playerid][pRobOtherThing]);
			    SCM(playerid,SAMP_WEISS,string);
		    }
		}
		else
		{
			Spieler[playerid][pRobBackwardTimeTresor]++;
			format(string,sizeof(string),"~n~~n~~n~~n~~n~~r~Du hast noch ~b~%i ~y~Sekunden~r~ um dich zum Tresorpunkt zu begeben",30-Spieler[playerid][pRobBackwardTimeTresor]);
		    GameTextForPlayer(playerid,string,1000,3);
		    if(Spieler[playerid][pRobBackwardTimeTresor] >= 30)
		    {
			    RemovePlayerAttachedObject(playerid,5);
			    SendClientMessageToAll(ORANGE,"News: Der Bankraub wurde soeben von dem Räuber abgebrochen.");
			    SCM(playerid,SAMP_WEISS,""IINFO" du bist am Bankraub gescheitert.");
				Spieler[playerid][pBankRobState] = false;
				Spieler[playerid][pRobBackwardTimeTresor] = 0;
				Spieler[playerid][pRobTimeInTresor] = 0;
				KillTimer(Spieler[playerid][pBankRobTimer]);
				robsec = 0;
				PlayerTalkPublic(playerid,WEISS,"ALARM: Die Tresortür schließt sich alle raus hier !!!",50);
				MoveDynamicObject(tor[17],1472.04,-998.54,44.58,1);
				PlayerHearMusicInRange(1472.04,-998.54,44.58,1035,5,1,2000);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
			}
		}
	}
	switch(robsec)
	{
	    case 1:SendClientMessageToAll(ORANGE,"News: Die Bank wird in 10 Minuten leer sein,die Staatsmächte sind unterwegs.");
	    case 120:SendClientMessageToAll(ORANGE,"News: Die Bank wird in 8 Minuten leer sein.");
	    case 240:SendClientMessageToAll(ORANGE,"News: Die Bank wird in 6 Minuten leer sein.");
	    case 360:SendClientMessageToAll(ORANGE,"News: Die Bank wird in 4 Minuten leer sein.");
	    case 480:SendClientMessageToAll(ORANGE,"News: Die Bank wird in 2 Minuten leer sein.");
	    case 540:SendClientMessageToAll(ORANGE,"News: Die Bank wird in 1 Minuten leer sein.");
	    case 600:
		{
			SendClientMessageToAll(ORANGE,"News: Die Bank wurde erfolgreich ausgeraubt.");
			TogglePlayerControllable(playerid,true);
			format(string,sizeof(string),"~w~Verdienst gesamt~g~ %i$",Spieler[playerid][pRobOtherThing]);
			GameTextForPlayer(playerid,string,2000,1);
			format(string,sizeof(string),""IINFO" du hast erfolgreich die Bank of San Andreas ausgeraubt. Verdienst %i$",Spieler[playerid][pRobOtherThing]);
			SCM(playerid,SAMP_WEISS,string);
			SCM(playerid,SAMP_WEISS,"Hau mit der Beute ab bevor die Tresortür in 30 Sekunden schließt.");
			SCM(playerid,SAMP_WEISS,""IINFO" du darfst die nächsten 5 Minuten nicht sterben oder das Spiel verlassen,");
		    SCM(playerid,SAMP_WEISS,""IINFO" da deine erbeutetes Geld somit verschwindet.");
			RemovePlayerAttachedObject(playerid,5);
			Spieler[playerid][pBankRobState] = false;
			Spieler[playerid][pRobOtherTime] = gettime() + (5*60);
			ACMoney(playerid,Spieler[playerid][pRobOtherThing]);
		}
		case 630:
		{
			MoveDynamicObject(tor[17],1472.04,-998.54,44.58,1);
			PlayerHearMusicInRange(1472.04,-998.54,44.58,1035,5,1,2000);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
		    KillTimer(Spieler[playerid][pBankRobTimer]);
			robsec = 0;
		}
	}
	return 1;
}
