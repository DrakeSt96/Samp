COMMAND:loadmoneypoint_2(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[3];
    if(!isPlayerInJob(playerid,9))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleABankCar(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Geldtransporter.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(Spieler[playerid][JobDuty]==0) return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Job Dienst!");
    if(sscanf(params,"s[3]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /loadmoneypoint [LS/SF]");
	if(strcmp(cmd,"LS",true) == 0)
	{
		SetPlayerCheckpoint(playerid,2006.7079,-1784.2205,13.6013,1.0);
		Spieler[playerid][pIsearch] = 1;
		SCM(playerid,SAMP_WEISS,""IINFO" der Ladepunkt Los Santos wurde auf deine Karte markiert.");
		return 1;
	}
	if(strcmp(cmd,"SF",true) == 0)
	{
		SetPlayerCheckpoint(playerid,-1830.9830,572.8057,35.1641,1.0);
		Spieler[playerid][pIsearch] = 1;
	    SCM(playerid,SAMP_WEISS,""IINFO" der Ladepunkt San Fierro wurde auf deine Karte markiert.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /loadmoneypoint [LS/SF]");
}
COMMAND:fillatm(playerid,const params[])
{
    #pragma unused params
    strdel(edit_2,0,sizeof(edit_2));
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(Spieler[playerid][JobDuty]==0) return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Job Dienst!");
	new vehicleid = GetPlayerVehicleID(playerid),nearestatm = ReturnATMID(playerid),string[128],cashflow = random(40) + 75;
    if(!isPlayerInJob(playerid,9))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleABankCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Geldtransporter.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(nearestatm == -1)return SCM(playerid,SAMP_WEISS,"An keinem Geldautomaten!");
    if(VehicleLoadTank[vehicleid] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Geldtransport ist mit keinem Geld beladen!");
	if((ATMInfo[nearestatm][ATMmoney] + 25000) > 800000)return SCM(playerid,SAMP_WEISS,""IINFO" ein Geldautomat kann maximal mit 800.000$ befüllt werden!");
    format(string,sizeof(string),""#HTML_WEISS"Alter Kontostand: "IINFO2"%i$\n",ATMInfo[nearestatm][ATMmoney]);
    strcat(edit_2,string);
	strcat(edit_2,""#HTML_WEISS"Einzahlung: "IINFO2"25000$\n");
	Spieler[playerid][pLohn] += cashflow;
	VehicleLoadTank[vehicleid] -= 25000;
	ATMInfo[nearestatm][ATMmoney] += 25000;
	format(string,sizeof(string),""#HTML_WEISS"Neuer bestand vom Geldautomaten: "IINFO2"%i$\n",ATMInfo[nearestatm][ATMmoney]);
	strcat(edit_2,string);
	format(string,sizeof(string),""#HTML_WEISS"Geldtransport beinhaltet noch: "IINFO2"%i$\n",VehicleLoadTank[vehicleid]);
	strcat(edit_2,string);
	format(string,sizeof(string),""#HTML_WEISS"Verdienst: "IINFO2"%i$\n\n",cashflow);
	strcat(edit_2,string);
	strcat(edit_2,""IINFO" die Auszahlung wird am Zahltag auf dein Konto überwiesen.");
	ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Geldautomat",edit_2,"Okay","");
	return 1;
}
COMMAND:allthinginfo_2(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[8000],vehicleid = GetPlayerVehicleID(playerid);
	if(Spieler[playerid][JobDuty]==0) return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Job Dienst!");
	if(isPlayerInJob(playerid,9))
	{
	    if(!IsVehicleABankCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Geldtransporter.");
	    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	    for(new i=0;i<MAX_ATMS;i++)
		{
			format(string,sizeof(string),"%s\n"#HTML_WEISS"ATM: "IINFO2"%i"#HTML_WEISS" Inhalt: "IINFO2"%i$"#HTML_WEISS" / "#HTML_ROT"800000$",string,i,ATMInfo[i][ATMmoney]);
			ShowPlayerDialog(playerid,DIALOG_SEARCH_ATMORZTM,DIALOG_STYLE_LIST,""ClanTagDialoge" Geldautomaten",string,"Markieren","Abbrechen");
		}
		return 1;
	}
	if(isPlayerInJob(playerid,19))
	{
		if(!IsVehicleAZigCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Transporter.");
	    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	    for(new i=0;i<MAX_ZIGAUTOMATEN;i++)
	  	{
			format(string,sizeof(string),"%s\nZTM: %i | %i/180 Schachteln",string,i,ZigAutomatInfo[i][Zigarrets]);
			ShowPlayerDialog(playerid,DIALOG_SEARCH_ATMORZTM,DIALOG_STYLE_LIST,"Zigarettenautomaten",string,"Markieren","Abbrechen");
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
}
COMMAND:loadrubbish(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid),string[128];
	if(!isPlayerInJob(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleAMuellCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Müllwagen.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    for(new haus=1;haus<MAX_HAUS;haus++)
	{
		if(HausInfo[haus][hauscreatet] == 1)
		{
		 	if(IsPlayerInRangeOfPoint(playerid,15.0,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]))
			{
				if(HausInfo[haus][hausmull] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Haus hat momentan keinen Müll zum abholen bereit liegen.");
				if(VehicleLoadTank[vehicleid] >= 200)return SCM(playerid,SAMP_WEISS,""IINFO" der Müllwagen ist voll. Fahre zu einer der Mülldeponien.");
				format(string,sizeof(string),""IINFO" der Müllwagen wurde mit %i Sack/Säcken Müll vom Haus (ID:%i) beladen.",HausInfo[haus][hausmull],haus);
				SCM(playerid,SAMP_WEISS,string);
				VehicleLoadTank[vehicleid] += HausInfo[haus][hausmull];
				HausInfo[haus][hausmull] = 0;
			    format(string,sizeof(string),"Ladungsstatus: %i/200 Müllsäcken",VehicleLoadTank[vehicleid]);
			    SCM(playerid,SAMP_WEISS,string);
				return 1;
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist an keinem Haus.");
}

COMMAND:loadrubbishstatus(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid),string[128];
    if(!isPlayerInJob(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleAMuellCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Müllwagen.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    format(string,sizeof(string),"Müllwagen beinhaltet: %i/200 Müllsäcken",VehicleLoadTank[vehicleid]);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}

COMMAND:unloadrubbish(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid),string[128];
    if(!isPlayerInJob(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleAMuellCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Müllwagen.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	if(IsPlayerInRangeOfPoint(playerid,5.0,2130.3259,-1985.8221,13.2739) || IsPlayerInRangeOfPoint(playerid,5.0,-1865.8647,-1669.4746,21.4771) || IsPlayerInRangeOfPoint(playerid,5.0,2524.5879,2818.7576,10.5474))
	{
		if(VehicleLoadTank[vehicleid] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Müllwagen hat keinen Müll geladen.");
	    format(string,sizeof(string),"%i Müllsäcke wurden entladen.",VehicleLoadTank[vehicleid]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Verdienst für %i aufgeladene Müllsäcke: %i$",VehicleLoadTank[vehicleid],VehicleLoadTank[vehicleid]*2);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[playerid][pLohn] += VehicleLoadTank[vehicleid]*2;
		VehicleLoadTank[vehicleid] = 0;
		SCM(playerid,SAMP_WEISS,"Info: Die Auszahlung wird am Zahltag auf dein Konto überwiesen.");
	    SCM(playerid,SAMP_WEISS,"Ladungsstatus: 0/200 Müllsäcken");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,"Nicht an der Los Santos Mülldeponie./Nicht an der San Fierro Mülldeponie./Nicht an der Las Venturas Mülldeponie.");
}

COMMAND:landfill(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[3];
    if(!isPlayerInJob(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleAMuellCar(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Müllwagen.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(sscanf(params,"s[3]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /landfill [LS/SF/LV]");
	if(strcmp(cmd,"LS",true) == 0)
	{
		SetPlayerCheckpoint(playerid,2130.3259,-1985.8221,13.2739,3.0);
		Spieler[playerid][pIsearch] = 1;
		SCM(playerid,SAMP_WEISS,"Die Mülldeponie in Los Santos wurde auf deine Karte markiert.");
		return 1;
	}
	if(strcmp(cmd,"SF",true) == 0)
	{
		SetPlayerCheckpoint(playerid,-1865.8647,-1669.4746,21.4771,3.0);
		Spieler[playerid][pIsearch] = 1;
	    SCM(playerid,SAMP_WEISS,"Die Mülldeponie in San Fierro wurde auf deine Karte markiert.");
		return 1;
	}
	if(strcmp(cmd,"LV",true) == 0)
	{
		SetPlayerCheckpoint(playerid,2524.5879,2818.7576,10.5474,3.0);
		Spieler[playerid][pIsearch] = 1;
	    SCM(playerid,SAMP_WEISS,"Die Mülldeponie in Las Venturas wurde auf deine Karte markiert.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /landfill [LS/SF/LV]");
}

COMMAND:loaddirtstatus(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid),string[128];
    if(!isPlayerInJob(playerid,2))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleACleanCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Reinigungsfahrzeug.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    format(string,sizeof(string),"Reinigungsfahrzeug beinhaltet: %i/500kg",VehicleLoadTank[vehicleid]);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}

COMMAND:unloaddirt(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid = GetPlayerVehicleID(playerid),string[128];
    if(!isPlayerInJob(playerid,2))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(!IsVehicleACleanCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Reinigungsfahrzeug.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	if(IsPlayerInRangeOfPoint(playerid,5.0,2484.5078,-2482.0237,13.3816))
	{
		if(VehicleLoadTank[vehicleid] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Reinigungsfahrzeug hat keinen Müll/Dreck geladen.");
	    format(string,sizeof(string),"%ikg wurden entladen.",VehicleLoadTank[vehicleid]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Verdienst für %ikg Müll/Dreck: %i$",VehicleLoadTank[vehicleid],VehicleLoadTank[vehicleid]/2);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[playerid][pLohn] += (VehicleLoadTank[vehicleid]/2);
		VehicleLoadTank[vehicleid] = 0;
		SCM(playerid,SAMP_WEISS,"Info: Die Auszahlung wird am Zahltag auf dein Konto überwiesen.");
	    SCM(playerid,SAMP_WEISS,"Ladungsstatus: 0/500kg");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,"Nicht an der Los Santos Entsorgungsmaschine (/cleanmachine).");
}

