				MoveDynamicObject(tor[39],-2043.7734375,-80.568031311035,34.921920776367 + 0.01,0.01,0,0,0);
				torstatus[39] = 1;
				SetTimerEx("MoveGate",10000,false,"i",3);
			}
			case 12:
