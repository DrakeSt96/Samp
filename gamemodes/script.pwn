stock GivePlayerWPS(wantedplayer,WPSAnzahl,const reason[])
{
	new string[200];
	if((Spieler[wantedplayer][pWantedPoints] + WPSAnzahl) < 60)
	{
		Spieler[wantedplayer][pWantedPoints] += WPSAnzahl;
	}
	else Spieler[wantedplayer][pWantedPoints] = 60;
	SetPlayerWantedLevel(wantedplayer,0);
	if(Spieler[wantedplayer][pWantedPoints] >= 10)
	{SetPlayerWantedLevel(wantedplayer,1);}
	if(Spieler[wantedplayer][pWantedPoints] >= 20)
	{SetPlayerWantedLevel(wantedplayer,2);}
	if(Spieler[wantedplayer][pWantedPoints] >= 30)
	{SetPlayerWantedLevel(wantedplayer,3);}
	if(Spieler[wantedplayer][pWantedPoints] >= 40)
	{SetPlayerWantedLevel(wantedplayer,4);}
	if(Spieler[wantedplayer][pWantedPoints] >= 50)
	{SetPlayerWantedLevel(wantedplayer,5);}
	if(Spieler[wantedplayer][pWantedPoints] >= 60)
	{SetPlayerWantedLevel(wantedplayer,6);}
	format(string,sizeof(string),"* Wantedlevel: %i | Derzeitiges Fahndungslevel: %i",GetPlayerWantedLevel(wantedplayer),Spieler[wantedplayer][pWantedPoints]);
	SCM(wantedplayer,SAMP_WEISS,string);
	if(WPSAnzahl > 0) Spieler[wantedplayer][pSuspectPoints]++,Spieler[wantedplayer][pLastSuspects]++;
	switch(Spieler[wantedplayer][pLastSuspects])
	{
		case 1:{format(pWantedReason1[wantedplayer],64,"%s(%i WPS)",reason,WPSAnzahl);}
		case 2:{format(pWantedReason2[wantedplayer],64,"%s(%i WPS)",reason,WPSAnzahl);}
		case 3:{format(pWantedReason3[wantedplayer],64,"%s(%i WPS)",reason,WPSAnzahl);}
		case 4:{format(pWantedReason4[wantedplayer],64,"%s(%i WPS)",reason,WPSAnzahl);}
		case 5:{format(pWantedReason5[wantedplayer],64,"%s(%i WPS)",reason,WPSAnzahl); Spieler[wantedplayer][pLastSuspects] = 0;}
	}
	PlayCrimeReportForPlayer(wantedplayer,wantedplayer,3);
	return 1;
}
stock BincoSystem(playerid)
{
	new query[128];
    Spieler[playerid][AmUmkleiden] = 1;
	TogglePlayerControllable(playerid,false);
    SetPlayerVirtualWorld(playerid,120+playerid);
  	SCM(playerid,SAMP_WEISS,"Wähle dir nun ein Skin aus.");
	ShowBinco(playerid);
  	PlayerTextDrawShow(playerid,BINCOplayerdraw[playerid]);
  	SelectTextDraw(playerid,GRAU);
  	if(isPlayerInFrakt(playerid,0) || isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16))
  	{
		if(Spieler[playerid][pDuty] == 0)
		{
		    if(ImTutorial[playerid] != 0)
			{
				Spieler[playerid][Skin] = 0;
				SetPlayerSkin(playerid,BincoSystemZiviSkins[Spieler[playerid][Skin]][Skinid]);
				format(query,sizeof(query),"SELECT * FROM spieler WHERE SkinID='%d' OR FraktionSkinID='%d'",GetPlayerSkin(playerid),GetPlayerSkin(playerid));
			    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,a_script_binco,playerid,MySQL_R394);
				return 1;
			}
			else
			{
				Spieler[playerid][Skinchange] = 1;
				Spieler[playerid][Skin] = 0;
				SetPlayerSkin(playerid,BincoSystemZiviSkins[Spieler[playerid][Skin]][Skinid]);
				format(query,sizeof(query),"SELECT * FROM spieler WHERE SkinID='%d' OR FraktionSkinID='%d'",GetPlayerSkin(playerid),GetPlayerSkin(playerid));
			    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,a_script_binco,playerid,MySQL_R394);
				return 1;
			}
		}
	}
    Spieler[playerid][FSkinchange] = 1;
	for(new i=0;i<sizeof(BincoSystemFraktionsSkins);i++)
	{
		if(isPlayerInFrakt(playerid,BincoSystemFraktionsSkins[i][Fraktid]))
		{
			Spieler[playerid][Skin] = i;
			SetPlayerSkin(playerid,BincoSystemFraktionsSkins[i][Skinid]);
			break;
		}
	}
    format(query,sizeof(query),"SELECT * FROM spieler WHERE SkinID='%d' OR FraktionSkinID='%d'",GetPlayerSkin(playerid),GetPlayerSkin(playerid));
    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,a_script_binco,playerid,MySQL_R394);
	return 1;
}
stock GetPlayerKofferWeight(playerid)
{
	new weight = Spieler[playerid][pKofferItems][0]+Spieler[playerid][pKofferItems][1]+Spieler[playerid][pKofferItems][2]+Spieler[playerid][pKofferItems][3]+Spieler[playerid][pKofferItems][4]+floatround(Spieler[playerid][pKofferItems][5]*1000)+floatround((Spieler[playerid][pKofferItems][6]/1000)*2)+Spieler[playerid][pKofferItems][7]+Spieler[playerid][pKofferItems][8]+floatround(Spieler[playerid][pKofferItems][9]*500);
	return weight;
}
stock ReturnKofferID(playerid)
{
	for(new koffer=0;koffer<MAX_KOFFER;koffer++)
	{
		if(KofferInfo[koffer][Kcreatet] != 0)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.5,KofferInfo[koffer][KPos][0],KofferInfo[koffer][KPos][1],KofferInfo[koffer][KPos][2]) && GetPlayerVirtualWorld(playerid) == KofferInfo[koffer][KWorld])
			return koffer;
		}
	}
	return -1;
}
stock CreateDroppedKoffer(playerid,kofferbombe = 0)
{
	if(Spieler[playerid][pKoffer] == 0)return -1;
	for(new koffer=0;koffer<MAX_KOFFER;koffer++)
	{
		if(KofferInfo[koffer][Kcreatet] != 1)
		{
			RemovePlayerAttachedObject(playerid,9);
			Spieler[playerid][pKoffer] = 0;
			KofferInfo[koffer][Kcreatet] = 1;
			GetPlayerPos(playerid,KofferInfo[koffer][KPos][0],KofferInfo[koffer][KPos][1],KofferInfo[koffer][KPos][2]);
		    KofferInfo[koffer][KWorld] = GetPlayerVirtualWorld(playerid);
		    KofferInfo[koffer][KOpium] = Spieler[playerid][pKofferItems][0];
		    KofferInfo[koffer][KGanja] = Spieler[playerid][pKofferItems][1];
		    KofferInfo[koffer][KKokain] = Spieler[playerid][pKofferItems][2];
		    KofferInfo[koffer][KMaterials] = Spieler[playerid][pKofferItems][3];
		    KofferInfo[koffer][KMaterialsPakets] = Spieler[playerid][pKofferItems][4];
		    KofferInfo[koffer][KC4] = Spieler[playerid][pKofferItems][5];
		    KofferInfo[koffer][KMoney] = Spieler[playerid][pKofferItems][6];
		    KofferInfo[koffer][KZigarets] = Spieler[playerid][pKofferItems][7];
		    KofferInfo[koffer][KKoeder] = Spieler[playerid][pKofferItems][8];
		    KofferInfo[koffer][KLunch] = Spieler[playerid][pKofferItems][9];
		    KofferInfo[koffer][KSpice] = Spieler[playerid][pKofferItems][10];
		    KofferInfo[koffer][KBomb] = kofferbombe;
		    KofferLabel[koffer] = CreateDynamic3DTextLabel("[Koffer]",SAMP_WEISS,KofferInfo[koffer][KPos][0],KofferInfo[koffer][KPos][1],KofferInfo[koffer][KPos][2],5.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,KofferInfo[koffer][KWorld]);
		    KofferInfo[koffer][KObject] = CreateDynamicObject(1210,KofferInfo[koffer][KPos][0],KofferInfo[koffer][KPos][1],KofferInfo[koffer][KPos][2]-0.87,90.0,0.0,0.0,KofferInfo[koffer][KWorld]);
		    for(new i=0;i<10;i++)
		    {
		    	Spieler[playerid][pKofferItems][i] = 0;
		    }
			return koffer;
		}
	}
	return -1;
}
