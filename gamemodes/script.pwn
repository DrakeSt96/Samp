						CreatePlayerVehicle(playerid,AutohausVehicle[v][modelid],AutohausVehicle[v][buyspawnX],AutohausVehicle[v][buyspawnY],AutohausVehicle[v][buyspawnZ],AutohausVehicle[v][buyspawnA],"N/A",AutohausVehicle[v][Preis]);
