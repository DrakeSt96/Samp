			strcat(string,""IINFO2"Pflanzen:"#HTML_GRAU" /pflanzen | /giessen | /dpflanze | /tdrogen | /kpflanze | /shplfanzen | /samenkaufen,\n");
			strcat(string,""#HTML_GRAU"/ortpflanze | /ortsamen\n");
			strcat(string,""IINFO2"Gangwar:"#HTML_GRAU" /gangwar | /gangwars | /gebiete | /gebietsinfo | /fgebiete\n");
			strcat(string,""IINFO2"Gangfight:"#HTML_GRAU" /gangfight | /stopgangfight | /gangfightinfo\n");
			strcat(string,""IINFO2"Base: "#HTML_GRAU"/baselock\n");
			strcat(string,""IINFO2"Verkauf:"#HTML_GRAU" /sellnacho\n");
			strcat(string,""IINFO2"Autohandel:"#HTML_GRAU" /buyjackcar, /showjackcar\n");
			if(GetFraktionSmarkCount(Spieler[playerid][pFraktion]) != 0){ strcat(string,""IINFO2"Schwarzmarkt:"#HTML_GRAU" /smenu | /steilhaber | /skickteilhaber | /slock | /seject | /sverkaufen | /sfight | /sfightinfo\n"); }
			else
			{
				for(new sm=1;sm<MAX_SMARKETS;sm++)
			    {
				    if(SmarkInfo[sm][screatet] == 1 && (isPlayerInFrakt(playerid,SmarkInfo[sm][sattackerfraktid]) || isPlayerInFrakt(playerid,SmarkInfo[sm][sfraktid])) && SmarkInfo[sm][sattackerfraktid] != 0)
				    {
				    	counter++;
					}
				}
				if(counter > 0) strcat(string,""IINFO2"Schwarzmarkt:"#HTML_GRAU" /sfightinfo\n");
			}
			strcat(string,""IINFO2"Sonstiges:"#HTML_GRAU" /knockout | /reinzerren | /fesseln | /entfesseln\n");
			strcat(string,""#HTML_GRAU"/fmember | /flock | /augenbinde | /delaugenbinde | /flastdriver | /fvehlist | /detachthings\n");
			if(isPlayerAMember(playerid,5))
		 	{
			 	strcat(string,""#HTML_WEISS"-"#HTML_BLAU" Leader Section -"#HTML_WEISS"\n");
			 	strcat(string,""#HTML_GRAU" /invite | /uninvite | /setrang | /fl,\n");
			 	strcat(string,""#HTML_GRAU" /invitevb | /uninvitevb | /setgehalt | /showgehalt,\n");
			 	strcat(string,""#HTML_GRAU" /frespawn | /fparken | /fsetrang | /fverwaltung | /l");
			}
		}
		case 18:
		{
			strcat(string,""IINFO2"Bestattung:"#HTML_GRAU" /leiche | /bestatten | /op | /accept bestatten\n");
			strcat(string,""IINFO2"Segen:"#HTML_GRAU" /segen\n");
			strcat(string,""IINFO2"Chat:"#HTML_GRAU" /vb\n");
			strcat(string,""IINFO2"Sonstiges:"#HTML_GRAU" /fesseln | /entfesseln | /predigt\n");
			strcat(string,""IINFO2"Base: "#HTML_GRAU"/baselock\n");
			strcat(string,""IINFO2"Sinlist:"#HTML_GRAU" /sinlist | /setsinlist | /freesinlist\n");
			strcat(string,""IINFO2"Pflanzen:"#HTML_GRAU" /pflanzen | /giessen | /dpflanze | /tdrogen | /kpflanze | /shplfanzen | /samenkaufen,\n");
			strcat(string,""IINFO2"/ortpflanze | /ortsamen\n");
			strcat(string,""IINFO2"/fmember | /flock | /augenbinde | /delaugenbinde | /flastdriver | /fvehlist | /detachthings\n");
			if(isPlayerAMember(playerid,5))
		 	{
			 	strcat(string,""#HTML_WEISS"-"#HTML_BLAU" Leader Section -"#HTML_WEISS"\n");
			 	strcat(string,""#HTML_GRAU" /invite | /uninvite | /setrang | /setgehalt | /showgehalt | /fl | /fverkaufen,\n");
			 	strcat(string,""#HTML_GRAU" /frespawn | /fparken | /fsetrang | /fverwaltung | /l");
			 	strcat(string,""#HTML_GRAU" /invitevb | /uninvitevb");
			}
		}
	}
	return ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Fraktionshilfe",string,"Zurück","Abbrechen");
}
COMMAND:animhelp(playerid,const params[])
{
	#pragma unused params
	ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Animationshilfe","/anim [Animation]","Zurück","Abbrechen");
	return 1;
}
COMMAND:vehhelp(playerid,const params[])
{
	#pragma unused params
	if(GetPlayerVehicleCount(playerid) != 0)return ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Fahrzeughilfe",""#HTML_BLAU"Fahrzeug{FFFFFF}:\n/cv oder Taste Z zum kontrollieren eines Fahrzeugs | /kraum | /kofferrauminfo | /eject | /tanken | /cc | /werkstatt | /lock\n\n"#HTML_BLAU"Privatfahrzeug{FFFFFF}:\n/pveh","Zurück","Abbrechen");
