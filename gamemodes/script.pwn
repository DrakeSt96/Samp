	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(Spieler[playerid][pNEWS] == false)
	{
		Spieler[playerid][pNEWS] = true;
		SCM(playerid,SAMP_WEISS,""IINFO" du hast den Newschat eingeschaltet!");
	}
	else if(Spieler[playerid][pNEWS] == true)
	{
