								format(string,sizeof(string),""IINFO" du hast einen %s für %i$ freigekauft.",VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(playerid))-400],vFahrzeug[Fahrzeug[fv][Vehicle]][AbgeschlepptPreis]);
