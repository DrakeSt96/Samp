	new readingallmsg[256];
	if(fID == 0)return 1;
    ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(isPlayerInFrakt(i,fID))
			{
				SCM(i,color,string);
			}
			if(Spieler[i][IreadALL] == 1)
			{
				format(readingallmsg,sizeof(readingallmsg),"F%i: %s",fID,string);
				SCM(i,SAMP_WEISS,readingallmsg);
			}
		}
	}
	return 1;
}

