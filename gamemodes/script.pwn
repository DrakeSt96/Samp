					//UpdateDynamic3DTextLabelText(SmarktLabel[sm],SAMP_WEISS,string);
				}
			}
			else{
				//format(string,sizeof(string),"[ "IINFO2"Schwarzmarkt"#HTML_WEISS" ]\nBesitzer: "IINFO2"%s"#HTML_WEISS"\n2tBesitzer: "IINFO2"%s"#HTML_WEISS"\nPreis: "IINFO2"%i"#HTML_WEISS"\nStraße: "IINFO2"%s %i"#HTML_ROT"\nAbgeschlossen",
				//FraktionsName(SmarkInfo[sm][sfraktid]),FraktionsName(SmarkInfo[sm][sbdfraktid]),SmarkInfo[sm][sprice],SmarkInfo[sm][swerbetext],sm);
				//UpdateDynamic3DTextLabelText(SmarktLabel[sm],SAMP_WEISS,string);
