COMMAND:showgehalt(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /setgehalt [playerid/Name]");
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler nicht in deine Fraktion.");
		if(Spieler[pID][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler hat kein Bankkonto.");
		format(string,sizeof(string),""IINFO" das Gehalt von %s (ID:%i) beträgt: %i$.",SpielerName(pID),pID,Spieler[pID][pFraktionsGehalt]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
 	}
 	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:setgehalt(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,gehalt,gehaltup[128],gehaltdown[128];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		if(sscanf(params,"ui",pID,gehalt))return SCM(playerid,SAMP_WEISS,""IINFO" /setgehalt [playerid/Name][Betrag]");
		if(gehalt<1||gehalt>5000)return SCM(playerid,SAMP_WEISS,"Bitte stelle das Gehalt nur zwischen 1-5000$ ein.");
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		new altgehalt = Spieler[pID][pFraktionsGehalt];
	    if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler nicht in deine Fraktion.");
		if(Spieler[pID][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler hat kein Bankkonto.");
	    format(gehaltdown,sizeof(gehaltdown),"Dein Gehalt wurde von %s auf %i$ runter gesetzt.",SpielerName(playerid),gehalt);
		format(gehaltup,sizeof(gehaltup),"Dein Gehalt wurde von %s auf %i$ hoch gesetzt. ",SpielerName(playerid),gehalt);
		if(altgehalt > gehalt){ SCM(pID,SAMP_WEISS,gehaltdown); }
		if(altgehalt < gehalt){ SCM(pID,SAMP_WEISS,gehaltup); }
		format(gehaltdown,sizeof(gehaltdown),""IINFO" du hast %s das Gehalt auf %i$ runter gesetzt.",SpielerName(pID),gehalt);
		format(gehaltup,sizeof(gehaltup),""IINFO" du hast %s das Gehalt auf %i$ hoch gesetzt.",SpielerName(pID),gehalt);
		if(altgehalt > gehalt){ SCM(playerid,SAMP_WEISS,gehaltdown); }
		if(altgehalt < gehalt){ SCM(playerid,SAMP_WEISS,gehaltup); }
		Spieler[pID][pFraktionsGehalt] = gehalt;
		return 1;
 	}
 	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:setrang(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,rank,rankup[128],rankdown[128];
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pLeader] == 0)return SCM(playerid,SAMP_WEISS,"Kein Leader.");
	if(sscanf(params,"ui",pID,rank))return SCM(playerid,SAMP_WEISS,""IINFO" /setrang [playerid/Name][Rang]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
   	if(rank<0||rank>6)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur einen Rang von 0-6 wählen.");
	if(rank == Spieler[pID][pFraktRang])return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den angegebenen Rang.");
	if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler nicht in deine Fraktion.");
	new altrank = Spieler[pID][pFraktRang];
	format(rankdown,sizeof(rankdown),""IINFO" du wurdest von %s auf Rang %i degradiert.",SpielerName(playerid),rank);
	format(rankup,sizeof(rankup),""IINFO" du wurdest von %s auf Rang %i befördert.",SpielerName(playerid),rank);
	if(altrank > rank){SCM(pID,SAMP_WEISS,rankdown);}
	if(altrank < rank){SCM(pID,SAMP_WEISS,rankup);}
	format(rankdown,sizeof(rankdown),""IINFO" du hast %s auf Rang %i degradiert.",SpielerName(pID),rank);
	format(rankup,sizeof(rankup),""IINFO" du hast %s auf Rang %i befördert.",SpielerName(pID),rank);
	if(altrank > rank){SCM(playerid,SAMP_WEISS,rankdown);}
	if(altrank < rank){SCM(playerid,SAMP_WEISS,rankup);}
	Spieler[pID][pFraktRang] = rank;
	return 1;
}

COMMAND:seturang(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,rank,rankup[128],rankdown[128];
    if(!isPlayerInFrakt(playerid,6))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(sscanf(params,"ui",pID,rank))return SCM(playerid,SAMP_WEISS,""IINFO" /seturang [playerid/Name][Rang]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	switch(Spieler[pID][pFraktABTInvite])
	{
    	case 1:
		{
			if(rank<0||rank>14)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur einen Unit-Rang von 0-14 wählen.");
			if(Spieler[playerid][pLeader] == 0 && Spieler[playerid][pFraktABTInvite] != Spieler[pID][pFraktABTInvite] && Spieler[playerid][pFraktURang] < 14)return SCM(playerid,SAMP_WEISS,"Kein Leader oder kein Leiter der jeweiligen Unit.");
		}
    	case 2:
		{
			if(rank<0||rank>14)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur einen Unit-Rang von 0-14 wählen.");
			if(Spieler[playerid][pLeader] == 0 && Spieler[playerid][pFraktABTInvite] != Spieler[pID][pFraktABTInvite] && Spieler[playerid][pFraktURang] < 14)return SCM(playerid,SAMP_WEISS,"Kein Leader oder kein Leiter der jeweiligen Unit.");
    	}
    	case 3:
		{
			if(rank<0||rank>8)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur einen Unit-Rang von 0-8 wählen.");
			if(Spieler[playerid][pLeader] == 0 && Spieler[playerid][pFraktABTInvite] != Spieler[pID][pFraktABTInvite] && Spieler[playerid][pFraktURang] < 8)return SCM(playerid,SAMP_WEISS,"Kein Leader oder kein Leiter der jeweiligen Unit.");
		}
	}
	if(Spieler[pID][pFraktABTInvite] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist in keiner Abteilung.");
	if(rank == Spieler[pID][pFraktURang])return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den angegebenen Rang.");
	if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Fraktion.");
	new altrank = Spieler[pID][pFraktURang];
	format(rankdown,sizeof(rankdown),""IINFO" du wurdest von %s auf Unit-Rang %i degradiert.",SpielerName(playerid),rank);
	format(rankup,sizeof(rankup),""IINFO" du wurdest von %s auf Unit-Rang %i befördert.",SpielerName(playerid),rank);
	if(altrank > rank){SCM(pID,SAMP_WEISS,rankdown);}
	if(altrank < rank){SCM(pID,SAMP_WEISS,rankup);}
	format(rankdown,sizeof(rankdown),""IINFO" du hast %s auf Unit-Rang %i degradiert.",SpielerName(pID),rank);
	format(rankup,sizeof(rankup),""IINFO" du hast %s auf Unit-Rang %i befördert.",SpielerName(pID),rank);
	if(altrank > rank){SCM(playerid,SAMP_WEISS,rankdown);}
	if(altrank < rank){SCM(playerid,SAMP_WEISS,rankup);}
	Spieler[pID][pFraktURang] = rank;
	return 1;
}

COMMAND:givecoins(playerid,const params[])
{
    #pragma unused params
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerAnAdmin(playerid,7) || Spieler[playerid][pAdmin] == -1)
	{
		new pID,string[128],menge;
	    if(sscanf(params,"ui",pID,menge))return SCM(playerid,SAMP_WEISS,""IINFO" /givecoins [ID] [Menge]");
		if(menge <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" du musst schon eine Menge angeben!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst nichts geben!");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		if((Spieler[pID][pCoins] + menge) > 100000000)return SCM(playerid,SAMP_WEISS,"So viel kann der Spieler nicht tragen.(Nur bis zu 100000000Coins möglich)");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %d Coins gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %d Coins gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[pID][pCoins] += menge;
	}
	else
	{
		ADMIN_MSG(playerid);
		return 1;
	}
	return 1;
}

COMMAND:give(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],cmd[30],menge;
    if(sscanf(params,"us[30]i",pID,cmd,menge))
	{
		SCM(playerid,SAMP_WEISS,""IINFO" /give [playerid/Name][Sache][Menge]");
		SCM(playerid,SAMP_WEISS,"Sache:");
	    SCM(playerid,SAMP_WEISS,"[Ganja/Kokain/Opium/Spice/Lunch/Zigarette/Kokainsamen/Ganjasamen/Coins/Spicesamen/Spice]");
	    return SCM(playerid,SAMP_WEISS,"[Materials/Werkzeugkasten/Benzinkanister/Köder/Spice/Opiumsamen/Kondome/Bier]");
	}
	if(menge <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" du musst schon eine Menge angeben!");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst nichts geben!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
    if(strcmp(cmd,"Ganja",true) == 0)
	{
		if((Spieler[playerid][pGanja] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viel Ganja mit dir!");
	    if((Spieler[pID][pGanja] + menge) > 2500)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %ig Ganja gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %ig Ganja gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pGanja] -= menge;
		Spieler[pID][pGanja] += menge;
		return 1;
	}
	if(strcmp(cmd,"Bier",true) == 0)
	{
		if((Spieler[playerid][pAlc] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viel Bier bei dir!");
	    if((Spieler[pID][pAlc] + menge) > 20)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Flasche/n Bier gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %d Flasche/n Bier gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pAlc] -= menge;
		Spieler[pID][pAlc] += menge;
		return 1;
	}
	if(strcmp(cmd,"Kondome",true) == 0)
	{
		if((Spieler[playerid][pCondoms] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viele Kondome bei dir!");
	    if((Spieler[pID][pCondoms] + menge) > 100)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Kondome gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %d Kondome gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pCondoms] -= menge;
		Spieler[pID][pCondoms] += menge;
		return 1;
	}
	if(strcmp(cmd,"Coins",true) == 0)
	{
		if((Spieler[playerid][pCoins] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht so viele Coins!");
	    if((Spieler[pID][pCoins] + menge) > 100000000)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Coins gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %d Coins gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pCoins] -= menge;
		Spieler[pID][pCoins] += menge;
		return 1;
	}
	if(strcmp(cmd,"Kokain",true) == 0)
	{
	    if((Spieler[playerid][pKokain] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viel Kokain bei dir!");
		if((Spieler[pID][pKokain] + menge) > 2500)return SCM(playerid,SAMP_WEISS,"So viel kannst der Spieler nicht tragen.");
		format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %ig Kokain gegeben.",SpielerName(pID),pID,menge);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dir soeben %ig Kokain gegeben.",SpielerName(playerid),playerid,menge);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s gibt etwas an %s **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pKokain] -= menge;
		Spieler[pID][pKokain] += menge;
		return 1;
	}
	if(strcmp(cmd,"Opium",true) == 0)
	{
