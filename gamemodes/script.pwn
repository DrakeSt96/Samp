	    	mysql_function_query(MySQL_R394,stringlogin,true,"l_script_sfahrzeuge","ii",playerid,slot);
	    }
	    mysql_SetInt("spieler","Online",1,"Name",Spieler[playerid][pName]);
		//AddToAutoLogin(playerid);
		StopPlayerPlaySound(playerid);
		PlayerPlaySound(playerid,1188,0.0,0.0,10.0);
		if(isPlayerAnAdmin(playerid,1))
		{
			format(stringlogin,sizeof(stringlogin),""IINFO" %s hat sich eingeloggt. Als Teammitglied.",SpielerName(playerid));
		    SendAdminMessage(WEISS,stringlogin);
		}
		if(Spieler[playerid][pKoffer] == 1) SetPlayerAttachedObject(playerid,9,1210,5,0.310000,0.066999,0.000000,0.000000,-91.900009,0.000000,1.000000,1.000000,1.000000);
		if(Spieler[playerid][pHandy] != 0)
		{
			if(Spieler[playerid][pHandystate] == 1 && Spieler[playerid][pHandyakku] > 0.0)
			{
				ShowHandyDraw(playerid);
			   	HandyAkku(playerid);
				AkkuTimer[playerid] = SetTimerEx("HandyAkku",120000,true,"i",playerid);
			}
		}/*
	    if(Spieler[playerid][pFraktion] != 0)
	    {
			format(stringlogin,sizeof(stringlogin),""IINFO" Fraktionsmitglied: %s hat sich eingeloggt!",SpielerName(playerid));
		    SendFraktionsMessage(Spieler[playerid][pFraktion],SAMP_WEISS,stringlogin);
		}*/
		if(Spieler[playerid][pViewTutorial] == 0)return ImTutorial[playerid] = 1;
		TogglePlayerControllable(playerid,true);
	    TogglePlayerSpectating(playerid,false);
		SpawnPlayerEx(playerid);
		StopAudioStreamForPlayer(playerid);
	 	MakeRace[playerid] = -1;
	 	SetPlayerWaffenSkill(playerid);
		if(!isPlayerInFrakt(playerid,0))
		{
			format(stringlogin,sizeof(stringlogin),"SELECT * FROM server_fnachicht WHERE fID='%d'",Spieler[playerid][pFraktion]);
			mysql_function_query(MySQL_R394,stringlogin,true,"sql_array2","siii",stringlogin,db_script_fmessage,playerid,MySQL_R394);
		}
		else SCM(playerid,SAMP_WEISS,"");
		if(Spieler[playerid][HatGeworben] == 0)
	    {
	    if(GetPlayerLevel(playerid) <= 3){}
	    else Spieler[playerid][HatGeworben] = 1;
	    }
		new zeitdauer = gettime()+(60*60*24*7*2);//2 wochen
		mysql_SetInt("spieler","PropertyClearTime",zeitdauer,"Name",SpielerName(playerid));
	    SetPVarInt(playerid,"Eingeloggt",1);
		printf("["ClanTag"][Account]: Spieler %s wurde geladen!",SpielerName(playerid));
		if(Spieler[playerid][cServerLeiste] == 1){
			ShowServerTD(playerid);
		}
		if(Spieler[playerid][cUpdate] == 1){
			ShowPlayerUpdate(playerid);
		}
        ShowEuro(playerid);
	 	for(new i;i<MAX_HAUS;i++)
		{
		    if(Spieler[playerid][cHausIcon] == 1){
				if(HausInfo[i][hauscreatet])
				{
					if(i < 500)SetPlayerMapIcon(playerid,i,HausInfo[i][haus_x],HausInfo[i][haus_y],HausInfo[i][haus_z],31,0,MAPICON_GLOBAL);
				}
			}
		}
	}
	return 1;
}
public l_script_sfahrzeuge(playerid,slot)
{
	new result[950],rows,fields;
    if(mysql_errno(MySQL_R394) != 0)
	{
		getdate(tag,monat,jahr);
		gettime(stunde,minute,sekunde);
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && GetPVarInt(i,"Eingeloggt") == 1)
			{
				SaveAccount(i);
			}
		}
	    Log("Restartssqllog","Admin: System hat den Server gerestartet(Dead MySql Connection)!");
	    OnGameModeSave();
	    GameModeExit();
		return 1;
	}
    cache_get_data(rows,fields);
	if(rows)
