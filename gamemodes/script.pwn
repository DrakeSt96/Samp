command(sprunkinfo, playerid, const params[])
{
    #pragma unused params
   	new string[128];
   	if(SpielerInfo[playerid][pJob] != 2)
   	{
   	    SCM(playerid,COLOR_RED,"Du bist kein Mitglied der Sprunk Systems GmbH!");
   	    return 1;
   	}
	if(GetPVarInt(playerid,"JobDuty") == 0)
	{
 		SCM(playerid,COLOR_RED,MSG_NOTDUTY);
   		return 1;
	}
	new nearestsprunk = ReturnSPRUNKID(playerid);
 	if(nearestsprunk != -1)
 	{
 	    if(SprunkInfo[nearestsprunk][EGmBhHp] <= 0)
 	    {
 	        SCM(playerid,COLOR_RED,""IINFO" der Sprunkautomat ist kaputt, bitte rufe den San Andreas Eletrical Service an!");
 	        return 1;
 	    }
 	    ClearChat(playerid);
 	    format(string, sizeof(string),""IINFO" der Sprunkautomat hat %d/150 Sprunkdosen!", SprunkInfo[nearestsprunk][SprunkInhalt]);
 	    SCM(playerid,COLOR_WHITE,string);
 	    return 1;
 	}
 	else
 	{
 	    SCM(playerid,COLOR_RED,"Du bist nicht in der Nähe von einem Sprunkautomat!");
 	    return 1;
 	}
}
COMMAND:fillsprunk, playerid, params[])
{
    #pragma unused params
   	new string[128],gehalt = 0,rand = random(10),restgehalt = 46 + random (42);
   	if(SpielerInfo[playerid][pJob] != 2)
   	{
   	    SCM(playerid,COLOR_RED,"Du bist kein Mitglied der Sprunk Systems GmbH!");
   	    return 1;
   	}
	if(GetPVarInt(playerid,"Sprunkcooldown") != 0)
	{
 		SCM(playerid,COLOR_RED,"Du kannst jetzt keinen Sprunkautomat befüllen!");
   		return 1;
	}
	new nearestsprunk = ReturnSPRUNKID(playerid);
 	if(nearestsprunk != -1)
 	{
 	    new rest = 150-SprunkInfo[nearestsprunk][SprunkInhalt];
  		if(SprunkInfo[nearestsprunk][EGmBhHp] <= 0)
 	    {
 	        SCM(playerid,COLOR_RED,""IINFO" der Sprunkautomat ist kaputt, bitte rufe einen Elektroniker an!");
 	        return 1;
 	    }
		if(SprunkInfo[nearestsprunk][SprunkInhalt] == 150)
		{
		    SCM(playerid,COLOR_RED,""IINFO" der Sprunkautomat ist noch voll!");
		    return 1;
		}
		if(rest > GetPVarInt(playerid,"SprunkPaket"))
		{
		    SCM(playerid,COLOR_RED,"Du hast nicht genügend Sprunkdosen dabei!");
		    return 1;
		}
		if(rest > 75)
		{
		    gehalt = rest * 3;
		}
		else
		{
			gehalt = rest * 4;
		}
		SetPVarInt(playerid,"SprunkPaket",GetPVarInt(playerid,"SprunkPaket")-rest);
		SpielerInfo[playerid][pPraemie] += gehalt;
  		format(string, sizeof(string),"Du hast erfolgreich %d Sprunkdosen in den Sprunkautomat befüllt. Du erhältst %d€.",rest,gehalt);
 	    SCM(playerid,COLOR_WHITE,string);
 	    PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
 	    SprunkInfo[nearestsprunk][SprunkInhalt] = 150;
 	    if(rand == 10)
 	    {
	  		format(string, sizeof(string),"Du hast %d€ Restgeld noch im Sprunkautomat gefunden!", restgehalt);
	 	    SCM(playerid,COLOR_WHITE,string);
	 	    GivePlayerEuro(playerid,restgehalt);
 	    }
 	    return 1;
 	}
 	else
 	{
 	    SCM(playerid,COLOR_RED,"Du bist nicht in der Nähe von einem Sprunkautomat!");
 	    return 1;
 	}
}
command(sprunkeinlagern, playerid, const params[])
{
    #pragma unused params
   	new vehicleid = GetClosestVehicle(playerid, 4.9);
   	SetPVarInt(playerid,"ASprunk",1);
