COMMAND:parteiname(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new name[32],p = Spieler[playerid][pParteiLeader],string[128];
	if(p == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Partei Leader.");
	if(sscanf(params,"s[32]",name))return SCM(playerid,SAMP_WEISS,""IINFO" /parteiname [Name]");
	if(strlen(name) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /parteiname [Name darf maximal 30 Zeichen beinhalten]");
	strmid(PartInfo[p][ParteiName],name,0,strlen(name),32);
	format(string,sizeof(string),""IINFO" du hast den Namen der Partei in "IINFO2"%s"#HTML_WEISS" umgeändert.",PartInfo[p][ParteiName]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s hat den Namen der Partei in "IINFO2"%s"#HTML_WEISS" umgeändert.",Spieler[playerid][pName],PartInfo[p][ParteiName]);
	SendParteiMessage(p,SAMP_WEISS,string);
	return 1;
}
COMMAND:parteimbeitrag(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new betrag,p = Spieler[playerid][pParteiLeader],string[128];
	if(p == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Partei Leader.");
	if(sscanf(params,"i",betrag))return SCM(playerid,SAMP_WEISS,""IINFO" /parteimbeitrag [Mitgliedsbeitrag]");
	if(betrag >= 0 && betrag <= 150)return SCM(playerid,SAMP_WEISS,""IINFO" /parteimbeitrag [0 - 150$]");
	PartInfo[p][ParteiMBeitrag] = betrag;
	format(string,sizeof(string),""IINFO" du hast den Mitgliedsbeitrag der Partei in '%i' geändert.",PartInfo[p][ParteiMBeitrag]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s hat den Mitgliedsbeitrag der Partei in '%i' geändert.",SpielerName(playerid),PartInfo[p][ParteiMBeitrag]);
	SendParteiMessage(p,SAMP_WEISS,string);
	return 1;
}
COMMAND:parteidelete(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new p = Spieler[playerid][pParteiLeader],string[128];
	if(p == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Partei Leader.");
	if(strcmp(Spieler[playerid][pName],PartInfo[p][ParteiOwner],true) == 0)
	{
		format(string,sizeof(string),""IINFO" du hast die Partei "IINFO2"%s"#HTML_WEISS" aufgelöst.",PartInfo[p][ParteiName]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s hat die Partei "IINFO2"%s"#HTML_WEISS" aufgelöst.",Spieler[playerid][pName],PartInfo[p][ParteiName]);
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && GetPVarInt(i,"Eingeloggt") == 1 && (Spieler[i][pParteiLeader] == p || Spieler[playerid][pParteiMember] == p))
			{
				SCM(i,SAMP_WEISS,string);
				Spieler[i][pParteiLeader] = 0;
				Spieler[i][pParteiMember] = 0;
			}
		}
		format(string,sizeof(string),"SELECT * FROM spieler WHERE pParteiMember='%d'",p);
	    mysql_function_query(MySQL_R394,string,true,"sql_array2","siii",string,_SQL_REMOVEACCSFROMPARTEI,playerid,MySQL_R394);
	    PartInfo[p][ParteiCreatet] = 0;
		strmid(PartInfo[p][ParteiName],"Keinen",0,strlen("Keinen"),32);
		strmid(PartInfo[p][ParteiOwner],"Keinen",0,strlen("Keinen"),24);
		strmid(PartInfo[p][ParteiMotto],"Keins",0,strlen("Keins"),128);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht der Besitzer der Partei.");
}
COMMAND:parteileave(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],p = Spieler[playerid][pParteiMember];
    if(p == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Partei.");
    if(strcmp(Spieler[playerid][pName],PartInfo[p][ParteiOwner],false) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst deine Partei nicht eigenhändig verlassen.");
	format(string,sizeof(string),"%s hat die Partei "IINFO2"%s"#HTML_WEISS" verlassen.",SpielerName(playerid),PartInfo[p][ParteiName]);
	SendParteiMessage(p,SAMP_WEISS,string);
	Spieler[playerid][pParteiLeader] = 0;
	Spieler[playerid][pParteiMember] = 0;
	return 1;
}
COMMAND:parteiinvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],p = Spieler[playerid][pParteiLeader];
    if(p == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Partei Leader.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /parteiinvite [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pParteiMember] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist bereits in einer Partei.");
	format(string,sizeof(string),"%s (ID:%i) hat dir eine Einladung in die Partei "IINFO2"%s"#HTML_WEISS" gesendet.(/accept parteiinvite)",SpielerName(playerid),playerid,PartInfo[p][ParteiName]);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" du hast %s (ID:%i) eine Einladung in deine Partei gesendet.",SpielerName(pID),pID);
	SCM(playerid,SAMP_WEISS,string);
	Spieler[pID][pSeller] = playerid;
	Spieler[pID][pAngebot] = 20;
	Spieler[pID][pMenge] = p;
	return 1;
}
COMMAND:parteiuninvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],p = Spieler[playerid][pParteiLeader];
    if(p == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Partei Leader.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /parteiuninvite [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pParteiMember] != p)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Organisation Mitglied.");
	if(strcmp(Spieler[pID][pName],PartInfo[p][ParteiOwner],true) == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst den Inhaber der Orgnisation nicht aus der Organisation schmeißen.");
	format(string,sizeof(string),""IINFO" du wurdest von %s (ID:%i) aus der Partei "IINFO2"%s"#HTML_WEISS" geschmissen.",Spieler[playerid][pName],playerid,PartInfo[p][ParteiName]);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),"%s wurde von %s aus der Partei geschmissen.",Spieler[pID][pName],Spieler[playerid][pName]);
	SendParteiMessage(p,SAMP_WEISS,string);
	Spieler[pID][pParteiLeader] = 0;
	Spieler[pID][pParteiMember] = 0;
	return 1;
}
COMMAND:parteimakeleader(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],p = Spieler[playerid][pParteiLeader];
    if(p == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Unternehmer.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /orgmakeleader [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pParteiMember] != p)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Partei Mitglied.");
	if(Spieler[pID][pParteiLeader] != 0)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits Leiter der Partei.");
	format(string,sizeof(string),""IINFO" du wurdest von %s (ID:%i) zum Leiter der Partei "IINFO2"%s"#HTML_WEISS" ernannt.",Spieler[playerid][pName],playerid,PartInfo[p][ParteiName]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s hat %s zum Leiter der Partei ernannt.",Spieler[playerid][pName],Spieler[pID][pName]);
	SendParteiMessage(p,SAMP_WEISS,string);
	Spieler[pID][pParteiLeader] = p;
	return 1;
}
