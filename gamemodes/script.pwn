stock UpdateHandyTextdraw(playerid)
{
	new string[128];
	if(Spieler[playerid][pHandyFlat] == 0)
	{
		switch(ReturnHempfangRate(playerid))
		{
			case -1:
			{
				format(string,sizeof(string),"Guthaben: %i$ I Verbindung: ~r~keine",Spieler[playerid][pHandyCoins]);
				PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 1:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~%i$~w~ I Verbindung: ~g~IIIIII",Spieler[playerid][pHandyCoins]);
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 2:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~%i$~w~ I Verbindung: ~g~IIIII",Spieler[playerid][pHandyCoins]);
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 3:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~%i$~w~ I Verbindung: ~g~IIII",Spieler[playerid][pHandyCoins]);
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 4:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~%i$~w~ I Verbindung: ~g~III",Spieler[playerid][pHandyCoins]);
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 5:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~%i$~w~ I Verbindung: ~g~II",Spieler[playerid][pHandyCoins]);
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 6:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~%i$~w~ I Verbindung: ~g~I",Spieler[playerid][pHandyCoins]);
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
		}
    }
    else
    {
	    switch(ReturnHempfangRate(playerid))
		{
			case -1:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~Vertrag~w~ I Verbindung: ~r~keine");
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 1:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~Vertrag~w~ I Verbindung: ~g~IIIIII");
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 2:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~Vertrag~w~ I Verbindung: ~g~IIIII");
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 3:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~Vertrag~w~ I Verbindung: ~g~IIII");
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 4:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~Vertrag~w~ I Verbindung: ~g~III");
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 5:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~Vertrag~w~ I Verbindung: ~g~II");
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
			case 6:
			{
			    format(string,sizeof(string),"~w~Guthaben: ~y~Vertrag~w~ I Verbindung: ~g~I");
			    PlayerTextDrawSetString(playerid,Handy_Draw_Info[playerid],string);
			}
		}
    }
	return 1;
