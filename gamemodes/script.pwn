COMMAND:alkatraz(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128],alkacount,Float:Pos[3];
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
    SCM(playerid,SAMP_WEISS,"[Personen auf dem Alkatraz]");
    ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				GetPlayerPos(i,Pos[0],Pos[1],Pos[2]);
				if(IsPlayerInZone(i,-2557.455,1588.191,-1868.46,2125.373) && Pos[2] < 215 && Spieler[i][pJailed] == 0)
				{
					format(string,sizeof(string),"%s - %s (ID:%i) - HP: %.1f - Rüstung: %.1f",SpielerName(i),Spieler[i][pName],i,GetPlayerACHealth(i),GetPlayerACArmour(i));
					SCM(playerid,SAMP_WEISS,string);
					alkacount++;
				}
			}
		}
	}
	if(alkacount == 0)return SCM(playerid,SAMP_WEISS,""IINFO" derzeit befindet sich keiner auf dem Alkatraz!");
	return 1;
}

