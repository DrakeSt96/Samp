stock TMastenCount()
{
	new index;
	for(new msten=0;msten<MAX_MASTEN;msten++)
	{
	 	if(FMastenInfo[msten][Erstellt] == 1)
		index++;
	}
 	return index;
}
stock IsPlayerVehicleKFZClass1(vehicleid)//nicht die besten autos
{
	new result;
	new model = GetVehicleModel(vehicleid);
    switch(model)
    {
	    case 400,401,402,404,410,412,418,419,421,422,424,434,436,439,441,457,458,464,465,466,467,474,475,478,479,489,
	 	491,492,496,500,504,505,507,516,517,518,526,527,529,533,534,535,536,540,542,543,545,546,547,549,550,551,
	 	571,576,585,600,604,605: result = model;
	    default:result = 0;
    }
	return result;
}
stock IsPlayerVehicleKFZClass2(vehicleid)//mehr nutzfahrzeuge wie lkw´s undso
{
	new result;
	new model = GetVehicleModel(vehicleid);
    switch(model)
    {
	    case 403,406,407,408,413,414,416,420,423,427,428,431,433,437,438,440,442,443,444,455,456,459,482,483,485,486,
	 	498,499,514,515,524,525,530,531,532,544,552,556,557,561,564,572,573,574,578,582,583,588,609: result = model;
	    default:result = 0;
    }
	return result;
}
stock IsPlayerVehicleKFZClass3(vehicleid)//sportwagen/luxus carren
{
	new result;
	new model = GetVehicleModel(vehicleid);
    switch(model)
    {
	    case 409,411,415,426,429,445,451,470,477,480,490,494,495,502,503,506,508,528,541,554,555,558,559,560,562,565,
	 	566,567,568,575,579,580,587,589,596,597,598,599,601,602,603: result = model;
	    default:result = 0;
    }
	return result;
}
stock IsPlayerVehicleKFZClass4(vehicleid)//zweiräder,quads
{
	new result;
	new model = GetVehicleModel(vehicleid);
    switch(model)
    {
	    case 448,461,462,463,468,471,521,522,523,581,586: result = model;
	    default:result = 0;
    }
	return result;
}
stock IsPlayerVehicleKFZClass5(vehicleid)//boote,flugzeuge,helikopter,tram,züge,vortex
{
	new result;
	new model = GetVehicleModel(vehicleid);
    switch(model)
    {
	    case 417,425,430,446,447,449,452,453,454,460,469,472,473,476,484,487,488,493,496,501,511,512,513,519,520,537,
		538,539,548,553,563,577,592,593: result = model;
	    default:result = 0;
    }
	return result;
}
stock GetPlayerVehicleCount(playerid)
{
	new vehicles = 0;
    for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
	{
		if(!strcmp(Spieler[playerid][pName],Pfahrzeug[slot][playerid][Besitzer],true))
		{
			if(IsValidVehicle(Pfahrzeug[slot][playerid][Vehicle]))
			vehicles++;
		}
	}
	return vehicles;
}
stock HavePlayerALivinvehicle(playerid)
{
    for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
	{
		if(!strcmp(Spieler[playerid][pName],Pfahrzeug[slot][playerid][Besitzer],true))
		{
			if(IsValidVehicle(Pfahrzeug[slot][playerid][Vehicle]))
			{
				if(Pfahrzeug[slot][playerid][modelid] == 508)
				return slot;
			}
		}
	}
	return -1;
}
stock UpdatePlayer(playerid)
{
    new Float:Pos[4],string[128],vehicleid = GetPlayerVehicleID(playerid);
	for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
	{
	    if(!strcmp(Spieler[playerid][pName],Pfahrzeug[slot][playerid][Besitzer],true))
		{
			if(IsValidVehicle(Pfahrzeug[slot][playerid][Vehicle]))
			{
				if(gettime() > Pfahrzeug[slot][playerid][AnmeldeTime] && Pfahrzeug[slot][playerid][AnAnmeldung] == 1)
				{
					GetVehiclePos(Pfahrzeug[slot][playerid][Vehicle],Pos[0],Pos[1],Pos[2]);
					GetVehicleZAngle(Pfahrzeug[slot][playerid][Vehicle],Pos[3]);
					GetVehicleHealth(Pfahrzeug[slot][playerid][Vehicle],Pfahrzeug[slot][playerid][HP]);
				 	VehicleSpawner(playerid,slot);
					SetVehiclePosEx(Pfahrzeug[slot][playerid][Vehicle],Pos[0],Pos[1],Pos[2]);
					SetVehicleZAngleEx(Pfahrzeug[slot][playerid][Vehicle],Pos[3]);
					Pfahrzeug[slot][playerid][AnAnmeldung] = 0;
				 	Pfahrzeug[slot][playerid][AnmeldeTime] = 0;
					Pfahrzeug[slot][playerid][Angemeldet] = 1;
				}
			}
		}
	}
    if(Spieler[playerid][pPersoLic] == 0 && gettime() > Spieler[playerid][WaitPerso] && Spieler[playerid][WaitPersoReadyMsg] == 0 && Spieler[playerid][WaitPerso] != 0)
    {
	    Spieler[playerid][WaitPersoReadyMsg] = 1;
	    SCM(playerid,SAMP_WEISS,""IINFO2" dein Perso sollte fertig sein. hole ihn in der Stadthalle ab.");
    }
	if(PlayerSpawned[playerid] == 1)
	{
	if(Spieler[playerid][pInHospital] != 0)
	{
		Spieler[playerid][pInHospital]--;
		ApplyAnimation(playerid,"CRACK","crckdeth2",4.0,true,true,true,false,0,SYNC_ALL);
		if(Spieler[playerid][pInHospital] <= 0) Spieler[playerid][pInHospital] = 0,SpawnPlayerEx(playerid);
	}
	if(Spieler[playerid][pRevived] == 1) ApplyAnimation(playerid,"CRACK","crckdeth2",4.0,true,true,true,false,0,SYNC_ALL);
	if(gettime() > Spieler[playerid][pNextDeath] && Spieler[playerid][pDeath] != 0 && Spieler[playerid][pNextDeath] != 0)
	{
		SCM(playerid,WANTEDDEATHERROT,""IINFO" du bist gestorben da dein Zustand sich enorm verschlechtert hat.");
		Spieler[playerid][pRevived] = 0;
		Spieler[playerid][pNextDeath] = 0;
		SetPlayerACHealth(playerid,100);
		Spieler[playerid][pDeathTime] = 0;
		Spieler[playerid][pIssureKiller] = -1;
		Spieler[playerid][pRobProtect] = -1;
		Spieler[playerid][pFriedhof] = 1;
		Spieler[playerid][pDeath] = 0;
		if(Spieler[playerid][tot_int] == 0 && Spieler[playerid][tot_world] == 0){CreateToten(playerid);}
		SpawnPlayerEx(playerid);
	}
	if(Spieler[playerid][pDeath] != 0 && Spieler[playerid][pInPrison] == 0 && Spieler[playerid][pRevived] == 0)
	{
		Spieler[playerid][pDeathTime]++;
		ApplyAnimation(playerid,"CRACK","crckdeth2",4.0,true,true,true,false,0,SYNC_ALL);
		//GameTextForPlayer(playerid,"~r~~n~~n~~n~Du bist verletzt.",1000,3);
		if(Spieler[playerid][pDeathTime] >= DEAHTIME)
		{
			SetPlayerACHealth(playerid,100);
			Spieler[playerid][pDeathTime] = 0;
			Spieler[playerid][pIssureKiller] = -1;
			Spieler[playerid][pRobProtect] = 0;
			Spieler[playerid][pFriedhof] = 1;
			Spieler[playerid][pRevived] = 0;
			Spieler[playerid][pNextDeath] = 0;
			Spieler[playerid][pDeath] = 0;
			if(Spieler[playerid][tot_int] == 0 && Spieler[playerid][tot_world] == 0){CreateToten(playerid);}
			SpawnPlayerEx(playerid);
		}
	}
	if(Spieler[playerid][pFriedhof] != 0 && Spieler[playerid][pInPrison] == 0)
	{
		Spieler[playerid][pFriedhofTime]++;
		if(Spieler[playerid][pFriedhofTime] >= FRIEDHOFSZEIT)
		{
			Spieler[playerid][pFriedhofTime] = 0;
			Spieler[playerid][pFriedhof] = 0;
			SetPlayerACHealth(playerid,100);
			SetPlayerVirtualWorld(playerid,0);
			SpawnPlayerEx(playerid);
		}
	}
    if(Spieler[playerid][pJailed] != 0 && Spieler[playerid][pInPrison] == 0)
	{
		Spieler[playerid][pJailTime]--;
		if(Spieler[playerid][pJailTime] <= 0)
		{
			switch(Spieler[playerid][pJailed])
			{
				case 1:
				{
					SetPlayerPosEx(playerid,1545.3734,-1675.8513,13.5602);
					SetPlayerInterior(playerid,0);
					SetPlayerVirtualWorld(playerid,0);
				}
				case 2:
				{
					SetPlayerPosEx(playerid,1545.3734,-1675.8513,13.5602);
					SetPlayerInterior(playerid,0);
					SetPlayerVirtualWorld(playerid,0);
				}
				case 3:
				{
					SetPlayerPosEx(playerid,1545.3734,-1675.8513,13.5602);
					SetPlayerInterior(playerid,0);
					SetPlayerVirtualWorld(playerid,0);
				}
			}
			Spieler[playerid][pJailTime] = 0;
			Spieler[playerid][pJailed] = 0;
			Spieler[playerid][pKaution] = 0;
			strmid(pWantedReason1[playerid],"-",0,strlen("-"),64);
			strmid(pWantedReason2[playerid],"-",0,strlen("-"),64);
			strmid(pWantedReason3[playerid],"-",0,strlen("-"),64);
			strmid(pWantedReason4[playerid],"-",0,strlen("-"),64);
			strmid(pWantedReason5[playerid],"-",0,strlen("-"),64);
			Spieler[playerid][pLastSuspects] = 0;
			SCM(playerid,WEISS,""IINFO" du hast deine Zeit abgesessen und bist frei.");
			SCM(playerid,WEISS,"Benehm dich in Zunkunft besser.");
		}
	}
	}

	if(Spieler[playerid][pMuted] != 0)
	{
		Spieler[playerid][pMuteTime]--;
		if(Spieler[playerid][pMuteTime] <= 0)
		{
			Spieler[playerid][pMuteTime] = 0;
			Spieler[playerid][pMuted] = 0;
			SCM(playerid,WEISS,""IINFO" du wurdest vom System entmutet.");
		}
	}
	if(SpawnKillStatus[playerid] == 1)
	{
		SpawnKillCount[playerid]++;
	    if(SpawnKillCount[playerid] >= 20)
	    {
			SpawnKillCount[playerid] = 0;
			SpawnKillStatus[playerid] = 0;
			TextDrawHideForPlayer(playerid,Spawnkilldraw);
		}
    }
	//if(isPlayerAtDriveIn(playerid) != -1) GameTextForPlayer(playerid,"~w~BENUTZE:~r~/DRIVEIN ODER DIE TASTE N",2000,3);
	//if(ReturnATMID(playerid) != -1) GameTextForPlayer(playerid,"~b~BANKAUTOMAT~n~~w~/BANKMENU ODER DIE TASTE H",2000,3);
    if(Spieler[playerid][pHandy] != 0 && Spieler[playerid][pHandystate] == 1 && Spieler[playerid][pHandyakku] > 0.0)
	{
		UpdateHandyTextdraw(playerid);
	}

	if(IsPlayerInVehicle(playerid,Spieler[playerid][PprobefahrtVeh]) && gettime() > Spieler[playerid][PprobefahrtTime])
	{
		if(GetVehicleModel(vehicleid) == GetVehicleModel(Pvehicles[Spieler[playerid][PprobefahrtVehID]]))
		{
		    DeleteVehicle(vehicleid);
		    PutPlayerInVehicleEx(playerid,Pvehicles[Spieler[playerid][PprobefahrtVehID]],0);
		    Spieler[playerid][PprobefahrtVeh] = 0;
			Spieler[playerid][PprobefahrtTime] = 0;
			Spieler[playerid][PprobefahrtVehID] = -1;
			TextDrawShowForPlayer(playerid,Introdraw[0]);
		    TextDrawShowForPlayer(playerid,Introdraw[1]);
			TogglePlayerControllable(playerid,false);
		    ShowPlayerDialog(playerid,DIALOG_AutoKaufen_Liste,DIALOG_STYLE_LIST,""ClanTagDialoge" Auothaus - Hauptmenü",""#HTML_BLAU"1."#HTML_WEISS" Auto Kaufen\n"#HTML_BLAU"2."#HTML_WEISS" Probefahrt\n"#HTML_BLAU"3."#HTML_WEISS" Fahrzeug Papiere","Nehmen","Abbrechen");
		}
		if(GetVehicleModel(vehicleid) == GetVehicleModel(Fvehicles[Spieler[playerid][PprobefahrtVehID]]))
		{
		    DeleteVehicle(vehicleid);
		    PutPlayerInVehicleEx(playerid,Fvehicles[Spieler[playerid][PprobefahrtVehID]],0);
		    Spieler[playerid][PprobefahrtVeh] = 0;
			Spieler[playerid][PprobefahrtTime] = 0;
			Spieler[playerid][PprobefahrtVehID] = -1;
			TextDrawShowForPlayer(playerid,Introdraw[0]);
		    TextDrawShowForPlayer(playerid,Introdraw[1]);
			TogglePlayerControllable(playerid,false);
			ShowPlayerDialog(playerid,DIALOG_AutoKaufen_Liste,DIALOG_STYLE_LIST,""ClanTagDialoge" Auothaus - Hauptmenü",""#HTML_BLAU"1."#HTML_WEISS" Auto Kaufen\n"#HTML_BLAU"2."#HTML_WEISS" Probefahrt\n"#HTML_BLAU"3."#HTML_WEISS" Fahrzeug Papiere","Nehmen","Abbrechen");
		}
	}
	Tanken(playerid);
	for(new i=0;i<MAX_MINEN;i++)
	{
		if(MinenInfo[i][Erstellt] == 1)
	    {
		  	if(IsPlayerInRangeOfPoint(playerid,7.5,MinenInfo[i][sperreX],MinenInfo[i][sperreY],MinenInfo[i][sperreZ]))
		   	{
			   	if(!isPlayerInFrakt(playerid,6) && Spieler[playerid][pDuty] == 0)
				{
				    format(string,sizeof(string),"** %s tritt auf etwas Geheimes **",SpielerName(playerid));
					PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
					CreateExplosion(MinenInfo[i][sperreX],MinenInfo[i][sperreY],MinenInfo[i][sperreZ],7,15);
					AddFire(MinenInfo[i][sperreX],MinenInfo[i][sperreY],MinenInfo[i][sperreZ],GetPlayerVirtualWorld(playerid),true);
					DeleteMinen(i);
				}
			}
		}
	}
	if(ReturnZollID(playerid) != -1)
	{
		switch(Zoll[ReturnZollID(playerid)][zollgesperrt])
		{
			case 0:
			{
				format(string,sizeof(string),"~g~Zoll %i in Richtung %s~n~"IINFO" /zoll~n~Kosten: %i$~n~Geoeffnet",ReturnZollID(playerid),Zoll[ReturnZollID(playerid)][zollbeschriftung],Zoll[ReturnZollID(playerid)][zollcash]);
				GameTextForPlayer(playerid,string,1000,3);
			}
			case 1:
			{
				format(string,sizeof(string),"~r~Zoll %i in Richtung %s~n~"IINFO" /zoll~n~Kosten: %i$~n~Gesperrt",ReturnZollID(playerid),Zoll[ReturnZollID(playerid)][zollbeschriftung],Zoll[ReturnZollID(playerid)][zollcash]);
				GameTextForPlayer(playerid,string,1000,3);
			}
		}
	}
    if(AnTelefonZelle[playerid] == 1)
	{
		if(ReturnTelefonzellenID(playerid) == -1)
		{
			if(Spieler[playerid][pCallHim] == 1)
			{
				new pID = Spieler[playerid][pCall];
				Spieler[playerid][pCallHim] = 0;
				Spieler[pID][pCallHim] = 0;
				Spieler[pID][pCall] = -1;
				Spieler[playerid][pCall] = -1;
				SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
				SetPlayerSpecialAction(pID,SPECIAL_ACTION_STOPUSECELLPHONE);
				SCM(playerid,SAMP_WEISS,""IINFO" du hast das Gespräch beendet.");
				SCM(pID,SAMP_WEISS,""IINFO" der Gesprächspartner hat aufgelegt.");
				PlayerPlaySound(playerid,1077,0.0,0.0,0.0);
				PlayerPlaySound(pID,1077,0.0,0.0,0.0);
				RemovePlayerAttachedObject(pID,8);
				RemovePlayerAttachedObject(playerid,8);
			}
		}
		else if(TeleZelleInfo[ReturnTelefonzellenID(playerid)][EGmBhHp] <= 0)
		{
			if(Spieler[playerid][pCallHim] == 1)
			{
				new pID = Spieler[playerid][pCall];
				Spieler[playerid][pCallHim] = 0;
				Spieler[pID][pCallHim] = 0;
				Spieler[pID][pCall] = -1;
				Spieler[playerid][pCall] = -1;
				SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
				SetPlayerSpecialAction(pID,SPECIAL_ACTION_STOPUSECELLPHONE);
				SCM(playerid,SAMP_WEISS,"Verbindung unterbrochen.");
				SCM(pID,SAMP_WEISS,"Verbindung unterbrochen.");
				PlayerPlaySound(playerid,1077,0.0,0.0,0.0);
				PlayerPlaySound(pID,1077,0.0,0.0,0.0);
				RemovePlayerAttachedObject(pID,8);
				RemovePlayerAttachedObject(playerid,8);
			}
		}
	}
	if(Spieler[playerid][LiveView] == 1)
	{
		if(!IsPlayerInRangeOfPoint(playerid,10.0,861.9858,-1045.1128,25.9659) && !IsPlayerInRangeOfPoint(playerid,10.0,-219.3893,1410.6112,27.7734) || !IsPlayerInRangeOfPoint(playerid,10.0,-219.3893,1410.6112,27.7734) && !IsPlayerInRangeOfPoint(playerid,10.0,861.9858,-1045.1128,25.9659))
		{
			format(string,sizeof(string),"%s verließ das Interview.",SpielerName(playerid));
			SendClientMessageToAll(ORANGE,string);
			Spieler[playerid][InviteInterView] = 0;
			Spieler[playerid][LiveView] = 0;
		}
	}
	if(IsPlayerInAnyVehicle(playerid) && GetPlayerVehicleSeat(playerid) == 0)
	{
		if(!IsVehAStadium1Vehicle(vehicleid) || !IsVehAStadium2Vehicle(vehicleid) || !IsVehAStadium3Vehicle(vehicleid) || !IsVehAStadium4Vehicle(vehicleid) || !IsVehAStadium5Vehicle(vehicleid) || !IsVehAStadium6Vehicle(vehicleid))
		{
			new Float:vhealth,mediccounter = 0;
			GetVehicleHealth(vehicleid,vhealth);
			if(vhealth < 330 && MotorDown[vehicleid] == 0)
			{
			    ForEachPlayer(i){if(IsPlayerConnected(i)){if(isPlayerInFrakt(i,3) && Spieler[i][pDuty] != 0){mediccounter++;}}}
			    new vehiclehra = random(10);
			    if(vehiclehra != 5 || vehiclehra != 1)
			    {
			        format(SP_INFO,sizeof(SP_INFO),"%s: nhn? Der Motor Springt nicht an.",SpielerName(playerid));
					SCM(playerid,WEISS,SP_INFO);
    				MotorDown[vehicleid] = 1;
			    	GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
					SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
					Motor[vehicleid] = false;
					SetVehicleHealth(vehicleid,350);
				}
				else if(vehiclehra == 5 || vehiclehra == 1)
				{
				    if(mediccounter >= 2)
				    {
				        new Float:vCords[3];
				        GetVehiclePos(vehicleid,vCords[0],vCords[1],vCords[2]);
				        format(SP_INFO,sizeof(SP_INFO),"%s: verdammt! Ich muss versuchen an meinem Handy zu kommen. "#HTML_GRUEN"(/services)",SpielerName(playerid));
						SCM(playerid,WEISS,SP_INFO);
						format(SP_INFO,sizeof(SP_INFO),"** %s hatte einen Autounfall und steckt fest **",SpielerName(playerid));
						PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	    				MotorDown[vehicleid] = 1;
	    				RescueState[playerid] = true;
				    	GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
						SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
						Motor[vehicleid] = false;
						TogglePlayerControllable(playerid, false);
						InterpolateCameraPos(playerid,vCords[0],vCords[1],vCords[2],vCords[0]+1,vCords[1]+2,vCords[2]+1,3500,CAMERA_MOVE);
						InterpolateCameraLookAt(playerid,vCords[0],vCords[1],vCords[2],vCords[0]+1,vCords[1],vCords[2]+1,3500,CAMERA_MOVE);
					    PlayerPlaySound(playerid,8002,0.0,0.0,0.0);
						SetVehicleHealth(vehicleid,350);
					}
					else
					{
				        format(SP_INFO,sizeof(SP_INFO),"%s: Mist! Einen Motorschaden, ich sollte jemanden Anrufen der mir Hilft.",SpielerName(playerid));
						SCM(playerid,WEISS,SP_INFO);
	    				MotorDown[vehicleid] = 1;
				    	GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
						SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_OFF,lights,alarm,doors,bonnet,boot,objective);
						Motor[vehicleid] = false;
						SetVehicleHealth(vehicleid,350);
					}
				}
			}
			if(Motor[vehicleid] == true && vhealth > 330 && MotorDown[vehicleid] == 0)
			{
				if(vFahrzeug[vehicleid][FailGas] != 0)
				{
					if(vFahrzeug[vehicleid][FailGas] != VehicleInfo[GetVehicleModel(vehicleid)-400][vtankklasse])
					{
						SetVehicleHealth(vehicleid,vhealth - 50);
					}
				}
			}
		}
	    for(new blitzerid=0;blitzerid<MAX_BLITZER;blitzerid++)
	 	{
		 	if(Blitzer[blitzerid][Erstellt] == 1)
		  	{
			  	if(IsVehicleInRangeOfPoint(vehicleid,12.5,Blitzer[blitzerid][sperreX],Blitzer[blitzerid][sperreY],Blitzer[blitzerid][sperreZ]) && gettime() > Spieler[playerid][pBlitzerTime])
			 	{
				 	if(Blitzer[blitzerid][EGmBhHp] > 0)
 					{
					 	if(GetVehicleSpeed(vehicleid) > (Blitzer[blitzerid][BlitzerGeschwindigkeit] + fsteuern[BlitzerToleranz]) && Spieler[playerid][pDuty] == 0)
					 	{
					 	    if(InviteInRace[playerid] == 0)
					 	    {
							 	if(Spieler[playerid][pAdminOnduty] == false)
							 	{
								 	Spieler[playerid][pBlitzerTime] = gettime() + 10;
		                            PlayerPlaySound(playerid,1132,0.0,0.0,0.0);
									format(string,sizeof(string),""IINFO" du wurdest wegen einer überhöhten Geschwindigkeit (%i/%i Km/h | Toleranz: %i Km/h) geblitzt.",GetVehicleSpeed(GetPlayerVehicleID(playerid)),Blitzer[blitzerid][BlitzerGeschwindigkeit],fsteuern[BlitzerToleranz]);
								    SCM(playerid,SAMP_WEISS,string);
									if((Spieler[playerid][pWantedPoints] + 1) <= 60)
									{
										format(string,sizeof(string),"Fahndung: Fall bearbeitet vom Blitzer %i || Wantedvergabe: 1 || Wanteds gesamt: %i || Grund: Überhöhte Geschwindigkeit",blitzerid,Spieler[playerid][pWantedPoints]+1);
										SCM(playerid,SAMP_WEISS,string);
										GivePlayerWPS(playerid,1,"Überhöhte Km/h");
									}
								    ForEachPlayer(i)
									{
										if(IsPlayerConnected(i) && GetPVarInt(i,"Eingeloggt") == 1)
										{
											if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,11))
											{
												if(Spieler[i][pDuty] != 0)
												{
													if(Spieler[i][pFunkgeraet] == 1 || (IsAFraktionsVeh(i) != -1 && Fahrzeug[IsAFraktionsVeh(i)][Fraktion] == Spieler[i][pFraktion]) || FraktionsAktenPCs(i))
													{
														format(string,sizeof(string),"HQ: Blitzer %i : %s (ID:%i) wurde wegen einer überhöhter Geschwindigkeit (%i/%i Km/h) geblitzt.",blitzerid,SpielerName(playerid),playerid,GetVehicleSpeed(GetPlayerVehicleID(playerid)),Blitzer[blitzerid][BlitzerGeschwindigkeit]);
														SCM(i,0x00489184,string);
													}
											 	}
											}
										}
									}
								}
								else SCM(playerid,SAMP_WEISS,""IINFO" da du im Admindienst bist kannst du nicht geblitzt werden.");
							}
							else
							{
							    Spieler[playerid][pBlitzerTime] = gettime() + 15;
           						PlayerPlaySound(playerid,1132,0.0,0.0,0.0);
							    format(string,sizeof(string),""IINFO" du wurdest wegen einer überhöhten Geschwindigkeit (%i/%i Km/h | Toleranz: %i Km/h) geblitzt.",GetVehicleSpeed(GetPlayerVehicleID(playerid)),Blitzer[blitzerid][BlitzerGeschwindigkeit],fsteuern[BlitzerToleranz]);
							    SCM(playerid,SAMP_WEISS,string);
							    SCM(playerid,SAMP_WEISS,""IINFO" da du in einem Rennfahrzeug sitzt, konnten dir keine Wantedpunkte gegeben werden.");
                                SCM(playerid,SAMP_WEISS,"Achtung! Die Polizei wurde informiert!");
								ForEachPlayer(i)
								{
									if(IsPlayerConnected(i) && GetPVarInt(i,"Eingeloggt") == 1)
									{
									    if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,11))
										{
											if(Spieler[i][pDuty] != 0)
											{
											    format(string,sizeof(string),"Fahndung: Fall bearbeitet vom Blitzer %i || Illegalles Straßenrennen an Blitzer %i gesichtet",blitzerid,blitzerid);
												SCM(playerid,SAMP_WEISS,string);
											}
										}
									}
								}
							}
						}
					}
			    }
		    }
	    }
	}
	return 1;
}
stock UpdateAntiCheat(playerid)
{
    new
	string[500],
	KEY:keys,ud,lr,
	Float:Pos[3],
    Float:antihp,
    Float:antiarm,
    weaponid = GetPlayerWeapon(playerid),
    weaponammo = GetPlayerAmmo(playerid),
	slot = Script_GetWeaponSlot(weaponid),
	vehicleid = GetPlayerVehicleID(playerid);
    GetPlayerHealth(playerid,antihp);
	GetPlayerArmour(playerid,antiarm);
	GetPlayerKeys(playerid,keys,ud,lr);
	if(IsPlayerInAnyVehicle(playerid))
	{
		if(gettime() > Spieler[playerid][pAntiVehicleEnter] && Spieler[playerid][pAntiVehicleEnter] != 0 && !IsPlayerInVehicle(playerid,Spieler[playerid][pAntiVehicleEnterVehicleID]) && Spieler[playerid][pCuffed] == 0 && Spieler[playerid][pTazerd] == 0)
		{
	    	format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: Anti-Vehicle-Troll",Spieler[playerid][pName],playerid);
			SendClientMessageToAll(SAMP_WEISS,string);
			BanUser(playerid,"System","Anti-Vehicle-Troll");
	  	}
  	}
	if(antiarm > 100.0 && GetPlayerState(playerid) == PLAYER_STATE_SPAWNED)
	{
		format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: Armourhack",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(SAMP_WEISS,string);
		BanUser(playerid,"System","Armourhack");
	}

    if((ud != 128 && ud != 0 && ud != -128) || (lr != 128 && lr != 0 && lr != -128))
    {
		if(isPlayerAnAdmin(playerid,6))return 1;
		format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gekickt. Grund: Joypad",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(SAMP_WEISS,string);
		format(string,sizeof(string),"Admin: System User: %s * Grund: Joypad",Spieler[playerid][pName]);
		Log("Kickedsqllog",string);
		KickUser(playerid,"System","Joypad");
	}
    if(slot != -1 && gettime() > Spieler[playerid][pAcPause][AC_WEAPONPAUSE])
    {
	    new antiweapammo = Spieler[playerid][pAnticheatWeapAmmo][slot],antiweap = Spieler[playerid][pAnticheatWeap][slot];
		if((weaponid != 0 && weaponid != 46 || weaponid != 46 && weaponid != 0) && PlayerSpawned[playerid] == 1)
		{
			if(antiweap != weaponid && weaponammo > 0)
			{
				format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: Waffenhack",Spieler[playerid][pName],playerid);
				SendClientMessageToAll(SAMP_WEISS,string);
				ResetWeapons(playerid,true);
				BanUser(playerid,"System","Waffenhack");
			}
			if(antiweapammo > weaponammo && antiweapammo > 0 && weaponammo > 0)
			{
				Spieler[playerid][pAnticheatWeapAmmo][slot] = weaponammo;
			}
		}
	}
	if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK)
	{
		if(isPlayerAnAdmin(playerid,6))return 1;
		format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: Jetpack",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(SAMP_WEISS,string);
		BanUser(playerid,"System","Jetpack");
	}
	new anim = GetPlayerAnimationIndex(playerid);
	GetVehiclePos(vehicleid,Pos[0],Pos[1],Pos[2]);
	if(Pos[2] > 12.0 && (anim == 1543 || anim == 1538 || anim == 1539))
	{
		format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: Flyhack",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(SAMP_WEISS,string);
		BanUser(playerid,"System","Flyhack");
	}
	if(GetPlayerPing(playerid) >= MAX_PINGPERPLAYER && PlayerSpawned[playerid] == 1 && GetPlayerPing(playerid) != 65535)
	{
		format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gekickt. Grund: Zu hoher Ping(%ims<%ims)",Spieler[playerid][pName],playerid,MAX_PINGPERPLAYER,GetPlayerPing(playerid));
		SendClientMessageToAll(SAMP_WEISS,string);
		KickUser(playerid,"System","Zu hoher Ping");
	}

	if(GetPlayerScore(playerid) != GetPlayerLevel(playerid) && Spieler[playerid][pMaske] == 0 && Spieler[playerid][pDuty] != 4)
	{
		SetPlayerScore(playerid,GetPlayerLevel(playerid));
	}

	if(IsPlayerInAnyVehicle(playerid))
	{
	GetVehiclePos(vehicleid,Pos[0],Pos[1],Pos[2]);
	if(Motor[GetPlayerVehicleID(playerid)] == false)
	{
		if(GetVehicleSpeed(vehicleid) > MAX_SPEED_PERVEHICLE)
		{
			if(gettime() > Spieler[playerid][pAntiWarning])
			{
			    if(AC_SPEEDHACK == 1)
			    {
					Spieler[playerid][pAntiWarning] = gettime() + 10;
					format(string,sizeof(string),""IINFO" Spieler %s wurde gebannt. Grund: Speedhack",Spieler[playerid][pName]);
					SendClientMessageToAll(SAMP_WEISS,string);
					BanUser(playerid,"System","Speedhack");
				}else{
					format(AC_INFO,sizeof(AC_INFO),""#HTML_ROT"»"#HTML_WEISS" AC:Speedhack "#HTML_ROT"(OFFLINE)"#HTML_WEISS": Spieler %s ist im verdacht einen Speedhack Cheat zu benutzen!",Spieler[playerid][pName]);
 					SendAdminMessage(SAMP_WEISS,AC_INFO);
				}
			}
		}
	}
	else
	{
		if(GetVehicleSpeed(vehicleid) > MAX_SPEED_PERVEHICLE-150)
		{
			if(gettime() > Spieler[playerid][pAntiWarning])
			{
			    if(AC_SPEEDHACK == 1)
			    {
					Spieler[playerid][pAntiWarning] = gettime() + 10;
					format(string,sizeof(string),""IINFO" Spieler %s wurde gebannt. Grund: Speedhack",Spieler[playerid][pName]);
					SendClientMessageToAll(SAMP_WEISS,string);
					BanUser(playerid,"System","Speedhack");
				}else{
					format(AC_INFO,sizeof(AC_INFO),""#HTML_ROT"»"#HTML_WEISS" AC:Speedhack "#HTML_ROT"(OFFLINE)"#HTML_WEISS": Spieler %s ist im verdacht einen Speedhack Cheat zu benutzen!",Spieler[playerid][pName]);
				    SendAdminMessage(SAMP_WEISS,AC_INFO);
				}
			}
		}
	}
	GetVehiclePos(vehicleid,Spieler[playerid][CurrentPos][0],Spieler[playerid][CurrentPos][1],Spieler[playerid][CurrentPos][2]);
	}
	else
	{
		GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
		if(gettime() > Spieler[playerid][pAntiWarning])
		{
			if(GetPlayerWeapon(playerid) != WEAPON_PARACHUTE)//Der Zweig unterscheidet mit/ohne Fallschirm. Stand frueher auf 44 (Nachtsichtgeraet), damit war der 105er-Zweig unerreichbar.
			{
                if(!isPlayerAnAdmin(playerid,5))
				if(GetPlayerSpeed(playerid) > 170 && Pos[2] > 10 && GetPlayerSurfingVehicleID(playerid) == INVALID_VEHICLE_ID)//ohne fallschirm 170 Km/h
				{
					Spieler[playerid][pAntiWarning] = gettime() + 10;
					format(string,sizeof(string),"%s [ID: %i] steht unter Airbreak Verdacht (%iKm/h > %iKm/h).",SpielerName(playerid),playerid,GetPlayerSpeed(playerid),MAX_SPEED_PERPLAYER);
					SendAdminMessage(SAMP_WEISS,string);
					AC_Melden(playerid,"Airbreak (ohne Fallschirm)",string,false);
				}
			}
			else
			{
                if(!isPlayerAnAdmin(playerid,5))
				if(GetPlayerSpeed(playerid) > 105 && GetPlayerSurfingVehicleID(playerid) == INVALID_VEHICLE_ID)//mit fallschirm 105 Km/h
				{
					Spieler[playerid][pAntiWarning] = gettime() + 10;
					format(string,sizeof(string),"%s [ID: %i] steht unter Airbreak Verdacht (%iKm/h > %iKm/h).",SpielerName(playerid),playerid,GetPlayerSpeed(playerid),MAX_SPEED_PERPLAYER);
					SendAdminMessage(SAMP_WEISS,string);
					AC_Melden(playerid,"Airbreak (mit Fallschirm)",string,false);
				}
			}
		}
		GetPlayerPos(playerid,Spieler[playerid][CurrentPos][0],Spieler[playerid][CurrentPos][1],Spieler[playerid][CurrentPos][2]);
	}
	return 1;
}
