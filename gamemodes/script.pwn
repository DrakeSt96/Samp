						{
							Pfahrzeug[slot][i][Paintjob] = -1;
							ChangeVehiclePaintjob(Pfahrzeug[slot][i][Vehicle],Pfahrzeug[slot][i][Paintjob]);
							return 1;
						}
					}
				}
				for(new fv;fv<MAX_FVEHS;fv++)
				{
					if(Fahrzeug[fv][Fraktion] != 0 && Fahrzeug[fv][Vehicle] == GetPlayerVehicleID(playerid))
				   	{
