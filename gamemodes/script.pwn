	if(strcmp(cmd,"Race",true) == 0)
   	{
	   	if(Spieler[playerid][pAngebot] != 14)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir eine Einladung zu einem Rennen an.");
		pID = Spieler[playerid][pSeller];
		new Float:Pos[3];
		if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
		if(!ProxDetectorS(10.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
        new r = RaceStarted;
		if(r == -1)return SCM(playerid,SAMP_WEISS,"Es findet kein Rennen statt.");
		format(string,sizeof(string),""IINFO" du hast die Einladung von %s (ID:%i) zu einem Rennen angenommen.",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s hat deine von dir aus gestellte Einladung zu einem Rennen angenommen.",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		SCM(playerid,SAMP_WEISS,"{FF0000}[RACE-INFO]: {FFFFFF}Rennbefehle: /lastcp | /flip");
		Spieler[playerid][pSeller] = -1;
		Spieler[playerid][pAngebot] = 0;
		GetPlayerPos(playerid, Pos[0],Pos[1],Pos[2]);
		RaceFahrzeug[playerid] = AddStaticVehicleEx(RaceCarType, Pos[0],Pos[1],Pos[2], 15.0, -1, -1, -1);
		SetVehicleNumberPlate(RaceFahrzeug[playerid],""#HTML_BLAU"["#SERVERTAG"]");
 		SetVehicleVirtualWorld(RaceFahrzeug[playerid],GetPlayerVirtualWorld(playerid));
  		LinkVehicleToInterior(RaceFahrzeug[playerid],GetPlayerInterior(playerid));
  		PutPlayerInVehicleEx(playerid, RaceFahrzeug[playerid], 0);
		vFahrzeug[RaceFahrzeug[playerid]][Tank] = VehicleInfo[GetVehicleModel(RaceFahrzeug[playerid])-400][vtankvolumen];
		MotorDown[GetPlayerVehicleID(playerid)] = 0;
    	vFahrzeug[GetPlayerVehicleID(playerid)][FailGas] = 0;
		if(RaceMode[r] == 0 || RaceMode[r] == 2 || RaceMode[r] == 3)
		{
			SetPlayerRaceCheckpoint(playerid,CP_TYPE_GROUND_NORMAL,RaceInfo[r][0][0],RaceInfo[r][0][1],RaceInfo[r][0][2],RaceInfo[r][1][0],RaceInfo[r][1][1],RaceInfo[r][1][2],RACE_CP_SIZE[r][0]);
		}
		else if(RaceMode[r] == 1)
		{
			SetPlayerRaceCheckpoint(playerid,CP_TYPE_AIR_NORMAL,RaceInfo[r][0][0],RaceInfo[r][0][1],RaceInfo[r][0][2],RaceInfo[r][1][0],RaceInfo[r][1][1],RaceInfo[r][1][2],RACE_CP_SIZE[r][0]);
		}
		InviteInRace[playerid] = 1;
		RaceCps[playerid] = 0;
		fverwaltungen[17][Geld] += RaceGebuehr;
		ACMoney(playerid,-RaceGebuehr);
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(InviteInRace[i] == 1)
				{
					format(string,sizeof(string),"%s ist dem Rennen beigetreten.",SpielerName(playerid));
					SCM(i,SAMP_WEISS,string);
				}
			}
		}
		return 1;
	}
	if(strcmp(cmd,"Freebl",true) == 0)
