	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],onlinemakler = 0;
    SCM(playerid,SAMP_WEISS,"||___________Immobilienmakler Online___________||");
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(isPlayerInJob(i,18))
				{
					if(Spieler[i][pHandy] == 0)
					{
						format(string,sizeof(string),"%s (ID:%i)",SpielerName(i),i);
						SCM(playerid,SAMP_WEISS,string);
					}
					else
					{
						format(string,sizeof(string),"%s (ID:%i) | Handy: %i",SpielerName(i),i,Spieler[i][pPhonenumber]);
						SCM(playerid,SAMP_WEISS,string);
					}
					onlinemakler++;
				}
			}
		}
	}
	if(onlinemakler == 0)return SCM(playerid,SAMP_WEISS,""IINFO" derzeit ist kein Immobilienmakler/in verfügbar.");
	return 1;
}
COMMAND:fillveh(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],vehicleid = GetPlayerVehicleID(playerid);
	if(Spieler[playerid][pTankFillBoxes] == 0)return SCM(playerid,SAMP_WEISS,"Kein Benzinkanister im Inventar.");
	if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(RepairAVehicle[vehicleid] == 1)return SCM(playerid,SAMP_WEISS,"Dein Fahrzeug wird gerade repariert!");
	if(RefillVehicle[vehicleid] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du tankst gerade!");
	if(Motor[vehicleid] == true)return SCM(playerid,SAMP_WEISS,""IINFO" der Motor muss aus sein,bevor du das Fahrzeug betankst.");
    if((vFahrzeug[vehicleid][Tank] + ((VehicleInfo[GetVehicleModel(GetPlayerVehicleID(playerid))-400][vtankvolumen])/50)) > VehicleInfo[GetVehicleModel(vehicleid)-400][vtankvolumen])return SCM(playerid,SAMP_WEISS,""IINFO" der Tank des Fahrzeuges ist bereits voll.");
	vFahrzeug[vehicleid][Tank] += ((VehicleInfo[GetVehicleModel(GetPlayerVehicleID(playerid))-400][vtankvolumen])/50);
	Spieler[playerid][pTankFillBoxes]--;
    format(string,sizeof(string),"** %s betankt ein Fahrzeug [%s] **",SpielerName(playerid),VehicleDefinations[GetVehicleModel(vehicleid)-400]);
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	return 1;
}
COMMAND:repairveh(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	new string[128],vehicleid = GetPlayerVehicleID(playerid);
	if(Spieler[playerid][pRepairVehBoxes] == 0)return SCM(playerid,SAMP_WEISS,"Kein Werkzeugkasten im Inventar.");
 	if(RepairAVehicle[vehicleid] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug wird gerade repariert!");
	if(RefillVehicle[vehicleid] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du tankst gerade!");
	if(Motor[vehicleid] == true)return SCM(playerid,SAMP_WEISS,""IINFO" der Motor muss aus sein,bevor du das Fahrzeug reparierst.");
	MotorDown[vehicleid] = 0;
	Spieler[playerid][pRepairVehBoxes]--;
	RepairAVehicle[vehicleid] = 0;
	RepairVehicle(vehicleid);
	format(string,sizeof(string),"** %s repariert ein Fahrzeug [%s] **",SpielerName(playerid),VehicleDefinations[GetVehicleModel(vehicleid)-400]);
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe eine Fahrzeuges.");
}
COMMAND:mlock(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:Pos[3],cmd[15],string[64];
    if(sscanf(params,"s[15]",cmd))return SCM(playerid,SAMP_WEISS,"/lock [RentVeh/FraktionsVeh/AdminVeh]");
	if(strcmp(cmd,"RentVeh",true) == 0)
	{
	    if(Spieler[playerid][pRentAVeh][1] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast dir kein Fahrzeug bei einem Fahrzeugverleih gemietet.");
		GetVehiclePos(RentVeh[playerid][1],Pos[0],Pos[1],Pos[2]);
		GetVehicleParamsEx(RentVeh[playerid][1],engine,lights,alarm,doors,bonnet,boot,objective);
		if(IsPlayerInRangeOfPoint(playerid,3.0,Pos[0],Pos[1],Pos[2]))
		{
			if(lockedveh[RentVeh[playerid][1]] == false)
			{
			    SetVehicleParamsEx(RentVeh[playerid][1],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
			    lockedveh[RentVeh[playerid][1]] = true;
			    GameTextForPlayer(playerid,"~w~Mietfahrzeug ~r~abgeschlossen",2000,6);
			    PlayerHearMusicInRange(Pos[0],Pos[1],Pos[2],1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
			}
			else if(lockedveh[RentVeh[playerid][1]] == true)
			{
			    SetVehicleParamsEx(RentVeh[playerid][1],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
			    lockedveh[RentVeh[playerid][1]] = false;
			    GameTextForPlayer(playerid,"~w~Mietfahrzeug ~g~aufgeschlossen",2000,6);
				PlayerHearMusicInRange(Pos[0],Pos[1],Pos[2],1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe deines gemieteten Fahrzeuges.");
	}
	if(strcmp(cmd,"FraktionsVeh",true) == 0)
	{
		if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	    for(new fv;fv<MAX_FVEHS;fv++)
		{
			if(IsValidVehicle(Fahrzeug[fv][Vehicle]))
			{
			   	GetVehiclePos(Fahrzeug[fv][Vehicle],Pos[0],Pos[1],Pos[2]);
				GetVehicleParamsEx(Fahrzeug[fv][Vehicle],engine,lights,alarm,doors,bonnet,boot,objective);
				if(IsPlayerInRangeOfPoint(playerid,3.0,Pos[0],Pos[1],Pos[2]))
				{
					if(Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion] && isPlayerAMember(playerid,Fahrzeug[fv][FraktionsRang]))
					{
						if(Fahrzeug[fv][Abgeschlossen] == 0)
						{
						    SetVehicleParamsEx(Fahrzeug[fv][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
						    Fahrzeug[fv][Abgeschlossen] = 1;
						    format(string,sizeof(string),"~w~%s~n~~r~abgeschlossen",VehicleDefinations[Fahrzeug[fv][modelid]-400]);
						    GameTextForPlayer(playerid,string,2000,6);
						    PlayerHearMusicInRange(Pos[0],Pos[1],Pos[2],1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
							return 1;
						}
						else if(Fahrzeug[fv][Abgeschlossen] == 1)
						{
						    SetVehicleParamsEx(Fahrzeug[fv][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
						    Fahrzeug[fv][Abgeschlossen] = 0;
							format(string,sizeof(string),"~w~%s~n~~g~aufgeschlossen",VehicleDefinations[Fahrzeug[fv][modelid]-400]);
						    GameTextForPlayer(playerid,string,2000,6);
						    PlayerHearMusicInRange(Pos[0],Pos[1],Pos[2],1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
						    return 1;
						}
					}
					return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
				}
			}
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Fraktionsfahrzeuges.");
	}
	if(strcmp(cmd,"AdminVeh",true) == 0)
	{
		if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
		for(new a=0;a<MAX_ADMINVEHS;a++)
		{
			GetVehiclePos(adminmobile[a],Pos[0],Pos[1],Pos[2]);
			GetVehicleParamsEx(adminmobile[a],engine,lights,alarm,doors,bonnet,boot,objective);
			if(IsPlayerInRangeOfPoint(playerid,3.0,Pos[0],Pos[1],Pos[2]))
			{
				if(lockedveh[adminmobile[a]] == false)
				{
				    SetVehicleParamsEx(adminmobile[a],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
				    lockedveh[adminmobile[a]] = true;
				    GameTextForPlayer(playerid,"~w~Adminmobil~n~~r~abgeschlossen",2000,6);
				    PlayerHearMusicInRange(Pos[0],Pos[1],Pos[2],1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
				}
				else if(lockedveh[adminmobile[a]] == true)
				{
				    SetVehicleParamsEx(adminmobile[a],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
				    lockedveh[adminmobile[a]] = false;
				    GameTextForPlayer(playerid,"~w~Adminmobil~n~~g~aufgeschlossen",2000,6);
				    PlayerHearMusicInRange(Pos[0],Pos[1],Pos[2],1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
				}
				return 1;
			}
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Adminfahrzeuges.");
	}
	return SCM(playerid,SAMP_WEISS,"/lock [RentVeh/FraktionsVeh/AdminVeh]");
}
COMMAND:alock(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:x,Float:y,Float:z;
    if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	for(new a=0;a<MAX_ADMINVEHS;a++)
	{
		GetVehiclePos(adminmobile[a],x,y,z);
		GetVehicleParamsEx(adminmobile[a],engine,lights,alarm,doors,bonnet,boot,objective);
		if(IsPlayerInRangeOfPoint(playerid,3.0,x,y,z))
		{
			if(lockedveh[adminmobile[a]] == false)
			{
			    SetVehicleParamsEx(adminmobile[a],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
			    lockedveh[adminmobile[a]] = true;
			    GameTextForPlayer(playerid,"~w~Adminmobil~n~~r~abgeschlossen",2000,6);
			    PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
			}
			else if(lockedveh[adminmobile[a]] == true)
			{
			    SetVehicleParamsEx(adminmobile[a],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
			    lockedveh[adminmobile[a]] = false;
			    GameTextForPlayer(playerid,"~w~Adminmobil~n~~g~aufgeschlossen",2000,6);
			    PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
			}
			return 1;
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Adminfahrzeuges.");
}
COMMAND:idrop_3(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[64],cmd[10];
	if(Paintball[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst das nicht in der Paintballarena!");
 	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in einem Fahrzeug!");
    if(sscanf(params,"s[10]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /idrop [Gun/Koffer]");
	if(strcmp(cmd,"Gun",true) == 0)
	{
		new f = MAX_WAFFENDROP+1,GunID = GetPlayerWeapon(playerid),GunAmmo = GetPlayerAmmo(playerid);
		if(IsWeaponEnable(GunID) == 1 && GunID != 0 || GunID == 9)
		{
			Script_RemovePlayerWeapon(playerid,GunID);
		 	return SCM(playerid,SAMP_WEISS,"ACHTUNG: Waffe wird vom System als unangemessen empfunden!");
	 	}
	   	if(GunID > 0 && GunAmmo != 0)
	   	{
		    for(new a = 0; a < MAX_WAFFENDROP; a++)
		    {
			    if(dGunData[a][ObjPos][0] == 0.0)
			    {
				    f = a;
				    break;
			    }
		    }
		   	Script_RemovePlayerWeapon(playerid,GunID);
			dGunData[f][ObjData][0] = GunID;
			dGunData[f][ObjData][1] = GunAmmo;
			GetPlayerPos(playerid,dGunData[f][ObjPos][0],dGunData[f][ObjPos][1],dGunData[f][ObjPos][2]);
			dGunData[f][ObjID] = CreateDynamicObject(GunObjects[GunID],dGunData[f][ObjPos][0],dGunData[f][ObjPos][1],dGunData[f][ObjPos][2]-1,93.7,120.0,120.0);
			format(string,sizeof(string),"** %s lässt etwas fallen **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			return 1;
	 	}
		return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Waffe in der Hand!");
	}
	if(strcmp(cmd,"Koffer",true) == 0)
	{
		if(Spieler[playerid][pKoffer] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst keinen Koffer mit dir.");
	    CreateDroppedKoffer(playerid);
	    format(string,sizeof(string),"** %s lässt etwas fallen **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /idrop [Gun/Koffer]");
}
COMMAND:ipickup_3(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[64],cmd[10];
	if(Paintball[playerid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst das nicht in der Paintballarena!");
 	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in einem Fahrzeug!");
    if(sscanf(params,"s[10]",cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /ipickup [Gun/Koffer]");
	if(strcmp(cmd,"Gun",true) == 0)
	{
		new f = MAX_WAFFENDROP+1;
	    if(GetPlayerLevel(playerid) < 3)return SCM(playerid,SAMP_WEISS,""IINFO" du brauchst mindenstens das Level 3.");
	 	for(new a = 0; a < MAX_WAFFENDROP; a++)
		{
			if(IsPlayerInRangeOfPoint(playerid,2.5,dGunData[a][ObjPos][0],dGunData[a][ObjPos][1],dGunData[a][ObjPos][2]))
			{
				f = a;
				break;
		 	}
		}
		if(f > MAX_WAFFENDROP)return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe einer Waffe!");
		DestroyDynamicObject(dGunData[f][ObjID]);
		GiveWeapon(playerid,dGunData[f][ObjData][0],dGunData[f][ObjData][1],true);
		dGunData[f][ObjPos][0] = 0.0;
		dGunData[f][ObjPos][1] = 0.0;
		dGunData[f][ObjPos][2] = 0.0;
		dGunData[f][ObjID] = -1;
		dGunData[f][ObjData][1] = 0;
		format(string,sizeof(string),"** %s hebt etwas auf **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	if(strcmp(cmd,"Koffer",true) == 0)
	{
		new koffer = ReturnKofferID(playerid);
		if(koffer == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Koffers.");
		if(Spieler[playerid][pKoffer] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst bereits einen Koffer mit dir.");
		if(KofferInfo[koffer][KBomb] == 1)
		{
			new randompos = random(20),randexploderadius = random(40)+10;
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),true);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			randexploderadius = random(30)+10;
			randompos = random(10);
			CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
			AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
			DestroyDynamicObject(KofferInfo[koffer][KObject]);
			DestroyDynamic3DTextLabel(KofferLabel[koffer]);
			KofferInfo[koffer][Kcreatet] = 0;
			KofferInfo[koffer][KPos][0] = 0.0;
			KofferInfo[koffer][KPos][1] = 0.0;
			KofferInfo[koffer][KPos][2] = 0.0;
			KofferInfo[koffer][KWorld] = 0;
		    KofferInfo[koffer][KOpium] = 0;
	     	KofferInfo[koffer][KSpice] = 0;
		    KofferInfo[koffer][KGanja] = 0;
		    KofferInfo[koffer][KKokain] = 0;
		    KofferInfo[koffer][KMaterials] = 0;
		    KofferInfo[koffer][KMaterialsPakets] = 0;
		    KofferInfo[koffer][KC4] = 0;
		    KofferInfo[koffer][KMoney] = 0;
		    KofferInfo[koffer][KZigarets] = 0;
		    KofferInfo[koffer][KKoeder] = 0;
		    KofferInfo[koffer][KLunch] = 0;
		    KofferInfo[koffer][KBomb] = 0;
			return 1;
		}
		SetPlayerAttachedObject(playerid,9,1210,5,0.310000,0.066999,0.000000,0.000000,-91.900009,0.000000,1.000000,1.000000,1.000000);
		Spieler[playerid][pKoffer] = 1;
	    Spieler[playerid][pKofferItems][0] = KofferInfo[koffer][KOpium];
	    Spieler[playerid][pKofferItems][1] = KofferInfo[koffer][KGanja];
	    Spieler[playerid][pKofferItems][2] = KofferInfo[koffer][KKokain];
	    Spieler[playerid][pKofferItems][3] = KofferInfo[koffer][KMaterials];
	    Spieler[playerid][pKofferItems][4] = KofferInfo[koffer][KMaterialsPakets];
	    Spieler[playerid][pKofferItems][5] = KofferInfo[koffer][KC4];
	    Spieler[playerid][pKofferItems][6] = KofferInfo[koffer][KMoney];
	    Spieler[playerid][pKofferItems][7] = KofferInfo[koffer][KZigarets];
	    Spieler[playerid][pKofferItems][8] = KofferInfo[koffer][KKoeder];
	    Spieler[playerid][pKofferItems][9] = KofferInfo[koffer][KLunch];
	    Spieler[playerid][pKofferItems][10] = KofferInfo[koffer][KSpice];
	    DestroyDynamicObject(KofferInfo[koffer][KObject]);
		DestroyDynamic3DTextLabel(KofferLabel[koffer]);
		KofferInfo[koffer][Kcreatet] = 0;
		KofferInfo[koffer][KPos][0] = 0.0;
		KofferInfo[koffer][KPos][1] = 0.0;
		KofferInfo[koffer][KPos][2] = 0.0;
		KofferInfo[koffer][KWorld] = 0;
	    KofferInfo[koffer][KOpium] = 0;
	    KofferInfo[koffer][KSpice] = 0;
	    KofferInfo[koffer][KGanja] = 0;
	    KofferInfo[koffer][KKokain] = 0;
	    KofferInfo[koffer][KMaterials] = 0;
	    KofferInfo[koffer][KMaterialsPakets] = 0;
	    KofferInfo[koffer][KC4] = 0;
	    KofferInfo[koffer][KMoney] = 0;
	    KofferInfo[koffer][KZigarets] = 0;
	    KofferInfo[koffer][KKoeder] = 0;
	    KofferInfo[koffer][KLunch] = 0;
	    KofferInfo[koffer][KBomb] = 0;
	    format(string,sizeof(string),"** %s hebt etwas auf **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /ipickup [Gun/Koffer]");
}
COMMAND:ownkofferinfo(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[128];
    if(Spieler[playerid][pKoffer] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Koffer.");
    format(string,sizeof(string),"Ganja: %dg\nKokain: %dg\nMaterials: %d\nMatsPakete: %d\nOpium: %dg\nLunchpakete: %d\nC4: %dKg\nKöder: %d\nGeld: %d$\nZigaretten: %d\nSpice: %dg",
	Spieler[playerid][pKofferItems][1],Spieler[playerid][pKofferItems][2],Spieler[playerid][pKofferItems][3],Spieler[playerid][pKofferItems][4],Spieler[playerid][pKofferItems][0],
	Spieler[playerid][pKofferItems][9],Spieler[playerid][pKofferItems][5],Spieler[playerid][pKofferItems][8],Spieler[playerid][pKofferItems][6],Spieler[playerid][pKofferItems][7],Spieler[playerid][pKofferItems][10]);
    ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"Koffer",string,"Verlassen","");
	return 1;
}
COMMAND:kofferinfo(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new koffer = ReturnKofferID(playerid),string[128];
	if(koffer == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Koffers.");
    if(KofferInfo[koffer][KBomb] == 1)
	{
		new randompos = random(20),randexploderadius = random(40)+10;
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),true);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		randexploderadius = random(30)+10;
		randompos = random(10);
		CreateExplosion(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,7,randexploderadius);
		AddFire(KofferInfo[koffer][KPos][0]+randompos,KofferInfo[koffer][KPos][1]+randompos,KofferInfo[koffer][KPos][2]+randompos,GetPlayerVirtualWorld(playerid),false);
		DestroyDynamicObject(KofferInfo[koffer][KObject]);
		DestroyDynamic3DTextLabel(KofferLabel[koffer]);
		KofferInfo[koffer][Kcreatet] = 0;
		KofferInfo[koffer][KPos][0] = 0.0;
		KofferInfo[koffer][KPos][1] = 0.0;
		KofferInfo[koffer][KPos][2] = 0.0;
		KofferInfo[koffer][KWorld] = 0;
	    KofferInfo[koffer][KOpium] = 0;
	    KofferInfo[koffer][KSpice] = 0;
	    KofferInfo[koffer][KGanja] = 0;
	    KofferInfo[koffer][KKokain] = 0;
	    KofferInfo[koffer][KMaterials] = 0;
	    KofferInfo[koffer][KMaterialsPakets] = 0;
	    KofferInfo[koffer][KC4] = 0;
	    KofferInfo[koffer][KMoney] = 0;
	    KofferInfo[koffer][KZigarets] = 0;
	    KofferInfo[koffer][KKoeder] = 0;
	    KofferInfo[koffer][KLunch] = 0;
	    KofferInfo[koffer][KBomb] = 0;
		return 1;
	}
	format(string,sizeof(string),"Ganja: %dg\nKokain: %dg\nMaterials: %d\nMatsPakete: %d\nOpium: %dg\nLunchpakete: %d\nC4: %dKg\nKöder: %d\nGeld: %d$\nZigaretten: %d\nSpice: %d",
	KofferInfo[koffer][KGanja],KofferInfo[koffer][KKokain],KofferInfo[koffer][KMaterials],KofferInfo[koffer][KMaterialsPakets],KofferInfo[koffer][KOpium],
	KofferInfo[koffer][KLunch],KofferInfo[koffer][KC4],KofferInfo[koffer][KKoeder],KofferInfo[koffer][KMoney],KofferInfo[koffer][KZigarets],KofferInfo[koffer][KSpice]);
    ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"Koffer",string,"Verlassen","");
	return 1;
}

COMMAND:koffer(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new cmd[30],ccommand[15],Menge,string[128];
    if(Spieler[playerid][pKoffer] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Koffer.");
	if(sscanf(params,"s[15]s[30]i",ccommand,cmd,Menge))return SCM(playerid,SAMP_WEISS,""IINFO" /koffer [reinlegen/rausnehmen][Ganja/Kokain/Materials/MatsPakete/Opium/Spice/Lunchpakete/C4/Köder/Geld/Zigaretten][Menge]");
	if(Menge <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" /koffer [reinlegen/rausnehmen][Ganja/Kokain/Materials/MatsPakete/Opium/Lunchpakete/C4/Köder/Geld/Zigaretten][Menge]");
	if(strcmp(ccommand,"Reinlegen",true) == 0)
	{
		if(strcmp(cmd,"Ganja",true) == 0)
		{
			if((Spieler[playerid][pGanja] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Ganja.");
			if((GetPlayerKofferWeight(playerid) + Menge) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
		   	Spieler[playerid][pGanja] -= Menge;
		    Spieler[playerid][pKofferItems][1] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %ig Ganja in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Spice",true) == 0)
		{
			if((Spieler[playerid][pSpice] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Spice.");
			if((GetPlayerKofferWeight(playerid) + Menge) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
		   	Spieler[playerid][pSpice] -= Menge;
		    Spieler[playerid][pKofferItems][10] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %ig Spice in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Kokain",true) == 0)
		{
			if((Spieler[playerid][pKokain] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Kokain.");
			if((GetPlayerKofferWeight(playerid) + Menge) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
		   	Spieler[playerid][pKokain] -= Menge;
			Spieler[playerid][pKofferItems][2] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %ig Kokain in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Materials",true) == 0)
		{
			if((Spieler[playerid][pMaterials] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Materials.");
			if((GetPlayerKofferWeight(playerid) + Menge) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
			Spieler[playerid][pMaterials] -= Menge;
		    Spieler[playerid][pKofferItems][3] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %i Materials in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"MatsPakete",true) == 0)
		{
			if((Spieler[playerid][MatsPackete] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Matspakete.");
			if((GetPlayerKofferWeight(playerid) + Menge) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
		 	Spieler[playerid][MatsPackete] -= Menge;
		    Spieler[playerid][pKofferItems][4] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %i Matspakete in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Opium",true) == 0)
		{
			if((Spieler[playerid][pOpium] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Opium.");
			if((GetPlayerKofferWeight(playerid) + Menge) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
			Spieler[playerid][pOpium] -= Menge;
			Spieler[playerid][pKofferItems][0] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %ig Opium in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Lunchpakete",true) == 0)
		{
			if((Spieler[playerid][pLunchpaket] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Lunchpakete.");
			if((GetPlayerKofferWeight(playerid) + (Menge*500)) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
			Spieler[playerid][pLunchpaket] -= Menge;
		    Spieler[playerid][pKofferItems][9] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %i Lunchpakete in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"C4",true) == 0)
		{
			if((Spieler[playerid][pC4] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug C4.");
			if((GetPlayerKofferWeight(playerid) + (Menge*1000)) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
			Spieler[playerid][pC4] -= Menge;
		    Spieler[playerid][pKofferItems][5] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %iKg C4 in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Köder",true) == 0)
		{
			if((Spieler[playerid][pAngelKoeder] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Angelköder.");
			if((GetPlayerKofferWeight(playerid) + Menge) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
			Spieler[playerid][pAngelKoeder] -= Menge;
			Spieler[playerid][pKofferItems][8] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %i Angelköder in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Geld",true) == 0)
		{
			if((GetACMoney(playerid) - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld.");
			ACMoney(playerid,-Menge);
			Spieler[playerid][pKofferItems][6] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %i$ in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Zigaretten",true) == 0)
		{
			if((Spieler[playerid][pZigarets] - Menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Zigaretten.");
			if((GetPlayerKofferWeight(playerid) + Menge) > 25000)return SCM(playerid,SAMP_WEISS,"So viel passt nicht in den Koffer.(maximal Füllgewicht 25Kg)");
		    Spieler[playerid][pZigarets] -= Menge;
			Spieler[playerid][pKofferItems][7] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %i Zigaretten in deinen Koffer gelegt. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" /koffer [reinlegen][Ganja/Kokain/Materials/MatsPakete/Opium/Spice/Lunchpakete/C4/Köder/Geld/Zigaretten][Menge]");
	}
	if(strcmp(ccommand,"Rausnehmen",true) == 0)
	{
		if(strcmp(cmd,"Ganja",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][1] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Ganja im Koffer.");
		    if((Spieler[playerid][pGanja] + Menge) > 2500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
		 	Spieler[playerid][pKofferItems][1] -= Menge;
			Spieler[playerid][pGanja] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %dg Ganja aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Spice",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][10] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Spice im Koffer.");
		    if((Spieler[playerid][pSpice] + Menge) > 2500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
		 	Spieler[playerid][pKofferItems][10] -= Menge;
			Spieler[playerid][pSpice] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %dg Spice aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Kokain",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][2] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Kokain im Koffer.");
		    if((Spieler[playerid][pKokain] + Menge) > 2500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
			Spieler[playerid][pKofferItems][2] -= Menge;
			Spieler[playerid][pKokain] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %dg Kokain aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Materials",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][3] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Materials im Koffer.");
		    if((Spieler[playerid][pMaterials] + Menge) > 10000)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
			Spieler[playerid][pKofferItems][3] -= Menge;
			Spieler[playerid][pMaterials] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %d Materials aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"MatsPakete",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][4] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Matspakete im Koffer.");
		    if((Spieler[playerid][MatsPackete] + Menge) > 10)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
			Spieler[playerid][pKofferItems][4] -= Menge;
			Spieler[playerid][MatsPackete] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %d Matspakete aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Opium",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][0] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Opium im Koffer.");
		    if((Spieler[playerid][pOpium] + Menge) > 500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
			Spieler[playerid][pKofferItems][0] -= Menge;
			Spieler[playerid][pOpium] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %dg Opium aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Lunchpakete",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][9] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Lunchpakete im Koffer.");
		    if((Spieler[playerid][pLunchpaket] + Menge) > 30)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
			Spieler[playerid][pKofferItems][9] -= Menge;
			Spieler[playerid][pLunchpaket] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %d Lunchpakete aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"C4",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][5] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug C4 im Koffer.");
		    if((Spieler[playerid][pC4] + Menge) > 10)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
			Spieler[playerid][pKofferItems][5] -= Menge;
			Spieler[playerid][pC4] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %dKg C4 aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Köder",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][8] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Angelköder im Koffer.");
		    if((Spieler[playerid][pAngelKoeder] + Menge) > 200)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
			Spieler[playerid][pKofferItems][8] -= Menge;
			Spieler[playerid][pAngelKoeder] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %d Angelköder aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Geld",true) == 0)
		{
		    if((Spieler[playerid][pKofferItems][6] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Geld im Koffer.");
		    Spieler[playerid][pKofferItems][6] -= Menge;
			ACMoney(playerid,Menge);
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %d$ aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		if(strcmp(cmd,"Zigaretten",true) == 0)
		{
			if((Spieler[playerid][pKofferItems][7] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Zigaretten im Koffer.");
		    if((Spieler[playerid][pZigarets] + Menge) > 100)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
			Spieler[playerid][pKofferItems][7] -= Menge;
			Spieler[playerid][pZigarets] += Menge;
			new Float:weight = GetPlayerKofferWeight(playerid)/1000;
			format(string,sizeof(string),""IINFO" du hast %d Zigaretten aus dem Koffer genommen. Gesamtgewicht: %.1f/25Kg",Menge,weight);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" /koffer [rausnehmen][Ganja/Kokain/Materials/MatsPakete/Opium/Spice/Lunchpakete/C4/Köder/Geld/Zigaretten][Menge]");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /koffer [reinlegen/rausnehmen][Ganja/Kokain/Materials/MatsPakete/Spice/Opium/Lunchpakete/C4/Köder/Geld/Zigaretten][Menge]");
}

COMMAND:kofferrauminfo(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[256],Float:Cords[3];
    for(new i=0;i<MAX_VEHICLES;i++)
    {
	    if(IsValidVehicle(i))
	    {
			GetVehiclePos(i,Cords[0],Cords[1],Cords[2]);
			if(IsPlayerInRangeOfPoint(playerid,3.0,Cords[0],Cords[1],Cords[2]) && IsVehicleACar(i) && kofferraum[i] == true)
			{
			    format(string,sizeof(string),"Ganja:  %ig\nKokain:  %ig\nMaterials:  %i\nOpium Pillen:  %i\nLunchpakete:  %i\nC4:  %ikg\nWerkzeugkästen:  %i\nBenzinkanister:  %i\nSpice: %ig",
				vFahrzeug[i][KofferraumGanja],vFahrzeug[i][KofferraumKokain],vFahrzeug[i][KofferraumMaterials],vFahrzeug[i][KofferraumOpium],vFahrzeug[i][KofferraumLunchpakete],vFahrzeug[i][KofferraumC4],vFahrzeug[i][KofferraumWerkzeugkasten],vFahrzeug[i][KofferraumBenzinkanister],vFahrzeug[i][KofferraumSpice]);
			    ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,VehicleDefinations[GetVehicleModel(i)-400],string,"Verlassen","");
			    return 1;
		    }
		}
 	}
	return SCM(playerid,SAMP_WEISS,"Nicht in der Nähe eine Fahrzeuges oder der Kofferraum eines Fahrzeuges ist nicht geöffnet.");
}
COMMAND:kraum(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new cmd[30],ccommand[15],Menge,string[128],Float:Cords[3];
	for(new i=0;i<MAX_VEHICLES;i++)
    {
	    if(IsValidVehicle(i))
	    {
			GetVehiclePos(i,Cords[0],Cords[1],Cords[2]);
			if(IsPlayerInRangeOfPoint(playerid,5.0,Cords[0],Cords[1],Cords[2]) && IsVehicleACar(i) && kofferraum[i] == true)
			{
			 	if(sscanf(params,"s[15]s[30]i",ccommand,cmd,Menge))return SCM(playerid,SAMP_WEISS,""IINFO" /kraum [reinlegen/rausnehmen][Ganja/Kokain/Materials/Opium/Spice/Lunchpakete/C4/Werkzeugkästen/Benzinkanister][Menge]");
				if(Menge < 1)return SCM(playerid,SAMP_WEISS,""IINFO" /kraum [reinlegen/rausnehmen][Ganja/Kokain/Materials/Opium/Lunchpakete/C4/Werkzeugkästen/Benzinkanister][Menge]");
				if(strcmp(ccommand,"Reinlegen",true) == 0)
				{
					if(strcmp(cmd,"Ganja",true) == 0)
					{
						if((Spieler[playerid][pGanja] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Ganja.");
						if((GetVehicleBootVolumen(i) + Menge) > VehicleInfo[GetVehicleModel(i)-400][vkofferraumvolumen])return SCM(playerid,SAMP_WEISS,"Es passt nicht mehr in den Kofferraum.");
						Spieler[playerid][pGanja] -= Menge;
						vFahrzeug[i][KofferraumGanja] += Menge;
						format(string,sizeof(string),""IINFO" du hast %dg Ganja in das Fahrzeug gelegt! Fahrzeug(Ganja): %dg",Menge,vFahrzeug[i][KofferraumGanja]);
						SCM(playerid,SAMP_WEISS,string);
						format(string,sizeof(string),"** %s legt etwas in den Kofferraum **",SpielerName(playerid));
						PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
						return 1;
					}
					if(strcmp(cmd,"Spice",true) == 0)
					{
						if((Spieler[playerid][pSpice] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Spice.");
						if((GetVehicleBootVolumen(i) + Menge) > VehicleInfo[GetVehicleModel(i)-400][vkofferraumvolumen])return SCM(playerid,SAMP_WEISS,"Es passt nicht mehr in den Kofferraum.");
						Spieler[playerid][pSpice] -= Menge;
						vFahrzeug[i][KofferraumSpice] += Menge;
						format(string,sizeof(string),""IINFO" du hast %dg Spice in das Fahrzeug gelegt! Fahrzeug(Spice): %dg",Menge,vFahrzeug[i][KofferraumSpice]);
						SCM(playerid,SAMP_WEISS,string);
						format(string,sizeof(string),"** %s legt etwas in den Kofferraum **",SpielerName(playerid));
						PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
						return 1;
					}
					if(strcmp(cmd,"Kokain",true) == 0)
					{
					    if((Spieler[playerid][pKokain] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Kokain.");
					    if((GetVehicleBootVolumen(i) + Menge) > VehicleInfo[GetVehicleModel(i)-400][vkofferraumvolumen])return SCM(playerid,SAMP_WEISS,"Es passt nicht mehr in den Kofferraum.");
						Spieler[playerid][pKokain] -= Menge;
						vFahrzeug[i][KofferraumKokain] += Menge;
						format(string,sizeof(string),""IINFO" du hast %dg Kokain in das Fahrzeug gelegt! Fahrzeug(Kokain): %dg",Menge,vFahrzeug[i][KofferraumKokain]);
						SCM(playerid,SAMP_WEISS,string);
						format(string,sizeof(string),"** %s legt etwas in den Kofferraum **",SpielerName(playerid));
						PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
