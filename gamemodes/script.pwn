	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
	    if(GetFraktionSmarkCount(Spieler[playerid][pFraktion]) == 0)return SCM(playerid,SAMP_WEISS,"Eure Fraktion besitzt kein Schwarzmarkt./Eure Fraktion ist kein Psrtner eines Schwarzmarktes.");
	    if(sm == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in/an eurem Schwarzmarkt.");
	    if(!isPlayerInFrakt(playerid,SmarkInfo[sm][sfraktid]))return SCM(playerid,SAMP_WEISS,"Dieser Schwarzmarkt gehört nicht eurer Fraktion.");
		if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
	    if(SmarkInfo[sm][sbdfraktid] == 0)return SCM(playerid,SAMP_WEISS,"Ihr habt keinen Partner eingetragen.");
	    format(string,sizeof(string),"%s (ID:%i) hat die Partnerschaft mit der Fraktion %s für den Schwarzmarkt (ID:%i) beendet.",Spieler[playerid][pName],playerid,FraktionsName(SmarkInfo[sm][sbdfraktid]),sm);
		SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
		format(string,sizeof(string),"%s (ID:%i) hat eure Partnerschaft für den Schwarzmarkt (ID:%i) beendet.",Spieler[playerid][pName],playerid,sm);
		SendFraktionsMessage(SmarkInfo[sm][sbdfraktid],FMELDUNG,string);
		SmarkInfo[sm][sbdfraktid] = 0;
		UpdateSmarkLabel(sm,2);//funktion 1 wenn der smark ohne frakt ist,funktion 2 wenn der smarkt mit frakt besetzt ist
		return 1;
	}
 	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:slock(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new sm = ReturnSmarkID(playerid),string[128];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		if(GetFraktionSmarkCount(Spieler[playerid][pFraktion]) == 0)return SCM(playerid,SAMP_WEISS,"Eure Fraktion besitzt kein Schwarzmarkt./Eure Fraktion ist kein Psrtner eines Schwarzmarktes.");
	    if(sm == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in/an eurem Schwarzmarkt.");
		if(isPlayerInFrakt(playerid,SmarkInfo[sm][sfraktid]) || isPlayerInFrakt(playerid,SmarkInfo[sm][sbdfraktid]))
		{
		    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		    if(SmarkInfo[sm][sattackerfraktid] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst den Umkämpften Schwarzmarkt jetzt nicht auf-/abschließen.");
			if(SmarkInfo[sm][slocked] == 0)
			{
				SmarkInfo[sm][slocked] = 1;
				format(string,sizeof(string),""IINFO" du hast den Schwarzmarkt (ID:%i) der %s abgeschlossen.",sm,FraktionsName(SmarkInfo[sm][sfraktid]));
				SCM(playerid,SAMP_WEISS,string);
				format(string,sizeof(string),"%s (ID:%i) hat euren Schwarzmarkt (ID:%i) abgeschlossen.",Spieler[playerid][pName],playerid,sm);
				SendFraktionsMessage(SmarkInfo[sm][sfraktid],FMELDUNG,string);
				UpdateSmarkLabel(sm,2);//funktion 1 wenn der smark ohne frakt ist,funktion 2 wenn der smarkt mit frakt besetzt ist
			}
			else if(SmarkInfo[sm][slocked] == 1)
			{
				SmarkInfo[sm][slocked] = 0;
				format(string,sizeof(string),""IINFO" du hast den Schwarzmarkt (ID:%i) der %s aufgeschlossen.",sm,FraktionsName(SmarkInfo[sm][sfraktid]));
				SCM(playerid,SAMP_WEISS,string);
				format(string,sizeof(string),"%s (ID:%i) hat euren Schwarzmarkt (ID:%i) aufgeschlossen.",Spieler[playerid][pName],playerid,sm);
				SendFraktionsMessage(SmarkInfo[sm][sfraktid],FMELDUNG,string);
				UpdateSmarkLabel(sm,2);//funktion 1 wenn der smark ohne frakt ist,funktion 2 wenn der smarkt mit frakt besetzt ist
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" das ist nicht euer Schwarzmarkt./Du bist nicht Partner dieses Schwarzmarktes.");
    }
 	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:seject(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],pID;
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		if(GetFraktionSmarkCount(Spieler[playerid][pFraktion]) == 0)return SCM(playerid,SAMP_WEISS,"Eure Fraktion besitzt kein Schwarzmarkt./Eure Fraktion ist kein Psrtner eines Schwarzmarktes.");
	    for(new sm=1;sm<MAX_SMARKETS;sm++)
		{
			if(SmarkInfo[sm][screatet] == 1)
			{
				if(IsPlayerInRangeOfPoint(playerid,25.0,944.8334,788.1722,-18.9141) && GetPlayerVirtualWorld(playerid) == sm)
				{
					if(isPlayerInFrakt(playerid,SmarkInfo[sm][sfraktid]) || isPlayerInFrakt(playerid,SmarkInfo[sm][sbdfraktid]))
					{
					    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
						if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /seject [playerid/Name]");
						if(playerid == pID)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst aus dem Schwarzmarkt schmeißen.");
						if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
					    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
						if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
						if(!ProxDetectorS(3.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
						if(isPlayerInFrakt(pID,SmarkInfo[sm][sfraktid]))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst den Besitzer nicht aus dem Schwarzmarkt schmeißen.");
						format(string,sizeof(string),"** %s nimmt %s am Kragen und schmeißt ihn aus dem Schwarzmarkt **",SpielerName(playerid),SpielerName(pID));
						PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
						SetPlayerPosEx(pID,SmarkInfo[sm][sx],SmarkInfo[sm][sy],SmarkInfo[sm][sz]);
						SetPlayerVirtualWorld(pID,0);
						SetPlayerInterior(pID,0);
						TogglePlayerControllable(pID,true);
						PlayerTextDrawHide(pID,INFOdraw[pID][0]);
						PlayerTextDrawHide(pID,BUYSMARKTWEAPONdraw[pID][0]);
						PlayerTextDrawHide(pID,BUYSMARKTWEAPONdraw[pID][1]);
						CancelSelectTextDraw(pID);
						Spieler[pID][pEnterExits] = gettime() + 10;
						return 1;
					}
					return SCM(playerid,SAMP_WEISS,""IINFO" das ist nicht euer Schwarzmarkt./Du bist nicht Partner dieses Schwarzmarktes.");
			    }
		    }
	    }
	    return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in eurem Schwarzmarkt.");
	}
 	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:baselock(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new i = ReturnFbaseID(playerid),string[350];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    if(i == -1)return SCM(playerid,SAMP_WEISS,""IINFO" nicht an der Base!");
	    if(!isPlayerInFrakt(playerid,Fraktionsbase[i][fbasefraktid]))return SCM(playerid,SAMP_WEISS,""IINFO" das ist nicht das Frakionshaus.");
	    if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
		if(Fraktionsbase[i][fbaselocked] == 0)
		{
			Fraktionsbase[i][fbaselocked] = 1;
			UpdateFbase3DText(i);
		    format(string,sizeof(string),"Rang: "IINFO2"%s"#HTML_WEISS" Name: "IINFO2"%s"#HTML_WEISS" hat die Base von: "IINFO2"%s"#HTML_WEISS" Abgeschlossen!",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],FraktionsName(Spieler[playerid][pFraktion]));
		    SendFraktionsMessage(Spieler[playerid][pFraktion],SAMP_WEISS,string);
		}
		else if(Fraktionsbase[i][fbaselocked] == 1)
		{
			Fraktionsbase[i][fbaselocked] = 0;
			UpdateFbase3DText(i);
		    format(string,sizeof(string),"Rang: "IINFO2"%s"#HTML_WEISS" Name: "IINFO2"%s"#HTML_WEISS" hat die Base von: "IINFO2"%s"#HTML_WEISS" Aufgeschlossen!",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],FraktionsName(Spieler[playerid][pFraktion]));
		    SendFraktionsMessage(Spieler[playerid][pFraktion],SAMP_WEISS,string);
		}
	 	return 1;
 	}
 	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:fheal(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    if(ReturnFbankPointID(playerid) == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich hier nicht heilen!");
	    if(!isPlayerInFrakt(playerid,Fraktionsbase[ReturnFbankPointID(playerid)][fbasefraktid]))return SCM(playerid,SAMP_WEISS,"Healpunkt ist nicht im besitz deiner Fraktion.");
		if(fverwaltungen[Spieler[playerid][pFraktion]][HealSlots] <= 0)
		{
			fverwaltungen[Spieler[playerid][pFraktion]][Heal] = 0;
			return SCM(playerid,SAMP_WEISS,""IINFO" das Heal-Pack wurde schon verbraucht.");
		}
		if(gettime() < Spieler[playerid][pAntiHealInFight])
		{
			new time = Spieler[playerid][pAntiHealInFight] - gettime();
			format(string,sizeof(string),""IINFO" du kannst dich erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten heilen oder dir eine Rüstung überziehen.",time/60,time%60);
			return SCM(playerid,SAMP_WEISS,string);
		}
		if(fverwaltungen[Spieler[playerid][pFraktion]][Heal] == 1)
		{
		    PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
		    SCM(playerid,0x4BB400FF,""IINFO" du hast dich geheilt.");
		    fverwaltungen[Spieler[playerid][pFraktion]][HealSlots]--;
		    if((GetPlayerACHealth(playerid) + 50) > 100)return SetPlayerACHealth(playerid,100);
			SetPlayerACHealth(playerid,GetPlayerACHealth(playerid)+50);
		}
		if(fverwaltungen[Spieler[playerid][pFraktion]][Heal] == 2)
		{
		    PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
		    SCM(playerid,0x4BB400FF,""IINFO" du hast dich geheilt.");
		    fverwaltungen[Spieler[playerid][pFraktion]][HealSlots]--;
		    if((GetPlayerACHealth(playerid) + 75) > 100)return SetPlayerACHealth(playerid,100);
			SetPlayerACHealth(playerid,GetPlayerACHealth(playerid)+75);
		}
		if(fverwaltungen[Spieler[playerid][pFraktion]][Heal] == 3)
		{
		    PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
		    SCM(playerid,0x4BB400FF,""IINFO" du hast dich geheilt.");
			fverwaltungen[Spieler[playerid][pFraktion]][HealSlots]--;
			SetPlayerACHealth(playerid,100);
		}
	    return 1;
    }
    return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:farmour(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    if(ReturnFbankPointID(playerid) == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir hier keine Rüstung überziehen!");
		if(!isPlayerInFrakt(playerid,Fraktionsbase[ReturnFbankPointID(playerid)][fbasefraktid]))return SCM(playerid,SAMP_WEISS,"Rüstungspunkt ist nicht im besitz deiner Fraktion.");
		if(fverwaltungen[Spieler[playerid][pFraktion]][ArmourSlots] <= 0)
		{
			fverwaltungen[Spieler[playerid][pFraktion]][Armour] = 0;
			return SCM(playerid,SAMP_WEISS,""IINFO" das Armour-Pack wurde schon verbraucht.");
		}
		if(gettime() < Spieler[playerid][pAntiHealInFight])
		{
			new time = Spieler[playerid][pAntiHealInFight] - gettime();
			format(string,sizeof(string),""IINFO" du kannst dich erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten heilen oder dir eine Rüstung überziehen.",time/60,time%60);
			return SCM(playerid,SAMP_WEISS,string);
		}
		if(fverwaltungen[Spieler[playerid][pFraktion]][Armour] == 1)
		{
		    PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
		    SCM(playerid,0x4BB400FF,""IINFO" du hast dir eine Rüstung übergezogen.");
		    fverwaltungen[Spieler[playerid][pFraktion]][ArmourSlots]--;
			if((GetPlayerACArmour(playerid) + 50) > 100)return SetPlayerACArmour(playerid,100);
			SetPlayerACArmour(playerid,GetPlayerACArmour(playerid) + 50);
		}
		if(fverwaltungen[Spieler[playerid][pFraktion]][Armour] == 2)
		{
		    PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
		    SCM(playerid,0x4BB400FF,""IINFO" du hast dir eine Rüstung übergezogen.");
		    fverwaltungen[Spieler[playerid][pFraktion]][ArmourSlots]--;
			if((GetPlayerACArmour(playerid) + 75) > 100)return SetPlayerACArmour(playerid,100);
			SetPlayerACArmour(playerid,GetPlayerACArmour(playerid) + 75);
		}
		if(fverwaltungen[Spieler[playerid][pFraktion]][Armour] == 3)
		{
		    PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
		    SCM(playerid,0x4BB400FF,""IINFO" du hast dir eine Rüstung übergezogen.");
			fverwaltungen[Spieler[playerid][pFraktion]][ArmourSlots]--;
			SetPlayerACArmour(playerid,100);
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
