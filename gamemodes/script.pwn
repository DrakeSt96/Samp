COMMAND:respawnallveh(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128];
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	for(new i=0;i<MAX_VEHICLES;i++)
	{
		if(IsValidVehicle(i))
		{
			if(IsVehicleEmpty(i) && !IsTrailerAttachedToVehicle(i))
			{
				MotorDown[i] = 0;
				vFahrzeug[i][FailGas] = 0;
				vFahrzeug[i][Tank] = VehicleInfo[GetVehicleModel(i)-400][vtankvolumen];
				SetVehicleToRespawn(i);
			}
		}
	}
	format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS" hat alle Fahrzeuge respawnt.",Spieler[playerid][pName]);
	SendClientMessageToAll(SAMP_WEISS,string);
	return 1;
}

COMMAND:respawnallfraktveh(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new string[128],fID;
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	if(sscanf(params,"i",fID))return SCM(playerid,SAMP_WEISS,""IINFO" /respawnallfraktveh [Fraktionsid]");
	if(fID<1||fID>17)return SCM(playerid,SAMP_WEISS,""IINFO" /respawnallfraktveh [Fraktionsid 1-16]");
	for(new fv;fv<MAX_FVEHS;fv++)
	{
		if(Fahrzeug[fv][Fraktion] == fID)
		{
			if(IsVehicleEmpty(Fahrzeug[fv][Vehicle]))
			{
				MotorDown[Fahrzeug[fv][Vehicle]] = 0;
				vFahrzeug[Fahrzeug[fv][Vehicle]][FailGas] = 0;
				vFahrzeug[Fahrzeug[fv][Vehicle]][Tank] = VehicleInfo[GetVehicleModel(Fahrzeug[fv][Vehicle])-400][vtankvolumen];
				GetVehicleHealth(Fahrzeug[fv][Vehicle],Fahrzeug[fv][HP]);
			 	FVehicleSpawner(fv);
			}
		}
	}
	format(string,sizeof(string),""ACINFO" Du hast alle unbenutzten Fraktionsfahrzeuge Fahrzeuge der Fraktion %s respawnt.",FraktionsName(fID));
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"Name: %s(ID:%i) | Adminlevel: %i | Fraktion: %s",Spieler[playerid][pName],playerid,Spieler[playerid][pAdmin],FraktionsName(fID));
	Log("AFrespawnsqllog",string);
	return 1;
}

COMMAND:afparken(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new fv = IsAFraktionsVeh(playerid),vehicleid = GetPlayerVehicleID(playerid);
    if(!isPlayerAnAdmin(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein "#SERVERTAG" Teammitglied./Du hast nicht den jeweiligen Adminrang.!");
    if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
    if(fv == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(Motor[vehicleid] == true)return SCM(playerid,SAMP_WEISS,""IINFO" der Motor muss aus sein,bevor du das Fahrzeug parkst.");
   	if(Fahrzeug[fv][Fraktion] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug gehört keiner Fraktion!");
	GetVehiclePos(Fahrzeug[fv][Vehicle],Fahrzeug[fv][posx],Fahrzeug[fv][posy],Fahrzeug[fv][posz]);
	GetVehicleZAngle(Fahrzeug[fv][Vehicle],Fahrzeug[fv][posa]);
	Fahrzeug[fv][Interior] = GetPlayerInterior(playerid);
	Fahrzeug[fv][VirtualWorld] = GetVehicleVirtualWorld(vehicleid);
	SCM(playerid,SAMP_WEISS,"Fahrzeug erfolgreich umgeparkt.");
	GetVehicleHealth(Fahrzeug[fv][Vehicle],Fahrzeug[fv][HP]);
	FVehicleSpawner(fv);
	SaveOnlyOneFveh(fv);
	PutPlayerInVehicleEx(playerid,Fahrzeug[fv][Vehicle],0);
	return 1;
}

COMMAND:aflock(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:x,Float:y,Float:z,string[64];
    if(!isPlayerAnAdmin(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein "#SERVERTAG" Teammitglied./Du hast nicht den jeweiligen Adminrang.!");
	if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
    for(new fv;fv<MAX_FVEHS;fv++)
	{
		if(IsValidVehicle(Fahrzeug[fv][Vehicle]))
		{
		   	GetVehiclePos(Fahrzeug[fv][Vehicle],x,y,z);
			GetVehicleParamsEx(Fahrzeug[fv][Vehicle],engine,lights,alarm,doors,bonnet,boot,objective);
			if(IsPlayerInRangeOfPoint(playerid,3.0,x,y,z))
			{
				if(Fahrzeug[fv][Abgeschlossen] == 0)
				{
				    SetVehicleParamsEx(Fahrzeug[fv][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
				    Fahrzeug[fv][Abgeschlossen] = 1;
				    format(string,sizeof(string),"~w~%s~n~~r~abgeschlossen",VehicleDefinations[Fahrzeug[fv][modelid]-400]);
				    GameTextForPlayer(playerid,string,2000,6);
				    PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
					return 1;
				}
				else if(Fahrzeug[fv][Abgeschlossen] == 1)
				{
				    SetVehicleParamsEx(Fahrzeug[fv][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
				    Fahrzeug[fv][Abgeschlossen] = 0;
					format(string,sizeof(string),"~w~%s~n~~g~aufgeschlossen",VehicleDefinations[Fahrzeug[fv][modelid]-400]);
				    GameTextForPlayer(playerid,string,2000,6);
				    PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
					return 1;
				}
			}
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Fraktionsfahrzeuges.");
}
COMMAND:jlock(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:x,Float:y,Float:z,string[64],vehicleid = GetPlayerVehicleID(playerid);
	if(!isPlayerInJob(playerid,10))return SCM(playerid,SAMP_WEISS,"Kein Trucker.");
	if(!IsVehicleATruck(vehicleid))return SCM(playerid,SAMP_WEISS,"In keinem Truck!");
	if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
	if(vFahrzeug[vehicleid][Abgeschlossen] == 0)
	{
 		SetVehicleParamsEx(vFahrzeug[vehicleid][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
   		vFahrzeug[vehicleid][Abgeschlossen] = 1;
	    format(string,sizeof(string),"~w~%s~n~~r~abgeschlossen",VehicleDefinations[vFahrzeug[vehicleid][modelid]-400]);
	    GameTextForPlayer(playerid,string,2000,6);
	    PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
		return 1;
	}
	else if(vFahrzeug[vehicleid][Abgeschlossen] == 1)
	{
 		SetVehicleParamsEx(vFahrzeug[vehicleid][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
 		vFahrzeug[vehicleid][Abgeschlossen] = 0;
		format(string,sizeof(string),"~w~%s~n~~g~aufgeschlossen",VehicleDefinations[vFahrzeug[vehicleid][modelid]-400]);
 		GameTextForPlayer(playerid,string,2000,6);
 		PlayerHearMusicInRange(x,y,z,1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
		return 1;
	}
	return 1;
}
