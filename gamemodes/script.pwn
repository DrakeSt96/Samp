				Spieler[playerid][pHandystate] = 0;
				format(string,sizeof(string),""IINFO" du hast dir ein %s mit einem Akkuverbrauch von %.1f% für %i$(davon versteuert: %i$) gekauft!",HandyInfo[Spieler[playerid][pHandy]][Handyname],HandyInfo[Spieler[playerid][pHandy]][HandyVerbrauch],BizInfo[biz][biz_artikel][listitem],givemwst);
				SCM(playerid,SAMP_WEISS,string);
