			format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
		    UpdateDynamic3DTextLabelText(WarLabel[gw][0],SAMP_WEISS,string);
			format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
		    UpdateDynamic3DTextLabelText(WarLabel[gw][1],SAMP_WEISS,string);
			format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
		    UpdateDynamic3DTextLabelText(WarLabel[gw][2],SAMP_WEISS,string);
		    return 1;
		}
		if(GangwarZones[gw][War_AttackerPoints] > GangwarZones[gw][War_OwnerPoints])
		{
			ForEachPlayer(i)
		    {
			    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			    {
				    if(!isPlayerInFrakt(i,GangwarZones[gw][War_Owner]) || !isPlayerInFrakt(i,GangwarZones[gw][War_Attacker]))
				    {
					    format(string,sizeof(string),"%s%s~w~ hat das Gangwar~n~gewonnen",GWFraktionsGameTextColor(GangwarZones[gw][War_Attacker]),FraktionsName(GangwarZones[gw][War_Attacker]));
					    GameTextForPlayer(i,string,7500,5);
				    }
				    if(isPlayerInFrakt(i,GangwarZones[gw][War_Attacker]))
