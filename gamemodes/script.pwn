COMMAND:exitiraum(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	ReturnPropertyData(playerid);
	new count = Spieler[playerid][pReturnPropertyDataHausCount],selecthomeid = Spieler[playerid][pSelectHome],homestorestring[600];
    if(GetPlayerVirtualWorld(playerid) != 300)return SCM(playerid,SAMP_WEISS,"Nicht im HomeStore.");
    if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
    if(selecthomeid == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast kein Haus für deinen Spawn ausgewählt.");
    SetPlayerPosEx(playerid,-2236.0898,130.1639,1035.4141);
    SetPlayerInterior(playerid,6);
    SetPlayerVirtualWorld(playerid,0);
    for(new i=0;i<sizeof(Homestore);i++)
    {
	    if(HausInfo[selecthomeid][haus_slots] >= Homestore[i][Hselectmatch])
	    {
		    strcat(homestorestring,Homestore[i][HInnenraum]);
		    strcat(homestorestring,"\n");
	    }
    }
    ShowPlayerDialog(playerid,H_INTERIOR_BESICHTIGUNG,DIALOG_STYLE_LIST,"HomeStore",homestorestring,"Besichtigen","Zurück");
	return 1;
}
COMMAND:listhausguns(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	ReturnPropertyData(playerid);
 	new haus = Spieler[playerid][pReturnPropertyDataHaus],count = Spieler[playerid][pReturnPropertyDataHausCount],string[64],weapcounter;
	if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
 	if(haus == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in/an deinem Haus.");
	if(HausInfo[haus][haus_waffenschrank] == 0)return SCM(playerid,SAMP_WEISS,"Dein Haus besitzt keinen Waffenschrank!");
	SCM(playerid,SAMP_WEISS,"||__________Waffen__________||");
	for(new i=0;i<13;i++)
	{
		if(HausInfo[haus][haus_gun][i] != 0)
		{
			format(string,sizeof(string),"%i. %s,%i Munition",i,SpielerWaffenName(HausInfo[haus][haus_gun][i]),HausInfo[haus][haus_gunammo][i]);
			SCM(playerid,SAMP_WEISS,string);
			weapcounter++;
		}
	}
	if(weapcounter == 0)return SCM(playerid,SAMP_WEISS,"Keine");
	return 1;
}
COMMAND:hausgun(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	ReturnPropertyData(playerid);
 	new haus = Spieler[playerid][pReturnPropertyDataHaus],count = Spieler[playerid][pReturnPropertyDataHausCount],string[128],cmd[6],gunname[35],gunammo;
	if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
 	if(haus == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in/an deinem Haus.");
	if(HausInfo[haus][haus_waffenschrank] == 0)return SCM(playerid,SAMP_WEISS,"Dein Haus besitzt keinen Waffenschrank!");
    if(sscanf(params,"s[6]s[35]i",cmd,gunname,gunammo))return SCM(playerid,SAMP_WEISS,""#IINFO" /hausgun [Get/Dump][Waffenname][Munition]");
	new gunid = WaffenidbyName(gunname);
	if(gunid == -1)return SCM(playerid,SAMP_WEISS,"Waffe nicht erkannt!");
	if(gunammo <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" du musst schon einen Munitionsbetrag angeben!");
	if(strcmp(cmd,"get",true) == 0)
   	{
		if(HausInfo[haus][haus_gun][Script_GetWeaponSlot(gunid)] == gunid)
		{
			if((HausInfo[haus][haus_gunammo][Script_GetWeaponSlot(gunid)] - gunammo) < 0)return SCM(playerid,SAMP_WEISS,"So viel Munition liegt nicht im Waffenschrank!");
			format(string,sizeof(string),""IINFO" du hast dir ein/e %s mit %i Munition aus dem Waffenschrank genommen!",SpielerWaffenName(gunid),gunammo);
			SCM(playerid,SAMP_WEISS,string);
			GiveWeapon(playerid,gunid,gunammo,true);
			HausInfo[haus][haus_gunammo][Script_GetWeaponSlot(gunid)] -= gunammo;
			if(HausInfo[haus][haus_gunammo][Script_GetWeaponSlot(gunid)] <= 0)
			{
				HausInfo[haus][haus_gun][Script_GetWeaponSlot(gunid)] = 0;
			}
			SaveOnlyOneHaus(haus);
			format(string,sizeof(string),"** %s holt eine Waffe aus dem Waffenschrank **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			return 1;
		}
	   	return SCM(playerid,SAMP_WEISS,"Angegebene Waffe nicht im Waffenschrank!");
   	}
   	if(strcmp(cmd,"dump",true) == 0)
   	{
	   	if(GetPlayerWeapon(playerid) != WEAPON:gunid)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt die angegebende Waffe nicht!");
		if((GetPlayerAmmo(playerid) - gunammo) < 0)return SCM(playerid,SAMP_WEISS,"Angegebene Munitionsrate nicht vorhanden!");
		format(string,sizeof(string),""IINFO" du hast ein/e %s mit %i Munition in den Waffenschrank gelegt!",SpielerWaffenName(gunid),gunammo);
		SCM(playerid,SAMP_WEISS,string);
		HausInfo[haus][haus_gun][Script_GetWeaponSlot(GetPlayerWeapon(playerid))] = gunid;
		HausInfo[haus][haus_gunammo][Script_GetWeaponSlot(GetPlayerWeapon(playerid))] += gunammo;
		SetPlayerAmmo(playerid,WEAPON:gunid,GetPlayerAmmo(playerid) - gunammo);
		SaveOnlyOneHaus(haus);
		format(string,sizeof(string),"** %s legt seine Waffe in den Waffenschrank **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
   	}
	return SCM(playerid,SAMP_WEISS,""#IINFO" /hausgun [Get/Dump][Waffenname][Munition]");
}
COMMAND:mieter(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	ReturnPropertyData(playerid);
 	new string[128],query[256],haus = Spieler[playerid][pReturnPropertyDataHaus],count = Spieler[playerid][pReturnPropertyDataHausCount];
 	if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
 	if(haus == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in/an deinem Haus.");
	format(string,sizeof(string),"[_Mieter der Hausnummer %i_]",haus);
	SCM(playerid,SAMP_WEISS,string);
    format(query,sizeof(query),"SELECT Name FROM spieler WHERE HausMieter='%d'",haus);
    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,c_script_mieter,playerid,MySQL_R394);
	return 1;
}
COMMAND:rauswerfen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im AFK-Modus und kannst somit keine Befehle nutzen."),SCM(playerid,SAMP_WEISS,""#HTML_BLAU"Verwendung:"#HTML_WEISS""#IINFO" /back");
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	ReturnPropertyData(playerid);
 	new namestring[24],query[128],string[128],haus = Spieler[playerid][pReturnPropertyDataHaus],count = Spieler[playerid][pReturnPropertyDataHausCount];
    if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
 	if(haus == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in/an deinem Haus.");
	if(sscanf(params,"s[24]",namestring))return SCM(playerid,SAMP_WEISS,""#IINFO" /rauswerfen [Mieter]");
    new pID = GetPlayerID(namestring);
	if(pID == -1)
	{
		format(query,sizeof(query),"SELECT * FROM spieler WHERE HausMieter='%d'",haus);
	    mysql_function_query(MySQL_R394,query,true,"sql_array","ssiiii",query,namestring,a_script_hmieterkick,haus,playerid,MySQL_R394);
		return 1;
	}
	if(Spieler[pID][pRentHome] != haus)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht bei dir eingemietet.");
	Spieler[pID][pSpawn] = 0;
  	HausInfo[haus][haus_eingemitetenzaehler]--;
   	format(string,sizeof(string),""IINFO" du hast %s aus deinem Haus geworfen! Mieterslots %i/%i",namestring,HausInfo[haus][haus_eingemitetenzaehler],HausInfo[haus][haus_slots]);
    SCM(playerid,SAMP_WEISS,string);
    UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
	return 1;
}
COMMAND:allerauswerfen(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	ReturnPropertyData(playerid);
 	new query[128],string[128],haus = Spieler[playerid][pReturnPropertyDataHaus],count = Spieler[playerid][pReturnPropertyDataHausCount];
    if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
 	if(haus == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in/an deinem Haus.");
	if(HausInfo[haus][haus_eingemitetenzaehler] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand ist bei dir eingemietet!");
    format(query,sizeof(query),"SELECT * FROM spieler WHERE HausMieter='%d'",haus);
    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,k_script_mieterkick,playerid,MySQL_R394);
    format(string,sizeof(string),""IINFO" du hast alle Mieter rausgeworfen! Mieterslots %i/%i",HausInfo[haus][haus_eingemitetenzaehler],HausInfo[haus][haus_slots]);
    SCM(playerid,SAMP_WEISS,string);
    HausInfo[haus][haus_eingemitetenzaehler] = 0;
	UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
	return 1;
}
COMMAND:haus(playerid,const params[])
{
	ShowPlayerHausUpdate(playerid);
	return 1;
}
COMMAND:haus__3(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	ReturnPropertyData(playerid);
 	new haus = Spieler[playerid][pReturnPropertyDataHaus],count = Spieler[playerid][pReturnPropertyDataHausCount],hausid = Spieler[playerid][pRentHome],cmd[25],string[128],query[128];
	if(count != 0 || hausid != 0)
	{
	    if(sscanf(params,"s[25]",cmd)) return SCM(playerid,SAMP_WEISS,"");
		if(strcmp(cmd,"hausupgrade",true) == 0 || strcmp(cmd,"upgrade",true) == 0)
	   	{
		   	if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
		    if(Spieler[playerid][pSelectHome] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast kein Haus für deinen Spawn ausgewählt.");
		   	if(!IsPlayerInRangeOfPoint(playerid,2,-2236.0898,130.1639,1035.4141))return SCM(playerid,SAMP_WEISS,"Nicht im HomeStore.");
		    ShowPlayerDialog(playerid,DIALOG_HOMESTORE,DIALOG_STYLE_LIST,"HomeStore","Innenraum besichtigen\nInnenraum erwerben\nHeal\nArmour\nWaffenschrank (30.000$)","Auswählen","Abbrechen");
		   	return 1;
	   	}
	   	if(strcmp(cmd,"lock",true) == 0 || strcmp(cmd,"aufzu",true) == 0)
	   	{
		   	if(count == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
		    if(haus == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in/an deinem Haus.");
		    if(IsPlayerInRangeOfPoint(playerid,5,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]) || (HausInfo[haus][haus_innenraum] != 255 && IsPlayerInRangeOfPoint(playerid,25,Homestore[HausInfo[haus][haus_innenraum]][Hx],Homestore[HausInfo[haus][haus_innenraum]][Hy],Homestore[HausInfo[haus][haus_innenraum]][Hz]) && GetPlayerVirtualWorld(playerid) == haus))
			{
				if(HausInfo[haus][haus_locked] == 0)
				{
					HausInfo[haus][haus_locked] = 1;
					UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
					SCM(playerid,SAMP_WEISS,""IINFO" du hast dein haus abgeschlossen!");
					return 1;
				}
				else if(HausInfo[haus][haus_locked] == 1)
				{
					HausInfo[haus][haus_locked] = 0;
					UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
					SCM(playerid,SAMP_WEISS,""IINFO" du hast dein haus aufgeschlossen!");
					return 1;
				}
			}
		   	else
   			{
			   SCM(playerid,SAMP_WEISS,""IINFO" du musst in deinem Haus/an deinem Haus sein!");
			   return 1;
			}
	   	}
		if(strcmp(cmd,"moebel",true) == 0)
		{
	        if(Spieler[playerid][pSelectHome] == 0)return SCM(playerid,SAMP_WEISS,""IINFO2" du hast kein Haus für deinen Spawn ausgewählt.");
			if(haus == 0)return SCM(playerid,SAMP_WEISS,""IINFO2" du bist nicht in deinem Haus.");
			if(GetPlayerInterior(playerid)==0)return SCM(playerid,SAMP_WEISS,""IINFO2" du bist nicht in deinem Haus.");
	        ShowPlayerDialog(playerid,HDIA_MOEBEL_MAIN,DIALOG_STYLE_LIST,""ClanTagDialoge" Möbel Startseite","Meine Möbel\nMöbel kaufen\nMöbel umstellen\nMöbel verkaufen","Auswählen","Abbrechen");
			return 1;
		}
	   	if(strcmp(cmd,"menu",true) == 0 || strcmp(cmd,"cp",true) == 0)
	   	{
		   	if(count == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
		    if(haus == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in/an deinem Haus.");
			ShowHausMenu(playerid);
	   	}
	   	if(strcmp(cmd,"heal",true) == 0 || strcmp(cmd,"heilen",true) == 0)
	   	{
		    if(hausid != -1 || haus != -1)
		    {
              if(GetPlayerVirtualWorld(playerid) != 0)
			  {
			    if(GetPlayerVirtualWorld(playerid) == haus || GetPlayerVirtualWorld(playerid) == hausid)
			    {
					if(HausInfo[GetPlayerVirtualWorld(playerid)][haus_hatheal] != 0 || HausInfo[GetPlayerVirtualWorld(playerid)][haus_hatheal] != 0)
					{
						if(HausInfo[GetPlayerVirtualWorld(playerid)][hausmull] < 10 || HausInfo[GetPlayerVirtualWorld(playerid)][hausmull] < 10)
						{
						    if(gettime() < Spieler[playerid][pAntiHealInFight])
							{
								new time = Spieler[playerid][pAntiHealInFight] - gettime();
								format(string,sizeof(string),""IINFO" du kannst dich erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten heilen oder dir eine Rüstung überziehen.",time/60,time%60);
								return SCM(playerid,SAMP_WEISS,string);
							}
      						if((GetPlayerACHealth(playerid) + HausInfo[GetPlayerVirtualWorld(playerid)][haus_heal]) > 100)
					  		{
					        SetPlayerACHealth(playerid,100);
					        PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
							SCM(playerid,SAMP_WEISS,""IINFO" du hast dich geheilt.");
							format(string,sizeof(string),"** %s füllt sein Leben auf **",SpielerName(playerid));
							PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
							}
							else
							{
							SetPlayerACHealth(playerid,GetPlayerACHealth(playerid)+HausInfo[GetPlayerVirtualWorld(playerid)][haus_heal]);
							PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
							SCM(playerid,SAMP_WEISS,""IINFO" du hast dich geheilt.");
							format(string,sizeof(string),"** %s füllt sein Leben auf **",SpielerName(playerid));
							PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
							}
						    return 1;

					    }
					    else
						{
							SCM(playerid,SAMP_WEISS,""IINFO" das Haus ist zu verdreckt um sich zu healen.");
							return 1;
						}
					}
					else
					{
						SCM(playerid,SAMP_WEISS,""IINFO" das Haus besitzt kein Hausheal.");
						return 1;
					}
				}
				else
				{
					SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in deinem Haus./Du bist nicht in deinen Mietshaus.");
					return 1;
				}
			  }
			  else
		      {
		      SCM(playerid,SAMP_WEISS,""IINFO" du musst in deinem Haus/an deinem Haus sein!");
		      return 1;
		      }
			}
			else
			{
		 		SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in deinem Haus./Du bist nicht in deinen Mietshaus.");
		 		return 1;
			}
	   	}
	   	if(strcmp(cmd,"armour",true) == 0 || strcmp(cmd,"rüstung",true) == 0)
	   	{
		   	if(hausid != -1 || haus != -1)
		    {
              if(GetPlayerVirtualWorld(playerid) != 0)
			  {
       			if(GetPlayerVirtualWorld(playerid) == haus || GetPlayerVirtualWorld(playerid) == hausid)
			    {
				    if(HausInfo[GetPlayerVirtualWorld(playerid)][haus_hatarmour] != 0 || HausInfo[GetPlayerVirtualWorld(playerid)][haus_hatarmour] != 0)
					{
						if(HausInfo[GetPlayerVirtualWorld(playerid)][hausmull] < 10 || HausInfo[GetPlayerVirtualWorld(playerid)][hausmull] < 10)
						{
						    if(gettime() < Spieler[playerid][pAntiHealInFight])
							{
								new time = Spieler[playerid][pAntiHealInFight] - gettime();
								format(string,sizeof(string),""IINFO" du kannst dich erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten heilen oder dir eine Rüstung überziehen.",time/60,time%60);
								return SCM(playerid,SAMP_WEISS,string);
							}
                            if((GetPlayerACArmour(playerid) + HausInfo[GetPlayerVirtualWorld(playerid)][haus_armour]) > 100)
							{
							SetPlayerACArmour(playerid,100);
							PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
							SCM(playerid,SAMP_WEISS,""IINFO" du hast dir eine Rüstung übergezogen.");
							format(string,sizeof(string),"** %s zieht sich eine Rüstung über **",SpielerName(playerid));
							PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
							}
							else
							{
							SetPlayerACArmour(playerid,(GetPlayerACArmour(playerid)+HausInfo[GetPlayerVirtualWorld(playerid)][haus_armour]));
							PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
							SCM(playerid,SAMP_WEISS,""IINFO" du hast dir eine Rüstung übergezogen.");
							format(string,sizeof(string),"** %s zieht sich eine Rüstung über **",SpielerName(playerid));
							PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
							}
							return 1;

						}
					    else
						{
							SCM(playerid,SAMP_WEISS,""IINFO" das Haus ist zu verdreckt um sich eine Rüstung über zu ziehen.");
							return 1;
						}
					}
					else
					{
						SCM(playerid,SAMP_WEISS,""IINFO" das Haus besitzt kein Hausarmour.");
						return 1;
					}
				}
				else
				{
					SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in deinem Haus./Du bist nicht in deinen Mietshaus.");
					return 1;
				}
			  }
			  else
			  {
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in deinem Haus./Du bist nicht in deinen Mietshaus.");
				return 1;
			  }
			}
			else
			{
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in deinem Haus./Du bist nicht in deinen Mietshaus.");
				return 1;
			}
	   	}
	   	if(strcmp(cmd,"verkaufen",true) == 0 || strcmp(cmd,"sell",true) == 0)
	   	{
		   	if(IsPlayerInRangeOfPoint(playerid,2,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z]))
			{
			    ACMoney(playerid,floatround(HausInfo[haus][haus_preis]/2));
				format(string,sizeof(string),""IINFO" du erhälst einen Bruchteil vom Kaufpreis zurück.(%i$)",HausInfo[haus][haus_preis]/2);
			 	SCM(playerid,SAMP_WEISS,string);
				DestroyDynamicPickup(HausInfo[haus][haus_pickup]);
				HausInfo[haus][haus_Owned] = 0;
				HausInfo[haus][haus_eingemitetenzaehler] = 0;
				HausInfo[haus][haus_locked] = 1;
			    HausInfo[haus][haus_waffenschrank] = 0;
			    HausInfo[haus][haus_hatheal] = 0;
			    HausInfo[haus][haus_heal] = 0;
			    HausInfo[haus][haus_hatarmour] = 0;
			    HausInfo[haus][haus_armour] = 0;
				strmid(HausInfo[haus][haus_besitzer],"Niemand",0,strlen("Niemand"),24);
				//strmid(HausInfo[haus][haus_beschreibung],"Keine",0,strlen("Keine"),150);
				strmid(HausInfo[haus][haus_msg],"Keine",0,strlen("Keine"),150);
				UpdateHausLabel(haus,1);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
			    HausInfo[haus][haus_pickup] = CreateDynamicPickup(Server_Haus_Frei_Pickup,1,HausInfo[haus][haus_x],HausInfo[haus][haus_y],HausInfo[haus][haus_z],-1);
			    SaveOnlyOneHaus(haus);
				Spieler[playerid][pSpawn] = 0;
			    SaveAccount(playerid);
			    ReturnPropertyData(playerid);
				format(query,sizeof(query),"SELECT Name FROM spieler WHERE HausMieter='%d'",haus);
			    mysql_function_query(MySQL_R394,query,true,"sql_array2","siii",query,k_script_mieterkick,playerid,MySQL_R394);
				mysql_format(MySQL_R394,query,sizeof(query),"DELETE FROM server_housemoebel WHERE haus_dbid='%d'",HausInfo[haus][dbhaus_id]);
				mysql_function_query(MySQL_R394,query,false,"","");
				for(new hobj=0;hobj<MAX_HAUSOBJECTS;hobj++)
				{
				    if(HausmoebelInfo[hobj][hmhaus_dbid] == HausInfo[haus][dbhaus_id] && HausmoebelInfo[hobj][hmmodelid] != 0)
					{
					    DestroyDynamicObject(HausmoebelInfo[hobj][hmobjectid]);
						HausmoebelInfo[hobj][hmmodelid] = 0;
					}
				}
				return 1;
		    }
		    else
			{
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht an deinem Haus.");
				return 1;
			}
	   	}
	   	if(strcmp(cmd,"myhome",true) == 0 || strcmp(cmd,"home",true) == 0)
	   	{
		   	if(count == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus.");
		    //if(Spieler[playerid][pSelectHome] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast kein Haus für deinen Spawn ausgewählt.");
		    SCM(playerid,WEISS,""IINFO" dein Haus wurde auf der Karte markiert.");
			SetPlayerCheckpoint(playerid,HausInfo[Spieler[playerid][pSelectHome]][haus_x],HausInfo[Spieler[playerid][pSelectHome]][haus_y],HausInfo[Spieler[playerid][pSelectHome]][haus_z],1.0);
			Spieler[playerid][pIsearch] = 1;
	   	}
	}
	else
	{
		SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Haus. | Du bist in keinem Haus eingemietet.");
		return 1;
	}
	return 1;
}
COMMAND:pickup(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new pID = Spieler[playerid][pCall],string[128];
	if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
    if(Spieler[playerid][pHandystate] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" dein Handy ist aus.");
    if(Spieler[playerid][pCall] == -1)return SCM(playerid,SAMP_WEISS,""IINFO" niemand ruft dich an.");
	format(string,sizeof(string),"%s hat abgehoben...",SpielerName(playerid));
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO"du kannst nun mit "IINFO2"%s"#HTML_WEISS" über dem öffentlichen Chat reden.",SpielerName(pID));
	SCM(playerid,WEISS,string);
	Spieler[playerid][pCallHim] = 1;
 	Spieler[pID][pCallHim] = 1;
	StopPlayerPlaySound(playerid);
	format(string,sizeof(string),""IINFO"im telefonat mit "IINFO2"%s",SpielerName(playerid));
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" im telefonat mit "IINFO2"%s",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,string);
	SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USECELLPHONE);
	GiveHandy(playerid);
	StopAudioStreamForPlayer(playerid);
	return 1;
}
COMMAND:tzelle_3(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(ReturnTelefonzellenID(playerid) == -1)return SCM(playerid,SAMP_WEISS,"An keiner Telefonzelle.");
    if(Spieler[playerid][pMuted] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist gemuted und kannst somit niemanden anrufen.");
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt im Fahrzeug.");
    if(Spieler[playerid][pCallHim] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits in einem Gespräch.");
    if(TeleZelleInfo[ReturnTelefonzellenID(playerid)][EGmBhHp] <= 0)return SCM(playerid,SAMP_WEISS,"Die Telefonzelle ist defekt, rufe einen Elektroniker!");
    AnTelefonZelle[playerid] = 1;
	ShowPlayerDialog(playerid,DIALOG_TELEFONZELLE_CALL,DIALOG_STYLE_INPUT,""ClanTagDialoge" Telefonzelle",""#HTML_WEISS"Gib nun bitte die "IINFO2"Nummer"#HTML_WEISS" des Spielers ein um ein.\nUm ein "IINFO2"Anruf"#HTML_WEISS" zu tätigen","Anrufen","Abbrechen");
	return 1;
}
COMMAND:hangup(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new pID = Spieler[playerid][pCall],string[128];
	if(AnTelefonZelle[playerid] == 1)
	{
		if(Spieler[playerid][pCallHim] == 1)
		{
			Spieler[playerid][pCallHim] = 0;
			Spieler[pID][pCallHim] = 0;
			Spieler[pID][pCall] = -1;
			Spieler[playerid][pCall] = -1;
			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
			SetPlayerSpecialAction(pID,SPECIAL_ACTION_STOPUSECELLPHONE);
			SCM(playerid,SAMP_WEISS,""IINFO" du hast das Gespräch beendet.");
			SCM(pID,SAMP_WEISS,""IINFO" der Gesprächspartner hat aufgelegt.");
			AnTelefonZelle[playerid] = 0;
			PlayerPlaySound(playerid,1077,0.0,0.0,0.0);
			RemovePlayerAttachedObject(pID,8);
			RemovePlayerAttachedObject(playerid,8);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Telefonieren.");
	}
	if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
	if(Spieler[playerid][pCallHim] == 1)
	{
		Spieler[playerid][pCallHim] = 0;
		Spieler[pID][pCallHim] = 0;
		Spieler[pID][pCall] = -1;
		Spieler[playerid][pCall] = -1;
		SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
		SetPlayerSpecialAction(pID,SPECIAL_ACTION_STOPUSECELLPHONE);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast das Gespräch beendet.");
		SCM(pID,SAMP_WEISS,""IINFO" der Gesprächspartner hat aufgelegt.");
		format(string,sizeof(string),"** %s legt sein %s in die Tasche **",SpielerName(playerid),HandyInfo[Spieler[playerid][pHandy]][Handyname]);
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		PlayerPlaySound(playerid,1077,0.0,0.0,0.0);
		RemovePlayerAttachedObject(pID,8);
		RemovePlayerAttachedObject(playerid,8);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Telefonieren.");
}

COMMAND:ptp(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,ZielID,string[128],Float:x,Float:y,Float:z;
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"uu",pID,ZielID))return SCM(playerid,SAMP_WEISS,""#IINFO" /ptp [playerid/Name][zielid/Zielname]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!IsPlayerConnected(ZielID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(ZielID,"Eingeloggt") == 0)
	{return Eingeloggt_MSG(playerid);}
	if(IsPlayerNPC(ZielID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(pID == ZielID)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst den Angegebenen Spieler nicht zu ihm selber Porten.");
	GetPlayerPos(ZielID,x,y,z);
	if(IsPlayerInAnyVehicle(pID))
	{
		new seatid = GetPlayerVehicleSeat(pID);
		SetPlayerPosEx(pID,x,y,z);
		SetVehiclePosEx(GetPlayerVehicleID(pID),x,y,z);
		PutPlayerInVehicleEx(pID,GetPlayerVehicleID(pID),seatid);
		SetPlayerInterior(pID,GetPlayerInterior(ZielID));
		SetPlayerVirtualWorld(pID,GetPlayerVirtualWorld(ZielID));
		LinkVehicleToInterior(GetPlayerVehicleID(ZielID),GetPlayerInterior(pID));
		SetVehicleVirtualWorld(GetPlayerVehicleID(ZielID),GetPlayerVirtualWorld(pID));
		format(string,sizeof(string),""IINFO" der Admin %s hat dich zu %s geportet.",SpielerName(playerid),SpielerName(ZielID));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" der Admin %s hat %s zu dir geportet.",SpielerName(playerid),SpielerName(pID));
		SCM(ZielID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast %s zu %s teleportiert",SpielerName(pID),SpielerName(ZielID));
		SCM(playerid,SAMP_WEISS,string);
	}
	else
	{
		SetPlayerPosEx(pID,x,y,z);
		SetPlayerInterior(pID,GetPlayerInterior(ZielID));
		SetPlayerVirtualWorld(pID,GetPlayerVirtualWorld(ZielID));
		format(string,sizeof(string),""IINFO" der Admin %s hat dich zu %s geportet.",SpielerName(playerid),SpielerName(ZielID));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" der Admin %s hat %s zu dir geportet.",SpielerName(playerid),SpielerName(pID));
		SCM(ZielID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast %s zu %s teleportiert",SpielerName(pID),SpielerName(ZielID));
		SCM(playerid,SAMP_WEISS,string);
	}
	return 1;
}

COMMAND:gotoxyz(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],Float:x,Float:y,Float:z,interior,world;
    if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
    if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
	if(sscanf(params,"fffii",x,y,z,interior,world))return SCM(playerid,SAMP_WEISS,""#IINFO" /gotoxyz [Xcord,Ycord,Zcord][Interior][Virtuelle Welt]");
	if(x >= 20000.0 || y >= 20000.0 || z >= 10000)return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(IsPlayerInAnyVehicle(playerid))
	{
		new seatid = GetPlayerVehicleSeat(playerid);
		SetPlayerPosEx(playerid,x,y,z);
		SetVehiclePosEx(GetPlayerVehicleID(playerid),x,y,z);
		PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),seatid);
		SetPlayerInterior(playerid,interior);
		SetPlayerVirtualWorld(playerid,world);
		SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),world);
		LinkVehicleToInterior(GetPlayerVehicleID(playerid),interior);
		format(string,sizeof(string),""IINFO" du hast dich zu den Coordinaten %.1f,%.1f,%.1f [Interiorid : %i][Virtuelle Welt: %i] geportet.",x,y,z,interior,world);
		SCM(playerid,SAMP_WEISS,string);
	}
	else
	{
		SetPlayerPosEx(playerid,x,y,z);
		SetPlayerInterior(playerid,interior);
		SetPlayerVirtualWorld(playerid,world);
		format(string,sizeof(string),""IINFO" du hast dich zu den Coordinaten %.1f,%.1f,%.1f [Interiorid : %i][Virtuelle Welt: %i] geportet.",x,y,z,interior,world);
		SCM(playerid,SAMP_WEISS,string);
	}
	return 1;
}

COMMAND:moviecamtime(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new time,string[128];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(sscanf(params,"i",time))return SCM(playerid,SAMP_WEISS,""#IINFO" /moviecamtime [Zeit in Sekunden]");
	if(time<1||time>300)return SCM(playerid,SAMP_WEISS,""#IINFO" /moviecamtime [Zeit in Sekunden 1-300]");
	format(string,sizeof(string),""IINFO" du hast den Camera Move auf %i Sekunden gestellt.",time);
	SCM(playerid,SAMP_WEISS,string);
	Spieler[playerid][FlyTime] = time*1000;
	return 1;
}

COMMAND:moviecam(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[20];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	if(sscanf(params,"s[20]",cmd))return SCM(playerid,SAMP_WEISS,""#IINFO" /moviecam [Fromcampos/Tocampos/Fromcamlockat/Tocamlockat/Start/Stop]");
	if(strcmp(cmd,"Fromcampos",true) == 0)
	{
		SCM(playerid,SAMP_WEISS,"Setze nun den Punkt wo die Camera hinfliegen soll.('Tocampos')");
		GetPlayerPos(playerid,Spieler[playerid][FlyXpos][0],Spieler[playerid][FlyYpos][0],Spieler[playerid][FlyZpos][0]);
	    Spieler[playerid][FlyInt] = GetPlayerInterior(playerid);
	    Spieler[playerid][FlyVirtualWorld] = GetPlayerVirtualWorld(playerid);
		return 1;
	}
	if(strcmp(cmd,"Tocampos",true) == 0)
	{
	    SCM(playerid,SAMP_WEISS,"Setze nun den Punkt wo die Camera hinschauen soll.('Fromcamlockat')");
		GetPlayerPos(playerid,Spieler[playerid][FlyXpos][1],Spieler[playerid][FlyYpos][1],Spieler[playerid][FlyZpos][1]);
	    Spieler[playerid][FlyInt] = GetPlayerInterior(playerid);
	    Spieler[playerid][FlyVirtualWorld] = GetPlayerVirtualWorld(playerid);
		return 1;
	}
	if(strcmp(cmd,"Fromcamlockat",true) == 0)
	{
	    SCM(playerid,SAMP_WEISS,"Setze nun den Punkt wo die Camera von der jetztigen Position hinschwenken soll.('Tocamlockat')");
		GetPlayerPos(playerid,Spieler[playerid][FlyXpos][2],Spieler[playerid][FlyYpos][2],Spieler[playerid][FlyZpos][2]);
	    Spieler[playerid][FlyInt] = GetPlayerInterior(playerid);
	    Spieler[playerid][FlyVirtualWorld] = GetPlayerVirtualWorld(playerid);
		return 1;
	}
	if(strcmp(cmd,"Tocamlockat",true) == 0)
	{
	    SCM(playerid,SAMP_WEISS,"Stelle nun den Camera Move ein. | Sprich wie lange die Camera fliegen soll.(/moviecamtime)");
		GetPlayerPos(playerid,Spieler[playerid][FlyXpos][3],Spieler[playerid][FlyYpos][3],Spieler[playerid][FlyZpos][3]);
	    Spieler[playerid][FlyInt] = GetPlayerInterior(playerid);
	    Spieler[playerid][FlyVirtualWorld] = GetPlayerVirtualWorld(playerid);
		return 1;
	}
	if(strcmp(cmd,"Start",true) == 0)
	{
		if(Spieler[playerid][FlyXpos][0] == 0 || Spieler[playerid][FlyXpos][1] == 0 || Spieler[playerid][FlyXpos][2] == 0 || Spieler[playerid][FlyXpos][3] == 0 || Spieler[playerid][FlyTime] == 0)return SCM(playerid,SAMP_WEISS,"Um eine Ordentliche Camera Bewegung hinzukriegen musst du die Anweisungen befolgen.");
	    SCM(playerid,SAMP_WEISS,"Die Camera fliegt die eingestellten Positionen ab. | 'Stop' um abzubrechen.");
		InterpolateCameraPos(playerid,Spieler[playerid][FlyXpos][0],Spieler[playerid][FlyYpos][0],Spieler[playerid][FlyZpos][0],Spieler[playerid][FlyXpos][1],Spieler[playerid][FlyYpos][1],Spieler[playerid][FlyZpos][1],Spieler[playerid][FlyTime],CAMERA_MOVE);
	    InterpolateCameraLookAt(playerid,Spieler[playerid][FlyXpos][2],Spieler[playerid][FlyYpos][2],Spieler[playerid][FlyZpos][2],Spieler[playerid][FlyXpos][3],Spieler[playerid][FlyYpos][3],Spieler[playerid][FlyZpos][3],Spieler[playerid][FlyTime],CAMERA_MOVE);
		return 1;
	}
	if(strcmp(cmd,"Stop",true) == 0)
	{
	    if(Spieler[playerid][FlyXpos][0] == 0 || Spieler[playerid][FlyXpos][1] == 0 || Spieler[playerid][FlyXpos][2] == 0 || Spieler[playerid][FlyXpos][3] == 0 || Spieler[playerid][FlyTime] == 0)return SCM(playerid,SAMP_WEISS,"Um eine Ordentliche Camera Bewegung hinzukriegen musst du die Anweisungen befolgen.");
		SCM(playerid,SAMP_WEISS,"Die Camera wurde gestoppt du landest an dem ersten Einstellungspunkt.");
		SetCameraBehindPlayer(playerid);
		SetPlayerPos(playerid,Spieler[playerid][FlyXpos][0],Spieler[playerid][FlyYpos][0],Spieler[playerid][FlyZpos][0]);
		SetPlayerInterior(playerid,Spieler[playerid][FlyInt]);
		SetPlayerVirtualWorld(playerid,Spieler[playerid][FlyVirtualWorld]);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""#IINFO" /moviecam [Fromcampos/Tocampos/Fromcamlockat/Tocamlockat/Start/Stop]");
}

COMMAND:marker(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[64],index = 0;
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    for(new markerid=0;markerid<MAX_ADMINMARKER;markerid++)
    {
	    if(Spieler[playerid][MarkerXpos][markerid] == 0.0 && Spieler[playerid][MarkerYpos][markerid] == 0.0 && Spieler[playerid][MarkerZpos][markerid] == 0.0)
	    {
			index++;
			if(IsPlayerInAnyVehicle(playerid))
			{
				GetVehiclePos(GetPlayerVehicleID(playerid),Spieler[playerid][MarkerXpos][markerid],Spieler[playerid][MarkerYpos][markerid],Spieler[playerid][MarkerZpos][markerid]);
			    Spieler[playerid][MarkerInt][markerid] = GetPlayerInterior(playerid);
				Spieler[playerid][MarkerVirtualWorld][markerid] = GetPlayerVirtualWorld(playerid);
				format(string,sizeof(string),""IINFO" du hast dir einen Marker[%i] erstellt.",markerid);
				SCM(playerid,SAMP_WEISS,string);
				SCM(playerid,SAMP_WEISS,""#IINFO" /gotomarker [Markerid]");
				return 1;
			}
			else
			{
				GetPlayerPos(playerid,Spieler[playerid][MarkerXpos][markerid],Spieler[playerid][MarkerYpos][markerid],Spieler[playerid][MarkerZpos][markerid]);
				Spieler[playerid][MarkerInt][markerid] = GetPlayerInterior(playerid);
				Spieler[playerid][MarkerVirtualWorld][markerid] = GetPlayerVirtualWorld(playerid);
				format(string,sizeof(string),""IINFO" du hast dir einen Marker[%i] erstellt.",markerid);
				SCM(playerid,SAMP_WEISS,string);
				SCM(playerid,SAMP_WEISS,""#HTML_BLAU"Verwendung:"#HTML_WEISS""#IINFO" /gotomarker [Markerid]");
				return 1;
			}
	    }
	}
	if(index == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast bereits 5 Marker erstellt.("#HTML_BLAU"Verwendung:"#HTML_WEISS" /delmarker [Markerid])");
	return 1;
}

COMMAND:delmarker(playerid,const params[])
{
	new string[128],markerid;
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(sscanf(params,"i",markerid))return SCM(playerid,SAMP_WEISS,""#IINFO" /delmarker [Markerid]");
    if(markerid >= MAX_ADMINMARKER)return SCM(playerid,SAMP_WEISS,""#IINFO" /delmarker [Markerid 0-4]");
	if(Spieler[playerid][MarkerXpos][markerid] == 0.0 && Spieler[playerid][MarkerYpos][markerid] == 0.0 && Spieler[playerid][MarkerZpos][markerid] == 0.0)
    {
    	return SCM(playerid,SAMP_WEISS,"Die Markerid ist nicht belegt!");
    }
    Spieler[playerid][MarkerXpos][markerid] = 0.0;
    Spieler[playerid][MarkerYpos][markerid] = 0.0;
    Spieler[playerid][MarkerZpos][markerid] = 0.0;
    Spieler[playerid][MarkerInt][markerid] = 0;
	Spieler[playerid][MarkerVirtualWorld][markerid] = 0;
	format(string,sizeof(string),""IINFO" du hast den Marker %i entfernt! Man kann sich nicht mehr zum Marker porten!",markerid);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}

COMMAND:gotomarker(playerid,const params[])
{
	new string[128],markerid;
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
    if(sscanf(params,"i",markerid))return SCM(playerid,SAMP_WEISS,""#IINFO" /gotomarker [Markerid]");
	if(markerid >= MAX_ADMINMARKER)return SCM(playerid,SAMP_WEISS,""#IINFO" /gotomarker [Markerid 0-4]");
	if(Spieler[playerid][MarkerXpos][markerid] == 0.0 && Spieler[playerid][MarkerYpos][markerid] == 0.0 && Spieler[playerid][MarkerZpos][markerid] == 0.0)
    {
    	return SCM(playerid,SAMP_WEISS,"Die Markerid ist nicht belegt!");
    }
    if(IsPlayerInAnyVehicle(playerid))
	{
		new seatid = GetPlayerVehicleSeat(playerid);
		SetPlayerPosEx(playerid,Spieler[playerid][MarkerXpos][markerid],Spieler[playerid][MarkerYpos][markerid],Spieler[playerid][MarkerZpos][markerid]);
		SetVehiclePosEx(GetPlayerVehicleID(playerid),Spieler[playerid][MarkerXpos][markerid],Spieler[playerid][MarkerYpos][markerid],Spieler[playerid][MarkerZpos][markerid]);
		PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),seatid);
		SetPlayerInterior(playerid,Spieler[playerid][MarkerInt][markerid]);
		SetPlayerVirtualWorld(playerid,Spieler[playerid][MarkerVirtualWorld][markerid]);
		LinkVehicleToInterior(GetPlayerVehicleID(playerid),Spieler[playerid][MarkerInt][markerid]);
		SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),Spieler[playerid][MarkerVirtualWorld][markerid]);
		format(string,sizeof(string),""IINFO" du hast dich zum Marker %i geportet!",markerid);
		SCM(playerid,SAMP_WEISS,string);
	}
	else
	{
		SetPlayerPosEx(playerid,Spieler[playerid][MarkerXpos][markerid],Spieler[playerid][MarkerYpos][markerid],Spieler[playerid][MarkerZpos][markerid]);
		SetPlayerInterior(playerid,Spieler[playerid][MarkerInt][markerid]);
		SetPlayerVirtualWorld(playerid,Spieler[playerid][MarkerVirtualWorld][markerid]);
		format(string,sizeof(string),""IINFO" du hast dich zum Marker %i geportet!",markerid);
		SCM(playerid,SAMP_WEISS,string);
	}
	return 1;
}

COMMAND:goto(playerid,const params[])
{
    new pID,string[128],Float:x,Float:y,Float:z;
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
    if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""#IINFO" /goto [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht zu dir teleportieren.");
	GetPlayerPos(pID,x,y,z);
	if(IsPlayerInAnyVehicle(playerid))
	{
		new seatid = GetPlayerVehicleSeat(playerid);
		SetPlayerPosEx(playerid,x,y + 4,z);
		SetVehiclePosEx(GetPlayerVehicleID(playerid),x,y + 4,z);
		PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),seatid);
		SetPlayerInterior(playerid,GetPlayerInterior(pID));
		SetPlayerVirtualWorld(playerid,GetPlayerVirtualWorld(pID));
		LinkVehicleToInterior(GetPlayerVehicleID(playerid),GetPlayerInterior(pID));
		SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),GetPlayerVirtualWorld(pID));
		format(string,sizeof(string),"%s hat sich zu dir geportet.",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dich zu %s geportet.",SpielerName(pID));
		SCM(playerid,SAMP_WEISS,string);
	}
	else
	{
		SetPlayerPosEx(playerid,x,y + 1,z);
		SetPlayerInterior(playerid,GetPlayerInterior(pID));
		SetPlayerVirtualWorld(playerid,GetPlayerVirtualWorld(pID));
		format(string,sizeof(string),"%s hat sich zu dir geportet.",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dich zu %s geportet.",SpielerName(pID));
		SCM(playerid,SAMP_WEISS,string);
	}
	return 1;
}

COMMAND:gethere(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
