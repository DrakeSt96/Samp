stock GetClosestVehicle(playerid,Float:max = 3.0)
{
	new Float:pos[3], id = -1, Float:temp;
	for(new v = 0; v <= MAX_VEHICLES; v++)
	{
		GetVehiclePos(v,pos[0],pos[1],pos[2]);
		temp = GetPlayerDistanceFromPoint(playerid,pos[0],pos[1],pos[2]);
		if(temp < max)
		{
			max = temp;
			id = v;
		}
	}
	return id;
}
stock ReturnSPRUNKID(playerid)
{
  	for(new i=0;i<MAX_SPRUNKS;i++)
  	{
	  	if(!IsPlayerInAnyVehicle(playerid))
	  	{
		   	if(IsPlayerInRangeOfPoint(playerid,1.5,Sprunk[i][_posx],Sprunk[i][_posy],Sprunk[i][_posz]))
			return i;
	    }
    }
	return -1;
}
