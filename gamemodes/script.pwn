						{
							if(BizInfo[biz][biz_art] == 12)//paintball
							{
								if(BizInfo[biz][biz_locked] == 1)return GameTextForPlayer(playerid,"~r~abgeschlossen!",1000,1);
								if((GetACMoney(playerid) - BizInfo[biz][biz_artikel][0]) < 0)
