stock ShowPlayerFahrzeug(playerid)
{
	strdel(edit_2,0,sizeof(edit_2));
	if(IsPlayerInAnyVehicle(playerid))
	{
		for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
			if(IsValidVehicle(Pfahrzeug[slot][playerid][Vehicle]))
			{
				if(Pfahrzeug[slot][playerid][Abgeschlossen] == 0){
					inforamtionen = ""#HTML_BLAU"1."#HTML_WEISS" Schloss Status: "#HTML_ROT"Aufgeschlossen\n";
					strcat(edit_2,inforamtionen);
				}else{
					inforamtionen = ""#HTML_BLAU"1."#HTML_WEISS" Schloss Status: "#HTML_GRUEN"Abgeschlossen\n";
					strcat(edit_2,inforamtionen);
				}
			}
			strcat(edit_2,""HTML_BLAU"2."HTML_WEISS" Fahrzeug Parken\n");
			strcat(edit_2,""HTML_BLAU"3."HTML_WEISS" Meine Fahrzeuge\n");
			strcat(edit_2,""HTML_BLAU"4."HTML_WEISS" Mein Fahrzeug verkaufen\n");
			format(SP_INFO,sizeof(SP_INFO),""ClanTagDialoge" Fahrzeug Control | "IINFO2"%s",VehicleDefinations[Pfahrzeug[slot][playerid][modelid]-400]);
			ShowPlayerDialog(playerid,DIALOG_PVEHS,DIALOG_STYLE_LIST,SP_INFO,edit_2,"Auswahl","Abbrechen");
			strdel(edit_2,0,sizeof(edit_2));
		}
 	}else{
		SCM(playerid,SAMP_WEISS,""IINFO" du musst im Fahrzeug sitzen.");
	}
	return 1;
}
