COMMAND:schild(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,16))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(Spieler[playerid][pArmouredbyASchild] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst keinen Schild mit dir!");
		if(Spieler[playerid][pWearedASchild] == 0)
		{
			Spieler[playerid][pWearedASchild] = 1;
			SCM(playerid,SAMP_WEISS,"* Du trägst nun einen Schild *");
            SetPlayerAttachedObject(playerid,3,18637,6,-0.040999,0.063999,-0.182000,92.200019,-1.700001,95.599998);
		}
		else if(Spieler[playerid][pWearedASchild] == 1)
		{
			Spieler[playerid][pWearedASchild] = 0;
			SCM(playerid,SAMP_WEISS,"* Schild abgenommen *");
			RemovePlayerAttachedObject(playerid,3);
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:dienstequip(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6))
	{
		if(gettime() > Spieler[playerid][DienstwaffeAntiSpam])
		{
			if(!FraktionsWaffenKammer(playerid))return SCM(playerid,SAMP_WEISS,"An keinem Ausrüstungspunkt.");
			if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
			if(isPlayerInFrakt(playerid,1))//sapd
			{
				if(Spieler[playerid][pWaffenLic] == 0 && Spieler[playerid][pArmyWaffenOrder] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Waffenschein!");
				Spieler[playerid][pTazer] = 1;
				Spieler[playerid][pTazerAkku] = 100;
			    Spieler[playerid][pTazerInorOutbag] = 0;
			    KillTimer(Spieler[playerid][pTazerTimer]);
				Spieler[playerid][pOrtungsgeraet] = 1;
			    Spieler[playerid][pFunkgeraet] = 1;
			    Spieler[playerid][pMegaphon] = 1;
			    Spieler[playerid][pArmouredbyASchild] = 1;
			    //SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Tazer,Ortungsgerät,Funkgerät,Schutzschild,Megaphon) wurde dir ausgehändigt.");
			}
			if(isPlayerInFrakt(playerid,2))//fbi
			{
				if(Spieler[playerid][pWaffenLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Waffenschein!");
				Spieler[playerid][pTazer] = 1;
				Spieler[playerid][pTazerAkku] = 100;
			    Spieler[playerid][pTazerInorOutbag] = 0;
			    KillTimer(Spieler[playerid][pTazerTimer]);
				Spieler[playerid][pOrtungsgeraet] = 1;
			    Spieler[playerid][pFunkgeraet] = 1;
			    Spieler[playerid][pMegaphon] = 1;
			    Spieler[playerid][pArmouredbyASchild] = 1;
			    //SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Tazer,Ortungsgerät,Funkgerät,Schutzschild,Megaphon) wurde dir ausgehändigt.");
			}
			if(isPlayerInFrakt(playerid,6))//army
			{
				if(Spieler[playerid][pWaffenLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Waffenschein!");
				Spieler[playerid][pTazer] = 1;
				Spieler[playerid][pTazerAkku] = 100;
			    Spieler[playerid][pTazerInorOutbag] = 0;
			    KillTimer(Spieler[playerid][pTazerTimer]);
				Spieler[playerid][pOrtungsgeraet] = 1;
			    Spieler[playerid][pFunkgeraet] = 1;
			    Spieler[playerid][pMegaphon] = 1;
			    Spieler[playerid][pArmouredbyASchild] = 1;
			    //SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Tazer,Ortungsgerät,Funkgerät,Schutzschild,Megaphon) wurde dir ausgehändigt.");
			}
			Spieler[playerid][DienstwaffeAntiSpam] = gettime() + (2*60);
			return 1;
		}
		new string[64],timestamp = Spieler[playerid][DienstwaffeAntiSpam]-gettime();
		format(string,sizeof(string),""IINFO" du kannst erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten ausrüsten.",timestamp/60,timestamp%60);
		return SCM(playerid,SAMP_WEISS,string);
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:dienstwaffe(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6))
	{
		if(gettime() > Spieler[playerid][DienstwaffeAntiSpam])
		{
			if(!FraktionsWaffenKammer(playerid))return SCM(playerid,SAMP_WEISS,"An keinem Ausrüstungspunkt.");
			if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
			if(isPlayerInFrakt(playerid,1))//sapd
			{
				if(Spieler[playerid][pWaffenLic] == 0 && Spieler[playerid][pArmyWaffenOrder] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Waffenschein!");
				Spieler[playerid][pTazer] = 1;
				Spieler[playerid][pTazerAkku] = 100;
			    Spieler[playerid][pTazerInorOutbag] = 0;
			    KillTimer(Spieler[playerid][pTazerTimer]);
				Spieler[playerid][pOrtungsgeraet] = 1;
			    Spieler[playerid][pFunkgeraet] = 1;
			    Spieler[playerid][pMegaphon] = 1;
			    Spieler[playerid][pArmouredbyASchild] = 1;
			    if(Spieler[playerid][pDuty] == 1)//normaler dienst
			    {
				    GiveWeapon(playerid,24,1000,false);
				    GiveWeapon(playerid,29,1000,false);
				    GiveWeapon(playerid,3,1,false);
				    GiveWeapon(playerid,41,2500,false);
				    ////SCM(playerid,SAMP_WEISS,"Deine Dienstwaffen(Deagle,MP5,Pfefferspray,Schlagstock) wurden dir ausgehändigt.");
				    ////SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Tazer,Ortungsgerät,Funkgerät,Schutzschild,Megaphon) wurde dir ausgehändigt.");
				    //SCM(playerid,SAMP_WEISS,"Mit dem Pfefferspray kannst du Spraytags von Gangs/Mafien entfernen,indem du diese eine Zeit lang ansprühst.");
			   	}
			    if(Spieler[playerid][pDuty] == 2)//zivil
			    {
				    GiveWeapon(playerid,24,1000,false);
				    GiveWeapon(playerid,29,1000,false);
				    GiveWeapon(playerid,3,1,false);
				    GiveWeapon(playerid,41,2500,false);
				    //SCM(playerid,SAMP_WEISS,"Deine Dienstwaffen(Deagle,MP5,Pfefferspray,Schlagstock) wurden dir ausgehändigt.");
				    //SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Tazer,Ortungsgerät,Funkgerät,Schutzschild,Megaphon) wurde dir ausgehändigt.");
				    //SCM(playerid,SAMP_WEISS,"Mit dem Pfefferspray kannst du Spraytags von Gangs/Mafien entfernen,indem du diese eine Zeit lang ansprühst.");
				}
			    if(Spieler[playerid][pDuty] == 3)//highway
			    {
				    GiveWeapon(playerid,24,1000,false);
				    GiveWeapon(playerid,29,1000,false);
				    GiveWeapon(playerid,3,1,false);
				    GiveWeapon(playerid,41,2500,false);
				    //SCM(playerid,SAMP_WEISS,"Deine Dienstwaffen(Deagle,MP5,Pfefferspray,Schlagstock) wurden dir ausgehändigt.");
				    //SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Tazer,Ortungsgerät,Funkgerät,Schutzschild,Megaphon) wurde dir ausgehändigt.");
				    //SCM(playerid,SAMP_WEISS,"Mit dem Pfefferspray kannst du Spraytags von Gangs/Mafien entfernen,indem du diese eine Zeit lang ansprühst.");
				}
			    if(Spieler[playerid][pDuty] == 4)//gsg9
			    {
				    GiveWeapon(playerid,24,1000,false);
				    GiveWeapon(playerid,25,1000,false);
				    GiveWeapon(playerid,29,1000,false);
				    GiveWeapon(playerid,31,1000,false);
				    GiveWeapon(playerid,34,120,false);
				    GiveWeapon(playerid,46,1,false);
				    SCM(playerid,SAMP_WEISS,"Deine Dienstwaffen(Deagle,MP5,Shotgun,Sniper,M4) wurden dir ausgehändigt.");
				    //SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Tazer,Ortungsgerät,Funkgerät,Schutzschild,Megaphon) wurde dir ausgehändigt.");
			    }
			}
			if(isPlayerInFrakt(playerid,2))//fbi
			{
				if(Spieler[playerid][pWaffenLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Waffenschein!");
				Spieler[playerid][pTazer] = 1;
				Spieler[playerid][pTazerAkku] = 100;
			    Spieler[playerid][pTazerInorOutbag] = 0;
			    KillTimer(Spieler[playerid][pTazerTimer]);
				Spieler[playerid][pOrtungsgeraet] = 1;
			    Spieler[playerid][pFunkgeraet] = 1;
			    Spieler[playerid][pMegaphon] = 1;
			    Spieler[playerid][pArmouredbyASchild] = 1;
				GiveWeapon(playerid,24,1000,false);
			    GiveWeapon(playerid,25,1000,false);
			    GiveWeapon(playerid,29,1000,false);
			    GiveWeapon(playerid,31,1000,false);
			    SCM(playerid,SAMP_WEISS,"Deine Dienstwaffen(Deagle,MP5,M4,Shotgun) wurden dir ausgehändigt.");
			    //SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Tazer,Ortungsgerät,Funkgerät,Schutzschild,Megaphon) wurde dir ausgehändigt.");
			}
			if(isPlayerInFrakt(playerid,3))//feuerwehr
			{
			    Spieler[playerid][pFunkgeraet] = 1;
				if(Spieler[playerid][pDuty] == 2)
				{
				    GiveWeapon(playerid,42,9000,false);
				    SCM(playerid,SAMP_WEISS,"Deine Dienstwaffen(Feuerlöscher) wurden dir ausgehändigt.");
				    SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Funkgerät) wurde dir ausgehändigt.");
			    }
			    else
			    {
				    GiveWeapon(playerid,41,2500,false);
				    SCM(playerid,SAMP_WEISS,"Deine Dienstwaffen(Spray) wurden dir ausgehändigt.");
				    SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Funkgerät) wurde dir ausgehändigt.");
			    }
			}
			if(isPlayerInFrakt(playerid,6))//army
			{
				if(Spieler[playerid][pWaffenLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Waffenschein!");
				Spieler[playerid][pTazer] = 1;
				Spieler[playerid][pTazerAkku] = 100;
			    Spieler[playerid][pTazerInorOutbag] = 0;
			    KillTimer(Spieler[playerid][pTazerTimer]);
				Spieler[playerid][pOrtungsgeraet] = 1;
			    Spieler[playerid][pFunkgeraet] = 1;
			    Spieler[playerid][pMegaphon] = 1;
			    Spieler[playerid][pArmouredbyASchild] = 1;
				GiveWeapon(playerid,24,1000,false);
			    GiveWeapon(playerid,25,1000,false);
			    GiveWeapon(playerid,29,1000,false);
			    GiveWeapon(playerid,31,1000,false);
			    GiveWeapon(playerid,34,120,false);
			    GiveWeapon(playerid,46,1,false);
			    SCM(playerid,SAMP_WEISS,"Deine Dienstwaffen(Deagle,MP5,Shotgun,M4,Fallschirm) wurden dir ausgehändigt.");
			    //SCM(playerid,SAMP_WEISS,"Dein Dienstequipment(Tazer,Ortungsgerät,Funkgerät,Schutzschild,Megaphon) wurde dir ausgehändigt.");
			}
			Spieler[playerid][DienstwaffeAntiSpam] = gettime() + (2*60);
			return 1;
		}
		new string[64],timestamp = Spieler[playerid][DienstwaffeAntiSpam]-gettime();
		format(string,sizeof(string),""IINFO" du kannst erst wieder in "IINFO2"%i:%02d"#HTML_WEISS" Minuten ausrüsten.",timestamp/60,timestamp%60);
		return SCM(playerid,SAMP_WEISS,string);
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:finvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,3))
	{
 		if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		new pID,stringuninv[128],fraktname[25];
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /finvite [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	 	if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler ist nicht in deiner Fraktion.");
		if(Spieler[pID][pFraktABTInvite] == 1)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits in einer Abteilung.");
		switch(Spieler[playerid][pFraktion])
		{
		    case 1:{fraktname="SWAT";}
		    case 3:{fraktname="Feuerwehr";}
			default:{fraktname="ERROR";}
	    }
		format(stringuninv,sizeof(stringuninv),""IINFO" du hast %s in die Abteilung %s eingewiesen.",SpielerName(pID),fraktname);
	  	SCM(playerid,SAMP_WEISS,stringuninv);
		format(stringuninv,sizeof(stringuninv),""IINFO" du wurdest vom Leader %s aus in die Abteilung %s eingewiesen.",SpielerName(playerid),fraktname);
	 	SCM(pID,SAMP_WEISS,stringuninv);
	  	Spieler[pID][pFraktABTInvite] = 1;
	  	return 1;
 	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:allowsperrzone(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerInFrakt(playerid,6))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	new pID,stringuninv[128];
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /allowsperrzone [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
 	if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler ist in deiner Fraktion.");
	if(Spieler[pID][pAllowSperrZone] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" der Spieler besitzt bereits die Erlaubnis in die Sperrzone einzutreten.");
	format(stringuninv,sizeof(stringuninv),""IINFO" du hast %s die Erlaubnis erteilt die Sperrzone zu betreten.",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,stringuninv);
	format(stringuninv,sizeof(stringuninv),"%s %s hat dir die Erlaubnis erteilt die Sperrzone zu betreten.",SpielerFraktionsRangName(playerid),SpielerName(playerid));
	SCM(pID,SAMP_WEISS,stringuninv);
	format(stringuninv,sizeof(stringuninv),"%s %s hat %s die Erlaubnis erteilt die Sperrzone zu betreten.",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
	SendFraktionsMessage(Spieler[playerid][pFraktion],DUNKELGRUEN,stringuninv);
	Spieler[pID][pAllowSperrZone] = 1;
	return 1;
}

COMMAND:delsperrzone(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerInFrakt(playerid,6))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	new pID,stringuninv[128];
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /allowsperrzone [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
 	if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler ist in deiner Fraktion.");
	if(Spieler[pID][pAllowSperrZone] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Spieler besitzt keine Erlaubnis in die Sperrzone einzutreten.");
	format(stringuninv,sizeof(stringuninv),""IINFO" du hast %s die Erlaubnis die Sperrzone zu betreten entzogen.",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,stringuninv);
	format(stringuninv,sizeof(stringuninv),"%s %s hat dir die Erlaubnis die Sperrzone zu betreten entzogen.",SpielerFraktionsRangName(playerid),SpielerName(playerid));
	SCM(pID,SAMP_WEISS,stringuninv);
	format(stringuninv,sizeof(stringuninv),"%s %s hat %s die Erlaubnis die Sperrzone zu betreten entzogen.",SpielerFraktionsRangName(playerid),SpielerName(playerid),SpielerName(pID));
	SendFraktionsMessage(Spieler[playerid][pFraktion],DUNKELGRUEN,stringuninv);
	Spieler[pID][pAllowSperrZone] = 0;
	return 1;
}

COMMAND:setbwunit(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,6))
	{
		if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		new pID,stringuninv[128],fraktname[25],unit;
		if(sscanf(params,"ui",pID,unit))return SCM(playerid,SAMP_WEISS,""IINFO" /bwunit [playerid/Name] [Unit 0-3]");
		if(unit<0||unit>3)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur eine Abteilung von 0-3 wählen.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	 	if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler ist nicht in deiner Fraktion.");
	 	if(unit > 0)
	 	{
			if(Spieler[pID][pFraktABTInvite] > 0)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits in einer Abteilung.");
			switch(unit)
			{
			    case 0:{fraktname="Army";}
			    case 1:{fraktname="Airforce";}
			    case 2:{fraktname="Navy";}
			    case 3:{fraktname="Ranger";}
				default:{fraktname="ERROR";}
		    }
			format(stringuninv,sizeof(stringuninv),""IINFO" du hast %s in die Abteilung %s eingewiesen.",SpielerName(pID),fraktname);
		  	SCM(playerid,SAMP_WEISS,stringuninv);
			format(stringuninv,sizeof(stringuninv),""IINFO" du wurdest vom Leader %s aus in die Abteilung %s eingewiesen.",SpielerName(playerid),fraktname);
		 	SCM(pID,SAMP_WEISS,stringuninv);
		  	Spieler[pID][pFraktABTInvite] = unit;
		  	Spieler[pID][pFraktURang] = 1;
		}
		else
		{
			switch(unit)
			{
			    case 0:{fraktname="Army";}
			    case 1:{fraktname="Airforce";}
			    case 2:{fraktname="Navy";}
			    case 3:{fraktname="Ranger";}
				default:{fraktname="ERROR";}
		    }
			format(stringuninv,sizeof(stringuninv),""IINFO" du hast %s in die Abteilung %s eingewiesen.",SpielerName(pID),fraktname);
		  	SCM(playerid,SAMP_WEISS,stringuninv);
			format(stringuninv,sizeof(stringuninv),""IINFO" du wurdest vom Leader %s aus in die Abteilung %s eingewiesen.",SpielerName(playerid),fraktname);
		 	SCM(pID,SAMP_WEISS,stringuninv);
		  	Spieler[pID][pFraktABTInvite] = unit;
		  	Spieler[pID][pFraktURang] = 1;
		}
	  	return 1;
 	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:funinvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,3))
	{
	    if(!isPlayerAMember(playerid,6))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		new pID,stringuninv[128],fraktname[64];
		if(sscanf(params,"u",pID)) return SCM(playerid,SAMP_WEISS,""IINFO" /funinvite [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	 	if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler ist nicht in deiner Fraktion.");
		if(Spieler[pID][pFraktABTInvite] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist in keiner Abteilung.");
		switch(Spieler[pID][pFraktion])
		{
		    case 1:{fraktname="SWAT";}
		    case 3:{fraktname="Feuerwehr";}
			default:{fraktname="ERROR";}
	    }
		format(stringuninv,sizeof(stringuninv),""IINFO" du hast %s in die Abteilung %s ausgewiesen.",SpielerName(pID),fraktname);
	  	SCM(playerid,SAMP_WEISS,stringuninv);
		format(stringuninv,sizeof(stringuninv),""IINFO" du wurdest vom Leader %s aus in die Abteilung %s ausgewiesen.",SpielerName(playerid),fraktname);
	 	SCM(pID,SAMP_WEISS,stringuninv);
	  	Spieler[pID][pFraktABTInvite] = 0;
	  	return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:bwunitduty(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(isPlayerInFrakt(playerid,6))
	{
	    if(!FraktionsDuty(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier nicht in/aus den Dienst gehen.");
		if(Spieler[playerid][pDuty] == 1 || Spieler[playerid][pDuty] == 2)return SCM(playerid,SAMP_WEISS,""IINFO" du musst erst Offduty sein.");
		if(Spieler[playerid][pFraktABTInvite] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist in keiner Abteilung.");
		if(Spieler[playerid][pDuty] == 0)
		{
		    if(Spieler[playerid][pFraktABTInvite] == 1)
		    {
		        SCM(playerid,SAMP_WEISS,"BW UNIT: Airforce");
		        Spieler[playerid][pDuty] = 3;
		        format(string,sizeof(string),"%s ist nun als 'Airforce' im Dienst.",SpielerName(playerid));
				SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
		    }
		    else if(Spieler[playerid][pFraktABTInvite] == 2)
		    {
		        SCM(playerid,SAMP_WEISS,"BW UNIT: Navy");
				Spieler[playerid][pDuty] = 4;
				format(string,sizeof(string),"%s ist nun als 'Navy' im Dienst.",SpielerName(playerid));
				SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
				Spieler[playerid][pHaveMaske] = 1;
			}
			else if(Spieler[playerid][pFraktABTInvite] == 3)
		    {
		        SCM(playerid,SAMP_WEISS,"BW UNIT: Ranger");
				Spieler[playerid][pDuty] = 5;
				format(string,sizeof(string),"%s ist nun als 'Ranger' im Dienst.",SpielerName(playerid));
				SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
				Spieler[playerid][pHaveMaske] = 1;
			}
			SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
			SetPlayerColor(playerid,BUNDESWEHR_FARBEN_CODE);
			SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Dienst.");
			format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			//SCM(playerid,SAMP_WEISS,"Info: Der Staat übernimmt den Preis für das waschen deiner Kleidung. ( 50$ pro Kleidungswechsel. )");
   			fverwaltungen[16][Geld] -= 50;
		}
		else
		{
  			ResetWeapons(playerid,false);
			for(new slot=0;slot<13;slot++)
			{
				if(Spieler[playerid][pPlayerWeapon][slot] != WEAPON_FIST && Spieler[playerid][pPlayerWeaponAmmo][slot] != 0)
				{
					GiveWeapon(playerid,Spieler[playerid][pPlayerWeapon][slot],Spieler[playerid][pPlayerWeaponAmmo][slot],false);
				}
			}
			Spieler[playerid][pTazer] = 0;
			Spieler[playerid][pTazerAkku] = 0;
   			Spieler[playerid][pTazerInorOutbag] = 0;
		 	KillTimer(Spieler[playerid][pTazerTimer]);
			Spieler[playerid][pTazerAkku] = 0;
   			Spieler[playerid][pTazerInorOutbag] = 0;
			Spieler[playerid][pOrtungsgeraet] = 0;
  			Spieler[playerid][pFunkgeraet] = 0;
   			Spieler[playerid][pMegaphon] = 0;
   			Spieler[playerid][pArmouredbyASchild] = 0;
   			Spieler[playerid][pHaveMaske] = 0;
			SetPlayerColor(playerid,SAMP_WEISS);
			RemovePlayerAttachedObject(playerid,4);
			SetPlayerArmour(playerid, 0.0);
			SetPlayerSkin(playerid,Spieler[playerid][pSkin]);
			format(string,sizeof(string),"** %s zieht seine Dienstkleidung aus und geht aus dem Dienst **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			Spieler[playerid][pDuty] = 0;
		}
		return 1;
 	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:duty(playerid,params[])//normales duty für sapd,San Andreas Rettungsdienst/feuewehr,fbi,army,ordnungsamt,san andreas news
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15))
	{
	    if(!FraktionsDuty(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier nicht in/aus den Dienst gehen.");
		if(Spieler[playerid][pDuty] > 1)return SCM(playerid,SAMP_WEISS,""IINFO" du musst erst Offduty sein.");
		if(Spieler[playerid][pDuty] == 0)
		{
			if(isPlayerInFrakt(playerid,1))
			{
				SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
				SetPlayerColor(playerid,SAPD_FARBEN_CODE);
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Dienst.");
				Spieler[playerid][pDuty] = 1;
				format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				//SCM(playerid,SAMP_WEISS,"Info: Der Staat übernimmt den Preis für das waschen deiner Kleidung. ( 50$ pro Kleidungswechsel. )");
			    fverwaltungen[16][Geld] -= 50;
			}
			if(isPlayerInFrakt(playerid,2))
			{
				SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
				SetPlayerColor(playerid,CSI_FARBEN_CODE);
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Dienst.");
				Spieler[playerid][pDuty] = 1;
				format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			    //SCM(playerid,SAMP_WEISS,"Info: Der Staat übernimmt den Preis für das waschen deiner Kleidung. ( 50$ pro Kleidungswechsel. )");
			    fverwaltungen[16][Geld] -= 50;
			}
			if(isPlayerInFrakt(playerid,3))
			{
				Spieler[playerid][pFunkgeraet] = 1;
				SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
				SetPlayerColor(playerid,MEDICAL_FARBEN_CODE);
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Dienst.");
				ResetWeapons(playerid,false);
				Spieler[playerid][pDuty] = 1;
				format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				//SCM(playerid,SAMP_WEISS,"Info: Der Staat übernimmt den Preis für das waschen deiner Kleidung. ( 50$ pro Kleidungswechsel. )");
			    fverwaltungen[16][Geld] -= 50;
			}
			if(isPlayerInFrakt(playerid,6))
			{
				SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
				SetPlayerColor(playerid,BUNDESWEHR_FARBEN_CODE);
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Dienst.");
				Spieler[playerid][pDuty] = 1;
				format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				//SCM(playerid,SAMP_WEISS,"Info: Der Staat übernimmt den Preis für das waschen deiner Kleidung. ( 50$ pro Kleidungswechsel. )");
			    fverwaltungen[16][Geld] -= 50;
			}
			if(isPlayerInFrakt(playerid,10))
			{
				SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
				SetPlayerColor(playerid,NEWS_FARBEN_CODE);
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Dienst.");
				Spieler[playerid][pDuty] = 1;
				ResetWeapons(playerid,false);
				format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			}
			if(isPlayerInFrakt(playerid,11))
			{
				Spieler[playerid][pFunkgeraet] = 1;
				SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
				SetPlayerColor(playerid,ADAC_FARBEN_CODE);
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Dienst.");
				Spieler[playerid][pDuty] = 1;
				ResetWeapons(playerid,false);
				GiveWeapon(playerid,41,1000,false);
				GiveWeapon(playerid,3,1,false);
				format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				//SCM(playerid,SAMP_WEISS,"Info: Der Staat übernimmt den Preis für das waschen deiner Kleidung. ( 50$ pro Kleidungswechsel. )");
			    //SCM(playerid,SAMP_WEISS,"Mit dem Pfefferspray kannst du Spraytags von Gangs/Mafien entfernen,indem du diese eine Zeit lang ansprühst.");
			    fverwaltungen[16][Geld] -= 50;
			}
			if(isPlayerInFrakt(playerid,14))
			{
				SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
				format(string,sizeof(string),""#HTML_ORANGE"Fahrschuke Kloppenberg"#HTML_WEISS": %s ist als Fahrlehrer Online gegangen.",SpielerName(playerid));
				SendClientMessageToAll(SAMP_WEISS,string);
				SetPlayerColor(playerid,FAHRLERHER_FARBEN_CODE);
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Dienst.");
				ResetWeapons(playerid,false);
				GiveWeapon(playerid,41,500,false);
				Spieler[playerid][pDuty] = 1;
				format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				//fSCHULleher[playerid] = CreateDynamic3DTextLabel("Fahrlehrer", FAHRSCHULEDUTY,30.0,40.0,50.0, MAX_STREAM_NAME_DISTANCE, playerid);
				//Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL,fSCHULleher[playerid],E_STREAMER_ATTACH_OFFSET_Z,0.4);
			}
			if(isPlayerInFrakt(playerid,15))
			{
				SetPlayerSkin(playerid,Spieler[playerid][pFraktSkin]);
				SetPlayerColor(playerid,ELEKTRIKER_FARBEN_CODE);
				SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Dienst.");
				Spieler[playerid][pDuty] = 1;
				ResetWeapons(playerid,false);
				format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			}
			return 1;
		}
		else if(Spieler[playerid][pDuty] == 1)
		{
			if(isPlayerInFrakt(playerid,14))
			{
				format(string,sizeof(string),"** Fahrlehrer %s ist nun nicht mehr im Dienst **",SpielerName(playerid));
				SendClientMessageToAll(FAHRSCHULEDUTY,string);
				if(IsValidDynamic3DTextLabel(fSCHULleher[playerid])) DestroyDynamic3DTextLabel(fSCHULleher[playerid]);
			}
			ResetWeapons(playerid,false);
			for(new slot=0;slot<13;slot++)
			{
				if(Spieler[playerid][pPlayerWeapon][slot] != WEAPON_FIST && Spieler[playerid][pPlayerWeaponAmmo][slot] != 0)
				{
					GiveWeapon(playerid,Spieler[playerid][pPlayerWeapon][slot],Spieler[playerid][pPlayerWeaponAmmo][slot],false);
				}
			}
			Spieler[playerid][pTazer] = 0;
			Spieler[playerid][pTazerAkku] = 0;
		    Spieler[playerid][pTazerInorOutbag] = 0;
		    KillTimer(Spieler[playerid][pTazerTimer]);
			Spieler[playerid][pTazerAkku] = 0;
		    Spieler[playerid][pTazerInorOutbag] = 0;
			Spieler[playerid][pOrtungsgeraet] = 0;
		    Spieler[playerid][pFunkgeraet] = 0;
		    Spieler[playerid][pMegaphon] = 0;
		    Spieler[playerid][pArmouredbyASchild] = 0;
			SetPlayerColor(playerid,SAMP_WEISS);
			RemovePlayerAttachedObject(playerid,4);
			SetPlayerArmour(playerid, 0.0);
			SetPlayerSkin(playerid,Spieler[playerid][pSkin]);
			format(string,sizeof(string),"** %s zieht seine Dienstkleidung aus und geht aus dem Dienst **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			Spieler[playerid][pDuty] = 0;
			return 1;
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:zivilduty(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6))
    {
	    if(!FraktionsDuty(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier nicht in den Dienst gehen.");
		if(Spieler[playerid][pDuty] == 0 || Spieler[playerid][pDuty] == 2)
		{
			if(Spieler[playerid][pDuty] == 0)
			{
			    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2))
			    {
					new rskin = random(6);
				   	switch(rskin)
				   	{
					    case 0: SetPlayerSkin(playerid,250);
					    case 1: SetPlayerSkin(playerid,240);
					    case 2: SetPlayerSkin(playerid,217);
					    case 3: SetPlayerSkin(playerid,188);
					    case 4: SetPlayerSkin(playerid,185);
					    case 5: SetPlayerSkin(playerid,180);
					}
					Spieler[playerid][pDuty] = 2;
					SetPlayerColor(playerid,SAMP_WEISS);
					SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Zivil-Dienst.");
					format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
					PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				}
				else if(isPlayerInFrakt(playerid,6))
				{
				    if(Spieler[playerid][pMaske] != 0)
				    {
						Spieler[playerid][pMaske] = 0;
						SetPlayerName(playerid,Spieler[playerid][pName]);
						SetPlayerScore(playerid,GetPlayerLevel(playerid));
						RemovePlayerAttachedObject(playerid,1);
					}
				    new rskin = random(6);
				   	switch(rskin)
				   	{
					    case 0: SetPlayerSkin(playerid,250);
					    case 1: SetPlayerSkin(playerid,240);
					    case 2: SetPlayerSkin(playerid,217);
					    case 3: SetPlayerSkin(playerid,188);
					    case 4: SetPlayerSkin(playerid,185);
					    case 5: SetPlayerSkin(playerid,180);
					}
					Spieler[playerid][pHaveMaske] = 1;
					Spieler[playerid][pDuty] = 2;
					SetPlayerColor(playerid,SAMP_WEISS);
					SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Zivil-Dienst.");
					format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
					PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				}
			}
			else if(Spieler[playerid][pDuty] == 2)
			{
				ResetWeapons(playerid,false);
				for(new slot=0;slot<13;slot++)
				{
					if(Spieler[playerid][pPlayerWeapon][slot] != WEAPON_FIST && Spieler[playerid][pPlayerWeaponAmmo][slot] != 0)
					{
						GiveWeapon(playerid,Spieler[playerid][pPlayerWeapon][slot],Spieler[playerid][pPlayerWeaponAmmo][slot],false);
					}
				}
				Spieler[playerid][pTazer] = 0;
				Spieler[playerid][pTazerAkku] = 0;
			    Spieler[playerid][pTazerInorOutbag] = 0;
			    KillTimer(Spieler[playerid][pTazerTimer]);
				Spieler[playerid][pOrtungsgeraet] = 0;
			    Spieler[playerid][pFunkgeraet] = 0;
			    Spieler[playerid][pArmouredbyASchild] = 0;
				SetPlayerColor(playerid,SAMP_WEISS);
				RemovePlayerAttachedObject(playerid,4);
				SetPlayerSkin(playerid,Spieler[playerid][pSkin]);
				format(string,sizeof(string),"** %s zieht seine Dienstkleidung aus und geht aus dem Dienst **",SpielerName(playerid));
				PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				Spieler[playerid][pDuty] = 0;
			}
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du musst erst Offduty sein!");
	}
    return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:highwayduty(playerid,params[])//autobahnpolizeiduty
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(!isPlayerInFrakt(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(!FraktionsDuty(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier nicht in/aus den Dienst gehen.");
	if(Spieler[playerid][pDuty] == 0 || Spieler[playerid][pDuty] == 3)
	{
	    if(Spieler[playerid][pDuty] == 0)
		{
		    SetPlayerSkin(playerid,284);
			Spieler[playerid][pDuty] = 3;
			SetPlayerColor(playerid,SAPDDUTY);
			SCM(playerid,SAMP_WEISS,""IINFO" du bist nun im Autobahn-Patroll-Dienst.");
			format(string,sizeof(string),"** %s zieht seine Dienstkleidung an und geht in den Dienst **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		}
		else if(Spieler[playerid][pDuty] == 3)
		{
			ResetWeapons(playerid,false);
			for(new slot=0;slot<13;slot++)
			{
				if(Spieler[playerid][pPlayerWeapon][slot] != WEAPON_FIST && Spieler[playerid][pPlayerWeaponAmmo][slot] != 0)
				{
					GiveWeapon(playerid,Spieler[playerid][pPlayerWeapon][slot],Spieler[playerid][pPlayerWeaponAmmo][slot],false);
				}
			}
			Spieler[playerid][pTazer] = 0;
			Spieler[playerid][pTazerAkku] = 0;
		    Spieler[playerid][pTazerInorOutbag] = 0;
		    KillTimer(Spieler[playerid][pTazerTimer]);
			Spieler[playerid][pOrtungsgeraet] = 0;
		    Spieler[playerid][pFunkgeraet] = 0;
		    Spieler[playerid][pMegaphon] = 0;
		    Spieler[playerid][pArmouredbyASchild] = 0;
			SetPlayerColor(playerid,SAMP_WEISS);
			RemovePlayerAttachedObject(playerid,4);
			SetPlayerSkin(playerid,Spieler[playerid][pSkin]);
			format(string,sizeof(string),"** %s zieht seine Dienstkleidung aus und geht aus dem Dienst **",SpielerName(playerid));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			Spieler[playerid][pDuty] = 0;
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du musst erst Offduty sein!");
}
COMMAND:swatduty(playerid,params[])//swatduty
