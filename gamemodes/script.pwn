				    ShowPlayerDialog(playerid,SMARK_MENU_GELD_EINZAHLEN,DIALOG_STYLE_INPUT,"Schwarzmarkt (Einzahlung von Geld)",string,"Einzahlen","Zurück");
					return 1;
				}
				if(!IsNumeric(inputtext))
				{
					format(string,sizeof(string),"Kassenstand(Geld): %i$\nGeld auf der Hand: %i$\nGib bitte den Betrag an Geld ein den du in die Schwarzmarktkasse einzahlen möchtest:",SmarkInfo[sm][skasse],GetACMoney(playerid));
				    ShowPlayerDialog(playerid,SMARK_MENU_GELD_EINZAHLEN,DIALOG_STYLE_INPUT,"Schwarzmarkt (Einzahlung von Geld)",string,"Einzahlen","Zurück");
					return 1;
				}
				else
				{
					if((GetACMoney(playerid) - Menge) < 0)
					{
						format(string,sizeof(string),"Kassenstand(Geld): %i$\nGeld auf der Hand: %i$\nGib bitte den Betrag an Geld ein den du in die Schwarzmarktkasse einzahlen möchtest:",SmarkInfo[sm][skasse],GetACMoney(playerid));
					    ShowPlayerDialog(playerid,SMARK_MENU_GELD_EINZAHLEN,DIALOG_STYLE_INPUT,"Schwarzmarkt (Einzahlung von Geld)",string,"Einzahlen","Zurück");
						return SCM(playerid,SAMP_WEISS,"Nicht genug Geld dabei.");
					}
					SmarkInfo[sm][skasse] += Menge;
					ACMoney(playerid,-Menge);
					format(string,sizeof(string),""IINFO" du hast %i$ in die Schwarzmarktkasse eingezahlt! Kassenstand(Geld): %d$",Menge,SmarkInfo[sm][skasse]);
					SCM(playerid,SAMP_WEISS,string);
