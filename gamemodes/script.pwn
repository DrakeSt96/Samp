		if(Spieler[playerid][pFunkgeraet] != 0 || fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		{
			if(Spieler[playerid][pMuted] == 1)
			{
		    format(stringdep,sizeof(stringdep),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
			return SCM(playerid,WEISS,stringdep);
			}
			if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /ex(executeivenchat) [Text]");
			if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /ex(executeivenchat) [Text darf maximal 90 Zeichen beinhalten]");
			for(new b=0;b<sizeof(BadWord);b++)
			{
			if(strfind(text,BadWord[b],true) != -1)
		  	{
		  	format(stringdep,sizeof(stringdep),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,stringdep);
			format(stringdep,sizeof(stringdep),"Beleidigung: %s | %s | Art: /ex(ecutivenchat)",BadWord[b],text);
			SendAdminMessage(SAMP_WEISS,stringdep);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
		    }
			}
			new strpos = strfind(text,"www",true);
			if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
			{
				strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
				return 1;
			}
			format(stringdep,sizeof(stringdep),"**(( %s %s : %s )) **",SpielerFraktionsRangName(playerid),SpielerName(playerid),text);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(GetPVarInt(i,"Eingeloggt") == 1)
					{
						if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,16))
						{
							if(Spieler[i][pDuty] != 0)
							{
								if(Spieler[i][pFunkgeraet] == 1 || (IsAFraktionsVeh(i) != -1 && Fahrzeug[IsAFraktionsVeh(i)][Fraktion] == Spieler[i][pFraktion]) || FraktionsAktenPCs(i))
								{
									SCM(i,EXECUTIVCHATCOLOR,stringdep);
								}
							}
						}
						if(Spieler[i][IreadALL] == 1)
						{
							SCM(i,SAMP_WEISS,stringdep);
						}
					}
				}
			}
			format(stringdep,sizeof(stringdep),"%s %s: %s",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],text);
		 	Log("Executeiven-Chatsqllog",stringdep);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,"Kein Funkgerät/Du sitzt in keinem Fraktionsfahrzeug.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:radarpistole(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:x,Float:y,Float:z,string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,14))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
		GetPlayerPos(playerid,x,y,z);
	    ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(playerid != i)
			  	{
					if(IsPlayerInAnyVehicle(i) && GetPlayerVehicleSeat(i) == 0)
					{
					   	if(IsPlayerInRangeOfPoint(i,50,x,y,z))
					   	{
							PlayerHearMusicInRange(x,y,z,1132,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
							format(string,sizeof(string),"* Geschwindigkeit von einem %s gemessen | Fahrer %s (ID:%i) | %i Km/h",VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(i))-400],SpielerName(i),i,GetVehicleSpeed(GetPlayerVehicleID(i)));
						    SCM(playerid,SAMP_WEISS,string);
						    format(string,sizeof(string),"%i Km/h gemessen",GetVehicleSpeed(GetPlayerVehicleID(i)));
						    GameTextForPlayer(playerid,string,6000,1);
						    format(string,sizeof(string),"** %s holt seine Radarpistole raus und misst die Geschwindigkeit von einem %s **",SpielerName(playerid),VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(i))-400]);
							PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
							return 1;
						}
					}
				}
			}
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Fahrzeuges das sich bewegt.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:blitzerinfo(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],counter = 0;
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,11))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst..");
		SCM(playerid,SAMP_WEISS,"||_________Blitzer in San Andreas_________||");
	    for(new i=0;i<MAX_BLITZER;i++)
		{
			if(Blitzer[i][Erstellt] == 1)
			{
				format(string,sizeof(string),"Blitzer %i : Richtgeschwindigkeit %i Km/h : Angegebenner Ort %s : Zustand %i",i,Blitzer[i][BlitzerGeschwindigkeit],Blitzer[i][BlitzerOrt],Blitzer[i][EGmBhHp]);
				SCM(playerid,SAMP_WEISS,string);
				counter++;
			}
	  	}
	  	if(counter == 0)return SCM(playerid,SAMP_WEISS,"Es wurde keine Blitzer errichtet.");
	  	return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:addtmast(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerInFrakt(playerid,15))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(GetPlayerInterior(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Telefonmasten aufstellen!");
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
    if(TMastenCount() == MAX_MASTEN)return SCM(playerid,SAMP_WEISS,"Es wurde bereits die maximal Anzahl an Funkmasten erstellt!");
    if(ReturnHempfangRate(playerid) != -1)return SCM(playerid,SAMP_WEISS,"Es befindet sich schon im Umkreis von 600 Metern ein Funkmast.");
	if((fverwaltungen[Spieler[playerid][pFraktion]][Geld] - MAX_TMASTENPRICE) < 0)return SCM(playerid,SAMP_WEISS,"Eure Fraktionskasse besitzt nicht so viel Geld.("#MAX_TMASTENPRICE"$)");
	CreateTmasten(playerid);
  	return 1;
}
COMMAND:deltmast(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerInFrakt(playerid,15))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
	DeleteTMasten(playerid);
  	return 1;
}
COMMAND:repairtmast(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new msten = ReturnTMastenID(playerid),string[128];
	if(!isPlayerInFrakt(playerid,15))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	//if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(msten == -1)return SCM(playerid,SAMP_WEISS,"An keinem Funkmasten!");
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
	if(FMastenInfo[msten][EGmBhHp] >= 50)return SCM(playerid,SAMP_WEISS,"Funkmast muss noch nicht gewartet werden.");
    format(string,sizeof(string),"** %s repariert einen Funkmast **",SpielerName(playerid));
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
	FMastenInfo[msten][EGmBhTstamp] = gettime() + ((random(10) + 10)*60);
	new oldmstenhp = FMastenInfo[msten][EGmBhHp];
	FMastenInfo[msten][EGmBhHp] = 100;
	OnePlayAnim(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
    format(string,sizeof(string),"%s (ID:%i) hat einen Funkmast repariert. | Die Fraktion erhält %i$ vom Staat.",SpielerName(playerid),playerid,FMastenInfo[msten][EGmBhHp]-oldmstenhp);
	SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	fverwaltungen[Spieler[playerid][pFraktion]][Geld] += (FMastenInfo[msten][EGmBhHp]-oldmstenhp);
	fverwaltungen[16][Geld] -= (FMastenInfo[msten][EGmBhHp]-oldmstenhp);
	DestroyDynamicObject(FMastenInfo[msten][EGmBhRubbishObject]);
	DestroyDynamic3DTextLabel(FMastenInfo[msten][RubLabel]);
	FMastenInfo[msten][RubLabel] = INVALID_3D_TEXT;
	return 1;
}
COMMAND:empfangsrate(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerInFrakt(playerid,15))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(TMastenCount() == 0)return SCM(playerid,SAMP_WEISS,"Es wurden keine Funkmasten errichtet.");
	if(Spieler[playerid][ShowNetworks] == 0)
	{
		for(new msten=0;msten<MAX_MASTEN;msten++)
		{
			if(FMastenInfo[msten][Erstellt] == 1)
			{
				if(FMastenInfo[msten][EGmBhHp] > 0)
				{
					GangZoneShowForPlayer(playerid,FMastenInfo[msten][EGmBhMastenZone],0xB9FF006A);
				}
				else GangZoneShowForPlayer(playerid,FMastenInfo[msten][EGmBhMastenZone],0xFF64009F);
			}
		}
		SCM(playerid,SAMP_WEISS,"Die Funkreichweite der Funkmasten wird auf deiner Karte in Zonen angezeigt.");
		Spieler[playerid][ShowNetworks] = 1;
	}
	else if(Spieler[playerid][ShowNetworks] == 1)
	{
		for(new msten=0;msten<MAX_MASTEN;msten++)
		{
			if(FMastenInfo[msten][Erstellt] == 1) GangZoneHideForPlayer(playerid,FMastenInfo[msten][EGmBhMastenZone]);
		}
		SCM(playerid,SAMP_WEISS,"Funkreichweitenansicht ausgeschaltet.");
		Spieler[playerid][ShowNetworks] = 0;
	}
	return 1;
}
COMMAND:repairinfo(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
    if(!isPlayerInFrakt(playerid,15))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	ShowPlayerTechnikerMenu(playerid);
	return 1;
