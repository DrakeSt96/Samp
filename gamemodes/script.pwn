public OnVehicleMod(playerid,vehicleid,componentid)
{
    new string[256];
    if((componentid<1000||componentid>1193 && GetPlayerInterior(playerid) == 0) && !isPlayerAnAdmin(playerid,1))//gegen die trollsobeit naps :)
	{
		format(string,sizeof(string),""ACINFO" Spieler %s [%i] wurde gebannt. Grund: Tuning-Hack",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(SAMP_WEISS,string);
		format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nDer Grund für den Bann von dem Admin System war: Tuning-Hack.\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[playerid][pName]);
		ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
		BanUser(playerid,"System","Tuning-Hack");
		return 1;
	}
    for(new fv;fv<MAX_FVEHS;fv++)
	{
		if(vehicleid == Fahrzeug[fv][Vehicle])
	   	{
		   	switch(GetVehicleComponentType(componentid))
		   	{
			   	case 0:Fahrzeug[fv][Spoiler] = componentid;
				case 1:Fahrzeug[fv][Hood] = componentid;
				case 2:Fahrzeug[fv][Roof] = componentid;
				case 3:Fahrzeug[fv][Sideskirt] = componentid;
				case 4:Fahrzeug[fv][Lamps] = componentid;
				case 5:Fahrzeug[fv][Nitro] = componentid;
				case 6:Fahrzeug[fv][Exhaust] = componentid;
				case 7:Fahrzeug[fv][Wheels] = componentid;
				case 8:Fahrzeug[fv][Stereo] = componentid;
				case 9:Fahrzeug[fv][Hydraulics] = componentid;
				case 10:Fahrzeug[fv][FrontBumper] = componentid;
				case 11:Fahrzeug[fv][RearBumper] = componentid;
				case 12:Fahrzeug[fv][VentRight] = componentid;
				case 13:Fahrzeug[fv][VentLeft] = componentid;
				case 14:Fahrzeug[fv][FrontBumper] = componentid;   // open.mp: Front-Bullbar, in SA-MP Slot 10
				case 15:Fahrzeug[fv][RearBumper] = componentid;    // open.mp: Rear-Bullbar, in SA-MP Slot 11
			}
			return 1;
	   	}
   	}
	ForEachPlayer(i)
	{
	    for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
			if(vehicleid == Pfahrzeug[slot][i][Vehicle])
		 	{
			 	switch(GetVehicleComponentType(componentid))
			   	{
				 	case 0:Pfahrzeug[slot][i][Spoiler] = componentid;
					case 1:Pfahrzeug[slot][i][Hood] = componentid;
					case 2:Pfahrzeug[slot][i][Roof] = componentid;
					case 3:Pfahrzeug[slot][i][Sideskirt] = componentid;
					case 4:Pfahrzeug[slot][i][Lamps] = componentid;
					case 5:Pfahrzeug[slot][i][Nitro] = componentid;
					case 6:Pfahrzeug[slot][i][Exhaust] = componentid;
					case 7:Pfahrzeug[slot][i][Wheels] = componentid;
					case 8:Pfahrzeug[slot][i][Stereo] = componentid;
					case 9:Pfahrzeug[slot][i][Hydraulics] = componentid;
					case 10:Pfahrzeug[slot][i][FrontBumper] = componentid;
					case 11:Pfahrzeug[slot][i][RearBumper] = componentid;
					case 12:Pfahrzeug[slot][i][VentRight] = componentid;
					case 13:Pfahrzeug[slot][i][VentLeft] = componentid;
					case 14:Pfahrzeug[slot][i][FrontBumper] = componentid;   // open.mp: Front-Bullbar, in SA-MP Slot 10
					case 15:Pfahrzeug[slot][i][RearBumper] = componentid;    // open.mp: Rear-Bullbar, in SA-MP Slot 11
				}
				return 1;
			}
	 	}
 	}
	return 1;
}

public OnEnterExitModShop(playerid,enterexit,interiorid)
{
	new fv = IsAFraktionsVeh(playerid);
	if(enterexit == 0 && fv != -1) ChangeVehicleColours(Fahrzeug[fv][Vehicle],Fahrzeug[fv][Colour1],Fahrzeug[fv][Colour2]);
	return 1;
}

public OnVehiclePaintjob(playerid,vehicleid,paintjobid)
{
    for(new fv;fv<MAX_FVEHS;fv++)
	{
		if(vehicleid == Fahrzeug[fv][Vehicle])
	   	{
		   	Fahrzeug[fv][Paintjob] = paintjobid;
		   	return 1;
	   	}
   	}
   	ForEachPlayer(i)
	{
	    for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
			if(vehicleid == Pfahrzeug[slot][i][Vehicle])
		 	{
				Pfahrzeug[slot][i][Paintjob] = paintjobid;
				return 1;
			}
		}
	}
	return 1;
}
public OnQueryError(errorid,const error[],const callback[],const query[],connectionHandle)
{
	new logstring[900],queryteil[512],qi,qj,imwert;
	// Die Werte zwischen Hochkommata werden ausgeblendet. Sonst landen
	// Passwort-Hashes und andere Spielerdaten im Klartext in der Logdatei
	// und auf der Serverkonsole. Struktur und Tabellen bleiben lesbar,
	// das genuegt zur Fehlersuche.
	while(query[qi] != 0 && qj < sizeof(queryteil)-5)
	{
		if(query[qi] == '\'')
		{
			queryteil[qj++] = '\'';
			if(!imwert)
			{
				queryteil[qj++] = '.';
				queryteil[qj++] = '.';
				queryteil[qj++] = '.';
			}
			imwert = !imwert;
		}
		else if(!imwert)
		{
			queryteil[qj++] = query[qi];
		}
		qi++;
	}
	queryteil[qj] = 0;
	format(logstring,sizeof(logstring),"MySQL-Fehler %d | Handle: %d | Callback: %s | Meldung: %s | Query (%d Zeichen, Werte ausgeblendet): %s",errorid,connectionHandle,callback,error,strlen(query),queryteil);
	Log("Server_MySQL_Error.txt",logstring);
	print(logstring);
	return 1;
}
public OnVehicleRespray(playerid,vehicleid,color1,color2)
{
	new string[256];
	if((color1<0||color1>255) || (color2<0||color2>255))//gegen die trollsobeit naps :)
	{
		format(string,sizeof(string),""ACINFO" Spieler %s [%i] wurde gebannt. Grund: Tuning-Hack",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(SAMP_WEISS,string);
		format(string,sizeof(string),"%s du wurdest vom Server gebannt.\nDer Grund für den Bann von dem Admin System war: Tuning-Hack.\nFalls du zu unrecht gebannt wurdest,\nmelde dich im Teamspeak³ oder schreibe uns im Forum.\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF} Adminteam",Spieler[playerid][pName]);
		ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Bann",string,"Verlassen","");
		BanUser(playerid,"System","Tuning-Hack");
		return 1;
	}
	new fv = IsAFraktionsVeh(playerid);
	if(fv != -1)
	{
	    if(Fahrzeug[fv][Fraktion] == 13 || Fahrzeug[fv][Fraktion] == 17)
	    {
	        Fahrzeug[fv][Colour1] = color1;
			Fahrzeug[fv][Colour2] = color2;
	    }
		ChangeVehicleColours(Fahrzeug[fv][Vehicle],Fahrzeug[fv][Colour1],Fahrzeug[fv][Colour2]);
	}
    ForEachPlayer(i)
	{
	    for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
			if(vehicleid == Pfahrzeug[slot][i][Vehicle])
		 	{
				Pfahrzeug[slot][i][Colour1] = color1;
				Pfahrzeug[slot][i][Colour2] = color2;
				ChangeVehicleColours(Pfahrzeug[slot][i][Vehicle],Pfahrzeug[slot][i][Colour1],Pfahrzeug[slot][i][Colour2]);
				return 1;
			}
		}
	}
	return 1;
}

