				ShowPlayerStadthalleMenu(playerid);
				return 1;
			}
			if(response == 1)
			{
				if(Spieler[playerid][pBankkonto] == 0)return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Ihr Antrag auf das Arbeitslosengeld wurde abgewiesen,da Sie kein Bankkonto besitzen.");
				if(!isPlayerInJob(playerid,0))return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Ihr Antrag auf das Arbeitslosengeld wurde abgewiesen,da Sie als Berufstätig gemeldet sind.");
				if(!isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Ihr Antrag auf das Arbeitslosengeld wurde abgewiesen,da Sie als Fraktionsmitglied gemeldet sind.");
				SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Ihr Antrag auf das Arbeitslosengeld wurde angenommen.");
				SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie erhalten nun jeden Zahltag ein gewissen Betrag an Geld das ihrem Konto Gutgeschreiben wird.");
			 	Spieler[playerid][pWorkLess] = 1;
				return 1;
			}
		}

		case DIALOG_TREUE_PRESENT:
		{
		    if(response == 0)return 1;
		    else
		    {
			    switch(listitem)
			    {
				    case 0:
					{
						Spieler[playerid][pStartbonus] = 1;
						Spieler[playerid][pRespektFromPayday] += 6;
						SCM(playerid,WEISS,"{A91400}SERVER{FFFFFF}: Du hast als Treuegeschenk 6 Respektpunkte erhalten.");
					}
					case 1:
					{
						Spieler[playerid][pStartbonus] = 1;
						ACMoney(playerid,10000);
						SCM(playerid,WEISS,"{A91400}SERVER{FFFFFF}: Du hast als Treuegeschenk 10.000$ erhalten.");
					}
					case 2:
					{
						Spieler[playerid][pStartbonus] = 1;
						new time = Spieler[playerid][pPremium]-gettime();
			         	if(floatround(time/86400) >= 1)
						{
						    new days = floatround(time/86400) + 7;
						    Spieler[playerid][pPremium] = (Spieler[playerid][pPremium]+(gettime() + (60*60*24*days)));
						}
						else
						{
			 				Spieler[playerid][pPremium] = (Spieler[playerid][pPremium]+(gettime() + (60*60*24*7)));
						}
