	format(string,sizeof(string),"%s hat die Beschreibung der Firma in "IINFO2"%s"#HTML_WEISS" umgeändert.",Spieler[playerid][pName],OrgInfo[org][OrgMotto]);
	SendOrganisationsMessage(org,SAMP_WEISS,string);
	return 1;
}
