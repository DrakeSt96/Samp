					return 1;
				}
				else
				{
					if(mietantrag<1||mietantrag>1000)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst die Miete nur zwischen 1 und 1000$ setzen");
					HausInfo[haus][haus_miete] = mietantrag;
				    format(string,sizeof(string),""IINFO" du hast deine Miete auf %i$ gesetzt.",HausInfo[haus][haus_miete]);
					SCM(playerid,SAMP_WEISS,string);
				    UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
