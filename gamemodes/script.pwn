		case DIALOG_SOUNDTEST:
		{
			new string[64];
			if(response == 0)
			{
			 	Spieler[playerid][pSound] = 0;
			 	return 1;
		 	}
			if(response == 1)
			{
				switch(listitem)
				{
					case 0:
					{
						Spieler[playerid][pSound]++;
						if(Spieler[playerid][pSound] > sizeof(ValidSounds))
						{
							Spieler[playerid][pSound] = 0;
							return 1;
						}
						PlayerPlaySound(playerid,ValidSounds[Spieler[playerid][pSound]],0.0,0.0,0.0);
					    format(string,sizeof(string),"[WEITER] Soundid %i wird abgespielt.",ValidSounds[Spieler[playerid][pSound]]);
					    SCM(playerid,SAMP_WEISS,string);
					    ShowPlayerDialog(playerid,DIALOG_SOUNDTEST,DIALOG_STYLE_LIST,"Soundtest","Weiter\nZurück","Auswählen","Abbrechen");
					}
					case 1:
					{
						Spieler[playerid][pSound]--;
						if(Spieler[playerid][pSound] < 0)
					 	{
							Spieler[playerid][pSound] = sizeof(ValidSounds);
							return 1;
						}
						PlayerPlaySound(playerid,ValidSounds[Spieler[playerid][pSound]],0.0,0.0,0.0);
					    format(string,sizeof(string),"[ZURÜCK] Soundid %i wird abgespielt.",ValidSounds[Spieler[playerid][pSound]]);
					    SCM(playerid,SAMP_WEISS,string);
					    ShowPlayerDialog(playerid,DIALOG_SOUNDTEST,DIALOG_STYLE_LIST,"Soundtest","Weiter\nZurück","Auswählen","Abbrechen");
					}
				}
				return 1;
			}
		}

		case SMARK_MENU:
		{
			new string[500],sm = ReturnSmarkID(playerid);
