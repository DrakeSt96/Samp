stock ShowPlayerDynCamView(playerid)
{
	new log_view = random(7);
	switch(log_view)
	{
	    case 0:{
	    	SetPlayerPos(playerid,1953.671386, -1621.703002, 42.246944+3);
			InterpolateCameraPos(playerid, 1953.671386, -1621.703002, 42.246944, 1829.043945, -1614.282592, 64.702522, 10000);
			InterpolateCameraLookAt(playerid, 1951.132812, -1617.947753, 40.136585, 1831.974365, -1612.430541, 61.099452, 10000);
		}
		case 1:{
	    	SetPlayerPos(playerid,1519.081542, -1039.282104, 28.212093+3);
			InterpolateCameraPos(playerid, 1519.081542, -1039.282104, 28.212093, 1405.731079, -1036.372436, 57.966449, 10000);
			InterpolateCameraLookAt(playerid, 1514.793945, -1036.710205, 28.255582, 1409.873657, -1035.150146, 55.447551, 10000);
		}
