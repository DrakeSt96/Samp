	new pID,string[128],serial[50];
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /gethdd [playerid/Name]");
 	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
   	gpci(pID,serial,sizeof(serial));
	format(string,sizeof(string),"Name: "IINFO2"%s"#HTML_WEISS" | HDD: "IINFO2"%s",SpielerName(pID),serial);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:report(playerid,const params[])
{
	#pragma unused params
	new onlineadmins;
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im AFK-Modus und kannst somit keine Befehle nutzen."),SCM(playerid,SAMP_WEISS,""IINFO" /back");
	ForEachPlayer(i){if(IsPlayerConnected(i) && !IsPlayerNPC(i)){if(GetPVarInt(i,"Eingeloggt") == 1){if(isPlayerAnAdmin(i,1)){onlineadmins++;}}}}
	if(onlineadmins == 0)return SCM(playerid,SAMP_WEISS,""IINFO" es ist kein Teammitglied Online.");
    if(!isPlayerInFrakt(playerid,0))return ShowPlayerReportFrak(playerid);
	return ShowPlayerReport(playerid);
}
COMMAND:reportfix(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	for(new x = 0; x < MAX_PLAYERS; x++)
	{
    	Spieler[x][pReportPartner] = -1;
		Spieler[x][pAReport] = 0;
		Spieler[x][pAtReport] = 0;
		DeleteReport(x);
		for(new i=0;i<5;i++){ Spieler[x][pWriteReport][i] = false; }
		Delete3DTextLabel(ReportLabel[x]);
	}
	SCM(playerid,SAMP_WEISS,""IINFO" alle Reports wurden gelöscht.");
	return 1;
}
COMMAND:rtclose(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID = Spieler[playerid][pReportPartner],string[256];
	if(Spieler[playerid][pAtReport] != 0)
	{
		format(string,sizeof(string),"{6F7374}[Support]:"#HTML_WEISS" %s hat den Report beendet.",Spieler[playerid][pName]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"{6F7374}[Support Modus]:"#HTML_WEISS" du hast den support mit {6F7374}%s{fafafa} geschlossen",Spieler[pID][pName]);
		SCM(playerid,SAMP_WEISS,string);
		for(new i=0;i<5;i++){ Spieler[pID][pWriteReport][i] = false; }
		Spieler[pID][pReportPartner] = -1;
		Spieler[pID][pAReport] = 0;
		Spieler[pID][pAtReport] = 0;
		Spieler[playerid][pReportPartner] = -1;
		Spieler[playerid][pAReport] = 0;
		Spieler[playerid][pAtReport] = 0;
		DeleteReport(playerid);
		DeleteReport(pID);
		Delete3DTextLabel(ReportLabel[pID]);
		Delete3DTextLabel(ReportLabel[playerid]);
		return 1;
	}
	if(Spieler[playerid][pAReport] != 0)
	{
		SCM(playerid,REPORTANDAFKCOLOR,"{6F7374}[Support Modus]"#HTML_WEISS" Du hast deinen aktuellen Report beendet.");
		Spieler[playerid][pReportPartner] = -1;
		Spieler[playerid][pAReport] = 0;
		Spieler[playerid][pAtReport] = 0;
		DeleteReport(playerid);
		DeleteReport(pID);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Report abgesendet.");
}
COMMAND:muenze(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[128],fall = random(3);
	if(GetACMoney(playerid) <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Münze zum werfen!");
	switch(fall)
	{
		case 0:
		{
			format(string,sizeof(string),"** %s warf eine Münze auf Kopf **",SpielerName(playerid));
		    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		}
		case 1:
		{
			format(string,sizeof(string),"** %s warf eine Münze auf Zahl **",SpielerName(playerid));
		    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		}
		case 2:
		{
			format(string,sizeof(string),"** %s warf eine Münze auf Kopf **",SpielerName(playerid));
		    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		}
		case 3:
		{
			format(string,sizeof(string),"** %s warf eine Münze auf Zahl **",SpielerName(playerid));
		    PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		}
	}
	return 1;
}
COMMAND:telefonbuch(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(ReturnTelefonzellenID(playerid) == -1)return SCM(playerid,SAMP_WEISS,""IINFO" an keiner Telefonzelle.");
 	if(sscanf(params,"u",pID)) return SCM(playerid,SAMP_WEISS,""IINFO" /telefonbuch [playerid/Name]");
 	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[pID][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Spieler konnte im Telefonbuch nicht gefunden werden.");
	if(Spieler[pID][pTeleAnzeige] == 0) return SCM(playerid,SAMP_WEISS,""IINFO" der Spieler konnte im Telefonbuch nicht gefunden werden.");
	format(string,sizeof(string),"Name: "IINFO2"%s"#HTML_WEISS" Handynummer: "IINFO2"%i",SpielerName(pID),Spieler[pID][pPhonenumber]);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:anwaelte(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[128],onlineanwaelte = 0;
    SCM(playerid,SAMP_WEISS,"||___________Anwälte Online___________||");
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(isPlayerInJob(i,16))
				{
					if(Spieler[i][pHandy] == 0)
					{
						format(string,sizeof(string),"%s (ID:%i)",SpielerName(i),i);
						SCM(playerid,SAMP_WEISS,string);
					}
					else
					{
						format(string,sizeof(string),"%s (ID:%i) | Handy: %i",SpielerName(i),i,Spieler[i][pPhonenumber]);
						SCM(playerid,SAMP_WEISS,string);
					}
					onlineanwaelte++;
				}
			}
		}
	}
	if(onlineanwaelte == 0)return SCM(playerid,SAMP_WEISS,""IINFO" derzeit ist kein Anwalt verfügbar.");
	return 1;
}
COMMAND:makler(playerid,const params[])
