COMMAND:lock(playerid,const params[])
{
    new string[156],Float:Pos[4];
    for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
	{
		if(IsValidVehicle(Pfahrzeug[slot][playerid][Vehicle]))
		{
		   	GetVehiclePos(Pfahrzeug[slot][playerid][Vehicle],Pos[0],Pos[1],Pos[2]);
			GetVehicleParamsEx(Pfahrzeug[slot][playerid][Vehicle],engine,lights,alarm,doors,bonnet,boot,objective);
			if(IsPlayerInRangeOfPoint(playerid,3.0,Pos[0],Pos[1],Pos[2]))
			{
				if(Pfahrzeug[slot][playerid][Abgeschlossen] == 0)
				{
				    SetVehicleParamsEx(Pfahrzeug[slot][playerid][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
				    Pfahrzeug[slot][playerid][Abgeschlossen] = 1;
				    format(string,sizeof(string),"~w~%s~n~~r~abgeschlossen",VehicleDefinations[Pfahrzeug[slot][playerid][modelid]-400]);
				    GameTextForPlayer(playerid,string,2000,6);
				    PlayerHearMusicInRange(Pos[0],Pos[1],Pos[2],1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
					return 1;
				}
				else if(Pfahrzeug[slot][playerid][Abgeschlossen] == 1)
				{
				    SetVehicleParamsEx(Pfahrzeug[slot][playerid][Vehicle],engine,lights,alarm,VEHICLE_PARAMS_OFF,bonnet,boot,objective);
				    Pfahrzeug[slot][playerid][Abgeschlossen] = 0;
				    format(string,sizeof(string),"~w~%s~n~~g~aufgeschlossen",VehicleDefinations[Pfahrzeug[slot][playerid][modelid]-400]);
				    GameTextForPlayer(playerid,string,2000,6);
			   		PlayerHearMusicInRange(Pos[0],Pos[1],Pos[2],1027,10,0,0);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
					return 1;
				}
			}
		}
	}
	return 1;
}
COMMAND:invite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[256];
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pLeader] == 0)return SCM(playerid,SAMP_WEISS,"Kein Leader.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /invite [playerid/Name]");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst inviten.");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!isPlayerInFrakt(playerid,11))
	{
		if(GetPlayerLevel(pID) < 3)return SCM(playerid,SAMP_WEISS,"Spieler besitzt nicht das nötige Level (mindestens Level 3)");
	}
	else if(!isPlayerInFrakt(playerid,15))
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" das darfst du nicht machen.");
	}else{
	    if(GetPlayerLevel(pID) < 2)return SCM(playerid,SAMP_WEISS,"Spieler besitzt nicht das nötige Level (mindestens Level 2)");
	}
	format(string,sizeof(string),""IINFO" das Memberlimit der Fraktion %s beträgt %d. Die Fraktion ist voll!",FraktionsName(Spieler[playerid][pFraktion]),fverwaltungen[Spieler[playerid][pFraktion]][FrakLimit]);
	if(fverwaltungen[Spieler[playerid][pFraktion]][FrakMembers] >= fverwaltungen[Spieler[playerid][pFraktion]][FrakLimit] && fverwaltungen[Spieler[playerid][pFraktion]][FrakLimit] != 0)return SCM(playerid,SAMP_WEISS,string),SCM(pID,SAMP_WEISS,string);
	if(isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler ist bereits in deiner Fraktion.");
	if(Spieler[pID][pFraktion] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist bereits in einer Fraktion.");
    if(Spieler[pID][pWorkLess] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler hat noch Arbeitslosengeld.");
	if(gettime() < Spieler[pID][pFraktionSperre])return SCM(playerid,SAMP_WEISS,"Spieler hat eine Fraktionssperre.");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	format(string,sizeof(string),""IINFO" du wurdest von %s in die Fraktion %s eingeladen.",Spieler[playerid][pName],FraktionsName(Spieler[playerid][pFraktion]));
    SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" du hast %s in deine Fraktion eingeladen.",Spieler[pID][pName]);
    SCM(playerid,SAMP_WEISS,string);
    format(string,sizeof(string),"Dir wurde eine Invite Anfrage vom Leader %s in die Fraktion %s gestellt.\nKlicke *Annehmen* um der Fraktion beizutreten\nUnd *Ablehnen* um nicht beizutreten.",Spieler[playerid][pName],FraktionsName(Spieler[playerid][pFraktion]));
    ShowPlayerDialog(pID,INVITE_DIALOG,DIALOG_STYLE_MSGBOX,FraktionsName(Spieler[playerid][pFraktion]),string,"Annehmen","Abbrechen");
	SetPVarInt(pID,"getfrak",Spieler[playerid][pFraktion]);
	SetPVarInt(pID,"getleader",playerid);
	format(string,sizeof(string),"Spieler: %s User: %s * Fraktion: %s",Spieler[playerid][pName],Spieler[pID][pName],FraktionsName(Spieler[playerid][pFraktion]));
    Log("Invitesqllog",string);
   	return 1;
}

COMMAND:uninvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,stringuninv[128];
    if(isPlayerInFrakt(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pLeader] == 0)return SCM(playerid,SAMP_WEISS,"Kein Leader.");
	if(sscanf(params,"u",pID)) return SCM(playerid,SAMP_WEISS,""IINFO" /uninvite [playerid/Name]");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst uninviten.");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
 	if(!isPlayerInFrakt(pID,Spieler[playerid][pFraktion]))return SCM(playerid,SAMP_WEISS,"Spieler ist nicht in deiner Fraktion.");
	format(stringuninv,sizeof(stringuninv),""IINFO" du hast %s aus deiner Fraktion uninvitet.",Spieler[pID][pName]);
  	SCM(playerid,SAMP_WEISS,stringuninv);
	format(stringuninv,sizeof(stringuninv),""IINFO" du wurdest vom Leader %s aus der Fraktion %s uninvitet.",Spieler[playerid][pName],FraktionsName(Spieler[playerid][pFraktion]));
 	SCM(pID,SAMP_WEISS,stringuninv);
 	GetPlayerPos(pID,Spieler[pID][LastInGamePos_x],Spieler[pID][LastInGamePos_y],Spieler[pID][LastInGamePos_z]);
	Spieler[pID][LastInGamePos_int] = GetPlayerInterior(pID);
	Spieler[pID][LastInGamePos_world] = GetPlayerVirtualWorld(pID);
	fverwaltungen[Spieler[playerid][pFraktion]][FrakMembers]--;
   	Spieler[pID][pFraktion] = 0;
  	Spieler[pID][pFraktRang] = 0;
  	Spieler[pID][pFraktURang] = 0;
  	Spieler[pID][pArmyHeliOrder] = 0;
	Spieler[pID][pArmyPlaneOrder] = 0;
  	Spieler[pID][pLeader] = 0;
   	Spieler[pID][pFraktionsGehalt] = 0;
   	Spieler[pID][pFraktSkin] = 0;
   	Spieler[pID][pSpawn] = 0;
   	Spieler[pID][pFraktABTInvite] = 0;
   	Spieler[pID][pDuty] = 0;
  	SpawnPlayerEx(pID);
	format(stringuninv,sizeof(stringuninv),"Spieler: %s User: %s * Fraktion:%s",Spieler[playerid][pName],Spieler[pID][pName],FraktionsName(Spieler[playerid][pFraktion]));
  	Log("UnInvitesqllog",stringuninv);
    return 1;
}

COMMAND:getip(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[64],pID;
	if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /getip [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	format(string,sizeof(string),"%s : IP: %s",SpielerName(pID),SpielerIP(pID));
	SCM(playerid,WEISS,string);
	return 1;
}

COMMAND:spec(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /spec [playerid/Name]");
	if(Spieler[playerid][pSpectate] != -1)return SCM(playerid,SAMP_WEISS,""IINFO" du spectatest bereits einen Spieler.");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selber Spectaten.");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pSpectate] != -1)return SCM(playerid,SAMP_WEISS,"Spieler spectatet bereits einen Spieler.");
	SaveAccount(playerid);
	GetPlayerPos(playerid,Spieler[playerid][LastInGamePos_x],Spieler[playerid][LastInGamePos_y],Spieler[playerid][LastInGamePos_z]);
	Spieler[playerid][LastInGamePos_int] = GetPlayerInterior(playerid);
	Spieler[playerid][LastInGamePos_world] = GetPlayerVirtualWorld(playerid);
	format(string,sizeof(string),""IINFO" du spionerst im moment %s (ID:%i) aus.",SpielerName(pID),pID);
	SCM(playerid,SAMP_WEISS,string);
	if(!isPlayerAnAdmin(playerid,6))
	{
		format(string,sizeof(string),"[SPEC]: %s %s spectatet nun %s[ID:%i].",Adminrang(playerid),SpielerName(playerid),SpielerName(pID),pID);
		SendAdminMessage(SAMP_WEISS,string);
	}
	SCM(playerid,SAMP_WEISS,"Nutze '/unspec' um das spionieren abzubrechen.");
	SetPlayerInterior(playerid,GetPlayerInterior(pID));
 	SetPlayerVirtualWorld(playerid,GetPlayerVirtualWorld(pID));
   	TogglePlayerSpectating(playerid,true);
   	if(!IsPlayerInAnyVehicle(pID)) PlayerSpectatePlayer(playerid,pID);
	else  PlayerSpectateVehicle(playerid,GetPlayerVehicleID(pID));
   	Spieler[playerid][pSpectate] = pID;
	return 1;
}

COMMAND:unspec(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	if(Spieler[playerid][pSpectate] == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du spectatetest niemanden.");
	TogglePlayerSpectating(playerid,false);
	new string[128];
	SCM(playerid,SAMP_WEISS,""IINFO" du spectatest nun nicht mehr.");
	format(string,sizeof(string),"[SPEC]: %s %s hat aufgehört zu spectaten.",Adminrang(playerid),SpielerName(playerid));
	SendAdminMessage(SAMP_WEISS,string);
    Spieler[playerid][pSpectate] = -2;
	return 1;
}

public SetToOldLocation(playerid)
{
    SetPlayerPosEx(playerid,Spieler[playerid][LastInGamePos_x],Spieler[playerid][LastInGamePos_y],Spieler[playerid][LastInGamePos_z]);
	SetPlayerInterior(playerid,Spieler[playerid][LastInGamePos_int]);
	SetPlayerVirtualWorld(playerid,Spieler[playerid][LastInGamePos_world]);
}

COMMAND:showstats(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128];
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /showstats [playerid/Name]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(isPlayerAnAdmin(pID,7) && pID != playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst das nicht!");
    format(string,sizeof(string),""IINFO" du überprüfst %s (ID:%i) Statistiken.",SpielerName(pID),pID);
	SCM(playerid,WEISS,string);
	ShowOldStatiks(pID,playerid);
	return 1;
}

COMMAND:showoldstats(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128];
    if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /showoldstats [playerid/Name]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(isPlayerAnAdmin(pID,7) && pID != playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst das nicht!");
    format(string,sizeof(string),""IINFO" du überprüfst %s (ID:%i) Statistiken.",SpielerName(pID),pID);
	SCM(playerid,WEISS,string);
	ShowStatiks(pID,playerid);
	return 1;
}

COMMAND:showtasche(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new pID,string[128];
    if(!isPlayerAnAdmin(playerid,3))return ADMIN_MSG(playerid);
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /showtasche [playerid/Name]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    format(string,sizeof(string),""IINFO" du überprüfst %s (ID:%i) Tasche.",SpielerName(pID),pID);
	SCM(playerid,WEISS,string);
    ShowBag(pID,playerid);
	return 1;
}

