						SendClientMessageToAll(ORANGE,"NR BOT: In ganz San Andreas herrscht Angst und schrecken.");
						SendClientMessageToAll(ORANGE,"NR BOT: Wir die San Andreas News AG halten Sie auf dem Laufenden.");
						SendClientMessageToAll(ORANGE,"NR BOT: [_Breaking News Ende_]");
						BombZone = GangZoneCreate(BombeX-60,BombeY-60,BombeX+60,BombeY+60);
						GangZoneShowForAll(BombZone,0xFF000065);
						GangZoneFlashForAll(BombZone,0xC3FF004F);
					    GameTextForPlayer(playerid,"~y~Du hast die Bombe gelegt...",3000,1);
					    SCM(playerid,SAMP_WEISS,""IINFO" du hast einen C4-Sprengsatz gelegt | Draht: Blau | Zeit bis zur explosion: 5:00 Minuten");
						Spieler[playerid][pC4] -= 5;
						BombPickup = CreateDynamicPickup(1252,23,BombeX,BombeY,BombeZ);
						BombSeconds = 0;
						BombTimer = SetTimer("Bomb",1000,true);
						ForEachPlayer(i)
					    {
						    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
						    {
							    if((isPlayerInFrakt(i,1) && Spieler[i][pFraktABTInvite] != 0) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,8))
								{
									TextDrawShowForPlayer(i,Bombdraw);
								}
							}
					    }
						format(string,sizeof(string),"** %s lässt etwas heimlich auf den Boden fallen **",SpielerName(playerid));
						PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
				    }
				    case 3://Gelb
				    {
						BombDraht[3] = 1;
						BombState = true;
						GetPlayerPos(playerid,BombeX,BombeY,BombeZ);
