public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    new string[700],gw = GWIsPlayerInWarArea(playerid);
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		for(new gwpickup=0;gwpickup<3;gwpickup++)
		{
			if(gw != -1 && pickupid == GangwarZones[gw][War_Flagpickup][gwpickup])
			{
				if(!IsPlayerInAnyVehicle(playerid) && (GangwarZones[gw][War_Time] != 0 || GangwarZones[gw][War_Attacker] != 0 || GangwarZones[gw][War_Started] == 1))
				{
					if(GangwarZones[gw][War_Owner] == Spieler[playerid][pFraktion] || GangwarZones[gw][War_Attacker] == Spieler[playerid][pFraktion])
					{
						if(GangwarZones[gw][War_CaptureHero][gwpickup] != -1)return 1;
						if(GangwarZones[gw][War_CapturedFlags][gwpickup] == Spieler[playerid][pFraktion])return 1;
						GangwarZones[gw][War_CaptureHero][gwpickup] = playerid;
					    format(string,sizeof(string),"Gangwar: %s versucht eine Flagge einzunehmen!",SpielerName(playerid));
					    ForEachPlayer(i)
						{
						    if(IsPlayerConnected(i))
							{
							    if(Spieler[i][pFraktion] == GangwarZones[gw][War_Owner] || Spieler[i][pFraktion] == GangwarZones[gw][War_Attacker])
								{
							    	SCM(i,GWCHATCOLOR,string);
							    }
						    }
					    }
						return 1;
					}
				}
			}
	 	}
    }
    if(pickupid == firebrigadedachenter)
	{
		new count = 0;
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i)
			{
				if(GetPVarInt(i,"Eingeloggt") == 1)
				{
					if(isPlayerInFrakt(i,3) && ProxDetectorS(5.0,playerid,i)) count++;
				}
			}
		}
		if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || count != 0)
		{
		    SetPlayerPosEx(playerid,1751.5216,-1108.6271,46.5746);
		    SetCameraBehindPlayer(playerid);
		    SetPlayerInterior(playerid,0);
		    SetPlayerVirtualWorld(playerid,0);
		    return 1;
	    }
	    return GameTextForPlayer(playerid,"~r~Du bist nicht in der jeweiligen Fraktion.~n~Es ist kein Arzt in deiner Reichweite.",1000,3);
    }
    if(pickupid == firebrigadedachexit)
	{
		new count = 0;
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i)
			{
				if(GetPVarInt(i,"Eingeloggt") == 1)
				{
					if(isPlayerInFrakt(i,3) && ProxDetectorS(5.0,playerid,i)) count++;
				}
			}
		}
		if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || count != 0)
		{
		    SetPlayerPosEx(playerid,1721.9294,-1115.6558,24.0859);
			SetCameraBehindPlayer(playerid);
		    SetPlayerInterior(playerid,0);
		    SetPlayerVirtualWorld(playerid,0);
		    return 1;
	    }
	    return GameTextForPlayer(playerid,"~r~Du bist nicht in der jeweiligen Fraktion.~n~Es ist kein Arzt in deiner Reichweite.",1000,3);
    }
    if(pickupid == exitstadium[0])
	{
		TextDrawShowForPlayer(playerid,InfoSign);
	    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du hast die Derby Arena verlassen.");
		PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
		StopAudioStreamForPlayer(playerid);
		
	 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
		if(GetPlayerVirtualWorld(playerid) == 1)
		{
			SetPlayerPosEx(playerid,2695.7078,-1704.6866,11.8438);
			SetPlayerInterior(playerid,0);
		}
		else
		{
			SetPlayerPosEx(playerid,-2109.6663,-444.1563,38.7344);
			SetPlayerInterior(playerid,0);
		}
		SetPlayerVirtualWorld(playerid,0);
	    return 1;
	}
	if(pickupid == exitstadium[1])
	{
	    TextDrawShowForPlayer(playerid,InfoSign);
	    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du hast die Race Arena verlassen.");
		PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
		StopAudioStreamForPlayer(playerid);
		
	 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
	    if(GetPlayerVirtualWorld(playerid) == 1)
		{
			SetPlayerPosEx(playerid,2695.7078,-1704.6866,11.8438);
			SetPlayerInterior(playerid,0);
		}
		else
		{
			SetPlayerPosEx(playerid,-2109.6663,-444.1563,38.7344);
			SetPlayerInterior(playerid,0);
		}
		SetPlayerVirtualWorld(playerid,0);
	    return 1;
	}
	if(pickupid == exitstadium[2])
	{
		TextDrawShowForPlayer(playerid,InfoSign);
	    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du hast die Kickstart Arena verlassen.");
		PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
		StopAudioStreamForPlayer(playerid);
		
	 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
		if(GetPlayerVirtualWorld(playerid) == 1)
		{
			SetPlayerPosEx(playerid,2695.7078,-1704.6866,11.8438);
			SetPlayerInterior(playerid,0);
		}
		else
		{
			SetPlayerPosEx(playerid,-2109.6663,-444.1563,38.7344);
			SetPlayerInterior(playerid,0);
		}
		SetPlayerVirtualWorld(playerid,0);
	    return 1;
	}
	if(pickupid == tutorialpickup[playerid][0] && Spieler[playerid][pTutMissionComplete][0] == true)
    {
    	Spieler[playerid][pTutMissionComplete][0] = false;
	    DestroyDynamicPickup(tutorialpickup[playerid][0]);
		SetACMoney(playerid,MAX_TUTORIAL_MONEY);
		Spieler[playerid][pTutMissionComplete][1] = true;
