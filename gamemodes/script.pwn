    //UpdateDynamic3DTextLabelText(AD3DText[2],ORANGE,string);
    //format(string,sizeof(string),""#HTML_ORANGE"Werbepunkt der San Andreas News GmbH\nHier könnte deine Werbung stehen\n"#HTML_WHITE"Preis: %i"#HTML_PERFECTGREEN"$"#HTML_ORANGE"\n"#HTML_WHITE"/werbung",fsteuern[ADPreis]);
    //UpdateDynamic3DTextLabelText(AD3DText[3],ORANGE,string);
	//format(string,sizeof(string),"%s hat den Werbepreis auf %i$ gesetzt.",SpielerName(playerid),fsteuern[ADPreis]);
    //SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	return 1;
}
COMMAND:newspaperprice(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new menge,string[128];
    if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(sscanf(params,"i",menge))return SCM(playerid,SAMP_WEISS,""IINFO" /newspaperprice [Preis]");
	if(menge<1||menge>10)return SCM(playerid,SAMP_WEISS,""IINFO" /newspaperprice [Preis 1-10]");
	fsteuern[NewspaperPreis] = menge;
	for(new i=0;i<2;i++)
	{
		format(string,sizeof(string),""#HTML_ORANGE"Zeitungspunkt der San Andreas News GmbH\n"#HTML_WHITE"Preis: %i"#HTML_PERFECTGREEN"$"#HTML_ORANGE"\n"#HTML_WHITE"/readnewspaper",fsteuern[NewspaperPreis]);
	    UpdateDynamic3DTextLabelText(Newspapertext[i],ORANGE,string);
    }
	format(string,sizeof(string),"%s hat den Zeitungspreis Preis auf %i$ gesetzt.",SpielerName(playerid),fsteuern[NewspaperPreis]);
    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	return 1;
}
COMMAND:writenewspaper(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],cmd[30],text[125];
	if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(sscanf(params,"s[30]s[125]",cmd,text))return SCM(playerid,SAMP_WEISS,""IINFO" /writenewspaper [1-8/Veröffentlichen/Zurückziehen][Text]");
	if(strlen(text) > 120)return SCM(playerid,SAMP_WEISS,""IINFO" /writenewspaper [1-8/Veröffentlichen/Zurückziehen][Text darf maximal 120 Zeichen beinhalten]");
	if(strcmp(cmd,"1",true) == 0)
	{
		strmid(fsteuern[NewspaperText1],text,0,strlen(text),128);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast den Absatz 1 der Zeitung in folgenden Text geändert:");
		format(string,sizeof(string),"- %s",text);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"2",true) == 0)
	{
		strmid(fsteuern[NewspaperText2],text,0,strlen(text),128);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast den Absatz 2 der Zeitung in folgenden Text geändert:");
		format(string,sizeof(string),"- %s",text);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"3",true) == 0)
	{
		strmid(fsteuern[NewspaperText3],text,0,strlen(text),128);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast den Absatz 3 der Zeitung in folgenden Text geändert:");
		format(string,sizeof(string),"- %s",text);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"4",true) == 0)
	{
		strmid(fsteuern[NewspaperText4],text,0,strlen(text),128);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast den Absatz 4 der Zeitung in folgenden Text geändert:");
		format(string,sizeof(string),"- %s",text);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"5",true) == 0)
	{
		strmid(fsteuern[NewspaperText5],text,0,strlen(text),128);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast den Absatz 5 der Zeitung in folgenden Text geändert:");
		format(string,sizeof(string),"- %s",text);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"6",true) == 0)
	{
	strmid(fsteuern[NewspaperText6],text,0,strlen(text),128);
	SCM(playerid,SAMP_WEISS,""IINFO" du hast den Absatz 6 der Zeitung in folgenden Text geändert:");
	format(string,sizeof(string),"- %s",text);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
	}
	if(strcmp(cmd,"7",true) == 0)
	{
		strmid(fsteuern[NewspaperText7],text,0,strlen(text),128);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast den Absatz 7 der Zeitung in folgenden Text geändert:");
		format(string,sizeof(string),"- %s",text);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"8",true) == 0)
	{
		strmid(fsteuern[NewspaperText8],text,0,strlen(text),128);
		SCM(playerid,SAMP_WEISS,""IINFO" du hast den Absatz 8 der Zeitung in folgenden Text geändert:");
		format(string,sizeof(string),"- %s",text);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"Veröffentlichen",true) == 0)
	{
		fsteuern[NewsPaperRealeased] = 1;
	    format(string,sizeof(string),"%s hat einen neue Ausgabe der San Andreas News Zeitung rausgebracht.",SpielerName(playerid));
	    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
		return 1;
	}
	if(strcmp(cmd,"Zurückziehen",true) == 0)
	{
		fsteuern[NewsPaperRealeased] = 0;
		fsteuern[NewsPaperLager][0] = 0;
		fsteuern[NewsPaperLager][1] = 0;
	    format(string,sizeof(string),"%s hat die Produktion der San Andreas News Zeitung eingestellt.",SpielerName(playerid));
	    SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /writenewspaper [1-8/Veröffentlichen/Zurückziehen][Text]");
}
COMMAND:readnewspaper(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[900];
	if(IsPlayerInRangeOfPoint(playerid,2.0,1440.1128,-1043.6819,23.8281))
	{
		if((GetACMoney(playerid) - fsteuern[NewspaperPreis]) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld dabei.");
		if(fsteuern[NewsPaperRealeased] == 0)return SCM(playerid,SAMP_WEISS,"Es wurde keine Zeitung veröffentlicht.");
		if(fsteuern[NewsPaperLager][0] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Zeitungsstand hat keine Zeitungen mehr.");
		ACMoney(playerid,-fsteuern[NewspaperPreis]);
		fverwaltungen[10][Geld] += fsteuern[NewspaperPreis];
		format(string,sizeof(string),""IINFO" du hast dir eine Zeitung für %i$ gekauft.",fsteuern[NewspaperPreis]);
		SCM(playerid,SAMP_WEISS,string);
		fsteuern[NewsPaperLager][0]--;
		format(string,sizeof(string),"%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s",fsteuern[NewspaperText1],fsteuern[NewspaperText2],fsteuern[NewspaperText3],fsteuern[NewspaperText4],fsteuern[NewspaperText5],fsteuern[NewspaperText6],fsteuern[NewspaperText7],fsteuern[NewspaperText8]);
		ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"San Andreas News Zeitung",string,"Verlassen","");
		return 1;
	}
	if(IsPlayerInRangeOfPoint(playerid,2.0,-1970.7450,104.3676,27.6875))
	{
		if((GetACMoney(playerid) - fsteuern[NewspaperPreis]) < 0) return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld dabei.");
		if(fsteuern[NewsPaperRealeased] == 0)return SCM(playerid,SAMP_WEISS,"Es wurde keine Zeitung veröffentlicht.");
		if(fsteuern[NewsPaperLager][1] <= 0)return SCM(playerid,SAMP_WEISS,""IINFO" der Zeitungsstand hat keine Zeitungen mehr.");
		ACMoney(playerid,-fsteuern[NewspaperPreis]);
		fverwaltungen[10][Geld] += fsteuern[NewspaperPreis];
		format(string,sizeof(string),""IINFO" du hast dir eine Zeitung für %i$ gekauft.",fsteuern[NewspaperPreis]);
		SCM(playerid,SAMP_WEISS,string);
		fsteuern[NewsPaperLager][1]--;
		format(string,sizeof(string),"%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s",fsteuern[NewspaperText1],fsteuern[NewspaperText2],fsteuern[NewspaperText3],fsteuern[NewspaperText4],fsteuern[NewspaperText5],fsteuern[NewspaperText6],fsteuern[NewspaperText7],fsteuern[NewspaperText8]);
		ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"San Andreas News Zeitung",string,"Verlassen","");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keine Zeitung kaufen.");
}

COMMAND:lottoeinzahlen(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],fv = IsAFraktionsVeh(playerid);
	if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
   	if(fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion] || IsPlayerInRangeOfPoint(playerid,5.0,-219.3893,1410.6112,27.7734))
   	{
		format(string,sizeof(string),"Gebe nun den Betrag ein den du in den Lotto-Jackpot einzahlen möchtest.\nMomentaner Jackpot bei: %i$",fsteuern[Lottojackpot]);
		ShowPlayerDialog(playerid,DIALOG_LOTTO_JACKPOTPAY,DIALOG_STYLE_INPUT,"Lotto",string,"Einzahlen","Abbrechen");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
}

COMMAND:startlotto(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],winners,lottowinner = random(49) + 1;
	if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,2))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(fsteuern[Lottojackpot] == 0)return SCM(playerid,SAMP_WEISS,"Lottojackpot ist leer!");
	if(gettime() > lottotimer)
	{
		SendClientMessageToAll(ORANGE,"|___________LOTTO___________|");
		format(string,sizeof(string),"%s hat die Lottoziehung gestartet!",SpielerName(playerid));
		SendClientMessageToAll(ORANGE,string);
		format(string,sizeof(string),"Die Lottozahl %i wurde gezogen.",lottowinner);
		SendClientMessageToAll(ORANGE,string);
		ForEachPlayer(pID)
		{
			if(IsPlayerConnected(pID) && !IsPlayerNPC(pID))
			{
				if(Spieler[pID][pLottonumber] == lottowinner)
				{
					new win = floatround(fsteuern[Lottojackpot]/GetLottoWinners(lottowinner));
					format(string,sizeof(string),"Gewinner %i. %s %i$",winners,SpielerName(pID),win);
					SendClientMessageToAll(ORANGE,string);
					Spieler[pID][pBank] += win;
					fsteuern[Lottojackpot] -= win;
					winners++;
				}
			}
			Spieler[pID][pLottonumber] = 0;
		}
		if(winners == 0)
		{
			format(string,sizeof(string),"Niemand hat gewonnen! Jackpot: %i$",fsteuern[Lottojackpot]);
			SendClientMessageToAll(ORANGE,string);
		}
		lottotimer = gettime() + (60*60);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du kannst erst nach einer Stunde eine neue Lottorunde starten!");
}

