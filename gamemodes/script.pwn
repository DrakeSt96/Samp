	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],wtafel;
    if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(sscanf(params,"i",wtafel))return SCM(playerid,SAMP_WEISS,""IINFO" /tafelwo [Tafelid]");
	if(wtafel<0||wtafel>(MAX_WERBETAFELN)-1)
	{
		format(string,sizeof(string),""IINFO" /tafelwo [Tafelid 0-%i]",MAX_WERBETAFELN-1);
		return SCM(playerid,SAMP_WEISS,string);
	}
    if(IsPlayerInRangeOfPoint(playerid,20.0,Werbetafeln[wtafel][wtafelx],Werbetafeln[wtafel][wtafely],Werbetafeln[wtafel][wtafelz]))return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits an der angegebenen Werbetafel!");
	format(string,sizeof(string),"Die Werbetafel %i wurde auf deiner Karte markiert.",wtafel);
	SCM(playerid,WEISS,string);
	SetPlayerCheckpoint(playerid,Werbetafeln[wtafel][wtafelx],Werbetafeln[wtafel][wtafely],Werbetafeln[wtafel][wtafelz],3.0);
	Spieler[playerid][pIsearch] = 1;
	return 1;
}
COMMAND:atafelwo(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128],wtafel;
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
    if(sscanf(params,"i",wtafel))return SCM(playerid,SAMP_WEISS,""IINFO" /atafelwo [Tafelid]");
    if(wtafel<0||wtafel>(MAX_WERBETAFELN)-1)
	{
		format(string,sizeof(string),""IINFO" /atafelwo [Tafelid 0-%i]",MAX_WERBETAFELN-1);
		return SCM(playerid,SAMP_WEISS,string);
	}
	if(IsPlayerInRangeOfPoint(playerid,20.0,Werbetafeln[wtafel][wtafelx],Werbetafeln[wtafel][wtafely],Werbetafeln[wtafel][wtafelz]))return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits an der angegebenen Werbetafel!");
	format(string,sizeof(string),"Die Werbetafel %i wurde auf deiner Karte markiert.",wtafel);
	SCM(playerid,WEISS,string);
	SetPlayerCheckpoint(playerid,Werbetafeln[wtafel][wtafelx],Werbetafeln[wtafel][wtafely],Werbetafeln[wtafel][wtafelz],3.0);
	Spieler[playerid][pIsearch] = 1;
	return 1;
}
COMMAND:n(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],text[91],fv = IsAFraktionsVeh(playerid);
    if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pNEWS] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du hast den Newsreporter Chat deaktiviert um sie wieder zu aktivieren.(/tog)");
    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
    if(fv == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
	if(Fahrzeug[fv][Fraktion] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
 	if(Spieler[playerid][pMuted] == 1)
	{
		format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		return SCM(playerid,WEISS,string);
	}
	if(sscanf(params,"s[90]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /n(achricht) [Text]");
	if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /n(achricht) [Text darf maximal 90 Zeichen beinhalten]");
	for(new i=0;i<sizeof(BadWord);i++)
	{
		if(strfind(text,BadWord[i],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /n(ewschat)",BadWord[i],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
    }
	format(string,sizeof(string),"NR %s: %s",SpielerName(playerid),text);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(Spieler[i][pNEWS] == true)
				{
					SCM(i,ORANGE,string);
				}
			}
		}
	}
	return 1;
}

COMMAND:leaveinterview(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[64];
	if(Spieler[playerid][LiveView] != 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Interview Aktiv.");
	format(string,sizeof(string),"%s verließ das Interview.",SpielerName(playerid));
	SendClientMessageToAll(ORANGE,string);
	Spieler[playerid][InviteInterView] = 0;
	Spieler[playerid][LiveView] = 0;
	return 1;
}

COMMAND:kickinterview(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(IsPlayerInRangeOfPoint(playerid,5.0,861.9858,-1045.1128,25.9659) || IsPlayerInRangeOfPoint(playerid,5.0,-219.3893,1410.6112,27.7734))
	{
		if(Spieler[playerid][LiveView] != 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Interview Aktiv.");
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /kickinterview [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst mit dir selbst kein Interview beenden.");
	    if(Spieler[pID][LiveView] != 1)return SCM(playerid,SAMP_WEISS,"Spieler ist in keinem Interview Aktiv.");
	    format(string,sizeof(string),""IINFO" du hast %s (ID:%i) aus dem Interview gekickt.",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s (ID:%i) hat dich aus dem Interview gekickt.",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		Spieler[pID][InviteInterView] = 0;
		Spieler[pID][LiveView] = 0;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Newsreporterbase oder in keinem Newsvan.");
}

COMMAND:interview(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	if(IsPlayerInRangeOfPoint(playerid,5.0,861.9858,-1045.1128,25.9659) || IsPlayerInRangeOfPoint(playerid,5.0,-219.3893,1410.6112,27.7734))
	{
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /interview [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst kein Interview anbieten.");
		format(string,sizeof(string),""IINFO" du bietest %s ein Interview an.",SpielerName(pID));
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"%s bietet dir ein Interview an.(/accept interview)",SpielerName(playerid),SpielerName(pID));
		SCM(pID,SAMP_WEISS,string);
		SCM(pID,SAMP_WEISS,"Um das Interview abzulehnen Tippe '/cancel interview'");
		Spieler[pID][InviteInterView] = 1;
		Spieler[pID][pSeller] = playerid;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Newsreporterbase oder in keinem Newsvan.");
}
COMMAND:setadpreis(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
