			{
				KillTimer(FschulTimer[playerid]);
			    FahrschulQuest(playerid,schein,1);
			    FschulTutTime[playerid] = 0;
			    FschulProbLic[playerid] = schein;
			}
		}
	}
    FschulTutTime[playerid]++;
	return 1;
}
public FahrschulQuest(playerid,schein,question)
{
	if(schein == 1)
	{
		switch(question)
		{
			case 1:
