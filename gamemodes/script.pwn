COMMAND:spawnplayer(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128];
	if(!isPlayerAnAdmin(playerid,1))return ADMIN_MSG(playerid);
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /spawnplayer [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS" hat den Spieler "IINFO2"%s"#HTML_WEISS" gespawnt.",Spieler[playerid][pName],Spieler[pID][pName]);
	SendAdminMessage(SAMP_WEISS,string);
	SCM(playerid,SAMP_WEISS,string);
	SaveAccount(pID);
	Spieler[pID][pIssureKiller] = -1;
	Spieler[pID][pFriedhof] = 0;
	Spieler[pID][pRobProtect] = 0;
	Spieler[pID][pFriedhofTime] = 0;
	Spieler[pID][pInHospital] = 0;
	Spieler[pID][pRevived] = 0;
	Spieler[pID][pNextDeath] = 0;
	Spieler[pID][pDeath] = 0;
	Spieler[pID][pDeathTime] = 0;
	return SpawnPlayerEx(pID);
}
COMMAND:makeadmin(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new pID,string[260],adminlvl;
	if(isPlayerAnAdmin(playerid,6))
	{
		if(sscanf(params,"ui",pID,adminlvl))return SCM(playerid,SAMP_WEISS,""IINFO" /setadmin [playerid/Name][Adminlevel]");
	    if(adminlvl<0||adminlvl>8)return SCM(playerid,SAMP_WEISS,""IINFO" /setadmin [playerid/Name][Adminlevel]");
	    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(Spieler[pID][pAdmin] == adminlvl)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits das angegebene Adminlevel!");
		Spieler[pID][pAdmin] = adminlvl;
		switch(Spieler[pID][pAdmin])
		{
			case 0:
			{
				if(Spieler[playerid][pAdminOnduty] == true)
				{
					Delete3DTextLabel(AdminDuty_3DText[playerid]);
					Spieler[playerid][pAdminOnduty] = false;
					SetPlayerName(playerid,Spieler[playerid][pName]);
					SetPlayerScore(playerid,GetPlayerLevel(playerid));
					if(Spieler[playerid][pMaske] == 1 && Spieler[playerid][pFraktion] != 6)
					{
						SetPlayerScore(playerid,random(50) + 122);
						format(string,sizeof(string),"Unbekannter %i",random(50) + 122);
						SetPlayerName(playerid,string);
					}
					if(Spieler[playerid][pDuty] == 4 && Spieler[playerid][pFraktion] != 6)
					{
						SetPlayerScore(playerid,random(50) + 122);
						format(string,24,"SWAT %i",random(50) + 122);
						SetPlayerName(playerid,string);
					}
					if(Spieler[playerid][pDuty] == 4 && Spieler[playerid][pFraktion] == 6 && Spieler[playerid][pMaske] == 1)
					{
						SetPlayerScore(playerid,random(50) + 122);
						format(string,24,"SEAL %i",random(50) + 122);
						SetPlayerName(playerid,string);
					}
					if(Spieler[playerid][pDuty] == 5 && Spieler[playerid][pFraktion] == 6 && Spieler[playerid][pMaske] == 1)
					{
						SetPlayerScore(playerid,random(50) + 122);
						format(string,24,"RANGER %i",random(50) + 122);
						SetPlayerName(playerid,string);
					}
				}
			}
		}
		format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS"  hat dir soeben das Adminlevel "IINFO2"%s"#HTML_WEISS" zugewiesen.",Spieler[playerid][pName],Adminrang(pID));
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""ACINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS"  soeben das Adminlevel "IINFO2"%s"#HTML_WEISS" zugewiesen.",Spieler[pID][pName],Adminrang(pID));
		SCM(playerid,SAMP_WEISS,string);
		SaveAccount(pID);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht den Rang dazu!");
}
COMMAND:setschein(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	new pID,string[128],cmd[30];
	if(sscanf(params,"us[30]",pID,cmd))return SCM(playerid,SAMP_WEISS,""IINFO" /setschein [playerid/Name][Auto/Motorrad/Boot/Flug/Heli/Waffen/Perso/Angel/Roller/Alle]");
 	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(strcmp(cmd,"Auto",true) == 0)
	{
		if(Spieler[pID][pAutoLic] != 0)return SCM(playerid,SAMP_WEISS,""IINFO"Spieler besitzt bereits den Führerschein!");
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir den Führerschein.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) den Führerschein überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pAutoLic] = 1;
		return 1;
	}
	if(strcmp(cmd,"Motorrad",true) == 0)
	{
		if(Spieler[pID][pBikeLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Motorradschein!");
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir den Motorradschein.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) den Motorradschein überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pBikeLic] = 1;
		return 1;
	}
	if(strcmp(cmd,"Boot",true) == 0)
	{
		if(Spieler[pID][pBoatLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Bootsschein!");
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir den Bootsschein.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) den Bootsschein überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pBoatLic] = 1;
		return 1;
	}
	if(strcmp(cmd,"Flug",true) == 0)
	{
		if(Spieler[pID][pPlaneLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Flugzeugschein!");
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir den Flugzeugschein.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) den Flugzeugschein überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pPlaneLic] = 1;
		return 1;
	}
	if(strcmp(cmd,"Heli",true) == 0)
	{
		if(Spieler[pID][pHeliLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Helikopterschein!");
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir den Helikopterschein.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) den Helikopterschein überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pHeliLic] = 1;
		return 1;
	}
	if(strcmp(cmd,"Waffen",true) == 0)
	{
		if(Spieler[pID][pWaffenLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Waffenschein!");
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir den Waffenschein.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) den Waffenschein überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pWaffenLic] = 3;
		SetPlayerWaffenSkill(pID);
	    return 1;
	}
	if(strcmp(cmd,"Angel",true) == 0)
	{
		if(Spieler[pID][pFishingLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Angelschein!");
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir den Angelschein.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) den Angelschein überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pFishingLic] = 1;
	    return 1;
	}
	if(strcmp(cmd,"Perso",true) == 0)
	{
		if(Spieler[pID][pPersoLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Personalausweis!");
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir den Personalauweis.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) den Personalauweis überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pPersoLic] = 1;
		return 1;
	}
	if(strcmp(cmd,"Roller",true) == 0)
	{
		if(Spieler[pID][pBikeLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Rollerschein!");
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir den Rollerschein.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) den Rollerschein überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pRollerLic] = 1;
		return 1;
	}
	if(strcmp(cmd,"Alle",true) == 0)
	{
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) gibt dir alle Scheine/Lizensen.",Spieler[playerid][pName],playerid);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du hast dem Spieler %s (ID:%i) alle Scheine/Lizensen überreicht.",Spieler[pID][pName],pID);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pPersoLic] = 1;
		Spieler[pID][pAutoLic] = 1;
		Spieler[pID][pBikeLic] = 1;
		Spieler[pID][pBoatLic] = 1;
		Spieler[pID][pPlaneLic] = 1;
		Spieler[pID][pHeliLic] = 1;
		Spieler[pID][pWaffenLic] = 3;
		Spieler[pID][pFishingLic] = 1;
		Spieler[pID][pRollerLic] = 1;
		SetPlayerWaffenSkill(pID);
	    return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /setschein [playerid/Name][Auto/Motorrad/Boot/Flug/Heli/Waffen/Perso/Angel/Roller/Alle]");
}
COMMAND:job(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pAutoLic] != 1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Führerschein.");
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[650],jobtime = Spieler[playerid][pJobSperre]-gettime(),jobinviteid = ReturnJobInviteID(playerid);
	if(jobinviteid == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keinen Job annehmen!");
	//if(!isPlayerInJob(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du bist bereits in einem Job tätig.");
	if(Spieler[playerid][WorkInJob] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du arbeitest momentan und kannst somit keinen Job annehmen! (Kündigen mit /quitjob)");
	if(gettime() < jobtime)
	{
		format(string,sizeof(string),""IINFO" du kannst erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten wieder einen neuen Job annehmen!",floatround(jobtime/60),floatround(jobtime%60));
		return SCM(playerid,SAMP_WEISS,string);
	}
	if(Spieler[playerid][pPersoLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Personalausweis.");
	ShowPlayerJobAnnahme(playerid);
	return 1;
}
COMMAND:stopjob(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInJob(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Job!");
	if(Spieler[playerid][WorkInJob] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Job gestartet oder bist in keinem Aktiv!");
    Spieler[playerid][WorkInJob] = 0;
	JobExit(playerid);
    RemovePlayerFromVehicle(playerid);
    KillTimer(JobTimer[playerid]);
	return 1;
}
COMMAND:quitjob(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInJob(playerid,0))return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Job!");
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst den Job nur außerhalb eines Fahrzeugs kündigen!");
    SCM(playerid,WEISS,""IINFO" du hast deinen Job gekündigt!");
	Spieler[playerid][pJob] = 0;
	Spieler[playerid][WorkInJob] = 0;
	JobExit(playerid);
	return 1;
}
COMMAND:quitflat(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(Spieler[playerid][pHandy] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt kein Handy.");
	if(Spieler[playerid][pHandyFlat] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Flatrate mit einem Mobilfunkanbieter abgeschlossen");
    SCM(playerid,WEISS,""IINFO" du hast deine Flatrate gekündigt!");
	Spieler[playerid][pHandyFlat] = 0;
    Spieler[playerid][pHandyBuyByBiz] = 0;
    UpdateHandyTextdraw(playerid);
	return 1;
}
COMMAND:unfreeze(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],reason[31];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /unfreeze [playerid/Name][Grund]");
    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /unfreeze [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	Spieler[pID][pFreezed] = false;
	TogglePlayerControllable(pID,true);
	Spieler[pID][pCuffed] = 0;
	Spieler[pID][pTazerd] = 0;
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat dich unfreezt. Grund: %s",Spieler[playerid][pName],playerid,reason);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" du hast %s (ID:%i) unfreezt. Grund: %s",Spieler[pID][pName],pID,reason);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:freeze(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],reason[31];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
	if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /freeze [playerid/Name][Grund]");
	if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /freeze [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[playerid][pAdmin] == 2)
	{
		if(GetPlayerLevel(pID) > 3)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur Level 1´er 2´er oder 3´er freezen!");
	}
	Spieler[pID][pFreezed] = true;
	TogglePlayerControllable(pID,false);
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat dich gefreezt. Grund: %s",Spieler[playerid][pName],playerid,reason);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" du hast %s (ID:%i) gefreezt. Grund: %s",Spieler[pID][pName],pID,reason);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:werbung(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[64];
	if(IsPlayerInRangeOfPoint(playerid,2,1555.6145,-1249.4934,17.4063) || IsPlayerInRangeOfPoint(playerid,2,1190.7998,-895.6903,48.0625))
	{
		if(gettime() < Spieler[playerid][pPremium])
		{
			if(gettime() < NextAdvertise)
			{
				new time = NextAdvertise - gettime();
				format(string,sizeof(string),""IINFO" du kannst nur alle "IINFO2"%i:%02d"#HTML_WEISS" Minuten eine Werbung schreiben.",time/60,time%60);
				return SCM(playerid,SAMP_WEISS,string);
			}
		}
		else
		{
			if(gettime() < (NextAdvertise/2))
			{
				new time = (NextAdvertise/2) - gettime();
				format(string,sizeof(string),""IINFO" du kannst nur alle "IINFO2"%i:%02d"#HTML_WEISS" Minuten eine Werbung schreiben.",time/60,time%60);
				return SCM(playerid,SAMP_WEISS,string);
			}
		}
		if(GetPlayerLevel(playerid) < 3)return SCM(playerid,SAMP_WEISS,"Dein Level reicht nicht aus.(mindestens Level 3)");
	    if(Spieler[playerid][pMuted] == 1)
		{
			format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
			return SCM(playerid,WEISS,string);
		}
		ShowPlayerDialog(playerid,DIALOG_ADWERBERKATERGORIEN,DIALOG_STYLE_LIST,"|-|_Werbung_|-|","Ich Biete...\nIch Suche...\nDein Text gestalten...","Auswählen","Abbrechen");
	}
	else
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Werbepunkt.");
	    return 1;
	}
	return 1;
}

COMMAND:login(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new string[128];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	if(login == false)
	{
		login = true;
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat das Einloggen verhindert.",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(0x4BB400FF,string);
	}
	else
	{
		login = false;
		format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat das Einloggen freigegeben.",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(0x4BB400FF,string);
	}
	return 1;
}

