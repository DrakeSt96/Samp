	return 1;
}
COMMAND:fishhelp(playerid,const params[])
{
	#pragma unused params
	new string[500];
	if(Spieler[playerid][pAngel] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Angel!");
	strcat(string,""#HTML_BLAU"Verkaufen{FFFFFF}:\n/sellfish\n\n"#HTML_BLAU"Inventar/Wegwerfen/Fischen{FFFFFF}:\n/fishinfo | /threwback | /fish\n");
	strcat(string,"{FFFFFF}INFO:{C9C9C9}\n");
    strcat(string,"{C9C9C9}Um angeln zu können musst du dir Köder in einem 24/7 Market anschaffen.\nAngeln kann man am Los Santos Pier.");
    ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,""#HTML_BLAU""#SERVERNAME"{FFFFFF} Fischshilfe",string,"Zurück","Abbrechen");
	return 1;
}
COMMAND:firmakasse(playerid,const params[])
{
	#pragma unused params
	new org = Spieler[playerid][pOrgMember];
	if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Firma.");
	strdel(edit_2,0,sizeof(edit_2));
	strcat(edit_2,""#HTML_BLAU"1."#HTML_WEISS" Firmakasse | einzahlen\n");
	strcat(edit_2,""#HTML_BLAU"2."#HTML_WEISS" Firmakasse | auszahlen\n");
	strcat(edit_2,""#HTML_BLAU"3."#HTML_WEISS" Firmakasse | Inhalt\n");
	ShowPlayerDialog(playerid,DIALOG_FIRMKASSE,DIALOG_STYLE_LIST,""ClanTagDialoge" Firmakasse",edit_2,"Weiter","Abbrechen");
	return 1;
}
COMMAND:orghelp(playerid,const params[])
{
	#pragma unused params
    new org = Spieler[playerid][pOrgMember],string[1000];
	if(org == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Firma.");
	format(string,sizeof(string),""#HTML_WEISS"Unternehmen: "IINFO2"%s\n",OrgInfo[org][OrgName]);
	format(string,sizeof(string),"%s"#HTML_WEISS"Firmabeschreibung: "IINFO2"%s\n",string,OrgInfo[org][OrgMotto]);
	format(string,sizeof(string),"%s"#HTML_WEISS"Firmbesitzer: "IINFO2"%s\n",string,OrgInfo[org][OrgOwner]);
	format(string,sizeof(string),"%s"#HTML_WEISS"Firmkasse: "IINFO2"%i$\n\n",string,OrgInfo[org][OrgKasse]);
	strcat(string,""#HTML_WEISS" /fc "#HTML_GRAU"- um mit Mitglieder deiner Firma zu schreiben.\n");
	strcat(string,""#HTML_WEISS" /firmmitglieder "#HTML_GRAU"- um alle Mitglieder deiner Firma zu betrachten.\n");
	strcat(string,""#HTML_WEISS" /firmleave "#HTML_GRAU"- um die Firma zu verlassen.\n");
	strcat(string,""#HTML_WEISS" /firmakasse "#HTML_GRAU"- um die Firmkasse zu verwalten.\n\n");
	if(Spieler[playerid][pOrgLeader] == org)
	{
	    strcat(string,""#HTML_WEISS" - Unternehmer Befehle -\n");
		strcat(string,""#HTML_WEISS" /firminvite "#HTML_GRAU"- um einen Spieler in deiner Firma aufzunehmen.\n");
		strcat(string,""#HTML_WEISS" /firmuninvite "#HTML_GRAU"- um einen Spieler aus deiner Firma entlassen.\n");
		strcat(string,""#HTML_WEISS" /firmleiter "#HTML_GRAU"- um einen Spieler in deiner Firma als Leiter zu machen.\n");
		strcat(string,""#HTML_WEISS" /firmunleiter "#HTML_GRAU"- um einen Spieler als Leiter deiner Firma zu Feuern.\n");
		strcat(string,""#HTML_WEISS" /firmbeschreibung "#HTML_GRAU"- um die Firmabeschreibung zu ändern.\n");
		strcat(string,""#HTML_WEISS" /firmname "#HTML_GRAU"- um die Firma umzubenennen.\n");
	}
	format(SP_INFO,sizeof(SP_INFO),""ClanTagDialoge" Unternehmen | "IINFO2"%s",OrgInfo[org][OrgName]);
	ShowPlayerDialog(playerid,DIALOG_HILFE_OPTIONAL,DIALOG_STYLE_MSGBOX,SP_INFO,string,"Okay","");
	return 1;
}
