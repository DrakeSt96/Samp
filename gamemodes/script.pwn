stock Float:GetPlayerACHealth(playerid)
{
	new Float:health;
	GetPlayerHealth(playerid,health);
	return health;
}

stock Float:GetPlayerACArmour(playerid)
{
	new Float:armour;
	GetPlayerArmour(playerid,armour);
	return armour;
}

stock Float:CheckNeRDrunkLevel(playerid)
{
    new Float:Drunk;
    if(GetPlayerDrunkLevel(playerid) > 2000)
    {
    	Drunk = (GetPlayerDrunkLevel(playerid)/8000);
    }
    else Drunk = 0.0;
 	return Drunk;
}
