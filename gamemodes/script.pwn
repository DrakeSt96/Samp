						ACMoney(playerid,-FvehicleBuyVehicles[i][Preis]);
						format(string,sizeof(string),""IINFO" du hast das Fahrzeug %s für %i$ gekauft.",FvehicleBuyVehicles[i][Name],FvehicleBuyVehicles[i][Preis]);
						SCM(playerid,SAMP_WEISS,string);
