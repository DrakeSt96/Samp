COMMAND:givegun(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new pID,waffe,muni,string[128];
    if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(sscanf(params,"uii",pID,waffe,muni))return SCM(playerid,SAMP_WEISS,""IINFO" /givegun [playerid/Name][Waffenid][Munition]");
    if(waffe<1||waffe>46)return SCM(playerid,SAMP_WEISS,"Waffe nur von 1 bis 46 vergebar.");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	format(string,sizeof(string),""ACINFO" Du hast dem Spieler %s (ID:%i) die Waffe %s mit %i Munition gegeben.",Spieler[pID][pName],pID,SpielerWaffenName(waffe),muni);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat dir die Waffe %s mit %i Munition gegeben.",Spieler[playerid][pName],playerid,SpielerWaffenName(waffe),muni);
	SCM(pID,SAMP_WEISS,string);
    GiveWeapon(pID,waffe,muni,false);
    return 1;
}

COMMAND:waffenschein(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new wlevel,string[128];
    if(!IsPlayerInRangeOfPoint(playerid,2,252.0674,116.7470,1003.2188))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier keinen Waffenschein machen.");
    if(sscanf(params,"i",wlevel))return SCM(playerid,SAMP_WEISS,""IINFO" /waffenschein [Klasse]");
	if(wlevel<1||wlevel>3)return SCM(playerid,SAMP_WEISS,""IINFO" /waffenschein [Klasse 1-3]");
	if(Spieler[playerid][pWaffenLic] == wlevel)
	{
		format(string,sizeof(string),""IINFO" du besitzt bereits einen Waffenschein-Klasse %i.",wlevel);
		return SCM(playerid,SAMP_WEISS,string);
	}
	if(wlevel < Spieler[playerid][pWaffenLic])
	{
		format(string,sizeof(string),""IINFO" du besitzt bereits einen Waffenschein besserer Klasse.",wlevel);
		return SCM(playerid,SAMP_WEISS,string);
	}
  	if(GetPlayerLevel(playerid) < (WEAPON_CLASS_LEVEL*wlevel))
 	{
	 	format(string,sizeof(string),""IINFO" du brauchst um dir die Waffenscheinklasse auf %i zu erhöhen Level %i.",wlevel,WEAPON_CLASS_LEVEL*wlevel);
	 	return SCM(playerid,SAMP_WEISS,string);
 	}
 	if(!isPlayerInFrakt(playerid,1) || !isPlayerInFrakt(playerid,2) || !isPlayerInFrakt(playerid,6) || !isPlayerInFrakt(playerid,16))
	{
	  	if((GetACMoney(playerid) - fsteuern[WeapPrice]*wlevel) < 0)
	  	{
		  	PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
		  	format(string,sizeof(string),"Nicht genug Geld. Waffenklasse %i kostet %i$",wlevel,fsteuern[WeapPrice]*wlevel);
		 	return SCM(playerid,SAMP_WEISS,string);
	  	}
	  	format(string,sizeof(string),"Herzlichen Glückwunsch zum Kauf des Waffenscheins der Klasse %i/%i.",wlevel,WEAPON_CLASS_LEVEL);
	    SCM(playerid,0x4BB400FF,string);
	  	ACMoney(playerid,-fsteuern[WeapPrice]*wlevel);
	  	fverwaltungen[16][Geld] += fsteuern[WeapPrice]*wlevel;
	}
  	else
  	{
		format(string,sizeof(string),"Herzlichen Glückwunsch zum Kauf des Waffenscheins der Klasse %i/%i.",wlevel,WEAPON_CLASS_LEVEL);
	    SCM(playerid,0x4BB400FF,string);
		format(string,sizeof(string),""IINFO" da du für den Staat arbeitest erhälst du eine Ermäßigung von %i$!",(fsteuern[WeapPrice]*wlevel)/2);
	    SCM(playerid,0x4BB400FF,string);
	    ACMoney(playerid,-(fsteuern[WeapPrice]*wlevel)/2);
	  	fverwaltungen[16][Geld] += (fsteuern[WeapPrice]*wlevel)/2;
	}
	PlayerPlaySound(playerid,1183,0.0,0.0,0.0);
  	SetTimerEx("StopPlayerPlaySound",5000,false,"i",playerid);
  	Spieler[playerid][pWaffenLic] = wlevel;
    SetPlayerWaffenSkill(playerid);
  	return 1;
}

COMMAND:gwdnote(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128];
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /gwdnote [playerid/Name]");
	if(pID == playerid) return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir deine Grundwehrdienstnote nicht selber zeigen.");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	format(string,sizeof(string),""IINFO" du zeigst %s deine Grundwehrdienstnote",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"||_______________________Grundwehrdienstnote von %s_______________________||",SpielerName(playerid));
    SCM(pID,WEISS,string);
	format(string,sizeof(string),"Grundwehrdienstnote: %i",Spieler[playerid][pGrundwehrdienst]);
	SCM(pID,WEISS,string);
	format(string,sizeof(string),"** %s zeigt %s seine Grundwehrdienstnote **",SpielerName(playerid),SpielerName(pID));
	PlayerTalkPublic(playerid,SAMP_WEISS,string,10);
	return 1;
}

COMMAND:eh(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /eh [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	format(string,sizeof(string),""IINFO" du versuchst %s mit Erster Hilfe zu versorgen.",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s versucht dich mit Erster Hilfe zu versorgen.",SpielerName(playerid));
	SCM(pID,WEISS,string);
	format(string,sizeof(string),"** %s versucht %s mit Erster Hilfe zu versorgen. **",SpielerName(playerid),SpielerName(pID));
	PlayerTalkPublic(playerid,SAMP_WEISS,string,10);
	return 1;
}

