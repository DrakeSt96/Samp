		if(rows)
		{
			while(count<rows)
			{
				cache_get_field_content(count,"Name",result);
				new pID = GetPlayerID(result);
				if(pID != -1)
				{
					Spieler[pID][pSpawn] = 0;
					Spieler[pID][pHotel] = 0;
				}
				else
				{
					format(query,sizeof(query),"UPDATE spieler SET Spawn='0',Hotel='0' WHERE Name='%s'",result);
				    mysql_function_query(MySQL_R394,query,false,"","");
			    }
			    count++;
			}
		}
	    return 1;
	}
