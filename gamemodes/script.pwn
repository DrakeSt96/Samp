							{
							    format(string,sizeof(string),"{C9C9C9}Willkommen beim {458B00}Fraktionsfahrzeughändler{C9C9C9}\n\nInformationen:\nFahrzeug: {458B00}%s\n{C9C9C9}Preis: {458B00}%d${C9C9C9}\nVerbrauch: {458B00}%.2fL/Km{C9C9C9}\nTankgröße: {458B00}%.2fL{C9C9C9}\nMöchtest du das Fahrzeug kaufen ?",FvehicleBuyVehicles[i][Name],FvehicleBuyVehicles[i][Preis],VehicleInfo[FvehicleBuyVehicles[i][modelid]-400][vtankverbrauch],VehicleInfo[FvehicleBuyVehicles[i][modelid]-400][vtankvolumen]);
								ShowPlayerDialog(playerid,DIALOG_VEHICLEBUY,DIALOG_STYLE_MSGBOX,"Fahrzeugkauf",string,"Kaufen","Zurück");
								return 1;
							}
						}
					}
					case 1://probe
					{
						if(!IsPlayerInAnyVehicle(playerid))return 1;
