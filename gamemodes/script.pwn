       			ShowPlayerDialog(playerid,DIALOG_FKASSE_NORM_AUSZAHLEN,DIALOG_STYLE_LIST,"Fraktionsbank_Auszahlen",""#HTML_BLAU"1."#HTML_WEISS" Geld\n"#HTML_BLAU"2."#HTML_WEISS" Opium Tabletten\n"#HTML_BLAU"3."#HTML_WEISS" Gangja's\n"#HTML_BLAU"4."#HTML_WEISS" Kokain\n"#HTML_BLAU"5."#HTML_WEISS" C4\n"#HTML_BLAU"6."#HTML_WEISS" Materials\n"#HTML_BLAU"7."#HTML_WEISS" Spice","Auswählen","Zurück");
			    return 1;
		    }
		    if(response == 1)
		    {
			    if(!strlen(inputtext) || strlen(inputtext) >= 8)
			    {
				    format(string,sizeof(string),"Bitte gebe den gewünschten Betrag an Spice (vorhandenes Spice %ig) ein.\nDen du ausgezahlt haben möchtest.",fverwaltungen[Spieler[playerid][pFraktion]][Spice]);
					ShowPlayerDialog(playerid,DIALOG_FKASSE_AUSZAHLEN_Spice,DIALOG_STYLE_INPUT,"Auszahlung von Spice",string,"Auszahlen","Zurück");
				    return 1;
				}
				if(!IsNumeric(inputtext))
				{
					format(string,sizeof(string),"Bitte gebe den gewünschten Betrag an Spice (vorhandenes Spice %ig) ein.\nDen du ausgezahlt haben möchtest.",fverwaltungen[Spieler[playerid][pFraktion]][Spice]);
					ShowPlayerDialog(playerid,DIALOG_FKASSE_AUSZAHLEN_Spice,DIALOG_STYLE_INPUT,"Auszahlung von Spice",string,"Auszahlen","Zurück");
				    return 1;
			    }
				else
				{
					if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
					if(fverwaltungen[Spieler[playerid][pFraktion]][Spice] < vspice)
					{
						SCM(playerid,SAMP_WEISS,"Fraktionskasse beinhaltet nicht so viel Spice.");
						format(string,sizeof(string),"Bitte gebe den gewünschten Betrag an Spice (vorhandenes Spice %ig) ein.\nDen du ausgezahlt haben möchtest.",fverwaltungen[Spieler[playerid][pFraktion]][Spice]);
						return ShowPlayerDialog(playerid,DIALOG_FKASSE_AUSZAHLEN_Spice,DIALOG_STYLE_INPUT,"Auszahlung von Spice",string,"Auszahlen","Zurück");
					}
					if((Spieler[playerid][pSpice] + vspice) > 500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
					fverwaltungen[Spieler[playerid][pFraktion]][Spice] -= vspice;
					Spieler[playerid][pSpice] += vspice;
     				ShowPlayerDialog(playerid,DIALOG_FKASSE_NORM_AUSZAHLEN,DIALOG_STYLE_LIST,"Fraktionsbank_Auszahlen",""#HTML_BLAU"1."#HTML_WEISS" Geld\n"#HTML_BLAU"2."#HTML_WEISS" Opium Tabletten\n"#HTML_BLAU"3."#HTML_WEISS" Gangja's\n"#HTML_BLAU"4."#HTML_WEISS" Kokain\n"#HTML_BLAU"5."#HTML_WEISS" C4\n"#HTML_BLAU"6."#HTML_WEISS" Materials\n"#HTML_BLAU"7."#HTML_WEISS" Spice","Auswählen","Zurück");
					format(string,sizeof(string),""IINFO" du hast %ig Spice in die Fraktionskasse ausgezahlt! Fraktionskassenstand(Spice): %ig",vspice,fverwaltungen[Spieler[playerid][pFraktion]][Spice]);
					SCM(playerid,WEISS,string);
					format(string,sizeof(string),"%s -- Spice Fkassenstand(nach Auszahlung): %i | Spieler: %s * Auszahlung: %i | Fkassenstand(nach Auszahlung): %i",FraktionsName(Spieler[playerid][pFraktion]),fverwaltungen[Spieler[playerid][pFraktion]][Spice]+vspice,Spieler[playerid][pName],vspice,fverwaltungen[Spieler[playerid][pFraktion]][Spice]);
