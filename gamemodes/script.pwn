	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(!isPlayerInFrakt(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(!FraktionsDuty(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier nicht in/aus den Dienst gehen.");
