	    case DIALOG_KEYENTRY:
	    {
		    if(response == 0)return 1;
		    else
		    {
			    if(!strlen(inputtext))return ShowPlayerDialog(playerid,DIALOG_KEYENTRY,DIALOG_STYLE_PASSWORD,"Gatecomputer","Passworteingabe:","Absenden","Abbrechen");
			    if(strval(inputtext) != GeneratedKey)
			    {
				    ForEachPlayer(i)
					{
						if(IsPlayerConnected(i) && !IsPlayerNPC(i))
						{
							if(Spieler[i][pDuty] != 0)
							{
								if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
							 	{
									if(Spieler[i][pFunkgeraet] == 1 || (IsAFraktionsVeh(i) != -1 && Fahrzeug[IsAFraktionsVeh(i)][Fraktion] == Spieler[i][pFraktion]) || FraktionsAktenPCs(i))
									{
										SCM(i,DUNKELBLAU,"HQ: Es wurde eine falsche Passwort eingabe an einem Tor des Alkatrazes ermittelt..");
									}
								}
							}
						}
					}
					SCM(playerid,SAMP_WEISS,"Falsche Eingabe!");
				    return ShowPlayerDialog(playerid,DIALOG_KEYENTRY,DIALOG_STYLE_PASSWORD,"Gatecomputer","Passworteingabe:","Absenden","Abbrechen");
			    }
			    if(IsPlayerInRangeOfPoint(playerid,1.5,KeyPedPosALKA[0][0],KeyPedPosALKA[0][1],KeyPedPosALKA[0][2]))
			    {
				    MoveDynamicObject(tor[21],2571.5300,-1302.5399,1044.3400,2);
					MoveDynamicObject(tor[22],2571.1499,-1302.5300,1044.3400,2);
					torstatus[21] = 1;
					torstatus[22] = 1;
					PlayerHearMusicInRange(2571.1499,-1302.5300,1044.3400,1035,5,1,500);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
				    SetTimerEx("MoveGate",10000,false,"i",7);
				}
			    if(IsPlayerInRangeOfPoint(playerid,1.5,KeyPedPosALKA[1][0],KeyPedPosALKA[1][1],KeyPedPosALKA[1][2]))
			    {
					MoveDynamicObject(tor[21],2571.5300,-1302.5399,1044.3400,2);
					MoveDynamicObject(tor[22],2571.1499,-1302.5300,1044.3400,2);
					torstatus[21] = 1;
					torstatus[22] = 1;
					PlayerHearMusicInRange(2571.1499,-1302.5300,1044.3400,1035,5,1,500);//x,y,z,soundid,radius,timer an = 1 wenn aus = 0,zeit wann timer music/sound beendet
