					if((HausInfo[haus][haus_Kokain] - Menge) < 0)return SCM(playerid,SAMP_WEISS,"Nicht genug Kokain in der Hauskasse.");
				    if((Spieler[playerid][pKokain] + Menge) > 2500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
					HausInfo[haus][haus_Kokain] -= Menge;
					Spieler[playerid][pKokain] += Menge;
					format(string,sizeof(string),""IINFO" du hast %ig Kokain aus deiner Hauskasse ausgezahlt! Hauskassenstand(Kokain): %ig",Menge,HausInfo[haus][haus_Kokain]);
					SCM(playerid,SAMP_WEISS,string);
					ShowPlayerDialog(playerid,HDIA_AUSWAHL_AUSZAHLEN,DIALOG_STYLE_LIST,"Hausverwaltung (Auszahlung)","Auszahlen von Geld\nAuszahlen von Opium Pillen\nAuszahlen von Ganja\nAuszahlen von C4\nAuszahlen von Kokain\nAuszahlen von Materials\nAuszahlen von Spice","Einzahlen","Zurück");
					return 1;
				}
			}
		}

	    case DIALOG_APORTEN:
		{
			new string[128];
		    if(response == 0)return 1;
			if(listitem < 0 || listitem >= sizeof(APorten))return SCM(playerid,SAMP_WEISS,""IINFO" ungueltige Auswahl.");
		    if(response == 1)
		    {
			    if(IsPlayerInAnyVehicle(playerid))
				{
					new seatid = GetPlayerVehicleSeat(playerid);
					SetPlayerVirtualWorld(playerid,0);
					SetPlayerPosEx(playerid,APorten[listitem][APortX],APorten[listitem][APortY],APorten[listitem][APortZ]);
					SetPlayerInterior(playerid,0);
					SetVehiclePosEx(GetPlayerVehicleID(playerid),APorten[listitem][APortX],APorten[listitem][APortY],APorten[listitem][APortZ]);
					SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),0);
					LinkVehicleToInterior(GetPlayerVehicleID(playerid),0);
					PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),seatid);
				}
				else
				{
					SetPlayerVirtualWorld(playerid,0);
				    SetPlayerPosEx(playerid,APorten[listitem][APortX],APorten[listitem][APortY],APorten[listitem][APortZ]);
				    SetPlayerInterior(playerid,0);
				}
				format(string,sizeof(string),""IINFO" du hast dich zum Portpunkt "IINFO2"%s"#HTML_WEISS" geportet.",APorten[listitem][Portname]);
				SCM(playerid,SAMP_WEISS,string);
				return 1;
		    }
	    }
