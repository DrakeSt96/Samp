							format(string,sizeof(string),"- %s",inputtext);
							SCM(playerid,REPORTANDAFKCOLOR,string);
							SCM(playerid,REPORTANDAFKCOLOR,""IINFO" du kannst deinen aktuellen Report mit '/rtclose' beenden.");
							format(string,sizeof(string),"%s (ID:%i) hat einen Report (Fraktion) abgesendet.(/reporten => Fraktion)",SpielerName(playerid),playerid);
							SendAdminMessage(GELB,string);
							Spieler[playerid][pAReport] = 1;
