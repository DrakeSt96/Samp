COMMAND:fh(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im AFK-Modus und kannst somit keine Befehle nutzen."),SCM(playerid,SAMP_WEISS,""IINFO" /back");
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[1000],counter = 0;
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
    for(new haus=1;haus<MAX_HAUS;haus++)
    {
	    if(HausInfo[haus][haus_Owned] == 0 && HausInfo[haus][hauscreatet] == 1)
	    {
		    format(string,sizeof(string),"%sHausnummer: "IINFO2"%i"#HTML_WEISS" | Mieterslots: "IINFO2"%i"#HTML_WEISS" | Kosten: "IINFO2"%i$"#HTML_WEISS"\n",string,haus,HausInfo[haus][haus_slots],HausInfo[haus][haus_preis]);
		    //SCM(playerid,SAMP_WEISS,string);
		    ShowPlayerDialog(playerid,9999,DIALOG_STYLE_LIST,""ClanTagDialoge" Alle Häuser",string,"Okay","");
		    counter++;
	    }
    }
    if(counter == 0)return SCM(playerid,SAMP_WEISS,"Keine vorhanden!");
	return 1;
}
COMMAND:gotohaus(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],cmd[25],id;
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
    if(sscanf(params,"s[25]i",cmd,id))return SCM(playerid,SAMP_WEISS,""IINFO" /gotohaus [Haus/Business/Schwarzmarkt][Hausnummer/ID/ID]");
    if(strcmp(cmd,"Haus",true) == 0)
	{
		if(id >= MAX_HAUS)return SCM(playerid,SAMP_WEISS,"Hausnummer über maximaler Hausanzahl!");
		if(HausInfo[id][hauscreatet] != 1)return SCM(playerid,SAMP_WEISS,"Haus existiert nicht!");
		if(IsPlayerInAnyVehicle(playerid))
		{
			new seatid = GetPlayerVehicleSeat(playerid);
			SetPlayerPosEx(playerid,HausInfo[id][haus_x],HausInfo[id][haus_y],HausInfo[id][haus_z]);
			SetVehiclePosEx(GetPlayerVehicleID(playerid),HausInfo[id][haus_x],HausInfo[id][haus_y],HausInfo[id][haus_z]);
			PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),seatid);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),0);
			LinkVehicleToInterior(GetPlayerVehicleID(playerid),0);
			format(string,sizeof(string),""IINFO" du hast dich zur Hausnummer "IINFO2"%i"#HTML_WEISS" geportet.",id);
			SCM(playerid,SAMP_WEISS,string);
		}
		else
		{
			SetPlayerPosEx(playerid,HausInfo[id][haus_x],HausInfo[id][haus_y],HausInfo[id][haus_z]);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			format(string,sizeof(string),""IINFO" du hast dich zur Hausnummer "IINFO2"%i"#HTML_WEISS" geportet.",id);
			SCM(playerid,SAMP_WEISS,string);
		}
		return 1;
	}
	if(strcmp(cmd,"Business",true) == 0)
	{
		if(id >= MAX_BIZ)return SCM(playerid,SAMP_WEISS,"Bizid über maximaler Businessanzahl!");
		if(BizInfo[id][bizcreatet] != 1)return SCM(playerid,SAMP_WEISS,"Business existiert nicht.");
		if(IsPlayerInAnyVehicle(playerid))
		{
			new seatid = GetPlayerVehicleSeat(playerid);
			SetPlayerPosEx(playerid,BizInfo[id][biz_x],BizInfo[id][biz_y],BizInfo[id][biz_z]);
			SetVehiclePosEx(GetPlayerVehicleID(playerid),BizInfo[id][biz_x],BizInfo[id][biz_y],BizInfo[id][biz_z]);
			PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),seatid);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),0);
			LinkVehicleToInterior(GetPlayerVehicleID(playerid),0);
			format(string,sizeof(string),""IINFO" du hast dich zum Business %i geportet.",id);
			SCM(playerid,SAMP_WEISS,string);
		}
		else
		{
			SetPlayerPosEx(playerid,BizInfo[id][biz_x],BizInfo[id][biz_y],BizInfo[id][biz_z]);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			format(string,sizeof(string),""IINFO" du hast dich zum Business %i geportet.",id);
			SCM(playerid,SAMP_WEISS,string);
		}
		return 1;
	}
	if(strcmp(cmd,"Schwarzmarkt",true) == 0)
	{
		if(id >= MAX_SMARKETS)return SCM(playerid,SAMP_WEISS,"Schwarzmarkt über maximaler Schwarzmarktanzahl!");
		if(SmarkInfo[id][screatet] != 1)return SCM(playerid,SAMP_WEISS,"Schwarzmarkt existiert nicht.");
		if(IsPlayerInAnyVehicle(playerid))
		{
			new seatid = GetPlayerVehicleSeat(playerid);
			SetPlayerPosEx(playerid,SmarkInfo[id][sx],SmarkInfo[id][sy],SmarkInfo[id][sz]);
			SetVehiclePosEx(GetPlayerVehicleID(playerid),SmarkInfo[id][sx],SmarkInfo[id][sy],SmarkInfo[id][sz]);
			PutPlayerInVehicleEx(playerid,GetPlayerVehicleID(playerid),seatid);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			SetVehicleVirtualWorld(GetPlayerVehicleID(playerid),0);
			LinkVehicleToInterior(GetPlayerVehicleID(playerid),0);
			format(string,sizeof(string),""IINFO" du hast dich zum Schwarzmarkt %i geportet.",id);
			SCM(playerid,SAMP_WEISS,string);
		}
		else
		{
			SetPlayerPosEx(playerid,SmarkInfo[id][sx],SmarkInfo[id][sy],SmarkInfo[id][sz]);
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			format(string,sizeof(string),""IINFO" du hast dich zum Schwarzmarkt %i geportet.",id);
			SCM(playerid,SAMP_WEISS,string);
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /gotohaus [Haus | Business] [Straßennummer]");
}
COMMAND:f(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new text[160],string[650];
	if(Spieler[playerid][pFraktion] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Fraktion.");
	if(Spieler[playerid][pMuted] == 1)
	{
		format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		return SCM(playerid,WEISS,string);
	}
	if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /f(amily) [Text]");
	if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /f(amily) [Text darf maximal 90 Zeichen beinhalten]");
	for(new b=0;b<sizeof(BadWord);b++)
	{
		if(strfind(text,BadWord[b],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /f(raktionschat)",BadWord[b],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
	}
	new strpos = strfind(text,"www",true);
	if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
	{
		strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
		return 1;
	}
	format(string,sizeof(string),""#HTML_ORANGE"[FraktionChat]:"#HTML_WEISS" %s "#IINFO2"%s"#HTML_WEISS": %s",SpielerFraktionsRangName(playerid),SpielerName(playerid),text);
    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
	format(string,sizeof(string),"%s %s: %s",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],text);
	Log("FraktionChat.txt",string);
	return 1;
}
COMMAND:fl(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new text[91],string[128];
    if(Spieler[playerid][pFraktion] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Fraktion.");
	if(!isPlayerAMember(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Fraktionsrang!");
	if(Spieler[playerid][pMuted] == 1)
	{
		format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		return SCM(playerid,WEISS,string);
	}
	if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /fl(fraktioninternerleaderchat) [Text]");
	if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /fl(fraktioninternerleaderchat) [Text darf maximal 90 Zeichen beinhalten]");
	for(new b=0;b<sizeof(BadWord);b++)
	{
		if(strfind(text,BadWord[b],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /fl(fraktioninternerleaderchat)",BadWord[b],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
	}
	new strpos = strfind(text,"www",true);
	if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
	{
		strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
		return 1;
	}
	format(string,sizeof(string),"**(( %s %s: %s ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],text);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(isPlayerInFrakt(i,Spieler[playerid][pFraktion]) && isPlayerAMember(i,5))
				{
					SCM(i,FLCHATCOLOR,string);
				}
				if(Spieler[i][IreadALL] == 1)
				{
					SCM(i,SAMP_WEISS,string);
				}
			}
		}
	}
	format(string,sizeof(string),"%s %s: %s",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],text);
	Log("FinterLeadersqllog",string);
	return 1;
}

