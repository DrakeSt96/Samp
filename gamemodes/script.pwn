public OnPlayerEditObject(playerid,playerobject,objectid,EDIT_RESPONSE:response,Float:fX,Float:fY,Float:fZ,Float:fRotX,Float:fRotY,Float:fRotZ)
{
	new string[124];
	if(response == EDIT_RESPONSE_FINAL)
	{
		// Spieler speichert die Veränderung
		// Speichere die Updates des Objekts hier
		if(GetPVarInt(playerid,"MoebelEditModus")==1)
		{
			for(new hobj=0;hobj<MAX_HAUSOBJECTS;hobj++)
			{
				if(HausmoebelInfo[hobj][hmmodelid] != 0 && HausmoebelInfo[hobj][hmobjectid] == GetPVarInt(playerid,"MoebelEditID"))
				{
					HausmoebelInfo[hobj][hm_x] = fX;
					HausmoebelInfo[hobj][hm_y] = fY;
					HausmoebelInfo[hobj][hm_z] = fZ;
					HausmoebelInfo[hobj][hm_rx] = fRotX;
					HausmoebelInfo[hobj][hm_ry] = fRotY;
					HausmoebelInfo[hobj][hm_rz] = fRotZ;
					SetDynamicObjectPos(HausmoebelInfo[hobj][hmobjectid],HausmoebelInfo[hobj][hm_x],HausmoebelInfo[hobj][hm_y],HausmoebelInfo[hobj][hm_z]);
					SetDynamicObjectRot(HausmoebelInfo[hobj][hmobjectid],HausmoebelInfo[hobj][hm_rx],HausmoebelInfo[hobj][hm_ry],HausmoebelInfo[hobj][hm_rz]);
					format(string,sizeof(string),"MÖBELSYSTEM:{FAFAFA} Editierung '%s' wurde gespeichert.",HausmoebelInfo[hobj][hmmoebel_name]);
					SCM(playerid,0xFFFF9FFF,string);
					SetPVarInt(playerid,"MoebelEditModus",0);
					return 1;
				}
			}
		}
		else
		{
			Spieler[playerid][pMoebelX] = fX;
			Spieler[playerid][pMoebelY] = fY;
			Spieler[playerid][pMoebelZ] = fZ;
			Spieler[playerid][pMoebelRX] = fRotX;
			Spieler[playerid][pMoebelRY] = fRotY;
			Spieler[playerid][pMoebelRZ] = fRotZ;
			format(string,sizeof(string),"{FAFAFA}Möchtest du '%s' kaufen?\n\nPreis {FFFF9F}$%s{FAFAFA}",Moebelstore[Spieler[playerid][pMoebelListitem]][moebel_name],MoneyString(Moebelstore[Spieler[playerid][pMoebelListitem]][moebel_preis]));
			ShowPlayerDialog(playerid,HDIA_MOEBEL_BEST,DIALOG_STYLE_MSGBOX,"{FFFF9F}"#SERVERNAME":{FAFAFA} Möbelsystem",string,"Kaufen","Abbrechen");
		}
		return 1;
	}
	if(response == EDIT_RESPONSE_CANCEL)
	{
		// Spieler hat abgebrochen
		if(GetPVarInt(playerid,"MoebelEditModus")==1)
		{
			SCM(playerid,0xFFFF9FFF,"MÖBELSYSTEM:{FAFAFA} Editierung wurde abgebrochen und nicht gespeichert.");
			SetPVarInt(playerid,"MoebelEditModus",0);
		}
		else
		{
			SCM(playerid,0xFFFF9FFF,"MÖBELSYSTEM:{FAFAFA} Du hast das editieren abgebrochen, das editierende Objekt wurde gelöscht.");
			DestroyDynamicObject(Spieler[playerid][pMoebelID]);
			Spieler[playerid][pMoebelID] = 0;
		}
		return 1;
	}
	return 1;
}
forward CacheHMID(hobj);
public CacheHMID(hobj)
{
	HausmoebelInfo[hobj][hmdb_id] = cache_insert_id(MySQL_R394);
	return 1;
