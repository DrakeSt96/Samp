			{
			    if(!IsVehicleABankCar(vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Geldtransporter.");
			    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
			    if(VehicleLoadTank[vehicleid] >= 100000)return SCM(playerid,SAMP_WEISS,""IINFO" Geldtransport ist bereits randgefüllt!");
