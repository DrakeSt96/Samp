			new string[96];
			if(response == 0)return 1;
			else
			{
				for(new i=0;i<sizeof(RentVehicleModels);i++)
				{
					if(IsPlayerInRangeOfPoint(playerid,1.5,RentVehicleModels[i][Vehrent_X],RentVehicleModels[i][Vehrent_Y],RentVehicleModels[i][Vehrent_Z]))
					{
						if((GetACMoney(playerid) - fsteuern[RentVehsPreis]) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Geld.");
						RentVeh[playerid][0] = CreateVehicleEx(RentVehicleModels[i][VehrentModelid],RentVehicleModels[i][Vehrentspawn_X],RentVehicleModels[i][Vehrentspawn_Y],RentVehicleModels[i][Vehrentspawn_Z],RentVehicleModels[i][Vehrentspawn_A],random(255),random(255),-1,false);
						if((RentVehicleModels[i][Vehrentspawn_X] > -992.5172 && RentVehicleModels[i][Vehrentspawn_X] < 4000.0000) && (RentVehicleModels[i][Vehrentspawn_Y] < 528.0000 && RentVehicleModels[i][Vehrentspawn_Y] > -4000.0000)) //Los Santos
						{
							format(string,sizeof(string),"SA-LS-%i",MAX_VEHICLES-RentVeh[playerid][0]);
						}
						if((RentVehicleModels[i][Vehrentspawn_X] > -4000.0000 && RentVehicleModels[i][Vehrentspawn_X]< -992.5172) && (RentVehicleModels[i][Vehrentspawn_Y] < 4000.0000 && RentVehicleModels[i][Vehrentspawn_Y] > -4000.0000)) //San Fierro
						{
							format(string,sizeof(string),"SA-SF-%i",MAX_VEHICLES-RentVeh[playerid][0]);
						}
						if((RentVehicleModels[i][Vehrentspawn_X] > -992.5172 && RentVehicleModels[i][Vehrentspawn_X]< 4000.0000) && (RentVehicleModels[i][Vehrentspawn_Y] < 4000.0000 && RentVehicleModels[i][Vehrentspawn_Y] > 528.0000)) //Las Venturas
						{
							format(string,sizeof(string),"SA-LV-%i",MAX_VEHICLES-RentVeh[playerid][0]);
						}
					 	SetVehicleNumberPlate(RentVeh[playerid][0],string);
					 	PutPlayerInVehicleEx(playerid,RentVeh[playerid][0],0);
					 	GetVehicleParamsEx(RentVeh[playerid][0],engine,lights,alarm,doors,bonnet,boot,objective);
					 	SetVehicleParamsEx(RentVeh[playerid][0],engine,lights,alarm,VEHICLE_PARAMS_ON,bonnet,boot,objective);
					    lockedveh[RentVeh[playerid][0]] = true;
					   	ACMoney(playerid,-fsteuern[RentVehsPreis]);
					   	Spieler[playerid][pRentAVeh][0] = 1;
					   	PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
						format(string,sizeof(string),""IINFO" du hast dir ein Fahrzeug: "IINFO2"%s"#HTML_WEISS" für "IINFO2"%i$"#HTML_WEISS" gemietet.",VehicleDefinations[RentVehicleModels[i][VehrentModelid]-400],fsteuern[RentVehsPreis]);
					   	SCM(playerid,SAMP_WEISS,string);
					   	SCM(playerid,SAMP_WEISS,""IINFO" du kannst dein Fahrzeug mit "IINFO2"/rlock"#HTML_WEISS" auf und zuschließen.");
						return 1;
					}
				}
			}
