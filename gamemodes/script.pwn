COMMAND:gefangene(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[1000],text[50],onlinejailer = 0,ort[50];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInJob(playerid,16))
    {
	    ForEachPlayer(i)
	    {
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(GetPVarInt(i,"Eingeloggt") == 1)
				{
					if(Spieler[i][pJailed] != 0)
					{
						switch(Spieler[i][pKaution])
						{
							case 1:format(text,sizeof(text),"Ja (Kautionskosten: %i$)",Spieler[i][pJailTime]*GetPlayerLevel(i));
							case 2:{text="Knast";}
						}
						switch(Spieler[i][pJailed])
						{
							case 1:{ort="Knast";}
							case 2:{ort="Alkatraz";}
							case 3:{ort="FBI Knast";}
						}
						format(string,sizeof(string),"%s[%i]      Zeit: "IINFO2"%i:%02d"#HTML_WEISS"      Kaution: %s [%i$]      %s\n%s",SpielerName(i),i,floatround(Spieler[i][pJailTime]/60),floatround(Spieler[i][pJailTime]%60),text,GetPlayerLevel(i)*Spieler[i][pJailTime]*10,ort,string);
						ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"Gefangene:",string,"Schließen","");
						onlinejailer++;
					}
				}
			}
		}
		if(onlinejailer == 0)return SCM(playerid,SAMP_WEISS,""IINFO" derzeit befindet sich kein Verbrecher im Gefängnis.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,"Nicht in der jeweiligen Fraktion/Job.");
}

COMMAND:radar(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[1000],flyinsky = 0;
    if(!isPlayerInFrakt(playerid,6))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(IsPlayerInRangeOfPoint(playerid,3.0,212.4202,1822.8317,6.4141) || IsVehAFlugzeug(GetPlayerVehicleID(playerid)) || IsVehAHelicopter(GetPlayerVehicleID(playerid)))
    {
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		ForEachPlayer(i)
	    {
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(GetPVarInt(i,"Eingeloggt") == 1)
				{
					if(i != playerid)
					{
						if(IsPlayerInAnyVehicle(i))
						{
							if(IsVehAFlugzeug(GetPlayerVehicleID(i)) || IsVehAHelicopter(GetPlayerVehicleID(i)))
							{
								format(string,sizeof(string),"%s (ID:%i)   :   %s\n%s",SpielerName(i),i,VehicleDefinations[GetVehicleModel(GetPlayerVehicleID(i))-400],string);
								ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"Radar:",string,"Verlassen","");
								flyinsky++;
							}
						}
					}
				}
			}
		}
		if(flyinsky == 0)return SCM(playerid,SAMP_WEISS,""IINFO" derzeit befindet sich kein Flugobjekt im Luftraum.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Radar oder in keinem Flugzeug/Helikopter.");
}

COMMAND:bildschirm(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new cmd[4];
	if(!isPlayerInFrakt(playerid,6))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(IsPlayerInRangeOfPoint(playerid,3.0,213.2844,1819.2777,6.4216) || UseCam[playerid] == 1)
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
