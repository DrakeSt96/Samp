COMMAND:gunlist(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInJob(playerid,14) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13))
	{
		SCM(playerid,SAMP_WEISS,"Waffenverkaufsliste: Waffenname (Materialsverbrauch)");
	    SCM(playerid,SAMP_WEISS,"Messer (410),Baseballschläger (150),Deagle (900)");
	 	SCM(playerid,SAMP_WEISS,"Schaufel (260),9mm (550),SD-Pistole (420)");
	 	SCM(playerid,SAMP_WEISS,"Shotgun (1250),MP-5 (2500),AK-47 (3500),M4 (3500)");
	 	SCM(playerid,SAMP_WEISS,"Sniper (8000),Rifle (3000),Spray (360)");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job./Du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:showgunlist(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(isPlayerInJob(playerid,14) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13))
	{
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /showgunlist [playerid/Name]");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		format(string,sizeof(string),"* Du zeigst %s (ID:%i) die Waffenverkaufsliste *",SpielerName(pID),pID);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"* %s (ID:%i) zeigt dir die Waffenverkaufsliste *",SpielerName(playerid),playerid);
		SCM(pID,SAMP_WEISS,string);
		SCM(pID,SAMP_WEISS,"Waffenverkaufsliste:");
	    SCM(pID,SAMP_WEISS,"Messer,Baseballschläger,Deagle");
	 	SCM(pID,SAMP_WEISS,"Schaufel,9mm,SD-Pistole");
	 	SCM(pID,SAMP_WEISS,"Shotgun,MP-5,AK-47,M4");
	 	SCM(pID,SAMP_WEISS,"Sniper,Rifle,Spray");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job./Du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:eisenlager(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(isPlayerInJob(playerid,14) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13))
	{
		format(string,sizeof(string),"Eisen in der Erzgrube Las Venturas: %ikg",fsteuern[EisenLagger1]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Eisen am Materialspunkt: %ikg",fsteuern[EisenLagger2]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job./Du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:getmats(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new gebrauch,preis = 50,string[128];
   	if(isPlayerInJob(playerid,14) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12))
	{
		if(!IsPlayerInRangeOfPoint(playerid,2,829.0806,-1554.1830,13.4869))return SCM(playerid,SAMP_WEISS,"Nicht am Materials Lager.");
		if(sscanf(params,"i",gebrauch))return SCM(playerid,SAMP_WEISS,""IINFO" /getmats [Pakete 1-10]");
		if(gebrauch<1||gebrauch>10)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur von 1 bis 10 Pakete auswählen.");
		if((GetACMoney(playerid) - gebrauch*preis) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Geld.");
	    if((Spieler[playerid][MatsPackete] + gebrauch) > 10)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
		if((fsteuern[EisenLagger2]-(100*gebrauch)) < 0)return SCM(playerid,SAMP_WEISS,"Es ist nicht genug Eisen im Lager.");
		ACMoney(playerid,-gebrauch*preis);
		fsteuern[EisenLagger2] -= 100*gebrauch;
		PlayerPlaySound(playerid,1054,0.0,0.0,0.0);
	    Spieler[playerid][MatsPackete] += gebrauch;
	    format(string,sizeof(string),""IINFO" du hast soeben %i Materials Pakete (-%i Eisen) für %i$ gekauft. Eisenlager: %ikg",gebrauch,100*gebrauch,gebrauch*preis,fsteuern[EisenLagger2]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	else if(isPlayerInFrakt(playerid,13))
	{
	    if(!IsPlayerInRangeOfPoint(playerid,2,1427.3173,1066.7876,10.1174))return SCM(playerid,SAMP_WEISS,"Nicht am Materials Lager.");
		if(sscanf(params,"i",gebrauch))return SCM(playerid,SAMP_WEISS,""IINFO" /getmats [Pakete 1-500]");
		if(gebrauch<1||gebrauch>500)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur von 1 bis 500 Pakete auswählen.");
		if((GetACMoney(playerid) - gebrauch*preis) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht genug Geld.");
	    if((Spieler[playerid][MatsPackete] + gebrauch) > 500)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
		if((fsteuern[EisenLagger2]-(100*gebrauch)) < 0)return SCM(playerid,SAMP_WEISS,"Es ist nicht genug Eisen im Lager.");
		ACMoney(playerid,-gebrauch*preis);
		fsteuern[EisenLagger2] -= 100*gebrauch;
		PlayerPlaySound(playerid,1054,0.0,0.0,0.0);
	    Spieler[playerid][MatsPackete] += gebrauch;
	    format(string,sizeof(string),""IINFO" du hast soeben %i Materials Pakete (-%i Eisen) für %i$ gekauft. Eisenlager: %ikg",gebrauch,100*gebrauch,gebrauch*preis,fsteuern[EisenLagger2]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job./Du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:delmats(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(isPlayerInJob(playerid,14) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12))
	{
		if(!IsPlayerInRangeOfPoint(playerid,2,2440.2212,-1977.4396,13.5469))return SCM(playerid,SAMP_WEISS,"Nicht am Materials Verarbeitungspunkt.");
		if(Spieler[playerid][MatsPackete] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Materials Pakete dabei.");
		if((Spieler[playerid][pMaterials] + Spieler[playerid][MatsPackete]*100) > 10000)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
		PlayerPlaySound(playerid,1054,0.0,0.0,0.0);
	    Spieler[playerid][MatsPackete] *= 100;
	    Spieler[playerid][pMaterials] += Spieler[playerid][MatsPackete];
	    format(string,sizeof(string),""IINFO" du hast soeben %i Materials hergestellt.",Spieler[playerid][MatsPackete]);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[playerid][MatsPackete] = 0;
		return 1;
	}
	else if(isPlayerInFrakt(playerid,13))
	{
	    if(!IsPlayerInRangeOfPoint(playerid,2,1663.3236,711.2418,10.8203))return SCM(playerid,SAMP_WEISS,"Nicht am Materials Verarbeitungspunkt.");
		if(Spieler[playerid][MatsPackete] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Materials Pakete dabei.");
		if((Spieler[playerid][pMaterials] + Spieler[playerid][MatsPackete]*100) > 1000000)return SCM(playerid,SAMP_WEISS,"So viel kannst du nicht tragen.");
		PlayerPlaySound(playerid,1054,0.0,0.0,0.0);
	    Spieler[playerid][MatsPackete] *= 100;
	    Spieler[playerid][pMaterials] += Spieler[playerid][MatsPackete];
	    format(string,sizeof(string),""IINFO" du hast soeben %i Materials hergestellt.",Spieler[playerid][MatsPackete]);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[playerid][MatsPackete] = 0;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job./Du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:find(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,nummer,ortungsstring[128],Float:x,Float:y,Float:z;
	if(!isPlayerInJob(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
	if(sscanf(params,"i",nummer))return SCM(playerid,SAMP_WEISS,""IINFO" /find [Handynummer]");
	if(IsHandyNummerEnable(nummer) == -1)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
	pID = IsHandyNummerEnable(nummer);
	format(ortungsstring,sizeof(ortungsstring),""IINFO" du versuchst %s (ID:%i) zu orten...",SpielerName(pID),pID);
	SCM(playerid,SAMP_WEISS,ortungsstring);
	if(Spieler[pID][pHandy] == 0)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
	if(Spieler[pID][pHandystate] == 0)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
	if(Spieler[pID][pDeath] == 1)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
	if(Spieler[pID][pFriedhof] == 1)return SCM(playerid,SAMP_WEISS,"Nicht ortbar.");
	format(ortungsstring,sizeof(ortungsstring),""IINFO" du hast %s (ID:%i) geortet. Nutze '/delcheck' um den Checkpoint zu entfernen.",SpielerName(pID),pID);
	SCM(playerid,SAMP_WEISS,ortungsstring);
	KillTimer(SpielerOrtenTimer[playerid]);
	GetPlayerPos(pID,x,y,z);
	SetPlayerCheckpoint(playerid,x,y,z,3);
	Spieler[playerid][pOrtenVehORPlayer] = 1;//1 playerid 2 veh 3 service accept
    Spieler[playerid][pOrtenVehIDplayerid] = pID;
	SpielerOrtenTimer[playerid]=SetTimerEx("SpielerOderFahrzeugOrten",1000,true,"iii",playerid,pID,1);
	Spieler[playerid][pIsearch] = 1;
	return 1;
}

COMMAND:findveh(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new vehicleid,ortungsstring[128],Float:x,Float:y,Float:z;
	if(!isPlayerInJob(playerid,5))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
	if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""IINFO" /findveh [vehicleid]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug nicht ortbar.");
	format(ortungsstring,sizeof(ortungsstring),""IINFO" du hast einen %s [Fahrzeugid:%i] geortet. Nutze '/delcheck' um den Checkpoint zu entfernen.",VehicleDefinations[GetVehicleModel(vehicleid)-400],vehicleid);
	SCM(playerid,SAMP_WEISS,ortungsstring);
	KillTimer(SpielerOrtenTimer[playerid]);
	GetVehiclePos(vehicleid,x,y,z);
	SetPlayerCheckpoint(playerid,x,y,z,3);
	Spieler[playerid][pOrtenVehORPlayer] = 2;//1 playerid 2 veh 3 service accept
    Spieler[playerid][pOrtenVehIDplayerid] = vehicleid;
	SpielerOrtenTimer[playerid]=SetTimerEx("SpielerOderFahrzeugOrten",1000,true,"iii",playerid,vehicleid,2);
	Spieler[playerid][pIsearch] = 1;
	return 1;
}

COMMAND:entladen(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(!isPlayerInJob(playerid,6))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job.");
    if(farmjobgo[playerid]  != 0 ||  farmjobgo2[playerid] != 0)
    {
	    if(VehicleLoadTank[GetPlayerVehicleID(playerid)] < 250)return SCM(playerid,SAMP_WEISS,"Dein Mähdrescher ist noch nicht gefüllt.(Entladen ab 250Kg)");
	    if(IsPlayerInRangeOfPoint(playerid,7.5,-398.6879,-1456.4888,25.7266) || IsPlayerInRangeOfPoint(playerid,7.5,-71.4187,-32.5338,3.1172))
	    {
		    if(IsVehicleAFarmCar(GetPlayerVehicleID(playerid)) || IsVehicleAFarmCar2(GetPlayerVehicleID(playerid)))
		    {
			    SCM(playerid,SAMP_WEISS,"Mähdrescher wurde entladen! Fahre nun weiter die Felder ab.");
			    format(string,sizeof(string),"Verdienst: %i$",2*VehicleLoadTank[GetPlayerVehicleID(playerid)]);
			    SCM(playerid,SAMP_WEISS,string);
			    if(farmpflanze[playerid] != -1) DestroyDynamicObject(farmpflanze[playerid]);
				Spieler[playerid][pLohn] += (2*VehicleLoadTank[GetPlayerVehicleID(playerid)]);
				SCM(playerid,SAMP_WEISS,"Info: Die Auszahlung wird am Zahltag auf dein Konto überwiesen.");
				VehicleLoadTank[GetPlayerVehicleID(playerid)] = 0;
			    PlayerTextDrawSetString(playerid,VEHJOBTANKdraw[playerid],"0kg");
			    DisablePlayerCheckpoint(playerid);
				if(IsVehicleAFarmCar(GetPlayerVehicleID(playerid)))
			    {
					new rSpawn = random(sizeof(farmcheckpoints1));
					SetPlayerCheckpoint(playerid,farmcheckpoints1[rSpawn][0],farmcheckpoints1[rSpawn][1],farmcheckpoints1[rSpawn][2],7.5);
				    farmpflanze[playerid] = CreateDynamicObject(823,farmcheckpoints1[rSpawn][0],farmcheckpoints1[rSpawn][1],farmcheckpoints1[rSpawn][2],0,0,0);
				}
			    if(IsVehicleAFarmCar2(GetPlayerVehicleID(playerid)))
			    {
					new rSpawn = random(sizeof(farmcheckpoints2));
					SetPlayerCheckpoint(playerid,farmcheckpoints2[rSpawn][0],farmcheckpoints2[rSpawn][1],farmcheckpoints2[rSpawn][2],7.5);
				    farmpflanze[playerid] = CreateDynamicObject(823,farmcheckpoints2[rSpawn][0],farmcheckpoints2[rSpawn][1],farmcheckpoints2[rSpawn][2],0,0,0);
				}
				return 1;
			}
			return SCM(playerid,SAMP_WEISS,"In keinem Mähdrescher.");
		}
		SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Entladepunkt!");
		if(IsVehicleAFarmCar(GetPlayerVehicleID(playerid)))
  		{
    		DisablePlayerCheckpoint(playerid);
		    if(farmpflanze[playerid] != -1) DestroyDynamicObject(farmpflanze[playerid]);
	   		SetPlayerCheckpoint(playerid,-398.6879,-1456.4888,25.7266,7.5);
		    SCM(playerid,SAMP_WEISS,"Entladepunkt wurde auf deiner Karte markiert! Nutze am Entladen Punkt '/entladen' um den Mähdrescher zu entladen.");
		}
  		if(IsVehicleAFarmCar2(GetPlayerVehicleID(playerid)))
    	{
	    	DisablePlayerCheckpoint(playerid);
		    if(farmpflanze[playerid] != -1) DestroyDynamicObject(farmpflanze[playerid]);
		    SetPlayerCheckpoint(playerid,-71.4187,-32.5338,3.1172,7.5);
		    SCM(playerid,SAMP_WEISS,"Entladepunkt wurde auf deiner Karte markiert! Nutze am Entladen Punkt '/entladen' um den Mähdrescher zu entladen.");
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du hast den Farmer Job nicht gestartet!");
}
COMMAND:eatbrot(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[128];
    if(Spieler[playerid][pJailed] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Gefängnis.");
	if(GetPlayerInterior(playerid) == 2 || GetPlayerInterior(playerid) == 3 || GetPlayerInterior(playerid) == 10)
    {
        if(GetPlayerACHealth(playerid) >= 95)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Hunger.");
		format(string,sizeof(string),"** %s isst ein knuspriges Brot **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		ApplyAnimation(playerid,"FOOD","EAT_Burger",4.0,false,true,true,true,5000,SYNC_ALL);
		if((GetPlayerACHealth(playerid) + 100) > 100)return SetPlayerACHealth(playerid,100);
		SetPlayerACHealth(playerid,GetPlayerACHealth(playerid)+100);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Alkatraz/Knast/Gefängnis.");
}
COMMAND:knastzeit(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new string[128],kaution[20];
    if(Spieler[playerid][pJailed] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Gefängnis.");
	switch(Spieler[playerid][pKaution])
	{
		case 1:{kaution="Vorhanden";}
		case 2:{kaution="Nicht Vorhanden";}
		default:{kaution="ERROR";}
	}
	format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten im Knast. Kaution: %s",floatround(Spieler[playerid][pJailTime]/60),floatround(Spieler[playerid][pJailTime]%60),kaution);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:friedhofzeit_3(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	new string[128];
	if(Spieler[playerid][pFriedhof] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht auf dem Friedhof.");
	format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten auf dem Friedhof.",floatround((FRIEDHOFSZEIT-Spieler[playerid][pFriedhofTime])/60),floatround((FRIEDHOFSZEIT-Spieler[playerid][pFriedhofTime])%60));
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:totenzeit_3(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);new string[128];
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeathTime] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht verletzt.");
	format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten verletzt.",floatround((DEAHTIME-Spieler[playerid][pDeathTime])/60),floatround((DEAHTIME-Spieler[playerid][pDeathTime])%60));
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:whack(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
    if(isPlayerInFrakt(playerid,12))
	{
	    if(!IsPlayerInRangeOfPoint(playerid,2,796.9619,1688.6897,5.2813))return SCM(playerid,SAMP_WEISS,"Nicht am Wantedhacking Punkt");
	    if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
	    if(hackingwperson == -1) return SCM(playerid,SAMP_WEISS,"Es wurde keine Angebot zum Wantedhacking unterbreitet!");
		Spieler[playerid][pSuspectPoints]++;
		SCM(playerid,HIGHROT,""IINFO" du hast ein Verbrechen begangen ( Hacking des Polizei Computers ). Reporter: Anonym");
		SCM(playerid,0xD30023FF,""IINFO" du beginnst dich in die Polizeidatenbank zu hacken. Du kannst maximal 20 Wantedpunkte");
		SCM(playerid,0xD30023FF,""IINFO" der Zielperson löschen. Die San Andreas Army und das Federal Bureau of Investigation");
		SCM(playerid,0xD30023FF,"sind auf dem Weg. Die Beamten können dich auf Grund des Computers orten. Um die Ortung und");
		SCM(playerid,0xD30023FF,""IINFO" das Hacken des Polizei Computers zu beenden, tippe /stopwhack.");
		SCM(playerid,0xD30023FF,""IINFO" der Vorgang dauert maximal 15 Minuten.");
		format(string,sizeof(string),"** %s beginnt das Hacking des Polizeicomputers. **",SpielerName(playerid));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		SendClientMessageToAll(ORANGE,"News: Ein Unbekannter versucht sich in die Polizei Datenbank zu hacken.");
		Spieler[playerid][pWhackTimer] = SetTimerEx("WantedhackT",1000,true,"i",playerid);
		GameTextForPlayer(playerid,"~r~Du versuchst die Polizei Datenbank zu hacken",3000,3);
		WantedHackingStatus = gettime() + (60*240);
		Spieler[playerid][pWHackState] = true;
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i))
			{
				if(GetPVarInt(i,"Eingeloggt") == 0)
				{
					if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
					{
						if(Spieler[i][pDuty] != 0)
						{
							SCM(i,DUNKELBLAU,"HQ: Ein Computervirus wurde im System gemeldet! Eine Unbekannte Person hackt sich in den Polizeicomputer!");
						}
					}
				}
			}
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job./Du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:sellwhack(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],fv = IsAFraktionsVeh(playerid),cops;
    if(isPlayerInFrakt(playerid,12))
	{
	    if(gettime() > WantedHackingStatus)
	 	{
	 	    if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
	 	    ForEachPlayer(c)
			{
				if(IsPlayerConnected(c))
	   			{
					if(isPlayerInFrakt(c,1) || isPlayerInFrakt(c,2) || isPlayerInFrakt(c,6))
					{
	    				if(Spieler[c][pDuty] != 0)
					    {
							cops++;
						}
					}
				}
			}
			if(cops < 4)return SCM(playerid,SAMP_WEISS,"Es müssen mindestens 4 Beamte online sein.");
		    if(hackingwperson != -1)return SCM(playerid,SAMP_WEISS,"Eine Person wurde bereits schon zum Wantedhacking ausgewählt.");
		    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
		    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /sellwhack [playerid/Name]");
		    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir nicht selber dein Wantedlevel hacken.");
		    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
		    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
			if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
			if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
			if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler ist nicht in deinem Fahrzeug.");
			if(fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,""IINFO" das Fahrzeug ist kein Fraktionsfahrzeug!");
	        if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 560)return SCM(playerid,SAMP_WEISS,""IINFO" das Hacken von Wantedlevel ist nur in einem Sultan möglich!");
			format(string,sizeof(string),"%s %s (ID:%i) bietet dir das Wantedhacking der %s an (Kosten: %i$ pro 15 Sekunden). Tippe /accept whack um anzunehmen.",SpielerFraktionsRangName(playerid),SpielerName(playerid),playerid,FraktionsName(Spieler[playerid][pFraktion]),fsteuern[wHackPrice]);
			SCM(pID,SAMP_WEISS,string);
			SCM(pID,SAMP_WEISS,"Um das Wantedhacking abzulehnen '/cancel whack'");
			format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) Wantedhacking für %i$ pro 15 Sekunden an.",SpielerName(pID),pID,fsteuern[wHackPrice]);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[pID][pSeller] = playerid;
		    Spieler[pID][pAngebot] = 23;
		 	Spieler[pID][pMenge] = 0;
		 	return 1;
        }
		else
		{
			new stimestamp = WantedHackingStatus-gettime();
			format(string,sizeof(string),""IINFO" du kannst erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten ein Angebot zum Wantedhacking unterbreiten.",floatround(stimestamp/60),floatround(stimestamp%60));
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job./Du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:sellrepair(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new preis,pID,string[128];
	if(isPlayerInFrakt(playerid,11))
	{
		if(isell[playerid] > gettime())return SCM(playerid,SAMP_WEISS,""IINFO" du kannst erst nach 10 Sekunden etwas verkaufen.");
		if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
	    if(sscanf(params,"ud",pID,preis))return SCM(playerid,SAMP_WEISS,""IINFO" /sellrepair [playerid/Name][Preis]");
	    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst keine Reperatur anbieten.");
	    if(preis<1||preis>1000)return SCM(playerid,SAMP_WEISS,"Bitte wähle einen Preis zwischen 1 - 1000$ aus.");
	    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		if(!IsPlayerInAnyVehicle(pID))return SCM(playerid,SAMP_WEISS,"Spieler muss in einem Fahrzeug sitzen.");
		format(string,sizeof(string),"Mechaniker %s (ID:%i) bietet dir eine Reparatur für %i$ an. Tippe /accept repair um anzunehmen.",SpielerName(playerid),playerid,preis);
		SCM(pID,SAMP_WEISS,string);
		SCM(pID,SAMP_WEISS,"Um die Reperatur abzulehnen Tippe '/cancel repair'");
		format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) eine Reparatur für %i$ an.",SpielerName(pID),pID,preis);
		SCM(playerid,SAMP_WEISS,string);
	    Spieler[pID][pSeller] = playerid;
	    Spieler[pID][pAngebot] = 4;
		Spieler[pID][pKaufPreis] = preis;
	 	Spieler[pID][pMenge] = 0;
		isell[playerid] = gettime() + (10);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Job./Du bist nicht in der jeweiligen Fraktion.");
}
