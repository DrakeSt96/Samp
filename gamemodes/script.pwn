public GenerateKeyForPlayer(playerid)
{
    new string[128];
	if(IsPlayerInRangeOfPoint(playerid,5.0,2581.5100,-1286.8101,1043.1200))
	{
    	KeyWillbeGenerate++;
    	switch(KeyWillbeGenerate)
		{
		    case 1..10: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~r~IIIIIIIIIII",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 11..20: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~r~IIIIIIIIII",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 21..30: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~r~IIIIIIIII",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 31..40: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~r~IIIIIIII",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 41..50: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~y~IIIIIII",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 51..60: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~y~IIIIII",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 61..70: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~y~IIIII",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 71..80: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~y~IIII",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 81..90: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~g~III",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 91..100: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~g~II",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 101..119: format(string,sizeof(string),"~n~~n~~n~~n~~g~"IINFO2"%i:%02d"#HTML_WEISS"~w~ Minuten~n~~g~I",(120-KeyWillbeGenerate)/60,(120-KeyWillbeGenerate)%60),GameTextForPlayer(playerid,string,1000,3);
		    case 120:
		    {
		        GeneratedKeyTstamp = gettime() + (60*15);
		        GameTextForPlayer(playerid,"~n~~n~~n~~n~~g~ERFOLGREICH",1000,3);
		        format(string,sizeof(string),"Zugangsschlüssel generiert: %i",GeneratedKey);
		        SCM(playerid,SAMP_WEISS,string);
		        SCM(playerid,SAMP_WEISS,""IINFO" du kannst den Zugangsschlüssel nun in die Eingabekonsolen der Tore eingeben.");
                SCM(playerid,SAMP_WEISS,""IINFO" der Zugangsschlüssel ist nur 15 Minuten benutzbar.");
				KeyWillbeGenerate = 0,Spieler[playerid][pGenerateState] = false,KillTimer(Spieler[playerid][pGenerateTimer]);
		    }
		}
    	return 1;
	}
	GameTextForPlayer(playerid,"~n~~n~~n~~n~~r~GESCHEITERT",1000,3),KeyWillbeGenerate = 0,Spieler[playerid][pGenerateState] = false,KillTimer(Spieler[playerid][pGenerateTimer]);
	return 1;
}
