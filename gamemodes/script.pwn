				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				KillTimer(JobTimer[playerid]);
			}
		}
		if(IsVehicleATransportplane3(vehicleid))
	    {
		    if(Spieler[playerid][pJob] != 3)
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du besitzt nicht den jeweiligen Job.");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
				StopAudioStreamForPlayer(playerid);
				
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				return RemovePlayerFromVehicle(playerid);
			}
			if(fjobgo2[playerid] == 0)
			{
				ShowPlayerDialog(playerid,DIALOG_JOB_START_AUSWAHL,DIALOG_STYLE_MSGBOX,"Felderbewässerer","Entscheide dich ob du den Job ´Starten´ oder ´Abbrechen´ willst !?","Starten","Abbrechen");
			}
