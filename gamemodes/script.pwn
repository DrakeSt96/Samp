			}
		}
	}
	switch(wrobsec)
	{
	    case 1:SendClientMessageToAll(ORANGE,"News: Das Waffenlager wird in 10 Minuten leer sein,die Staatsmächte sind unterwegs.");
	    case 120:SendClientMessageToAll(ORANGE,"News: Das Waffenlager wird in 8 Minuten leer sein.");
	    case 240:SendClientMessageToAll(ORANGE,"News: Das Waffenlager wird in 6 Minuten leer sein.");
	    case 360:SendClientMessageToAll(ORANGE,"News: Das Waffenlager wird in 4 Minuten leer sein.");
	    case 480:SendClientMessageToAll(ORANGE,"News: Das Waffenlager wird in 2 Minuten leer sein.");
	    case 540:SendClientMessageToAll(ORANGE,"News: Das Waffenlager wird in 1 Minuten leer sein.");
	    case 600:
		{
			SendClientMessageToAll(ORANGE,"News: Die Bank wurde erfolgreich ausgeraubt.");
			TogglePlayerControllable(playerid,true);
			format(string,sizeof(string),"~w~Verdienst gesamt~g~ %i$",Spieler[playerid][pRobOtherThing]);
			GameTextForPlayer(playerid,string,2000,1);
			format(string,sizeof(string),""IINFO" du hast erfolgreich das Waffenlager der Bundeswehr ausgeraubt. Verdienst %i Materials",Spieler[playerid][pWaffenlagerRobOtherThing]);
			SCM(playerid,SAMP_WEISS,string);
			SCM(playerid,SAMP_WEISS,"Hau mit der Beute ab bevor sich das Tor in 30 Sekunden schließt.");
			SCM(playerid,SAMP_WEISS,""IINFO" du darfst die nächsten 5 Minuten nicht sterben oder das Spiel verlassen,");
		    SCM(playerid,SAMP_WEISS,""IINFO" da deine erbeutetes Geld somit verschwindet.");
			RemovePlayerAttachedObject(playerid,5);
			Spieler[playerid][pWaffenlagerRobState] = false;
			Spieler[playerid][pWaffenlagerRobOtherTime] = gettime() + (5*60);
			Spieler[playerid][pMaterials] += Spieler[playerid][pWaffenlagerRobOtherThing];
		}
		case 630:
		{
		    KillTimer(Spieler[playerid][pWaffenlagerRobTimer]);
			wrobsec = 0;
		}
	}
	return 1;
}
public RobC4Transporter(fahrerid,beifahrerid,robberid)
{
    new string[128],Float:Pos[3];
	robc4sec++;
	GetPlayerPos(fahrerid,Pos[0],Pos[1],Pos[2]);
	if(IsVehicleInRangeOfPoint(BOTarmytransport,10.0,Pos[0],Pos[1],Pos[2]) && IsPlayerInVehicle(robberid,BOTarmytransport))
	{
		pRobC4TimeNearVehicle++;
		format(string,sizeof(string),"~n~~n~~n~~n~~n~~g~Neues C4 in ~b~%i~y~ Sekunden",60-pRobC4TimeNearVehicle);
	    GameTextForPlayer(fahrerid,string,1000,3);
	    format(string,sizeof(string),"~n~~n~~n~~n~~n~~g~Neues C4 in ~b~%i~y~ Sekunden",60-pRobC4TimeNearVehicle);
	    GameTextForPlayer(beifahrerid,string,1000,3);
	    format(string,sizeof(string),"~n~~n~~n~~n~~n~~g~Neues C4 in ~b~%i~y~ Sekunden",60-pRobC4TimeNearVehicle);
	    GameTextForPlayer(robberid,string,1000,3);
	    pRobC4BackwardTime = 0;
	    if(pRobC4TimeNearVehicle >= 60)
	    {
		    pRobC4TimeNearVehicle = 0;
		    format(string,sizeof(string),"** %s reicht %s 1kg C4 **",SpielerName(robberid),SpielerName(beifahrerid));
			PlayerTalkPublic(robberid,SAMP_PublicChatColor,string,10);
			format(string,sizeof(string),"** %s laggert 1kg C4 in das Fahrzeug ein **",SpielerName(beifahrerid));
			PlayerTalkPublic(beifahrerid,SAMP_PublicChatColor,string,10);
			GameTextForPlayer(beifahrerid,"~g~C4 erhalten: ~y~1kg",1000,3);
		    vFahrzeug[GetPlayerVehicleID(fahrerid)][KofferraumC4]++;
	    }
	}
	else
	{
		pRobC4BackwardTime++;
		format(string,sizeof(string),"~n~~n~~n~~n~~n~~r~Ihr habt noch ~b~%i ~y~Sekunden~r~ um dich zum C4-Transporter zu begeben",20-pRobC4BackwardTime);
	    GameTextForPlayer(fahrerid,string,1000,3);
	    format(string,sizeof(string),"~n~~n~~n~~n~~n~~r~Ihr habt noch ~b~%i ~y~Sekunden~r~ um dich zum C4-Transporter zu begeben",20-pRobC4BackwardTime);
	    GameTextForPlayer(beifahrerid,string,1000,3);
	    format(string,sizeof(string),"~n~~n~~n~~n~~n~~r~Ihr habt noch ~b~%i ~y~Sekunden~r~ um dich zum C4-Transporter zu begeben",20-pRobC4BackwardTime);
	    GameTextForPlayer(robberid,string,1000,3);
	    if(pRobC4BackwardTime >= 20)
	    {
		    ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(GetPVarInt(i,"Eingeloggt") == 0)
					{
						if(isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
						{
							if(Spieler[i][pDuty] != 0)
							{
								SCM(i,DUNKELBLAU,"HQ: An alle Einheiten, der Überfall auf den C4-Transporter wurde abgebrochen!");
							}
						}
					}
				}
			}
		    SCM(fahrerid,SAMP_WEISS,"Ihr seid am C4-Raub gescheitert.");
		    SCM(beifahrerid,SAMP_WEISS,"Ihr seid am C4-Raub gescheitert.");
		    SCM(robberid,SAMP_WEISS,"Ihr seid am C4-Raub gescheitert.");
		    RemovePlayerFromVehicle(robberid);
			Spieler[fahrerid][pC4RobState] = false;
			Spieler[beifahrerid][pC4RobState] = false;
			Spieler[robberid][pC4RobState] = false;
			pRobC4BackwardTime = 0;
			pRobC4TimeNearVehicle = 0;
			KillTimer(C4robTimer);
			robc4sec = 0;
	}
	}
    if(robc4sec >= 360)
	{
		SCM(fahrerid,SAMP_WEISS,"Ihr habt den C4-Transporter erfolgreich ausgeraubt.");
	    SCM(beifahrerid,SAMP_WEISS,"Ihr habt den C4-Transporter erfolgreich ausgeraubt.");
	    SCM(robberid,SAMP_WEISS,"Ihr habt den C4-Transporter erfolgreich ausgeraubt.");
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i))
			{
				if(GetPVarInt(i,"Eingeloggt") == 0)
				{
					if(isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
					{
						if(Spieler[i][pDuty] != 0)
						{
							SCM(i,DUNKELBLAU,"HQ: An alle Einheiten, der C4-Transporter wurde erfolgreich überfallen!");
						}
					}
				}
			}
		}
		RemovePlayerFromVehicle(robberid);
		Spieler[fahrerid][pC4RobState] = false;
		Spieler[beifahrerid][pC4RobState] = false;
		Spieler[robberid][pC4RobState] = false;
		pRobC4BackwardTime = 0;
		pRobC4TimeNearVehicle = 0;
		KillTimer(C4robTimer);
		robc4sec = 0;
	}
	return 1;
}
public TazerAkku(playerid)
{
	Spieler[playerid][pTazerAkku]--;
	return 1;
}
public HandySendConnect(playerid,count)
{
	new string[3000],nummer = Spieler[playerid][pCallEntry];
	switch(count)
	{
	case 0://call
	{
    if(ReturnHempfangRate(playerid) == -1)
	{
		ShowPlayerHandyMenu2(playerid);
		return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
	}
	if(nummer == 911 || nummer == 110)
	{
		SCM(playerid,SAMP_WEISS,""#HTML_WEISS"["#HTML_BLAU"Die Zentrale"#HTML_WEISS"]: Was ist geschehen ?");
		return ShowPlayerDialog(playerid,DIALOG_HANDY_CALL911,DIALOG_STYLE_LIST,HandyInfo[Spieler[playerid][pHandy]][Handyname],"Mord\nKörperverletzung\nSachbeschädigung\nUnfall\nSchiesserei","Auswählen","Abbrechen");
	}
	if(IsHandyNummerEnable(nummer) == -1)
	{
		ShowPlayerDialog(playerid,DIALOG_HANDY_CALL,DIALOG_STYLE_INPUT,HandyInfo[Spieler[playerid][pHandy]][Handyname],""HTML_WEISS"Gib nun bitte die "IINFO2"Nummer"#HTML_WEISS" des Spielers ein, denn du "IINFO2"anrufen"#HTML_WEISS" willst!","Anrufen","Zurück");
	    return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
	}
	new pID = IsHandyNummerEnable(nummer);
	if(ReturnHempfangRate(pID) == -1)
	{
		ShowPlayerHandyMenu2(playerid);
		return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
	}
	if(Spieler[playerid][pCall] == Spieler[playerid][pPhonenumber])
	{
		ShowPlayerDialog(playerid,DIALOG_HANDY_CALL,DIALOG_STYLE_INPUT,HandyInfo[Spieler[playerid][pHandy]][Handyname],""HTML_WEISS"Gib nun bitte die "IINFO2"Nummer"#HTML_WEISS" des Spielers ein, denn du "IINFO2"anrufen"#HTML_WEISS" willst!","Anrufen","Zurück");
		return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
	}
	if(Spieler[pID][pCallHim] == 1)
	{
		ShowPlayerDialog(playerid,DIALOG_HANDY_CALL,DIALOG_STYLE_INPUT,HandyInfo[Spieler[playerid][pHandy]][Handyname],""HTML_WEISS"Gib nun bitte die "IINFO2"Nummer"#HTML_WEISS" des Spielers ein, denn du "IINFO2"anrufen"#HTML_WEISS" willst!","Anrufen","Zurück");
		return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
	}
	if(Spieler[pID][pHandystate] == 0)
	{
		ShowPlayerDialog(playerid,DIALOG_HANDY_CALL,DIALOG_STYLE_INPUT,HandyInfo[Spieler[playerid][pHandy]][Handyname],""HTML_WEISS"Gib nun bitte die "IINFO2"Nummer"#HTML_WEISS" des Spielers ein, denn du "IINFO2"anrufen"#HTML_WEISS" willst!","Anrufen","Zurück");
		return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
	}
	Spieler[playerid][pCall] = pID;
	Spieler[pID][pCall] = playerid;
	SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USECELLPHONE);
	GiveHandy(playerid);
	ShowPlayerPhoneSound(pID);
	format(string,sizeof(string),"** %s %s fängt an zu klingeln **",SpielerName(pID),HandyInfo[Spieler[pID][pHandy]][Handyname]);
	PlayerTalkPublic(pID,SAMP_PublicChatColor,string,10);
	format(string,sizeof(string),""IINFO" du ruftst "IINFO2"%s"#HTML_WEISS" an...",SpielerName(pID));
	SCM(playerid,SAMP_WEISS,string);
	//format(string,sizeof(string),""IINFO" du rufst %s an...",SpielerName(pID));
	//SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"Spieler: "IINFO2"%s"#HTML_WEISS" ruft an Tippe "IINFO2"/pickup"#HTML_WEISS" um abzuheben.",SpielerName(playerid));
	SCM(pID,WEISS,string);
	format(string,sizeof(string),"Spieler: "IINFO2"%s"#HTML_WEISS" ruft an.",SpielerName(playerid));
	SCM(pID,SAMP_WEISS,string);
	if(Spieler[playerid][pHandyCoins] != 0 && Spieler[playerid][pHandyFlat] == 0)
	{
		Spieler[playerid][pHandyCoins]--;
		UpdateHandyTextdraw(playerid);
	}
	return 1;
	}
	case 1://sms dialog 2
	{
	if(ReturnHempfangRate(playerid) == -1)
	{
		ShowPlayerHandyMenu2(playerid);
		return SCM(playerid,SAMP_WEISS,"Senden fehlgeschlagen");
	}
	if(IsHandyNummerEnable(nummer) == -1)
	{
		ShowPlayerHandyMenu2(playerid);
		return SCM(playerid,SAMP_WEISS,"Senden fehlgeschlagen");
	}
	new pID = IsHandyNummerEnable(nummer);
	if(Spieler[pID][pHandystate] == 0)
	{
		ShowPlayerHandyMenu2(playerid);
		return SCM(playerid,SAMP_WEISS,"Senden fehlgeschlagen");
	}
	SCM(playerid,WEISS,""IINFO" Nachricht abgesendet.");
	format(string,sizeof(string),"SMS: %s,Empfänger: %s (%i)",Spieler[playerid][pSMSText],SpielerName(pID),Spieler[pID][pPhonenumber]);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"SMS: %s,Sender: %s (%i)",Spieler[playerid][pSMSText],SpielerName(playerid),Spieler[playerid][pPhonenumber]);
	SCM(pID,SAMP_WEISS,string);
    PlayerPlaySound(pID,1137,0.0,0.0,0.0);
	Spieler[playerid][pCall] = -1;
	ShowPlayerHandyMenu2(playerid);
    ForEachPlayer(i)
	{
		if(IsPlayerConnected(i))
		{
			if(Spieler[i][IreadALL] == 1)
			{
				format(string,sizeof(string),"SMS an %s (%i): %s,Sender: %s (%i)",SpielerName(pID),Spieler[pID][pPhonenumber],Spieler[playerid][pSMSText],SpielerName(playerid),Spieler[playerid][pPhonenumber]);
				SCM(i,SAMP_WEISS,string);
			}
		}
	}
	if(Spieler[playerid][pHandyCoins] != 0 && Spieler[playerid][pHandyFlat] == 0)
	{
		Spieler[playerid][pHandyCoins]--;
		UpdateHandyTextdraw(playerid);
	}
	return 1;
	}
	case 2:
	{
		if(IsHandyNummerEnable(nummer) == -1)
		{
			ShowPlayerDialog(playerid,DIALOG_TELEFONZELLE_CALL,DIALOG_STYLE_INPUT,"Telefon","Gib nun bitte die Nummer des Spielers ein,denn du anrufen willst!","Anrufen","Zurück");
			return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
		}
		new pID = IsHandyNummerEnable(nummer);
		if(ReturnHempfangRate(pID) == -1)
		{
			ShowPlayerDialog(playerid,DIALOG_TELEFONZELLE_CALL,DIALOG_STYLE_INPUT,"Telefon","Gib nun bitte die Nummer des Spielers ein,denn du anrufen willst!","Anrufen","Zurück");
			return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
		}
		if(Spieler[playerid][pCall] == Spieler[playerid][pPhonenumber])
		{
			ShowPlayerDialog(playerid,DIALOG_TELEFONZELLE_CALL,DIALOG_STYLE_INPUT,"Telefon","Gib nun bitte die Nummer des Spielers ein,denn du anrufen willst!","Anrufen","Zurück");
			return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
		}
		if(Spieler[pID][pCallHim] == 1)
		{
			ShowPlayerDialog(playerid,DIALOG_TELEFONZELLE_CALL,DIALOG_STYLE_INPUT,"Telefon","Gib nun bitte die Nummer des Spielers ein,denn du anrufen willst!","Anrufen","Zurück");
			return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
		}
		if(Spieler[pID][pHandystate] == 0)
		{
			ShowPlayerDialog(playerid,DIALOG_TELEFONZELLE_CALL,DIALOG_STYLE_INPUT,"Telefon","Gib nun bitte die Nummer des Spielers ein,denn du anrufen willst!","Anrufen","Zurück");
			return SCM(playerid,SAMP_WEISS,""IINFO" Anruf fehlgeschlagen");
		}
		Spieler[playerid][pCall] = pID;
		Spieler[pID][pCall] = playerid;
		SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USECELLPHONE);
		ShowPlayerPhoneSound(pID);
		//PlayerPlaySound(pID,1076,0.0,0.0,0.0);
		format(string,sizeof(string),"** %s %s fängt an zu klingeln **",SpielerName(pID),HandyInfo[Spieler[pID][pHandy]][Handyname]);
		PlayerTalkPublic(pID,SAMP_PublicChatColor,string,10);
		format(string,sizeof(string),""IINFO" du ruftst %s an...",SpielerName(pID));
		SCM(playerid,SAMP_WEISS,string);
		//format(string,sizeof(string),""IINFO" du rufst %s an...",SpielerName(pID));
		//SCM(playerid,SAMP_WEISS,string);
		SCM(pID,WEISS,""IINFO" eine unterdrückte Nummer ruft an Tippe "IINFO2"/pickup"#HTML_WEISS" um abzuheben...");
		SCM(pID,SAMP_WEISS,""IINFO" eine unterdrückte Nummer ruft an");
		return 1;
		}
	}
	return printf("ERROR: HandySendConnect(playerid=%i,count=%i) funktion nicht erkannt!",playerid,count);
}

public HandyAkku(playerid)
{
	Spieler[playerid][pHandyakku] -= HandyInfo[Spieler[playerid][pHandy]][HandyVerbrauch];
	if(Spieler[playerid][pHandyakku] <= 0.0)
	{
		StopAudioStreamForPlayer(playerid);
		HideHandyDraw(playerid);
		KillTimer(AkkuTimer[playerid]);
		Spieler[playerid][pHandystate] = 0;
		Spieler[playerid][pHandyakku] = 0.0;
		if(Spieler[playerid][pCallHim] == 1)
		{
			new pID = Spieler[playerid][pCall];
			Spieler[playerid][pCallHim] = 0;
			Spieler[pID][pCallHim] = 0;
			Spieler[pID][pCall] = -1;
			Spieler[playerid][pCall] = -1;
			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
			SetPlayerSpecialAction(pID,SPECIAL_ACTION_STOPUSECELLPHONE);
			SCM(playerid,SAMP_WEISS,""IINFO" du hast das Gespräch beendet.");
			SCM(pID,SAMP_WEISS,""IINFO" der Gesprächspartner hat aufgelegt.");
			PlayerPlaySound(playerid,1077,0.0,0.0,0.0);
			PlayerPlaySound(pID,1077,0.0,0.0,0.0);
			RemovePlayerAttachedObject(pID,8);
			RemovePlayerAttachedObject(playerid,8);
		}
	}
	return 1;
}

public Angeln(playerid)
{
    new fisch = random(7)+1,gewicht = random(29)+1,fishname = random(8)+1,string[128];
    TogglePlayerControllable(playerid,true);
	RemovePlayerAttachedObject(playerid,6);
	switch(fisch)
	{
		case 1:
		{
		SCM(playerid,SAMP_WEISS,""IINFO" du hast einen Reifen geangelt und wirfst ihn wieder zurück ins Meer!");
		}
		case 2:
		{
			Spieler[playerid][pAngelKoeder]--;
		    format(string,sizeof(string),""IINFO" du hast einen %s geangelt! Gewicht: %i Kg",Fische[fishname],gewicht);
			SCM(playerid,SAMP_WEISS,string);
