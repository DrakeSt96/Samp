							    format(string,sizeof(string),""#HTML_WEISS"Fahrzeug: "IINFO2"%s"#HTML_WEISS" Fraktion: "IINFO2"%s",VehicleDefinations[Fahrzeug[fv][modelid]-400],FraktionsName(Fahrzeug[fv][Fraktion]));
