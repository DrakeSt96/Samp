public OnPlayerText(playerid,text[])
{
	new string[128];
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return 0;
	if(!strlen(text))return 0;
	if(ImTutorial[playerid] != 0)
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" du kannst nicht reden,da du im Tutorial bist.");
	    return 0;
	}

	if(Spieler[playerid][pInPrison] == 1)
	{
	    SCM(playerid,SAMP_WEISS,""IINFO" du kannst nicht reden,da du im Prison bist!");
	    return 0;
	}

	if(Spieler[playerid][pFriedhof] == 1 && Spieler[playerid][pAtReport] == 0)
	{
	    SCM(playerid,SAMP_WEISS,"Tote können nicht sprechen.");
		return 0;
	}

	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)
	{
		SCM(playerid,SAMP_WEISS,""IINFO" du bist im AFK-Modus und kannst somit nicht sprechen.");
		SCM(playerid,SAMP_WEISS,""IINFO" /back");
		return 0;
	}
	if(Spieler[playerid][pTalkwithBankbitch] == 1)
	{
		if(strcmp(text,"Bankkonto",true) == 0)
		{
			new bankpin = random(8000) + random(1000);
		 	if(!IsPlayerInRangeOfPoint(playerid,2,1482.3273,-1005.3770,26.8159) && GetPlayerVirtualWorld(playerid) == 1)
			{
				SCM(playerid,SAMP_WEISS,"Nicht in der Los Santos Zentralbank.");
				return 0;
			}
		 	if(Spieler[playerid][pPersoLic] == 0)
		 	{
				SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie besitzen keinen Personalausweis.");
				return 0;
			}
			if((GetACMoney(playerid) - 25) < 0)
			{
				SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie haben nicht genug Geld.");
				return 0;
			}
			if(Spieler[playerid][pBankkonto] == 0)
			{
				SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie haben sich erfolgreich ein Bankkonto zugelegt.");
			    Spieler[playerid][pBankkonto] = 1;
			    Spieler[playerid][pBankPin] = bankpin;
			    format(string,sizeof(string),"{FF6666}Bankangestellte:{FFFFFF} Ihr Pin lautet %i.",Spieler[playerid][pBankPin]);
			    SCM(playerid,SAMP_WEISS,string);
			    SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Ihren Bankpin können Sie über den Befehl '/bankpin' aufrufen.");
			   	ApplyAnimation(GetPlayerID("[BOT]Bank"),"PED","IDLE_CHAT",4.0,false,false,false,false,0,SYNC_ALL);
				ACMoney(playerid,-25);
				return 0;
			}
		 	if(Spieler[playerid][pWrongBankPinEntry] >= 3)
			{
				SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Ihr Konto wurde entsperrt.");
			    Spieler[playerid][pBankPin] = bankpin;
			    Spieler[playerid][pWrongBankPinEntry] = 0;
			    format(string,sizeof(string),"{FF6666}Bankangestellte:{FFFFFF} Ihr neuer Pin lautet %i.",Spieler[playerid][pBankPin]);
			    SCM(playerid,SAMP_WEISS,string);
			    ApplyAnimation(GetPlayerID("[BOT]Bank"),"PED","IDLE_CHAT",4.0,false,false,false,false,0,SYNC_ALL);
			   	Spieler[playerid][pBank] -= 25;
			   	return 0;
			}
		    SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie haben bereits ein Bankkonto./Ihr Bankkonto wurde nicht gesperrt.");
			return 0;
		}
		if(strcmp(text,"Banksafe",true) == 0)
		{
		    if(!IsPlayerInRangeOfPoint(playerid,2,1482.3273,-1005.3770,26.8159) && GetPlayerVirtualWorld(playerid) == 1)
			{
				SCM(playerid,SAMP_WEISS,"Nicht in der Los Santos Zentralbank.");
			 	return 0;
			}
			if(Spieler[playerid][pBankSafeSafe] == 1)
			{
				SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie haben bereits ein Bankschließfach.");
			 	return 0;
			}
			if(Spieler[playerid][pPersoLic] == 0)
			{
				SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie besitzen keinen Personalausweis.");
			  	return 0;
			}
			if((GetACMoney(playerid) - 125) < 0)
			{
				SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie haben nicht genug Geld.");
			    return 0;
			}
			SCM(playerid,SAMP_WEISS,"{FF6666}Bankangestellte:{FFFFFF} Sie haben sich erfolgreich ein Schließfach zugelegt.");
		    Spieler[playerid][pBankSafeSafe] = 1;
		    ApplyAnimation(GetPlayerID("[BOT]Bank"),"PED","IDLE_CHAT",4.0,false,false,false,false,0,SYNC_ALL);
			ACMoney(playerid,-125);
			return 0;
		}
		if(strcmp(text,"Tschüss",true) == 0)
		{
			SetCameraBehindPlayer(playerid);
			TogglePlayerControllable(playerid,true);
			Spieler[playerid][pTalkwithBankbitch] = 0;
			PlayerPlaySound(playerid,5453,0.0,0.0,0.0);
			format(string,sizeof(string),"{FF6666}Bankangestellte:{FFFFFF} Auf Wiedersehen %s,ich wünsche Ihnen noch einen schönen Tag.",SpielerName(playerid));
			SCM(playerid,SAMP_WEISS,string);
			return 0;
		}
		return 0;
	}
	if(chatpredigt[playerid] == true)
	{
	    if(IsPlayerInRangeOfPoint(playerid,3.0,-1440.5856,-1577.0372,102.0159))
		{
		    format(string,sizeof(string),"%s %s: %s",SpielerFraktionsRangName(playerid),SpielerName(playerid),text);
			PlayerTalkOnly(playerid,SEKTEFARBE,string,25.0);
			format(string,sizeof(string),"%s %s: %s",SpielerFraktionsRangName(playerid),SpielerName(playerid),text);
			SCM(playerid,SEKTEFARBE,string);
			if(gPlayerUsingLoopingAnim[playerid] == false && animak[playerid] == false && Spieler[playerid][RpChat] == 1 && !IsPlayerInVehicle(playerid,GetPlayerVehicleID(playerid)))
		    {
		    	OnePlayAnim(playerid,"PED","IDLE_CHAT",4.0,0,0,0,0,0);
			}
		    return 0;
		}
	}
	if(MakeBiz[playerid] != 0)
	{
		new Float:Pos[3];
	    if(BizInfo[MakeBiz[playerid]][biz_art] == 10 || BizInfo[MakeBiz[playerid]][biz_art] == 14)//tankstelle || Base-Jump Business
		{
			GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
			if(strcmp(text,"Back",true) == 0)
			{
				if(!IsPlayerInRangeOfPoint(playerid,5.0,BizInfo[MakeBiz[playerid]][biz_x],BizInfo[MakeBiz[playerid]][biz_y],BizInfo[MakeBiz[playerid]][biz_z]))
				{
					SCM(playerid,SAMP_WEISS,""IINFO" du musst schon am Erstellungspunkt des Business sein.");
					return 0;
				}
				if(BizInfo[MakeBiz[playerid]][tPos][3] != 0.0)
				{
					DestroyDynamicPickup(BizInfo[MakeBiz[playerid]][biz_pickup][2]);
				    DestroyDynamic3DTextLabel(BizLabel[MakeBiz[playerid]][2]);
					BizInfo[MakeBiz[playerid]][tPos][3] = 0;
				    BizInfo[MakeBiz[playerid]][tPos][4] = 0;
				    BizInfo[MakeBiz[playerid]][tPos][5] = 0;
				    SCM(playerid,SAMP_WEISS,"Punkt 2 gelöscht.(Schreibe 'Back' um den ersten Punkt zu löschen.)");
					return 0;
				}
				if(BizInfo[MakeBiz[playerid]][tPos][0] != 0.0)
				{
					DestroyDynamicPickup(BizInfo[MakeBiz[playerid]][biz_pickup][1]);
				    DestroyDynamic3DTextLabel(BizLabel[MakeBiz[playerid]][1]);
					BizInfo[MakeBiz[playerid]][tPos][0] = 0;
				    BizInfo[MakeBiz[playerid]][tPos][1] = 0;
				    BizInfo[MakeBiz[playerid]][tPos][2] = 0;
				    SCM(playerid,SAMP_WEISS,"Punkt 1 gelöscht.(Schreibe 'Back' um zur Leveleinstellung zu gelangen.)");
					return 0;
				}
				//format(string,sizeof(string),"Bizerstellungs Fortschritt:\nBizart: %s\nPreis: %i$\nGebe nun das Level ein,\ndass man benötigt um das Buisness zu kaufen:",BizName(MakeBiz[playerid]),BizInfo[MakeBiz[playerid]][biz_preis]);
			    ShowPlayerDialog(playerid,BIZ_ERSTELLEN_DIALOG_BUYLEVEL,DIALOG_STYLE_INPUT,""ClanTagDialoge" Bizerstellung -> Level",""#HTML_WEISS"Gebe nun an ab welches Level es zu kaufen sein soll.","Weiter","Zurück");
				return 0;
			}
			if(strcmp(text,"Punkt1",true) == 0)
			{
				if(BizInfo[MakeBiz[playerid]][tPos][0] != 0.0)
				{
					SCM(playerid,SAMP_WEISS,""IINFO" der erste Punkt wurde bereits erstellt.(Schreibe 'Back' um den ersten Punkt zu löschen.)");
					return 0;
				}
				GetPlayerPos(playerid,BizInfo[MakeBiz[playerid]][tPos][0],BizInfo[MakeBiz[playerid]][tPos][1],BizInfo[MakeBiz[playerid]][tPos][2]);
				if(BizInfo[MakeBiz[playerid]][biz_art] == 10)//tankstelle
				{
					format(string,sizeof(string),""#HTML_WEISS"[ "#HTML_BLAU"%s"#HTML_WEISS" ]\nBenzin: "#HTML_BLAU"%i$"#HTML_WEISS" Pro_L\nDiesel: "#HTML_BLAU"%i$"#HTML_WEISS" Pro_L\nTurboBenzin: "#HTML_BLAU"%i$"#HTML_WEISS" Pro_L\nKerosin: "#HTML_BLAU"%i$"#HTML_WEISS" Pro_L\nTanken?\n/tanken"
					,BizName(MakeBiz[playerid]),BizInfo[MakeBiz[playerid]][biz_artikel][0],BizInfo[MakeBiz[playerid]][biz_artikel][1],BizInfo[MakeBiz[playerid]][biz_artikel][2],BizInfo[MakeBiz[playerid]][biz_artikel][3]);
					BizLabel[MakeBiz[playerid]][1] = CreateDynamic3DTextLabel(string,SAMP_WEISS,BizInfo[MakeBiz[playerid]][tPos][0],BizInfo[MakeBiz[playerid]][tPos][1],BizInfo[MakeBiz[playerid]][tPos][2],10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
					BizInfo[MakeBiz[playerid]][biz_pickup][1] = CreateDynamicPickup(1650,1,BizInfo[MakeBiz[playerid]][tPos][0],BizInfo[MakeBiz[playerid]][tPos][1],BizInfo[MakeBiz[playerid]][tPos][2],0);
				}
				if(BizInfo[MakeBiz[playerid]][biz_art] == 14)//Base-Jump Business
				{
					format(string,sizeof(string),"%s\nKosten pro Fallschirm: %i$\nBefehle: /parachute",BizName(MakeBiz[playerid]),BizInfo[MakeBiz[playerid]][biz_artikel][0]);
					BizLabel[MakeBiz[playerid]][1] = CreateDynamic3DTextLabel(string,SAMP_WEISS,BizInfo[MakeBiz[playerid]][tPos][0],BizInfo[MakeBiz[playerid]][tPos][1],BizInfo[MakeBiz[playerid]][tPos][2],10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
					BizInfo[MakeBiz[playerid]][biz_pickup][1] = CreateDynamicPickup(371,1,BizInfo[MakeBiz[playerid]][tPos][0],BizInfo[MakeBiz[playerid]][tPos][1],BizInfo[MakeBiz[playerid]][tPos][2],0);
				}
				SCM(playerid,SAMP_WEISS,"Schreibe 'Punkt2' um den zweiten Punkt zu erstellen.");
				return 0;
			}
			if(strcmp(text,"Punkt2",true) == 0)
			{
				if(BizInfo[MakeBiz[playerid]][tPos][3] != 0.0)
				{
					SCM(playerid,SAMP_WEISS,""IINFO" der erste Punkt wurde bereits erstellt.(Schreibe 'Back' um den zweiten Punkt zu löschen.)");
					return 0;
				}
				GetPlayerPos(playerid,BizInfo[MakeBiz[playerid]][tPos][3],BizInfo[MakeBiz[playerid]][tPos][4],BizInfo[MakeBiz[playerid]][tPos][5]);
			    if(BizInfo[MakeBiz[playerid]][biz_art] == 10)//tankstelle
				{
					format(string,sizeof(string),""#HTML_WEISS"[ "#HTML_BLAU"%s"#HTML_WEISS" ]\nBenzin: "#HTML_BLAU"%i$"#HTML_WEISS" Pro_L\nDiesel: "#HTML_BLAU"%i$"#HTML_WEISS" Pro_L\nTurboBenzin: "#HTML_BLAU"%i$"#HTML_WEISS" Pro_L\nKerosin: "#HTML_BLAU"%i$"#HTML_WEISS" Pro_L\nTanken?\n/tanken"
					,BizName(MakeBiz[playerid]),BizInfo[MakeBiz[playerid]][biz_artikel][0],BizInfo[MakeBiz[playerid]][biz_artikel][1],BizInfo[MakeBiz[playerid]][biz_artikel][2],BizInfo[MakeBiz[playerid]][biz_artikel][3]);
					BizLabel[MakeBiz[playerid]][2] = CreateDynamic3DTextLabel(string,SAMP_WEISS,BizInfo[MakeBiz[playerid]][tPos][3],BizInfo[MakeBiz[playerid]][tPos][4],BizInfo[MakeBiz[playerid]][tPos][5],10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
					BizInfo[MakeBiz[playerid]][biz_pickup][2] = CreateDynamicPickup(1650,1,BizInfo[MakeBiz[playerid]][tPos][3],BizInfo[MakeBiz[playerid]][tPos][4],BizInfo[MakeBiz[playerid]][tPos][5],0);
				}
				if(BizInfo[MakeBiz[playerid]][biz_art] == 14)//Base-Jump Business
				{
					format(string,sizeof(string),"%s\nKosten pro Fallschirm: %i$\nBefehle: /parachute",BizName(MakeBiz[playerid]),BizInfo[MakeBiz[playerid]][biz_artikel][0]);
					BizLabel[MakeBiz[playerid]][2] = CreateDynamic3DTextLabel(string,SAMP_WEISS,BizInfo[MakeBiz[playerid]][tPos][3],BizInfo[MakeBiz[playerid]][tPos][4],BizInfo[MakeBiz[playerid]][tPos][5],10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
					BizInfo[MakeBiz[playerid]][biz_pickup][2] = CreateDynamicPickup(371,1,BizInfo[MakeBiz[playerid]][tPos][3],BizInfo[MakeBiz[playerid]][tPos][4],BizInfo[MakeBiz[playerid]][tPos][5],0);
				}
				format(string,sizeof(string),"Bizstellungs Fortschritt:\nBizart: %s\nPreis: %i$\nLevel zum kauf: %i\nGebe nun eine Beschreibung zum Buisness ein:",BizName(MakeBiz[playerid]),BizInfo[MakeBiz[playerid]][biz_preis],BizInfo[MakeBiz[playerid]][biz_level]);
			    ShowPlayerDialog(playerid,BIZ_ERSTELLEN_BESCHREIBUNG,DIALOG_STYLE_INPUT,""ClanTagDialoge" Bizerstellung -> Straße",""#HTML_WEISS"Gebe nun die Straße ein!","Weiter","Zurück");
				return 0;
			}
		}
	}

	new strpos = strfind(text,"www",true);
	if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
	{
		strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
		return 0;
	}
	if(Spieler[playerid][pMuted] == 1)
	{
		format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		SCM(playerid,WEISS,string);
		format(string,sizeof(string),"** %s kann nicht reden,da er gemutet ist **",SpielerName(playerid));
		PlayerTalkOnly(playerid,SAMP_PublicChatColor,string,10);
		return 0;
	}
	for(new i=0;i<sizeof(BadWord);i++)
	{
	 	if(strfind(text,BadWord[i],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
			SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: öffentlicher Chat",BadWord[i],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 0;
	    }
	}

	if(UseCheatCodes(text))
	{
	    format(string,sizeof(string),""ACINFO" das System hat den Spieler %s (ID:%i) gebannt. Grund: Cheater",Spieler[playerid][pName],playerid);
		SendClientMessageToAll(SAMP_WEISS,string);
		BanUser(playerid,"System","SinglePlayerCheatCodes");
	}

	if(Spieler[playerid][LiveView] == 1)
	{
		if(isPlayerInFrakt(playerid,10))
		{
		 	format(string,sizeof(string),"Live Reporter %s: %s",SpielerName(playerid),text);
			SendClientMessageToAll(0x60CC00FF,string);
			return 0;
		}
		else
		{
		 	format(string,sizeof(string),"Live Gast %s: %s",SpielerName(playerid),text);
			SendClientMessageToAll(0x60CC00FF,string);
			return 0;
		}
	}

	if(Spieler[playerid][pDeath] == 1)
	{
	    format(string,sizeof(string),"%s flüstert: %s",SpielerName(playerid),text);
		SCM(playerid,WEISS,string);
		format(string,sizeof(string),"%s flüstert: %s",SpielerName(playerid),text);
		PlayerTalkOnly(playerid,0xA0A0A0FF,string,5);
		return 0;
	}

	if(Spieler[playerid][pCallHim] == 1)
	{
	    new pID = Spieler[playerid][pCall];
		if(ReturnHempfangRate(playerid) != -1)
		{
			format(string,sizeof(string),"(Handy) %s: %s",SpielerName(playerid),text);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),"(Handy) %s: %s",SpielerName(playerid),text);
			PlayerTalkPublic(playerid,0xA0A0A0FF,string,10);
			format(string,sizeof(string),"(Handy) %s: %s",SpielerName(playerid),text);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(Spieler[i][IreadALL] == 1)
					{
						SCM(i,SAMP_WEISS,string);
					}
				}
			}
			return 0;
		}
		else
		{
			Spieler[playerid][pCallHim] = 0;
			Spieler[pID][pCallHim] = 0;
			Spieler[pID][pCall] = -1;
			Spieler[playerid][pCall] = -1;
			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
			SetPlayerSpecialAction(pID,SPECIAL_ACTION_STOPUSECELLPHONE);
			SCM(playerid,SAMP_WEISS,"Verbindung unterbrochen.");
			SCM(pID,SAMP_WEISS,"Verbindung unterbrochen.");
			PlayerPlaySound(playerid,1077,0.0,0.0,0.0);
			PlayerPlaySound(pID,1077,0.0,0.0,0.0);
			return 0;
		}
	}
	if(IsPlayerConnected(playerid))
	{
	    if(Spieler[playerid][pAdminOnduty] == false)
		{
		    if(gPlayerUsingLoopingAnim[playerid] == false && animak[playerid] == false && Spieler[playerid][RpChat] == 1 && !IsPlayerInVehicle(playerid,GetPlayerVehicleID(playerid)))
		    {
		        OnePlayAnim(playerid,"PED","IDLE_CHAT",4.0,0,0,0,0,0);
		    }
			format(string,sizeof(string),"%s sagt: %s",SpielerName(playerid),text);
			SCM(playerid,WEISS,string);
			format(string,sizeof(string),"%s sagt: %s",SpielerName(playerid),text);
			PlayerTalkOnly(playerid,0xA0A0A0FF,string,10);
		}
		else
		{
		    if(gPlayerUsingLoopingAnim[playerid] == false && animak[playerid] == false && Spieler[playerid][RpChat] == 1 && !IsPlayerInVehicle(playerid,GetPlayerVehicleID(playerid)))
		    {
		        OnePlayAnim(playerid,"PED","IDLE_CHAT",4.0,0,0,0,0,0);
		    }
			format(string,sizeof(string),"{FF0000}%s{FFFFFF} sagt: %s",SpielerName(playerid),text);
			SCM(playerid,WEISS,string);
			format(string,sizeof(string),"{FF0000}%s{C9C9C9} sagt: %s",SpielerName(playerid),text);
			PlayerTalkOnly(playerid,0xA0A0A0FF,string,10);
		}
		return 0;
	}
	return 1;
}
/*public OnPlayerCommandText(playerid,cmdtext[])
{
 	new string[128];
    format(string,sizeof(string),""#HTML_BLAU""ClanTag":"#HTML_WEISS" Der Befehl: %s gibt es hier nicht versuchs mit ((/hilfe))",cmdtext);
 	return SCM(playerid,WEISS,string);
}*/
// HINWEIS: zcmd.inc definiert am Ende  #define OnPlayerCommandText zcmd_OnPlayerCommandText .
// Spielereingaben laufen deshalb NICHT durch diese Fassung, sondern durch die
// Fassung in "pawno/include/Gloabe Includes/zcmd.inc" - dort steht die
// Laengenpruefung fuer funcname bereits (if (pos > MAX_FUNC_NAME - 5) return 0;).
// Diese Fassung hier wird nur noch bei internen Aufrufen der Form
// OnPlayerCommandText(playerid,"/befehl") im Script benutzt; die Grenzpruefung
// unten muss deshalb trotzdem stehen bleiben.
public OnPlayerCommandText(playerid, const cmdtext[])
{
    new
        pos,
        funcname[36];
    while (cmdtext[++pos] > ' ')
	{
		if (pos > 31) return 0; funcname[pos-1] = tolower(cmdtext[pos]);
	}
	funcname[pos-1] = '\0'; format(funcname, sizeof(funcname),"cmd_%s", funcname);
	while (cmdtext[pos] == ' ') pos++;
	if (!cmdtext[pos])
	{
		return CallLocalFunction(funcname,"is", playerid,"\1");
	}
	return CallLocalFunction(funcname,"is", playerid, cmdtext[pos]);
}
public OnPlayerCommandPerformed(playerid,const cmdtext[],success)
{
    new string[256];
	if(Sekunden > 0)
	{
		format(string,sizeof(string),"{00AFFF}"#SERVERTAG"{FFFFFF} : Der Server restartet in %i Sekunden!",Sekunden);
		return SCM(playerid,WEISS,string);
	}
	if(!success)
 	{
	  	format(string,sizeof(string),""#HTML_BLAU""ClanTag":"#HTML_WEISS" Der Befehl: %s gibt es hier nicht versuchs mit ((/hilfe))",cmdtext);
		return SCM(playerid,WEISS,string);
 	}
 	return 1;
}
