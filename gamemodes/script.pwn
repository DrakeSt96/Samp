		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		Spieler[playerid][pSpice] -= menge;
		Spieler[pID][pSpice] += menge;
		return 1;
	}
	if(strcmp(cmd,"Lunch",true) == 0)
	{
	    if((Spieler[playerid][pLunchpaket] - menge) < 0)return SCM(playerid,SAMP_WEISS,""IINFO" du trägst nicht so viele Lunchpakete bei dir!");
