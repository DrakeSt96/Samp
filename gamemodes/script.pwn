	if(strcmp(cmd,"Interview",true) == 0)
   	{
	   	if(Spieler[playerid][InviteInterView] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" niemand bietet dir ein Interview an.");
	   	if(IsPlayerInRangeOfPoint(playerid,5.0,861.9858,-1045.1128,25.9659) || IsPlayerInRangeOfPoint(playerid,5.0,-219.3893,1410.6112,27.7734))
		{
			pID = Spieler[playerid][pSeller];
			if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst kein Interview mit dir selbst führen!");
			if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,"Spieler nicht eingeloggt.");
			if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
			format(string,sizeof(string),""IINFO" der San Andreas News Reporter %s startet ein Interview mit %s",SpielerName(pID),SpielerName(playerid));
			SendClientMessageToAll(ORANGE,string);
			format(string,sizeof(string),"%s hat das Interview von dir angenommen.",SpielerName(playerid));
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast das Interview mit %s angenommen.",SpielerName(pID));
			SCM(playerid,SAMP_WEISS,string);
			Spieler[pID][LiveView] = 1;
			Spieler[playerid][LiveView] = 1;
			Spieler[playerid][InviteInterView] = 0;
			Spieler[playerid][pSeller] = -1;
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier kein Interview annehmen!");
	}
	if(strcmp(cmd,"Immobilie",true) == 0)
	{
	    new besitzerid = Immobilienbesitzer[playerid],kundenid = Immobilienkunde[playerid],seller = Immobilienseller[playerid];
		if(Immobiliensell[playerid] == 0)return SCM(playerid,SAMP_WEISS,"In keiner Kaufauktion Aktiv.");
		if(playerid == besitzerid)
		{
			if(!IsPlayerConnected(kundenid))return SCM(playerid,SAMP_WEISS,"Besitzer nicht eingeloggt!");
			if(!IsPlayerConnected(seller))return SCM(playerid,SAMP_WEISS,"Immobilienmakler nicht eingeloggt!");
		    if(!ProxDetectorS(5.0,playerid,kundenid))return SCM(playerid,SAMP_WEISS,"Besitzer nicht in deiner Nähe.");
		    if(!ProxDetectorS(5.0,playerid,seller))return SCM(playerid,SAMP_WEISS,"Immobilienmakler nicht in deiner Nähe.");
		    if(Immobilienart[playerid] == 1)
		    {
				ReturnPropertyData(playerid);
				new count = Spieler[playerid][pReturnPropertyDataHausCount];
				if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Besitz eines Hauses!");
				format(string,sizeof(string),""IINFO" du hast Bestätigt das %s (ID:%i) dein Haus [Hausnummer %i] an %s (ID:%i) verkaufen darf!",SpielerName(seller),seller,Immobilienid[playerid],SpielerName(kundenid),kundenid);
				SCM(playerid,SAMP_WEISS,string);
				SCM(playerid,SAMP_WEISS,"Warte auf Annahme vom Käufer!");
				format(string,sizeof(string),"%s (ID:%i) hat Bestätig das %s (ID:%i) sein/ihr Haus [Hausnummer %i] an dich verkaufen darf!",SpielerName(besitzerid),besitzerid,SpielerName(seller),seller,Immobilienid[playerid]);
				SCM(kundenid,SAMP_WEISS,string);
				SCM(kundenid,SAMP_WEISS,"Nutze '/accept immobilie' um das Haus zu kaufen!");
				format(string,sizeof(string),"%s (ID:%i) hat Bestätigt das du sein Haus [Hausnummer %i] an %s (ID:%i) verkaufen darfst!",SpielerName(besitzerid),besitzerid,Immobilienid[playerid],SpielerName(kundenid),kundenid);
				SCM(seller,SAMP_WEISS,string);
				SCM(seller,SAMP_WEISS,"Warte auf Bestätiung vom Käufer!");
				Immobilienbesitzeraccepted[kundenid] = 1;
				return 1;
			}
			if(Immobilienart[playerid] == 2)
		    {
			    new biz = GetBusinessOwner(playerid,Spieler[playerid][pName]);
				if(biz == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Besitz eines Businesses!");
				format(string,sizeof(string),""IINFO" du hast Bestätigt das %s (ID:%i) dein Business (%s) [Bizid %i] an %s (ID:%i) verkaufen darf!",SpielerName(seller),seller,BizName(Immobilienid[playerid]),Immobilienid[playerid],SpielerName(kundenid),kundenid);
				SCM(playerid,SAMP_WEISS,string);
				SCM(playerid,SAMP_WEISS,"Warte auf Annahme vom Käufer!");
				format(string,sizeof(string),"%s (ID:%i) hat Bestätig das %s (ID:%i) sein/ihr Business (%s) [Bizid %i] an dich verkaufen darf!",SpielerName(besitzerid),besitzerid,SpielerName(seller),seller,BizName(Immobilienid[playerid]),Immobilienid[playerid]);
				SCM(kundenid,SAMP_WEISS,string);
				SCM(kundenid,SAMP_WEISS,"Nutze '/accept immobilie' um das Haus zu kaufen!");
				format(string,sizeof(string),"%s (ID:%i) hat Bestätigt das du sein Business (%s) [Bizid %i] an %s (ID:%i) verkaufen darfst!",SpielerName(besitzerid),besitzerid,BizName(Immobilienid[playerid]),Immobilienid[playerid],SpielerName(kundenid),kundenid);
				SCM(seller,SAMP_WEISS,string);
				SCM(seller,SAMP_WEISS,"Warte auf Bestätiung vom Käufer!");
				Immobilienbesitzeraccepted[kundenid] = 1;
				return 1;
			}
			return 1;
		}
		if(playerid == kundenid && Immobilienbesitzeraccepted[playerid] == 1)
		{
			if(!IsPlayerConnected(besitzerid))return SCM(playerid,SAMP_WEISS,"Besitzer nicht eingeloggt!");
			if(!IsPlayerConnected(seller))return SCM(playerid,SAMP_WEISS,"Immobilienmakler nicht eingeloggt!");
			if(!ProxDetectorS(5.0,playerid,besitzerid))return SCM(playerid,SAMP_WEISS,"Besitzer nicht in deiner Nähe.");
		    if(!ProxDetectorS(5.0,playerid,seller))return SCM(playerid,SAMP_WEISS,"Immobilienmakler nicht in deiner Nähe.");
		    if((GetACMoney(playerid) - Immobilienpreis[playerid]) < 0)
			{
			    PlayerPlaySound(playerid,1055,0.0,0.0,0.0);
				return SCM(playerid,SAMP_WEISS,""IINFO" du hast nicht genug Geld dabei");
			}
			if(Immobilienart[playerid] == 1)
		    {
			    ReturnPropertyData(playerid);
				new haus = Spieler[playerid][pReturnPropertyDataHaus],count = Spieler[playerid][pReturnPropertyDataHausCount];
				if(count >= MAX_HAUS_OWNER)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt bereits "#MAX_HAUS_OWNER" Haus!");
			    ReturnPropertyData(besitzerid);
			    haus = Spieler[besitzerid][pReturnPropertyDataHaus],count = Spieler[besitzerid][pReturnPropertyDataHausCount];
			    if(haus <= 0 || haus >= MAX_HAUS)return SCM(playerid,SAMP_WEISS,"Der Besitzer besitzt kein Haus / ihr seid nicht in der Naehe seines Hauses.");
			    if(haus == -1)return SCM(playerid,SAMP_WEISS,""IINFO" der Besitzer besitzt kein Haus./Ihr seit nicht in der Nähe des Hauses vom Besitzer.");
			    format(string,sizeof(string),"%s (ID:%i) hat das Haus [Hausnummer %i] von %s (ID:%i) für %i$ an dich vermarktet!",SpielerName(seller),seller,Immobilienid[playerid],SpielerName(besitzerid),besitzerid,Immobilienpreis[playerid]);
				SCM(playerid,SAMP_WEISS,string);
				SCM(playerid,SAMP_WEISS,"Es gehört nun dir!");
				format(string,sizeof(string),"%s (ID:%i) hat dein Haus [Hausnummer %i] für %i$ an %s (ID:%i) verkauft! Du erhälst %i$.",SpielerName(seller),seller,Immobilienid[playerid],Immobilienpreis[playerid],SpielerName(playerid),playerid,Immobilienpreis[playerid]);
				SCM(besitzerid,SAMP_WEISS,string);
				format(string,sizeof(string),""IINFO" du hast das Haus [Hausnummer %i] von %s (ID:%i) für %i$ an %s (ID:%i) vermarktet!",Immobilienid[playerid],SpielerName(besitzerid),besitzerid,Immobilienpreis[playerid],SpielerName(playerid),playerid);
				SCM(seller,SAMP_WEISS,string);
				SCM(seller,SAMP_WEISS,"Es gehört nun ihm!");
				HausInfo[haus][haus_locked] = 0;
				strmid(HausInfo[haus][haus_besitzer],Spieler[playerid][pName],0,strlen(Spieler[playerid][pName]),24);
				//strmid(HausInfo[haus][haus_beschreibung],"Keine",0,strlen("Keine"),150);
				strmid(HausInfo[haus][haus_msg],"Keine",0,strlen("Keine"),150);
				UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
		    }
			if(Immobilienart[playerid] == 2)
		    {
			    if(Spieler[playerid][pPremium] > gettime())
			    {
			    	if(IsPlayerAnyBusinessOwner(Spieler[playerid][pName]) >= MAX_BUSINESS_OWNER)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt bereits "#MAX_BUSINESS_OWNER" Businesse!");
				}
				else
				{
					if(IsPlayerAnyBusinessOwner(Spieler[playerid][pName]) >= MAX_BUSINESS_OWNER/2)
					{
						format(string,sizeof(string),""IINFO" du besitzt bereits %i Businesse!",MAX_BUSINESS_OWNER/2);
						return SCM(playerid,SAMP_WEISS,string);
					}
				}
				new bizfromowner = GetBusinessOwner(besitzerid,Spieler[besitzerid][pName]);
				if(bizfromowner == -1)return SCM(playerid,SAMP_WEISS,""IINFO" der Besitzer besitzt kein Business./Ihr seit nicht in der Nähe des Business vom Besitzer.");
			    format(string,sizeof(string),"%s (ID:%i) hat das Business (%s) [Bizid %i] von %s (ID:%i) für %i$ an dich vermarktet!",SpielerName(seller),seller,BizName(Immobilienid[playerid]),Immobilienid[playerid],SpielerName(besitzerid),besitzerid,Immobilienpreis[playerid]);
				SCM(playerid,SAMP_WEISS,string);
				SCM(playerid,SAMP_WEISS,"Es gehört nun dir!");
				format(string,sizeof(string),"%s (ID:%i) hat dein Business (%s) [Bizid %i] für %i$ an %s (ID:%i) verkauft! Du erhälst %i$.",SpielerName(seller),seller,BizName(Immobilienid[playerid]),Immobilienid[playerid],Immobilienpreis[playerid],SpielerName(playerid),playerid,Immobilienpreis[playerid]);
				SCM(besitzerid,SAMP_WEISS,string);
				format(string,sizeof(string),""IINFO" du hast das Business (%s) [Bizid %i] von %s (ID:%i) für %i$ an %s (ID:%i) vermarktet!",BizName(Immobilienid[playerid]),Immobilienid[playerid],SpielerName(besitzerid),besitzerid,Immobilienpreis[playerid],SpielerName(playerid),playerid);
				SCM(seller,SAMP_WEISS,string);
				SCM(seller,SAMP_WEISS,"Es gehört nun ihm!");
				BizInfo[bizfromowner][biz_locked] = 0;
				strmid(BizInfo[bizfromowner][biz_besitzer],Spieler[playerid][pName],0,strlen(Spieler[playerid][pName]),24);
				strmid(BizInfo[bizfromowner][biz_teilhaber],"Niemand",0,strlen("Niemand"),24);
				strmid(BizInfo[bizfromowner][biz_beschreibung],"Keine",0,strlen("Keine"),150);
				UpdateBizLabel(bizfromowner,2);//funktion 1 wenn das biz ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
			}
			ACMoney(besitzerid,Immobilienpreis[playerid]);
			ACMoney(playerid,-Immobilienpreis[playerid]);
			SaveAccount(playerid);
		    SaveAccount(besitzerid);
		    Immobilienart[playerid] = 0;
			Immobiliensell[playerid] = 0;
			Immobilienseller[playerid] = -1;
			Immobilienbesitzer[playerid] = -1;
			Immobilienkunde[playerid] = -1;
			Immobilienpreis[playerid] = 0;
			Immobilienid[playerid] = -1;
			Immobilienbesitzeraccepted[playerid] = 0;
			Immobilienart[besitzerid] = 0;
			Immobiliensell[besitzerid] = 0;
			Immobilienseller[besitzerid] = -1;
			Immobilienbesitzer[besitzerid] = -1;
			Immobilienkunde[besitzerid] = -1;
			Immobilienpreis[besitzerid] = 0;
			Immobilienid[besitzerid] = -1;
			Immobilienbesitzeraccepted[besitzerid] = 0;
			Immobilienart[seller] = 0;
			Immobiliensell[seller] = 0;
			Immobilienseller[seller] = -1;
			Immobilienbesitzer[seller] = -1;
			Immobilienkunde[seller] = -1;
			Immobilienpreis[seller] = 0;
			Immobilienid[seller] = -1;
			Immobilienbesitzeraccepted[seller] = 0;
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,"Besitzer hat nocht nicht bestätigt!");
	}
	if(strcmp(cmd,"VBCHAT",true) == 0)
    {
	    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
		{
			new frak = fverwaltungen[Spieler[playerid][pFraktion]][VBprozess];
		    if(Spieler[playerid][pLeader] == 0)return SCM(playerid,SAMP_WEISS,"Kein Leader.");
		    if(fverwaltungen[Spieler[playerid][pFraktion]][VBAnfrage] == 0)return SCM(playerid,SAMP_WEISS,"Deine Fraktion wurde zu keinem Bündnischat eingeladen.");
		    fverwaltungen[Spieler[playerid][pFraktion]][HaveVBInvite] = 1;
		    fverwaltungen[frak][HaveVBInvite] = 1;
		    fverwaltungen[Spieler[playerid][pFraktion]][VBFraktion] = frak;
		    fverwaltungen[frak][VBFraktion] = Spieler[playerid][pFraktion];
		    fverwaltungen[Spieler[playerid][pFraktion]][VBAnfrage] = 0;
		    fverwaltungen[frak][VBAnfrage] = 0;
		    fverwaltungen[Spieler[playerid][pFraktion]][VBprozess] = 0;
		    fverwaltungen[frak][VBprozess] = 0;
		    format(string,sizeof(string),""IINFO" du hast die Bündnischat Anfrage der Fraktion %s angenommen.(/vb[Text])",FraktionsName(frak));
		    SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"Die Fraktion %s hat eure gestellte Bündnischat Anfrage angenommen.(/vb[Text])",FraktionsName(Spieler[playerid][pFraktion]));
		    SendFraktionsMessage(frak,FMELDUNG,string);
		    return 1;
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	}
	if(strcmp(cmd,"Taxi",true) == 0)
    {
	    new Float:pX,Float:pY,Float:pZ;
	    if(!isPlayerInJob(playerid,17))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im jeweiligen Job.");
	    if(!IsVehicleATaxi(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"In keinem Taxi.");
		if(Spieler[playerid][pTaxiDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht als Taxifahrer in Dienst.");
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallServiceTaxi] == true)
		    {
			    format(string,sizeof(string),""IINFO" du hast den Auftrag von "IINFO2"%s"#HTML_WEISS" wahrgenommen. Fahre zum Auftrag.",SpielerName(i));
			  	SCM(playerid,SAMP_WEISS,string);
			   	format(string,sizeof(string),"Taxifahrer "IINFO2"%s"#HTML_WEISS" hat deinen Anruf wahrgenommen und ist unterwegs zu dir. Warte einen Moment!",SpielerName(playerid));
			   	SCM(i,SAMP_WEISS,string);
				GameTextForPlayer(playerid,"~g~Fahre zum Auftrag",2500,1);
				GetPlayerPos(i,pX,pY,pZ);
				SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
				Spieler[playerid][pIsearch] = 1;
				Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
			    Spieler[playerid][pOrtenVehIDplayerid] = i;
			    Spieler[i][pCallServiceTaxi] = false;
				return 1;
		    }
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Taxifahrer angefordert.");
	}
	if(strcmp(cmd,"Bestatten",true) == 0)
    {
	    if(isPlayerInFrakt(playerid,18) || isPlayerInJob(playerid,12))
		{
		    if(!IsVehicleADeathCar(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"In keinem Leichenwagen.");
		    for(new deather = 0;deather<MAX_TOTEN;deather++)
			{
				if(TotenInfo[deather][totenlevel] != 0)
				{
				    format(string,sizeof(string),""IINFO" du hast den Auftrag Nummer %i wahrgenommen. Fahre zum Auftrag.",deather);
				  	SCM(playerid,SAMP_WEISS,string);
					GameTextForPlayer(playerid,"~g~Fahre zum Auftrag",2500,1);
					SetPlayerCheckpoint(playerid,TotenInfo[deather][totenxpos],TotenInfo[deather][totenypos],TotenInfo[deather][totenzpos],3.0);
					Spieler[playerid][pIsearch] = 1;
					return 1;
			    }
			}
			return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Leichenbestatter angefordert.");
		}
		else
		{
  			SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im jeweiligen Fraktion/Du bist nicht im jeweiligen Job.");
		}
		return 1;
	}
	if(strcmp(cmd,"Mechaniker",true) == 0)
    {
	    new Float:pX,Float:pY,Float:pZ;
	    if(isPlayerInJob(playerid,12) || isPlayerInFrakt(playerid,11))
	    {
		    ForEachPlayer(i)
		    {
			    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallServicMechanic] == true)
			    {
				    format(string,sizeof(string),""IINFO" du hast den Auftrag von "IINFO2"%s"#HTML_WEISS" wahrgenommen. Fahre zum Auftrag.",SpielerName(i));
				  	SCM(playerid,SAMP_WEISS,string);
				   	format(string,sizeof(string),"Mechaniker: "IINFO2"%s"#HTML_WEISS" hat deinen Auftrag wahrgenommen und ist unterwegs zu dir. Warte einen Moment!",SpielerName(playerid));
				   	SCM(i,SAMP_WEISS,string);
					GameTextForPlayer(playerid,"~g~Fahre zum Auftrag",2500,1);
					GetPlayerPos(i,pX,pY,pZ);
					SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
					Spieler[playerid][pIsearch] = 1;
					Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
				    Spieler[playerid][pOrtenVehIDplayerid] = i;
				    Spieler[i][pCallServicMechanic] = false;
					return 1;
			    }
			}
			return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Mechaniker angefordert.");
		}
		else
		{
		    SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im jeweiligen Fraktion/Du bist nicht im jeweiligen Job.");
		}
		return 1;
	}
	if(strcmp(cmd,"Rubbish",true) == 0)
    {
	    new Float:pX,Float:pY,Float:pZ;
	    if(!isPlayerInJob(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im jeweiligen Job.");
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallServiceRubbishMen] == true)
		    {
			    format(string,sizeof(string),""IINFO" du hast den Auftrag von %s wahrgenommen. Fahre zum Auftrag.",SpielerName(i));
			  	SCM(playerid,SAMP_WEISS,string);
			   	format(string,sizeof(string),"Müllman %s hat deinen Auftrag wahrgenommen und ist unterwegs zu dir. Warte einen Moment!",SpielerName(playerid));
			   	SCM(i,SAMP_WEISS,string);
				GameTextForPlayer(playerid,"~g~Fahre zum Auftrag",2500,1);
				GetPlayerPos(i,pX,pY,pZ);
				SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
				Spieler[playerid][pIsearch] = 1;
				Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
			    Spieler[playerid][pOrtenVehIDplayerid] = i;
			    Spieler[i][pCallServiceRubbishMen] = false;
				return 1;
		    }
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Müllwagen angefordert.");
	}
	if(strcmp(cmd,"Befreiung",true) == 0)
   	{
		new Float:pX,Float:pY,Float:pZ;
	    if(!isPlayerInFrakt(playerid,12))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallServiceWheelman] == true)
		    {
			    format(string,sizeof(string),""IINFO" du hast den Auftrag von %s wahrgenommen und begibst dich zum Auftrag | Wantedlevel: %i | Derzeitiges Fahndungslevel: %i",SpielerName(i),GetPlayerWantedLevel(i),Spieler[i][pWantedPoints]);
			  	SCM(playerid,SAMP_WEISS,string);
				GameTextForPlayer(playerid,"~g~Fahre zum Auftrag",3000,1);
				GetPlayerPos(i,pX,pY,pZ);
				SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
				Spieler[playerid][pIsearch] = 2;
			    format(string,sizeof(string),"**(( %s %s: Habe den Auftrag von %s (ID:%i) wahrgenommen und begebe mich zum Auftrag! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],SpielerName(i),i);
			    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
				Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
			    Spieler[playerid][pOrtenVehIDplayerid] = i;
			    SpielerOrtenTimer[playerid] = SetTimerEx("SpielerOderFahrzeugOrten",1000,true,"iii",playerid,i,1);
			    Spieler[i][pCallServiceWheelman] = false;
				return 1;
		    }
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat eine Befreiung angefordert.");
   	}
	if(strcmp(cmd,"Sapd",true) == 0)
    {
	    new Float:pX,Float:pY,Float:pZ;
	    if(!isPlayerInFrakt(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallServicSAPD] == true)
		    {
			    format(string,sizeof(string),""IINFO" du hast den Auftrag von %s wahrgenommen und begibst dich zum Einsatzort.",SpielerName(i));
			  	SCM(playerid,SAMP_WEISS,string);
			   	format(string,sizeof(string),"%s hat den Auftrag angenommen und ist untwegs zu dir. Warte einen Moment!",SpielerName(playerid));
			   	SCM(i,SAMP_WEISS,string);
				GameTextForPlayer(playerid,"~g~Fahre zum Einsatzort",2500,1);
				GetPlayerPos(i,pX,pY,pZ);
				SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
				Spieler[playerid][pIsearch] = 1;
			    format(string,sizeof(string),"**(( %s %s: Habe den Auftrag von %s (ID:%i) wahrgenommen und begebe mich zum Einsatzort! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],SpielerName(i),i);
			    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
				Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
			    Spieler[playerid][pOrtenVehIDplayerid] = i;
			    Spieler[i][pCallServicSAPD] = false;
				return 1;
		    }
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Polizisten angefordert.");
	}
   	if(strcmp(cmd,"Medic",true) == 0)
   	{
		new Float:pX,Float:pY,Float:pZ;
	    if(!isPlayerInFrakt(playerid,3))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallServiceMedic] == true)
		    {
			    format(string,sizeof(string),""IINFO" du hast den Auftrag von %s wahrgenommen und begibst dich zum Einsatzort.",SpielerName(i));
			  	SCM(playerid,SAMP_WEISS,string);
			   	format(string,sizeof(string),"%s hat den Auftrag angenommen und ist untwegs zu dir. Warte einen Moment!",SpielerName(playerid));
			   	SCM(i,SAMP_WEISS,string);
				GameTextForPlayer(playerid,"~g~Fahre zum Einsatzort",2500,1);
				GetPlayerPos(i,pX,pY,pZ);
				SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
				Spieler[playerid][pIsearch] = 1;
			    format(string,sizeof(string),"**(( %s %s: Habe den Auftrag von %s (ID:%i) wahrgenommen und begebe mich zum Einsatzort! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],SpielerName(i),i);
			    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
				Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
			    Spieler[playerid][pOrtenVehIDplayerid] = i;
			    Spieler[i][pCallServiceMedic] = false;
				return 1;
		    }
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Notarzt angefordert.");
   	}
   	if(strcmp(cmd,"Verstaerkung",true) == 0)
   	{
		new Float:pX,Float:pY,Float:pZ;
	    if(!isPlayerInFrakt(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallVaersterkung] == true)
		    {
			    format(string,sizeof(string),"Verstärkungsnotruf von %s wahrgenommen und begibst dich umgehend zum Einsatzort.",SpielerName(i));
			  	SCM(playerid,SAMP_WEISS,string);
			   	format(string,sizeof(string),"%s ist unterwegs zum Einsatzort!",SpielerName(playerid));
			   	SCM(i,SAMP_WEISS,string);
				GameTextForPlayer(playerid,"~g~Fahre zum Einsatzort",2500,1);
				GetPlayerPos(i,pX,pY,pZ);
				SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
				Spieler[playerid][pIsearch] = 1;
			    format(string,sizeof(string),"**(( %s %s: Verstärkung von %s (ID:%i) angenommen. Begebe mich zum Einsatzort! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],SpielerName(i),i);
			    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
				Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
			    Spieler[playerid][pOrtenVehIDplayerid] = i;
			    Spieler[i][pCallVaersterkung] = false;
				return 1;
		    }
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat Verstärkung angefordert.");
   	}
   	if(strcmp(cmd,"pod",true) == 0)
   	{
	   	new Float:pX,Float:pY,Float:pZ;
	    if(!isPlayerInFrakt(playerid,11))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallServicOAmt] == true)
		    {
			    format(string,sizeof(string),""IINFO" du hast den Auftrag von "IINFO2"%s"#HTML_WEISS" wahrgenommen und begibst dich zum Einsatzort.",SpielerName(i));
			  	SCM(playerid,SAMP_WEISS,string);
			   	format(string,sizeof(string),""IINFO" %s hat den Auftrag angenommen und ist untwegs zu dir. Bitte bleibe da wo du bist.",SpielerName(playerid));
			   	SCM(i,SAMP_WEISS,string);
				GameTextForPlayer(playerid,"~g~Fahre zum Einsatzort",2500,1);
				GetPlayerPos(i,pX,pY,pZ);
				SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
				Spieler[playerid][pIsearch] = 1;
				format(string,sizeof(string),"**(( %s %s: Habe den Auftrag von %s wahrgenommen und begebe mich zum Einsatzort! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],SpielerName(i));
			    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
				Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
			    Spieler[playerid][pOrtenVehIDplayerid] = i;
			    Spieler[i][pCallServicOAmt] = false;
				return 1;
	    	}
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Abschlepper angefordert.");
	}
   	if(strcmp(cmd,"Feuer",true) == 0)
   	{
		new Float:pX,Float:pY,Float:pZ;
	    if(!isPlayerInFrakt(playerid,3) && Spieler[playerid][pFraktABTInvite] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion/Abteilung.");
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallServicFireBrigade] == true)
		    {
			    format(string,sizeof(string),""IINFO" du hast den Auftrag von %s wahrgenommen und begibst dich zum Einsatzort.",SpielerName(i));
			  	SCM(playerid,SAMP_WEISS,string);
			   	format(string,sizeof(string),"%s hat den Auftrag angenommen und ist untwegs zu dir. Warte einen Moment!",SpielerName(playerid));
			   	SCM(i,SAMP_WEISS,string);
				GameTextForPlayer(playerid,"~g~Fahre zum Einsatzort",2500,1);
				GetPlayerPos(i,pX,pY,pZ);
				SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
				Spieler[playerid][pIsearch] = 1;
				format(string,sizeof(string),"**(( %s %s: Habe den Auftrag von %s (ID:%i) wahrgenommen und begebe mich zum Einsatzort! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],SpielerName(i),i);
			    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
				Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
			    Spieler[playerid][pOrtenVehIDplayerid] = i;
			    Spieler[i][pCallServicFireBrigade] = false;
				return 1;
		    }
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Löschzug angefordert.");
 	}
	if(strcmp(cmd,"Elektriker",true) == 0)
    {
	    new Float:pX,Float:pY,Float:pZ;
	    if(!isPlayerInFrakt(playerid,15))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
	    ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i) && !IsPlayerNPC(i) && playerid != i && Spieler[i][pCallServicElektrik] == true)
		    {
			    format(string,sizeof(string),""IINFO" du hast den Auftrag von %s wahrgenommen und begibst dich zum Einsatzort.",SpielerName(i));
			  	SCM(playerid,SAMP_WEISS,string);
			   	format(string,sizeof(string),"%s hat den Auftrag angenommen und ist untwegs zu dir. Warte einen Moment!",SpielerName(playerid));
			   	SCM(i,SAMP_WEISS,string);
				GameTextForPlayer(playerid,"~g~Fahre zum Einsatzort",2500,1);
				GetPlayerPos(i,pX,pY,pZ);
				SetPlayerCheckpoint(playerid,pX,pY,pZ,3.0);
				Spieler[playerid][pIsearch] = 1;
				format(string,sizeof(string),"**(( %s %s: Habe den Auftrag von %s (ID:%i) wahrgenommen und begebe mich zum Einsatzort! ))**",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],SpielerName(i),i);
			    SendFraktionsMessage(Spieler[playerid][pFraktion],FCHATCOLOR,string);
				Spieler[playerid][pOrtenVehORPlayer] = 3;//1 playerid 2 veh 3 service accept
			    Spieler[playerid][pOrtenVehIDplayerid] = i;
			    Spieler[i][pCallServicElektrik] = false;
				return 1;
		    }
		}
		return SCM(playerid,SAMP_WEISS,""IINFO" niemand hat einen Elektriker angefordert.");
	}
	SCM(playerid,SAMP_WEISS,""IINFO" /accept [Ganja/Kokain/Opium/Spice/Sex/Ice/Frisk/Ticket/Interview/Schein/Elektriker/Race/Freebl/Alkoholtest/Befreiung/Dice/Segen]");
	return SCM(playerid,SAMP_WEISS,"[Fahrstunde/SAPD/Medic/Feuer/Abschleppen/Taxi/Bestatten/Mechaniker/Rubbish/Waffe/Repair/Refill/Immobilie/Vertrag/Orginvite/Sinlist/Nacho]");
}
COMMAND:kaution(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],pID;
 	if(!isPlayerInJob(playerid,16))return SCM(playerid,SAMP_WEISS,"Kein Anwalt.");
 	if(pAnwaltallow[playerid] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keine Erlaubnis um in das Recht zu schreiten.");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /kaution [playerid/Name]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst aus dem Gefängnis entlassen.");
    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(Spieler[pID][pJailed] == 0)return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht im Gefängnis.");
	if(Spieler[pID][pKaution] == 2)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler hat kein Recht auf eine Kaution.");
	if((GetACMoney(playerid) - (Spieler[pID][pJailTime]*GetPlayerLevel(pID))) < 0)
	{
		format(string,sizeof(string),"Um den Spieler freizukaufen musst du %i$ vorrauszahlen.(Berechnung: Knastzeit*Level)",Spieler[pID][pJailTime]*GetPlayerLevel(pID));
		return SCM(playerid,SAMP_WEISS,string);
	}
	switch(Spieler[pID][pJailed])
	{
		case 1:
		{
			SetPlayerPosEx(pID,1758.0619,-1645.6868,13.4559);
			SetPlayerInterior(pID,0);
			SetPlayerVirtualWorld(pID,0);
		}
		case 2:
		{
			SetPlayerPosEx(pID,-2160.9009,1352.4110,7.8327);
			SetPlayerInterior(pID,0);
			SetPlayerVirtualWorld(pID,0);
		}
		case 3:
		{
			SetPlayerPosEx(pID,1050.6272,1183.8065,10.8203);
			SetPlayerInterior(pID,0);
			SetPlayerVirtualWorld(pID,0);
		}
	}
	ACMoney(playerid,-(Spieler[pID][pJailTime]*GetPlayerLevel(pID)));
	fverwaltungen[16][Geld] += (Spieler[pID][pJailTime]*GetPlayerLevel(pID));
	Spieler[pID][pJailed] = 0;
	Spieler[pID][pKaution] = 0;
	Spieler[pID][pJailTime] = 0;
	pAnwaltallow[playerid] = 0;
	format(string,sizeof(string),""IINFO" du hast %s (ID:%i) mit Kaution für %i$ auf freiem Fuß gesetzt.",SpielerName(pID),pID,Spieler[pID][pJailTime]*GetPlayerLevel(pID));
	SCM(playerid,0x85E500FF,string);
	SCM(playerid,0x85E500FF,"Er ist nun verpflichtet dir das Geld zurück zu zahlen.");
	format(string,sizeof(string),""IINFO" der Anwalt %s (ID:%i) hat dich mit Kaution für %i$ auf freiem Fuß gesetzt.",SpielerName(playerid),playerid,Spieler[pID][pJailTime]*GetPlayerLevel(pID));
	SCM(pID,0x85E500FF,string);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
		   	if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,16))
		   	{
			   	format(string,sizeof(string),""IINFO" der Spieler %s (ID:%i) wurde vom Anwalt %s (ID:%i) mit Kaution für %i$ auf freiem Fuß gesetzt.",SpielerName(pID),pID,SpielerName(playerid),playerid,Spieler[pID][pJailTime]*GetPlayerLevel(pID));
			   	SCM(i,SAMP_WEISS,string);
		   	}
	   	}
	}
	return 1;
}

COMMAND:addjtime(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],pID,seks;
 	if(!isPlayerInFrakt(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Polizist.");
	if(sscanf(params,"ud",pID,seks))return SCM(playerid,SAMP_WEISS,""IINFO" /addjtime [playerid/Name] [Sekunden]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(Spieler[pID][pJailed] == 0)return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht im Gefängnis.");
	Spieler[pID][pJailTime] = Spieler[pID][pJailTime]+seks;
	format(string,sizeof(string),""IINFO" du hast die Knastzeit von %s (ID:%i) um weitere %d Sekunden erhöht.",SpielerName(pID),pID,seks);
	SCM(playerid,0x85E500FF,string);
	format(string,sizeof(string),""IINFO" der Polizist %s (ID:%i) hat deine Knastzeit um weitere %d Sekunden erhöht.",SpielerName(playerid),playerid,seks);
	SCM(pID,0x85E500FF,string);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
		   	if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,16))
		   	{
			   	format(string,sizeof(string),"Die Knastzeit von %s (ID:%i) wurde vom Beamten %s (ID:%i) um %d Sekunden erhöht.",SpielerName(pID),pID,SpielerName(playerid),playerid,seks);
			   	SCM(i,SAMP_WEISS,string);
		   	}
	   	}
	}
	return 1;
}

COMMAND:deljtime(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
  	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],pID,seks;
 	if(!isPlayerInFrakt(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Polizist.");
	if(sscanf(params,"ud",pID,seks))return SCM(playerid,SAMP_WEISS,""IINFO" /deljtime [playerid/Name] [Sekunden]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(Spieler[pID][pJailed] == 0)return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht im Gefängnis.");
    if(seks >= Spieler[pID][pJailTime])return SCM(playerid,SAMP_WEISS,"Die angegebene Sekundenzahl überschreitet die Restknastzeit der Zielperson.");
	Spieler[pID][pJailTime] = Spieler[pID][pJailTime]-seks;
	format(string,sizeof(string),""IINFO" du hast die Knastzeit von %s (ID:%i) um %d Sekunden verkürzt.",SpielerName(pID),pID,seks);
	SCM(playerid,0x85E500FF,string);
	format(string,sizeof(string),""IINFO" der Polizist %s (ID:%i) hat deine Knastzeit um %d Sekunden verkürzt.",SpielerName(playerid),playerid,seks);
	SCM(pID,0x85E500FF,string);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
		   	if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,16))
		   	{
			   	format(string,sizeof(string),"Die Knastzeit von %s (ID:%i) wurde vom Beamten %s (ID:%i) um %d Sekunden verkürzt.",SpielerName(pID),pID,SpielerName(playerid),playerid,seks);
			   	SCM(i,SAMP_WEISS,string);
		   	}
	   	}
	}
	return 1;
}

COMMAND:augenbinde(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	    if(Spieler[playerid][pAugenbinde] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast eine Augenbinde auf.");
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /augenbinde [playerid/Name]");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst keine Augenbinde aufsetzen.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht in deinem Fahrzeug.");
		if(Spieler[pID][pAugenbinde] == 1)return SCM(playerid,SAMP_WEISS,"Spieler hat bereits einen Augenbinde angelegt.");
	    //TextDrawShowForPlayer(pID,BlackScreendraw);
	    Spieler[pID][pAugenbinde] = 1;
	    format(string,sizeof(string),""IINFO" du hast %s eine Augenbinde angelegt.",SpielerName(pID));
	    SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"%s hat dir einen Augenbinde angelegt.",SpielerName(playerid));
	    SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s hat %s eine Augenbinde angelegt **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:delaugenbinde(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(((isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6)) && Spieler[playerid][pDuty] != 0) || isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Fahrzeug.");
	    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
		if(Spieler[playerid][pAugenbinde] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du hast eine Augenbinde auf.");
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /delaugenbinde [playerid/Name]");
	    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir selbst keine Augenbinde abnehmen.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht in deinem Fahrzeug.");
	    if(Spieler[pID][pAugenbinde] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist hat keine Augenbinde angelegt.");
	    TextDrawHideForPlayer(pID,BlackScreendraw);
	    Spieler[pID][pAugenbinde] = 0;
	    format(string,sizeof(string),""IINFO" du hast %s seine Augenbinde abgenommen.",SpielerName(pID));
	    SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"%s hat dir deine Augenbinde abgenommen.",SpielerName(playerid));
	    SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s hat %s die Augenbinde abgenommen **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:invitevb(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],fID;
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(Spieler[playerid][pLeader] == 0)return SCM(playerid,SAMP_WEISS,"Kein Leader.");
	    if(fverwaltungen[Spieler[playerid][pFraktion]][HaveVBInvite] == 1)return SCM(playerid,SAMP_WEISS,"Deine Fraktion ist bereits in einem Bündnischat vertreten.");
		if(sscanf(params,"i",fID))return SCM(playerid,SAMP_WEISS,""IINFO" /invitevb [FraktionsID]");
	    if(fID == 4 || fID == 5 || fID == 7 || fID == 9 || fID == 12 || fID == 13 || fID == 17 || fID == 18)
		{
			if(isPlayerInFrakt(playerid,fID))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst deine Fraktion nicht selbst zu einem Bündnischat einladen.");
		   	if(fverwaltungen[fID][HaveVBInvite] == 1)return SCM(playerid,SAMP_WEISS,"Die angegebene Fraktion ist bereits in einem Bündnischat vertreten.");
		   	format(string,sizeof(string),""IINFO" du hast an die Fraktion %s eine Bündnischat einladung gesendet.",FraktionsName(fID));
		    SCM(playerid,SAMP_WEISS,string);
		    format(string,sizeof(string),"Die Fraktion %s möchte deine Fraktion in den Verbündetenchat einladen.(/accept vbchat)",FraktionsName(Spieler[playerid][pFraktion]));
		    SendFraktionsMessage(fID,FMELDUNG,string);
			fverwaltungen[fID][VBAnfrage] = 1;
		    fverwaltungen[fID][VBprozess] = Spieler[playerid][pFraktion];
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,"Wähle eine Gang/Mafia aus.(/fraktionen)");
	}
   	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:uninvitevb(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(Spieler[playerid][pLeader] == 0)return SCM(playerid,SAMP_WEISS,"Kein Leader.");
		if(fverwaltungen[Spieler[playerid][pFraktion]][HaveVBInvite] == 0)return SCM(playerid,SAMP_WEISS,"Deine Fraktion ist in keinem Bündniss vertreten.");
	    format(string,sizeof(string),""IINFO" du hast den Bündnischat mit der Fraktion %s geschlossen.",FraktionsName(fverwaltungen[Spieler[playerid][pFraktion]][VBFraktion]));
	   	SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"Die Fraktion %s hat den Bündnischat zwischen euren beiden Fraktionen geschlossen.",FraktionsName(Spieler[playerid][pFraktion]));
	    SendFraktionsMessage(fverwaltungen[Spieler[playerid][pFraktion]][VBFraktion],FMELDUNG,string);
	    fverwaltungen[Spieler[playerid][pFraktion]][VBAnfrage] = 0;
	    fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][VBFraktion]][VBAnfrage] = 0;
	    fverwaltungen[Spieler[playerid][pFraktion]][HaveVBInvite] = 0;
	    fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][VBFraktion]][HaveVBInvite] = 0;
	    fverwaltungen[fverwaltungen[Spieler[playerid][pFraktion]][VBFraktion]][VBFraktion] = 0;
	    fverwaltungen[Spieler[playerid][pFraktion]][VBFraktion] = 0;
	    return 1;
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:vb(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new text[91],string[128];
	if(Spieler[playerid][pFraktion] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Fraktion.");
	if(fverwaltungen[Spieler[playerid][pFraktion]][HaveVBInvite] == 0)
    {return SCM(playerid,SAMP_WEISS,"Deine Fraktion ist in keinem Bündniss vertreten.");}
    if(Spieler[playerid][pMuted] == 1)
	{
	 	format(string,sizeof(string),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
		return SCM(playerid,WEISS,string);
	}
	if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /vb(Verbündetenchat) [Text]");
	if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /vb(Verbündetenchat) [Text darf maximal 90 Zeichen beinhalten]");
	for(new i=0;i<sizeof(BadWord);i++)
	{
		if(strfind(text,BadWord[i],true) != -1)
	  	{
		  	format(string,sizeof(string),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
		   	SendClientMessageToAll(SAMP_WEISS,string);
			format(string,sizeof(string),"Beleidigung: %s | %s | Art: /vb(verbündetenchat)",BadWord[i],text);
			SendAdminMessage(SAMP_WEISS,string);
		    Spieler[playerid][pMuteTime] += 15*60;
			Spieler[playerid][pMuted] = 1;
			return 1;
	    }
	}
	format(string,sizeof(string),"**( %s %s %s: %s )**",FraktionsName(Spieler[playerid][pFraktion]),SpielerFraktionsRangName(playerid),SpielerName(playerid),text);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(isPlayerInFrakt(i,fverwaltungen[Spieler[playerid][pFraktion]][VBFraktion]) || isPlayerInFrakt(i,Spieler[playerid][pFraktion]))
				{
					SCM(i,0xC7CD2EA4,string);
				}
				if(Spieler[i][IreadALL] == 1)
				{
					SCM(i,SAMP_WEISS,string);
				}
			}
		}
	}
	return 1;
}

COMMAND:fkasse(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
   	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
 	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,10) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,14) || isPlayerInFrakt(playerid,15) || isPlayerInFrakt(playerid,16) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		format(string,sizeof(string),"[_______Fraktionsbank der %s_______]",FraktionsName(Spieler[playerid][pFraktion]));
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Geld: %i$		Opium: %i Pillen",fverwaltungen[Spieler[playerid][pFraktion]][Geld],fverwaltungen[Spieler[playerid][pFraktion]][Opium]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Ganja: %ig		Kokain: %ig  Spice: %ig",fverwaltungen[Spieler[playerid][pFraktion]][Ganja],fverwaltungen[Spieler[playerid][pFraktion]][Kokain],fverwaltungen[Spieler[playerid][pFraktion]][Spice]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"C4: %ikg		Materials: %i",fverwaltungen[Spieler[playerid][pFraktion]][C4],fverwaltungen[Spieler[playerid][pFraktion]][Materials]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Waffenpack Nummer: %i		Vorhandene Waffenslots: %i",fverwaltungen[Spieler[playerid][pFraktion]][WaffenPack],fverwaltungen[Spieler[playerid][pFraktion]][WaffenSlots]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Healpack Nummer: %i		Vorhandene Healslots: %i",fverwaltungen[Spieler[playerid][pFraktion]][Heal],fverwaltungen[Spieler[playerid][pFraktion]][HealSlots]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Armourpack Nummer: %i		Vorhandene Armourslots: %i",fverwaltungen[Spieler[playerid][pFraktion]][Armour],fverwaltungen[Spieler[playerid][pFraktion]][ArmourSlots]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:knockout(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
   	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],Float:x,Float:y,Float:z,pID;
   	GetPlayerPos(playerid,x,y,z);
 	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in einem Fahrzeug.");
	    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /knockout [playerid/Name]");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst ausknocken.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(!ProxDetectorS(3.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
		if(IsPlayerInAnyVehicle(pID))return SCM(playerid,SAMP_WEISS,"Spieler sitzt in einem Fahrzeug.");
	    if(Spieler[playerid][pTazerd] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist K.O.");
		if(Spieler[pID][pTazerd] == 1)return SCM(playerid,SAMP_WEISS,"Spieler bereits K.O.");
		if(Spieler[pID][pDeath] == 1)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits Tot.");
		TogglePlayerControllable(pID,false);
		Spieler[pID][pTazerd] = 1;
		//TextDrawShowForPlayer(pID,BlackScreendraw);
		ApplyAnimation(pID,"CRACK","crckdeth2",4.0,true,true,true,false,0,SYNC_ALL);
	    TazerTimer[pID] = SetTimerEx("UnTazer",10000,false,"i",pID);
		format(string,sizeof(string),"%s hat dich K.O geschlagen.",SpielerName(playerid));
		SCM(pID,SAMP_WEISS,string);
		GameTextForPlayer(pID,"~r~K.O",7500,3);
		format(string,sizeof(string),"** %s hat %s so geschlagen, dass er einen Knockout erleidet **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:reinzerren(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
	    new pID,seatid,string[128];
	    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	    if(sscanf(params,"ui",pID,seatid))return SCM(playerid,SAMP_WEISS,""IINFO" /reinzerren [playerid/Name][Sitzplatz]");
	    if(seatid<1||seatid>3)return SCM(playerid,SAMP_WEISS,"Sitzplätze bitte nur zwischen 1-3.");
	    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(Spieler[pID][pTazerd] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht K.O.");
	    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	    if(IsPlayerInAnyVehicle(pID))return SCM(playerid,SAMP_WEISS,"Spieler ist bereits in einem Fahrzeug!");
		TogglePlayerControllable(pID,false);
	    KillTimer(TazerTimer[pID]);
	    Spieler[pID][pTazerd] = 0;
	    Spieler[pID][pCuffed] = 1;
	    PutPlayerInVehicleEx(pID,GetPlayerVehicleID(playerid),seatid);
	    format(string,sizeof(string),"%s hat dich ins Fahrzeug gezogen,sodass du dich nicht bewegen kannst.",SpielerName(playerid));
	    SCM(pID,SAMP_WEISS,string);
	    format(string,sizeof(string),""IINFO" du hast %s ins Fahrzeug gezogen,sodass er sich nicht bewegen kann.",SpielerName(pID));
	    SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"** %s zieht %s ins Fahrzeug **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
    return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:fesseln(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
	    if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
	    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
		if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
		if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /fesseln [playerid/Name]");
	    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selber fesseln.");
	    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	    if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht in deinem Fahrzeug.");
	    if(Spieler[pID][pCuffed] == 1)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits gefesselt.");
		TogglePlayerControllable(pID,false);
		KillTimer(TazerTimer[pID]);
	    Spieler[pID][pCuffed] = 1;
	    GameTextForPlayer(pID,"~r~Gefesselt",3000,3);
	    format(string,sizeof(string),""IINFO" du hast %s gefesselt.",SpielerName(pID));
	    SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"%s hat dich gefesselt.",SpielerName(playerid));
	    SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s fesselt %s im Fahrzeug **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:entfesseln(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17) || isPlayerInFrakt(playerid,18))
	{
		if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /entfesseln [playerid/Name]");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selber entfesseln.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht in deinem Fahrzeug.");
	    if(Spieler[pID][pCuffed] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht gefesselt.");
	    new seatid = GetPlayerVehicleSeat(pID);
		ClearAnimations(pID);
	    TogglePlayerControllable(pID,true);
	    KillTimer(TazerTimer[pID]);
	    PutPlayerInVehicleEx(pID,GetPlayerVehicleID(playerid),seatid);
	    Spieler[pID][pCuffed] = 0;
	    GameTextForPlayer(pID,"~g~Entfesselt",3000,3);
	    format(string,sizeof(string),""IINFO" du hast %s entfesselt.",SpielerName(pID));
	    SCM(playerid,SAMP_WEISS,string);
	    format(string,sizeof(string),"%s hat dich entfesselt.",SpielerName(playerid));
	    SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),"** %s entfesselt %s im Fahrzeug **",SpielerName(playerid),SpielerName(pID));
		PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:setsinlist(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],reason[31];
    if(isPlayerInFrakt(playerid,18))
	{
		if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /setsinlist [playerid/Name][Grund]");
	    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /setsinlist [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst auf die Blacklist setzen.");
		if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
	    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
		if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
		if(Spieler[pID][pBL][Spieler[playerid][pFraktion]] == 1)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits auf der Sinlist deiner Fraktion!");
		if(isPlayerInFrakt(playerid,Spieler[pID][pFraktion]))return SCM(playerid,SAMP_WEISS,""IINFO" du kannst keine Leute aus deiner eigenen Fraktion auf die Sinlist setzen.");
		format(string,sizeof(string),""IINFO" du wurdest von %s auf die Sinlist der %s gesetzt. Grund: %s",SpielerName(playerid),FraktionsName(Spieler[playerid][pFraktion]),reason);
		SCM(pID,FMELDUNG,string);
		format(string,sizeof(string),"%s hat %s auf die Sinlist gesetzt. Grund: %s",SpielerName(playerid),SpielerName(pID),reason);
	 	SendFraktionsMessage(Spieler[playerid][pFraktion],FMELDUNG,string);
	    Spieler[pID][pBL][Spieler[playerid][pFraktion]] = 1;
	    strmid(pBLReason[pID][Spieler[playerid][pFraktion]],reason,0,strlen(reason),32);
	    return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}


COMMAND:setbl(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],reason[31];
    if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		if(!isPlayerAMember(playerid,3))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang.");
		if(sscanf(params,"us[31]",pID,reason))return SCM(playerid,SAMP_WEISS,""IINFO" /setbl [playerid/Name][Grund]");
	    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""IINFO" /setbl [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
		if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst auf die Blacklist setzen.");
