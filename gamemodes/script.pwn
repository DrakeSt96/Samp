COMMAND:weatherinfo(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],fv = IsAFraktionsVeh(playerid);
    if(!isPlayerInFrakt(playerid,10))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
    if(fv == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
	if(Fahrzeug[fv][Fraktion] != Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fraktionsfahrzeug.");
 	SCM(playerid,ORANGE,"[_Wetter in San Andreas_]");
	format(string,sizeof(string),"Los Santos: %s",WeatherName(UseBadWeather[0]));
	SCM(playerid,ORANGE,string);
	format(string,sizeof(string),"San Fierro: %s",WeatherName(UseBadWeather[1]));
	SCM(playerid,ORANGE,string);
	format(string,sizeof(string),"Las Venturas: %s",WeatherName(UseBadWeather[2]));
	SCM(playerid,ORANGE,string);
	return 1;
}
COMMAND:showfirmen(playerid,const params[])
{
	#pragma unused params
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[612],count,ftyp[32],fgtyp[16],status[16];
	if(!isPlayerInFrakt(playerid,16)) return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(!isPlayerAMember(playerid,5)) return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
    for(new f=1;f<MAX_FIRMEN;f++)
	{
		if(Firma[f][FirmaCreatet] != 0)
		{
		    if(Firma[f][FirmaStatus] == 1)
		    {
		        switch(Firma[f][FirmaPGesperrt]){
		            case 0:{status="Gesperrt";}
		            case 1:{status="Offen";}
		            default:{status="ERROR";}
				}
				switch(Firma[f][FirmaAGesperrt]){
				    case 1:{status="Gesperrt[A]";}
				}
		        switch(Firma[f][FirmaGTyp]){
		            case 0:{fgtyp="e.V.";}
		            case 1:{fgtyp="AG";}
		            case 2:{fgtyp="GmbH";}
		            case 3:{fgtyp="gGmbH";}
		            default:{fgtyp="ERROR";}
				}
				switch(Firma[f][FirmaTyp]){
		            case 0:{ftyp="Spedition";}
		            case 1:{ftyp="Personentransport";}
		            case 2:{ftyp="Sicherheitsfirma";}
		            case 3:{ftyp="Telefongesellschaft";}
		            case 4:{ftyp="Fahrzeughandel";}
		            case 5:{ftyp="Fahrzeugservice";}
		            case 6:{ftyp="Gebrauchtwagenhandel";}
		            case 7:{ftyp="Baugewerbe";}
		            case 8:{ftyp="Lotterie";}
		            case 9:{ftyp="Gastronomie";}
		            case 10:{ftyp="Rechtsberatung";}
		            case 11:{ftyp="Müllentsorgung";}
		            default:{ftyp="ERROR";}
				}
				format(string,sizeof(string),"[Firmen ID: %i], Name: %s, Typ: %s, Firmentyp: %s, Gründer: %s\n%s",f,Firma[f][FirmaName],fgtyp,ftyp,Firma[f][FirmaOwner],string);
		    	ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Firmenanträge",string,"Verlassen","");
				count++;
			}
		}
	}
	if(count == 0)return SCM(playerid,SAMP_WEISS,"Es wurden bisher keine Firmen gegründet.");
	return 1;
}
