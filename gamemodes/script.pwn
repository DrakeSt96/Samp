		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"matspackete",result);
		Spieler[playerid][pBankSafeMatspackete] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"bier",result);
		Spieler[playerid][pBankSafeAlc] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"zigaretten",result);
		Spieler[playerid][pBankSafeZigarets] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"werkzeugkaesten",result);
		Spieler[playerid][pBankSafeRepairVehBoxes] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"benzinkanister",result);
		Spieler[playerid][pBankSafeTankFillBoxes] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"koeder",result);
		Spieler[playerid][pBankSafeAngelkoeder] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"kondome",result);
		Spieler[playerid][pBankSafeCondoms] = strval(result);
		strdel(result,0,sizeof(result));
		cache_get_field_content(0,"duenger",result);
		Spieler[playerid][pBankSafeDuenger] = strval(result);
		strdel(result,0,sizeof(result));
	}
	else
	{
		format(query,sizeof(query),"INSERT INTO spieler_bsafe (Name) VALUES ('%s')",SpielerName(playerid));
		mysql_function_query(MySQL_R394,query,false,"","");
	}
	return 1;
}
public sql_array(const index[],const index2[],sqlresultid,extraid,extraid2,SconnectionHandle)
{
    new query[1000],rows,fields;
	if(SconnectionHandle != MySQL_R394 || mysql_errno(MySQL_R394) != 0)
	{
		getdate(tag,monat,jahr);
		gettime(stunde,minute,sekunde);
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && GetPVarInt(i,"Eingeloggt") == 1)
			{
				SaveAccount(i);
			}
		}
	    Log("Restartssqllog","Admin: System hat den Server gerestartet(Dead MySql Connection)!");
	    OnGameModeSave();
	    GameModeExit();
		return 1;
	}
	switch(sqlresultid)
	{
	case e_script_handynr:
	{
	    cache_get_data(rows,fields);
		if(rows)
		{
			new pNummer = random(1000000) + random(455420);
			format(query,sizeof(query),"SELECT * FROM spieler WHERE HandyNummer='%d'",pNummer);
			mysql_function_query(MySQL_R394,query,true,"sql_array","ssiiii",query,"",e_script_handynr,extraid,pNummer,MySQL_R394);
			return 1;
		}
		Spieler[extraid][pPhonenumber] = extraid2;
		SaveAccount(extraid);
	    return 1;
	}
	case d_script_passwort:
	{
	    cache_get_data(rows,fields);
	    if(!rows)
	    {
		    SCM(extraid,SAMP_WEISS,"Angegebener Spieler ist nicht registriert.");
			return 1;
	    }
	    format(query,sizeof(query),""IINFO" du hast des Passwort von %s zu %s umbenannt!",index,index2);
	    SCM(extraid,SAMP_WEISS,query);
	    mysql_format(MySQL_R394,query,sizeof(query),"UPDATE spieler SET Passwort='%s' WHERE Name='%e'",ScriptPW_CreateStr(index2),index);
	    mysql_function_query(MySQL_R394,query,false,"","");
	    // F-04: den im Speicher gehaltenen Hash des Betroffenen mitziehen,
	    // sonst oeffnet das alte Passwort bis zum Relog weiter den Admindienst.
	    ForEachPlayer(pwpl)
	    {
	        if(IsPlayerConnected(pwpl) && !IsPlayerNPC(pwpl) && strcmp(SpielerName(pwpl),index,true) == 0)
	        {
	            SetAccountPasswortHash(pwpl,index2);
	            SetPVarInt(pwpl,"apwfails",0);
	            SetPVarInt(pwpl,"admind",0);
	        }
	    }
	    return 1;
	}
	case d_script_name:
	{
	    cache_get_data(rows,fields);
		if(rows)
		{
			SCM(extraid,SAMP_WEISS,"Name wir schon verwendet.");
			return 1;
		}
		for(new haus=1;haus<MAX_HAUS;haus++)
		{
			if(HausInfo[haus][hauscreatet] == 1)
			{
				if(strcmp(HausInfo[haus][haus_besitzer],Spieler[extraid2][pName],true) == 0)
				{
				    strmid(HausInfo[haus][haus_besitzer],index2,0,strlen(index2),24);
					UpdateHausLabel(haus,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
			    }
		    }
		}
	    for(new biz=1;biz<MAX_BIZ;biz++)
		{
			if(BizInfo[biz][bizcreatet] == 1)
			{
			    if(!strcmp(BizInfo[biz][biz_besitzer],Spieler[extraid2][pName],true))
				{
				    strmid(BizInfo[biz][biz_besitzer],index2,0,strlen(index2),24);
				    UpdateBizLabel(biz,2);//funktion 1 wenn das biz ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
				}
			    if(!strcmp(BizInfo[biz][biz_teilhaber],Spieler[extraid2][pName],true))
				{
				    strmid(BizInfo[biz][biz_teilhaber],index2,0,strlen(index2),24);
				    UpdateBizLabel(biz,2);//funktion 1 wenn das biz ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
				}
			}
	    }
	    for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
			if(!strcmp(Spieler[extraid2][pName],Pfahrzeug[slot][extraid2][Besitzer],true))
			{
				mysql_format(MySQL_R394,query,sizeof(query),"UPDATE spieler_fahrzeuge SET name='%e' WHERE name='%e' AND slot='%d'",index2,Pfahrzeug[slot][extraid2][Besitzer],slot);
			    mysql_function_query(MySQL_R394,query,false,"","");
			    format(Pfahrzeug[slot][extraid2][Besitzer],24,"%s",index2);
		    }
	   	}
	    mysql_format(MySQL_R394,query,sizeof(query),"UPDATE spieler SET Name='%e' WHERE Name='%e'",index2,Spieler[extraid2][pName]);
	    mysql_function_query(MySQL_R394,query,false,"","");
	    format(query,sizeof(query),""IINFO" du hast den Name von %s zu %s umbenannt!",Spieler[extraid2][pName],index2);
	    SCM(extraid,SAMP_WEISS,query);
	    format(query,sizeof(query),""ACINFO" der Admin %s (ID:%i) hat deinen Spielernamen in %s umgeändert. Dein Account wurde geupdatet!",Spieler[extraid][pName],extraid,index2);
		SCM(extraid2,SAMP_WEISS,query);
	    format(Spieler[extraid2][pName],24,"%s",index2);
	    SetPlayerName(extraid2,Spieler[extraid2][pName]);
	    SetPlayerScore(extraid2,GetPlayerLevel(extraid2));
	    return 1;
	}
	case db_script_uban:
	{
	    cache_get_data(rows,fields);
		if(!rows)
	 	{
			SCM(extraid,SAMP_WEISS,""IINFO" banfall existiert nicht in der Datenbank!");
			return 1;
	 	}
		mysql_format(MySQL_R394,query,sizeof(query),"DELETE FROM server_bans WHERE Name = '%e'",index);
	   	mysql_function_query(MySQL_R394,query,false,"","");
	   	mysql_format(MySQL_R394,query,sizeof(query),"DELETE FROM `server_hddbans` WHERE `name` = '%e'",index);
	   	mysql_function_query(MySQL_R394,query,false,"","");
	    format(query,sizeof(query),""ACINFO" der Admin "IINFO2"%s"HTML_WEISS" hat den Spieler "IINFO2"%s"#HTML_WEISS" entbannt. Grund: "IINFO2"%s",
		Spieler[extraid][pName],index,index2);
		SendAdminMessage(SAMP_WEISS,query);
		format(query,sizeof(query),"Admin: %s User: %s * Grund: %s",Spieler[extraid][pName],index,index2);
		Log("script_banlöschung.txt",query);
	    return 1;
	}
	case a_script_hmieterkick:
	{
	    cache_get_data(rows,fields);
	    if(rows)
	    {
			format(query,sizeof(query),"UPDATE spieler SET Spawn='0',HausMieter='0' WHERE Name='%s'",index2);
		    mysql_function_query(MySQL_R394,query,false,"","");
		    HausInfo[extraid][haus_eingemitetenzaehler]--;
		    format(query,sizeof(query),""IINFO" du hast %s aus deinem Haus geworfen! Mieterslots %i/%i",index2,HausInfo[extraid][haus_eingemitetenzaehler],HausInfo[extraid][haus_slots]);
		    SCM(extraid2,SAMP_WEISS,query);
		    UpdateHausLabel(extraid,2);//funktion 1 wenn das haus ohne besitzer ist,funktion 2 wenn das biz mit besitzer ist
			return 1;
		}
		SCM(extraid2,SAMP_WEISS,"Spieler ist nicht bei dir eingemietet.");
		return 1;
	}
	}
	return 1;
}
public sql_array2(const index[],sqlresultid,extraid,SconnectionHandle)
{
	new query[4000],result[650],rows,fields;
	if(SconnectionHandle != MySQL_R394 || mysql_errno(MySQL_R394) != 0)
	{
		getdate(tag,monat,jahr);
		gettime(stunde,minute,sekunde);
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && GetPVarInt(i,"Eingeloggt") == 1)
			{
				SaveAccount(i);
			}
		}
	    Log("Restartssqllog","Admin: System hat den Server gerestartet(Dead MySql Connection)!");
	    OnGameModeSave();
	    GameModeExit();
		return 1;
	}
	cache_get_data(rows,fields);
	switch(sqlresultid)
	{
	case s_script_gangzone:
	{
	    cache_get_data(rows,fields);
		if(!rows)
		{
			format(query,sizeof(query),"INSERT INTO server_gangwars (GangZoneID,GangWarZoneOwner) VALUES ('%d','0')",extraid);
		    mysql_function_query(MySQL_R394,query,false,"","");
		}
	    return 1;
	}
	case l_script_gangzone:
	{
	    cache_get_data(rows,fields);
		new gw;
		if(rows)
		{
		    while(gw<rows)
			{
				cache_get_field_content(gw,"GangWarZoneOwner",result);
				GangwarZones[gw][War_Owner] = strval(result);
				strdel(result,0,sizeof(result));
				cache_get_field_content(gw,"GangWarZoneAttacker",result);
				GangwarZones[gw][War_Attacker] = strval(result);
				strdel(result,0,sizeof(result));
				cache_get_field_content(gw,"War_OwnerPoints",result);
				GangwarZones[gw][War_OwnerPoints] = strval(result);
				strdel(result,0,sizeof(result));
				cache_get_field_content(gw,"War_AttackerPoints",result);
				GangwarZones[gw][War_AttackerPoints] = strval(result);
				strdel(result,0,sizeof(result));
				cache_get_field_content(gw,"War_Started",result);
				GangwarZones[gw][War_Started] = strval(result);
				strdel(result,0,sizeof(result));
				cache_get_field_content(gw,"War_Time",result);
				GangwarZones[gw][War_Time] = strval(result);
				strdel(result,0,sizeof(result));

				GangwarZones[gw][WARdraw][0] = TextDrawCreate(8,260,"_");//stand 1
			    TextDrawFont(GangwarZones[gw][WARdraw][0],TEXT_DRAW_FONT_1);
			    TextDrawAlignment(GangwarZones[gw][WARdraw][0],TEXT_DRAW_ALIGN:0);
				TextDrawLetterSize(GangwarZones[gw][WARdraw][0],0.450000,0.999990);
				TextDrawColour(GangwarZones[gw][WARdraw][0],0xFEFEFEFF);
				TextDrawSetProportional(GangwarZones[gw][WARdraw][0],true);
				TextDrawSetShadow(GangwarZones[gw][WARdraw][0],2);

				GangwarZones[gw][WARdraw][1] = TextDrawCreate(8,270,"_");//stand 2
			    TextDrawFont(GangwarZones[gw][WARdraw][1],TEXT_DRAW_FONT_1);
			    TextDrawAlignment(GangwarZones[gw][WARdraw][1],TEXT_DRAW_ALIGN:0);
				TextDrawLetterSize(GangwarZones[gw][WARdraw][1],0.450000,0.999990);
				TextDrawColour(GangwarZones[gw][WARdraw][1],0xFEFEFEFF);
				TextDrawSetProportional(GangwarZones[gw][WARdraw][1],true);
				TextDrawSetShadow(GangwarZones[gw][WARdraw][1],2);

				GangwarZones[gw][WARdraw][2] = TextDrawCreate(8,250,"_");//zeit
			    TextDrawFont(GangwarZones[gw][WARdraw][2],TEXT_DRAW_FONT_1);
			    TextDrawAlignment(GangwarZones[gw][WARdraw][2],TEXT_DRAW_ALIGN:0);
				TextDrawLetterSize(GangwarZones[gw][WARdraw][2],0.450000,0.999990);
				TextDrawColour(GangwarZones[gw][WARdraw][2],0xFEFEFEFF);
				TextDrawSetProportional(GangwarZones[gw][WARdraw][2],true);
				TextDrawSetShadow(GangwarZones[gw][WARdraw][2],2);

				GangwarZones[gw][WARdraw][3] = TextDrawCreate(8,280,"FLAGGE");//Flagge 1
			    TextDrawFont(GangwarZones[gw][WARdraw][3],TEXT_DRAW_FONT_1);
			    TextDrawAlignment(GangwarZones[gw][WARdraw][3],TEXT_DRAW_ALIGN:0);
				TextDrawLetterSize(GangwarZones[gw][WARdraw][3],0.350000,0.499990);
				TextDrawColour(GangwarZones[gw][WARdraw][3],0xFEFEFEFF);
				TextDrawSetProportional(GangwarZones[gw][WARdraw][3],true);
				TextDrawSetShadow(GangwarZones[gw][WARdraw][3],1);

				GangwarZones[gw][WARdraw][4] = TextDrawCreate(8,270,"..............");//Flagge 1
		        TextDrawAlignment(GangwarZones[gw][WARdraw][4],TEXT_DRAW_ALIGN_LEFT);
		        TextDrawBackgroundColour(GangwarZones[gw][WARdraw][4],ROT);
		        TextDrawFont(GangwarZones[gw][WARdraw][4],TEXT_DRAW_FONT_3);
		        TextDrawLetterSize(GangwarZones[gw][WARdraw][4],0.369999,2.549999);
		        TextDrawColour(GangwarZones[gw][WARdraw][4],ROT);
		        TextDrawSetOutline(GangwarZones[gw][WARdraw][4],1);
		        TextDrawSetProportional(GangwarZones[gw][WARdraw][4],true);
		        TextDrawSetShadow(GangwarZones[gw][WARdraw][4],1);

		        GangwarZones[gw][WARdraw][5] = TextDrawCreate(108,280,"FLAGGE");//Flagge 2
			    TextDrawFont(GangwarZones[gw][WARdraw][5],TEXT_DRAW_FONT_1);
			    TextDrawAlignment(GangwarZones[gw][WARdraw][5],TEXT_DRAW_ALIGN:0);
				TextDrawLetterSize(GangwarZones[gw][WARdraw][5],0.350000,0.499990);
				TextDrawColour(GangwarZones[gw][WARdraw][5],0xFEFEFEFF);
				TextDrawSetProportional(GangwarZones[gw][WARdraw][5],true);
				TextDrawSetShadow(GangwarZones[gw][WARdraw][5],1);

				GangwarZones[gw][WARdraw][6] = TextDrawCreate(108,270,"..............");//Flagge 2
		        TextDrawAlignment(GangwarZones[gw][WARdraw][6],TEXT_DRAW_ALIGN_LEFT);
		        TextDrawBackgroundColour(GangwarZones[gw][WARdraw][6],ROT);
		        TextDrawFont(GangwarZones[gw][WARdraw][6],TEXT_DRAW_FONT_3);
		        TextDrawLetterSize(GangwarZones[gw][WARdraw][6],0.369999,2.549999);
		        TextDrawColour(GangwarZones[gw][WARdraw][6],ROT);
		        TextDrawSetOutline(GangwarZones[gw][WARdraw][6],1);
		        TextDrawSetProportional(GangwarZones[gw][WARdraw][6],true);
		        TextDrawSetShadow(GangwarZones[gw][WARdraw][6],1);

		        GangwarZones[gw][WARdraw][7] = TextDrawCreate(208,280,"FLAGGE");//Flagge 3
			    TextDrawFont(GangwarZones[gw][WARdraw][7],TEXT_DRAW_FONT_1);
			    TextDrawAlignment(GangwarZones[gw][WARdraw][7],TEXT_DRAW_ALIGN:0);
				TextDrawLetterSize(GangwarZones[gw][WARdraw][7],0.350000,0.499990);
				TextDrawColour(GangwarZones[gw][WARdraw][7],0xFEFEFEFF);
				TextDrawSetProportional(GangwarZones[gw][WARdraw][7],true);
				TextDrawSetShadow(GangwarZones[gw][WARdraw][7],1);

				GangwarZones[gw][WARdraw][8] = TextDrawCreate(208,270,"..............");//Flagge 3
		        TextDrawAlignment(GangwarZones[gw][WARdraw][8],TEXT_DRAW_ALIGN_LEFT);
		        TextDrawBackgroundColour(GangwarZones[gw][WARdraw][8],ROT);
		        TextDrawFont(GangwarZones[gw][WARdraw][8],TEXT_DRAW_FONT_3);
		        TextDrawLetterSize(GangwarZones[gw][WARdraw][8],0.369999,2.549999);
		        TextDrawColour(GangwarZones[gw][WARdraw][8],ROT);
		        TextDrawSetOutline(GangwarZones[gw][WARdraw][8],1);
		        TextDrawSetProportional(GangwarZones[gw][WARdraw][8],true);
		        TextDrawSetShadow(GangwarZones[gw][WARdraw][8],1);

				GangwarZones[gw][War_ZoneID] = GangZoneCreate(GangwarZones[gw][War_Zone_MinX],GangwarZones[gw][War_Zone_MinY],GangwarZones[gw][War_Zone_MaxX],GangwarZones[gw][War_Zone_MaxY]);
			 	GangwarZones[gw][War_Flagpickup][0] = CreateDynamicPickup(2993,1,GangwarZones[gw][War_FlagX1],GangwarZones[gw][War_FlagY1],GangwarZones[gw][War_FlagZ1],-1);
			    GangwarZones[gw][War_Flagpickup][1] = CreateDynamicPickup(2993,1,GangwarZones[gw][War_FlagX2],GangwarZones[gw][War_FlagY2],GangwarZones[gw][War_FlagZ2],-1);
			    GangwarZones[gw][War_Flagpickup][2] = CreateDynamicPickup(2993,1,GangwarZones[gw][War_FlagX3],GangwarZones[gw][War_FlagY3],GangwarZones[gw][War_FlagZ3],-1);

				if(GangwarZones[gw][War_Started] == 0)
				{
				    GWisStarted4Fraktion[GangwarZones[gw][War_Owner]] = 0;
					GangwarZones[gw][War_CaptureFlags_Owner] = 0;
				    GangwarZones[gw][War_CaptureFlags_Attacker] = 0;
					GangwarZones[gw][War_CaptureHero][0] = -1;
					GangwarZones[gw][War_CaptureHero][1] = -1;
					GangwarZones[gw][War_CaptureHero][2] = -1;
					GangwarZones[gw][War_CapturedFlags][0] = 0;
					GangwarZones[gw][War_CapturedFlags][1] = 0;
					GangwarZones[gw][War_CapturedFlags][2] = 0;
					format(GlobalString,sizeof(GlobalString),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
				    WarLabel[gw][0] = CreateDynamic3DTextLabel(GlobalString,SAMP_WEISS,GangwarZones[gw][War_FlagX1],GangwarZones[gw][War_FlagY1],GangwarZones[gw][War_FlagZ1],25,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
				    format(GlobalString,sizeof(GlobalString),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
					WarLabel[gw][1] = CreateDynamic3DTextLabel(GlobalString,SAMP_WEISS,GangwarZones[gw][War_FlagX2],GangwarZones[gw][War_FlagY2],GangwarZones[gw][War_FlagZ2],25,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
				    format(GlobalString,sizeof(GlobalString),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
					WarLabel[gw][2] = CreateDynamic3DTextLabel(GlobalString,SAMP_WEISS,GangwarZones[gw][War_FlagX3],GangwarZones[gw][War_FlagY3],GangwarZones[gw][War_FlagZ3],25,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
				}
				else
				{
					GWisStarted4Fraktion[GangwarZones[gw][War_Owner]] = 1;
				    GWisStarted4Fraktion[GangwarZones[gw][War_Attacker]] = 1;
					format(GlobalString,sizeof(GlobalString),"%s %i/%i",FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_OwnerPoints],MAX_GWPOINT4WINNER);
					TextDrawSetString(GangwarZones[gw][WARdraw][0],GlobalString);
					format(GlobalString,sizeof(GlobalString),"%s %i/%i",FraktionsName(GangwarZones[gw][War_Attacker]),GangwarZones[gw][War_AttackerPoints],MAX_GWPOINT4WINNER);
					TextDrawSetString(GangwarZones[gw][WARdraw][1],GlobalString);
					format(GlobalString,sizeof(GlobalString),"%i Min",GangwarZones[gw][War_Time]);
					TextDrawSetString(GangwarZones[gw][WARdraw][2],GlobalString);
					GangwarZones[gw][War_CaptureFlags_Owner] = 2;
				    GangwarZones[gw][War_CaptureFlags_Attacker] = 1;
					format(GlobalString,sizeof(GlobalString),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Attacker]));
				    WarLabel[gw][0] = CreateDynamic3DTextLabel(GlobalString,0xCDFF00CC,GangwarZones[gw][War_FlagX1],GangwarZones[gw][War_FlagY1],GangwarZones[gw][War_FlagZ1],25,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1,0);
				    GangwarZones[gw][War_CapturedFlags][0] = GangwarZones[gw][War_Attacker];
				    format(GlobalString,sizeof(GlobalString),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]));
