COMMAND:listgwareas(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	SCM(playerid,SAMP_WEISS,"|________Gebieteinformation________|");
	for(new gw=1;gw<sizeof(GangwarZones);gw++)
	{
		if(GangwarZones[gw][War_Started] == 0)
		{
			format(string,sizeof(string),"Gebietsid: %i - Gebietsname: %s | Inhaber: %s,Gebietswert: %i$",gw,GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
			SCM(playerid,SAMP_WEISS,string);
		}
		else
		{
			format(string,sizeof(string),"Gebietsid: %i - Gebietsname: %s | Inhaber: %s %i/%i,Angreifer: %s %i/%i",gw,GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_OwnerPoints],MAX_GWPOINT4WINNER,FraktionsName(GangwarZones[gw][War_Attacker]),GangwarZones[gw][War_AttackerPoints],MAX_GWPOINT4WINNER);
			SCM(playerid,SAMP_WEISS,string);
		}
	}
	return 1;
}
COMMAND:setgwowner(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new gwzone,fID,string[128];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(sscanf(params,"ii",gwzone,fID))return SCM(playerid,SAMP_WEISS,""#IINFO" /setgwowner [Gebietsid][Fraktionsid]");
	if(gwzone<1||gwzone>(MAX_GWZONES)-1)
	{
		format(string,sizeof(string),""#IINFO" /setgwowner [Gebietsid 1-%i][Fraktionsid]",MAX_GWZONES-1);
		return SCM(playerid,SAMP_WEISS,string);
	}
	if(fID == 4 || fID == 5 || fID == 7 || fID == 9 || fID == 12 || fID == 13 || fID == 17)
	{
		if(GangwarZones[gwzone][War_Started] == 1)return SCM(playerid,SAMP_WEISS,"In dem angegebenen Gebiet herrscht ein Gangwar!");
	    format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat der Fraktion %s zum Inhaber des Gebiets %s ernannt.",Spieler[playerid][pName],playerid,FraktionsName(fID),GangwarZones[gwzone][War_Zone_Name]);
	    SendAdminMessage(GRUEN,string);
	    GangwarZones[gwzone][War_Owner] = fID;
		GangwarZones[gwzone][War_Attacker] = 0;
	    GangwarZones[gwzone][War_AttackerPoints] = 0;
	 	GangwarZones[gwzone][War_OwnerPoints] = 0;
	 	GangwarZones[gwzone][War_CaptureFlags_Owner] = 0;
		GangwarZones[gwzone][War_CaptureFlags_Attacker] = 0;
		GangwarZones[gwzone][War_CaptureHero][0] = -1;
		GangwarZones[gwzone][War_CaptureHero][1] = -1;
		GangwarZones[gwzone][War_CaptureHero][2] = -1;
		GangwarZones[gwzone][War_CapturedFlags][0] = 0;
		GangwarZones[gwzone][War_CapturedFlags][1] = 0;
		GangwarZones[gwzone][War_CapturedFlags][2] = 0;
		GangwarZones[gwzone][War_Started] = 0;
		GangwarZones[gwzone][War_Time] = 0;
		ForEachPlayer(i)
	    {
		    if(IsPlayerConnected(i))
		    {
			    if(isPlayerInFrakt(i,4) || isPlayerInFrakt(i,5) || isPlayerInFrakt(i,7) || isPlayerInFrakt(i,9) || isPlayerInFrakt(i,12) || isPlayerInFrakt(i,13) || isPlayerInFrakt(i,17))
				{
				    GangZoneHideForPlayer(i,GangwarZones[gwzone][War_ZoneID]);
				    GangZoneShowForPlayer(i,GangwarZones[gwzone][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gwzone][War_Owner]));
				    if(isPlayerInFrakt(i,fID))
				    {
					    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][0]);
					    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][1]);
					    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][2]);
					    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][3]);
					 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][4]);
					 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][5]);
					 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][6]);
					 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][7]);
					 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][8]);
					    format(string,sizeof(string),""IINFO" der Admin "IINFO2"%s"#HTML_WEISS" hat euch zum Inhaber des Gebiets: "IINFO2"%s"#HTML_WEISS" ernannt.",Spieler[playerid][pName],GangwarZones[gwzone][War_Zone_Name]);
					    SCM(i,SAMP_WEISS,string);
				    }
			    }
		    }
	    }
		format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Property]);
	    UpdateDynamic3DTextLabelText(WarLabel[gwzone][0],SAMP_WEISS,string);
		format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Property]);
	    UpdateDynamic3DTextLabelText(WarLabel[gwzone][1],SAMP_WEISS,string);
		format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Property]);
	    UpdateDynamic3DTextLabelText(WarLabel[gwzone][2],SAMP_WEISS,string);
	    return 1;
    }
	return SCM(playerid,SAMP_WEISS,"Wähle eine Gang/Mafia aus.(/fraktionen)");
}

COMMAND:stopgwinarea(playerid,const params[])
{
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new gwzone,string[128],reason[31];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(sscanf(params,"is[31]",gwzone,reason))return SCM(playerid,SAMP_WEISS,""#IINFO" /stopgwinarea [Gebietsid][Grund]");
    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""#IINFO" /stopgwinarea [Gebietsid][Grund darf maximal 30 Zeichen beinhalten]");
	if(gwzone<1||gwzone>(MAX_GWZONES)-1)
	{
		format(string,sizeof(string),""#IINFO" /stopgwinarea [Gebietsid 1-%i][Grund]",MAX_GWZONES-1);
		return SCM(playerid,SAMP_WEISS,string);
	}
	if(GangwarZones[gwzone][War_Started] == 0)return SCM(playerid,SAMP_WEISS,"In dem angegebenen Gebiet herrscht kein Gangwar!");
    ForEachPlayer(i)
    {
	    if(IsPlayerConnected(i))
	    {
		    if(isPlayerInFrakt(i,GangwarZones[gwzone][War_Owner]))
		    {
			    GangZoneStopFlashForPlayer(i,GangwarZones[gwzone][War_ZoneID]);
			    GangZoneHideForPlayer(i,GangwarZones[gwzone][War_ZoneID]);
			    GangZoneShowForPlayer(i,GangwarZones[gwzone][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gwzone][War_Owner]));
			    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][0]);
			    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][1]);
			    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][2]);
			    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][3]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][4]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][5]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][6]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][7]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][8]);
			    format(string,sizeof(string),""ACINFO" %s (ID:%i) hat das Gangwar zwischen %s und %s in dem Gebiet %s beendet. Grund: %s",Spieler[playerid][pName],playerid,FraktionsName(GangwarZones[gwzone][War_Owner]),FraktionsName(GangwarZones[gwzone][War_Attacker]),GangwarZones[gwzone][War_Zone_Name],reason);
			    SCM(i,SAMP_WEISS,string);
		    }
		    if(isPlayerInFrakt(i,GangwarZones[gwzone][War_Attacker]))
		    {
			    GangZoneStopFlashForPlayer(i,GangwarZones[gwzone][War_ZoneID]);
			    GangZoneHideForPlayer(i,GangwarZones[gwzone][War_ZoneID]);
			    GangZoneShowForPlayer(i,GangwarZones[gwzone][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gwzone][War_Owner]));
			    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][0]);
			    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][1]);
			    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][2]);
			    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][3]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][4]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][5]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][6]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][7]);
			 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][8]);
			    format(string,sizeof(string),""ACINFO" %s (ID:%i) hat das Gangwar zwischen %s und %s in dem Gebiet %s beendet. Grund: %s",Spieler[playerid][pName],playerid,FraktionsName(GangwarZones[gwzone][War_Owner]),FraktionsName(GangwarZones[gwzone][War_Attacker]),GangwarZones[gwzone][War_Zone_Name],reason);
			    SCM(i,SAMP_WEISS,string);
		    }
    	}
    }
    format(string,sizeof(string),""ACINFO" %s (ID:%i) hat das Gangwar zwischen %s und %s in dem Gebiet %s beendet. Grund: %s",Spieler[playerid][pName],playerid,FraktionsName(GangwarZones[gwzone][War_Owner]),FraktionsName(GangwarZones[gwzone][War_Attacker]),GangwarZones[gwzone][War_Zone_Name],reason);
    SendAdminMessage(GRUEN,string);
    GWisStarted4Fraktion[GangwarZones[gwzone][War_Owner]] = 0;
    GWisStarted4Fraktion[GangwarZones[gwzone][War_Attacker]] = 0;
	GangwarZones[gwzone][War_Attacker] = 0;
    GangwarZones[gwzone][War_AttackerPoints] = 0;
 	GangwarZones[gwzone][War_OwnerPoints] = 0;
	GangwarZones[gwzone][War_CaptureHero][0] = -1;
	GangwarZones[gwzone][War_CaptureHero][1] = -1;
	GangwarZones[gwzone][War_CaptureHero][2] = -1;
    GangwarZones[gwzone][War_Time] = 0;
    GangwarZones[gwzone][War_Started] = 0;
    GangwarZones[gwzone][War_CaptureFlags_Owner] = 0;
    GangwarZones[gwzone][War_CaptureFlags_Attacker] = 0;
	format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Property]);
    UpdateDynamic3DTextLabelText(WarLabel[gwzone][0],SAMP_WEISS,string);
	format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Property]);
    UpdateDynamic3DTextLabelText(WarLabel[gwzone][1],SAMP_WEISS,string);
	format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Property]);
    UpdateDynamic3DTextLabelText(WarLabel[gwzone][2],SAMP_WEISS,string);
	return 1;
}

COMMAND:gangwars(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new gangwarsstarted,string[128];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		SCM(playerid,SAMP_WEISS,"|________Gangwars________|");
		for(new gw;gw<sizeof(GangwarZones);gw++)
		{
			if(GangwarZones[gw][War_Started] == 1)
			{
				format(string,sizeof(string),"Gebietsname: %s | Inhaber: %s %i/%i,Angreifer: %s %i/%i",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_OwnerPoints],MAX_GWPOINT4WINNER,FraktionsName(GangwarZones[gw][War_Attacker]),GangwarZones[gw][War_AttackerPoints],MAX_GWPOINT4WINNER);
				SCM(playerid,SAMP_WEISS,string);
				gangwarsstarted++;
			}
		}
		if(gangwarsstarted == 0)return SCM(playerid,SAMP_WEISS,"Zurzeit finden keine Gangwars statt!");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:gebiete(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128];
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		SCM(playerid,SAMP_WEISS,"|________Gebieteinformation________|");
		for(new gw=1;gw<sizeof(GangwarZones);gw++)//wegen failgebiet  :D
		{
			format(string,sizeof(string),"Gebietsname: %s | Inhaber: %s,Gebietswert: %i$",GangwarZones[gw][War_Zone_Name],FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
			SCM(playerid,SAMP_WEISS,string);
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:fgebiete(playerid,const params[])
{
    #pragma unused params
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],mygebiete;
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		SCM(playerid,SAMP_WEISS,"|________Eroberte Gebiete________|");
		for(new gw;gw<sizeof(GangwarZones);gw++)
		{
			if(GangwarZones[gw][War_Owner] == Spieler[playerid][pFraktion])
			{
				format(string,sizeof(string),"Gebietsname: %s,Gebietswert: %i$",GangwarZones[gw][War_Zone_Name],GangwarZones[gw][War_Zone_Property]);
				SCM(playerid,SAMP_WEISS,string);
				mygebiete++;
			}
		}
		if(mygebiete == 0)return SCM(playerid,SAMP_WEISS,"Keine.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:gebietsinfo(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],gw = GWIsPlayerInWarArea(playerid);
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		if(gw == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keinem Gangwargebiet.");
		format(string,sizeof(string),"|________%s________|",GangwarZones[gw][War_Zone_Name]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Inhaber: %s,Gebietswert: %i$",FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_Zone_Property]);
		SCM(playerid,SAMP_WEISS,string);
		if(GangwarZones[gw][War_Started] == 1)
		{
			format(string,sizeof(string),"Stand bei Minute %i:",GangwarZones[gw][War_Time]);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s: %i/%i",FraktionsName(GangwarZones[gw][War_Owner]),GangwarZones[gw][War_OwnerPoints],MAX_GWPOINT4WINNER);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"%s: %i/%i",FraktionsName(GangwarZones[gw][War_Attacker]),GangwarZones[gw][War_AttackerPoints],MAX_GWPOINT4WINNER);
			SCM(playerid,SAMP_WEISS,string);
		}
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:gangwar(playerid,const params[])
{
	#pragma unused params
	new string[128],gwzone = GWIsPlayerInWarArea(playerid),gangs = 0,Float:Pos[3];
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
 	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(isPlayerInFrakt(playerid,4) || isPlayerInFrakt(playerid,5) || isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		new day=GetDayName();
		gettime(stunde,minute,sekunde);
		if(day == 1 || day == 2 || day == 4 || day == 6)
		{
			if(stunde<19||stunde>21)return SCM(playerid,SAMP_WEISS,"Man kann ein Gangwar erst zwischen 19 und 21 Uhr starten.");
			if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht den jeweiligen Rang.");
			if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in einem Fahrzeug!");
		    if(gwzone == -1)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier kein Gangwar starten.");
			if(GangwarZones[gwzone][War_Owner] == Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,"Dieses Gebiet gehört bereits deiner Fraktion!");
		    if(GangwarZones[gwzone][War_Attacker] == Spieler[playerid][pFraktion])return SCM(playerid,SAMP_WEISS,"Ihr greift das Gebiet bereits an!");
			if(GangwarZones[gwzone][War_Time] != 0 || GangwarZones[gwzone][War_Attacker] != 0 || GangwarZones[gwzone][War_Started] != 0)return SCM(playerid,SAMP_WEISS,"Dieses Gebiet wird bereits umkämpft!");
		    if(IsPlayerInRangeOfPoint(playerid,5.0,GangwarZones[gwzone][War_FlagX1],GangwarZones[gwzone][War_FlagY1],GangwarZones[gwzone][War_FlagZ1]) ||
			IsPlayerInRangeOfPoint(playerid,5.0,GangwarZones[gwzone][War_FlagX2],GangwarZones[gwzone][War_FlagY2],GangwarZones[gwzone][War_FlagZ2]) ||
			IsPlayerInRangeOfPoint(playerid,5.0,GangwarZones[gwzone][War_FlagX3],GangwarZones[gwzone][War_FlagY3],GangwarZones[gwzone][War_FlagZ3]))
			{
			if(GWisStarted4Fraktion[Spieler[playerid][pFraktion]] == 1)return SCM(playerid,SAMP_WEISS,"Deine Fraktion ist bereits in einem Gangwar verwickelt!");
			if(GWisStarted4Fraktion[GangwarZones[gwzone][War_Owner]] == 1)return SCM(playerid,SAMP_WEISS,"Gebietsinhaber ist bereits in einem Gangwar verwickelt!");
			if(GangwarZones[gwzone][War_Owner] == 0)
			{
				ForEachPlayer(i)
			    {
				    if(IsPlayerConnected(i))
				    {
					    if(isPlayerInFrakt(i,Spieler[playerid][pFraktion]))
					    {
						    GangZoneHideForPlayer(i,GangwarZones[gwzone][War_ZoneID]);
						    GangZoneShowForPlayer(i,GangwarZones[gwzone][War_ZoneID],GWZoneColorOfFraktion(Spieler[playerid][pFraktion]));
						    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][0]);
						    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][1]);
						    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][2]);
						    TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][3]);
						 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][4]);
						 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][5]);
						 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][6]);
						 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][7]);
						 	TextDrawHideForPlayer(i,GangwarZones[gwzone][WARdraw][8]);
						    GameTextForPlayer(i,"~g~GEBIET EINGENOMMEN",7500,5);
					    }
				    }
			    }
			    GangwarZones[gwzone][War_Owner] = Spieler[playerid][pFraktion];
				GangwarZones[gwzone][War_Attacker] = 0;
			    GangwarZones[gwzone][War_AttackerPoints] = 0;
			 	GangwarZones[gwzone][War_OwnerPoints] = 0;
			 	GangwarZones[gwzone][War_CaptureFlags_Owner] = 0;
				GangwarZones[gwzone][War_CaptureFlags_Attacker] = 0;
				GangwarZones[gwzone][War_CaptureHero][0] = -1;
				GangwarZones[gwzone][War_CaptureHero][1] = -1;
				GangwarZones[gwzone][War_CaptureHero][2] = -1;
				GangwarZones[gwzone][War_CapturedFlags][0] = 0;
				GangwarZones[gwzone][War_CapturedFlags][1] = 0;
				GangwarZones[gwzone][War_CapturedFlags][2] = 0;
				GangwarZones[gwzone][War_Started] = 0;
				format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Property]);
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][0],SAMP_WEISS,string);
				format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Property]);
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][1],SAMP_WEISS,string);
				format(string,sizeof(string),"[ "IINFO2"GangZone"#HTML_WEISS" ]\nOrt: "IINFO2"%s"#HTML_WEISS"\nGebiet der Fraktion:"IINFO2"%s"#HTML_WEISS"\nGebietswert: "IINFO2"%i$"#HTML_WEISS"\n/gangwar",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Property]);
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][2],SAMP_WEISS,string);
			    return 1;
			}
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
			    {
					if(isPlayerInFrakt(i,GangwarZones[gwzone][War_Owner]))
					{
						gangs++;
					}
				}
			}
			if(gangs < 4)return SCM(playerid,SAMP_WEISS,"Nicht genug Gangmitglieder Online.(mind. 4)");
			SetPlayerVirtualWorld(playerid,1);
			Spieler[playerid][pTutTime4All] = 0;
			GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
			TogglePlayerControllable(playerid,false);
			TextDrawShowForPlayer(playerid,Introdraw[0]);
		    TextDrawShowForPlayer(playerid,Introdraw[1]);
			InterpolateCameraPos(playerid,Pos[0],Pos[1],Pos[2],GangwarZones[gwzone][War_FlagX1],GangwarZones[gwzone][War_FlagY1],GangwarZones[gwzone][War_FlagZ1],2000,CAMERA_MOVE);
			InterpolateCameraLookAt(playerid,Pos[0],Pos[1],Pos[2],GangwarZones[gwzone][War_FlagX1],GangwarZones[gwzone][War_FlagY1],GangwarZones[gwzone][War_FlagZ1],2000,CAMERA_MOVE);
			Spieler[playerid][pTutTimer4All] = SetTimerEx("Tutorial4All",1000,true,"ii",playerid,1);
			TextDrawShowForPlayer(playerid,InfoSign);
		    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~g~Gangwar:~w~ Du hast ein Gangwar gestartet.");
			PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
			GangwarZones[gwzone][War_Attacker] = Spieler[playerid][pFraktion];
			GWisStarted4Fraktion[GangwarZones[gwzone][War_Owner]] = 1;
		    GWisStarted4Fraktion[GangwarZones[gwzone][War_Attacker]] = 1;
		    GangwarZones[gwzone][War_AttackerPoints] = 0;
		 	GangwarZones[gwzone][War_OwnerPoints] = 0;
			GangwarZones[gwzone][War_CaptureHero][0] = -1;
			GangwarZones[gwzone][War_CaptureHero][1] = -1;
			GangwarZones[gwzone][War_CaptureHero][2] = -1;
		    GangwarZones[gwzone][War_Time] = 60;
		    GangwarZones[gwzone][War_Started] = 1;
		    GangwarZones[gwzone][War_CaptureFlags_Owner] = 2;
		    GangwarZones[gwzone][War_CaptureFlags_Attacker] = 1;
		    format(string,sizeof(string),"%s %i/%i",FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_OwnerPoints],MAX_GWPOINT4WINNER);
		    TextDrawSetString(GangwarZones[gwzone][WARdraw][0],string);
		    format(string,sizeof(string),"%s %i/%i",FraktionsName(Spieler[playerid][pFraktion]),GangwarZones[gwzone][War_AttackerPoints],MAX_GWPOINT4WINNER);
		    TextDrawSetString(GangwarZones[gwzone][WARdraw][1],string);
		    format(string,sizeof(string),"%i Min",GangwarZones[gwzone][War_Time]);
			TextDrawSetString(GangwarZones[gwzone][WARdraw][2],string);
		    if(IsPlayerInRangeOfPoint(playerid,5.0,GangwarZones[gwzone][War_FlagX1],GangwarZones[gwzone][War_FlagY1],GangwarZones[gwzone][War_FlagZ1]))
			{
				format(string,sizeof(string),"%s",FraktionsName(Spieler[playerid][pFraktion]));//Flagge 1
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][3],string);
			    TextDrawBackgroundColour(GangwarZones[gwzone][WARdraw][4],GRUEN);
				TextDrawColour(GangwarZones[gwzone][WARdraw][4],GRUEN);
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][4],"..............");
			    format(string,sizeof(string),"%s",FraktionsName(GangwarZones[gwzone][War_Owner]));//Flagge 2
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][5],string);
			    TextDrawBackgroundColour(GangwarZones[gwzone][WARdraw][6],GRUEN);
				TextDrawColour(GangwarZones[gwzone][WARdraw][6],GRUEN);
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][6],"..............");
			    format(string,sizeof(string),"%s",FraktionsName(GangwarZones[gwzone][War_Owner]));//Flagge 3
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][7],string);
			    TextDrawBackgroundColour(GangwarZones[gwzone][WARdraw][8],GRUEN);
				TextDrawColour(GangwarZones[gwzone][WARdraw][8],GRUEN);
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][8],"..............");
				format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gwzone][War_Zone_Name],FraktionsName(Spieler[playerid][pFraktion]));
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][0],0xCDFF00CC,string);
			    GangwarZones[gwzone][War_CapturedFlags][0] = Spieler[playerid][pFraktion];
			    format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]));
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][1],0xCDFF00CC,string);
			    GangwarZones[gwzone][War_CapturedFlags][1] = GangwarZones[gwzone][War_Owner];
			    format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]));
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][2],0xCDFF00CC,string);
			    GangwarZones[gwzone][War_CapturedFlags][2] = GangwarZones[gwzone][War_Owner];
			}
			if(IsPlayerInRangeOfPoint(playerid,5.0,GangwarZones[gwzone][War_FlagX2],GangwarZones[gwzone][War_FlagY2],GangwarZones[gwzone][War_FlagZ2]))
			{
				format(string,sizeof(string),"%s",FraktionsName(GangwarZones[gwzone][War_Owner]));//Flagge 1
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][3],string);
			    TextDrawBackgroundColour(GangwarZones[gwzone][WARdraw][4],GRUEN);
				TextDrawColour(GangwarZones[gwzone][WARdraw][4],GRUEN);
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][4],"..............");
			    format(string,sizeof(string),"%s",FraktionsName(Spieler[playerid][pFraktion]));//Flagge 2
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][5],string);
			    TextDrawBackgroundColour(GangwarZones[gwzone][WARdraw][6],GRUEN);
				TextDrawColour(GangwarZones[gwzone][WARdraw][6],GRUEN);
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][6],"..............");
			    format(string,sizeof(string),"%s",FraktionsName(GangwarZones[gwzone][War_Owner]));//Flagge 3
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][7],string);
			    TextDrawBackgroundColour(GangwarZones[gwzone][WARdraw][8],GRUEN);
				TextDrawColour(GangwarZones[gwzone][WARdraw][8],GRUEN);
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][8],"..............");
				format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gwzone][War_Zone_Name],FraktionsName(Spieler[playerid][pFraktion]));
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][1],0xCDFF00CC,string);
			    GangwarZones[gwzone][War_CapturedFlags][1] = Spieler[playerid][pFraktion];
			    format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]));
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][2],0xCDFF00CC,string);
			    GangwarZones[gwzone][War_CapturedFlags][2] = GangwarZones[gwzone][War_Owner];
			    format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]));
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][0],0xCDFF00CC,string);
			    GangwarZones[gwzone][War_CapturedFlags][0] = GangwarZones[gwzone][War_Owner];
			}
			if(IsPlayerInRangeOfPoint(playerid,5.0,GangwarZones[gwzone][War_FlagX3],GangwarZones[gwzone][War_FlagY3],GangwarZones[gwzone][War_FlagZ3]))
			{
				format(string,sizeof(string),"%s",FraktionsName(GangwarZones[gwzone][War_Owner]));//Flagge 1
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][3],string);
			    TextDrawBackgroundColour(GangwarZones[gwzone][WARdraw][4],GRUEN);
				TextDrawColour(GangwarZones[gwzone][WARdraw][4],GRUEN);
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][4],"..............");
			    format(string,sizeof(string),"%s",FraktionsName(GangwarZones[gwzone][War_Owner]));//Flagge 2
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][5],string);
			    TextDrawBackgroundColour(GangwarZones[gwzone][WARdraw][6],GRUEN);
				TextDrawColour(GangwarZones[gwzone][WARdraw][6],GRUEN);
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][6],"..............");
			    format(string,sizeof(string),"%s",FraktionsName(Spieler[playerid][pFraktion]));//Flagge 3
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][7],string);
			    TextDrawBackgroundColour(GangwarZones[gwzone][WARdraw][8],GRUEN);
				TextDrawColour(GangwarZones[gwzone][WARdraw][8],GRUEN);
			    TextDrawSetString(GangwarZones[gwzone][WARdraw][8],"..............");
				format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gwzone][War_Zone_Name],FraktionsName(Spieler[playerid][pFraktion]));
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][2],0xCDFF00CC,string);
			    GangwarZones[gwzone][War_CapturedFlags][2] = Spieler[playerid][pFraktion];
			    format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]));
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][0],0xCDFF00CC,string);
			    GangwarZones[gwzone][War_CapturedFlags][0] = GangwarZones[gwzone][War_Owner];
			    format(string,sizeof(string),"%s\n\nFlagge der Fraktion '%s'",GangwarZones[gwzone][War_Zone_Name],FraktionsName(GangwarZones[gwzone][War_Owner]));
			    UpdateDynamic3DTextLabelText(WarLabel[gwzone][1],0xCDFF00CC,string);
			    GangwarZones[gwzone][War_CapturedFlags][1] = GangwarZones[gwzone][War_Owner];
			}
		    ForEachPlayer(i)
			{
			 	if(IsPlayerConnected(i))
				{
				   	if(Spieler[i][pFraktion] == GangwarZones[gwzone][War_Owner])
				 	{
					 	format(string,sizeof(string),"Gangwar: Die Fraktion %s greift euer Gebiet [%s] an!",FraktionsName(Spieler[playerid][pFraktion]),GangwarZones[gwzone][War_Zone_Name]);
						SCM(i,GWCHATCOLOR,string);
						SCM(i,GWCHATCOLOR,"- Solltet ihr einen Gegner im Gebiet töten so erhaltet ihr einen Punkt.");
						SCM(i,GWCHATCOLOR,"- Pro eingenomme Flagge kriegt ihr nach einer vergangenen Gangwar Minute einen Punkt.");
						SCM(i,GWCHATCOLOR,"- Im Gebiet das Spiel zu verlassen wird mit -3 Punkten für deine Fraktion bestraft.");
					    SCM(i,GWCHATCOLOR,"  Dazu kriegt der Gegner 3 Punkte plus.");
						GangZoneFlashForPlayer(i,GangwarZones[gwzone][War_ZoneID],GWZoneColorOfFraktion(Spieler[playerid][pFraktion]));
					    TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][0]);
					    TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][1]);
					    TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][2]);
					    TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][3]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][4]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][5]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][6]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][7]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][8]);
					    PlayerPlaySound(i,1057,0.0,0.0,0.0);
					}
				  	if(Spieler[i][pFraktion] == Spieler[playerid][pFraktion])
				  	{
					  	format(string,sizeof(string),"Gangwar: %s hat ein Gangwar mit der Fraktion %s gestartet! Im Gebiet %s",SpielerName(playerid),FraktionsName(GangwarZones[gwzone][War_Owner]),GangwarZones[gwzone][War_Zone_Name]);
						SCM(i,GWCHATCOLOR,string);
						SCM(i,GWCHATCOLOR,"- Solltet ihr einen Gegner im Gebiet töten so erhaltet ihr einen Punkt.");
						SCM(i,GWCHATCOLOR,"- Pro eingenomme Flagge kriegt ihr nach einer vergangenen Gangwar Minute einen Punkt.");
						SCM(i,GWCHATCOLOR,"- Im Gebiet das Spiel zu verlassen wird mit -3 Punkten für deine Fraktion bestraft.");
					    SCM(i,GWCHATCOLOR,"  Dazu kriegt der Gegner 3 Punkte plus.");
					  	GangZoneFlashForPlayer(i,GangwarZones[gwzone][War_ZoneID],GWZoneColorOfFraktion(GangwarZones[gwzone][War_Attacker]));
					    TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][0]);
					    TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][1]);
					    TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][2]);
					    TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][3]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][4]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][5]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][6]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][7]);
					 	TextDrawShowForPlayer(i,GangwarZones[gwzone][WARdraw][8]);
					    PlayerPlaySound(i,1057,0.0,0.0,0.0);
					}
			    }
		    }
		    return 1;
		    }
		    return SCM(playerid,SAMP_WEISS,""IINFO" du musst an einer Flagge sein!");
	    }
	    return SCM(playerid,SAMP_WEISS,"Man kann einen Gangwar nur Montag, Mittwoch, Freitag und Sonntag starten.");
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:aufzug(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in einem Fahrzeug!");
 	new Float:pos[3],string[950];
 	if(IsPlayerInRangeOfPoint(playerid,2,850.9716,-1054.2428,25.9759))
 	{
	 	SetPlayerPosEx(playerid,850.8454,-1054.0603,31.0745);
	 	return 1;
 	}
 	if(IsPlayerInRangeOfPoint(playerid,2,850.9716,-1054.2428,31.0744))
 	{
		SetPlayerPosEx(playerid,850.8454,-1054.0603,25.9759);
	 	return 1;
 	}
  	GetPlayerPos(playerid,pos[0],pos[1],pos[2]);
   	if(pos[1] < -1301.4 && pos[1] > -1303.2417 && pos[0] < 1786.2131 && pos[0] > 1784.1555)    // He is using the elevator button
	{
		for(new i;i<sizeof(ElevatorQueue);i++)
		{
		 	if(FloorRequestedBy[i] != INVALID_PLAYER_ID)
		    strcat(string,"{FF0000}");
		    strcat(string,FloorNames[i]);
		    strcat(string,"\n");
		}
		ShowPlayerDialog(playerid,DIALOG_LS_AUFZUG,DIALOG_STYLE_LIST,""ClanTagDialoge" Hotel Mantala",string,"Auswählen","Abbrechen");
	}
	else    // Is he in a floor button?
	{
	 	if(pos[1] > -1301.4 && pos[1] < -1299.1447 && pos[0] < 1785.6147 && pos[0] > 1781.9902)
	  	{	// He is most likely using it,check floor:
			new i=20;
			while(pos[2] < GROUND_Z_COORD + FloorZOffsets[i] + 3.5 && i > 0)
		 	i--;
			if(i == 0 && pos[2] < GROUND_Z_COORD + FloorZOffsets[0] + 2.0)
		 	i = -1;
			if(i <= 19)
			{
				CallElevator(playerid,i + 1);
				GameTextForPlayer(playerid,"~g~Aufzug gerufen",3000,4);
			}
	    }
	}
	return 1;
}

COMMAND:addxmasobj(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new xmasobject,Float:x,Float:y,Float:z,Float:a;
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
	if(XmasObjCount() == MAX_XMAS_OBJECTS)return SCM(playerid,SAMP_WEISS,"Es wurde bereits die maximale Anzahl an Straßensperren errichtet!");
	if(sscanf(params,"i",xmasobject))return SCM(playerid,SAMP_WEISS,""#IINFO" /addxmasobj [1-6]");
    if(xmasobject<1||xmasobject>6)return SCM(playerid,SAMP_WEISS,""#IINFO" /addxmasobj [1-6]");
    GetPlayerPos(playerid,x,y,z);
  	GetPlayerFacingAngle(playerid,a);
	switch(xmasobject)
	{
		case 1:{AddXmasObj(playerid,19076,x,y,z-1,a);}
		case 2:{AddXmasObj(playerid,19054,x,y,z-0.2,a);}
		case 3:{AddXmasObj(playerid,19055,x,y,z-0.2,a);}
		case 4:{AddXmasObj(playerid,19056,x,y,z-0.2,a);}
		case 5:{AddXmasObj(playerid,19057,x,y,z-0.2,a);}
		case 6:{AddXmasObj(playerid,19058,x,y,z-0.2,a);}
	}
	return 1;
}

COMMAND:delxmasobj(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,"Im Fahrzeug nicht möglich.");
	RemoveXmasObj(playerid);
	return 1;
}

COMMAND:delallxmasobj(playerid,const params[])
{
    #pragma unused params
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new string[128];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    RemoveAllXmasObj();
    format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat alle Xmas Objects entfernt.",Spieler[playerid][pName],playerid);
	SendAdminMessage(BLAU,string);
	return 1;
}

COMMAND:acheckgun(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new pID,string[64],index = 0;
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""#IINFO" /acheckgun [playerid/Name]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    new WEAPON:waffe,muni;
    format(string,sizeof(string),"[_____Waffen von %s_____]",SpielerName(pID));
    SCM(playerid,SAMP_WEISS,string);
	for(new i=0;i<13;i++)
	{
		GetPlayerWeaponData(pID,WEAPON_SLOT:i,waffe,muni);
		if(waffe != WEAPON_FIST)
		{
			format(string,sizeof(string)," %i: %s %i Munition",i,SpielerWaffenName(waffe),muni);
			SCM(playerid,SAMP_WEISS,string);
			index++;
		}
	}
	if(index == 0)return SCM(playerid,SAMP_WEISS,"Keine.");
	return 1;
}

COMMAND:checkfps(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new pID,string[64];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""#IINFO" /checkfps [playerid/Name]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    format(string,sizeof(string),"%s,%i Frames per Second",Spieler[pID][pName],Spieler[pID][pFPS]);
    SCM(playerid,SAMP_WEISS,string);
	return 1;
}

COMMAND:checknetworkstats(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	new pID,string[612],headerstring[64];
	if(!isPlayerAnAdmin(playerid,2))return ADMIN_MSG(playerid);
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""#IINFO" /checknetworkstats [playerid/Name]");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	GetPlayerNetworkStats(pID,string,sizeof(string));
	format(string,sizeof(string),""#HTML_BLAU"Netzwerk Statistik:{D9CCD9}\n%s\n\n"#HTML_BLAU""#SERVERNAME"{FFFFFF}",string);
    format(headerstring,sizeof(headerstring),""#HTML_BLAU"%s (%02d.%02d.%04d - %02d:%02d:%02d)",Spieler[pID][pName],tag,monat,jahr,stunde,minute,sekunde);
	ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,headerstring,string,"Verlassen","");
	return 1;
}

COMMAND:aimbottest(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
    if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
    new pID,Float:Pos[4],string[128];
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""#IINFO" /aimbottest [playerid/Name]");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst auf Aimbot testen!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
    if(IsPlayerInAnyVehicle(playerid) || IsPlayerInAnyVehicle(pID))return SCM(playerid,SAMP_WEISS,""IINFO" du und der Spieler dürfen nicht in einen Fahrzeug sitzen.");
    if(!ProxDetectorS(10.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(gettime() < Spieler[playerid][pAimbotTest])return SCM(playerid,SAMP_WEISS,""IINFO" du musst noch einen Moment warten bist du wieder einen Aimbottest machen kannst.");
	Spieler[playerid][pAimbotTest] = gettime() + 10;
	GetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
	GetPlayerFacingAngle(playerid,Pos[3]);
	SetTimerEx("AimbotTest",500,false,"iffff",playerid,Pos[0],Pos[1],Pos[2],Pos[3]);
	GetXYInFrontOfPlayer(pID,Pos[0],Pos[1],Pos[2],Pos[3],-2.5);
	SetPlayerPos(playerid,Pos[0],Pos[1],Pos[2]);
	SetPlayerFacingAngle(playerid,Pos[3]);
	SetCameraBehindPlayer(playerid);
	format(string,sizeof(string),""IINFO" du überprüftst %s (ID:%i) auf Aimbot.",SpielerName(pID),pID);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
