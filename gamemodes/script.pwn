COMMAND:sinlist(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[1000],onlinebl = 0;
    if(isPlayerInFrakt(playerid,18))
	{
		ForEachPlayer(i)
	    {
			if(IsPlayerConnected(i))
			{
				if(GetPVarInt(i,"Eingeloggt") == 1)
				{
					if(Spieler[i][pBL][Spieler[playerid][pFraktion]] == 1)
					{
						format(string,sizeof(string),"%s (ID:%i) | %s\n%s",SpielerName(i),i,pBLReason[i][Spieler[playerid][pFraktion]],string);
						ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"Sinlist",string,"Verlassen","");
						onlinebl ++;
					}
				}
			}
		}
		if(onlinebl == 0)return SCM(playerid,SAMP_WEISS,"Kein Spieler auf der Blacklist.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:blacklist(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[1000],onlinebl = 0;
    if(isPlayerInFrakt(playerid,4)|| isPlayerInFrakt(playerid,5)|| isPlayerInFrakt(playerid,7) || isPlayerInFrakt(playerid,9) || isPlayerInFrakt(playerid,12) || isPlayerInFrakt(playerid,13) || isPlayerInFrakt(playerid,17))
	{
		ForEachPlayer(i)
	    {
			if(IsPlayerConnected(i))
			{
				if(GetPVarInt(i,"Eingeloggt") == 1)
				{
					if(Spieler[i][pBL][Spieler[playerid][pFraktion]] == 1)
					{
						format(string,sizeof(string),"%s (ID:%i) | %s\n%s",SpielerName(i),i,pBLReason[i][Spieler[playerid][pFraktion]],string);
						ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,"Blacklist",string,"Verlassen","");
						onlinebl ++;
					}
				}
			}
		}
		if(onlinebl == 0)return SCM(playerid,SAMP_WEISS,"Kein Spieler auf der Blacklist.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:stadium(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(IsPlayerInRangeOfPoint(playerid,5.0,2695.7078,-1704.6866,11.8438) || IsPlayerInRangeOfPoint(playerid,5.0,-2109.6663,-444.1563,38.7344))
	{
		ShowMenuForPlayer(EVENTSTADIUMmenu,playerid);
		TogglePlayerControllable(playerid,false);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Los Santos Stadium!");
}

COMMAND:helm(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(Spieler[playerid][pMotorradhelm] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Helm!");
	if(Spieler[playerid][pWearedAMotorradhelm] == 0)
	{
		Spieler[playerid][pWearedAMotorradhelm] = 1;
		SCM(playerid,SAMP_WEISS,"* Du trägst nun einen Helm *");
		switch(Spieler[playerid][pMotorradhelm])
		{
			//case 1 == motorradhelm 1 rot ,case 2 == motorradhelm 2 grün ,case 3 == motorradhelm 3 blau rote sichtscheibe ,case 4 == motorcrosshelm 4|
			case 1: SetPlayerAttachedObject(playerid,2,18977,2 ,0.057000,0.023000,-0.002999,87.200019,75.399978,3.200001);
			case 2: SetPlayerAttachedObject(playerid,2,18979,2 ,0.048000,0.011999,0.000000,11.999999,83.500007,73.899993);
			case 3: SetPlayerAttachedObject(playerid,2,18978,2 ,0.058000,0.018999,0.003000,85.399986,77.000000,-0.599999);
			case 4: SetPlayerAttachedObject(playerid,2,18976,2 ,0.075999,0.038999,0.000000,11.999992,100.499992,79.700019);
		}
	}
	else if(Spieler[playerid][pWearedAMotorradhelm] == 1)
	{
		Spieler[playerid][pWearedAMotorradhelm] = 0;
		SCM(playerid,SAMP_WEISS,"* Helm abgenommen *");
		RemovePlayerAttachedObject(playerid,2);
	}
	return 1;
}

COMMAND:equipment(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new Float:x,Float:y,Float:z;
    if(!isPlayerInFrakt(playerid,3))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(Spieler[playerid][pFraktABTInvite] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Abteilung.");
	if(Spieler[playerid][pDuty] != 2)return SCM(playerid,SAMP_WEISS,"Nicht als Feuerwehrman im Dienst.");
	if(IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du bist in einem Fahrzeug!");
    for(new fv;fv<MAX_FVEHS;fv++)
	{
		if(Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		{
			GetVehiclePos(Fahrzeug[fv][Vehicle],x,y,z);
			if(IsPlayerInRangeOfPoint(playerid,2.0,x,y,z))
			{
				ShowMenuForPlayer(FIREequip,playerid);
				TogglePlayerControllable(playerid,false);
				return 1;
		    }
	    }
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der Nähe eines Fraktionsfahrzeuges.");
}

