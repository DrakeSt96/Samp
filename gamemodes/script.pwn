	CreateExplosion(Pos[0]+randompos,Pos[1]+randompos,Pos[2]+randompos,7,randexploderadius);
	AddFire(Pos[0]+randompos,Pos[1]+randompos,Pos[2]+randompos,GetPlayerVirtualWorld(playerid),false);
	SetPlayerACHealth(playerid,0);
	Spieler[playerid][pC4] -= 2;
	ForEachPlayer(i)
	{
		if(IsPlayerInRangeOfPoint(i,20.0,Pos[0],Pos[1],Pos[2]))
		{
			if(playerid != i)
			{
				Spieler[playerid][pMorde]++;
				SetPlayerACHealth(i,0);
			    SCM(playerid,HIGHROT,""IINFO" du hast ein Verbrechen begangen ( Vorsätzlicher Mord ). Reporter: Anonym");
			}
		}
	}
	return 1;
}
COMMAND:raketenwerfer(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new raketenrandom = random(9)+1,string[128],cops;
	if(isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,6))
	{
		if(!IsPlayerInRangeOfPoint(playerid,2.0,-1289.7888,509.4005,11.1953))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht am Flugzeugträger.");
	    if(isPlayerInFrakt(playerid,8))
		{
			if(gettime() < raket_rob)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur alle 45 Minuten einen Raketenwerfer stehlen.");
			ForEachPlayer(c)
			{
				if(IsPlayerConnected(c))
			    {
					if(isPlayerInFrakt(c,2) || isPlayerInFrakt(c,6))
				    {
					    if(Spieler[c][pDuty] != 0)
					    {
							cops++;
						}
					}
				}
			}
			if(cops < 2)return SCM(playerid,SAMP_WEISS,"Nicht genug Beamte Online.(2)");
			raket_rob = gettime() + (60*45);
			GiveWeapon(playerid,35,raketenrandom,true);
			format(string,sizeof(string),""IINFO" du hast soeben %i Schuss Raketenwerfermunition der San Andreas Army für einen Raketenwerfer gestohlen!",raketenrandom);
			SCM(playerid,0xD30023FF,string);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
					{
						SCM(i,DUNKELBLAU,"HQ: An alle Einheiten, ein Unbekannter versucht einen Raketenwerfer aus der Armybase zu stehlen!");//für die kommt dann die Message!
					}
				}
			}
			return 1;
		}
		else
		{
			if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang!");
			if(Spieler[playerid][pGetRocketLauncherTime] > gettime())
			{
				new time = Spieler[playerid][pGetRocketLauncherTime] - gettime();
				format(string,sizeof(string),""IINFO" du kannst dir erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten einen Raketenwerfer nehmen.",time/60,time%60);
				SCM(playerid,SAMP_WEISS,string);
			}
			Spieler[playerid][pGetRocketLauncherTime] = gettime() + (15*60);
			SCM(playerid,SAMP_WEISS,""IINFO" du hast dir einen Raketenwerfer mit 10 Schuss aus dem Raketenwerferdepot genommen!");
			GiveWeapon(playerid,35,10,false);
			return 1;
		}
    }
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:granaten(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new muni = random(4) + 1,string[128],cops;
	if(isPlayerInFrakt(playerid,8) || isPlayerInFrakt(playerid,6))
	{
		if(!IsPlayerInRangeOfPoint(playerid,2.0,257.4643,1816.1462,1.0078))return SCM(playerid,SAMP_WEISS,"Nicht in der Armybase.");
	    if(isPlayerInFrakt(playerid,8))
		{
			if(gettime() < granate_rob)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst nur alle 45 Minuten ein Granaten stehlen.");
			ForEachPlayer(c)
			{
				if(IsPlayerConnected(c))
			    {
					if(isPlayerInFrakt(c,2) || isPlayerInFrakt(c,6) && Spieler[c][pDuty] != 0) cops++;
				}
			}
			if(cops < 2)return SCM(playerid,SAMP_WEISS,"Nicht genug Beamte Online.(2)");
			granate_rob = gettime() + (60*45);
			GiveWeapon(playerid,16,muni,true);
			if(muni > 1) format(string,sizeof(string),""IINFO" du hast soeben %i Granaten der San Andreas Army entwendet!",muni);
			else format(string,sizeof(string),""IINFO" du hast soeben %i Granate der San Andreas Army entwendet!",muni);
			SCM(playerid,0xD30023FF,string);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(isPlayerInFrakt(i,2) || isPlayerInFrakt(i,6))
					{
						SCM(i,DUNKELBLAU,"HQ: An alle Einheiten, die Waffenkammer des Staates wurde ausgeraubt!");
					}
				}
			}
			return 1;
		}
		else
		{
			if(!isPlayerAMember(playerid,4))return SCM(playerid,SAMP_WEISS,"Nicht den jeweiligen Rang!");
			if(Spieler[playerid][pGetGrenadesTime] > gettime())
			{
				new time = Spieler[playerid][pGetGrenadesTime] - gettime();
				format(string,sizeof(string),""IINFO" du kannst dir erst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten Granaten nehmen.",time/60,time%60);
				SCM(playerid,SAMP_WEISS,string);
			}
			Spieler[playerid][pGetGrenadesTime] = gettime() + (15*60);
			SCM(playerid,SAMP_WEISS,""IINFO" du hast dir 5 Granaten aus dem Granatendepot genommen!");
			GiveWeapon(playerid,16,5,false);
			return 1;
		}
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}
COMMAND:eject(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(!IsPlayerInAnyVehicle(playerid))return SCM(playerid,SAMP_WEISS,""IINFO" du sitzt in keinem Fahrzeug.");
    if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /eject [playerid/Name]");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst aus dem Fahrzeug schmeißen!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!IsPlayerInVehicle(pID,GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,"Spieler befindet sich nicht in deinem Fahrzeug.");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	format(string,sizeof(string),"** %s wirft %s aus dem Fahrzeug **",SpielerName(playerid),SpielerName(pID));
	PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
 	RemovePlayerFromVehicle(pID);
	return 1;
}
COMMAND:fdcode(playerid,const params[])
{
 	new fv = IsAFraktionsVeh(playerid);
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	if(fv != -1 && Fahrzeug[fv][Fraktion] ==1 || Fahrzeug[fv][Fraktion] == 2 || Fahrzeug[fv][Fraktion] == 3 || Fahrzeug[fv][Fraktion] == 11){
		if(Spieler[playerid][pFraktion] == 1 || Spieler[playerid][pFraktion] == 2 || Spieler[playerid][pFraktion] == 3 || Spieler[playerid][pFraktion] == 11 && Spieler[playerid][pDuty] == 1){
	    	ShowPlayerDialog(playerid,DIALOG_FDCODE,DIALOG_STYLE_INPUT,""ClanTagDialoge" Fahrzeug Code",""#HTML_WEISS"Gebe deinen gewünschten Fahrzeug Code ein.","Codesetzen","Abbrechen");
		}else SCM(playerid,SAMP_WEISS,""IINFO" nicht in der Fraktion! Oder OnDuty.");
	}else SCM(playerid,SAMP_WEISS,""IINFO" nicht in diesem Fahrzeug möglich!");
	return 1;
}
COMMAND:fdcodedel(playerid,const params[])
{
 	new fv2 = IsAFraktionsVeh(playerid);
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	if(fv2 != -1 && Fahrzeug[fv2][Fraktion] ==1 || Fahrzeug[fv2][Fraktion] == 2 || Fahrzeug[fv2][Fraktion] == 3 || Fahrzeug[fv2][Fraktion] == 11){
		if(Spieler[playerid][pFraktion] == 1 || Spieler[playerid][pDuty] == 1){
			for(new fv;fv<MAX_FVEHS;fv++)
			{
				if(Fahrzeug[fv][Fraktion] == 1 || Fahrzeug[fv][Fraktion] == 2 || Fahrzeug[fv][Fraktion] == 3 || Fahrzeug[fv][Fraktion] == 11 && VehicleOnDuty[GetPlayerVehicleID(playerid)] == true){
		            Delete3DTextLabel(fdcodetext[GetPlayerVehicleID(playerid)]);
		            VehicleOnDuty[GetPlayerVehicleID(playerid)] = false;
		  		}
			}
		}else SCM(playerid,SAMP_WEISS,""IINFO" nicht in der Fraktion des S.A.P.D! Oder OnDuty");
	}else SCM(playerid,SAMP_WEISS,""IINFO" nicht in diesem Fahrzeug möglich!");
	return 1;
}
COMMAND:fare(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
 	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[650];
	if(!isPlayerInJob(playerid,17))return SCM(playerid,SAMP_WEISS,""IINFO" kein Taxifahrer.");
	if(!IsVehicleATaxi(GetPlayerVehicleID(playerid)))return SCM(playerid,SAMP_WEISS,""IINFO" in keinem Taxi.");
	if(GetPlayerVehicleSeat(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" nicht der Fahrer des Fahrzeugs.");
	if(Spieler[playerid][JobDuty]==0) return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Job Dienst!");
	Spieler[playerid][pTaxiDuty] = 1;
	PlayerTextDrawShow(playerid,TAXOdraw[playerid][1]);
	format(string,sizeof(string),"Dienstpreis: %i$",MAX_TAXI_PRICE);
	PlayerTextDrawSetString(playerid,TAXOdraw[playerid][1],string);
	format(string,sizeof(string),"Taxifahrer/in: "IINFO2"%s"#HTML_WEISS" ist absofort im Dienst. Kosten: "IINFO2"%i$",SpielerName(playerid),MAX_TAXI_PRICE);
	SendClientMessageToAll(SAMP_WEISS,string);
	if(IsValidDynamic3DTextLabel(taxipriceinfo[GetPlayerVehicleID(playerid)])) DestroyDynamic3DTextLabel(taxipriceinfo[GetPlayerVehicleID(playerid)]);
	VehicleOnDuty[GetPlayerVehicleID(playerid)] = true;
	format(string,sizeof(string),"{FFFF00}Starline Corporation\n{FFFFFF}Taxifahrer/in: "IINFO2"%s"#HTML_WEISS"\nDienstpreis: "IINFO2"%i$",SpielerName(playerid),MAX_TAXI_PRICE);
	taxipriceinfo[GetPlayerVehicleID(playerid)] = CreateDynamic3DTextLabel(string,SAMP_WEISS,0.0,0.0,0.0,25.0,INVALID_PLAYER_ID, GetPlayerVehicleID(playerid),1,0,-1,-1);
	PlayerTextDrawShow(playerid,TAXOdraw[playerid][0]);
 	PlayerTextDrawSetString(playerid,TAXOdraw[playerid][0],"Frei...");
 	PlayerTextDrawShow(playerid,TAXOdraw[playerid][2]);
  	PlayerTextDrawSetString(playerid,TAXOdraw[playerid][2],"Frei...");
  	PlayerTextDrawShow(playerid,TAXOdraw[playerid][3]);
	PlayerTextDrawSetString(playerid,TAXOdraw[playerid][3],"Frei...");
	return 1;
}
public OnPlayerEnterVehicle(playerid,vehicleid,ispassenger)
{
    Spieler[playerid][pWaiterCrash] = gettime() + 15;
	if(Spieler[playerid][pDeath] == 1)
	{
		ClearAnimations(playerid);
		TogglePlayerControllable(playerid,true);
		return 1;
	}
	new driver = Script_GetVehicleDriver(vehicleid);
	if(ispassenger == 0)
	{
		if(driver != INVALID_PLAYER_ID)
		{
			if(IsVehicleABus(vehicleid) || IsVehicleAPostCar(vehicleid) || IsVehicleACleanCar(vehicleid) || IsVehicleAMuellCar(vehicleid) || IsVehicleATransportplane(vehicleid) || IsVehicleATransportplane2(vehicleid) || IsVehicleATransportplane3(vehicleid) || IsVehicleATruck(vehicleid) || IsVehicleAFarmCar(vehicleid) || IsVehicleAFarmCar2(vehicleid) || IsVehicleATaxi(vehicleid))
			{
				ClearAnimations(playerid);
				TogglePlayerControllable(playerid,true);
				return 1;
			}
			for(new a=0;a<MAX_ADMINVEHS;a++)
		   	{
			   	if(vehicleid == adminmobile[a])
			   	{
				   	ClearAnimations(playerid);
					TogglePlayerControllable(playerid,true);
					break;
				}
		 	}
		 	for(new e=0;e<MAX_EVENTVEHS;e++)
		   	{
			   	if(vehicleid == eventmobile[e])
			   	{
				   	ClearAnimations(playerid);
					TogglePlayerControllable(playerid,true);
				   	break;
			   	}
		  	}
		}
	}
	return 1;
}
public OnPlayerExitVehicle(playerid,vehicleid)
{
    if(IsVehicleABus(vehicleid))
	{
	 	if(isPlayerInJob(playerid,11))
	 	{
		    if(BusCheckpointStatus1[playerid] != -1 || BusCheckpointStatus2[playerid] != -1 || BusCheckpointStatus3[playerid] != -1 || BusCheckpointStatus4[playerid] != -1 || BusCheckpointStatus5[playerid] != -1 || BusCheckpointStatus6[playerid] != -1 || BusCheckpointStatus7[playerid] != -1 || BusCheckpointStatus8[playerid] != -1)
		    {
			    JobTimer[playerid] = SetTimerEx("JobExit",2*60000,false,"i",playerid);
			    SCM(playerid,SAMP_WEISS,"Achtung! Du darfst dich nur 2 Minuten ausserhalb des Fahrzeuges bewegen,da der Job sonst abbricht!");
		    }
	    }
    }
	if(isPlayerInJob(playerid,8) && BauarbeiterHatErlaubnis[playerid] == 1)
	{
	    BauarbeiterHatErlaubnis[playerid] = 0;
	    BauarbeiterEntladenPunkt[playerid] = -1;
	    Spieler[playerid][pIsearch] = 0;
	    if(IsValidDynamicObject(BHaus2Object[playerid])) DestroyDynamicObject(BHaus2Object[playerid]);
	    BHaus2Object[playerid] = -1;
	    BauarbeiterCheckpoint[playerid] = 0;
	    if(IsValidDynamicObject(BHausObject[playerid])) DestroyDynamicObject(BHausObject[playerid]);
	    BHausObject[playerid] = -1;
	    MotorDown[vehicleid] = 0;
		vFahrzeug[vehicleid][FailGas] = 0;
		vFahrzeug[vehicleid][Tank] = VehicleInfo[GetVehicleModel(vehicleid)-400][vtankvolumen];
		SetVehicleToRespawn(vehicleid);
	    SCM(playerid,SAMP_WEISS,""IINFO" der Job wurde abgebrochen! Du bist aus deinem Fahrzeug ausgestiegen!");
	    DisablePlayerCheckpoint(playerid);
	}
    if(InviteInRace[playerid] == 1)
	{
		if(RaceFahrzeug[playerid] != 0) DestroyVehicle(RaceFahrzeug[playerid]);
		DisablePlayerRaceCheckpoint(playerid);
		for(new t=0;t<6;t++){ PlayerTextDrawHide(playerid,RACEdraw[playerid][t]); }
		new string2[128];
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(InviteInRace[i] == 1)
				{
					format(string2,sizeof(string2),"%s hat das Rennen verlassen! [Grund: Aus Fahrzeug ausgestiegen]",SpielerName(playerid));
					SCM(i,FMELDUNG,string2);
				}
			}
		}
		InviteInRace[playerid] = 0;
	}
	new i = Spieler[playerid][PprobefahrtVehID];
    if(vehicleid == Spieler[playerid][PprobefahrtVeh])
    {
		if(GetVehicleModel(vehicleid) == GetVehicleModel(Pvehicles[i]))
		{
		    DeleteVehicle(vehicleid);
		    PutPlayerInVehicleEx(playerid,Pvehicles[Spieler[playerid][PprobefahrtVehID]],0);
			TogglePlayerControllable(playerid,false);
			ShowPlayerDialog(playerid,DIALOG_AutoKaufen_Liste,DIALOG_STYLE_LIST,""ClanTagDialoge" Auothaus - Hauptmenü",""#HTML_BLAU"1."#HTML_WEISS" Auto Kaufen\n"#HTML_BLAU"2."#HTML_WEISS" Probefahrt\n"#HTML_BLAU"3."#HTML_WEISS" Fahrzeug Papiere","Nehmen","Abbrechen");
		    Spieler[playerid][PprobefahrtVeh] = 0;
			Spieler[playerid][PprobefahrtTime] = 0;
			Spieler[playerid][PprobefahrtVehID] = -1;
			return 1;
		}
		if(GetVehicleModel(vehicleid) == GetVehicleModel(Fvehicles[i]))
		{
		    DeleteVehicle(vehicleid);
		    PutPlayerInVehicleEx(playerid,Fvehicles[Spieler[playerid][PprobefahrtVehID]],0);
			TogglePlayerControllable(playerid,false);
			new Float:Pos[3];
			GetVehicleModelInfo(FvehicleBuyVehicles[i][modelid],VEHICLE_MODEL_INFO_SIZE,Pos[0],Pos[1],Pos[2]);
			ShowPlayerDialog(playerid,DIALOG_AutoKaufen_Liste,DIALOG_STYLE_LIST,""ClanTagDialoge" Auothaus - Hauptmenü",""#HTML_BLAU"1."#HTML_WEISS" Auto Kaufen\n"#HTML_BLAU"2."#HTML_WEISS" Probefahrt\n"#HTML_BLAU"3."#HTML_WEISS" Fahrzeug Papiere","Nehmen","Abbrechen");
		    Spieler[playerid][PprobefahrtVeh] = 0;
			Spieler[playerid][PprobefahrtTime] = 0;
			Spieler[playerid][PprobefahrtVehID] = -1;
			return 1;
		}
    }
    if(Spieler[playerid][InFahrSchulPruefung] == 1)
    {
	    if(Spieler[playerid][pSchulungsCPautolic] != 0 || Spieler[playerid][pSchulungsCPmotorbikelic] != 0 || Spieler[playerid][pSchulungsCPfluglic] != 0 || Spieler[playerid][pSchulungsCPbootlic] != 0 || Spieler[playerid][pSchulungsCPhelilic] != 0 || Spieler[playerid][pSchulungsCProllerlic] != 0)
		{
			SCM(playerid,SAMP_WEISS,""IINFO" du bist aus dem Fahrzeug gestiegen! Deine Prüfung wurde abgebrochen.");
			Spieler[playerid][pSchulungsCPautolic] = 0;
		    Spieler[playerid][pSchulungsCPmotorbikelic] = 0;
		    Spieler[playerid][pSchulungsCProllerlic] = 0;
		    Spieler[playerid][pSchulungsCPfluglic] = 0;
		    Spieler[playerid][pSchulungsCPbootlic] = 0;
		    Spieler[playerid][pSchulungsCPhelilic] = 0;
		    Spieler[playerid][pSchulungsWARNS] = 0;
		    Spieler[playerid][InFahrSchulPruefung] = 0;
		    SetPlayerPosEx(playerid,-2033.4276,-117.4092,1035.1719);
			SetPlayerInterior(playerid,3);
			SetPlayerVirtualWorld(playerid,0);
		    DeleteVehicle(Spieler[playerid][pSchulungsVEH]);
		    Spieler[playerid][pSchulungsVEH] = -1;
		}
	}
	if(Spieler[playerid][pKartracingCP1] != 0)
	{
		DisablePlayerRaceCheckpoint(playerid);
		KillTimer(Spieler[playerid][pKartTimer]);
		Spieler[playerid][pKartracingCP1] = 0;
		Spieler[playerid][pKartCountdown] = 0;
	    SetPlayerPosEx(playerid,2308.4192,-1238.2944,-30.9800);
		SetPlayerInterior(playerid,0);
	    DeleteVehicle(Spieler[playerid][pKart]);
	    Spieler[playerid][pKart] = -1;
	}
    if(IsVehicleAPostCar(vehicleid))
    {
	 	if(isPlayerInJob(playerid,4))
	 	{
		    if(postjobgo[playerid] != 0 || postjobgo2[playerid] != 0)
		    {
			    JobTimer[playerid] = SetTimerEx("JobExit",2*60000,false,"i",playerid);
			    SCM(playerid,SAMP_WEISS,"Achtung! Du darfst dich nur 2 Minuten ausserhalb des Fahrzeuges bewegen,da der Job sonst abbricht!");
		    }
	    }
	}

    if(IsVehicleATransportplane(vehicleid))
    {
	 	if(isPlayerInJob(playerid,3))
	 	{
		    if(fjobgo[playerid] != 0)
		    {
			    JobTimer[playerid] = SetTimerEx("JobExit",2*60000,false,"i",playerid);
			    SCM(playerid,SAMP_WEISS,"Achtung! Du darfst dich nur 2 Minuten ausserhalb des Fahrzeuges bewegen,da der Job sonst abbricht!");
		    }
	    }
    }

    if(IsVehicleATransportplane2(vehicleid))
    {
	 	if(isPlayerInJob(playerid,3))
	 	{
		    if(fjobgo1[playerid] != 0)
		    {
			    JobTimer[playerid] = SetTimerEx("JobExit",2*60000,false,"i",playerid);
			    SCM(playerid,SAMP_WEISS,"Achtung! Du darfst dich nur 2 Minuten ausserhalb des Fahrzeuges bewegen,da der Job sonst abbricht!");
		    }
	    }
    }

    if(IsVehicleATransportplane3(vehicleid))
    {
	 	if(isPlayerInJob(playerid,3))
	 	{
		    if(fjobgo2[playerid] != 0)
		    {
			    JobTimer[playerid] = SetTimerEx("JobExit",2*60000,false,"i",playerid);
			    SCM(playerid,SAMP_WEISS,"Achtung! Du darfst dich nur 2 Minuten ausserhalb des Fahrzeuges bewegen,da der Job sonst abbricht!");
		    }
	    }
    }

    if(IsVehicleATruck(vehicleid))
    {
	 	if(isPlayerInJob(playerid,10))
	 	{
		    if(truckerjobgo[playerid] != 0 || truckerjobgo2[playerid] != 0 || truckerjobgo3[playerid] != 0 || truckerjobgo4[playerid] != 0 || truckerjobgo5[playerid] != 0)
		    {
		    	JobExit(playerid);
		    }
	    }
    }

 	if((IsVehicleAFarmCar(vehicleid) || IsVehicleAFarmCar2(vehicleid)))
    {
	 	if(isPlayerInJob(playerid,6))
	 	{
			if(farmjobgo[playerid] != 0 ||  farmjobgo2[playerid] != 0)
		    {
		    	JobExit(playerid);
		    }
	    }
    }

 	if(IsVehicleATaxi(vehicleid))
	{
	    if(isPlayerInJob(playerid,17) && Spieler[playerid][pTaxiDuty] == 1)
	 	{
		    Spieler[playerid][pTaxiDuty] = 0;
		    PlayerTextDrawHide(playerid,TAXOdraw[playerid][0]);
		    PlayerTextDrawHide(playerid,TAXOdraw[playerid][1]);
		   	PlayerTextDrawHide(playerid,TAXOdraw[playerid][2]);
			PlayerTextDrawHide(playerid,TAXOdraw[playerid][3]);
			if(IsVehicleATaxi(vehicleid) && VehicleOnDuty[vehicleid] == true)
			{
				VehicleOnDuty[vehicleid] = false;
				if(IsValidDynamic3DTextLabel(taxipriceinfo[vehicleid]))
				{
					DestroyDynamic3DTextLabel(taxipriceinfo[vehicleid]);
				}
			}
	    }
	}
	strmid(Flastdriver[vehicleid],Spieler[playerid][pName],0,strlen(Spieler[playerid][pName]),strlen(Spieler[playerid][pName]));
	return 1;
}

public OnPlayerStateChange(playerid,PLAYER_STATE:newstate,PLAYER_STATE:oldstate)
{
    new vehicleid = GetPlayerVehicleID(playerid),string[512];
    ForEachPlayer(i)
	{
	 	if(GetPlayerState(i) == PLAYER_STATE_SPECTATING && Spieler[i][pSpectate] == playerid)
	 	{
		  	if(oldstate == PLAYER_STATE_ONFOOT && (newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)) PlayerSpectateVehicle(i,GetPlayerVehicleID(playerid));
			else if((oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER) && newstate == PLAYER_STATE_ONFOOT) PlayerSpectatePlayer(i,playerid);
	  	}
	}
    if(newstate == PLAYER_STATE_ONFOOT || newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
    {
	    if(!IsPlayerInAnyVehicle(playerid) && !strcmp(VehicleRadioStream[vehicleid],"NONE",true)) StopAudioStreamForPlayer(playerid);
		if(IsPlayerInAnyVehicle(playerid) && strcmp(VehicleRadioStream[vehicleid],"NONE",true))
		{
			StopAudioStreamForPlayer(playerid);
			PlayAudioStreamForPlayer(playerid,VehicleRadioStream[vehicleid]);
		}
    }
    if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
    {
        Spieler[playerid][pAntiVehicleEnterVehicleID] = vehicleid;
		Spieler[playerid][pAntiVehicleEnter] = gettime() + 3;
    }
	else Spieler[playerid][pAntiVehicleEnterVehicleID] = -1,Spieler[playerid][pAntiVehicleEnter] = 0;
    if(newstate != PLAYER_STATE_SPECTATING) SyncFperson(playerid);
    if(newstate == PLAYER_STATE_PASSENGER)
	{
		SetPlayerArmedWeapon(playerid,WEAPON_FIST);
		if(IsVehicleATaxi(vehicleid))
	    {
		    new driver = Script_GetVehicleDriver(vehicleid);
			if(Spieler[driver][pTaxiDuty] == 1)
			{
				if((GetACMoney(playerid) - MAX_TAXI_PRICE) < 0)
				{
					TextDrawShowForPlayer(playerid,InfoSign);
				    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Nicht genug Geld.");
					PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
					StopAudioStreamForPlayer(playerid);
					
				 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
					return RemovePlayerFromVehicle(playerid);
				}
				Spieler[playerid][pTaxiBeifahrerPreis] = 0;
				PlayerTextDrawShow(playerid,TAXOdraw[playerid][0]);
				PlayerTextDrawShow(playerid,TAXOdraw[playerid][1]);
				PlayerTextDrawSetString(playerid,TAXOdraw[playerid][0],"Fahrpreis: 0$");
				format(string,sizeof(string),"Dienstpreis: %i$",MAX_TAXI_PRICE);
				PlayerTextDrawSetString(playerid,TAXOdraw[playerid][1],string);
				format(string,sizeof(string),""IINFO" du bist in das Taxi von %s eingestiegen! Dienstpreis : %i$ (Dienstpreis + Fahrzeit alle 15 Sekunden)",SpielerName(driver),MAX_TAXI_PRICE);
				SCM(playerid,SAMP_WEISS,string);
				format(string,sizeof(string),"%s ist in dein Taxi eingestiegen! Dienstpreis : %i$ (Dienstpreis + Fahrzeit alle 15 Sekunden)",SpielerName(playerid),MAX_TAXI_PRICE);
				SCM(driver,SAMP_WEISS,string);
				Spieler[playerid][pTaxiSeat] = GetPlayerVehicleSeat(playerid);
			 	Spieler[playerid][pTaxiTimer] = SetTimerEx("Taxometer",753,true,"ii",playerid,driver);
			 	switch(GetPlayerVehicleSeat(playerid))
			    {
				   	case 1:
				   	{
					 	format(string,sizeof(string),"%s %i$",SpielerName(playerid),Spieler[playerid][pTaxiBeifahrerPreis]);
					 	PlayerTextDrawSetString(driver,TAXOdraw[driver][0],string);
				 	}
				   	case 2:
				   	{
					  	format(string,sizeof(string),"%s %i$",SpielerName(playerid),Spieler[playerid][pTaxiBeifahrerPreis]);
					  	PlayerTextDrawSetString(driver,TAXOdraw[driver][2],string);
				  	}
					case 3:
					{
						format(string,sizeof(string),"%s %i$",SpielerName(playerid),Spieler[playerid][pTaxiBeifahrerPreis]);
						PlayerTextDrawSetString(driver,TAXOdraw[driver][3],string);
					}
			   	}
		   	}
		}
	    if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 582 && GetPlayerVehicleSeat(playerid) == 1)
	   	{
		   	PlayerInNewsVan[playerid] = GetPlayerVehicleID(playerid);
		   	SetPlayerPosEx(playerid,-219.6105,1408.2527,27.7656);
		   	SetPlayerInterior(playerid,18);
		   	SetPlayerVirtualWorld(playerid,1000+PlayerInNewsVan[playerid]);
	   	}
	   	if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 508 && GetPlayerVehicleSeat(playerid) == 1)
	   	{
		   	PlayerInJourney[playerid] = GetPlayerVehicleID(playerid);
		   	SetPlayerPosEx(playerid,767.9480,1402.6608,-4.5741);
		   	SetPlayerInterior(playerid,0);
		   	SetPlayerVirtualWorld(playerid,PlayerInJourney[playerid]);
	   	}
		if(IsVehicleABus(vehicleid))
		{
			if((GetACMoney(playerid) - MAX_BUS_PRICE) < 0 )
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Nicht genug Geld.");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
				StopAudioStreamForPlayer(playerid);
				
				SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				return RemovePlayerFromVehicle(playerid);
			}
			format(string,sizeof(string),""IINFO" du hast %i$ für dein Busfahrticket bezahlen!",MAX_BUS_PRICE);
			SCM(playerid,SAMP_WEISS,string);
			ACMoney(playerid,- MAX_BUS_PRICE);
			ACMoney(Script_GetVehicleDriver(vehicleid),MAX_BUS_PRICE);
			format(string,sizeof(string),"%s hat ein Busfahrticket für %i$ gekauft!",SpielerName(playerid),MAX_BUS_PRICE);
			SCM(Script_GetVehicleDriver(vehicleid),SAMP_WEISS,string);
		}
	}
	if(newstate == PLAYER_STATE_DRIVER)
	{
		SetPlayerArmedWeapon(playerid,WEAPON_FIST);
		if(Spieler[playerid][TachoShow] == false)
		{
			Spieler[playerid][TachoTimer] = SetTimerEx("Tachometer",986,true,"i",playerid);
			Spieler[playerid][TachoShow] = true;
		}
		if(GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 510)
	    {
			GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
			SetVehicleParamsEx(vehicleid,VEHICLE_PARAMS_ON,lights,alarm,doors,bonnet,boot,objective);
	    }
	    else{}
	    new fv = IsAFraktionsVeh(playerid);
	    if(fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion] && !isPlayerAMember(playerid,Fahrzeug[fv][FraktionsRang]))
	    {
		    TextDrawShowForPlayer(playerid,InfoSign);
		    format(string,sizeof(string),"~r~Info:~w~~n~Das Fahrzeug %s (ID:%i) ist auf den Rang %i ausgelegt.",VehicleDefinations[Fahrzeug[fv][modelid]-400],fv,Fahrzeug[fv][FraktionsRang]);
		    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],string);
			PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
			StopAudioStreamForPlayer(playerid);
			
		 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
			return RemovePlayerFromVehicle(playerid);
	    }
		if(IsVehAGWDVehicle(vehicleid) && Spieler[playerid][pGrundwehrdienst] > 2)
		{
			if(isPlayerInFrakt(playerid,6) && Spieler[playerid][pDuty] == 1 || Spieler[playerid][pAdminOnduty] == true)return 1;
		 	TextDrawShowForPlayer(playerid,InfoSign);
		    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Keine Grundwehrdienstnote 3.");
			PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
			StopAudioStreamForPlayer(playerid);
			
		 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
			return RemovePlayerFromVehicle(playerid);
		}
		if(Spieler[playerid][InFahrSchulPruefung] == 0)
		{
			if(GetVehicleModel(vehicleid) == 462 && Spieler[playerid][pRollerLic] == 0) SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Rollerschein."),SCM(playerid,SAMP_WEISS,"Lass dich nicht von der Polizei oder dem Ordnungsamt erwischen.");
			if(IsVehABike(vehicleid) && Spieler[playerid][pBikeLic] == 0) SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Motorradschein."),SCM(playerid,SAMP_WEISS,"Lass dich nicht von der Polizei oder dem Ordnungsamt erwischen.");
			if(IsVehABoot(vehicleid) && Spieler[playerid][pBoatLic] == 0) SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Bootsschein."),SCM(playerid,SAMP_WEISS,"Lass dich nicht von der Polizei oder dem Ordnungsamt erwischen.");
			if(IsVehAFlugzeug(vehicleid))
			{
				if(isPlayerInFrakt(playerid,6) && Spieler[playerid][pArmyPlaneOrder] == 0 && (fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion]))
				{
					TextDrawShowForPlayer(playerid,InfoSign);
				    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du hast nicht die Berechtigung dieses Flugzeug zu fliegen.");
					PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
					StopAudioStreamForPlayer(playerid);
					
				 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
					return RemovePlayerFromVehicle(playerid);
				}
				if(Spieler[playerid][pPlaneLic] == 0)
				{
					RemovePlayerFromVehicle(playerid);
					TextDrawShowForPlayer(playerid,InfoSign);
				    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du besitzt keinen Flugzeugschein.~n~~w~Du hast zu viel Angst um das Flugzeug oder den Helikopter zufliegen.");
					PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
					StopAudioStreamForPlayer(playerid);
					
				 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				}
			}
			if(IsVehAHelicopter(vehicleid))
			{
				if(isPlayerInFrakt(playerid,6) && Spieler[playerid][pArmyHeliOrder] == 0 && (fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion]))
				{
					TextDrawShowForPlayer(playerid,InfoSign);
				    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du hast nicht die Berechtigung diesen Helikopter zu fliegen.");
					PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
					StopAudioStreamForPlayer(playerid);
					
				 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
					return RemovePlayerFromVehicle(playerid);
				}
				if(Spieler[playerid][pHeliLic] == 0)
				{
				 	RemovePlayerFromVehicle(playerid);
					TextDrawShowForPlayer(playerid,InfoSign);
				    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du besitzt keinen Helikopterschein.~n~~w~Und hast zu viel Angst den Helikopter zufliegen.");
					PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
					StopAudioStreamForPlayer(playerid);
					
				 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				}
			}
			if(IsVehicleACar(vehicleid) && Spieler[playerid][pAutoLic] == 0) SCM(playerid,SAMP_WEISS,""IINFO" du hast keinen Führerschein."),SCM(playerid,SAMP_WEISS,"Lass dich nicht von der Polizei oder dem Ordnungsamt erwischen.");
		}
		ForEachPlayer(i)
		{
			for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
			{
				if(vehicleid == Pfahrzeug[slot][i][Vehicle])
				{
					if(gettime() < Pfahrzeug[slot][i][AnmeldeTime] && Pfahrzeug[slot][i][AnAnmeldung] == 1)
					{
						TextDrawShowForPlayer(playerid,InfoSign);
					    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Das Fahrzeug wird angemeldet.");
						PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
						StopAudioStreamForPlayer(playerid);
						
					 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
						return RemovePlayerFromVehicle(playerid);
					}
				}
			}
		}
		if((IsVehicleAFarmCar(vehicleid) || IsVehicleAFarmCar2(vehicleid)))
	    {
		    if(Spieler[playerid][pJob] != 6)
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du besitzt nicht den jeweiligen Job.");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
				StopAudioStreamForPlayer(playerid);
				
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				return RemovePlayerFromVehicle(playerid);
			}
			if(farmjobgo[playerid] == 0 && farmjobgo2[playerid] == 0 || farmjobgo2[playerid] == 0 && farmjobgo[playerid] == 0)
		    {
				ShowPlayerDialog(playerid,DIALOG_JOB_START_AUSWAHL,DIALOG_STYLE_MSGBOX,"Landwirt","Entscheide dich ob du den Job ´Starten´ oder ´Abbrechen´ willst !?","Starten","Abbrechen");
			}
			else
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Fahre nun weiter das Feld ab!");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				KillTimer(JobTimer[playerid]);
			}
		}
		if(IsVehicleATruck(vehicleid))
	    {
		    if(Spieler[playerid][pJob] != 10)
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du besitzt nicht den jeweiligen Job.");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
				StopAudioStreamForPlayer(playerid);
				
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				return RemovePlayerFromVehicle(playerid);
			}
			if(truckerjobgo[playerid] == 0 && truckerjobgo2[playerid] == 0 && truckerjobgo3[playerid] == 0 && truckerjobgo4[playerid] == 0 && truckerjobgo5[playerid] == 0
			|| truckerjobgo2[playerid] == 0 && truckerjobgo[playerid] == 0 && truckerjobgo3[playerid] == 0 && truckerjobgo4[playerid] == 0 && truckerjobgo5[playerid] == 0
			|| truckerjobgo3[playerid] == 0 && truckerjobgo2[playerid] == 0 && truckerjobgo[playerid] == 0 && truckerjobgo4[playerid] == 0 && truckerjobgo5[playerid] == 0
			|| truckerjobgo4[playerid] == 0 && truckerjobgo5[playerid] == 0 && truckerjobgo3[playerid] == 0 && truckerjobgo2[playerid] == 0 && truckerjobgo[playerid] == 0
			|| truckerjobgo5[playerid] == 0 && truckerjobgo4[playerid] == 0 && truckerjobgo3[playerid] == 0 && truckerjobgo2[playerid] == 0 && truckerjobgo[playerid] == 0)
		    {
				ShowPlayerDialog(playerid,DIALOG_JOB_STRECKEN_AUSWAHL,DIALOG_STYLE_LIST,"Truckerauslieferungsplan","Waren\nAutoteile\nBauschutt\nTreibstoff\nEisen","Auswählen","Abbrechen");
		    }
		    else
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Fahre nun weiter die Ladungs aus!");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				KillTimer(JobTimer[playerid]);
			}
		}
		if(IsVehicleABus(vehicleid))
	    {
		    if(Spieler[playerid][pJob] != 11)
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du besitzt nicht den jeweiligen Job.");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
				StopAudioStreamForPlayer(playerid);
				
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				return RemovePlayerFromVehicle(playerid);
			}
			if(BusCheckpointStatus1[playerid] == -1 && BusCheckpointStatus2[playerid] == -1 && BusCheckpointStatus3[playerid] == -1 && BusCheckpointStatus4[playerid] == -1 && BusCheckpointStatus5[playerid] == -1 && BusCheckpointStatus6[playerid] == -1 && BusCheckpointStatus7[playerid] == -1 && BusCheckpointStatus8[playerid] == -1
		    || BusCheckpointStatus2[playerid] == -1 && BusCheckpointStatus1[playerid] == -1 && BusCheckpointStatus3[playerid] == -1 && BusCheckpointStatus4[playerid] == -1 && BusCheckpointStatus5[playerid] == -1 && BusCheckpointStatus6[playerid] == -1 && BusCheckpointStatus7[playerid] == -1 && BusCheckpointStatus8[playerid] == -1
		    || BusCheckpointStatus3[playerid] == -1 && BusCheckpointStatus1[playerid] == -1 && BusCheckpointStatus2[playerid] == -1 && BusCheckpointStatus4[playerid] == -1 && BusCheckpointStatus5[playerid] == -1 && BusCheckpointStatus6[playerid] == -1 && BusCheckpointStatus7[playerid] == -1 && BusCheckpointStatus8[playerid] == -1
		    || BusCheckpointStatus4[playerid] == -1 && BusCheckpointStatus1[playerid] == -1 && BusCheckpointStatus2[playerid] == -1 && BusCheckpointStatus3[playerid] == -1 && BusCheckpointStatus5[playerid] == -1 && BusCheckpointStatus6[playerid] == -1 && BusCheckpointStatus7[playerid] == -1 && BusCheckpointStatus8[playerid] == -1
		    || BusCheckpointStatus5[playerid] == -1 && BusCheckpointStatus1[playerid] == -1 && BusCheckpointStatus2[playerid] == -1 && BusCheckpointStatus3[playerid] == -1 && BusCheckpointStatus4[playerid] == -1 && BusCheckpointStatus6[playerid] == -1 && BusCheckpointStatus7[playerid] == -1 && BusCheckpointStatus8[playerid] == -1
		    || BusCheckpointStatus6[playerid] == -1 && BusCheckpointStatus1[playerid] == -1 && BusCheckpointStatus2[playerid] == -1 && BusCheckpointStatus3[playerid] == -1 && BusCheckpointStatus4[playerid] == -1 && BusCheckpointStatus5[playerid] == -1 && BusCheckpointStatus7[playerid] == -1 && BusCheckpointStatus8[playerid] == -1
		    || BusCheckpointStatus7[playerid] == -1 && BusCheckpointStatus1[playerid] == -1 && BusCheckpointStatus2[playerid] == -1 && BusCheckpointStatus3[playerid] == -1 && BusCheckpointStatus4[playerid] == -1 && BusCheckpointStatus5[playerid] == -1 && BusCheckpointStatus6[playerid] == -1 && BusCheckpointStatus8[playerid] == -1
		    || BusCheckpointStatus8[playerid] == -1 && BusCheckpointStatus1[playerid] == -1 && BusCheckpointStatus2[playerid] == -1 && BusCheckpointStatus3[playerid] == -1 && BusCheckpointStatus4[playerid] == -1 && BusCheckpointStatus5[playerid] == -1 && BusCheckpointStatus6[playerid] == -1 && BusCheckpointStatus7[playerid] == -1)
		    {
				ShowPlayerDialog(playerid,DIALOG_JOB_STRECKEN_AUSWAHL,DIALOG_STYLE_LIST,"Buslinien","Linie 11 (Los Santos Ost/Zentrum Ost)\nLinie 30 (Zentrum West/Los Santos Airport)\nLinie 22 (Industrie Gebiet/Los Santos Ost)\nLinie 14 (Zentrum LS/ Downtown LS)\nLinie 1 (Zentrum LS/San Fierro)\nLinie 16 (Zentrum LS/Las Venturas)\nLinie 7 (Los Santos Ost/Zentrum LS)\nLinie 21 (Los Santos Süd)","Auswählen","Abbrechen");
			}
			else
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Fahre nun weiter die Haltestellen ab!");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				KillTimer(JobTimer[playerid]);
			}
		}
		if(IsVehicleACleanCar(vehicleid))
	    {
		    if(Spieler[playerid][pJob] != 2)
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du besitzt nicht den jeweiligen Job.");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
				StopAudioStreamForPlayer(playerid);
				
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				return RemovePlayerFromVehicle(playerid);
			}
			SCM(playerid,SAMP_WEISS,"Befehle: /loaddirtstatus,/unloaddirt,/cleanmachine");
			SCM(playerid,SAMP_WEISS,"Um die Straße von Müll und Dreck zu reinigen drücke die Taste 'Num2' um die Straße zu säubern.");
		}
		if(IsVehicleAPWaffentransportCar(vehicleid))
		{
		    if(!isPlayerInFrakt(playerid,1))
			{
				SCM(playerid,SAMP_WEISS,""IINFO" das Darfst du nicht!");
				StopAudioStreamForPlayer(playerid);
				return RemovePlayerFromVehicle(playerid);
			}
			else if(!isPlayerAMember(playerid,3))
			{
				SCM(playerid,SAMP_WEISS,""IINFO" das Darfst du nicht!");
				StopAudioStreamForPlayer(playerid);
				return RemovePlayerFromVehicle(playerid);
			}
			SCM(playerid,SAMP_WEISS,""IINFO" /startwaffentransport | /loadwaffen | /deliverwaffen");
		}
		if(IsVehicleAMuellCar(vehicleid))
	    {
		    if(Spieler[playerid][pJob] != 1)
			{
				TextDrawShowForPlayer(playerid,InfoSign);
			    PlayerTextDrawSetString(playerid,INFOdraw[playerid][2],"~r~Info:~w~~n~Du besitzt nicht den jeweiligen Job.");
				PlayerTextDrawShow(playerid,INFOdraw[playerid][2]);
				StopAudioStreamForPlayer(playerid);
				
			 	SetTimerEx("HideInfoBox",3000,false,"i",playerid);
				return RemovePlayerFromVehicle(playerid);
			}
			SCM(playerid,SAMP_WEISS,"Befehle: /loadrubbish,/loadrubbishstatus,/unloadrubbish,/landfill,/op,/accept rubbish");
		}
		if(IsVehicleATransportplane(vehicleid))
	    {
