					    ShowPlayerDialog(playerid,SMARK_MENU_GELD_EINZAHLEN,DIALOG_STYLE_INPUT,"Schwarzmarkt (Einzahlung von Geld)",string,"Einzahlen","Zurück");
						return SCM(playerid,SAMP_WEISS,"Nicht genug Geld in der Schwarzmarktkasse.");
					}
					SmarkInfo[sm][skasse] -= Menge;
					ACMoney(playerid,Menge);
