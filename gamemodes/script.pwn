					 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][7]);
					 	TextDrawHideForPlayer(i,GangwarZones[gw][WARdraw][8]);
					    GameTextForPlayer(i,"~g~GANGWAR GEWONNEN",7500,5);
