COMMAND:auninvite(playerid,const params[])
{
    new string[550],stringuninv[550],pID;
    if(!isPlayerAnAdmin(playerid,4))return SCM(playerid,GRAU,""IINFO" das darfst du nicht!");
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""IINFO" /auninvite (ID)");
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht eingeloggt!");
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(isPlayerInFrakt(pID,0))return SCM(playerid,SAMP_WEISS,"Spieler ist in keiner Fraktion.");
	format(stringuninv,sizeof(stringuninv),""ACINFO" du hast dem Spieler "IINFO2"%s"#HTML_WEISS" aus der Fraktion "IINFO2"%s"#HTML_WEISS" uninvitet.",Spieler[pID][pName],FraktionsName(Spieler[pID][pFraktion]));
  	SCM(playerid,SAMP_WEISS,stringuninv);
	format(stringuninv,sizeof(stringuninv),""ACINFO" du wurdest von "IINFO2"%s"#HTML_WEISS" aus der Fraktion "IINFO2"%s"#HTML_WEISS" uninvitet.",Spieler[playerid][pName],FraktionsName(Spieler[pID][pFraktion]));
 	SCM(pID,SAMP_WEISS,stringuninv);
 	format(string,sizeof(string),"Admin %s User: %s * Fraktion: %s",Spieler[playerid][pName],Spieler[pID][pName],FraktionsName(Spieler[pID][pFraktion]));
  	Log("script_auninvite",string);
  	GetPlayerPos(pID,Spieler[pID][LastInGamePos_x],Spieler[pID][LastInGamePos_y],Spieler[pID][LastInGamePos_z]);
	Spieler[pID][LastInGamePos_int] = GetPlayerInterior(pID);
	Spieler[pID][LastInGamePos_world] = GetPlayerVirtualWorld(pID);
	if(Spieler[pID][pLeader] != 1)
	{
		fverwaltungen[Spieler[playerid][pFraktion]][FrakMembers]--;
	}
   	Spieler[pID][pFraktion] = 0;
  	Spieler[pID][pFraktRang] = 0;
  	Spieler[pID][pFraktURang] = 0;
  	Spieler[pID][pArmyHeliOrder] = 0;
	Spieler[pID][pArmyPlaneOrder] = 0;
  	Spieler[pID][pLeader] = 0;
   	Spieler[pID][pFraktionsGehalt] = 0;
   	Spieler[pID][pFraktSkin] = 0;
   	Spieler[pID][pSpawn] = 0;
   	Spieler[pID][pFraktABTInvite] = 0;
   	Spieler[pID][pDuty] = 0;
  	SpawnPlayerEx(pID);
	return 1;
}
COMMAND:makeleader(playerid,const params[])
{
    new pID,fID,string[650];
	if(!isPlayerAnAdmin(playerid,5))return SCM(playerid,GRAU,""IINFO" du bist kein Teammitglied");
	if(sscanf(params,"ui",pID,fID))return SCM(playerid,SAMP_WEISS,""IINFO" /makeleader [playerid/Name][Fraktionsid]");
	if(fID<1||fID>17)return SCM(playerid,GRAU,"Wähle bitte eine Fraktion zwischen 1 und 16 aus.");
	if(!IsPlayerConnected(pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht eingeloggt!");
    if(GetPVarInt(pID,"Eingeloggt") == 0)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht eingeloggt!");
	if(IsPlayerNPC(pID))return SCM(playerid,GRAU,""IINFO" das kannst du nicht!");
	if(GetPlayerLevel(pID) < 1)return SCM(playerid,SAMP_WEISS,"Spieler besitzt nicht das nötige Level (mindestens Level 1)");
	if(Spieler[pID][pFraktion] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist bereits in einer Fraktion.");
	if(gettime() < Spieler[pID][pFraktionSperre])return SCM(playerid,SAMP_WEISS,"Spieler hat eine Fraktionssperre.");
	if(!isPlayerAnAdmin(pID,6))
	{
		if(Spieler[pID][pFraktion] != 0)return SCM(playerid,SAMP_WEISS,""IINFO" Spieler bereits in der Fraktion als Leader tätig.");
	    Spieler[pID][pFraktionSperre] = 0;
	}
	Spieler[pID][pFraktion] = fID;
	Spieler[pID][pFraktRang] = 6;
	Spieler[pID][pLeader] = 1;
	Spieler[pID][pSpawn] = 2;
	Spieler[pID][pFraktionsGehalt] = 1600;
	Spieler[pID][pFraktSkin] = 0;
	Spieler[pID][pFraktABTInvite] = 0;
	GetPlayerPos(pID,Spieler[pID][LastInGamePos_x],Spieler[pID][LastInGamePos_y],Spieler[pID][LastInGamePos_z]);
	Spieler[pID][LastInGamePos_int] = GetPlayerInterior(pID);
	Spieler[pID][LastInGamePos_world] = GetPlayerVirtualWorld(pID);
	SetPlayerACHealth(pID,100);
	switch(fID)
	{
	    case 1:{Spieler[pID][pDuty] = 1;}
	    case 2:{Spieler[pID][pDuty] = 1;}
	    case 3:{Spieler[pID][pDuty] = 1;}
	    case 4:{Spieler[pID][pDuty] = 0;}
	    case 5:{Spieler[pID][pDuty] = 0;}
	    case 6:{Spieler[pID][pDuty] = 1; Spieler[playerid][pArmyWaffenOrder] = 1; SetPlayerWaffenSkill(playerid);}
	    case 7:{Spieler[pID][pDuty] = 0;}
	    case 8:{Spieler[pID][pDuty] = 0;}
	    case 9:{Spieler[pID][pDuty] = 0;}
	    case 10:{Spieler[pID][pDuty] = 1;}
	    case 11:{Spieler[pID][pDuty] = 1;}
	    case 12:{Spieler[pID][pDuty] = 0;}
	    case 13:{Spieler[pID][pDuty] = 0;}
	    case 14:{Spieler[pID][pDuty] = 1;}
	    case 15:{Spieler[pID][pDuty] = 1;}
	    case 16:{Spieler[pID][pDuty] = 1;}
	    case 17:{Spieler[pID][pDuty] = 0;}
    }
	format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS" hat den Spieler "IINFO2"%s"#HTML_WEISS" zum Leader der Fraktion "IINFO2"%s"#HTML_WEISS" gemacht.",Spieler[playerid][pName],Spieler[pID][pName],FraktionsName(fID));
	SendAdminMessage(BLAU,string);
	format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS" hat dich zum Leader der Fraktion "IINFO2"%s"#HTML_WEISS" gemacht.",Spieler[playerid][pName],FraktionsName(fID));
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),"Admin: %s User: %s * Fraktion: %s",Spieler[playerid][pName],Spieler[pID][pName],FraktionsName(fID));
	Log("leader.txt",string);
	switch(Spieler[pID][pFraktion]){
		case 0:{
		    SetPlayerPosEx(pID,721.3259,-1328.1736,13.5391);
	    	SetPlayerFacingAngle(pID,3.3708);
			SetPlayerCameraPos(pID, 721.7279, -1316.5415, 14.2091);
			SetPlayerCameraLookAt(pID, 721.6773, -1317.5453, 14.1291);
			SetPlayerInterior(pID,0);
 		  	Spieler[pID][ImInvite] = 1;
		    BincoSystem(pID);
		}//LSPD
		case 1:{
		    SetPlayerPosEx(pID,721.3259,-1328.1736,13.5391);
	    	SetPlayerFacingAngle(pID,3.3708);
			SetPlayerCameraPos(pID, 720.8214, -1317.1305, 17.8457);
			SetPlayerCameraLookAt(pID, 720.7907, -1318.1334, 17.5807);
			SetPlayerInterior(pID,0);
		  	Spieler[pID][ImInvite] = 1;
		    BincoSystem(pID);
		}//F.I.B
		case 2:{
		    SetPlayerPosEx(pID,1507.6348,-1653.5775,19.2359);
	    	SetPlayerFacingAngle(pID,78.9629);
			SetPlayerCameraPos(pID, 1498.8345, -1650.1194, 19.9979);
			SetPlayerCameraLookAt(pID, 1499.7462, -1650.5413, 19.8880);
			SetPlayerInterior(pID,0);
		  	Spieler[pID][ImInvite] = 1;
		    BincoSystem(pID);
		}//FeuerWehr/MEdic
		case 3:{
		    SetPlayerPosEx(pID,1701.2112,-1149.6174,23.8652);
	    	SetPlayerFacingAngle(pID,149.0019);
			SetPlayerCameraPos(pID, 1693.8503, -1156.4280, 27.0899);
			SetPlayerCameraLookAt(pID, 1694.5499, -1155.7067, 26.7499);
			SetPlayerInterior(pID,0);
		  	Spieler[pID][ImInvite] = 1;
		    BincoSystem(pID);
		}//Präsident
		case 16:{
		    SetPlayerPosEx(pID,1178.2493,-2037.2023,69.0078);
	    	SetPlayerFacingAngle(pID,270.6934);
			SetPlayerCameraPos(pID, 1186.3784, -2036.8231, 70.5737);
			SetPlayerCameraLookAt(pID, 1185.3734, -2036.8159, 70.4088);
			SetPlayerInterior(pID,0);
		  	Spieler[pID][ImInvite] = 1;
		    BincoSystem(pID);
		}//GroveStreet
		case 14:{
			SetPlayerPosEx(pID,1178.2493,-2037.2023,69.0078);
			SetPlayerFacingAngle(pID,270.6934);
			SetPlayerCameraPos(pID, 2050.9285, -1904.9465, 14.9587);
			SetPlayerCameraLookAt(pID, 2050.9229, -1903.9420, 14.7287);
			SetPlayerInterior(pID,0);
		  	Spieler[pID][ImInvite] = 1;
		    BincoSystem(pID);
		}//Fahrschule
		case 5:{
		    SetPlayerPosEx(pID,2442.4031,-1647.7460,28.5842);
	    	SetPlayerFacingAngle(pID,75.8783);
			SetPlayerCameraPos(pID, 2434.1042, -1644.4716, 31.2286);
			SetPlayerCameraLookAt(pID, 2435.0432, -1644.8346, 30.8336);
			SetPlayerInterior(pID,0);
		  	Spieler[pID][ImInvite] = 1;
		    BincoSystem(pID);
		}//FallsSystemNichtFertig
		default:{
			SetPlayerPosEx(pID,182.4923,-87.8844,1002.0234);
			SetPlayerCameraPos(pID,177.9503,-88.1474,1001.8047);
			SetPlayerCameraLookAt(pID,182.6175,-88.1204,1002.0234);
			SetPlayerFacingAngle(pID,89.0834);
			SetPlayerInterior(pID,18);
			Spieler[pID][ImInvite] = 1;
			BincoSystem(pID);
		}
	}
	return 1;
}
COMMAND:adminc(playerid,const params[])
{
	#pragma unused params
	if(Spieler[playerid][pAdmin]>=1)
	{
		if(Spieler[playerid][pAdminOnduty] == false)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Admindienst.");
		ShowPlayerAdminControlPanel(playerid);
	}else{SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Admin!");}
	return 1;
}
COMMAND:savedbbase(playerid,const params[])
{
	#pragma unused params
	if(Spieler[playerid][pAdmin]>=2){
		format(SP_INFO,sizeof(SP_INFO),""IINFO" Spieler: "IINFO2"%s"#HTML_WEISS" hat die Datenbank gespeichert.",SpielerName(playerid));
		SendAdminMessage(WEISS,SP_INFO);
		DB_SAVE();
	}
	else SCM(playerid,SAMP_WEISS,""IINFO" du besitzt nicht die Rechte dazu!");
	return 1;
}
