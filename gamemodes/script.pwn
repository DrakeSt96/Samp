}
stock HideEuro(playerid)
{
	PlayerTextDrawDestroy(playerid,EURO_TD[playerid][0]);
	PlayerTextDrawDestroy(playerid,EURO_TD[playerid][1]);
	PlayerTextDrawDestroy(playerid,EURO_TD[playerid][2]);
}
