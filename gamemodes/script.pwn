stock AgeOfPlayer(playerid)
{
	new yearold = gettime() - Spieler[playerid][pYearsOld];
	return floatround(yearold/31536000);//ein jahr in sekunden :) 31536000 Sekunden
}
stock Float:GetDistanceBetweenPoints(Float:x1,Float:y1,Float:z1,Float:x2,Float:y2,Float:z2)
{
	return floatadd(floatadd(floatsqroot(floatpower(floatsub(x1,x2),2)),floatsqroot(floatpower(floatsub(y1,y2),2))),floatsqroot(floatpower(floatsub(z1,z2),2)));
}

stock SpawnPlayerEx(playerid)
{
    if(!IsPlayerConnected(playerid))return 0;
	if(IsPlayerInAnyVehicle(playerid)) RemovePlayerFromVehicle(playerid);
	ClearAnimations(playerid);
	SpawnPlayer(playerid);
	return 1;
}
stock PutPlayerInVehicleEx(playerid,vehicleid,seatid)
{
	if(!IsPlayerConnected(playerid))return 0;
	if(!IsValidVehicle(vehicleid))return 0;
	Spieler[playerid][pAntiVehicleEnter] = gettime() + 3;
	Spieler[playerid][pAntiVehicleEnterVehicleID] = vehicleid;
	PutPlayerInVehicle(playerid,vehicleid,seatid);
	SetPlayerArmedWeapon(playerid,WEAPON_FIST);
	return 1;
}
stock SetACMoney(playerid,money)
{
	if(!IsPlayerConnected(playerid))return 0;
 	ResetPlayerMoney(playerid);
 	Spieler[playerid][pCash] = money;
	//GivePlayerMoney(playerid,Spieler[playerid][pCash]);
	new test123[350];
	format(test123,sizeof(test123),"%d Euro",Spieler[playerid][pCash]);
	PlayerTextDrawSetString(playerid,EURO_TD[playerid][2],test123);
	return 1;
}
stock ACMoney(playerid,money)
{
	if(!IsPlayerConnected(playerid))return 0;
	Spieler[playerid][pCash] = Spieler[playerid][pCash]+money;
	if(Spieler[playerid][pCash] < 0)Spieler[playerid][pCash] = 0;
    //GivePlayerMoney(playerid,money);
   	new test123[350];
	format(test123,sizeof(test123),"%d Euro",Spieler[playerid][pCash]);
	PlayerTextDrawSetString(playerid,EURO_TD[playerid][2],test123);
	return 1;
}
stock GetACMoney(playerid) return Spieler[playerid][pCash];

stock SetPlayerLevel(playerid,level)
{
    if(!IsPlayerConnected(playerid))return 0;
    if((Spieler[playerid][pRespektFromPayday] - Spieler[playerid][pRespektToLevelUp]) < 0)
    {
		Spieler[playerid][pRespektFromPayday] = 0;
	}
	else Spieler[playerid][pRespektFromPayday] -= Spieler[playerid][pRespektToLevelUp];
	SetPlayerScore(playerid,level);
	Spieler[playerid][pLevel] = level;
	Spieler[playerid][pRespektToLevelUp] = (RESPEKTPROLEVELUP*Spieler[playerid][pLevel]);
    Spieler[playerid][pLevelKosten] = (LEVELCOSTPROLEVELUP*Spieler[playerid][pLevel]);
	return 1;
}
stock GetPlayerLevel(playerid) return Spieler[playerid][pLevel];

stock SetSpawnInfoEx(playerid,team,skinid,Float:x,Float:y,Float:z,Float:angle,weap1,ammo1,weap2,ammo2,weap3,ammo3)
{
    if(!IsPlayerConnected(playerid))return 0;
    Spieler[playerid][CurrentPos][0] = x;
	Spieler[playerid][CurrentPos][1] = y;
	Spieler[playerid][CurrentPos][2] = z;
	return SetSpawnInfo(playerid,team,skinid,x,y,z,angle,WEAPON:weap1,ammo1,WEAPON:weap2,ammo2,WEAPON:weap3,ammo3);
}

stock SetPlayerPosEx(playerid,Float:x,Float:y,Float:z)
{
    if(!IsPlayerConnected(playerid))return 0;
    if(SetPlayerPos(playerid,x,y,z))
    {
    Spieler[playerid][CurrentPos][0] = x;
	Spieler[playerid][CurrentPos][1] = y;
	Spieler[playerid][CurrentPos][2] = z;
    }
    return 1;
}

stock SetPlayerPosFindZEx(playerid,Float:x,Float:y,Float:z)
{
    if(!IsPlayerConnected(playerid))return 0;
    if(SetPlayerPosFindZ(playerid,x,y,z))
    {
    Spieler[playerid][CurrentPos][0] = x;
	Spieler[playerid][CurrentPos][1] = y;
	Spieler[playerid][CurrentPos][2] = z;
    }
    return 1;
}

stock GetPlayerSpeed(playerid)
{
	new Float:SpeedVel[3],Float:Speeddistance,Speed;
	if(!IsPlayerConnected(playerid))return 0;
    GetPlayerVelocity(playerid,SpeedVel[0],SpeedVel[1],SpeedVel[2]);
	Speeddistance = floatsqroot(((SpeedVel[0]*SpeedVel[0])+(SpeedVel[1]*SpeedVel[1]))+(SpeedVel[2]*SpeedVel[2]))*144;
	Speed = floatround(Speeddistance,floatround_round);
	return Speed;
}

stock GetVehicleSpeed(vehicleid)
{
	new Float:SpeedVel[3],Float:Speeddistance,Speed;
	if(!IsValidVehicle(vehicleid))return 1;
	GetVehicleVelocity(vehicleid,SpeedVel[0],SpeedVel[1],SpeedVel[2]);
	Speeddistance = floatsqroot(((SpeedVel[0]*SpeedVel[0])+(SpeedVel[1]*SpeedVel[1]))+(SpeedVel[2]*SpeedVel[2]))*144;
	Speed = floatround(Speeddistance,floatround_round);
	return Speed;
}

stock SetVehiclePosEx(vehicleid,Float:x,Float:y,Float:z)
{
	if(!IsValidVehicle(vehicleid))return 1;
	if(SetVehiclePos(vehicleid,x,y,z))
	{
	    vFahrzeug[vehicleid][Xs] = x;
		vFahrzeug[vehicleid][Ys] = y;
		vFahrzeug[vehicleid][Zs] = z;
		vFahrzeug[vehicleid][OldVehPos][0] = x;
		vFahrzeug[vehicleid][OldVehPos][1] = y;
		vFahrzeug[vehicleid][OldVehPos][2] = z;
		ForEachPlayer(i)
		{
			if(IsPlayerConnected(i) && !IsPlayerNPC(i) && IsPlayerInVehicle(i,vehicleid))
			{
			    Spieler[i][CurrentPos][0] = x;
				Spieler[i][CurrentPos][1] = y;
				Spieler[i][CurrentPos][2] = z;
			}
		}
	}
	return 1;
}

stock SetVehicleZAngleEx(vehicleid,Float:anglevehpos)
{
	if(!IsValidVehicle(vehicleid))return 1;
	SetVehicleZAngle(vehicleid,anglevehpos);
	vFahrzeug[vehicleid][OldVehPos][3] = anglevehpos;
	return 1;
}

stock IsWheelModel(model)
{
	new wheelmodels[17] = {1025,1073,1074,1075,1076,1077,1078,1079,1080,1081,1082,1083,1084,1085,1096,1097,1098};
	for(new i=0;i<sizeof(wheelmodels);i++)
	{
		if(model == wheelmodels[i])
		return 1;
	}
	return 0;
}

stock IllegalCarNitroIde(model)
{

	new illegalvehs[29] = {581,523,462,521,463,522,461,448,468,586,509,481,510,472,473,493,595,484,430,453,452,446,454,590,569,537,538,570,449};
	for(new i=0;i<sizeof(illegalvehs);i++)
	{
		if(model == illegalvehs[i])
		return 1;
	}
	return 0;
}

stock IllegalNitroVehicle(vehicleid)
{
	if(!IsVliadVehicle(vehcleid))return 0;
	return IllegalCarNitroIde(GetVehicleModel(vehicleid));
}

stock IsLegalVehicleiMod(vehicleide,componentid)
{
	new bool:modul = false;
	if((IsWheelModel(componentid)) || (componentid == 1086) || (componentid == 1087) || ((componentid >= 1008) && (componentid <= 1010)))
	{
		new nosblocker = IllegalCarNitroIde(vehicleide);
		if(!nosblocker) modul = true;
	}
	else
	{
	    for(new i=0;i<sizeof(LegalVehicleMods);i++)
		{
			if(LegalVehicleMods[i][0] == vehicleide)
			{
				for(new c=1;c<22;c++) if(LegalVehicleMods[i][c] == componentid) modul = true;
			}
		}
	}
	return modul;
}

