				    case 13:{Spieler[playerid][pDuty] = 0;}
				    case 14:{Spieler[playerid][pDuty] = 1;}
				    case 15:{Spieler[playerid][pDuty] = 1;}
				    case 16:{Spieler[playerid][pDuty] = 1;}
