stock countMoebelObjekte(playerid)
{
    if(Spieler[playerid][pSelectHome]==0)return SCM(playerid,SAMP_WEISS,"kein Haus für deinen Spawn ausgewählt.");
    new count;
    for(new hobj=0;hobj<MAX_HAUSOBJECTS;hobj++)
	{
	    if(HausmoebelInfo[hobj][hmhaus_dbid] == Spieler[playerid][pSelectHome] && HausmoebelInfo[hobj][hmmodelid] != 0)
		{
            count++;
		}
	}
	return count;
}
forward EditObjectTimer(playerid);
public EditObjectTimer(playerid)
{
    EditDynamicObject(playerid,Spieler[playerid][pMoebelID]);
    return 1;
}
stock MoneyString(money)
{
	new bmess[15];
	format(bmess, sizeof(bmess), "%d", money);
	if(money > 0)
	{
		for(new l=strlen(bmess)-3; l>0; l-=3)
		{
			if(l>0)
			{
				strins(bmess, ".", l);
			}
		}
	}
	else
	{
		for(new z=strlen(bmess)-3; z>1; z-=3)
		{
			if(z>1)
			{
				strins(bmess, ".", z);
			}
		}
	}
	return bmess;
}
forward Float:GetXYInFrontOf(&Float:a, &Float:x, &Float:y, Float:distanc);
Float:GetXYInFrontOf(&Float:a, &Float:x, &Float:y, Float:distanc)
{
	x += (distanc * floatsin(-a, degrees));
	y += (distanc * floatcos(-a, degrees));
	return a;
}
forward Float:GiveRotation(&Float:a, Float:ap);
Float:GiveRotation(&Float:a,Float:ap)
{
	a+=ap;
	if(a <0){a=360-(a*-1);}
	if(a >360){a=0+(a-360);}
	return a;
}
stock ReturnHausID(playerid)
{
	for(new haus=1;haus<MAX_HAUS;haus++)
	{
		if(HausInfo[haus][hauscreatet] != 0)
		{
			if(HausInfo[haus][dbhaus_id] == Spieler[playerid][pSelectHome])return haus;
		}
	}
	return printf("Funktion ReturnHausID Fehler!");
}
forward LoadHausmoebel();
public LoadHausmoebel()
{
	new result[650],rows,fields;
	cache_get_data(rows,fields);
	new hmobjID = 0;
	if(rows)
	{
	    while(hmobjID<rows)
		{
            cache_get_field_content(hmobjID,"moebel_name",result);
            format(HausmoebelInfo[hmobjID][hmmoebel_name],64,"%s",result);
            strdel(result,0,sizeof(result));
            cache_get_field_content(hmobjID,"id",result);
	        HausmoebelInfo[hmobjID][hmdb_id] = strval(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"haus_dbid",result);
	        HausmoebelInfo[hmobjID][hmhaus_dbid] = strval(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"modelid",result);
	        HausmoebelInfo[hmobjID][hmmodelid] = strval(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"hmmodelpreis",result);
	        HausmoebelInfo[hmobjID][hmmodelpreis] = strval(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"hm_x",result);
	        HausmoebelInfo[hmobjID][hm_x] = floatstr(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"hm_y",result);
	        HausmoebelInfo[hmobjID][hm_y] = floatstr(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"hm_z",result);
	        HausmoebelInfo[hmobjID][hm_z] = floatstr(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"hm_rx",result);
	        HausmoebelInfo[hmobjID][hm_rx] = floatstr(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"hm_ry",result);
	        HausmoebelInfo[hmobjID][hm_ry] = floatstr(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"hm_rz",result);
	        HausmoebelInfo[hmobjID][hm_rz] = floatstr(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"vworld",result);
	        HausmoebelInfo[hmobjID][hm_vworld] = strval(result);
	        strdel(result,0,sizeof(result));
	        cache_get_field_content(hmobjID,"interior",result);
	        HausmoebelInfo[hmobjID][hm_int] = strval(result);
	        strdel(result,0,sizeof(result));
	        HausmoebelInfo[hmobjID][hmobjectid] = CreateDynamicObject(HausmoebelInfo[hmobjID][hmmodelid],HausmoebelInfo[hmobjID][hm_x],HausmoebelInfo[hmobjID][hm_y],HausmoebelInfo[hmobjID][hm_z],
			HausmoebelInfo[hmobjID][hm_rx],HausmoebelInfo[hmobjID][hm_ry],HausmoebelInfo[hmobjID][hm_rz],HausmoebelInfo[hmobjID][hm_vworld],HausmoebelInfo[hmobjID][hm_int]);
	        hmobjID++;
		}
	}
	return 1;
}
forward CheckSpielerExists(playerid,const namestring[]);
forward ShowFreundeListe(playerid);
forward DelFreundInListe(playerid,listitem);
forward OnFreundeListeSave(playerid,const name[]);
forward OnFreundeListeLoad(playerid,const name[]);
forward AddFriendList(playerid,const namestring[]);
public OnFreundeListeLoad(playerid,const name[])
{
    new count=0,rows,fields,string[128],query[94],result[MAX_PLAYER_NAME];
	cache_get_data(rows,fields,MySQL_R394);
	if(rows)
	{
        format(string,sizeof(string),"Freundeliste:{FAFAFA} %s ist nun {009F00}Online{FAFAFA}.",name);
        while(count<rows)
        {
            if(count>=rows){ break; }
            cache_get_field_content(count,"username",result);
            new pID = GetPlayerID(result);
            if(pID != -1)
			{
				SendClientMessage(pID,0xFF9C00FF,string);
			}
			count++;
        }
		mysql_format(MySQL_R394,query,sizeof(query),"UPDATE spieler_freund SET online='1' WHERE freundname='%s'",name);
		mysql_function_query(MySQL_R394,query,false,"","");
		return 1;
	}
	return 1;
}
public OnFreundeListeSave(playerid,const name[])
{
    new count=0,rows,fields,string[128],query[94],result[MAX_PLAYER_NAME];
	cache_get_data(rows,fields,MySQL_R394);
	if(rows)
    {
    	format(string,sizeof(string),"Freundeliste:{FAFAFA} %s ist nun {C70A00}Offline{FAFAFA}.",name);
        while(count<rows)
        {
            if(count>=rows){ break; }
            cache_get_field_content(count,"username",result);
			new pID = GetPlayerID(result);
            if(pID != -1)
			{
				SendClientMessage(pID,0xFF9C00FF,string);
			}
			count++;
        }
		mysql_format(MySQL_R394,query,sizeof(query),"UPDATE spieler_freund SET online='0' WHERE freundname='%s'",name);
		mysql_function_query(MySQL_R394,query,false,"","");
		return 1;
	}
	return 1;
}
#define MAX_FREE_FRIENDS 10
public AddFriendList(playerid,const namestring[])
{
	new count=0,rows,fields,string[128],query[128],connected,result[MAX_PLAYER_NAME];
	cache_get_data(rows,fields);
	getdate(jahr,monat,tag);
	if(rows)
	{
	    if(rows>=MAX_FREE_FRIENDS)return SendClientMessage(playerid,SAMP_WEISS,"Du kannst nur maximal "#MAX_FREE_FRIENDS" Freunde eintragen!");
		while(count<rows)
		{
		    cache_get_field_content(count,"freundname",result);
		    if(strcmp(result,namestring,true)==0)
			{
              format(string,sizeof(string),"{C9C9C9}Der angegebene Spieler ({C70A00}%s{C9C9C9}) ist bereits auf deiner Freundeliste!\n",namestring);
	          return ShowPlayerDialog(playerid,DIALOG_SONSTIGES,DIALOG_STYLE_MSGBOX,"Freundeliste",string,"Schließen","");
			}
		    count++;
		    if(count>=rows)
		    {
				 if(GetPlayerID(namestring)!=-1){ connected=1; }else{ connected=0; }
				 mysql_format(MySQL_R394,query,sizeof(query),"INSERT INTO spieler_freund (username,freundname,online,datum) VALUES ('%s','%s','%d','%02d.%02d.%04d')",
				 SpielerName(playerid),namestring,connected,tag,monat,jahr);
				 mysql_function_query(MySQL_R394,query,false,"","");
				 format(string,sizeof(string),"Freundeliste:{FAFAFA} Du hast den Spieler {C70A00}%s{FAFAFA} in deine Freundeliste eingetragen!",namestring);
                 SendClientMessage(playerid,0xFF9C00FF,string);
				 new pID = GetPlayerID(namestring);
				 if(pID != -1)
				 {
				     format(string,sizeof(string),"Freundeliste:{FAFAFA} %s hat dich in seine Freundeliste eingetragen!",SpielerName(playerid));
				     SendClientMessage(pID,0xFF9C00FF,string);
				 }
				 return 1;
			}
		}
	}
	if(GetPlayerID(namestring)!=-1){ connected=1; }else{ connected=0; }
	mysql_format(MySQL_R394,query,sizeof(query),"INSERT INTO spieler_freund (username,freundname,online,datum) VALUES ('%s','%s','%d','%d.%d.%d')",
	SpielerName(playerid),namestring,connected,tag,monat,jahr);
	mysql_function_query(MySQL_R394,query,false,"","");
	format(string,sizeof(string),"Freundeliste:{FAFAFA} Du hast den Spieler {C70A00}%s{FAFAFA} in deine Freundeliste eingetragen!",namestring);
    SendClientMessage(playerid,0xFF9C00FF,string);
	new pID = GetPlayerID(namestring);
	if(pID != -1)
	{
        format(string,sizeof(string),"Freundeliste:{FAFAFA} %s hat dich in seine Freundeliste eingetragen!",SpielerName(playerid));
		SendClientMessage(pID,0xFF9C00FF,string);
	}
	return 1;
}
public ShowFreundeListe(playerid)
{
    new count = 0,rows,fields,string[1128],datum[12],result[MAX_PLAYER_NAME];
    cache_get_data(rows,fields,MySQL_R394);
    if(rows)
	{
	    while(count<rows)
		{
		    cache_get_field_content(count,"freundname",result);
		    cache_get_field_content(count,"datum",datum);
		    if(GetPlayerID(result)!=-1){ format(string,sizeof(string),"%s\n{009F00}%s{FAFAFA} - Befreundet seit %s",string,result,datum); }
		    else { format(string,sizeof(string),"%s\n{C70A00}%s{FAFAFA} - Befreundet seit %s",string,result,datum); }
		    count++;
		}
        return ShowPlayerDialog(playerid,DIALOG_FRIEND_LIST,DIALOG_STYLE_LIST,"Freundeliste",string,"Auswählen","Schließen");
	}
    return ShowPlayerDialog(playerid,DIALOG_SONSTIGES,DIALOG_STYLE_LIST,"{FFFFFF}Freundeliste","{009F00}- Freundeliste ist leer -","Schließen","");
}
public DelFreundInListe(playerid,listitem)
{
    new count = 0,rows,fields,string[128],query[128],result[MAX_PLAYER_NAME];
    cache_get_data(rows,fields,MySQL_R394);
    if(rows)
	{
	    while(count<rows)
		{
		    cache_get_field_content(count,"freundname",result);
		    if(count==listitem)
		    {
				new pID = GetPlayerID(result);
		        if(pID!=-1)
			    {
				   format(string,sizeof(string),"Freundeliste:{FAFAFA} {C70A00}%s{FAFAFA} hat dich aus seiner Freundeliste entfernt!",SpielerName(playerid));
				   SendClientMessage(pID,0xFF9C00FF,string);
				   format(string,sizeof(string),"Freundeliste:{FAFAFA} {C70A00}%s{FAFAFA} wurde aus deiner Freundeliste entfernt!",result);
				   SendClientMessage(playerid,0xFF9C00FF,string);
				   mysql_format(MySQL_R394,query,sizeof(query),"DELETE FROM spieler_freund WHERE freundname='%s'",result);
	               mysql_function_query(MySQL_R394,query,false,"","");
				   return 1;
			    }
			    mysql_format(MySQL_R394,query,sizeof(query),"DELETE FROM spieler_freund WHERE freundname='%s'",result);
	            mysql_function_query(MySQL_R394,query,false,"","");
	            format(string,sizeof(string),"Freundeliste:{FAFAFA} {C70A00}%s{FAFAFA} wurde aus deiner Freundeliste entfernt!",result);
				SendClientMessage(playerid,0xFF9C00FF,string);
	            return 1;
			}
		    count++;
		}
	}
    return 1;
}
public CheckSpielerExists(playerid,const namestring[])
{
	new rows,fields,query[124],string[125],usrname[MAX_PLAYER_NAME];
    cache_get_data(rows,fields);
	if(rows)
	{
		cache_get_field_content(0,"Name",usrname);
		mysql_format(MySQL_R394,query,sizeof(query),"SELECT * FROM spieler_freund WHERE Name='%s'",SpielerName(playerid));
		mysql_function_query(MySQL_R394,query,true,"AddFriendList","is",playerid,usrname);
	}
	else
	{
	   format(string,sizeof(string),"{C9C9C9}Der angegebene Spieler ({C70A00}%s{C9C9C9}) wurde nicht gefunden!\n",namestring);
	   //ShowPlayerDialog(playerid,DIALOG_SONSTIGES,DIALOG_STYLE_MSGBOX,"Freundeliste",string,"Schließen","");
	   SCM(playerid,SAMP_WEISS,namestring);
	}
	return 1;
}
forward GetPremiums(playerid);
public GetPremiums(playerid)
{
	new string[950],adminrang2,name[MAX_PLAYER_NAME],online2,OnlineString[950];
	new rows = cache_num_rows();
	for(new i=0;i<rows;i++)
	{
		adminrang2 = cache_get_field_content_int(i,"pPremium");
		cache_get_field_content(i,"Name",name,MySQL_R394,MAX_PLAYER_NAME);
		if(adminrang2>=2)
		{
			online2 = cache_get_field_content_int(i,"Online");
			if(online2 == 0)OnlineString=""HTML_ROT"Offline";
			else if(online2 == 1)OnlineString=""HTML_GRUEN"Online";
			format(string, sizeof(string),""#HTML_WEISS"%s Name: "IINFO2"%s"#HTML_WEISS" Status: %s"#HTML_WEISS"\n",string,name,OnlineString);
  		}
	}
	ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Premium - Spieler",string,"Okay","");
	return 1;
}
forward GetAdmins(playerid);
public GetAdmins(playerid)
{
	new string[950],adminrang2,name[MAX_PLAYER_NAME],online2,OnlineString[950];
	new rows = cache_num_rows();
	for(new i=0;i<rows;i++)
	{
		adminrang2 = cache_get_field_content_int(i,"Admin");
		cache_get_field_content(i,"Name",name,MySQL_R394,MAX_PLAYER_NAME);
		if(adminrang2 > 0 && adminrang2 < 9)
		{
			online2 = cache_get_field_content_int(i,"Online");
			if(online2 == 0)OnlineString=""HTML_ROT"Offline";
			else if(online2 == 1)OnlineString=""HTML_GRUEN"Online";
			format(string, sizeof(string),""#HTML_WEISS"%sAdminrang: "IINFO2"%s"#HTML_WEISS" Name: "IINFO2"%s"#HTML_WEISS" Status: %s"#HTML_WEISS"\n",string,GetAdminName(adminrang2),name,OnlineString);
		}
	}
	ShowPlayerDialog(playerid,DIALOG_ADMINLIST,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Unser Team von "IINFO2"Invincible - Life",string,"Schließen","");
	return 1;
}
