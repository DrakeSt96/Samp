	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[612],count;
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
    for(new p=1;p<MAX_PARTEI;p++)
	{
		if(PartInfo[p][ParteiCreatet] != 0)
		{
			format(string,sizeof(string),"%i. %s : Motto: %s,Gründer: %s\n%s",p,PartInfo[p][ParteiName],PartInfo[p][ParteiMotto],PartInfo[p][ParteiOwner],string);
		    ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Parteien",string,"Verlassen","");
			count++;
		}
	}
	if(count == 0)return SCM(playerid,SAMP_WEISS,"Es wurden keine Parteien erstellt.");
	return 1;
}
COMMAND:organisationen_2(playerid,const params[])
{
	#pragma unused params
    if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[9500],count;
	//if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
    for(new org=1;org<MAX_ORGANISATIONS;org++)
	{
		if(OrgInfo[org][OrgCreatet] != 0)
		{
			//format(string,sizeof(string),"%i. %s : Motto: %s,Gründer: %s\n%s",org,OrgInfo[org][OrgName],OrgInfo[org][OrgMotto],OrgInfo[org][OrgOwner],string);
		    //ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Firmen",string,"Verlassen","");
		    format(string,sizeof(string),""#HTML_WEISS" Firma: "IINFO2"%s"#HTML_WEISS" Beschreibung: "IINFO2"%s"#HTML_WEISS" Unternehmer: "IINFO2"%s\n%s",
			OrgInfo[org][OrgName],OrgInfo[org][OrgMotto],OrgInfo[org][OrgOwner],string);
			ShowPlayerDialog(playerid,DIALOG_REQUIRE,DIALOG_STYLE_MSGBOX,""ClanTagDialoge" Unternehmen",string,"Okay","");
			count++;
		}
	}
	if(count == 0)return SCM(playerid,SAMP_WEISS,""IINFO2" es wurden keine Firmen erstellt.");
	return 1;
}
COMMAND:aorginvite(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],org;
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	if(sscanf(params,"ui",pID,org))return SCM(playerid,SAMP_WEISS,""IINFO" /aorginvite [playerid/Name][Unternehmen]");
	if(org < 1 || org >= MAX_ORGANISATIONS || OrgInfo[org][OrgCreatet] != 1)return SCM(playerid,SAMP_WEISS,"Die von dir angegebene Organisation existiert nicht.(/organisationen)");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pOrgMember] != org)return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Organisation Mitglied.");
	format(string,sizeof(string),""ACINFO" %s (ID:%i) hat dir eine Einladung in die Organisation "IINFO2"%s"#HTML_WEISS" gesendet.(/accept orginvite)",SpielerName(playerid),playerid,OrgInfo[org][OrgName]);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""ACINFO" Du hast %s (ID:%i) eine Einladung in deine Organisation gesendet.",SpielerName(pID),pID);
	SCM(playerid,SAMP_WEISS,string);
	Spieler[pID][pSeller] = playerid;
	Spieler[pID][pAngebot] = 18;
	Spieler[pID][pMenge] = org;
	return 1;
}
