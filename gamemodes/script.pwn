						SCM(playerid,WEISS,"{A91400}SERVER{FFFFFF}: Du hast als Weihnachtsgeschenk 6 Respektpunkte erhalten.");
					}
					case 1:
					{
						Spieler[playerid][pStartbonus] = 1;
						ACMoney(playerid,10000);
						SCM(playerid,WEISS,"{A91400}SERVER{FFFFFF}: Du hast als Weihnachtsgeschenk 10.000$ erhalten.");
					}
					case 2:
					{
						Spieler[playerid][pStartbonus] = 1;
						new time = Spieler[playerid][pPremium]-gettime();
			         	if(floatround(time/86400) >= 1)
						{
						    new days = floatround(time/86400) + 7;
						    Spieler[playerid][pPremium] = (Spieler[playerid][pPremium]+(gettime() + (60*60*24*days)));
						}
						else
						{
			 				Spieler[playerid][pPremium] = (Spieler[playerid][pPremium]+(gettime() + (60*60*24*7)));
						}
						SCM(playerid,WEISS,"{A91400}SERVER{FFFFFF}: Du hast als Weihnachtsgeschenk eine Woche Donator Status erhalten.");
						SCM(playerid,WEISS,"{00F0FF}* Was du mit dem Donator Status für Vorteile hast steht in der Allgemeinen Hilfe (/hilfe) *");
					}
			    }
			    return 1;
		    }
