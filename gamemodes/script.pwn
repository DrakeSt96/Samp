COMMAND:beamte(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	new string[2000],onlinemembers = 0;
    if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2) || isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,16))
	{
	    ForEachPlayer(i)
	    {
			if(IsPlayerConnected(i) && !IsPlayerNPC(i))
			{
				if(GetPVarInt(i,"Eingeloggt") == 1)
				{
					if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,3) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,16))
					{
						format(string,sizeof(string),"%s %s : %s (Rang:%i)\n%s",FraktionsName(Spieler[i][pFraktion]),SpielerFraktionsRangName(i),SpielerName(i),Spieler[i][pFraktRang],string);
						ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_LIST,""ClanTagDialoge" Staat",string,"Verlassen","");
						onlinemembers++;
					}
				}
			}
		}
		if(onlinemembers == 0)return SCM(playerid,SAMP_WEISS,"Kein Fraktionsmitglied Online.");
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:d(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new text[91],stringdep[128],fv = IsAFraktionsVeh(playerid);
	if(isPlayerInFrakt(playerid,1) || isPlayerInFrakt(playerid,2)|| isPlayerInFrakt(playerid,3) || isPlayerInFrakt(playerid,6) || isPlayerInFrakt(playerid,11) || isPlayerInFrakt(playerid,16))
	{
		if(Spieler[playerid][pDuty] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht im Dienst.");
		if(Spieler[playerid][pFunkgeraet] != 0 || fv != -1 && Fahrzeug[fv][Fraktion] == Spieler[playerid][pFraktion])
		{
			if(Spieler[playerid][pMuted] == 1)
			{
			    format(stringdep,sizeof(stringdep),""IINFO" du bist noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten gemuted.",floatround(Spieler[playerid][pMuteTime]/60),floatround(Spieler[playerid][pMuteTime]%60));
				return SCM(playerid,WEISS,stringdep);
			}
			if(sscanf(params,"s[91]",text))return SCM(playerid,SAMP_WEISS,""IINFO" /d(epartment) [Text]");
			if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""IINFO" /d(epartment) [Text darf maximal 90 Zeichen beinhalten]");
			for(new b=0;b<sizeof(BadWord);b++)
			{
				if(strfind(text,BadWord[b],true) != -1)
			  	{
				  	format(stringdep,sizeof(stringdep),""ACINFO" das System hat den Spieler "IINFO2"%s"#HTML_WEISS" für 15 Minuten gemutet. Grund: Beleidigung",Spieler[playerid][pName]);
				   	SendClientMessageToAll(SAMP_WEISS,stringdep);
					format(stringdep,sizeof(stringdep),"Beleidigung: %s | %s | Art: /d(epartmentschat)",BadWord[b],text);
					SendAdminMessage(SAMP_WEISS,stringdep);
				    Spieler[playerid][pMuteTime] += 15*60;
					Spieler[playerid][pMuted] = 1;
					return 1;
			    }
			}
			new strpos = strfind(text,"www",true);
			if(strfind(text,".",true) != -1 && strfind(text,":",true) != -1 && strlen(text) > 8 && strfind(text,TSIP,false) == -1)
			{
				strdel(text,strpos,strfind(text,".",true) && strfind(text,":",true));
				return 1;
			}
			format(stringdep,sizeof(stringdep),"**(( Funk %s %s : %s ))**",SpielerFraktionsRangName(playerid),SpielerName(playerid),text);
			ForEachPlayer(i)
			{
				if(IsPlayerConnected(i))
				{
					if(GetPVarInt(i,"Eingeloggt") == 1)
					{
						if(isPlayerInFrakt(i,1) || isPlayerInFrakt(i,2) || isPlayerInFrakt(i,3) || isPlayerInFrakt(i,6) || isPlayerInFrakt(i,11) || isPlayerInFrakt(i,16))
						{
							if(Spieler[i][pDuty] != 0)
							{
							    if(Spieler[i][pFunkgeraet] == 1 || (IsAFraktionsVeh(i) != -1 && Fahrzeug[IsAFraktionsVeh(i)][Fraktion] == Spieler[i][pFraktion]) || FraktionsAktenPCs(i))
								{
									SCM(i,DEPARTMENTSCOLOR,stringdep);
								}
							}
						}
						if(Spieler[i][IreadALL] == 1)
						{
							SCM(i,SAMP_WEISS,stringdep);
						}
					}
				}
			}
			format(stringdep,sizeof(stringdep),"%s %s: %s",SpielerFraktionsRangName(playerid),Spieler[playerid][pName],text);
		 	Log("Departments-Chatsqllog",stringdep);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,"Kein Funkgerät/Du sitzt in keinem Fraktionsfahrzeug.");
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
}

COMMAND:ex(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
