				SetPlayerCameraPos(playerid,177.9503,-88.1474,1001.8047);
				SetPlayerCameraLookAt(playerid,182.6175,-88.1204,1002.0234);
				SetPlayerFacingAngle(playerid,89.0834);
				SetPlayerInterior(playerid,18);
