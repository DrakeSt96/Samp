		}
		if(strcmp(cmd,"Nebel",true) == 0)
		{
			KillTimer(WeatherTimer);
			WeatherTimer = SetTimer("WeatherChange",60000*ChangeweatherinMin,true);
			UseBadWeather[2] = 9;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) ändert die Wetterverhältnisse in Las Venturas auf nebelig.",Spieler[playerid][pName],playerid);
			SendAdminMessage(GRUEN,string);
			SendClientMessageToAll(ORANGE,""#HTML_BLAU"Wetter Station"#HTML_WEISS": Es liegt eine Wetteränderung in ganz San Andreas vor.");
			return 1;
		}
		if(strcmp(cmd,"Schnee",true) == 0)
		{
			if(monat < 10 && monat > 1)return SCM(playerid,SAMP_WEISS,"Es ist noch Sommerzeit.");
			KillTimer(WeatherTimer);
			WeatherTimer = SetTimer("WeatherChange",60000*ChangeweatherinMin,true);
			UseBadWeather[2] = 8;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) ändert die Wetterverhältnisse in Las Venturas auf Schnee.",Spieler[playerid][pName],playerid);
			SendAdminMessage(GRUEN,string);
			SendClientMessageToAll(ORANGE,""#HTML_BLAU"Wetter Station"#HTML_WEISS": Es liegt eine Wetteränderung in ganz San Andreas vor.");
			return 1;
		}
		if(strcmp(cmd,"Zufall",true) == 0)
		{
			KillTimer(WeatherTimer);
			WeatherTimer = SetTimer("WeatherChange",60000*ChangeweatherinMin,true);
			UseBadWeather[2] = BadWeather[random(sizeof(BadWeather))];
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) ändert die Wetterverhältnisse in Las Venturas auf zufällige weise.",Spieler[playerid][pName],playerid);
			SendAdminMessage(GRUEN,string);
			SendClientMessageToAll(ORANGE,""#HTML_BLAU"Wetter Station"#HTML_WEISS": Es liegt eine Wetteränderung in ganz San Andreas vor.");
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""#IINFO" /setweather [Normal/Regen/Sturm/Nebel/Schnee/Zufall][LV]");
	}
	return SCM(playerid,SAMP_WEISS,""#IINFO" /setweather [Normal/Regen/Sturm/Nebel/Schnee/Zufall][LS/SF/LV]");
}

COMMAND:setfraktionskasse(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new fID,menge,string[128],cmd[12];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	if(sscanf(params,"is[12]i",fID,cmd,menge))return SCM(playerid,SAMP_WEISS,""#IINFO" /setfraktionskasse [Fraktionsid][Geld/Ganja/Opium/Spice/Kokain/C4/Materials][Menge]");
    if(fID<1||fID>18)return SCM(playerid,SAMP_WEISS,"Wähle bitte eine Fraktion zwischen 1 und 16 aus.");
    if(fID == 4 || fID == 5 || fID == 7 || fID == 8 || fID == 9 || fID == 10 || fID == 12 || fID == 13 || fID == 15 || fID == 16 || fID == 17 || fID == 18)
	{
		if(strcmp(cmd,"Geld",true) == 0)
		{
			fverwaltungen[fID][Geld] += menge;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat die Fraktionskasse (Geld) von %s auf %i$ angepasst. Fraktionskasse (Geld): %i$",Spieler[playerid][pName],playerid,FraktionsName(fID),menge,fverwaltungen[fID][Geld]);
			SendAdminMessage(GRUEN,string);
			format(string,sizeof(string),"[ADMINÜBERWEISUNG] %s -- GELD Fkassenstand(vor Einzahlung): %i | Admin: %s * Einzahlung: %i | Fkassenstand(nach Einzahlung): %i",FraktionsName(fID),fverwaltungen[fID][Geld]-menge,Spieler[playerid][pName],menge,fverwaltungen[fID][Geld]);
			Log("Fraktions_Kasse.txt",string);
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat eure Fraktionskasse (Geld) auf %i$ angepasst. Fraktionskasse (Geld): %i$",Spieler[playerid][pName],playerid,menge,fverwaltungen[fID][Geld]);
		    SendFraktionsMessage(fID,FMELDUNG,string);
			return 1;
		}
		if(strcmp(cmd,"Ganja",true) == 0)
		{
			fverwaltungen[fID][Ganja] += menge;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat die Fraktionskasse (Ganja) von %s auf %ig angepasst. Fraktionskasse (Ganja): %ig",Spieler[playerid][pName],playerid,FraktionsName(fID),menge,fverwaltungen[fID][Ganja]);
			SendAdminMessage(GRUEN,string);
			format(string,sizeof(string),"[ADMINÜBERWEISUNG] %s -- Ganja Fkassenstand(vor Einzahlung): %i | Admin: %s * Einzahlung: %i | Fkassenstand(nach Einzahlung): %i",FraktionsName(fID),fverwaltungen[fID][Ganja]-menge,Spieler[playerid][pName],menge,fverwaltungen[fID][Ganja]);
			Log("Fraktions_Kasse.txt",string);
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat eure Fraktionskasse (Ganja) auf %ig angepasst. Fraktionskasse (Ganja): %ig",Spieler[playerid][pName],playerid,menge,fverwaltungen[fID][Ganja]);
		    SendFraktionsMessage(fID,FMELDUNG,string);
			return 1;
		}
		if(strcmp(cmd,"Opium",true) == 0)
		{
			fverwaltungen[fID][Opium] += menge;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat die Fraktionskasse (Opium Pillen) von %s auf %i angepasst. Fraktionskasse (Opium Pillen): %i",Spieler[playerid][pName],playerid,FraktionsName(fID),menge,fverwaltungen[fID][Opium]);
			SendAdminMessage(GRUEN,string);
			format(string,sizeof(string),"[ADMINÜBERWEISUNG] %s -- Opium Fkassenstand(vor Einzahlung): %i | Admin: %s * Einzahlung: %i | Fkassenstand(nach Einzahlung): %i",FraktionsName(fID),fverwaltungen[fID][Opium]-menge,Spieler[playerid][pName],menge,fverwaltungen[fID][Opium]);
			Log("Fraktions_Kasse.txt",string);
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat eure Fraktionskasse (Opium Pillen) auf %i angepasst. Fraktionskasse (Opium Pillen): %i",Spieler[playerid][pName],playerid,menge,fverwaltungen[fID][Opium]);
		    SendFraktionsMessage(fID,FMELDUNG,string);
			return 1;
		}
		if(strcmp(cmd,"Spice",true) == 0)
		{
			fverwaltungen[fID][Spice] += menge;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat die Fraktionskasse (Spice) von %s auf %i angepasst. Fraktionskasse (Spice): %i",Spieler[playerid][pName],playerid,FraktionsName(fID),menge,fverwaltungen[fID][Spice]);
			SendAdminMessage(GRUEN,string);
			format(string,sizeof(string),"[ADMINÜBERWEISUNG] %s -- Spice Fkassenstand(vor Einzahlung): %i | Admin: %s * Einzahlung: %i | Fkassenstand(nach Einzahlung): %i",FraktionsName(fID),fverwaltungen[fID][Spice]-menge,Spieler[playerid][pName],menge,fverwaltungen[fID][Spice]);
			Log("Fkassensqllog",string);
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat eure Fraktionskasse (Spice) auf %i angepasst. Fraktionskasse (Spice): %i",Spieler[playerid][pName],playerid,menge,fverwaltungen[fID][Spice]);
		    SendFraktionsMessage(fID,FMELDUNG,string);
			return 1;
		}
		if(strcmp(cmd,"C4",true) == 0)
		{
			fverwaltungen[fID][C4] += menge;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat die Fraktionskasse (C4) von %s auf %ikg angepasst. Fraktionskasse (C4): %ikg",Spieler[playerid][pName],playerid,FraktionsName(fID),menge,fverwaltungen[fID][C4]);
			SendAdminMessage(GRUEN,string);
			format(string,sizeof(string),"[ADMINÜBERWEISUNG] %s -- C4 Fkassenstand(vor Einzahlung): %i | Admin: %s * Einzahlung: %i | Fkassenstand(nach Einzahlung): %i",FraktionsName(fID),fverwaltungen[fID][C4]-menge,Spieler[playerid][pName],menge,fverwaltungen[fID][C4]);
			Log("Fkassensqllog",string);
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat eure Fraktionskasse (C4) auf %ikg angepasst. Fraktionskasse (C4): %ikg",Spieler[playerid][pName],playerid,menge,fverwaltungen[fID][C4]);
			SendFraktionsMessage(fID,FMELDUNG,string);
			return 1;
		}
		if(strcmp(cmd,"Kokain",true) == 0)
		{
			fverwaltungen[fID][Kokain] += menge;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat die Fraktionskasse (Kokain) von %s auf %ig angepasst. Fraktionskasse (Kokain): %ig",Spieler[playerid][pName],playerid,FraktionsName(fID),menge,fverwaltungen[fID][Kokain]);
			SendAdminMessage(GRUEN,string);
			format(string,sizeof(string),"[ADMINÜBERWEISUNG] %s -- KOKAIN Fkassenstand(vor Einzahlung): %i | Admin: %s * Einzahlung: %i | Fkassenstand(nach Einzahlung): %i",FraktionsName(fID),fverwaltungen[fID][Kokain]-menge,Spieler[playerid][pName],menge,fverwaltungen[fID][Kokain]);
			Log("Fkassensqllog",string);
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat eure Fraktionskasse (Kokain) auf %ig angepasst. Fraktionskasse (Kokain): %ig",Spieler[playerid][pName],playerid,menge,fverwaltungen[fID][Kokain]);
		    SendFraktionsMessage(fID,FMELDUNG,string);
			return 1;
		}
		if(strcmp(cmd,"Materials",true) == 0)
		{
			fverwaltungen[fID][Materials] += menge;
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat die Fraktionskasse (Materials) von %s auf %i angepasst. Fraktionskasse (Materials): %i",Spieler[playerid][pName],playerid,FraktionsName(fID),menge,fverwaltungen[fID][Materials]);
			SendAdminMessage(GRUEN,string);
			format(string,sizeof(string),"[ADMINÜBERWEISUNG] %s -- MATERIALS Fkassenstand(vor Einzahlung): %i | Admin: %s * Einzahlung: %i | Fkassenstand(nach Einzahlung): %i",FraktionsName(fID),fverwaltungen[fID][Materials]-menge,Spieler[playerid][pName],menge,fverwaltungen[fID][Materials]);
			Log("Fkassensqllog",string);
			format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat eure Fraktionskasse (Materials) auf %i angepasst. Fraktionskasse (Materials): %i",Spieler[playerid][pName],playerid,menge,fverwaltungen[fID][Materials]);
		    SendFraktionsMessage(fID,FMELDUNG,string);
			return 1;
		}
		return SCM(playerid,SAMP_WEISS,""#IINFO" /setfraktionskasse [Fraktionsid][Geld/Ganja/Opium/Spice/Kokain/C4/Materials][Menge]");
	}
	return SCM(playerid,SAMP_WEISS,"Angegebene Fraktion besitzt keine Fraktionsbank.(/fraktionen)");
}
COMMAND:delfrakcar(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],query[64],vehicleid;
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
    if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""#IINFO" /delfrakcar [Vehicleid]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
    for(new fv;fv<MAX_FVEHS;fv++)
 	{
	 	if(vehicleid == Fahrzeug[fv][Vehicle])
	 	{
	 	    if(GetVehicleModel(vehicleid) >= 400 && GetVehicleModel(vehicleid) <= 611)
	 	    {
			if(Fahrzeug[fv][Fraktion] == 0)return SCM(playerid,SAMP_WEISS,"Fahrzeug gehört keiner Fraktion an!");
		    format(string,sizeof(string),""IINFO" du hast ein Fraktionsfahrzeug (%s) der Fraktion %s vom Server gelöscht!",VehicleDefinations[Fahrzeug[fv][modelid]-400],FraktionsName(Fahrzeug[fv][Fraktion]));
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"Admin : %s | Fahrzeug: %s * Fraktion : %s",Spieler[playerid][pName],VehicleDefinations[Fahrzeug[fv][modelid]-400],FraktionsName(Fahrzeug[fv][Fraktion]));
			Log("Fvehdelsqllog",string);
			Fahrzeug[fv][Fraktion] = 0;
			Fahrzeug[fv][FraktionsRang] = 0;
			Fahrzeug[fv][modelid] = -1;
			Fahrzeug[fv][Colour1] = -1;
			Fahrzeug[fv][Colour2] = -1;
			Fahrzeug[fv][Paintjob] = -1;
			Fahrzeug[fv][posx] = -1;
			Fahrzeug[fv][posy] = -1;
			Fahrzeug[fv][posz] = -1;
			Fahrzeug[fv][posa] = -1;
			Fahrzeug[fv][Interior] = 0;
			Fahrzeug[fv][VirtualWorld] = 0;
			Fahrzeug[fv][Abgeschlossen] = 0;
			vFahrzeug[Fahrzeug[fv][Vehicle]][Abgeschleppt] = 0;
			vFahrzeug[Fahrzeug[fv][Vehicle]][AbgeschlepptPreis] = 0;
			Fahrzeug[fv][Spoiler] = 0;
			Fahrzeug[fv][Wheels] = 0;
			Fahrzeug[fv][Nitro] = 0;
			Fahrzeug[fv][Roof] = 0;
			Fahrzeug[fv][Hood] = 0;
			Fahrzeug[fv][Sideskirt] = 0;
			Fahrzeug[fv][Lamps] = 0;
			Fahrzeug[fv][Exhaust] = 0;
			Fahrzeug[fv][Stereo] = 0;
			Fahrzeug[fv][Hydraulics] = 0;
			Fahrzeug[fv][VentRight] = 0;
			Fahrzeug[fv][VentLeft] = 0;
			Fahrzeug[fv][FrontBumper] = 0;
			Fahrzeug[fv][RearBumper] = 0;
			Fahrzeug[fv][Preis] = 0;
			strmid(Fahrzeug[fv][Nummernschild],"-",0,strlen("-"),64);
			format(query,sizeof(query),"DELETE FROM server_ffahrzeuge WHERE id = '%d'",Fahrzeug[fv][Carkey]);
		   	mysql_function_query(MySQL_R394,query,false,"","");
			DeleteVehicle(Fahrzeug[fv][Vehicle]);
			Fahrzeug[fv][Vehicle] = -1;
			break;
			}
		}
	}
	return 1;
}
COMMAND:addfrakcar(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new preis,fID,modelidenty,Float:x,Float:y,Float:z,Float:angle,string[650],counter = 0;
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	if(GetPlayerInterior(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier kein Fraktionsfahrzeug erstellen.");
	if(GetPlayerVirtualWorld(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier kein Fraktionsfahrzeug erstellen.");
	if(sscanf(params,"iii",modelidenty,preis,fID))return SCM(playerid,SAMP_WEISS,""#IINFO" /addfrakcar [Modelid][Preis][Fraktionsid]");
    if(fID<1||fID>18)return SCM(playerid,SAMP_WEISS,"Wähle bitte eine Fraktion zwischen 1 und 16 aus.");
    if(modelidenty<400||modelidenty>611)return SCM(playerid,SAMP_WEISS,"Wähle bitte nur Model-Id´s zwischen 400 und 611 aus.");
 	for(new fv;fv<MAX_FVEHS;fv++)
 	{
	 	if(Fahrzeug[fv][Fraktion] != 0)counter++;
 	}
	if(counter == MAX_FVEHS)return SCM(playerid,SAMP_WEISS,""IINFO" die maximale Anzahl an erstellten Fraktionsfahrzeugen ist erreicht!");
	GetPlayerPos(playerid,x,y,z);
	GetPlayerFacingAngle(playerid,angle);
	format(string,sizeof(string),""IINFO" du hast das Fahrzeug: "IINFO2"%s"#HTML_WEISS" für die Fraktion "IINFO2"%s"HTML_WEISS" erstellt.",VehicleDefinations[modelidenty-400],FraktionsName(fID));
	SCM(playerid,SAMP_WEISS,string);
	CreateFraktionsVehicle(modelidenty,fID,x,y,z,GetPlayerInterior(playerid),GetPlayerVirtualWorld(playerid),angle,-1,0);
	format(string,sizeof(string),""ACINFO" der Admin "IINFO2"%s"#HTML_WEISS" hat das Fahrzeug "IINFO2"%s"#HTML_WEISS" für eure Fraktion erstellt.",Spieler[playerid][pName],VehicleDefinations[modelidenty-400]);
    SendFraktionsMessage(fID,FMELDUNG,string);
	return 1;
}
COMMAND:adduserveh(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,model,Float:Posi[4],string[650];
	if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
	if(GetPlayerInterior(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier kein Spielerfahrzeug erstellen.");
	if(GetPlayerVirtualWorld(playerid) != 0)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst hier kein Spielerfahrzeug erstellen.");
	if(sscanf(params,"ui",pID,model))return SendClientMessage (playerid,SAMP_WEISS,""#IINFO" /adduserveh [playerid/Name][Model]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(model<400||model>611)return SCM(playerid,SAMP_WEISS,"Wähle bitte nur Model-Id´s zwischen 400 und 611 aus.");
	if(GetPlayerVehicleCount(pID) >= MAX_PLAYER_VEHS)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits die maximale Anzahl an Fahrzeugen!");
	GetPlayerPos(playerid,Posi[0],Posi[1],Posi[2]);
	GetPlayerFacingAngle(playerid,Posi[3]);
	format(string,sizeof(string),""ACINFO" der Admin: "IINFO2"%s"#HTML_WEISS" hat dir das Fahrzeug "IINFO2"%s"#HTML_WEISS" erstellt! Es ist nun dein Fahrzeug.",Spieler[playerid][pName],VehicleDefinations[model-400]);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),""IINFO" du hast den Spieler: "IINFO2"%s"#HTML_WEISS" das Fahrzeug "IINFO2"%s"#HTML_WEISS" erstellt! Es ist nun sein Fahrzeug.",Spieler[pID][pName],VehicleDefinations[model-400]);
	SCM(playerid,SAMP_WEISS,string);
    CreatePlayerVehicle(pID,model,Posi[0],Posi[1],Posi[2],Posi[3],"N/A",0);
	return 1;
}
COMMAND:deluserveh(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new string[128],query[128],vehicleid;
    if(!isPlayerAnAdmin(playerid,6))return ADMIN_MSG(playerid);
    if(sscanf(params,"i",vehicleid))return SCM(playerid,SAMP_WEISS,""#IINFO" /deluserveh [Vehicleid]");
	if(!IsValidVehicle(vehicleid))return SCM(playerid,SAMP_WEISS,"Fahrzeug existiert nicht!");
  	ForEachPlayer(i)
	{
	    for(new slot=0;slot<MAX_PLAYER_VEHS;slot++)
		{
			if(vehicleid == Pfahrzeug[slot][i][Vehicle])
			{
                if(GetVehicleModel(vehicleid) >= 400 && GetVehicleModel(vehicleid) <= 611)
 				{
			    format(string,sizeof(string),""IINFO" du hast das Fahrzeug (%s) gelöscht!",VehicleDefinations[Pfahrzeug[slot][i][modelid]-400]);
				SCM(playerid,SAMP_WEISS,string);
			    Pfahrzeug[slot][i][modelid] = 0;
			    Pfahrzeug[slot][i][posx] = -1;
			    Pfahrzeug[slot][i][posy] = -1;
			    Pfahrzeug[slot][i][posz] = -1;
			    Pfahrzeug[slot][i][posa] = -1;
			    Pfahrzeug[slot][i][Colour1] = -1;
			    Pfahrzeug[slot][i][Colour2] = -1;
			    Pfahrzeug[slot][i][Paintjob] = -1;
			    Pfahrzeug[slot][i][Abgeschlossen] = 0;
			    Pfahrzeug[slot][i][Spoiler] = 0;
			    Pfahrzeug[slot][i][Hood] = 0;
			    Pfahrzeug[slot][i][Roof] = 0;
			    Pfahrzeug[slot][i][Sideskirt] = 0;
			    Pfahrzeug[slot][i][Lamps] = 0;
			    Pfahrzeug[slot][i][Nitro] = 0;
			    Pfahrzeug[slot][i][Exhaust] = 0;
			    Pfahrzeug[slot][i][Wheels] = 0;
			    Pfahrzeug[slot][i][Stereo] = 0;
			    Pfahrzeug[slot][i][Hydraulics] = 0;
			    Pfahrzeug[slot][i][FrontBumper] = 0;
			    Pfahrzeug[slot][i][RearBumper] = 0;
			    Pfahrzeug[slot][i][VentRight] = 0;
			    Pfahrzeug[slot][i][VentLeft] = 0;
				format(query,sizeof(query),"DELETE FROM spieler_fahrzeuge WHERE name = '%s' AND slot = '%d'",Pfahrzeug[slot][i][Besitzer],slot);
			   	mysql_function_query(MySQL_R394,query,false,"","");
				strmid(Pfahrzeug[slot][i][Besitzer],"Keiner",0,strlen("Keiner"),32);
			    DeleteVehicle(Pfahrzeug[slot][i][Vehicle]);
			    Pfahrzeug[slot][i][Vehicle] = -1;
				return 1;
				}
			}
	 	}
	}
	return SCM(playerid,SAMP_WEISS,"Fahrzeug gehört keinem Spieler!");
}

COMMAND:delfraktionssperre(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128],reason[31];
	if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
	if(sscanf(params,"us[31]",pID,reason))return SendClientMessage (playerid,SAMP_WEISS,""#IINFO" /delfraktionssperre [playerid/Name][Grund]");
    if(strlen(reason) > 30)return SCM(playerid,SAMP_WEISS,""#IINFO" /delfraktionssperre [playerid/Name][Grund darf maximal 30 Zeichen beinhalten]");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(gettime() > Spieler[pID][pFraktionSperre])return SCM(playerid,SAMP_WEISS,"Spieler hat keine Fraktionssperre.");
	format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat deine Fraktionssperre gelöscht. Grund: %s",Spieler[playerid][pName],playerid,reason);
	SCM(pID,SAMP_WEISS,string);
    format(string,sizeof(string),""ACINFO" der Admin %s (ID:%i) hat die Fraktionssperre von den Spieler %s (ID:%i) gelöscht. Grund: %s",Spieler[playerid][pName],playerid,SpielerName(pID),pID,reason);
    SendAdminMessage(BLAU,string);
	Spieler[pID][pFraktionSperre] = 0;
	return 1;
}

COMMAND:afmember(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    new string[512],stringheader[64],onlinemembers = 0,fID;
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
 	if(sscanf(params,"i",fID))return SCM(playerid,SAMP_WEISS,""#IINFO" /afmember [FraktionsID]");
 	if(fID<1||fID>17)return SCM(playerid,SAMP_WEISS,"Wähle bitte eine Fraktion zwischen 1 und 16 aus.");
	ForEachPlayer(i)
    {
		if(IsPlayerConnected(i) && !IsPlayerNPC(i))
		{
			if(GetPVarInt(i,"Eingeloggt") == 1)
			{
				if(isPlayerInFrakt(i,fID))
				{
					onlinemembers++;
					format(stringheader,sizeof(stringheader),""ClanTagDialoge" %s",FraktionsName(fID));
					format(string,sizeof(string),"%s : %s (Rang:%i)\n%s",SpielerFraktionsRangName(i),SpielerName(i),Spieler[i][pFraktRang],string);
					ShowPlayerDialog(playerid,DIALOG_4ALL_SONSTIGES,DIALOG_STYLE_LIST,stringheader,string,"Verlassen","");
				}
			}
		}
	}
	if(onlinemembers == 0)return SCM(playerid,SAMP_WEISS,"Kein Fraktionsmitglied der angegebenen Fraktion Online.");
	return 1;
}
COMMAND:showfkasse(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
   	new string[128],fID;
    if(!isPlayerAnAdmin(playerid,5))return ADMIN_MSG(playerid);
 	if(sscanf(params,"i",fID))return SCM(playerid,SAMP_WEISS,""#IINFO" /showfkasse [FraktionsID]");
    if(fID<1||fID>18)return SCM(playerid,SAMP_WEISS,"Wähle bitte eine Fraktion zwischen 1 und 18 aus.");
    if(fID == 4 || fID == 5 || fID == 7 || fID == 8 || fID == 9 || fID == 10 || fID == 12 || fID == 13 || fID == 15 || fID == 16 || fID == 17 || fID == 18)
	{
		format(string,sizeof(string),"[_______Fraktionsbank der %s_______]",FraktionsName(fID));
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Geld: %i$      Opium: %i Pillen",fverwaltungen[fID][Geld],fverwaltungen[fID][Opium]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Ganja: %ig     Kokain: %ig	Spice: %ig",fverwaltungen[fID][Ganja],fverwaltungen[fID][Kokain],fverwaltungen[fID][Spice]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"C4: %ikg     	 Materials: %i",fverwaltungen[fID][C4],fverwaltungen[fID][Materials]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Waffenpack Nummer: %i     Vorhandene Waffenslots: %i",fverwaltungen[fID][WaffenPack],fverwaltungen[fID][WaffenSlots]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Healpack Nummer: %i     Vorhandene Healslots: %i",fverwaltungen[fID][Heal],fverwaltungen[fID][HealSlots]);
		SCM(playerid,SAMP_WEISS,string);
		format(string,sizeof(string),"Armourpack Nummer: %i     Vorhandene Armourslots: %i",fverwaltungen[fID][Armour],fverwaltungen[fID][ArmourSlots]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,"Angegebene Fraktion besitzt keine Fraktionsbank.(/fraktionen)");
}
COMMAND:fahrschule(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new lehrer,string[256];
	if(!IsPlayerInRangeOfPoint(playerid,2.0,-2033.4276,-117.4092,1035.1719))return SCM(playerid,SAMP_WEISS,"Nicht in der Fahrschule!");
	ForEachPlayer(i)
	{
		if(isPlayerInFrakt(i,14) && Spieler[i][pDuty] == 1 && Spieler[i][pAWAYFROMKEYBOARD] == 0)
		{
			lehrer++;
		}
	}
	if(gettime() < Spieler[playerid][pPremium])
	{
		if(gettime() < Spieler[playerid][pScheinSperre]/2)
	    {
			new timestamp = (Spieler[playerid][pScheinSperre]/2) - gettime();
			SCM(playerid,SAMP_WEISS,""IINFO" du hast eine Fahrschulsperre.");
			format(string,sizeof(string),""IINFO" komme in "IINFO2"%i:%02d"#HTML_WEISS" Minuten wieder.",timestamp/60,timestamp%60);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
	}
	else
	{
		if(gettime() < Spieler[playerid][pScheinSperre])
	    {
			new timestamp = Spieler[playerid][pScheinSperre] - gettime();
			SCM(playerid,SAMP_WEISS,""IINFO" du hast eine Fahrschulsperre.");
			format(string,sizeof(string),""IINFO" komme in "IINFO2"%i:%02d"#HTML_WEISS" Minuten wieder.",timestamp/60,timestamp%60);
			SCM(playerid,SAMP_WEISS,string);
			return 1;
		}
	}
	if(lehrer != 0)return SCM(playerid,SAMP_WEISS,""IINFO" es sind Fahrlehrer Online!");
	if(Spieler[playerid][pPersoLic] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du besitzt keinen Personalausweis.");
	strdel(edit_2,0,sizeof(edit_2));
	strcat(edit_2,""#HTML_WEISS"Schein\t\t"#HTML_WEISS"Preis\n");
	format(string,sizeof(string),""#HTML_WEISS"Autoschein\t\t"IINFO2"(%i$)\n",fsteuern[PreisLicCar]);
	strcat(edit_2,string);
	format(string,sizeof(string),""#HTML_WEISS"Motorradschein\t\t"IINFO2"(%i$)\n",fsteuern[PreisLicBike]);
	strcat(edit_2,string);
	format(string,sizeof(string),""#HTML_WEISS"Rollerschein\t\t"IINFO2"(%i$)\n",fsteuern[PreisLicRoller]);
	strcat(edit_2,string);
	format(string,sizeof(string),""#HTML_WEISS"Flugschein\t\t"IINFO2"(%i$)\n",fsteuern[PreisLicPlane]);
	strcat(edit_2,string);
	format(string,sizeof(string),""#HTML_WEISS"Helikopterschein\t\t"IINFO2"(%i$)\n",fsteuern[PreisLicHeli]);
	strcat(edit_2,string);
	format(string,sizeof(string),""#HTML_WEISS"Bootsschein\t\t"IINFO2"(%i$)\n",fsteuern[PreisLicBoat]);
	strcat(edit_2,string);
	ShowPlayerDialog(playerid,DIALOG_FAHRSCHULE,DIALOG_STYLE_TABLIST_HEADERS,""ClanTagDialoge" Olaf's Fahrschule",edit_2,"Weiter","Abbrechen");
	return 1;
}
COMMAND:fahrstunde(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128];
	if(!isPlayerInFrakt(playerid,14))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""#IINFO" /fahrstunde [playerid/Name]");
    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst mit dir selbst keine Fahrstunde starten!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
    if(gettime() < Spieler[playerid][pPremium])
	{
		if(gettime() < Spieler[pID][pScheinSperre]/2)return SCM(playerid,SAMP_WEISS,"Spieler hat eine Scheinsperre.");
	}
	else
	{
		if(gettime() < Spieler[pID][pScheinSperre])return SCM(playerid,SAMP_WEISS,"Spieler hat eine Scheinsperre.");
	}
	if(Spieler[pID][InFahrSchulPruefung] == 1)return SCM(playerid,SAMP_WEISS,"Spieler ist bereits in einer Fahrstunde!");
	format(string,sizeof(string),""IINFO" du hast "IINFO2"%s"#HTML_WEISS" eine Fahrstunde angeboten.",SpielerName(pID));
    SCM(playerid,SAMP_WEISS,string);
    format(string,sizeof(string),"Fahrlehrer "IINFO2"%s"#HTML_WEISS" hat dir eine Fahrstunde angeboten.(/accept Fahrstunde)",SpielerName(playerid));
    SCM(pID,SAMP_WEISS,string);
    SCM(pID,SAMP_WEISS,""IINFO" um die Fahrstunde abzulehnen Tippe "IINFO2"/cancel fahrstunde");
    Spieler[pID][pSeller] = playerid;
	Spieler[pID][pAngebot] = 7;
	Spieler[pID][pKaufPreis] = 0;
	Spieler[pID][pMenge] = 0;
	Spieler[pID][pMenge2] = 0;
	Spieler[pID][pVerbrauch] = 0;
	return 1;
}
COMMAND:stopfahrstunde(playerid,const params[])
{
    #pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID = Spieler[playerid][pSeller],string[128];
	if(!isPlayerInFrakt(playerid,14))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][InFahrSchulPruefung] == 0)return SCM(playerid,SAMP_WEISS,""IINFO" du bist in keiner Fahrprüfung.");
	format(string,sizeof(string),""IINFO" du hast die Fahrstunde mit "IINFO2"%s"#HTML_WEISS" abgebrochen.",SpielerName(pID));
    SCM(playerid,SAMP_WEISS,string);
    format(string,sizeof(string),"Fahrlehrer "IINFO2"%s"#HTML_WEISS" hat deine Fahrstunde abgebrochen.",SpielerName(playerid));
    SCM(pID,SAMP_WEISS,string);
	Spieler[pID][InFahrSchulPruefung] = 0;
	Spieler[playerid][InFahrSchulPruefung] = 0;
	RemovePlayerFromVehicle(pID);
	Spieler[pID][pSeller] = -1;
	Spieler[pID][pAngebot] = 0;
	Spieler[pID][pKaufPreis] = 0;
	Spieler[pID][pMenge] = 0;
	Spieler[pID][pMenge2] = 0;
	Spieler[pID][pVerbrauch] = 0;
	return 1;
}
COMMAND:setopreis(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new preis,string[128],cmd[10];
    if(!isPlayerInFrakt(playerid,14))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(sscanf(params,"s[10]i",cmd,preis))return SCM(playerid,SAMP_WEISS,""#IINFO" /setopreis [Auto/Motorrad/Roller/Boot/Flug/Heli][Preis]");
	if(preis<1||preis>30000)return SCM(playerid,SAMP_WEISS,""#IINFO" /setopreis [Auto/Motorrad/Boot/Flug/Heli][Preis 1-30000]");
	if(strcmp(cmd,"Auto",true) == 0)
	{
		fsteuern[PreisLicCar] = preis;
		format(string,sizeof(string),""IINFO" du hast den Preis für den Führerschein auf "IINFO2"%i$"#HTML_WEISS" gesetzt.",fsteuern[PreisLicCar]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"Motorrad",true) == 0)
	{
		fsteuern[PreisLicBike] = preis;
		format(string,sizeof(string),""IINFO" du hast den Preis für den Motorradschein auf "IINFO2"%i$"#HTML_WEISS" gesetzt.",fsteuern[PreisLicBike]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"Roller",true) == 0)
	{
		fsteuern[PreisLicRoller] = preis;
		format(string,sizeof(string),""IINFO" du hast den Preis für den Motorradschein auf "IINFO2"%i$"#HTML_WEISS" gesetzt.",fsteuern[PreisLicBike]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"Flug",true) == 0)
	{
		fsteuern[PreisLicPlane] = preis;
		format(string,sizeof(string),""IINFO" du hast den Preis für den Flugzeugschein auf "IINFO2"%i$"#HTML_WEISS" gesetzt.",fsteuern[PreisLicPlane]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"Heli",true) == 0)
	{
		fsteuern[PreisLicHeli] = preis;
		format(string,sizeof(string),""IINFO" du hast den Preis für den Helikopterschein auf "IINFO2"%i$"#HTML_WEISS" gesetzt.",fsteuern[PreisLicHeli]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	if(strcmp(cmd,"Boot",true) == 0)
	{
		fsteuern[PreisLicBoat] = preis;
		format(string,sizeof(string),""IINFO" du hast den Preis für den Bootsschein auf "IINFO2"%i$"#HTML_WEISS" gesetzt.",fsteuern[PreisLicBoat]);
		SCM(playerid,SAMP_WEISS,string);
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""#IINFO" /setopreis [Auto/Motorrad/Roller/Boot/Flug/Heli][Preis]");
}
COMMAND:sellschein(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
    if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],cmd[10];
	if(!isPlayerInFrakt(playerid,14))return SCM(playerid,SAMP_WEISS,""IINFO" du bist nicht in der jeweiligen Fraktion.");
	if(sscanf(params,"us[10]",pID,cmd))return SCM(playerid,SAMP_WEISS,""#IINFO" /sellschein [playerid/Name][Auto/Motorrad/Boot/Flug/Heli/Roller]");
    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dir keine Scheine/Lizensen selber verkaufen!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
	if(strcmp(cmd,"Auto",true) == 0)
	{
		if(Spieler[pID][pAutoLic] != 0)return SCM(playerid,SAMP_WEISS,""IINFO"Spieler besitzt bereits den Führerschein!");
		format(string,sizeof(string),"%s (ID:%i) bietet dir den Führerschein für %i$ an.(/accept Schein)",SpielerName(playerid),playerid,fsteuern[PreisLicCar]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) den Führerschein für %i$ an.",SpielerName(pID),pID,fsteuern[PreisLicCar]);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pSeller] = playerid;
		Spieler[pID][pAngebot] = 1;
		Spieler[pID][pKaufPreis] = fsteuern[PreisLicCar];
		Spieler[pID][pMenge] = 1;
		return 1;
	}
	if(strcmp(cmd,"Motorrad",true) == 0)
	{
		if(Spieler[pID][pBikeLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Motorradschein!");
		format(string,sizeof(string),"%s (ID:%i) bietet dir den Motorradschein für %i$ an.(/accept Schein)",SpielerName(playerid),playerid,fsteuern[PreisLicBike]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) den Motorradschein für %i$ an.",SpielerName(pID),pID,fsteuern[PreisLicBike]);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pSeller] = playerid;
		Spieler[pID][pAngebot] = 1;
		Spieler[pID][pKaufPreis] = fsteuern[PreisLicBike];
		Spieler[pID][pMenge] = 2;
		return 1;
	}
	if(strcmp(cmd,"Flug",true) == 0)
	{
		if(Spieler[pID][pPlaneLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Flugzeugschein!");
		format(string,sizeof(string),"%s (ID:%i) bietet dir den Flugzeugschein für %i$ an.(/accept Schein)",SpielerName(playerid),playerid,fsteuern[PreisLicPlane]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) den Flugzeugschein für %i$ an.",SpielerName(pID),pID,fsteuern[PreisLicPlane]);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pSeller] = playerid;
		Spieler[pID][pAngebot] = 1;
		Spieler[pID][pKaufPreis] = fsteuern[PreisLicPlane];
		Spieler[pID][pMenge] = 3;
		return 1;
	}
	if(strcmp(cmd,"Heli",true) == 0)
	{
		if(Spieler[pID][pHeliLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Helikopterschein!");
		format(string,sizeof(string),"%s (ID:%i) bietet dir den Helikopterschein für %i$ an.(/accept Schein)",SpielerName(playerid),playerid,fsteuern[PreisLicHeli]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) den Helikopterschein für %i$ an.",SpielerName(pID),pID,fsteuern[PreisLicHeli]);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pSeller] = playerid;
		Spieler[pID][pAngebot] = 1;
		Spieler[pID][pKaufPreis] = fsteuern[PreisLicHeli];
		Spieler[pID][pMenge] = 4;
		return 1;
	}
	if(strcmp(cmd,"Boot",true) == 0)
	{
		if(Spieler[pID][pBoatLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Bootsschein!");
		format(string,sizeof(string),"%s (ID:%i) bietet dir den Bootsschein für %i$ an.(/accept Schein)",SpielerName(playerid),playerid,fsteuern[PreisLicBoat]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) den Bootsschein für %i$ an.",SpielerName(pID),pID,fsteuern[PreisLicBoat]);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pSeller] = playerid;
		Spieler[pID][pAngebot] = 1;
		Spieler[pID][pKaufPreis] = fsteuern[PreisLicBoat];
		Spieler[pID][pMenge] = 5;
		return 1;
	}
	if(strcmp(cmd,"Roller",true) == 0)
	{
		if(Spieler[pID][pRollerLic] != 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt bereits den Rollerschein!");
		format(string,sizeof(string),"%s (ID:%i) bietet dir den Rollerschein für %i$ an.(/accept Schein)",SpielerName(playerid),playerid,fsteuern[PreisLicRoller]);
		SCM(pID,SAMP_WEISS,string);
		format(string,sizeof(string),""IINFO" du bietest %s (ID:%i) den Rollerschein für %i$ an.",SpielerName(pID),pID,fsteuern[PreisLicRoller]);
		SCM(playerid,SAMP_WEISS,string);
		Spieler[pID][pSeller] = playerid;
		Spieler[pID][pAngebot] = 1;
		Spieler[pID][pKaufPreis] = fsteuern[PreisLicRoller];
		Spieler[pID][pMenge] = 6;
		return 1;
	}
	return SCM(playerid,SAMP_WEISS,""#IINFO" /sellschein [playerid/Name][Auto/Motorrad/Boot/Flug/Heli/Roller]");
}
COMMAND:durchsuchen(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID;
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""#HTML_BLAU"Verwendung:"#HTML_WEISS""#IINFO" /durchsuchen [playerid/Name]");
    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst durchsuchen!");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(Spieler[pID][pDeath] == 0)return SCM(playerid,SAMP_WEISS,"Spieler ist nicht verletzt!");
    if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
    //if(GetPlayerLevel(playerid) < 3) return SCM(playerid,SAMP_WEISS,"Dein Level reicht nicht aus.(mindestens Level 3)");
    if(Spieler[pID][pIssureKiller] !=playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du hast den Spieler nicht getötet!");
	if(GetPlayerLevel(pID) < 3) return SCM(playerid,SAMP_WEISS,"Level 2er können nicht ausgeraubt werden.");
    ShowBag(pID,playerid);
    return 1;
}
COMMAND:rob(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	new pID,string[128],cmd[15],time = RobWait[playerid] - gettime();
    if(sscanf(params,"us[15]",pID,cmd))return SCM(playerid,SAMP_WEISS,""#IINFO" /rob [playerid/Name][Geld/C4/Ganja/Kokain/Opium/Spice/Handy/Materials]");
    if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selbst beklauen!");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)
	{return Eingeloggt_MSG(playerid);}
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(!ProxDetectorS(5.0,playerid,pID))return SCM(playerid,SAMP_WEISS,""IINFO" der angegebene Spieler ist nicht in deiner Nähe!");
    if(GetPlayerLevel(playerid) < 3) return SCM(playerid,SAMP_WEISS,"Dein Level reicht nicht aus.(mindestens Level 3)");
    if(Spieler[pID][pIssureKiller] != playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du hast den Spieler nicht getötet!");
	if(GetPlayerLevel(pID) < 3) return SCM(playerid,SAMP_WEISS,"Level 2er können nicht ausgeraubt werden.");
	if(RobWait[playerid] < gettime())
	{
		if(strcmp(cmd,"Geld",true) == 0)
		{
		    if(Spieler[pID][pRobProtect] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst diesem Spieler nicht mehr Geld entwenden.");
			if(GetACMoney(pID) <= 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt kein Geld.");

			if(GetACMoney(pID) < 5000)
			{
	        new rand = random(1000);
	        format(string,sizeof(string),"%s (ID:%i) hat dir %i$ geklaut.",SpielerName(playerid),playerid,rand);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i$ gestohlen.",SpielerName(pID),pID,rand);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"** %s hat %s %i$ seines Geldes gestohlen **",SpielerName(playerid),SpielerName(pID),rand);
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			ACMoney(playerid,floatround(rand));
			ACMoney(pID,-floatround(rand));
			Spieler[pID][pRobProtect] = 1;
			RobWait[playerid] = gettime() + (60*15);
			}
			if(GetACMoney(pID) >= 5000)
			{
			new rand = random(1000);
			format(string,sizeof(string),"%s (ID:%i) hat dir %i$ geklaut.",SpielerName(playerid),playerid,rand);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i$ gestohlen.",SpielerName(pID),pID,rand);
			SCM(playerid,SAMP_WEISS,string);
			format(string,sizeof(string),"** %s hat %s %i$ seines Geldes gestohlen **",SpielerName(playerid),SpielerName(pID),rand);
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			ACMoney(playerid,floatround(rand));
			ACMoney(pID,-floatround(rand));
			Spieler[pID][pRobProtect] = 1;
			RobWait[playerid] = gettime() + (60*15);
			}
			return 1;
		}
		if(strcmp(cmd,"C4",true) == 0)
		{
			if(Spieler[pID][pC4] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt kein C4.");
			format(string,sizeof(string),"%s (ID:%i) hat dir deine %ikg C4 geklaut.",SpielerName(playerid),playerid,Spieler[pID][pC4]/2);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %ikg C4 entnommen.",SpielerName(pID),pID,Spieler[pID][pC4]/2);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[playerid][pC4] += floatround(Spieler[pID][pC4]/2);
			Spieler[pID][pC4] -= floatround(Spieler[pID][pC4]/2);
			format(string,sizeof(string),"** %s nimmt etwas von %s **",SpielerName(playerid),SpielerName(pID));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			RobWait[playerid] = gettime() + (60*15);
			return 1;
		}
		if(strcmp(cmd,"Ganja",true) == 0)
		{
			if(Spieler[pID][pGanja] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt kein Ganja.");
			format(string,sizeof(string),"%s (ID:%i) hat dir deine %ig Ganja geklaut.",SpielerName(playerid),playerid,Spieler[pID][pGanja]/2);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %ig Ganja entnommen.",SpielerName(pID),pID,Spieler[pID][pGanja]/2);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[playerid][pGanja] += floatround(Spieler[pID][pGanja]/2);
			Spieler[pID][pGanja] -= floatround(Spieler[pID][pGanja]/2);
			format(string,sizeof(string),"** %s nimmt etwas von %s **",SpielerName(playerid),SpielerName(pID));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			RobWait[playerid] = gettime() + (60*15);
			return 1;
		}
		if(strcmp(cmd,"Spice",true) == 0)
		{
			if(Spieler[pID][pSpice] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt kein Spice.");
			format(string,sizeof(string),"%s (ID:%i) hat dir deine %ig Spice geklaut.",SpielerName(playerid),playerid,Spieler[pID][pSpice]/2);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %ig Spice entnommen.",SpielerName(pID),pID,Spieler[pID][pSpice]/2);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[playerid][pSpice] += floatround(Spieler[pID][pSpice]/2);
			Spieler[pID][pSpice] -= floatround(Spieler[pID][pSpice]/2);
			format(string,sizeof(string),"** %s nimmt etwas von %s **",SpielerName(playerid),SpielerName(pID));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			RobWait[playerid] = gettime() + (60*15);
			return 1;
		}
		if(strcmp(cmd,"Kokain",true) == 0)
		{
			if(Spieler[pID][pKokain] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt kein Kokain.");
			format(string,sizeof(string),"%s (ID:%i) hat dir deine %ig Kokain geklaut.",SpielerName(playerid),playerid,floatround(Spieler[pID][pKokain]/2));
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %ig Kokain entnommen.",SpielerName(pID),pID,floatround(Spieler[pID][pKokain]/2));
			SCM(playerid,SAMP_WEISS,string);
			Spieler[playerid][pKokain] += floatround(Spieler[pID][pKokain]/2);
			Spieler[pID][pKokain] -= floatround(Spieler[pID][pKokain]/2);
			format(string,sizeof(string),"** %s nimmt etwas von %s **",SpielerName(playerid),SpielerName(pID));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			RobWait[playerid] = gettime() + (60*15);
			return 1;
		}
		if(strcmp(cmd,"Materials",true) == 0)
		{
			if(Spieler[pID][pMaterials] ==0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt keine Materials.");
			format(string,sizeof(string),"%s (ID:%i) hat dir deine %i Materials geklaut.",SpielerName(playerid),playerid,Spieler[pID][pMaterials]/2);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Materials entnommen.",SpielerName(pID),pID,Spieler[pID][pMaterials]/2);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[playerid][pMaterials] += floatround(Spieler[pID][pMaterials]/2);
			Spieler[pID][pMaterials] -= floatround(Spieler[pID][pMaterials]/2);
			format(string,sizeof(string),"** %s nimmt etwas von %s **",SpielerName(playerid),SpielerName(pID));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			RobWait[playerid] = gettime() + (60*15);
			return 1;
		}
		if(strcmp(cmd,"Opium",true) == 0)
		{
			if(Spieler[pID][pOpium] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt keine Opium Pillen.");
			format(string,sizeof(string),"%s (ID:%i) hat dir deine %i Opium Pillen geklaut.",SpielerName(playerid),playerid,Spieler[pID][pOpium]/2);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) %i Opium Pillen entnommen.",SpielerName(pID),pID,Spieler[pID][pOpium]/2);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[playerid][pOpium] += floatround(Spieler[pID][pOpium]/2);
			Spieler[pID][pOpium] -= floatround(Spieler[pID][pOpium]/2);
			format(string,sizeof(string),"** %s nimmt etwas von %s **",SpielerName(playerid),SpielerName(pID));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			RobWait[playerid] = gettime() + (60*15);
			return 1;
		}
		if(strcmp(cmd,"Handy",true) == 0)
		{
			if(Spieler[pID][pHandy] == 0)return SCM(playerid,SAMP_WEISS,"Spieler besitzt kein Handy.");
		    format(string,sizeof(string),"%s (ID:%i) hat dir dein %s geklaut.",SpielerName(playerid),playerid,HandyInfo[Spieler[pID][pHandy]][Handyname]);
			SCM(pID,SAMP_WEISS,string);
			format(string,sizeof(string),""IINFO" du hast %s (ID:%i) das %s entnommen.",SpielerName(pID),pID,HandyInfo[Spieler[pID][pHandy]][Handyname]);
			SCM(playerid,SAMP_WEISS,string);
			Spieler[playerid][pHandy] = Spieler[pID][pHandy];
			Spieler[playerid][pPhonenumber] = Spieler[pID][pPhonenumber];
			Spieler[playerid][pHandystate] = Spieler[pID][pHandystate];
			Spieler[playerid][pHandyakku] = Spieler[pID][pHandyakku];
			Spieler[playerid][pHandyFlat] = Spieler[pID][pHandyFlat];
		    Spieler[playerid][pHandyBuyByBiz] = Spieler[pID][pHandyBuyByBiz];
			HideHandyDraw(playerid);
			KillTimer(AkkuTimer[playerid]);
			Spieler[pID][pHandy] = 0;
			Spieler[pID][pHandyakku] = 0.0;
			Spieler[pID][pHandystate] = 0;
			Spieler[pID][pPhonenumber] = 0;
			Spieler[pID][pHandyFlat] = 0;
		    Spieler[pID][pHandyBuyByBiz] = 0;
			format(string,sizeof(string),"** %s nimmt etwas von %s **",SpielerName(playerid),SpielerName(pID));
			PlayerTalkPublic(playerid,SAMP_PublicChatColor,string,10);
			RobWait[playerid] = gettime() + (60*15);
			return 1;
		}
	}
	else
	{
	    format(string,sizeof(string),"Sie müssen noch "IINFO2"%i:%02d"#HTML_WEISS" Minuten warten bis du einen Spieler ausrauben kannst.",time/60,time%60);
		SCM(playerid,SAMP_WEISS,string);
	}
	return SCM(playerid,SAMP_WEISS,""IINFO" /rob [playerid/Name][Geld/C4/Ganja/Kokain/Opium/Spice/Handy/Materials]");
}

COMMAND:cheater(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128];
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""#IINFO" /cheater [playerid/Name]");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selber als Cheater melden!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(gettime() > Spieler[playerid][pWaiterMeldung])
	{
		format(string,sizeof(string),"[Cheatermeldung] %s: Spieler %s (ID:%i) ist unter verdacht zu cheaten.",SpielerName(playerid),SpielerName(pID),pID);
	    SendAdminMessage(SAMP_WEISS,string);
		format(string,sizeof(string),"Info: Tippe '/spec %s' oder '/spec %i' um den angeblichen Cheater zu spionieren!",SpielerName(pID),pID);
		SendAdminMessage(SAMP_WEISS,string);
		SCM(playerid,SAMP_WEISS,"Deine Cheatermeldung wurde ans Admin-Team weitergeleitet.");
		Spieler[playerid][pWaiterMeldung] = gettime()+(60*5);
 	}
 	else
 	{
 	    new timec = Spieler[playerid][pWaiterMeldung]-gettime();
		format(string,sizeof(string),""IINFO" du kannst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten eine weitere Cheatermeldung absenden.",floatround(timec/60),floatround(timec%60));
		SCM(playerid,SAMP_WEISS,string);
 	}
	return 1;
}

COMMAND:melden(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128];
	if(sscanf(params,"u",pID))return SCM(playerid,SAMP_WEISS,""#IINFO" /melden [playerid/Name]");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selber als Cheater melden!");
	if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	if(gettime() > Spieler[playerid][pWaiterMeldung])
	{
		format(string,sizeof(string),"[Meldung] %s: Spieler %s (ID:%i) hat einen Regelverstoß begannen.",SpielerName(playerid),SpielerName(pID),pID);
	    SendAdminMessage(SAMP_WEISS,string);
		format(string,sizeof(string),"Info: Tippe '/spec %s' oder '/spec %i' um den angeblichen Regelverstoß zu spionieren!",SpielerName(pID),pID);
		SendAdminMessage(SAMP_WEISS,string);
		SCM(playerid,SAMP_WEISS,"Deine Regelmeldung wurde ans Admin-Team weitergeleitet.");
		Spieler[playerid][pWaiterMeldung] = gettime()+(60*5);
	}
 	else
 	{
 	    new timec = Spieler[playerid][pWaiterMeldung]-gettime();
		format(string,sizeof(string),""IINFO" du kannst in "IINFO2"%i:%02d"#HTML_WEISS" Minuten einen weiteren Regelverstoß absenden.",floatround(timec/60),floatround(timec%60));
		SCM(playerid,SAMP_WEISS,string);
 	}
	return 1;
}

COMMAND:showreports(playerid,const params[])
{
	#pragma unused params
	new string[128];
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im AFK-Modus und kannst somit keine Befehle nutzen."),SCM(playerid,SAMP_WEISS,""#HTML_BLAU"Verwendung:"#HTML_WEISS""#IINFO" /back");
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein "#SERVERTAG" Teammitglied./Du hast nicht den jeweiligen Adminrang.");
	format(string,sizeof(string),""IINFO" der Supporter %s hat derzeit %d Reports bearbeitet.",SpielerName(playerid),Spieler[playerid][Reports]);
	SCM(playerid,SAMP_WEISS,string);
	return 1;
}
COMMAND:rpinfo(playerid,const params[])
{
	#pragma unused params
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return SCM(playerid,SAMP_WEISS,""IINFO" du bist im AFK-Modus und kannst somit keine Befehle nutzen."),SCM(playerid,SAMP_WEISS,""IINFO" /back");
	if(Spieler[playerid][pInPrison] == 1)return Prison_MSG(playerid);
	if(Spieler[playerid][pFriedhof] == 1)return TOT_MSG(playerid);
	if(Spieler[playerid][pDeath] == 1)return DAMAGE_MSG(playerid);
	if(Spieler[playerid][pJailed] != 0)return KNAST_MSG(playerid);
	if(Spieler[playerid][pTazerd] == 1)return TAZER_MSG(playerid);
	if(Spieler[playerid][pCuffed] == 1)return CUFF_MSG(playerid);
	if(!isPlayerAnAdmin(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein Teammitglied./Du hast nicht den jeweiligen Adminrang.");
	if(gettime() > showreportstate)
	{
	    SendClientMessageToAll(WEISS,"{FF8C00}Support{FFFFFF}: Du bist neu hier und noch Level 1? - Wir haben Ein Geschenk für dich!");
	    SendClientMessageToAll(WEISS,"{FF8C00}Support{FFFFFF}: Gib einfach /startbonus, gefolgt von /buylevel ein!");
		SendClientMessageToAll(WEISS,"{FF8C00}Support{FFFFFF}: Du hast eine Frage oder ein Problem ?");
		SendClientMessageToAll(WEISS,"{FF8C00}Support{FFFFFF}: Oder dir ist ein Regelverstoß aufgefallen?");
		SendClientMessageToAll(WEISS,"{FF8C00}Support{FFFFFF}: Falls ja mach /report und wähle die Kategorie aus,");
		SendClientMessageToAll(WEISS,"{FF8C00}Support{FFFFFF}: in der du den Report schreiben kannst. Ein Supporter/Admin wird sich dir zuwenden.");
	    showreportstate = gettime() + (60*5);
		return 1;
	}
	SCM(playerid,SAMP_WEISS,""IINFO" es wurde bereits eine Report System Meldung rausgegeben.");
	SCM(playerid,SAMP_WEISS,""IINFO" diese Info kan nur alle 5 Minuten rausgegeben werden.");
	return 1;
}
COMMAND:w(playerid,const params[])
{
	if(ImTutorial[playerid] != 0)return ImTutorial_MSG(playerid);
	if(GetPVarInt(playerid,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(Spieler[playerid][pAWAYFROMKEYBOARD] == 1)return AFK_MSG(playerid);
	new pID,string[128],text[91];
	if(!isPlayerAnAdmin(playerid,1))return SCM(playerid,SAMP_WEISS,""IINFO" du bist kein "#SERVERTAG" Teammitglied./Du hast nicht den jeweiligen Adminrang.");
	if(sscanf(params,"us[91]",pID,text))return SCM(playerid,SAMP_WEISS,""#IINFO" /w(hisper) [playerid/Name][Text]");
	if(strlen(text) > 90)return SCM(playerid,SAMP_WEISS,""#IINFO" /w(hisper) [Text darf maximal 90 Zeichen beinhalten]");
	if(pID == playerid)return SCM(playerid,SAMP_WEISS,""IINFO" du kannst dich nicht selber anflüstern!");
    if(!IsPlayerConnected(pID))return Eingeloggt_MSG(playerid);
    if(GetPVarInt(pID,"Eingeloggt") == 0)return Eingeloggt_MSG(playerid);
	if(IsPlayerNPC(pID))return SCM(playerid,SAMP_WEISS,""IINFO" das kannst du nicht!");
	format(string,sizeof(string),""IINFO" du hast %s folgendes geflüstert: %s",SpielerName(pID),text);
	SCM(playerid,SAMP_WEISS,string);
	format(string,sizeof(string),"%s (ID:%i) flüstert dir:",SpielerName(playerid),playerid,text);
	SCM(pID,SAMP_WEISS,string);
	format(string,sizeof(string),"%s",text);
	SCM(pID,0xFFD10087,string);
	format(string,sizeof(string),"%s flüstert zu %s: %s",Spieler[playerid][pName],SpielerName(pID),text);
	ForEachPlayer(i)
	{
		if(IsPlayerConnected(i))
		{
			if(Spieler[i][IreadALL] == 1)
			{
				SCM(i,SAMP_WEISS,string);
			}
		}
	}
	return 1;
}
